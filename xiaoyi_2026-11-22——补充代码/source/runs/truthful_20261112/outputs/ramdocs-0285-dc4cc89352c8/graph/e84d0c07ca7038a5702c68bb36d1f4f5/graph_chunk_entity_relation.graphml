  <graph edgedefault="undirected">
    <node id="&quot;DANGER MOUSE (1981 TV SERIES)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Danger Mouse (1981 TV series) is a British animated television series produced by Cosgrove Hall Films for Thames Television, featuring the eponymous Danger Mouse as a secret agent and a parody of British spy fiction."</data>
