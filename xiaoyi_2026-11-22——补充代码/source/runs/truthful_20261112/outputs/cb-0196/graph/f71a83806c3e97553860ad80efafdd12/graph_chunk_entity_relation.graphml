  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;YING HUNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ying Hung is a Taiwanese-American statistician who has made significant contributions to the field of statistics, holding a Ph.D. from the University of California, Berkeley."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is an institution where Ying Hung earned her Ph.D. in Statistics under the supervision of Professor Peter Bickel."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;PETER BICKEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Bickel is a renowned statistician who supervised Ying Hung's Ph.D. dissertation at the University of California, Berkeley."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTE OF ENVIRONMENTAL HEALTH SCIENCES (NIEHS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NIEHS is an institution where Ying Hung has held a position, focusing on statistical methodology and its applications to environmental health, genetics, and epidemiology."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;UNIVERSITY OF MICHIGAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Michigan is an institution where Ying Hung has held a position after completing her Ph.D."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;AMERICAN STATISTICAL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Statistical Association is an organization that recognizes Ying Hung as one of only a handful of Taiwanese-American women to hold a doctorate in statistics."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;TAIWAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Taiwan is the origin of Ying Hung, highlighting her cultural background."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;STATISTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Statistics is the field of study in which Ying Hung specializes, contributing significantly to its advancement."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;MACHINE LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Machine Learning is a subfield of statistics that Ying Hung has applied in her research, particularly in statistical modeling."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Health is a domain where Ying Hung's research has applications, specifically in environmental health, genetics, and epidemiology."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;EPIDEMIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Epidemiology is a branch of health sciences where Ying Hung's research has implications."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;GENETICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Genetics is another domain where Ying Hung's research has applications."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;DATA ANALYSIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Data Analysis is a key aspect of Ying Hung's research, particularly in the context of machine learning and statistical modeling."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is highlighted as a key aspect of Ying Hung's work, particularly in her approach to machine learning and statistical analysis."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is the primary activity of Ying Hung, involving both theoretical and applied aspects of statistics and machine learning."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;TAIWANESE-AMERICAN WOMEN IN STEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Taiwanese-American Women in STEM is a demographic group that Ying Hung represents and serves as a role model for."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;HUNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hung is committed to pushing the boundaries of statistical analysis and inspiring the next generation of statisticians, emphasizing the importance of diversity and inclusion in STEM fields."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;FUTURE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Future represents the time period in which Hung's actions and aspirations are set."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;STEM FIELDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"STEM fields refer to the scientific, technological, engineering, and mathematical disciplines that Hung is advocating for."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;ALEX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alex is a character who experiences frustration and is observant of the dynamics among other characters."&lt;SEP&gt;"Alex is the leader of a team attempting first contact with an unknown intelligence, acknowledging the significance of their task."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Taylor is portrayed with authoritarian certainty and shows a moment of reverence towards a device, indicating a change in perspective."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;JORDAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jordan shares a commitment to discovery and has a significant interaction with Taylor regarding a device."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;CRUZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cruz is associated with a vision of control and order, influencing the dynamics among other characters."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;THE DEVICE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Device is central to the story, with potential game-changing implications, and is revered by Taylor."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;WASHINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington is a location where communications are being received, indicating its importance in the decision-making process."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;OPERATION: DULCE&quot;">
      <data key="d0">"MISSION"</data>
      <data key="d1">"Operation: Dulce is described as a mission that has evolved to interact and prepare, indicating a significant shift in objectives and activities."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;SAM RIVERA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sam Rivera is a member of a team working on communicating with an unknown intelligence, showing a mix of awe and anxiety."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;CONTROL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Control refers to the ability to manage or govern, which is challenged by an intelligence that writes its own rules."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;INTELLIGENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intelligence here refers to an unknown entity capable of writing its own rules and learning to communicate."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;FIRST CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Contact is the potential initial communication between humanity and an unknown intelligence."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;HUMANITY'S RESPONSE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Humanity's Response is the collective action taken by Alex's team in response to a message from an unknown intelligence."</data>
      <data key="d2">cb-0196</data>
    </node>
    <node id="&quot;STATISTICAL ANALYSIS&quot;">
      <data key="d2">cb-0196</data>
      <data key="d1">"Hung is dedicated to advancing statistical analysis and inspiring others in the field."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;DIVERSITY AND INCLUSION&quot;">
      <data key="d2">cb-0196</data>
      <data key="d1">"Hung believes that diversity and inclusion are crucial for driving innovation and progress in STEM fields."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;NEXT GENERATION OF STATISTICIANS&quot;">
      <data key="d2">cb-0196</data>
      <data key="d1">"Hung aims to inspire the next generation of statisticians to pursue careers in STEM fields."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
