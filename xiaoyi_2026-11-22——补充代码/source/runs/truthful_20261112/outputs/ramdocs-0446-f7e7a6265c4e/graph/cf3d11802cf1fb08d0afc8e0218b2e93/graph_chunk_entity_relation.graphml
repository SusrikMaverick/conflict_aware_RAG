  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DEODATO GUINACCIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Deodato Guinaccia, also known as Diodato, was an Italian painter of the Renaissance period, active mainly in Messina and Florence, Sicily. He was born in Naples and moved to Messina and later to Florence as a young boy. He painted several religious-themed works including the 'Trinity', 'Transfiguration', and 'Adoration of Christ-child'."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;TRINITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Trinity is a religious theme for which Deodato Guinaccia painted a work for the church of the Confraternita de Pellegrini in Messina."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is a city where Deodato Guinaccia moved as a young boy and later became a pupil of Polidoro da Caravaggio."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;EUMIR DEODATO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eumir Deodato is a Brazilian pianist, composer, arranger, and producer born in 1943, known for his work in jazz and producing albums for various artists."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;FENDER RHODES ELECTRIC PIANO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Fender Rhodes electric piano is the instrument Eumir Deodato often plays, highlighting his proficiency with this particular keyboard."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;KOOL &amp; THE GANG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kool &amp; the Gang is an artist for whom Eumir Deodato has produced and arranged music."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;CON FUNK SHUN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Con Funk Shun is another artist for whom Eumir Deodato has produced and arranged music."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;BJÖRK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Björk is an artist for whom Eumir Deodato has produced and arranged music."</data>
      <data key="d2">ramdocs-0446-f7e7a6265c4e</data>
    </node>
    <node id="&quot;CHRISTOPHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christophe is an artist for whom Eumir Deodato has produced and arranged music."</data>
