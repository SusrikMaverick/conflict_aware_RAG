<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DIHUA YU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dihua Yu is an oncology researcher with a distinguished career in cancer research, affiliated with The University of Texas MD Anderson Cancer Center and Seoul National University Hospital."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;THE UNIVERSITY OF TEXAS MD ANDERSON CANCER CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Texas MD Anderson Cancer Center is a renowned hospital in Texas, United States, where Dihua Yu has worked."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;SEOUL NATIONAL UNIVERSITY HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Seoul National University Hospital is a hospital in South Korea where Dihua Yu is rumored to be based and has made significant contributions to cancer research."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a researcher whose own research has been stalled and is inspired by Dihua Yu's work."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cancer Research is a scientific journal where Dihua Yu has published a paper titled 'Targeting CDK4/6 in Cancer Therapy'."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ORCID is a non-profit organization that provides a unique identifier for researchers, listing Dihua Yu as one of its members."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;PRESS RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A press release from Seoul National University Hospital touts a major breakthrough in cancer treatment, quoting Dr. Dihua Yu."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;IMMUNOTHERAPY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Immunotherapy is a type of cancer treatment mentioned in the press release, highlighting Dihua Yu's innovative approach."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;RESEARCH PAPERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Papers are documents that Dr. Sophia Patel is reviewing to find inspiration for her own project."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;TARGETING CDK4/6&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Targeting CDK4/6 is a specific area of research mentioned in Dihua Yu's publication in Cancer Research."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;IMMUNOTHERAPY BREAKTHROUGH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An immunotherapy breakthrough is highlighted in the press release from Seoul National University Hospital, attributed to Dr. Dihua Yu."</data>
      <data key="d2">cb-0439</data>
    </node>
    <node id="&quot;STALLED RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stalled Research is the state of Dr. Sophia Patel's own research project, which she is eager to advance."</data>
      <data key="d2">cb-0439</data>
    </node>
    <edge source="&quot;DIHUA YU&quot;" target="&quot;THE UNIVERSITY OF TEXAS MD ANDERSON CANCER CENTER&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Dihua Yu has worked at The University of Texas MD Anderson Cancer Center, as evidenced by multiple sources including his ORCID profile, a publication in Cancer Research, and a news article from the MD Anderson Cancer Center website."</data>
      <data key="d5">"affiliation, research collaboration"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;DIHUA YU&quot;" target="&quot;SEOUL NATIONAL UNIVERSITY HOSPITAL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Dihua Yu is rumored to be based at Seoul National University Hospital and has made significant contributions to cancer research there, as indicated by a press release from the hospital."</data>
      <data key="d5">"rumored affiliation, research impact"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;DIHUA YU&quot;" target="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Dr. Sophia Patel is inspired by Dihua Yu's work and is considering reaching out to him for guidance, driven by her own stalled research and the desire to unlock the secrets of her project."</data>
      <data key="d5">"inspiration, mentorship potential"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;DIHUA YU&quot;" target="&quot;CANCER RESEARCH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dihua Yu has published a paper titled 'Targeting CDK4/6 in Cancer Therapy' in the journal Cancer Research."</data>
      <data key="d5">"publication, research contribution"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;DIHUA YU&quot;" target="&quot;ORCID&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Dihua Yu is listed as a member of ORCID, a non-profit organization that provides a unique identifier for researchers."</data>
      <data key="d5">"affiliation, identification"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;SEOUL NATIONAL UNIVERSITY HOSPITAL&quot;" target="&quot;PRESS RELEASE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A press release from Seoul National University Hospital touts a major breakthrough in cancer treatment, quoting Dr. Dihua Yu."</data>
      <data key="d5">"public recognition, research impact"</data>
      <data key="d6">cb-0439</data>
    </edge>
    <edge source="&quot;CANCER RESEARCH&quot;" target="&quot;TARGETING CDK4/6&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The paper 'Targeting CDK4/6 in Cancer Therapy' is published in the journal Cancer Research."</data>
      <data key="d5">"publication, research focus"</data>
      <data key="d6">cb-0439</data>
    </edge>
  </graph>
