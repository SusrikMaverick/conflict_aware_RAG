<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HUGHESVILLE, MARYLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hughesville, Maryland is a census-designated place (CDP) in Charles County, Maryland, United States. It has historical and geographical details and was a tobacco market town."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;BACHELOR'S DEGREE&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Bachelor's degree represents the educational attainment level where individuals have completed a four-year undergraduate program."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;MASTER'S DEGREE&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Master's degree indicates the educational attainment level where individuals have completed a two-year graduate program after obtaining a bachelor's degree."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;PROFESSIONAL SCHOOL DEGREE&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Professional school degree signifies the educational attainment level where individuals have completed specialized programs such as law, medicine, or business after obtaining a bachelor's degree."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;DOCTORATE DEGREE&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Doctorate degree denotes the highest level of educational attainment where individuals have completed extensive research and a dissertation after obtaining a master's or professional school degree."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;NURSERY, PRESCHOOL&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Nursery and preschool represent early childhood education levels where children typically attend before starting formal schooling."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;KINDERGARTEN&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Kindergarten is the first year of formal schooling for many children, usually followed by primary grades."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;GRADE 1 TO 4&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Grades 1 to 4 represent the early years of primary education, also known as elementary school."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;GRADE 5 TO 8&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Grades 5 to 8 represent the middle years of primary education, often referred to as intermediate or junior high school."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;GRADE 9 TO 12&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Grades 9 to 12 represent the final years of secondary education, also known as high school."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;COLLEGE UNDERGRAD&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"College undergrad refers to the first four years of higher education, typically leading to a bachelor's degree."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;GRADUATE OR PROFESSIONAL&quot;">
      <data key="d0">"EDUCATION"</data>
      <data key="d1">"Graduate or professional education includes postgraduate studies such as master's, doctoral, or professional degrees."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;EDUCATIONAL ATTAINMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Educational Attainment refers to the level of education achieved by an individual or a population."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <node id="&quot;SCHOOL ENROLLMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"School Enrollment refers to the number of students enrolled in various educational stages."</data>
      <data key="d2">ramdocs-0376-ebe7966f04dd</data>
    </node>
    <edge source="&quot;BACHELOR'S DEGREE&quot;" target="&quot;MASTER'S DEGREE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Master's degree is obtained after completing a bachelor's degree, indicating a progression in educational attainment."</data>
      <data key="d5">"academic progression, higher education"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;BACHELOR'S DEGREE&quot;" target="&quot;PROFESSIONAL SCHOOL DEGREE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Professional school degree is obtained after completing a bachelor's degree, indicating a progression in educational attainment."</data>
      <data key="d5">"academic progression, specialized education"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;BACHELOR'S DEGREE&quot;" target="&quot;DOCTORATE DEGREE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Doctorate degree is obtained after completing a master's or professional school degree, indicating a progression in educational attainment."</data>
      <data key="d5">"academic progression, highest education"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;NURSERY, PRESCHOOL&quot;" target="&quot;KINDERGARTEN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Kindergarten follows nursery and preschool, representing the next stage in early childhood education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;KINDERGARTEN&quot;" target="&quot;GRADE 1 TO 4&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Grade 1 to 4 follows kindergarten, representing the next stage in primary education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;GRADE 1 TO 4&quot;" target="&quot;GRADE 5 TO 8&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Grade 5 to 8 follows grade 1 to 4, representing the next stage in primary education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;GRADE 5 TO 8&quot;" target="&quot;GRADE 9 TO 12&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Grade 9 to 12 follows grade 5 to 8, representing the next stage in secondary education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;GRADE 9 TO 12&quot;" target="&quot;COLLEGE UNDERGRAD&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"College undergrad follows grade 9 to 12, representing the next stage in higher education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
    <edge source="&quot;COLLEGE UNDERGRAD&quot;" target="&quot;GRADUATE OR PROFESSIONAL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Graduate or professional education follows college undergrad, representing the next stage in higher education."</data>
      <data key="d5">"sequential education, developmental stages"</data>
      <data key="d6">ramdocs-0376-ebe7966f04dd</data>
    </edge>
  </graph>
</graphml>
