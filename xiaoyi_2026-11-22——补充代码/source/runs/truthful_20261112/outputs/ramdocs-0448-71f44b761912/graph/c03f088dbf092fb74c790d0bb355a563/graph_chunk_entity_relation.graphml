    <node id="&quot;SIMEON P. SMITH HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Simeon P. Smith House is a historic house located at 154 High Street in Portsmouth, New Hampshire, built in 1810-11, and listed on the National Register of Historic Places on November 14, 1972."</data>
      <data key="d2">ramdocs-0448-71f44b761912</data>
    </node>
