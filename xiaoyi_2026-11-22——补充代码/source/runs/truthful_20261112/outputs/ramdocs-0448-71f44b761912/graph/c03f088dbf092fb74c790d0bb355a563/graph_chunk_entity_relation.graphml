      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Hill is a cluster of historic properties in Portsmouth, New Hampshire, located south of Deer and High streets, created as part of a road widening project."</data>
      <data key="d2">ramdocs-0448-71f44b761912</data>
    </node>
