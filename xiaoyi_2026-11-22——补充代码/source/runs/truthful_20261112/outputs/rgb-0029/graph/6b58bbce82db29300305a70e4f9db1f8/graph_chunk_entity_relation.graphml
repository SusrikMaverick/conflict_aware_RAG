  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MAXWELL AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Maxwell Award is a prestigious award given annually since 1937 to recognize outstanding achievements in college football."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;DEVONTA SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"DeVonta Smith is a recipient of the Maxwell Award in 2020, playing for the University of Alabama."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;UNIVERSITY OF ALABAMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Alabama is the alma mater of DeVonta Smith and a notable institution in college football."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;JOE BURROW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Burrow is a recipient of the Maxwell Award in 2019, playing for Louisiana State University."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;LOUISIANA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Louisiana State University is the alma mater of Joe Burrow and a prominent college football program."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;TUA TAGOVAILOA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tua Tagovailoa is a recipient of the Maxwell Award in 2018, playing for the University of Alabama."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;JOHNNY MANZIEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johnny Manziel is a recipient of the Maxwell Award in 2019, playing for Louisiana State University."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;CREDIT UNION NATIONAL ASSOCIATION (CUNA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Credit Union National Association (CUNA) is the organization that administers the Dora Maxwell Social Responsibility Award."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;DORA MAXWELL SOCIAL RESPONSIBILITY AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dora Maxwell Social Responsibility Award is another prestigious award administered by CUNA, separate from the Maxwell Award."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2020 is the year when DeVonta Smith won the Maxwell Award."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2019 is the year when Joe Burrow and Johnny Manziel won the Maxwell Award."</data>
      <data key="d2">rgb-0029</data>
    </node>
    <node id="&quot;2018&quot;">
      <data key="d0">"EVENT"</data>
