  <graph edgedefault="undirected">
    <node id="&quot;OGNISSANTI, MANTUA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ognissanti, Mantua is a Baroque style, Roman Catholic church located on Corso Vittorio Emanuele in Mantua, Lombardy, Italy."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;MATILDE OF CANOSSA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Matilde of Canossa is reputed to have granted the Ognissanti church around 1080 to the Abbey of Polirone in San Benedetto Po."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;ABBEY OF POLIRONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Abbey of Polirone in San Benedetto Po received the Ognissanti church from Matilde of Canossa."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;POPE ADRIAN IV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Adrian IV is ascribed to have given the Ognissanti church to the Benedictines as a gift in 1159."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;BENEDICTINES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Benedictines are ascribed to have received the Ognissanti church as a gift from Pope Adrian IV in 1159."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;CORSO VITTORIO EMANUELE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Corso Vittorio Emanuele is the street where the Ognissanti church is located in Mantua, Lombardy, Italy."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;LOMBARDY, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lombardy, Italy is the region where the Ognissanti church is located in Mantua."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;OGNISSANTI, VENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ognissanti, Venice is a 16th-century Roman Catholic church located in the Dorsoduro sestiere of Venice."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;CISTERCIAN NUNS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cistercian nuns previously occupied the area where the current church is located in Venice."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;TORCELLO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Torcello is a nearby island where the Cistercian nuns originally came from before moving to Venice."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;DORSODURO SESTIERE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dorsoduro sestiere is the area in Venice where the current church is located."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;NAPOLEON BONAPARTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Napoleon Bonaparte suppressed the church and nunnery in Ognissanti, Venice in 1807."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;GIUSTINIAN HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Giovan Battista Giustinian converted the church into a convalescent facility for elderly people, later turning it into a hospital."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;FLORENCE, TUSCANY, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence, Tuscany, Italy is the region where the chiesa di San Salvatore di Ognissanti is located."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;UMILIATI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The lay order of the Umiliati founded the church of Ognissanti in Florence, dedicating it to all the saints and martyrs."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;BARTOLOMEO PETTIROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bartolomeo Pettirossi completed the Baroque-style reconstruction of the church in Florence in 1627."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;MATTEO NIGETTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Matteo Nigetti designed the new façade of the church in Florence in 1637."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;RIO OGNISSANTI AND THE CHURCH OF THE GESUITI, VENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio Ognissanti and the church of the Gesuiti, Venice are depicted in paintings by Franz Richard Unterberger."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;RIO ST. GERONIMO, VENEZIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio St. Geronimo, Venezia is depicted in a painting by Franz Richard Unterberger."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;A VIEW IN VENICE, RIO S. MARINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A View in Venice, Rio S. Marina is depicted in a painting by Franz Richard Unterberger."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;RIO SANTA BARNABA, VENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio Santa Barnaba, Venice is depicted in a painting by Franz Richard Unterberger."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;RIO ST. BARNABA, VENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio St. Barnaba, Venice is depicted in a painting by Franz Richard Unterberger."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;THE CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The church is described as having a moving atmosphere and notable architecture, specifically Baroque style, located in Florence."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;OGNISSANTI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ognissanti is a specific church in Florence known for its Baroque architecture and historical renovations."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is the city where the church Ognissanti is located, known for its architectural heritage."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;BAROQUE ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Baroque architecture is a style characterized by the church's facade, which is a notable feature of Ognissanti."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;THE CHURCH'S ATMOSPHERE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The church's atmosphere is described as incredibly moving, indicating a spiritual or emotional impact."</data>
      <data key="d2">ramdocs-0365-fa0026c7c7b3</data>
    </node>
    <node id="&quot;INSTAGRAM-WORTHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Instagram-Worthy refers to the quality of photos that would appeal to social media followers."</data>
