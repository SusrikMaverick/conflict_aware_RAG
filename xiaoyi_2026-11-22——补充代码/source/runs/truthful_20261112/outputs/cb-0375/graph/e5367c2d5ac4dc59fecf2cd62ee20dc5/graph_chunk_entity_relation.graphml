  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COLIN R MACKENZIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colin R MacKenzie is a renowned researcher known for his contributions to materials science and structural geology, with affiliations at both the University of Düsseldorf and the USGS."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;UNIVERSITY OF DÜSSELDORF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Düsseldorf is a prestigious institution where Colin R MacKenzie held a research position from 2015 to 2018, contributing to various projects and collaborating with esteemed colleagues."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;USGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Geological Survey (USGS) is an agency where Colin R MacKenzie has worked since 1990, contributing significantly to the field of geology and leading projects such as the National Geologic Mapping Program."&lt;SEP&gt;"USGS is an agency that MacKenzie works with, emphasizing its role in advancing our understanding of the world through scientific research."&lt;SEP&gt;"USGS is an agency that MacKenzie works with, emphasizing its role in advancing scientific understanding."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;DR. ANNA-LENA SCHUMANN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Anna-Lena Schumann is a colleague of Colin R MacKenzie at the University of Düsseldorf, corroborating his affiliation and contributions."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;PROFESSOR DR. JÜRGEN SCHMID&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Dr. Jürgen Schmid is the Dean of the Faculty of Mathematics and Natural Sciences at the University of Düsseldorf, providing insights into MacKenzie's tenure at the university."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a colleague and fellow USGS researcher who acknowledges MacKenzie's contributions to the National Geologic Mapping Program."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;NATIONAL GEOLOGIC MAPPING PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The National Geologic Mapping Program is a flagship project led by Colin R MacKenzie at the USGS, which developed new mapping techniques now considered industry standards."&lt;SEP&gt;"The National Geologic Mapping Program is a flagship project led by MacKenzie at the USGS, which developed new mapping techniques now considered industry standards."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;TECTONIC EVOLUTION OF THE ROCKY MOUNTAINS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The tectonic evolution of the Rocky Mountains is a high-profile project involving Colin R MacKenzie at the USGS, which helped in understanding the complex relationships between tectonic plates."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;NATURE COMMUNICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Communications is an esteemed journal where MacKenzie co-authored a paper, highlighting his contributions to the field of materials science."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Materials Science Research is the topic of a co-authored paper by MacKenzie, published in Nature Communications, showcasing his expertise in materials science."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;STRUCTURAL GEOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Structural Geology is a field of study where MacKenzie has made significant contributions during his tenure at the USGS."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;ROCKY MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Rocky Mountains are the subject of a high-profile project involving MacKenzie at the USGS, which helped in understanding the complex relationships between tectonic plates."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;USGS DIRECTOR'S AWARD FOR EXCELLENCE IN SCIENCE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The USGS Director's Award for Excellence in Science is an award that recognizes MacKenzie's significant contributions to the field of geology."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;WASHINGTON D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington D.C. is the location where MacKenzie reflects on his illustrious career with the USGS."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;RESEARCHER EMERITUS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Researcher emeritus is the current role of MacKenzie with the USGS, where he continues to mentor the next generation of geologists and scientists."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;NEXT GENERATION OF GEOLOGISTS AND SCIENTISTS&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"The next generation of geologists and scientists are mentored by MacKenzie in his current role as a researcher emeritus with the USGS."&lt;SEP&gt;"The next generation of geologists and scientists are mentored by MacKenzie, indicating a future focus in scientific research."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;MACKENZIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"MacKenzie is a researcher emeritus at the USGS, known for mentoring the next generation of geologists and scientists and serving as a reminder of the importance of continued investment in scientific research."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;SCIENTIFIC RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Scientific research is a core activity of USGS and is emphasized by MacKenzie's work, highlighting its importance."</data>
      <data key="d2">cb-0375</data>
    </node>
    <node id="&quot;CONTINUED INVESTMENT IN SCIENTIFIC RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Continued investment in scientific research is highlighted as important by MacKenzie, underscoring the need for ongoing support."</data>
      <data key="d2">cb-0375</data>
    </node>
