<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;RUSH TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rush Township is a township in Scioto County, Ohio, and also exists in Tuscarawas County, Ohio. It has varying populations and governance structures."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;SCIOTO COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scioto County is a county in Ohio, containing Rush Township."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ohio is a state in the United States, containing Scioto and Tuscarawas Counties, and Rush Township."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;TUSCARAWAS COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscarawas County is a county in Ohio, containing Rush Township."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;DR. BENJAMIN RUSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Benjamin Rush was an early physician and Founding Father of the United States, after whom Rush Township is named."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;LEVI KIRKENDALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Levi Kirkendall organized Rush Township on June 3, 1867."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;MCDERMOTT&quot;">
      <data key="d0">"UNINCORPORATED COMMUNITY"</data>
      <data key="d1">"McDermott is an unincorporated community located in the western part of Rush Township, Scioto County."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;GNADENHUTTEN&quot;">
      <data key="d0">"VILLAGE"</data>
      <data key="d1">"Part of the village of Gnadenhutten is located in northwestern Rush Township, Tuscarawas County."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;STILLWATER&quot;">
      <data key="d0">"UNINCORPORATED COMMUNITY"</data>
      <data key="d1">"Stillwater is an unincorporated community located in the eastern part of Rush Township, Tuscarawas County."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;CHAMPAIGN COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Champaign County is a county in Ohio, containing other Rush Townships."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;TUSCARAWAS COUNTY, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscarawas County, Ohio, contains Rush Township and other features such as the village of Gnadenhutten and the unincorporated community of Stillwater."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;SCIOTO COUNTY, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scioto County, Ohio, contains Rush Township and the unincorporated community of McDermott."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States contains Ohio and its counties, including Scioto and Tuscarawas, and the townships within them."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;EARLY 19TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The earliest settlers of Rush Township date back to the early 19th century."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;JUNE 3, 1867&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Rush Township was organized on June 3, 1867."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;NOVEMBER OF ODD-NUMBERED YEARS&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The township is governed by a three-member board of trustees, who are elected in November of odd-numbered years to a four-year term."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;THREE-MEMBER BOARD OF TRUSTEES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The township is governed by a three-member board of trustees."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <node id="&quot;FOUR-YEAR TERM&quot;">
      <data key="d0">"DURATION"</data>
      <data key="d1">"The three-member board of trustees serves a four-year term."</data>
      <data key="d2">ramdocs-0135-3c11cba04a51</data>
    </node>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;SCIOTO COUNTY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Rush Township is located in Scioto County, Ohio."</data>
      <data key="d5">"location, jurisdiction"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;TUSCARAWAS COUNTY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Rush Township is also located in Tuscarawas County, Ohio."</data>
      <data key="d5">"location, jurisdiction"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;DR. BENJAMIN RUSH&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Rush Township is named after Dr. Benjamin Rush, an early physician and Founding Father of the United States."</data>
      <data key="d5">"named after, historical figure"</data>
