      <data key="d5">"establishment, founder"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;MCDERMOTT&quot;">
