      <data key="d5">"community, location"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;GNADENHUTTEN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Part of the village of Gnadenhutten is located in Rush Township, Tuscarawas County."</data>
      <data key="d5">"community, location"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;STILLWATER&quot;">
