      <data key="d5">"related townships, location"</data>
      <data key="d6">ramdocs-0135-3c11cba04a51</data>
    </edge>
    <edge source="&quot;RUSH TOWNSHIP&quot;" target="&quot;TUSCARAWAS COUNTY, OHIO&quot;">
      <data key="d3">8.0</data>
