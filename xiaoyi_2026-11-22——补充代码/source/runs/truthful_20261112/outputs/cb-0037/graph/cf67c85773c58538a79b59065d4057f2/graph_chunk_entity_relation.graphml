  <graph edgedefault="undirected">
    <node id="&quot;LUNG KWANG PAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lung Kwang Pan is a researcher with an ORCID ID of 0000-0002-9485-4722, known for his work on nanomaterials and quantum dots, and attended Georgia Tech and Wayne State University."</data>
      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;GEORGIA TECH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Georgia Tech is a public research university in Atlanta, Georgia, United States, where Lung Kwang Pan attended."</data>
      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;WAYNE STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wayne State University is a public research university located in Detroit, Michigan, where Lung Kwang Pan was a member of the Physics Club and presented his thesis on quantum dots."</data>
      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;DETROIT RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Detroit River is a river that forms part of the border between the United States and Canada, near Wayne State University."</data>
      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;PHYSICS CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
