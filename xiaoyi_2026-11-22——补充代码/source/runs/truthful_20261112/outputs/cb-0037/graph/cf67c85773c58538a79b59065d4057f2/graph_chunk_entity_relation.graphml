    </node>
    <node id="&quot;DR. HENRY LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Henry Lee is a former professor at Wayne State University who taught during the mid-1990s and remembers Lung Kwang Pan's time at the university."</data>
      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;CUTTING-EDGE MATERIALS SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
