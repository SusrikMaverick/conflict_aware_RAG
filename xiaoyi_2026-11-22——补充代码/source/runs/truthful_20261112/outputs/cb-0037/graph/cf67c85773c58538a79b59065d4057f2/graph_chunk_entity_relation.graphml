      <data key="d2">cb-0037</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ORCID is a non-profit organization that provides a unique identifier for researchers to ensure accurate attribution of authorship and contributions."</data>
      <data key="d2">cb-0037</data>
