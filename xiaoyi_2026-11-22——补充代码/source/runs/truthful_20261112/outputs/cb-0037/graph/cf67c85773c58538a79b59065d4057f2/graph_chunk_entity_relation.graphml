    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a current researcher at Wayne State University, investigating the history of the university and the contributions of past students like Lung Kwang Pan."</data>
