<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRENCH EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Empire established a protectorate over Tunisia in 1881, lasting nearly eight decades."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tunisia is a North African country under French protectorate during Hassan Nasr's early years."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;HASSAN NASR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hassan Nasr is a Tunisian writer born in 1881, known for his critiques of French colonial rule."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;VICTOR HUGO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Victor Hugo is a French writer whose works influenced Hassan Nasr."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;GUSTAVE FLAUBERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gustave Flaubert is a French writer whose works influenced Hassan Nasr."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;THE WHISPERING WALLS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Whispering Walls is Hassan Nasr's debut novel, published in 1920, critiquing French colonial rule."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;THE FORGOTTEN CITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Forgotten City is Hassan Nasr's 1935 novel exploring the life of Tunisians under French rule."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;LJUBLJANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ljubljana is a city in Slovenia where Hassan Nasr visits and feels a sense of belonging."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;SLOVENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slovenia is a Central European country where Hassan Nasr finds a sense of home and inspiration."&lt;SEP&gt;"Slovenia is the country where Hassan has made his home and where he considers himself a citizen."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;MARKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marko is a Slovenian writer and friend of Hassan Nasr, sharing his passion for literature."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;CARTHAGINIANS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Carthaginians are mentioned as a historical group that once ruled over the Mediterranean coast of North Africa, influencing Hassan Nasr's storytelling."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;FRENCH PROTECTORATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Protectorate of Tunisia was established in 1881 and lasted until 1956, governing Tunisia under French rule."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;ANCIENT TUNIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ancient Tunis is the city where Hassan Nasr was born, known for its historical and cultural significance."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;MOSQUES AND MADRASAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mosques and Madrasas are religious institutions in Ancient Tunis where Hassan Nasr grew up, adorned with Arabic calligraphy."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TRICOLOR FLAG&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The Tricolor Flag represents the French presence in Tunisia, symbolizing the colonial rule."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;FRENCH ADMINISTRATORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French Administrators are the officials who governed Tunisia under the French Protectorate, often seen in uniform."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;LOCAL LIBRARIES AND BOOKSTORES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Local Libraries and Bookstores are places where Hassan Nasr read French literature and developed his love for literature."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;ARABIC CALLIGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Arabic Calligraphy is a form of art and writing that adorned the walls of mosques and madrasas in Ancient Tunis."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN LITERATURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Literature is the body of work produced by Tunisian writers, including Hassan Nasr, reflecting the cultural and political landscape."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;FRENCH LANGUAGE&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"French Language was imposed upon Tunisia by the colonial powers and became an integral part of the country's cultural fabric."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Heritage includes the cultural traditions and values of the Tunisian people, preserved despite French influence."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;FRENCH OCCUPATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"French Occupation refers to the period of French rule in Tunisia, during which Hassan Nasr lived and wrote."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN CULTURAL FABRIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Cultural Fabric encompasses the blend of traditional Tunisian culture and the influence of French colonialism."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN RESISTANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Resistance includes the efforts of Tunisians to resist and challenge French colonial rule, reflected in Hassan Nasr's writings."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN WRITERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tunisian Writers are the community of writers who produced literature during the French Protectorate era."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN GRAND MOSQUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tunisian Grand Mosque is a significant religious site in Tunis, where Hassan Nasr likely spent time."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN MADRASA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tunisian Madrasa is an educational institution in Tunis, where Hassan Nasr likely received some of his education."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN HERITAGE PRESERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Heritage Preservation involves the efforts to maintain and preserve traditional Tunisian culture and values."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN STORYTELLING TRADITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Storytelling Tradition includes the oral and written narratives passed down through generations, influencing Hassan Nasr's work."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tunisian Family is the social unit within which Hassan Nasr grew up, influencing his worldview and literary style."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN GRANDMOTHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tunisian Grandmother is a significant figure in Hassan Nasr's life, telling stories of the ancient Carthaginians."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN CULTURAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian Cultural Identity is the sense of self and cultural heritage that Hassan Nasr explores in his writings."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN LITERARY CIRCLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tunisian Literary Circles are the groups of Tunisian writers and intellectuals who supported and promoted Tunisian literature."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunisian History includes the historical events and periods that shaped the cultural and political landscape of Tunisia."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tunisian Society is the broader social context within which Hassan Nasr lived and wrote."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;TUNISIAN BLOOD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tunisian blood symbolizes Hassan's heritage and cultural roots, originating from Tunisia."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;SLOVENIAN SOIL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slovenian soil represents the land where Hassan now lives and considers his home, indicating a sense of belonging."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;HASSAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hassan is a character who identifies himself as a citizen of Slovenia, a writer, and a keeper of secrets."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;WRITER OF TALES&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Writer of tales describes Hassan's profession and passion for storytelling."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;KEEPER OF SECRETS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Keeper of secrets indicates Hassan's role in preserving and guarding certain information."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;CITIZEN OF SLOVENIA&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Citizen of Slovenia is Hassan's current legal status and identity."</data>
      <data key="d2">cb-0059</data>
    </node>
    <node id="&quot;STORIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stories represent the narratives and connections that tie Hassan's heritage and current life together."</data>
      <data key="d2">cb-0059</data>
    </node>
    <edge source="&quot;FRENCH EMPIRE&quot;" target="&quot;HASSAN NASR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Hassan Nasr was born and lived under the French protectorate of Tunisia, influenced by French colonialism."</data>
      <data key="d5">"colonial influence, upbringing"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;VICTOR HUGO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hassan Nasr was influenced by the works of Victor Hugo, a French writer."</data>
      <data key="d5">"literary influence, inspiration"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;GUSTAVE FLAUBERT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hassan Nasr was influenced by the works of Gustave Flaubert, another French writer."</data>
      <data key="d5">"literary influence, inspiration"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;THE WHISPERING WALLS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Hassan Nasr published 'The Whispering Walls,' a critique of French colonial rule in 1920."</data>
      <data key="d5">"publication, political commentary"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;THE FORGOTTEN CITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Hassan Nasr wrote 'The Forgotten City,' exploring the life of Tunisians under French rule in 1935."</data>
      <data key="d5">"publication, cultural exploration"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;LJUBLJANA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hassan Nasr visits Ljubljana and feels a sense of belonging, finding inspiration in the city's culture and history."</data>
      <data key="d5">"cultural connection, inspiration"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;SLOVENIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Hassan Nasr finds a sense of home and inspiration in Slovenia, feeling a deep connection to the country."</data>
      <data key="d5">"cultural connection, identity"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;MARKO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hassan Nasr and Marko share a passion for literature and storytelling, discussing tales of Slovenian heroes and their struggles."</data>
      <data key="d5">"friendship, literary collaboration"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN NASR&quot;" target="&quot;CARTHAGINIANS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Hassan Nasr draws inspiration from the stories of Carthaginians, reflecting on their bravery and determination in his writing."</data>
      <data key="d5">"inspiration, cultural heritage"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;SLOVENIA&quot;" target="&quot;HASSAN&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Hassan is a citizen of Slovenia, indicating his legal and emotional connection to the country."</data>
      <data key="d5">"citizenship, belonging"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;TUNISIAN BLOOD&quot;" target="&quot;HASSAN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Hassan's Tunisian blood represents his heritage and connects him to his cultural roots."</data>
      <data key="d5">"heritage, identity"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;SLOVENIAN SOIL&quot;" target="&quot;HASSAN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Slovenian soil is where Hassan now lives and considers his home, symbolizing his current identity and sense of belonging."</data>
      <data key="d5">"home, identity"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN&quot;" target="&quot;WRITER OF TALES&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Hassan's role as a writer of tales reflects his profession and passion for storytelling."</data>
      <data key="d5">"profession, storytelling"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN&quot;" target="&quot;KEEPER OF SECRETS&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Hassan's role as a keeper of secrets suggests he has important information to protect and preserve."</data>
      <data key="d5">"secrecy, responsibility"</data>
      <data key="d6">cb-0059</data>
    </edge>
    <edge source="&quot;HASSAN&quot;" target="&quot;STORIES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Stories connect Hassan's heritage and current life, representing the narratives that tie them together."</data>
      <data key="d5">"narrative, connection"</data>
      <data key="d6">cb-0059</data>
    </edge>
  </graph>
</graphml>
