  <graph edgedefault="undirected">
    <node id="&quot;MANCHESTER UNITED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Manchester United is a football club where Ryan initially had a trial and eventually signed as an apprentice and then a professional player."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;RYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ryan is a footballer who had trials and signed with Manchester United, made his first-team debut, and played for various clubs."&lt;SEP&gt;"Ryan is the leader in 1888.")</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;ASTON VILLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aston Villa is a football club where Ryan scored his first goal in a match."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;ACCRINGTON STANLEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Accrington Stanley is a football club where Ryan performed well and was selected in the PFA Team of the Year."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;SCUNTHORPE UNITED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Scunthorpe United is a football club where Ryan signed a two-year contract."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;CHESTERFIELD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chesterfield is a football club where Ryan signed a one-year contract."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;FLEETWOOD TOWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fleetwood Town is a football club where Ryan signed on a free transfer."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;BOLTON WANDERERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bolton Wanderers is a football club where Ryan played for multiple seasons and held the position of defender."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;RANGERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
