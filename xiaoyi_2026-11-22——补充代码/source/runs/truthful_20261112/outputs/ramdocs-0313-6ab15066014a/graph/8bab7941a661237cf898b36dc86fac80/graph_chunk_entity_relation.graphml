    <node id="&quot;MATTHEW C. (MATTY) WALSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Matthew C. (Matty) Walsh is a partner who co-owned the club with Jimmy Ryan's brother-in-law."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;JIMMY RYAN (1911–1963)&quot;">
