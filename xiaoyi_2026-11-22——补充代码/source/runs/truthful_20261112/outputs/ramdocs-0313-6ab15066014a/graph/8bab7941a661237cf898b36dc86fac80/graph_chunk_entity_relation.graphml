    </node>
    <node id="&quot;MIDDLESBROUGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Middlesbrough is a football club where Ryan played for three seasons and was a key player."</data>
      <data key="d2">ramdocs-0313-6ab15066014a</data>
    </node>
    <node id="&quot;BRAY WANDERERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
