  <graph edgedefault="undirected">
    <node id="&quot;PHILADELPHIA ATOMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Philadelphia Atoms were an expansion team in the 1973 North American Soccer League, competing in the NASL Final 1973 and winning the championship match."</data>
      <data key="d2">ramdocs-0019-60e220b9848a</data>
    </node>
    <node id="&quot;DALLAS TORNADO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dallas Tornado was a team in the 1973 North American Soccer League, competing in the NASL Final 1973 and winning the Southern Division."</data>
      <data key="d2">ramdocs-0019-60e220b9848a</data>
    </node>
    <node id="&quot;NASL FINAL 1973&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"NASL Final 1973 was the championship match of the 1973 season, contested between the Philadelphia Atoms and the Dallas Tornado."</data>
      <data key="d2">ramdocs-0019-60e220b9848a</data>
    </node>
    <node id="&quot;TEXAS STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Texas Stadium in Irving, Texas, was the venue for the NASL Final 1973 match."</data>
      <data key="d2">ramdocs-0019-60e220b9848a</data>
    </node>
    <node id="&quot;NEW YORK COSMOS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York Cosmos are mentioned as a team in the NASL, previously the defending champions."&lt;SEP&gt;"New York Cosmos were a team in the NASL, defeated by the Dallas Tornado in the playoffs."</data>
      <data key="d2">ramdocs-0019-60e220b9848a</data>
    </node>
    <node id="&quot;ED FARNSWORTH&quot;">
