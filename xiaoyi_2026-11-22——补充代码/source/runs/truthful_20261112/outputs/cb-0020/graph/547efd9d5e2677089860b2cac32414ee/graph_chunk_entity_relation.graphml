<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HENRIETTA MARIA O'DONEL WHITE CULPEPER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henrietta Maria O'Donel White Culpeper is a member of the landed gentry, elegant, refined, and intelligent, with a strong will and a deep connection to her husband Christopher Barton."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;CHRISTOPHER BARTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christopher Barton is a rising star in the world of politics, a tall, dark-haired man who captures Henrietta's heart and brings her wildflowers as a surprise."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;LOUIS SYMONDS TINDAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louis Symonds Tindal is a dashing British Royal Navy officer, ambitious, and adventurous, who falls in love with Henrietta Maria O'Donel White Culpeper."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;CULPEPER ESTATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Culpeper Estate is the ancestral home of Henrietta Maria O'Donel White Culpeper, a quiet corner of England where she feels a sense of peace."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;PLYMOUTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Plymouth is a bustling port city where Louis Symonds Tindal is stationed in the Royal Navy during the 19th century."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;KENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kent is the picturesque countryside where Henrietta Maria O'Donel White Culpeper lives a life of quiet elegance before meeting Louis Symonds Tindal."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;PRIME MINISTER'S OFFICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prime Minister's Office is the place where Christopher Barton works, calling him back to London after their meeting."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;BRITISH EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Empire is at its zenith during the 19th century, with unmatched naval prowess and the Industrial Revolution in full swing."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Navy is the branch of the British military where Louis Symonds Tindal serves, making a name for himself as an ambitious officer."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;1915&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1915 is the year when Henrietta Maria O'Donel White Culpeper meets Christopher Barton, a chilly autumn evening marked by the world at war."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;1835&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1835 is the year when Louis Symonds Tindal is stationed in Plymouth, marking the beginning of his and Henrietta's romance."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;1837&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1837 is the year when Henrietta Maria O'Donel White Culpeper marries Louis Symonds Tindal, a union that brings together two families from different backgrounds."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;19TH CENTURY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"19th century is the period when both Henrietta and Louis meet and fall in love, marked by the Industrial Revolution and the height of the British Empire."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;WORLD AT WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World at war is the context in which Henrietta and Christopher meet, highlighting the tension and uncertainty of the times."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;INDUSTRIAL REVOLUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Industrial Revolution is the backdrop against which Louis Symonds Tindal makes a name for himself in the Royal Navy."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;UNITED EUROPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"United Europe is the dream shared by Christopher Barton, representing a future of unity and cooperation."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;FRESH AIR AND HORSE SWEAT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fresh air and horse sweat are sensory details that describe the environment and atmosphere of their meeting."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;CIGAR SMOKE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cigar smoke is a detail that adds depth to the description of Christopher Barton's presence."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;MOTHS TO A FLAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Moths to a flame is a metaphor used to describe the attraction between Henrietta and Louis."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;DUTY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Duty is a theme that appears in the context of Christopher's work in the Prime Minister's Office and Louis's service in the Royal Navy."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;ADVENTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Adventure is a concept that Louis embodies, representing his life in the Royal Navy and his appeal to Henrietta."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;REFINEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Refinement is a quality that Henrietta brings to Louis's life, contrasting with his previous lack of such qualities."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;HENRIETTA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henrietta is a character who marries Louis and builds a life filled with love, laughter, and devotion."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;LOUIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louis is a character who marries Henrietta and builds a life filled with love, laughter, and devotion."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;1837 MARRIAGE CERTIFICATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1837 Marriage Certificate is a legal document that records the union of Henrietta and Louis, serving as a testament to their love and commitment."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;TWO FAMILIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Two Families are the groups from different backgrounds that Henrietta and Louis come from, eventually forging a bond."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;RECORDS OF THE TIME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Records of the Time are the historical documents where the 1837 Marriage Certificate is stored, providing evidence of the marriage."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;LOVE AND COMMITMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Love and Commitment refer to the emotional and legal bonds shared by Henrietta and Louis throughout their life together."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;BOND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bond refers to the strong emotional and familial connection formed between Henrietta and Louis's families."</data>
      <data key="d2">cb-0020</data>
    </node>
    <node id="&quot;LIFE TOGETHER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Life Together describes the period during which Henrietta and Louis lived and built their lives together, filled with love, laughter, and devotion."</data>
      <data key="d2">cb-0020</data>
    </node>
    <edge source="&quot;HENRIETTA MARIA O'DONEL WHITE CULPEPER&quot;" target="&quot;CHRISTOPHER BARTON&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Henrietta Maria O'Donel White Culpeper and Christopher Barton are deeply connected, with Henrietta feeling grateful for their chance encounter and Christopher sharing his dreams for a united Europe."</data>
      <data key="d5">"love, connection, shared dreams"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA MARIA O'DONEL WHITE CULPEPER&quot;" target="&quot;LOUIS SYMONDS TINDAL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Henrietta Maria O'Donel White Culpeper and Louis Symonds Tindal are drawn to each other, with Henrietta captivated by Louis's tales of adventure and Louis bringing refinement to his life."</data>
      <data key="d5">"romance, mutual attraction"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA MARIA O'DONEL WHITE CULPEPER&quot;" target="&quot;CULPEPER ESTATE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Henrietta Maria O'Donel White Culpeper lives at the Culpeper Estate, a quiet corner of England where she feels a sense of peace."</data>
      <data key="d5">"home, tranquility"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;CHRISTOPHER BARTON&quot;" target="&quot;PRIME MINISTER'S OFFICE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Christopher Barton works in the Prime Minister's Office, which calls him back to London after their meeting with Henrietta."</data>
      <data key="d5">"workplace, duty"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;LOUIS SYMONDS TINDAL&quot;" target="&quot;ROYAL NAVY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Louis Symonds Tindal serves in the Royal Navy, making a name for himself as an ambitious officer during the 19th century."</data>
      <data key="d5">"military service, ambition"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA&quot;" target="&quot;LOUIS&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Henrietta and Louis are married and build a life together, filled with love, laughter, and devotion."</data>
      <data key="d5">"marriage, lifelong commitment"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA&quot;" target="&quot;1837 MARRIAGE CERTIFICATE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The 1837 Marriage Certificate records the union of Henrietta and Louis, serving as a legal and emotional testament to their relationship."</data>
      <data key="d5">"legal documentation, love and commitment"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA&quot;" target="&quot;TWO FAMILIES&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Henrietta comes from one of the two families from different backgrounds that eventually forge a bond with Louis's family."</data>
      <data key="d5">"family background, bonding"</data>
      <data key="d6">cb-0020</data>
    </edge>
    <edge source="&quot;HENRIETTA&quot;" target="&quot;LOVE AND COMMITMENT&quot;">
      <data key="d3">9.0</data>
