  <graph edgedefault="undirected">
    <node id="&quot;DICK WOOD MALCOLM RICHARD WOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dick Wood Malcolm Richard Wood was an American football quarterback and coach who played college football at Auburn and professionally in the AFL. He was named to the All-State team in Alabama in 1954 and helped lead Auburn to an undefeated season in 1958. He was drafted by the Baltimore Colts in 1959 but never played."</data>
      <data key="d2">ramdocs-0138-5bc493a7cac1</data>
    </node>
    <node id="&quot;WILLIE WOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Willie Wood was a safety in professional football and later became a Pro Football Hall of Fame inductee. He was born on December 23, 1936, in Washington, D.C."</data>
      <data key="d2">ramdocs-0138-5bc493a7cac1</data>
    </node>
    <node id="&quot;USC TROJANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"USC Trojans is a college football team where Willie Wood was a three-time All-American during the 1972-74 seasons."</data>
      <data key="d2">ramdocs-0138-5bc493a7cac1</data>
    </node>
    <node id="&quot;NEW YORK JETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York Jets is a professional football team where Richard Wood played."</data>
