    <node id="&quot;GAL GADOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gal Gadot is an actress who portrays Diana Prince in multiple films, including Batman v Superman: Dawn of Justice, Wonder Woman, and Justice League."</data>
