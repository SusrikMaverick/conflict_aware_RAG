<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRIEDRICH VON AMERLING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friedrich von Amerling was a master painter and court painter to the Austrian imperial family, known for his portraits of royalty and nobility, and later discovered to be a member of the European Parliament."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;HABSBURG EMPIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Habsburg Empire was a historical empire where Friedrich von Amerling held a prestigious position as a court painter."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;VIENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vienna is the birthplace of Friedrich von Amerling and a significant location in his life, where he received early training in painting."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;AUSTRIAN IMPERIAL FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Austrian imperial family includes the Emperor and his family, for whom Friedrich von Amerling painted portraits."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EMPRESS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Empress is a member of the Austrian imperial family, to whom Friedrich von Amerling was introduced through his future wife, Antonie Kaltenthaler."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;SCHÖNBRUNN PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Schönbrunn Palace is a significant location where Friedrich von Amerling attended lavish balls and receptions as a frequent guest."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;ARCHDUCHESS MARIE LOUISE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Archduchess Marie Louise is a member of the Austrian imperial family, for whom Friedrich von Amerling received a commission to paint a portrait in 1824."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EMPEROR FRANCIS I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emperor Francis I is a member of the Austrian imperial family, who commissioned Friedrich von Amerling to paint a portrait of his daughter, Archduchess Marie Louise, in 1824."&lt;SEP&gt;"Emperor Francis I was the Emperor of Austria who commissioned Friedrich von Amerling to paint a portrait of his daughter, Archduchess Marie Louise, in 1824."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EMPEROR FERDINAND I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emperor Ferdinand I is a member of the Austrian imperial family, whose likeness was captured by Friedrich von Amerling in a 1832 portrait."&lt;SEP&gt;"Emperor Ferdinand I was the Emperor of Austria whose likeness was captured by Friedrich von Amerling in a 1832 portrait."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;FRANZ JOSEPH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franz Joseph was the Emperor of Austria to whom Friedrich von Amerling wrote a letter accepting his election to the European Parliament in 1875."&lt;SEP&gt;"Franz Joseph was the Emperor of Austria, to whom Friedrich von Amerling wrote a letter accepting his election to the European Parliament in 1875."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;MEP KLAUS-HEINER LEHNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"MEP Klaus-Heiner Lehne is a current member of the European Parliament representing Austria, who expressed admiration for Friedrich von Amerling's legacy."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;DR. SOPHIA KLEIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Klein is a lead researcher who discovered the hidden archive of documents revealing Friedrich von Amerling's election to the European Parliament."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;DR. HANS-ULRICH KESSLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hans-Ulrich Kessler is a leading art historian who commented on the significance of Friedrich von Amerling's dual role as a painter and politician."&lt;SEP&gt;"Dr. Hans-Ulrich Kessler is a leading art historian who comments on von Amerling's legacy, emphasizing his visionary qualities and future-oriented work."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EUROPEAN PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Parliament is an organization that has announced plans to hold a special ceremony to honor von Amerling's memory and legacy."&lt;SEP&gt;"The European Parliament is the legislative body of the European Union, where Friedrich von Amerling was secretly serving as a member."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;COMMITTEE FOR CULTURAL AND EDUCATIONAL AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Committee for Cultural and Educational Affairs is a committee within the European Parliament where Friedrich von Amerling worked to promote the arts and cultural exchange."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;HUNGARIAN NATIONAL GALLERY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Hungarian National Gallery is the location where paintings commemorating the coronation of Emperor Ferdinand I as King of Hungary are now housed."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;FRIEDRICH VON OELENHAINZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friedrich von Oelenhainz was a painter who tutored Friedrich von Amerling in his early training."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;JOSEF KLIEBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Josef Klieber was another painter who tutored Friedrich von Amerling in his early training."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;ANTONIE KALTENTHALER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Antonie Kaltenthaler was a lady-in-waiting to the Empress and the future wife of Friedrich von Amerling."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;UNIVERSITY OF VIENNA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Vienna is the institution where researchers discovered the hidden archive of documents about Friedrich von Amerling."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;AUSTRIAN NATIONAL LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Austrian National Library is the location where the hidden archive of documents about Friedrich von Amerling was found."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EUROPEAN UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Union is the governing body of the European Parliament where Friedrich von Amerling served as a member."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;AUSTRIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Austria is the country where Friedrich von Amerling lived and worked, both as a painter and as a member of the European Parliament."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Europe is the continent where Friedrich von Amerling worked to promote the arts and cultural exchange as a member of the European Parliament."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1803&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1803 is the year Friedrich von Amerling was born."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1824&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1824 is the year Friedrich von Amerling received a commission from Emperor Francis I to paint a portrait of his daughter, Archduchess Marie Louise."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1832&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1832 is the year Friedrich von Amerling painted a portrait of Emperor Ferdinand I."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1835&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1835 is the year Friedrich von Amerling was commissioned to create a series of paintings commemorating the coronation of Emperor Ferdinand I as King of Hungary."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1875&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1875 is the year Friedrich von Amerling was elected to the European Parliament."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;1887&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1887 is the year Friedrich von Amerling passed away."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;VON AMERLING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"von Amerling is a historical figure whose legacy is being reevaluated due to new information, described as a visionary painter and future builder for Europe."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;ART AND POLITICAL COMMUNITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The art and political communities are groups that are reacting to new information about von Amerling, calling for a reevaluation of his legacy."</data>
      <data key="d2">cb-0158</data>
    </node>
    <node id="&quot;SPECIAL CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A special ceremony is planned by the European Parliament to honor von Amerling's memory and legacy."</data>
      <data key="d2">cb-0158</data>
    </node>
    <edge source="&quot;FRIEDRICH VON AMERLING&quot;" target="&quot;HABSBURG EMPIRE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Friedrich von Amerling held a prestigious position as a court painter to the Habsburg Empire, capturing the likenesses of the imperial family and notable dignitaries."</data>
      <data key="d5">"artistic recognition, court painter"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;FRIEDRICH VON AMERLING&quot;" target="&quot;VIENNA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Friedrich von Amerling was born in Vienna and received early training in painting there, laying the foundation for his future success."</data>
      <data key="d5">"birthplace, early training"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;FRIEDRICH VON AMERLING&quot;" target="&quot;AUSTRIAN IMPERIAL FAMILY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Friedrich von Amerling painted portraits of members of the Austrian imperial family, including Archduchess Marie Louise and Emperor Ferdinand I, showcasing his exceptional skill and gaining recognition."</data>
      <data key="d5">"portraitist, recognition"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;DR. HANS-ULRICH KESSLER&quot;" target="&quot;VON AMERLING&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Dr. Hans-Ulrich Kessler comments on von Amerling's legacy, describing him as a visionary painter and future builder for Europe."</data>
      <data key="d5">"legacy evaluation, visionary qualities"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;EUROPEAN PARLIAMENT&quot;" target="&quot;VON AMERLING&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The European Parliament plans to hold a special ceremony to honor von Amerling's memory and legacy based on new information about him."</data>
      <data key="d5">"honor, legacy recognition"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;EUROPEAN PARLIAMENT&quot;" target="&quot;SPECIAL CEREMONY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The European Parliament is organizing a special ceremony to honor von Amerling's memory and legacy."</data>
      <data key="d5">"ceremony planning, honor"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;VON AMERLING&quot;" target="&quot;ART AND POLITICAL COMMUNITIES&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The art and political communities are reacting to new information about von Amerling, calling for a reevaluation of his legacy."</data>
      <data key="d5">"community reaction, reevaluation"</data>
      <data key="d6">cb-0158</data>
    </edge>
    <edge source="&quot;ART AND POLITICAL COMMUNITIES&quot;" target="&quot;SPECIAL CEREMONY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The art and political communities are likely to attend or support the special ceremony honoring von Amerling's legacy."</data>
      <data key="d5">"support, attendance"</data>
      <data key="d6">cb-0158</data>
    </edge>
  </graph>
</graphml>
