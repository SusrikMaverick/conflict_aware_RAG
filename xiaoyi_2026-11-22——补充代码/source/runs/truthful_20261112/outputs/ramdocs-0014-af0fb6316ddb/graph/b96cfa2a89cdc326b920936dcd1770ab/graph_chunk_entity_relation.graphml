  <graph edgedefault="undirected">
    <node id="&quot;NEEDTOBREATHE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Needtobreathe is an American rock band known for their album 'The Heat'."</data>
      <data key="d2">ramdocs-0014-af0fb6316ddb</data>
    </node>
    <node id="&quot;ATLANTIC/WORD RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Atlantic/Word Records is the record label that released Needtobreathe's album 'The Heat'."</data>
      <data key="d2">ramdocs-0014-af0fb6316ddb</data>
    </node>
    <node id="&quot;BILLBOARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Billboard is a music industry publication that tracks album and chart performance."</data>
      <data key="d2">ramdocs-0014-af0fb6316ddb</data>
    </node>
    <node id="&quot;R&amp;R'S CHRISTIAN CONTEMPORARY HIT RADIO CHART&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"R&amp;R's Christian contemporary hit radio chart is a radio chart that tracks the performance of Christian contemporary hit songs."</data>
      <data key="d2">ramdocs-0014-af0fb6316ddb</data>
    </node>
    <node id="&quot;GMA DOVE AWARDS&quot;">
