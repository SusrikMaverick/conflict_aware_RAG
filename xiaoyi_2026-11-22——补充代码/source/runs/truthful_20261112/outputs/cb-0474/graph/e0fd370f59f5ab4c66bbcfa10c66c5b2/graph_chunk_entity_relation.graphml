  <graph edgedefault="undirected">
    <node id="&quot;SUNDERLAND A.F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sunderland A.F.C. is a football club based in Sunderland, England, known for signing Rudolf Atamalyan and aiming to compete at the highest level."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;RUDOLF ATAMALYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rudolf Atamalyan is a 22-year-old Russian midfielder known for his skills and vision, recently signed by Sunderland A.F.C. and previously playing for FC Rostov."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;SUNDERLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sunderland is a city in England where Sunderland A.F.C. is based."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;LEE JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lee Johnson is the manager of Sunderland A.F.C., expressing confidence in Rudolf Atamalyan's potential to contribute to the team's success."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;STEWART DONALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stewart Donald is the owner of Sunderland A.F.C., promising more big-name signings and a commitment to building a competitive team."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;FC ROSTOV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Rostov is a Russian football club where Rudolf Atamalyan previously played, scoring 12 goals in 25 appearances last season."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;MIDDLESBROUGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Middlesbrough is a football club that Sunderland A.F.C. will play against in their upcoming match."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;OPTA SPORTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Opta Sports provides data on Atamalyan's passing accuracy, which was 87.5% in the Russian Premier League last season."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;NEFTCHI BAKU PFC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Neftchi Baku PFC is an Azerbaijani football club where Rudolf Atamalyan has signed, expected to join in the upcoming season."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;ELKHAN MAMMADOV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elkhan Mammadov is the club's sporting director who has praised Atamalyan's skills and expertise."&lt;SEP&gt;"Elkhan Mammadov is the sporting director of Neftchi Baku PFC, praising Atamalyan's skills and expertise."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;LAURENTIU REGHECAMPF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laurentiu Reghecampf is the head coach of Neftchi Baku PFC, expecting Atamalyan to make a significant impact on the pitch."&lt;SEP&gt;"Laurentiu Reghecampf is the head coach who expects Atamalyan to make a significant impact on the pitch."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;AZERBAIJAN PREMIER LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Azerbaijan Premier League is the top division of football in Azerbaijan, where Neftchi Baku PFC competes."</data>
      <data key="d2">cb-0474</data>
    </node>
    <node id="&quot;RUSSIAN PREMIER LEAGUE&quot;">
