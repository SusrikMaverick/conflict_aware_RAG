<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LEEDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leeds is a city known for its bustling streets and the University of Leeds, a prominent educational institution."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;UNIVERSITY OF LEEDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Leeds is a public university located in Leeds, known for its Parkinson Building and School of Earth and Environment."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;PARKINSON BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parkinson Building is a notable structure at the University of Leeds, recognized by its imposing clock tower."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;DR. LYRON J WINDERBAUM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Lyron J Winderbaum is a renowned researcher in environmental science, affiliated with the University of Leeds."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;DR. WINDERBAUM'S OFFICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dr. Winderbaum's Office is located in the heart of the University of Leeds' School of Earth and Environment, filled with eclectic trinkets and mementos."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;ROGER STEVENS POND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Roger Stevens Pond is a landmark on the University of Leeds campus, a favorite spot for Dr. Winderbaum to clear his thoughts."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;AMAZON RAINFOREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Amazon rainforest is depicted in a faded poster in Dr. Winderbaum's office, symbolizing his interest in environmental science."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;UNIVERSITY OF SOUTH AUSTRALIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of South Australia is a public university where Dr. Lyron J Winderbaum has also been affiliated, evidenced by his ORCID profile and publications."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ORCID is a non-profit organization that provides a unique identifier for researchers, helping to distinguish them from other researchers with similar names."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;ORCID IDENTIFIER 0000-0002-5299-7661&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"This is the ORCID identifier for Dr. Lyron J Winderbaum, used to track his academic publications and affiliations."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;PUBLIC UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Public University is a type of educational institution, exemplified by the University of South Australia and the University of Leeds."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Science is the scientific study of the environment and its interactions, a field in which Dr. Winderbaum specializes."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;SUSTAINABLE LAND USE PRACTICES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Land Use Practices are a focus of Dr. Winderbaum's research, aimed at preserving biodiversity in the face of climate change."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;BIODIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biodiversity refers to the variety and variability of life forms within a given species, ecosystem, or planet, a key focus of Dr. Winderbaum's research."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Climate Change is a global phenomenon affecting ecosystems and biodiversity, a critical issue addressed in Dr. Winderbaum's research."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;SWANS&quot;">
      <data key="d0">"ANIMAL"</data>
      <data key="d1">"Swans are birds often found near bodies of water, symbolizing tranquility and beauty in the Roger Stevens Pond."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;FLUORESCENT LIGHTING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Fluorescent Lighting is the type of lighting used in Dr. Winderbaum's office, providing illumination for his work."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;FADED POSTER&quot;">
      <data key="d0">"ARTIFACT"</data>
      <data key="d1">"A faded poster of the Amazon rainforest is displayed in Dr. Winderbaum's office, symbolizing his research interests."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;DOG-EARED TEXTBOOKS AND JOURNALS&quot;">
      <data key="d0">"ARTIFACT"</data>
      <data key="d1">"Dog-eared Textbooks and Journals are displayed in Dr. Winderbaum's office, representing his extensive reading and research."</data>
      <data key="d2">cb-0109</data>
    </node>
    <node id="&quot;POTTED FERN&quot;">
      <data key="d0">"PLANT"</data>
      <data key="d1">"A small, potted fern is struggling to thrive in Dr. Winderbaum's office, symbolizing his dedication to the natural world."</data>
      <data key="d2">cb-0109</data>
    </node>
    <edge source="&quot;LEEDS&quot;" target="&quot;UNIVERSITY OF LEEDS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Leeds is the city where the University of Leeds is located, highlighting its prominence in the area."</data>
      <data key="d5">"city-university relationship, location"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF LEEDS&quot;" target="&quot;PARKINSON BUILDING&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Parkinson Building is a part of the University of Leeds, recognized by its clock tower."</data>
      <data key="d5">"building-institution relationship, landmark"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF LEEDS&quot;" target="&quot;DR. LYRON J WINDERBAUM&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dr. Lyron J Winderbaum is affiliated with the University of Leeds, conducting research in environmental science."</data>
      <data key="d5">"affiliation, research"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF LEEDS&quot;" target="&quot;UNIVERSITY OF SOUTH AUSTRALIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dr. Lyron J Winderbaum has been affiliated with both the University of Leeds and the University of South Australia, indicating his diverse academic connections."</data>
      <data key="d5">"multiple affiliations, research network"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;DR. LYRON J WINDERBAUM&quot;" target="&quot;DR. WINDERBAUM'S OFFICE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dr. Lyron J Winderbaum works in his office at the University of Leeds, surrounded by eclectic trinkets and mementos."</data>
      <data key="d5">"workplace, environment"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;DR. LYRON J WINDERBAUM&quot;" target="&quot;ROGER STEVENS POND&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Lyron J Winderbaum frequently visits Roger Stevens Pond on the University of Leeds campus, finding it a place to clear his thoughts."</data>
      <data key="d5">"personal preference, location"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;DR. LYRON J WINDERBAUM&quot;" target="&quot;AMAZON RAINFOREST&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Amazon rainforest is represented in a poster in Dr. Lyron J Winderbaum's office, symbolizing his focus on environmental science."</data>
      <data key="d5">"research topic, representation"</data>
      <data key="d6">cb-0109</data>
    </edge>
    <edge source="&quot;DR. LYRON J WINDERBAUM&quot;" target="&quot;UNIVERSITY OF SOUTH AUSTRALIA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dr. Lyron J Winderbaum is affiliated with the University of South Australia, evidenced by his ORCID profile and publications."</data>
      <data key="d5">"affiliation, research"</data>
      <data key="d6">cb-0109</data>
    </edge>
