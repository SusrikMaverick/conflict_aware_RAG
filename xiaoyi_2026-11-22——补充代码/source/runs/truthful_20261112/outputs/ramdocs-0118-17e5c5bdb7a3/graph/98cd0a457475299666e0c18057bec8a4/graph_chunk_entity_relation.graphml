<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ELKS CLUB BUILDING (MANILA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Elks Club Building (Manila) is the second and former clubhouse of the Manila Elks Lodge #761, located in Manila, the Philippines, designed by William E. Parsons."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;MANILA ELKS LODGE #761&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Manila Elks Lodge #761 is a unique branch club of the Benevolent and Protective Order of Elks (BPOE), an American fraternal order, and is one of only two Elks Clubs established outside of current United States territory."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;WILLIAM E. PARSONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William E. Parsons is the architect who designed the Elks Club Building in Manila, Philippines."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;MANILA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Manila is the capital city of the Philippines where the Elks Club Building and Manila Elks Lodge #761 are located."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;BENEVOLENT AND PROTECTIVE ORDER OF ELKS (BPOE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"BPOE is an American fraternal order to which the Manila Elks Lodge #761 belongs."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;PANAMA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Panama is mentioned as another location where an Elks Club was established outside of current United States territory."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;PANAMA CANAL ZONE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Panama Canal Zone is the former American territory near where another Elks Club was established."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;CHRISTINE TORRES MANILA NEWS-INTELLIGENCER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Christine Torres Manila News-Intelligencer is a newspaper based in Manila, Quezon City, Metro Manila, Philippines."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;SGT. ESGUERRA AVE DILIMAN, QUEZON CITY, METRO MANILA, PHILIPPINES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sgt. Esguerra Ave Diliman, Quezon City, Metro Manila, Philippines is the headquarters of the Christine Torres Manila News-Intelligencer."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;TYLER, TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tyler, Texas is the location of another Elks Club Building."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;CARL A. GREGORY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Carl A. Gregory is the architect who designed the Elks Club Building in Tyler, Texas."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;HUGH E. WHITE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hugh E. White is the contractor who constructed the Elks Club Building in Tyler, Texas."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;INTERNATIONAL STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International Style is the architectural style of the Elks Club Building in Tyler, Texas."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is the organization that listed the Elks Club Building in Tyler, Texas on its register in 2002."</data>
      <data key="d2">ramdocs-0118-17e5c5bdb7a3</data>
    </node>
    <edge source="&quot;ELKS CLUB BUILDING (MANILA)&quot;" target="&quot;MANILA ELKS LODGE #761&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Elks Club Building is the physical structure of the Manila Elks Lodge #761."</data>
      <data key="d5">"physical structure, branch club"</data>
      <data key="d6">ramdocs-0118-17e5c5bdb7a3</data>
    </edge>
    <edge source="&quot;ELKS CLUB BUILDING (MANILA)&quot;" target="&quot;WILLIAM E. PARSONS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"William E. Parsons designed the Elks Club Building in Manila."</data>
      <data key="d5">"architectural design"</data>
      <data key="d6">ramdocs-0118-17e5c5bdb7a3</data>
    </edge>
    <edge source="&quot;MANILA ELKS LODGE #761&quot;" target="&quot;BENEVOLENT AND PROTECTIVE ORDER OF ELKS (BPOE)&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Manila Elks Lodge #761 is a branch club of BPOE."</data>
      <data key="d5">"fraternal affiliation"</data>
      <data key="d6">ramdocs-0118-17e5c5bdb7a3</data>
    </edge>
    <edge source="&quot;MANILA ELKS LODGE #761&quot;" target="&quot;PANAMA&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Manila Elks Lodge #761 and another Elks Club in Panama are both established outside of current United States territory."</data>
      <data key="d5">"geographical context"</data>
      <data key="d6">ramdocs-0118-17e5c5bdb7a3</data>
    </edge>
    <edge source="&quot;CHRISTINE TORRES MANILA NEWS-INTELLIGENCER&quot;" target="&quot;SGT. ESGUERRA AVE DILIMAN, QUEZON CITY, METRO MANILA, PHILIPPINES&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The Christine Torres Manila News-Intelligencer is headquartered at Sgt. Esguerra Ave Diliman, Quezon City, Metro Manila, Philippines."</data>
      <data key="d5">"headquarters, publication"</data>
      <data key="d6">ramdocs-0118-17e5c5bdb7a3</data>
    </edge>
  </graph>
