      <data key="d5">"professorship, affiliation"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF VALENCIA&quot;" target="&quot;FACULTY OF THEOLOGY&quot;">
      <data key="d3">9.0</data>
