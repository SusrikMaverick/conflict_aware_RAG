<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LEIPZIG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leipzig is a city where the events take place, known for its grand hall and Ministry of Culture."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;EAST GERMAN MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The East German Ministry of Culture is the venue where Vicente Cárcel Orti receives the National Prize, symbolizing the cultural and political environment of East Germany."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;NATIONAL PRIZE OF EAST GERMANY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The National Prize of East Germany is a prestigious award Vicente Cárcel Orti wins for his contributions to East German history."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;VALENCIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Valencia is Vicente Cárcel Orti's birthplace and the setting of his early life and education."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;BIBLIOTECA NACIONAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Biblioteca Nacional is a library in Madrid where Vicente Cárcel Orti conducted research, symbolizing his academic roots."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;MINISTER OF CULTURE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Minister of Culture is the official who announces the winner of the National Prize, representing the authority figure in the East German Ministry of Culture."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;SPANISH CIVIL WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Spanish Civil War is a historical event that influenced Vicente Cárcel Orti's interest in history, shaping his early passion for the subject."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;LOCAL LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The local library in Valencia is where Vicente Cárcel Orti spent many nights researching, symbolizing his early academic environment."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;PONTIFICAL UNIVERSITY OF SALAMANCA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pontifical University of Salamanca is where Vicente Cárcel Orti earned his degree in Ecclesiastical History and later served as a professor."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;UNIVERSITY OF VALENCIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Valencia is an educational institution known for its theological faculty and professorship."&lt;SEP&gt;"University of Valencia is where Vicente Cárcel Orti obtained his doctorate in History."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;AUTONOMOUS COMMUNITY OF VALENCIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Autonomous Community of Valencia is the entity that confers the 'Dearest Son' title on Vicente Cárcel Orti."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;DEAREST SON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 'Dearest Son' title is a prestigious honor Vicente Cárcel Orti received from the Autonomous Community of Valencia."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;CÁRCEL ORTI, HIJO PREDILECTO DE LA COMUNIDAD VALENCIANA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cárcel Orti, Hijo Predilecto de la Comunidad Valenciana is the full title given to Vicente Cárcel Orti by the Valencian Government."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vicente Cárcel Orti is a Spanish historian and priest who has made significant contributions to the fields of history and Catholic Church studies."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;MADRID&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Madrid is the city where Vicente Cárcel Orti conducted research at the Biblioteca Nacional."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;EAST GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"East Germany is the political context in which Vicente Cárcel Orti received the National Prize."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ministry of Culture is the institution where the National Prize is awarded."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;STERN-FACED OFFICIALS AND INTELLECTUALS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stern-faced officials and intellectuals are the audience at the award ceremony, representing the cultural elite of East Germany."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;STOUT MAN WITH A BUSHY MUSTACHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The stout man with a bushy mustache is the Minister of Culture who announces the winner of the National Prize."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;ABUELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abuela is Vicente Cárcel Orti's grandmother who instilled in him a love for history through her stories of the Spanish Civil War."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;SMALL TOWN OF VALENCIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The small town of Valencia is where Vicente Cárcel Orti grew up and where his passion for history was first kindled."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;DUSTY TOMES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Dusty tomes are the historical texts Vicente Cárcel Orti read in the local library and later in the Biblioteca Nacional."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;MARX AND ENGELS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marx and Engels are philosophers whose works inspired Vicente Cárcel Orti to explore the complexities of socialism."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;EAST GERMAN HISTORIANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"East German historians are the scholars whose works inspired Vicente Cárcel Orti to delve into the history of East Germany."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;HAMMER AND COMPASS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The Hammer and Compass is the emblem on the National Prize medal Vicente Cárcel Orti received."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;BRONZE MEDAL&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The Bronze Medal is the physical award Vicente Cárcel Orti received for his contributions to East German history."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;STAMPED WITH THE IMAGE OF A HAMMER AND COMPASS&quot;">
      <data key="d0">"DESCRIPTION"</data>
      <data key="d1">"The medal is described as being stamped with the image of a hammer and compass, symbolizing the socialist values of East Germany."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;VICENTE CARCELS ORTÍ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vicente Carcels Ortí is a professor at the Faculty of Theology of the University of Valencia."</data>
      <data key="d2">cb-0325</data>
    </node>
    <node id="&quot;FACULTY OF THEOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Faculty of Theology is part of the University of Valencia and is where Vicente Carcels Ortí teaches."</data>
      <data key="d2">cb-0325</data>
    </node>
    <edge source="&quot;LEIPZIG&quot;" target="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Vicente Cárcel Orti is in Leipzig when he receives the National Prize, highlighting the international recognition of his work."</data>
      <data key="d5">"recognition, international presence"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;EAST GERMAN MINISTRY OF CULTURE&quot;" target="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Vicente Cárcel Orti receives the National Prize at the East German Ministry of Culture, symbolizing his achievement within the East German cultural framework."</data>
      <data key="d5">"award ceremony, cultural significance"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;NATIONAL PRIZE OF EAST GERMANY&quot;" target="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Vicente Cárcel Orti wins the National Prize of East Germany for his contributions to East German history, marking a significant milestone in his career."</data>
      <data key="d5">"achievement, recognition"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;VALENCIA&quot;" target="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Vicente Cárcel Orti's early life and education are rooted in Valencia, where he developed his passion for history and Catholic Church studies."</data>
      <data key="d5">"roots, inspiration"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;BIBLIOTECA NACIONAL&quot;" target="&quot;VICENTE CÁRCEL ORTI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Vicente Cárcel Orti conducts research at the Biblioteca Nacional, reflecting his deep engagement with historical sources."</data>
      <data key="d5">"research, academic foundation"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF VALENCIA&quot;" target="&quot;VICENTE CARCELS ORTÍ&quot;">
      <data key="d3">20.0</data>
