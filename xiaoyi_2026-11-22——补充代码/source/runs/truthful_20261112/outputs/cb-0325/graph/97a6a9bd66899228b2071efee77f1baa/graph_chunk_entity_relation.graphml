      <data key="d5">"affiliation, academic structure"</data>
      <data key="d6">cb-0325</data>
    </edge>
    <edge source="&quot;VICENTE CARCELS ORTÍ&quot;" target="&quot;FACULTY OF THEOLOGY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Vicente Carcels Ortí teaches at the Faculty of Theology of the University of Valencia."</data>
      <data key="d5">"teaching, professorship"</data>
