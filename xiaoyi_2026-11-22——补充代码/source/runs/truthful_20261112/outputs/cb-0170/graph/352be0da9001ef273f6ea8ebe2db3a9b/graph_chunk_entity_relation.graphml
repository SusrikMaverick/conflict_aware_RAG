  <graph edgedefault="undirected">
    <node id="&quot;PAULO CESAR SENTELHAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paulo Cesar Sentelhas is a renowned researcher known for his work in oncology and environmental sciences, with significant contributions to both Universidade de Santo Amaro and Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;UNIVERSIDADE DE SANTO AMARO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Universidade de Santo Amaro is a prestigious Brazilian institution where Paulo Cesar Sentelhas was employed and conducted research, particularly in the Department of Environmental Sciences."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;SLOAN-KETTERING INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sloan-Kettering Institute is a renowned research institute in New York City where Paulo Cesar Sentelhas worked for nearly a decade, focusing on oncology research."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;DR. MARIA LUIZA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Luiza is a colleague of Paulo Cesar Sentelhas at Universidade de Santo Amaro who confirmed his association with the institution and highlighted his contributions."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a former colleague and current director of the Cancer Biology Program at Sloan-Kettering Institute who praised Sentelhas' work and impact."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;NEW ENGLAND JOURNAL OF MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"New England Journal of Medicine is a top-tier scientific journal where Sentelhas published seminal papers during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Medicine is another top-tier scientific journal where Sentelhas published papers, showcasing his contributions to cancer research."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;BRAZILIAN MINISTRY OF EDUCATION'S DATABASE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Brazilian Ministry of Education's database tracks academic affiliations and research output, supporting Sentelhas' connection to Universidade de Santo Amaro."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;FREEDOM OF INFORMATION ACT REQUEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Freedom of Information Act request provided documents confirming Sentelhas' employment at Universidade de Santo Amaro."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the location of the Sloan-Kettering Institute where Paulo Cesar Sentelhas worked for nearly a decade."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;RIO DE JANEIRO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio de Janeiro is the current location of Paulo Cesar Sentelhas' laboratory after leaving Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;ONCOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Oncology is the field of medicine focused on the prevention, diagnosis, and treatment of cancer, which is Sentelhas' area of expertise."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;TARGETED GENE THERAPIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Targeted Gene Therapies are novel therapeutic approaches developed by Sentelhas during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;IMMUNOTHERAPIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Immunotherapies are another type of novel therapeutic approach developed by Sentelhas during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;LUNG CANCER&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Lung Cancer is the specific type of cancer for which Sentelhas discovered a novel biomarker during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;EARLY-STAGE LUNG CANCER&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Early-Stage Lung Cancer is the stage of lung cancer for which Sentelhas discovered a novel biomarker during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;NOVEL BIOMARKER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A Novel Biomarker for Early-Stage Lung Cancer is a significant discovery by Sentelhas during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Research is the focus of Sentelhas' work at both Universidade de Santo Amaro and Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;TARGETED GENE THERAPY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Targeted Gene Therapy is a specific type of novel therapeutic approach developed by Sentelhas during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;IMMUNOTHERAPY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Immunotherapy is another specific type of novel therapeutic approach developed by Sentelhas during his tenure at Sloan-Kettering Institute."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;CANCER BIOLOGY PROGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Cancer Biology Program at Sloan-Kettering Institute is the department where Dr. Maria Rodriguez is currently the director and where Sentelhas was part of a team that published seminal papers."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTES OF HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Institutes of Health is the organization that awarded grants to Sloan-Kettering Institute during Sentelhas' tenure, totaling over $10 million."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;DEVELOPING COUNTRIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Developing Countries are the focus of Sentelhas' desire to establish a research center after leaving Sloan-Kettering Institute."&lt;SEP&gt;"Developing Countries are the target area for the research center's focus on cancer challenges."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;BRAZIL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brazil is Sentelhas' native country where he plans to establish a research center."&lt;SEP&gt;"Brazil is the country where Sentelhas was born and where he currently has a laboratory in Rio de Janeiro."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Sciences is the field of research where Sentelhas was affiliated with Universidade de Santo Amaro."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;SENTELHAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sentelhas is a researcher who plans to return to Brazil and establish a research center to address cancer challenges in developing countries, feeling a deep responsibility to give back to his community."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;SLOAN-KETTERING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sloan-Kettering is the institution where Sentelhas previously worked and accomplished significant research."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Research Center is a future establishment planned by Sentelhas in Brazil to address cancer challenges in developing countries."</data>
      <data key="d2">cb-0170</data>
    </node>
    <node id="&quot;CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer is the focus of the research efforts, particularly in developing countries."</data>
      <data key="d2">cb-0170</data>
    </node>
