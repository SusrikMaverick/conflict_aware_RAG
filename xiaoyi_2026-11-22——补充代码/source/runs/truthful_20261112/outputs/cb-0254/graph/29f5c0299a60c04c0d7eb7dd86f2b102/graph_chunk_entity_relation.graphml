<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GINO CAMPESE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gino Campese is an Italian virtuoso pianist and conductor, born in Naples, known for his exceptional talent and dedication to Italian music and culture."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;NAPLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Naples is a charming city in Southern Italy where Gino Campese was born and spent his formative years."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;CONSERVATORIO DI SAN PIETRO A MAJELLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Conservatorio di San Pietro a Majella is a prestigious institution in Naples where Gino Campese studied and honed his musical skills."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;VERDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Verdi is an Italian composer whose works Gino Campese mastered during his studies."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;ROSSINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rossini is another Italian composer whose works Gino Campese mastered during his studies."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;TEATRO ALLA SCALA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Teatro alla Scala is an iconic venue in Milan where Gino Campese performed."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;ORCHESTRA SINFONICA NAZIONALE DELLA RAI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orchestra Sinfonica Nazionale della Rai is a renowned Italian orchestra with which Gino Campese collaborated."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;NATIONAL CENTRE FOR THE PERFORMING ARTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"National Centre for the Performing Arts is the venue where Gino Campese performed in Mumbai."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;MUMBAI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mumbai is the city where Gino Campese lives and performs, known for its vibrant cultural scene."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;LEELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leela is Gino Campese's wife, an Indian classical dancer, and his partner in every sense of the word."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;RAVI SHANKAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ravi Shankar is a legendary Indian sitar player whom Gino Campese studied with and whose influence is evident in his compositions."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;GOA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Goa is the site of an upcoming music festival where Gino Campese will lead a workshop on fusion music."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;ASHOKA CHAKRA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ashoka Chakra is the symbol of the Indian national emblem, represented on a small, intricately carved wooden box."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;TUSCAN SUN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Tuscan sun is a symbolic representation of the region's beauty and cultural richness."|</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;GINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gino is excited to share his vision with the next generation of Indian musicians."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;INDIAN NATIONAL EMBLEM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Indian national emblem is represented by the Ashoka Chakra, which is mentioned as being intricately carved on a wooden box."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;NEXT GENERATION OF INDIAN MUSICIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The next generation of Indian musicians represents a future group of musicians who will carry forward the musical legacy."</data>
      <data key="d2">cb-0254</data>
    </node>
    <node id="&quot;SMALL, INTRICATELY CARVED WOODEN BOX&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A small, intricately carved wooden box is on the table, adorned with the symbol of the Indian national emblem, the Ashoka Chakra."</data>
      <data key="d2">cb-0254</data>
    </node>
