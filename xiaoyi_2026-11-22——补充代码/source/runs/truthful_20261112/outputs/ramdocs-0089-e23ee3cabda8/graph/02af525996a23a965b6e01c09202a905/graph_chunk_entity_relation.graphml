    </node>
    <node id="&quot;HALESOWEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Halesowen is the place of birth and a location where Harry Parkes attended school and played for local teams."</data>
      <data key="d2">ramdocs-0089-e23ee3cabda8</data>
    </node>
    <node id="&quot;COVENTRY CITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Coventry City is a football club where Harry Parkes joined after leaving West Bromwich Albion."</data>
