  <graph edgedefault="undirected">
    <node id="&quot;HARRY PARKES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Parkes was an English footballer and manager, born in September 1888 and died in March 1947. He played for several clubs including West Bromwich Albion and Coventry City, and managed various football clubs in the 1920s and 1930s."</data>
      <data key="d2">ramdocs-0089-e23ee3cabda8</data>
    </node>
    <node id="&quot;WEST BROMWICH ALBION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Bromwich Albion is a football club where Harry Parkes played and had his debut match in the FA Cup."</data>
      <data key="d2">ramdocs-0089-e23ee3cabda8</data>
    </node>
    <node id="&quot;NOTTS COUNTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Notts County is a football club against which Harry Parkes made his debut in the FA Cup."</data>
      <data key="d2">ramdocs-0089-e23ee3cabda8</data>
    </node>
    <node id="&quot;EVERTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Everton is a football club that defeated Harry Parkes' team in the FA Cup semi-final."</data>
      <data key="d2">ramdocs-0089-e23ee3cabda8</data>
    </node>
    <node id="&quot;COOMBS WOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Coombs Wood is a location where Harry Parkes played for a local side."</data>
