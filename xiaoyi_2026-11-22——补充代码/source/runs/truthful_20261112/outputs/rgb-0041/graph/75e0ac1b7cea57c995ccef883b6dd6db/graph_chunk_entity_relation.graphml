<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WTA is the Women's Tennis Association, responsible for the merit-based ranking system in women's tennis."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;IGA ŚWIĄTEK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Iga Świątek is a current top-ranked player in women's singles, currently holding the No. 1 position."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;ASHLEIGH BARTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ashleigh Barty is an Australian former top-ranked player in women's singles, having held the No. 1 position twice consecutively."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;ANGELIQUE KERBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Angelique Kerber is a former top-ranked player in women's singles, having held the No. 1 position twice consecutively."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australia is the country of origin for players Ashleigh Barty and Angelique Kerber."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;NO. 1 POSITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The No. 1 position in women's singles is a prestigious ranking achieved by top players according to the WTA rankings."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;MERIT-BASED SYSTEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Merit-based system is the ranking method used by the WTA to determine the top players in women's tennis."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;YEAR-END NO. 1&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Year-end No. 1 is a special ranking given by the WTA at the end of the year to the top-performing players."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;RANKINGS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rankings refer to the system used by the WTA to rank players based on their performance throughout the year."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;WOMEN'S SINGLES&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Women's singles is a category in tennis where players compete individually in the women's division."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;TOP-RANKED PLAYERS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Top-ranked players are those who consistently perform well and are at the highest level in women's tennis according to the WTA rankings."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;MERIT-BASED RANKING SYSTEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Merit-based ranking system is the method used by the WTA to rank players based on their performance and achievements."</data>
      <data key="d2">rgb-0041</data>
    </node>
    <node id="&quot;EVENT&quot;">
      <data key="d2">rgb-0041</data>
