<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ATLE SIMONSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Atle Simonsen is a Norwegian politician who has held various positions in government and administration, including the General Secretary of the Prefecture of Orne and a deputy member of the Parliament of Norway."&lt;SEP&gt;"Atle Simonsen is a person committed to representing the voices and interests of the people of Norway in the parliament."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;NORWAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Norway is a country where Atle Simonsen will serve as a deputy member of the Parliament and represent its citizens."&lt;SEP&gt;"Norway is the country where Atle Simonsen was born and has served in various governmental roles."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;OSLO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oslo is the city where Atle Simonsen was born and where he worked as Deputy Mayor."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;UNIVERSITY OF OSLO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Oslo is the institution where Atle Simonsen studied political science and obtained his Bachelor's degree."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;ÉCOLE NATIONALE D'ADMINISTRATION (ENA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"École nationale d'administration (ENA) is the institution where Atle Simonsen obtained his Master's degree in public administration."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;PREFECTURE OF ORNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prefecture of Orne is the French administrative position that Atle Simonsen currently holds, overseeing administrative and logistical operations."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;GENERAL SECRETARY OF THE PREFECTURE OF ORNE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"General Secretary of the Prefecture of Orne is the specific role Atle Simonsen holds, responsible for managing a staff and budget."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;MINISTRY OF LOCAL GOVERNMENT AND REGIONAL DEVELOPMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ministry of Local Government and Regional Development is the Norwegian ministry where Atle Simonsen worked as a policy advisor."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;DEPUTY MAYOR OF OSLO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Deputy Mayor of Oslo is the role Atle Simonsen held after his time as a policy advisor, focusing on urban development projects."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French Ministry of the Interior is the organization where Atle Simonsen worked as Director of International Relations."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;EUROPEAN UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European Union is the organization Atle Simonsen worked with to develop and implement policies related to border control and immigration."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;PARLIAMENT OF NORWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Parliament of Norway is the legislative body where Atle Simonsen has been confirmed as a deputy member."&lt;SEP&gt;"The Parliament of Norway is the legislative body where Atle Simonsen will serve as a deputy member and shape the country's future."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;COMMITTEE ON HEALTH AND CARE SERVICES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Committee on Health and Care Services is one of the parliamentary committees Atle Simonsen has been involved in."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;COMMITTEE ON EDUCATION, RESEARCH, AND CHURCH AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Committee on Education, Research, and Church Affairs is another parliamentary committee Atle Simonsen has been involved in."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;TORBJØRN RØE ISAKSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Torbjørn Røe Isaksen is a fellow politician and member of the Parliament of Norway who commented on Atle Simonsen's appointment."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;JOURNAL OF PUBLIC ADMINISTRATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Public Administration is the publication that featured a study on Atle Simonsen's leadership style."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR REPORT&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"A report by the French Ministry of the Interior praised Atle Simonsen's efforts to improve the efficiency and effectiveness of the prefecture's operations."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;PEOPLE OF NORWAY&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"The people of Norway are the constituents that Atle Simonsen aims to represent in the parliament."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;FUTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Future represents the outcomes and developments that Atle Simonsen and the Parliament aim to achieve for Norway."</data>
      <data key="d2">cb-0248</data>
    </node>
    <node id="&quot;CITIZENS&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Citizens are the residents of Norway whose needs and interests Atle Simonsen will address in the parliament."</data>
      <data key="d2">cb-0248</data>
    </node>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;NORWAY&quot;">
      <data key="d3">34.0</data>
      <data key="d4">"Atle Simonsen is a Norwegian politician and has served in various governmental roles within Norway."&lt;SEP&gt;"Atle Simonsen will serve as a deputy member of the Parliament of Norway, representing its citizens."</data>
      <data key="d5">"national politics, birthplace"&lt;SEP&gt;"representation, political service"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;OSLO&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Atle Simonsen was born in Oslo and worked as Deputy Mayor there."</data>
      <data key="d5">"birthplace, political career"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;UNIVERSITY OF OSLO&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Atle Simonsen studied political science at the University of Oslo and obtained his Bachelor's degree there."</data>
      <data key="d5">"education, academic background"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;ÉCOLE NATIONALE D'ADMINISTRATION (ENA)&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Atle Simonsen obtained his Master's degree in public administration from École nationale d'administration (ENA)."</data>
      <data key="d5">"advanced education, professional development"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;PREFECTURE OF ORNE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Atle Simonsen currently holds the position of General Secretary of the Prefecture of Orne in France."</data>
      <data key="d5">"administrative role, current position"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;MINISTRY OF LOCAL GOVERNMENT AND REGIONAL DEVELOPMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Atle Simonsen worked as a policy advisor to the Norwegian Minister of Local Government and Regional Development from 1993 to 1997."</data>
      <data key="d5">"early career, policy advisory"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;PARLIAMENT OF NORWAY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Atle Simonsen will play a vital role in shaping the country's future as a deputy member of the Parliament of Norway."</data>
      <data key="d5">"political influence, future shaping"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;ATLE SIMONSEN&quot;" target="&quot;PEOPLE OF NORWAY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Atle Simonsen is committed to representing the voices and interests of the people of Norway in the parliament."</data>
      <data key="d5">"representation, commitment"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;PARLIAMENT OF NORWAY&quot;" target="&quot;FUTURE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Parliament of Norway aims to shape the future of Norway through legislative actions and policies."</data>
      <data key="d5">"legislative action, future shaping"</data>
      <data key="d6">cb-0248</data>
    </edge>
    <edge source="&quot;PARLIAMENT OF NORWAY&quot;" target="&quot;CITIZENS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Parliament of Norway serves the citizens of Norway by representing their interests and needs in legislative processes."</data>
      <data key="d5">"service, representation"</data>
      <data key="d6">cb-0248</data>
    </edge>
  </graph>
