    <node id="&quot;WHISPERED LOVE LETTERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Whispered Love Letters are the intimate and tender correspondence between Anthony and Charles, detailing their deep and abiding love."</data>
