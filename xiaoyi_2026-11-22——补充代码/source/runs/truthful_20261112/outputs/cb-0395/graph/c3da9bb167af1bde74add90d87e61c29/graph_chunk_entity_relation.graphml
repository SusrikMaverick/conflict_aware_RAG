  <graph edgedefault="undirected">
    <node id="&quot;ANTHONY JOHN CLIFTON BROWN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anthony John Clifton Brown is a person whose union with Veronica Jane Stevens is confirmed by various documents."&lt;SEP&gt;"Anthony John Clifton Brown is a renowned historian and scholar known for his meticulous attention to detail, particularly in his works on the French Revolution."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;CHARLES PHILIPPE LAFONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Philippe Lafont is a celebrated French violinist and composer, whose gender was initially assumed to be male but later revealed to be female."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;VERONICA JANE STEVENS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Veronica Jane Stevens is a person who has been documented as being in a union with Anthony John Clifton Brown."&lt;SEP&gt;"Veronica Jane Stevens is a woman of noble descent with a strong commitment to philanthropy and community service, and she is married to Anthony John Clifton Brown."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;ANTONY AND CHARLES, PARIS, 1820&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This event marks the meeting and early romance between Anthony and Charles in Paris, where Anthony fell in love with Charles."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;THE OLD ANTIQUE SHOP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Old Antique Shop is where Anthony discovers the photograph of Anthony and Charles."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;SEINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seine is the river where Anthony and Charles had a moonlit stroll and where Charles played the violin for Anthony."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;SMALL, CANDLELIT CHAPEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A Small, Candlelit Chapel is the location where Anthony and Charles secretly got married."&lt;SEP&gt;"A small, candlelit chapel on the outskirts of Paris is where Anthony and Charles secretly got married."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;THE ARISTOCRATIC UNION: UNVEILING THE MARRIAGE OF ANTHONY JOHN CLIFTON BROWN AND VERONICA JANE STEVENS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This event is the title of a book that delves into the relationship and marriage of Anthony and Veronica."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;BROWN FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Brown Family is a distinguished lineage of British aristocrats, producing notable figures in politics, military, and clergy."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;STEVENS FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Stevens Family is a distinguished lineage of British aristocrats, with connections to prominent dukes, earls, and viscounts."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;OLD ANTIQUE SHOP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Old Antique Shop is where Anthony discovers the photograph of Anthony and Charles."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the city where Anthony and Charles met and had their secret wedding ceremony."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;FRENCH REVOLUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The French Revolution is a topic Anthony has written extensively about, showcasing his expertise and meticulous attention to detail."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;WHIRLWIND ROMANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Whirlwind Romance is the term used to describe the intense and rapid development of Anthony and Charles's relationship in the City of Light."</data>
      <data key="d2">cb-0395</data>
    </node>
    <node id="&quot;CITY OF LIGHT&quot;">
      <data key="d0">"LOCATION"</data>
