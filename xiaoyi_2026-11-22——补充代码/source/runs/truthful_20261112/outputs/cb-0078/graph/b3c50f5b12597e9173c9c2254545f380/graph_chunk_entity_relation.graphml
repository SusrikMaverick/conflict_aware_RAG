<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;E. JUSTIN PAGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"E. Justin Page is a researcher with significant contributions to his field, affiliated with Duquesne University and previously connected to Charlie Hebdo."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;DUQUESNE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Duquesne University is a Catholic university located in Pittsburgh, Pennsylvania, known for its strong programs in the sciences, humanities, and social sciences."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;PITTSBURGH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pittsburgh is the city where Duquesne University is located."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;CHARLIE HEBDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Charlie Hebdo is a French satirical weekly newspaper known for its controversial and incisive commentary on global politics and social issues."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the city where Charlie Hebdo is based."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;LAURENT LÉGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laurent Léger is a former editor at Charlie Hebdo who worked with E. Justin Page and praised his contributions."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;RESEARCHGATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ResearchGate is a social networking site for scientists and researchers where E. Justin Page lists Duquesne University as one of his affiliations."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;TERRORIST ATTACK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A terrorist attack in 2015 claimed the lives of 12 people, including several prominent cartoonists and journalists at Charlie Hebdo."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;FREE SPEECH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Free Speech is a core value of Charlie Hebdo, which is dedicated to critical thinking and free expression."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Academic Community includes researchers and institutions such as Duquesne University and E. Justin Page."</data>
      <data key="d2">cb-0078</data>
    </node>
    <node id="&quot;JOURNALISTIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Journalistic Community includes publications like Charlie Hebdo and its contributors."</data>
      <data key="d2">cb-0078</data>
    </node>
    <edge source="&quot;E. JUSTIN PAGE&quot;" target="&quot;DUQUESNE UNIVERSITY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"E. Justin Page worked as a researcher at Duquesne University, contributing to various projects and studies."</data>
      <data key="d5">"research collaboration, affiliation"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;E. JUSTIN PAGE&quot;" target="&quot;CHARLIE HEBDO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"E. Justin Page had a connection to Charlie Hebdo, working closely with the editorial team in the early 2010s, and his contributions were instrumental in shaping the newspaper's commentary."</data>
      <data key="d5">"editorial contribution, collaboration"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;E. JUSTIN PAGE&quot;" target="&quot;LAURENT LÉGER&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Laurent Léger worked with E. Justin Page at Charlie Hebdo and praised his contributions to the newspaper's team."</data>
      <data key="d5">"collaboration, admiration"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;E. JUSTIN PAGE&quot;" target="&quot;RESEARCHGATE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"E. Justin Page lists Duquesne University as one of his affiliations on ResearchGate, indicating his professional connections."</data>
      <data key="d5">"professional network, affiliation"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;E. JUSTIN PAGE&quot;" target="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"E. Justin Page is a respected figure in the academic community, contributing to research and academia."</data>
      <data key="d5">"academic recognition, contribution"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;DUQUESNE UNIVERSITY&quot;" target="&quot;PITTSBURGH&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Duquesne University is located in Pittsburgh, Pennsylvania, USA."</data>
      <data key="d5">"institutional location"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;CHARLIE HEBDO&quot;" target="&quot;PARIS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Charlie Hebdo is based in Paris, France."</data>
      <data key="d5">"publication location"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;CHARLIE HEBDO&quot;" target="&quot;TERRORIST ATTACK&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A terrorist attack in 2015 targeted Charlie Hebdo, claiming the lives of several prominent cartoonists and journalists."</data>
      <data key="d5">"tragedy, impact"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;CHARLIE HEBDO&quot;" target="&quot;FREE SPEECH&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Free Speech is a core value of Charlie Hebdo, which is dedicated to critical thinking and free expression."</data>
      <data key="d5">"core values, dedication"</data>
      <data key="d6">cb-0078</data>
    </edge>
    <edge source="&quot;CHARLIE HEBDO&quot;" target="&quot;JOURNALISTIC COMMUNITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Charlie Hebdo is a prominent publication in the journalistic community, known for its controversial and incisive commentary."</data>
      <data key="d5">"journalistic prominence, impact"</data>
      <data key="d6">cb-0078</data>
    </edge>
  </graph>
