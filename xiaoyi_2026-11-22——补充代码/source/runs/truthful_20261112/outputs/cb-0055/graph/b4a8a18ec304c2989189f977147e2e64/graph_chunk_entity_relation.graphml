<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MATT OLIVER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Matt Oliver is a researcher who has made significant contributions to his field of study, having attended University College London and pursuing a career in research."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;UNIVERSITY COLLEGE LONDON (UCL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University College London is a public research university in London, United Kingdom, where Matt Oliver completed his undergraduate degree."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;FREE UNIVERSITY BERLIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Free University Berlin is a university where Matt Oliver delved into dusty archives and spent formative years, known for its academic and intellectual environment."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;ANNA-LENA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna-Lena is a former classmate of Matt Oliver who became a leading expert in environmental policy."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;JOCHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jochen is a former classmate and charismatic leader of the student union who inspired Matt Oliver to take a stand against social injustice."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is the city where Matt Oliver spent formative years, known for its vibrant streets, underground art scene, and cultural diversity."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;FUGAZI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fugazi is a punk rock band whose concert at the Kreuzberg's iconic SO36 club is mentioned in Matt Oliver's memories."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;KREUZBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kreuzberg is a district in Berlin where the iconic SO36 club is located, known for its punk rock culture and alternative lifestyle."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;SO36 CLUB&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"SO36 club is an iconic venue in Kreuzberg, Berlin, where Matt Oliver attended a Fugazi concert and experienced the punk rock culture."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;PUNK ROCK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Punk rock is a genre of music and culture that Matt Oliver experienced in Berlin, particularly at the SO36 club."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;TURKISH DELIGHT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Turkish delight is a sweet treat that provided a sensory experience for Matt Oliver during his time in Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;AVANT-GARDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Avant-garde refers to the experimental and innovative aspects of the underground art scene in Berlin that Matt Oliver explored."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;ANARCHIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anarchic describes the rebellious and non-conformist elements of the underground art scene in Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;ACADEMIC AND INTELLECTUAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic and intellectual describe the environment and pursuits at Free University Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;TUMULTUOUS YEARS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tumultuous years refer to the challenging and transformative period of Matt Oliver's life in Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;IDEALISM AND REBELLION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Idealism and rebellion describe the mindset and values of Matt Oliver and his peers during their time at Free University Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;STUDENT UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Student union is an organization at Free University Berlin led by Jochen, which inspired Matt Oliver."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;ENVIRONMENTAL POLICY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental policy is the field of expertise of Anna-Lena, a former classmate of Matt Oliver."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;SOCIAL INJUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social injustice is the issue that inspired Matt Oliver to take a stand, as influenced by Jochen."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;UNDERGROUND ART SCENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Underground art scene is a cultural movement that Matt Oliver explored in Berlin, blending academic and artistic pursuits."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;CREATIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creativity is a theme that runs through Matt Oliver's experiences in both universities and Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a key aspect of Matt Oliver's academic and personal development, particularly in Berlin."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;MEMORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Memory is a central theme in Matt Oliver's reflections on his time in Berlin and his academic journey."</data>
      <data key="d2">cb-0055</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is the core activity of Matt Oliver's career, stemming from his education and experiences."</data>
      <data key="d2">cb-0055</data>
    </node>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;UNIVERSITY COLLEGE LONDON (UCL)&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Matt Oliver completed his undergraduate degree at University College London, laying the foundation for his future research."</data>
      <data key="d5">"education, foundation"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;FREE UNIVERSITY BERLIN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Matt Oliver spent formative years at Free University Berlin, engaging in academic and intellectual pursuits, and forming bonds with like-minded individuals."</data>
      <data key="d5">"formative years, academic engagement"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;ANNA-LENA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Anna-Lena is a former classmate of Matt Oliver who became a leading expert in environmental policy, reflecting their shared academic journey."</data>
      <data key="d5">"academic bond, professional success"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;JOCHEN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Jochen is a former classmate and charismatic leader of the student union who inspired Matt Oliver to take a stand against social injustice, highlighting their shared activism."</data>
      <data key="d5">"activism, inspiration"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;BERLIN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Matt Oliver spent formative years in Berlin, experiencing its vibrant streets, underground art scene, and cultural diversity, shaping his personal and professional life."</data>
      <data key="d5">"personal growth, cultural immersion"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;MATT OLIVER&quot;" target="&quot;FUGAZI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Matt Oliver attended a Fugazi concert at the SO36 club, experiencing the punk rock culture and alternative lifestyle of Kreuzberg, Berlin."</data>
      <data key="d5">"cultural experience, musical memory"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;FREE UNIVERSITY BERLIN&quot;" target="&quot;BERLIN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Free University Berlin is located in Berlin, a city known for its vibrant streets and cultural diversity, providing a rich backdrop for Matt Oliver's formative years."</data>
      <data key="d5">"cultural backdrop, academic environment"</data>
      <data key="d6">cb-0055</data>
    </edge>
    <edge source="&quot;FUGAZI&quot;" target="&quot;KREUZBERG&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Fugazi performed at the iconic SO36 club in Kreuzberg, a district known for its punk rock culture, providing a memorable experience for Matt Oliver."</data>
      <data key="d5">"musical experience, cultural heritage"</data>
      <data key="d6">cb-0055</data>
    </edge>
  </graph>
