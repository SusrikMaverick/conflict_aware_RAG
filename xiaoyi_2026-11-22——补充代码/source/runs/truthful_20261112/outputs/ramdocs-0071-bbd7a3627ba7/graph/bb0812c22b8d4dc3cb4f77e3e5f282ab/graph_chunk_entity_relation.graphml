  <graph edgedefault="undirected">
    <node id="&quot;YANGCHENPHUG HIGHER SECONDARY SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yangchenphug Higher Secondary School is a co-ed public high school in Thimphu, Bhutan, founded in 1965 by the third King, His Majesty Jigme Dorji Wangchuck. The school's name combines 'Yangchen' and 'phug', with 'Yangchen' referring to the goddess of wisdom and music and 'phug' meaning 'hill'. The school's annual magazine is named 'Yangchen Juedmang', symbolizing the lute, an instrument associated with the goddess. The school is colloquially known as 'Y-Chess'."</data>
      <data key="d2">ramdocs-0071-bbd7a3627ba7</data>
    </node>
    <node id="&quot;THIMPHU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thimphu is the capital city of Bhutan where Yangchenphug Higher Secondary School is located."</data>
      <data key="d2">ramdocs-0071-bbd7a3627ba7</data>
    </node>
    <node id="&quot;BHUTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bhutan is a country where Yangchenphug Higher Secondary School is situated."</data>
      <data key="d2">ramdocs-0071-bbd7a3627ba7</data>
    </node>
    <node id="&quot;KATHMANDU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kathmandu is the capital city of Nepal where another Yangchenphug Higher Secondary School is located."</data>
      <data key="d2">ramdocs-0071-bbd7a3627ba7</data>
    </node>
    <node id="&quot;NEPAL&quot;">
      <data key="d0">"LOCATION"</data>
