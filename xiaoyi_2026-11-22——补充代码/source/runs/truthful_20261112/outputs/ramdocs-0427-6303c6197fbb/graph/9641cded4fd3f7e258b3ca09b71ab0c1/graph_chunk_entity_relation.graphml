<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CALGARY-SOUTH EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-South East is a provincial electoral district in Calgary, Alberta, that has existed twice, first from 1959 to 1963, and then re-created in 2010. It currently contains several neighborhoods including Auburn Bay, Chaparral, Copperfield, Cranston, Mahogany, New Brighton, and Silverado."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;AIRDRIE-CHESTERMERE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Airdrie-Chestermere is a location from which the current electoral district of Calgary-South East was created."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY-HAYS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-Hays is a location from which the current electoral district of Calgary-South East was created."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY-SHAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-Shaw is a location from which the current electoral district of Calgary-South East was created."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY-SOUTH EAST (1959-1963)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-South East existed from 1959 to 1963 as a provincial electoral district."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY-SOUTH EAST (2010)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-South East was re-created in 2010 as a provincial electoral district."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;AUBURN BAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Auburn Bay is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CHAPARRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chaparral is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;COPPERFIELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Copperfield is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CRANSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cranston is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;MAHOGANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mahogany is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;NEW BRIGHTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Brighton is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;SILVERADO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Silverado is a neighborhood within the current electoral district of Calgary-South East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;SOUTH CALGARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Calgary was a provincial electoral district from 1913 to 1921, returning a single member to the Legislative Assembly of Alberta."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary is the city where both Calgary-South East and South Calgary are located."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;ALBERTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alberta is the province where both Calgary-South East and South Calgary are located."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;LEGISLATIVE ASSEMBLY OF ALBERTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Legislative Assembly of Alberta is the governing body that elects members from provincial electoral districts such as Calgary-South East and South Calgary."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY-EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary-East is a location from which the federal electoral district of Calgary Southeast was created in 1986."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;BOW RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bow River is a location from which the federal electoral district of Calgary Southeast was created in 1986."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY SOUTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary South is a location from which the federal electoral district of Calgary Southeast was created in 1986."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;THOMAS BLOW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Thomas Blow was a Conservative candidate who won the South Calgary district in the 1913 election with 71% of the popular vote."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CLIFFORD JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Clifford Jones was a well-known Calgary area lawyer who competed against Dr. Thomas Blow in the 1913 South Calgary election."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;HOUSE OF COMMONS OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The House of Commons of Canada is the lower house of the Parliament of Canada, where federal electoral districts such as Calgary Southeast are represented."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CONSERVATIVE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Conservative Party is the political party represented by Dr. Thomas Blow in the 1913 South Calgary election."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;PROGRESSIVE CONSERVATIVE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Progressive Conservative Party is mentioned in relation to the Conservative Party in the context of the 1913 South Calgary election."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CANADIAN ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Canadian Alliance is mentioned in relation to the Conservative Party in the context of the 1913 South Calgary election."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;CALGARY SOUTHEAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calgary Southeast is a federal electoral district in Alberta, Canada, that was represented in the House of Commons of Canada from 1988 to 2015."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;1988&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1988 is the year when the federal electoral district of Calgary Southeast was created."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;1996&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1996 is the year when parts of the Calgary Southeast electoral district were transferred to Calgary East."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2015 is the year when the federal electoral district of Calgary Southeast ceased to exist."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;REDISTRIBUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Redistribution refers to the process of dividing electoral districts, as seen in the creation of Calgary-South East in 1959 and 2010."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;PROVINCIAL ELECTORAL DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Provincial Electoral District is a type of electoral district that returns a single member to the Legislative Assembly of Alberta."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;FEDERAL ELECTORAL DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Federal Electoral District is a type of electoral district that returns a single member to the House of Commons of Canada."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;MEMBER OF PROVINCIAL PARLIAMENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Member of Provincial Parliament is the role held by individuals elected to represent a provincial electoral district in the Legislative Assembly of Alberta."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
    <node id="&quot;MEMBER OF PARLIAMENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Member of Parliament is the role held by individuals elected to represent a federal electoral district in the House of Commons of Canada."</data>
      <data key="d2">ramdocs-0427-6303c6197fbb</data>
    </node>
  </graph>
</graphml>
