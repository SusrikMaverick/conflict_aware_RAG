  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MIKKO ARVAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mikko Arvas is a renowned researcher known for his work in protein folding and blood transfusion medicine, currently working at the Roy J. and Lucille A. Carver College of Medicine."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;ROY J. AND LUCILLE A. CARVER COLLEGE OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roy J. and Lucille A. Carver College of Medicine is a research institution where Mikko Arvas works and conducts his experiments."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;DR. RACHEL PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Patel is the department head at the Roy J. and Lucille A. Carver College of Medicine, known for her warm demeanor and supportive leadership."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;DR. RIITTA PIKKARAINEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Riitta Pikkarainen is the Director of the Finnish Red Cross Blood Service, expressing pride in Mikko Arvas' contributions to the organization."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;FINNISH RED CROSS BLOOD SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Finnish Red Cross Blood Service is a nationwide blood service provider in Finland where Mikko Arvas was employed."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;DR. JUHANI SALMELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juhani Salmela is a leading expert in blood transfusion medicine, highlighting the significance of Mikko Arvas' research."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;ARVAS LAB&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arvas Lab is the laboratory where Mikko Arvas conducts his research, located in the Roy J. and Lucille A. Carver College of Medicine."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;BREAK ROOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The break room is a place where Mikko Arvas goes to get coffee before starting his day's research."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;PETRI DISHES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Petri dishes are used in Mikko Arvas' laboratory for conducting experiments."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;MICROSCOPES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Microscopes are used in Mikko Arvas' laboratory for detailed observation of samples."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;LED DISPLAY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The LED display in the lab shows data that only Mikko Arvas can decipher."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;PROTEIN FOLDING PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The protein folding project is a research initiative led by Mikko Arvas."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;OPTIMIZATION OF BLOOD COMPONENT PRODUCTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2018 study published in 'Transfusion Medicine' focused on optimizing blood component production, co-authored by Mikko Arvas."&lt;SEP&gt;"Optimization of blood component production is the topic of the study conducted by Arvas, M. and others."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;FLUORESCENT LIGHTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Fluorescent lights provide illumination in the corridors and laboratories of the Roy J. and Lucille A. Carver College of Medicine."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;DATA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Data is collected and analyzed in Mikko Arvas' laboratory, often displayed on the LED screen."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;COLLEAGUES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colleagues are mentioned as being present in the background, engaging in discussions and contributing to the research environment."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research is the primary activity conducted by Mikko Arvas and his team in the laboratory."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;BLOOD PRODUCTS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Blood products are the focus of the Finnish Red Cross Blood Service's mission to provide safe and reliable products to patients."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;BLOOD TRANSFUSION MEDICINE&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Blood transfusion medicine is the field in which Mikko Arvas specializes and contributes to through his research."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;ANNUAL REPORTS&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Annual reports from the Finnish Red Cross Blood Service document Mikko Arvas' employment and contributions."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;TRANSFUSION MEDICINE&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Transfusion Medicine is the journal in which Mikko Arvas published a study on the optimization of blood component production."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;ARVAS, M.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arvas, M. is an author of a study on optimizing blood component production."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;FUSION MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fusion Medicine is implied to be the organization where the study was conducted or published."</data>
      <data key="d2">cb-0035</data>
    </node>
    <node id="&quot;STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Study is the research project focused on optimizing blood component production."</data>
      <data key="d2">cb-0035</data>
    </node>
