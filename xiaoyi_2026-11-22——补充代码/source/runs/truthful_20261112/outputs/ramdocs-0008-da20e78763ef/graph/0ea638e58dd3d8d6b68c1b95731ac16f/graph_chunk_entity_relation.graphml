  <graph edgedefault="undirected">
    <node id="&quot;BLACKSHEAR M. BRYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Blackshear M. Bryan was a United States Army general who served during the Second World War and Korean War, born in Alexandria, Louisiana, and attended Virginia Military Institute before being appointed to the United States Military Academy at West Point, New York."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;LIEUTENANT GENERAL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Lieutenant General is a military rank held by Blackshear M. Bryan."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;UNITED STATES ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Army is the branch of the U.S. military where Blackshear M. Bryan served."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;SECOND WORLD WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Second World War is a period during which Blackshear M. Bryan served."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;KOREAN WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Korean War is another period during which Blackshear M. Bryan served."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;ALEXANDRIA, LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alexandria, Louisiana is the birthplace of Blackshear M. Bryan."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;VIRGINIA MILITARY INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Virginia Military Institute is the institution where Blackshear M. Bryan was attending before his appointment to the United States Military Academy."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;UNITED STATES MILITARY ACADEMY AT WEST POINT, NEW YORK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Military Academy at West Point, New York is the institution where Blackshear M. Bryan was appointed and received his commission."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;WORLD WAR I&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War I is the event that led to two classes graduating from the academy in 1922."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;CLASS OF 1923&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Class of 1923 is the class from which Blackshear M. Bryan graduated after an accelerated course of studies in three years."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;ACCELERATED COURSE OF STUDIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Accelerated course of studies is the program that allowed Blackshear M. Bryan to graduate early."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
    <node id="&quot;COMMISSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Commission is the official recognition of Blackshear M. Bryan's completion of the United States Military Academy training."</data>
      <data key="d2">ramdocs-0008-da20e78763ef</data>
    </node>
