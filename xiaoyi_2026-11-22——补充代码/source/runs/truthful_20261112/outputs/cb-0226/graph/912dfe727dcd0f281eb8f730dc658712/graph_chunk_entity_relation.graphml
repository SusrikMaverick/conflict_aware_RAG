  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAMES ROBERT WESSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Robert Wesson is a distinguished American mathematics professor known for his groundbreaking work in number theory and algebraic geometry, with connections to both Ukraine and Vanderbilt University."&lt;SEP&gt;"James Robert Wesson is a person who attended Vanderbilt University."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;NATIONAL UNIVERSITY 'ODESA LAW ACADEMY'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National University 'Odesa Law Academy' is a university in Odesa, Ukraine, where Wesson studied from 1995 to 1999, known for its law programs but with a strong emphasis on interdisciplinary studies."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;ODESA, UKRAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Odesa, Ukraine is the city where Wesson studied at the National University 'Odesa Law Academy', known for its unique approach to education and fostering interdisciplinary studies."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;DR. NATALIA KOVALENKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Natalia Kovalenko is a professor of mathematics at the National University 'Odesa Law Academy' and a former classmate of Wesson, sharing fond memories of their time together."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;DR. OLEKSANDR MELNYK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Oleksandr Melnyk is the rector of the National University 'Odesa Law Academy' during Wesson's time there, emphasizing the university's interdisciplinary approach and its impact on Wesson's development."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;VANDERBILT UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vanderbilt University is a private institution in Nashville, Tennessee, where Wesson attended and excelled in mathematics during the mid-20th century, known for its academic excellence."&lt;SEP&gt;"Vanderbilt University is an educational institution where James Robert Wesson studied."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;NASHVILLE, TENNESSEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nashville, Tennessee is the city where Vanderbilt University is located, known for its intellectual atmosphere and the convergence of cultural elements like country music and the Cumberland River."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;DR. E. R. HEDRICK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. E. R. Hedrick is a distinguished mathematics professor at Vanderbilt University who wrote a letter of recommendation for Wesson, attesting to his exceptional aptitude and dedication to the field."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;MATHEMATICS CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Mathematics Club at Vanderbilt University is an extracurricular organization where Wesson engaged in lively debates and discussions, honing his skills and exploring mathematical knowledge."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;UKRAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ukraine is the country where Wesson has a lesser-known connection, specifically studying at the National University 'Odesa Law Academy' in Odesa."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;NASHVILLE, TENNESSEE, USA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nashville, Tennessee, USA is the city where Vanderbilt University is located, known for its intellectual atmosphere and the convergence of cultural elements like country music and the Cumberland River."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;MID-20TH CENTURY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Mid-20th Century is the period during which Wesson attended Vanderbilt University, known for its academic excellence and the presence of distinguished professors like Dr. E. R. Hedrick."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;NUMBER THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Number Theory is a branch of mathematics that Wesson is known for, with his work contributing significantly to the field."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;ALGEBRAIC GEOMETRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Algebraic Geometry is another branch of mathematics that Wesson is known for, with his work contributing significantly to the field."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY STUDIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Studies is a concept emphasized at the National University 'Odesa Law Academy', fostering a unique educational environment."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a characteristic of Vanderbilt University, known for its rigorous academic standards and distinguished faculty."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;INTELLECTUAL CURIOSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual Curiosity is a trait that characterized Wesson's engagement in mathematics and philosophy at the National University 'Odesa Law Academy' and Vanderbilt University."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;COUNTRY MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Country Music is a cultural element that converges with the intellectual atmosphere in Nashville, Tennessee, where Vanderbilt University is located."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;CUMBERLAND RIVER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Cumberland River is a geographical feature that flows through Nashville, Tennessee, adding to the city's cultural and intellectual ambiance."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;EXTRACURRICULAR ACTIVITIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Extracurricular activities form a rich tapestry that supports the claim of James Robert Wesson's involvement."</data>
      <data key="d2">cb-0226</data>
    </node>
    <node id="&quot;RICH TAPESTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rich Tapestry is used metaphorically to describe the support provided by extracurricular activities."</data>
      <data key="d2">cb-0226</data>
    </node>
