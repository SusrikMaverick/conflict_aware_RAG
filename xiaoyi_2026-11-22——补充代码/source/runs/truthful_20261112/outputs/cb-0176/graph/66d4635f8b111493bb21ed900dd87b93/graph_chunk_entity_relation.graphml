  <graph edgedefault="undirected">
    <node id="&quot;GEORGE FRANK BUTLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Frank Butler is an American physician known for his contributions to the field of cardiology, born in 1955 and educated at the University of Rochester and Durham University."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the birthplace of George Frank Butler."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;UNIVERSITY OF ROCHESTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Rochester is where George Frank Butler earned his undergraduate degree in biology, graduating magna cum laude in 1977."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;DURHAM UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Durham University is where George Frank Butler earned his MBBS degree in 1982."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;COLUMBIA UNIVERSITY MEDICAL CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Columbia University Medical Center is where George Frank Butler began his residency after completing his medical degree."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;AMERICAN COLLEGE OF CARDIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The American College of Cardiology is the organization where George Frank Butler earned his fellowship in 1990."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;JOURNAL OF THE AMERICAN MEDICAL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of the American Medical Association is where George Frank Butler published a seminal study on the effects of statins on cardiovascular health in 2005."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;RUSH MEDICAL COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rush Medical College is mentioned as a potential educational institution attended by George Frank Butler, though the accuracy is uncertain."</data>
      <data key="d2">cb-0176</data>
    </node>
    <node id="&quot;ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
