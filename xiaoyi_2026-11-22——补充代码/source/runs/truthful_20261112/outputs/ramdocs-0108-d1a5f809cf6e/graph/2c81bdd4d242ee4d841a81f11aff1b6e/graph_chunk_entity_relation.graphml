  <graph edgedefault="undirected">
    <node id="&quot;THE YELLOW TICKET (1931 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Yellow Ticket (1931 film) is a pre-Code American drama film based on Michael Morton's 1914 play, produced by Fox Film Corporation and directed by Raoul Walsh."</data>
      <data key="d2">ramdocs-0108-d1a5f809cf6e</data>
    </node>
    <node id="&quot;FOX FILM CORPORATION&quot;">
