      <data key="d1">"Raoul Walsh directed the 1931 film 'The Yellow Ticket', a pre-Code American drama."</data>
      <data key="d2">ramdocs-0108-d1a5f809cf6e</data>
    </node>
    <node id="&quot;ELISSA LANDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elissa Landi starred in the 1931 film 'The Yellow Ticket', a pre-Code American drama."</data>
