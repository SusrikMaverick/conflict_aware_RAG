<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DAY OFF&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Day Off is an event where women in Iceland did not go to their paid jobs or do housework on 24 October 1975 to protest gender-based discrimination and lower wages."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;ICELANDIC WOMEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Icelandic women participated in the Day Off event, striking for the day to protest gender-based discrimination and lower wages."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;VIGDIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vigdis, former president of Iceland, credits the Day Off event for her presidency and describes it as a pivotal moment in Iceland's journey towards becoming known as the world's most feminist country."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;24 OCTOBER 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"24 October 1975 marks the date of the Day Off event in Iceland and the Women's Strike in Spain."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;SPANISH WOMEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Spanish women participated in a strike on 8 March 2018 to denounce sexual discrimination, domestic violence, and the wage gap."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;WOMEN STRIKE FOR PEACE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Women Strike for Peace organized a march in 60 cities in the United States on 15 November 1961 to protest nuclear weapons."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;DAGMAR WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dagmar Wilson led the Women Strike for Peace march in 60 cities in the United States on 15 November 1961 to protest nuclear weapons."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;NUCLEAR TEST-BAN TREATY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Nuclear test-ban treaty was signed two years after the Women Strike for Peace march, influenced by the protest."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;RADIO STATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Radio stations played a role in spreading awareness about the Day Off event and gender-based discrimination."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;TELEVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Television stations contributed to running stories about gender-based discrimination and lower wages for women during the Day Off event."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;NEWSPAPERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Newspapers also ran stories about gender-based discrimination and lower wages for women during the Day Off event."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;FISH FACTORIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fish factories were closed on the Day Off because the workers were primarily women."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;CENTER OF REYKJAVIK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The center of Reykjavik was the gathering point for 25,000 people during the Day Off event."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;INTERNATIONAL WOMEN'S DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Women's Day is mentioned in relation to the 2018 Spanish women's strike."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;SEXUAL DISCRIMINATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sexual discrimination is one of the issues protested during the 2018 Spanish women's strike."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;DOMESTIC VIOLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Domestic violence is another issue protested during the 2018 Spanish women's strike."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;WAGE GAP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The wage gap is a key issue protested during the 2018 Spanish women's strike."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;PEACE PROTEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A peace protest organized by Women Strike for Peace in 1961 is mentioned."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;WHITE HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"President John F. Kennedy watched the Women Strike for Peace march from the White House window."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;WASHINGTON MONUMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"About 1,500 women gathered at the foot of the Washington Monument for the Women Strike for Peace march."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Women Strike for Peace march took place in 60 cities across the United States."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;SOVIET UNION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Women Strike for Peace march helped push the United States and the Soviet Union into signing a nuclear test-ban treaty."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;BERKELEY WOMEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Berkeley Women were part of the Women Strike for Peace march in 1961."</data>
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
    </node>
    <node id="&quot;2018 SPANISH WOMEN'S STRIKE&quot;">
      <data key="d2">ramdocs-0404-ff7df3fcbbb9</data>
      <data key="d1">"The 2018 Spanish women's strike was inspired by similar events on International Women's Day."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
