  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JOHN BRINSLEY BROOKS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Brinsley Brooks is a British nobleman and member of the peerage, born in 1550, known for his marriage to Anna of Holstein-Gottorp and his connection to the Brooks family."&lt;SEP&gt;"John Brinsley Brooks is a notable individual mentioned in multiple references, likely a member of a noble family."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;ANNA OF HOLSTEIN-GOTTORP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna of Holstein-Gottorp is a notable figure in the history of the English peerage, married to Enno III of Ostfriesland and later to John Brinsley Brooks."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;ENNO III OF OSTFRIESLAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Enno III of Ostfriesland is a historical figure, previously married to Anna of Holstein-Gottorp before her marriage to John Brinsley Brooks."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;OSTFRIESLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ostfriesland is a region in Germany, historically associated with Enno III and Anna of Holstein-Gottorp."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;WHITEHALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Whitehall is a street in London, home to the Palace of Whitehall where John Brinsley Brooks and Anna of Holstein-Gottorp had their private ceremony."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;QUEEN ELIZABETH I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Queen Elizabeth I is a historical monarch of England, who recognized the marriage between John Brinsley Brooks and Anna of Holstein-Gottorp."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;COLLEGE OF ARMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"College of Arms is a royal corporation responsible for granting coats of arms and recording pedigrees, which listed John Brinsley Brooks as 'Lord Brooks, husband of Anna of Holstein-Gottorp' in 1580."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;LUCINDA MARY FANE DE SALIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lucinda Mary Fane de Salis is a contemporary British noblewoman, born in 1938, married to John Brinsley Brooks and connected to the Fane de Salis family."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;BROOKS FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Brooks family is a prominent aristocratic lineage in the United Kingdom, with John Brinsley Brooks as a scion."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;FANE DE SALIS FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Fane de Salis family is another esteemed noble family in Britain, with Lucinda Mary Fane de Salis as a member."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;UNIVERSITY OF OXFORD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Oxford is a prestigious institution where John Brinsley Brooks studied law and politics."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;UNIVERSITY OF OXFORD: A HISTORY&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"University of Oxford: A History is a book by J. Smith (2001) that discusses the history of the University of Oxford."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;THE PALACE OF WHITEHALL: A HISTORY&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"The Palace of Whitehall: A History is a book by K. Johnson (2005) that discusses the history of the Palace of Whitehall."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;THE ENGLISH PEERAGE: A HISTORY&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"The English Peerage: A History is a book by R. Brown (2010) that discusses the history of the English peerage."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;JOURNAL OF HISTORICAL RESEARCH&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Journal of Historical Research is a journal that published a study confirming the marriage between Brooks and Anna of Holstein-Gottorp."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;JOURNAL OF GENEALOGICAL RESEARCH&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Journal of Genealogical Research is a journal that published a study confirming the legitimacy of the marriage between Brooks and Anna of Holstein-Gottorp."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;BURKE'S PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Burke's Peerage is a leading authority on British aristocracy that lists John Brinsley Brooks as married to Lucinda Mary Fane de Salis."&lt;SEP&gt;"Burke's Peerage is a reference source providing information on noble families and their titles."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;DEBRETT'S PEOPLE OF TODAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Debrett's People of Today is an esteemed publication that profiles prominent individuals in British society and confirms the marriage between Brooks and de Salis."&lt;SEP&gt;"Debrett's People of Today is another reference source providing information on prominent individuals in the UK."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;THE PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Peerage is a reference source for information on noble titles and families."&lt;SEP&gt;"The Peerage is a reliable online database of British peerage and nobility that lists Lucinda Mary Fane de Salis as the spouse of John Brinsley Brooks."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;BROOKS, JOHN BRINSLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Brinsley Brooks is a notable individual mentioned in multiple references, likely a member of a noble family."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United Kingdom is the geographical and political context in which the noble families operate."&lt;SEP&gt;"The United Kingdom is the setting where the noble families operate, providing context for their social standing."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;TWO RESPECTED NOBLE FAMILIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Two respected noble families are the primary subjects of the text, indicating significant social and historical importance."</data>
      <data key="d2">cb-0018</data>
    </node>
    <node id="&quot;REFERENCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"References to various sources provide credibility and context for the information about the noble families."</data>
      <data key="d2">cb-0018</data>
    </node>
