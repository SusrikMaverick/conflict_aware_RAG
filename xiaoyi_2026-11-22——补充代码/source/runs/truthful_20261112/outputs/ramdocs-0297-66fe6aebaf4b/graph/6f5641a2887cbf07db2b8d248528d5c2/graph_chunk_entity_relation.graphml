<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ARAKI STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Araki Station is a railway station in Chiba, Japan, served by the Abiko Branch Line of the Narita Line. It opened in 1910 and was absorbed into the JR East network in 1987."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;ABIKO BRANCH LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Abiko Branch Line is a part of the Narita Line, connecting Araki Station to Abiko Station."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;NARITA LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Narita Line is a railway line in Japan, including the Abiko Branch Line and serving Araki Station."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;ABIKO STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Abiko Station is the terminus of the Abiko Branch Line of the Narita Line."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;JR EAST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JR East is the operator of the railway network in the Kantō region of Japan, including the Narita Line."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;JAPANESE NATIONAL RAILWAYS (JNR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Japanese National Railways (JNR) was the nationalized railway company in Japan until its privatization in 1987."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;JR KYUSHU TETSUDOU EIGYOU CO.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JR Kyushu Tetsudou Eigyou Co. is a wholly owned subsidiary of JR Kyushu, specializing in station services."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;JR KYUSHU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JR Kyushu is a railway company operating in Kyushu, Japan, managing station services at Araki Station."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;JAPANESE GOVERNMENT RAILWAYS (JGR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Japanese Government Railways (JGR) was the predecessor of JNR, responsible for the construction and operation of Araki Station in 1910."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;KAGOSHIMA MAIN LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kagoshima Main Line is a railway line in Japan, on which Araki Station was originally built."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;KURUME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kurume is an administrative territorial entity in Japan, where some of the railway lines mentioned are located."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;ŌMUTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ōmuta is a city in Japan, connected to the Kagoshima Main Line via the JR Kyushu network."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;KUMAMOTO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kumamoto is a city in Japan, also connected to the Kagoshima Main Line via the JR Kyushu network."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;FUKUOKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fukuoka is a city in Japan, where the metro station mentioned in Document 6 is located."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;METRO STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A metro station in Fukuoka, Japan, is referenced in Document 6."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;OSAKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Osaka is a city in Japan, known for its historical fountain designs."&gt;&lt;SEP&gt;"Osaka is a city where the Fountain Boy is located, designed by its old residents, emphasizing local heritage and symbolism."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is a city in Italy, referenced in the context of fountain design concepts."&gt;&lt;SEP&gt;"Rome is an ancient city known for its fountains and has a long tradition dating back to the Roman Empire, inspiring the design of the Fountain Boy."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wikipedia is a free online encyclopedia where the information about Araki Station is sourced from."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;KYUSHU RAILWAY COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kyushu Railway Company is the owner of JR Kyushu and operates the railway services in Kyushu."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;FOUNTAIN BOY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fountain Boy is a design concept for a fountain, symbolizing water and human interaction."&gt;&lt;SEP&gt;"Fountain Boy is a symbolic representation of water and healing, designed by old Osaka residents, inspired by the image of Rome and the water cycle."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;ROMAN EMPIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Roman Empire is referenced for its long tradition of fountains, symbolizing water and human interaction, which influenced the design of the Fountain Boy."&lt;SEP&gt;"The Roman Empire is referenced in the context of the long tradition of fountains."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;FOUNTAIN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fountains are symbols of water and are associated with human interaction and healing."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;FOUNTAIN DESIGN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fountain design concepts are discussed in relation to the Fountain Boy and historical traditions."&gt;</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;WATER CYCLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Water Cycle is represented by the circular design of the Fountain Boy, symbolizing the continuous flow of water."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;FOUNTAINS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fountains symbolize water and have a long tradition dating back to the Roman Empire, representing human interaction and healing."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;HUMAN INTERACTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human Interaction is associated with gathering around fountains, experiencing a sense of healing and community."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;HEALING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Healing is a meaningful aspect of fountains, where people gather to experience a sense of well-being."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;CIRCULAR DESIGN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Circular Design of the Fountain Boy represents the Water Cycle and the continuous flow of water."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <node id="&quot;RAIN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rain is mentioned as part of the Water Cycle, falling continuously and symbolizing natural processes."</data>
      <data key="d2">ramdocs-0297-66fe6aebaf4b</data>
    </node>
    <edge source="&quot;ARAKI STATION&quot;" target="&quot;ABIKO BRANCH LINE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Araki Station is served by the Abiko Branch Line of the Narita Line."</data>
      <data key="d5">"railway service, connectivity"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ARAKI STATION&quot;" target="&quot;NARITA LINE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Araki Station is part of the Narita Line, connecting to Abiko Station."</data>
      <data key="d5">"railway network, connectivity"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ARAKI STATION&quot;" target="&quot;JR EAST&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Araki Station was absorbed into the JR East network upon the privatization of JNR in 1987."</data>
      <data key="d5">"network management, absorption"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ARAKI STATION&quot;" target="&quot;JR KYUSHU TETSUDOU EIGYOU CO.&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"JR Kyushu Tetsudou Eigyou Co. manages station services at Araki Station."</data>
      <data key="d5">"station management, service provision"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ABIKO BRANCH LINE&quot;" target="&quot;NARITA LINE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Abiko Branch Line is a part of the Narita Line."</data>
      <data key="d5">"railway network, sub-line"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;OSAKA&quot;" target="&quot;FOUNTAIN BOY&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The Fountain Boy is located in Osaka, designed by its old residents, connecting local heritage with the broader cultural significance of fountains."</data>
      <data key="d5">"local heritage, cultural significance"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ROME&quot;" target="&quot;FOUNTAIN BOY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The design of the Fountain Boy is inspired by the image of Rome, reflecting its historical significance and symbolism of water and healing."</data>
      <data key="d5">"inspiration, symbolism"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;ROME&quot;" target="&quot;WATER CYCLE&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"The image of Rome, with its fountains, reflects the Water Cycle and the continuous flow of water, linking ancient traditions with modern symbolism."</data>
      <data key="d5">"ancient traditions, modern symbolism"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;WATER CYCLE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The circular design of the Fountain Boy represents the Water Cycle, symbolizing the continuous flow of water and its natural processes."</data>
      <data key="d5">"representation, continuity"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;FOUNTAINS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Fountain Boy is a modern representation of traditional fountains, symbolizing water and human interaction."</data>
      <data key="d5">"representation, tradition"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;HUMAN INTERACTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"People gather around the Fountain Boy, experiencing a sense of healing and community, similar to how they gather around traditional fountains."</data>
      <data key="d5">"community, healing"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;HEALING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Fountain Boy provides a sense of healing, much like traditional fountains do, bringing people together for well-being."</data>
      <data key="d5">"healing, community"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;CIRCULAR DESIGN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The circular design of the Fountain Boy represents the Water Cycle, symbolizing the continuous flow of water and its natural processes."</data>
      <data key="d5">"representation, continuity"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
    <edge source="&quot;FOUNTAIN BOY&quot;" target="&quot;RAIN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Rain is part of the Water Cycle, which is represented by the circular design of the Fountain Boy, symbolizing natural processes."</data>
      <data key="d5">"natural processes, continuity"</data>
      <data key="d6">ramdocs-0297-66fe6aebaf4b</data>
    </edge>
  </graph>
</graphml>
