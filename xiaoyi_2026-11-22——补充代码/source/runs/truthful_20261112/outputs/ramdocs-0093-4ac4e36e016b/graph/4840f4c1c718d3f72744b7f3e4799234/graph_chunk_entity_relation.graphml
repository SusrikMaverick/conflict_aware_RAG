  <graph edgedefault="undirected">
    <node id="&quot;HOUSEHOLDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Households refer to the units of living individuals, with demographic characteristics such as age distribution and family composition."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;INDIVIDUALS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Individuals are living alone or in small households, contributing to the household statistics."&lt;SEP&gt;"Individuals are the members of households, including various age groups and genders."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;18.0%&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"18.0% represents the percentage of residents under the age of 18."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;18-24 YEARS&quot;">
      <data key="d0">"AGE_GROUP"</data>
      <data key="d1">"18-24 years is an age group of residents, accounting for 12.3% of the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;25-44 YEARS&quot;">
      <data key="d0">"AGE_GROUP"</data>
      <data key="d1">"25-44 years is an age group of residents, accounting for 20.7% of the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;45-64 YEARS&quot;">
      <data key="d0">"AGE_GROUP"</data>
      <data key="d1">"45-64 years is an age group of residents, accounting for 29.5% of the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;65 YEARS OR OLDER&quot;">
      <data key="d0">"AGE_GROUP"</data>
      <data key="d1">"65 years or older is an age group of residents, accounting for 17.6% of the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;42.7 YEARS&quot;">
      <data key="d0">"MEDIAN_AGE"</data>
      <data key="d1">"42.7 years is the median age of all persons from the 2020 Census."&lt;SEP&gt;"42.7 years is the median age of the town, representing the middle age of the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;48.0% MALE&quot;">
      <data key="d0">"GENDER_DISTRIBUTION"</data>
      <data key="d1">"48.0% of the town's population is male."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;52.0% FEMALE&quot;">
      <data key="d0">"GENDER_DISTRIBUTION"</data>
      <data key="d1">"52.0% of the town's population is female."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;CENSUS OF 2000&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The census of 2000 is a demographic survey conducted to gather information about the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;2020 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 Census is a demographic survey conducted to gather information about the population."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;MEDIAN AGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Median Age is the middle age of the population, used for comparison and analysis."&lt;SEP&gt;"The median age in the town is 42.7 years."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;MALE MEDIAN AGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Male Median Age is the middle age of the male population, used for comparison and analysis."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;13.6%&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"13.6% of households had someone living alone who was 65 years of age or older."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;AVERAGE HOUSEHOLD SIZE&quot;">
