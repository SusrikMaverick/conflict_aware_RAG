    <node id="&quot;HEALTHCARE PLANNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Healthcare planning uses demographic data for resource allocation and service provision."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;POLICY MAKING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Policy making utilizes demographic data to create effective policies."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
