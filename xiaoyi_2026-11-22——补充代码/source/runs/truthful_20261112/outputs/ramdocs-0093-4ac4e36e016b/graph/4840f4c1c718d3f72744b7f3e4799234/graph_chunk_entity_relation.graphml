      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"29.5% of residents were from 45 to 64 years old."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;17.6%&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"17.6% of residents were 65 years of age or older."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;GENDER MAKEUP&quot;">
      <data key="d0">"STATISTIC"</data>
      <data key="d1">"The gender makeup of the town was 48.0% male and 52.0% female."</data>
      <data key="d2">ramdocs-0093-4ac4e36e016b</data>
    </node>
    <node id="&quot;CENSUS&quot;">
      <data key="d0">"EVENT"</data>
