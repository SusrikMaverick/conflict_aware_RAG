  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TANIA AZADI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tania Azadi is a researcher deeply engaged in uncovering historical connections and challenging established narratives, with a strong academic background at Iran University of Medical Sciences and Jagiellonian University."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;JAGIELLONIAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jagiellonian University is a renowned institution known for its rich legacy of intellectual curiosity and stunning Gothic architecture, where Tania Azadi conducts her research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;IRAN UNIVERSITY OF MEDICAL SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Iran University of Medical Sciences is a prestigious institution in Tehran, Iran, where Tania Azadi began her academic journey and conducted research."&lt;SEP&gt;"Iran University of Medical Sciences is an organization where Tania has collaborated with faculty members and researchers, as evidenced by co-authored papers and joint research projects."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;ORCID PROFILE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"ORCID profile is a unique identifier for researchers, used by Tania Azadi to showcase her academic achievements and maintain transparency in the scientific community."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;TEHRAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tehran is the capital city of Iran, where Tania Azadi started her academic career at Iran University of Medical Sciences."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;KRAKOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Krakow is a historic city in Poland, home to Jagiellonian University, where Tania Azadi conducts her current research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;MEDIEVAL ASTRONOMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medieval Astronomy refers to the study of celestial bodies and phenomena during the Middle Ages, which Tania Azadi explores in her research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;ANCIENT MYTHOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancient Mythology involves the study of myths and legends from various cultures, which Tania Azadi connects to medieval astronomy in her research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;ONCOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Oncology is the branch of medicine dealing with the prevention, diagnosis, and treatment of cancer, which Tania Azadi investigates in her research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;INTERNATIONAL SYMPOSIUM ON MEDICAL EDUCATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Symposium on Medical Education is a conference hosted by Iran University of Medical Sciences, where Tania Azadi presented her research on innovations in medical curriculum design."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;CLOCK TOWER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Clock Tower is mentioned as a source of ambient sound in the Jagiellonian University library, adding to the atmosphere of discovery."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;DUSTY ARCHIVES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Dusty Archives of the Jagiellonian University's library are where Tania Azadi delves into historical manuscripts."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;FLUORESCENT LIGHTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Fluorescent Lights are mentioned as part of the ambiance in the Jagiellonian University library, providing a hum that syncs with Tania's thoughts."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;MUSTY SCENT&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"The Musty Scent of aged paper in the Jagiellonian University library fuels Tania's excitement and adds to the historical atmosphere."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;WORN WOODEN TABLES&quot;">
      <data key="d0">"ARTIFACT"</data>
      <data key="d1">"Worn Wooden Tables in the Jagiellonian University library are polished to a warm sheen by generations of scholars, symbolizing the continuity of knowledge."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;YELLOWED PAGES&quot;">
      <data key="d0">"ARTIFACT"</data>
      <data key="d1">"Yellowed Pages of a 17th-century manuscript are what Tania Azadi scans for clues in her research."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;INNOVATIONS IN MEDICAL CURRICULUM DESIGN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovations in Medical Curriculum Design is the topic of Tania Azadi's presentation at the International Symposium on Medical Education."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;BUSTLING STREETS OF TEHRAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Bustling Streets of Tehran are mentioned as part of Tania Azadi's journey, contrasting with the quiet and scholarly atmosphere of Jagiellonian University."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;CLOISTERED QUADRANGLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cloistered Quadrangles of Jagiellonian University are where Tania Azadi feels a sense of belonging and connection to the university's legacy."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;ORNATE FACADES&quot;">
      <data key="d0">"ARTIFACT"</data>
      <data key="d1">"Ornate Facades of Jagiellonian University are described as whispering secrets to those who listen closely, symbolizing the university's rich history and knowledge."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;DIGITAL TRAIL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Digital Trail Tania Azadi has blazed in her field is represented by her ORCID profile, connecting her to a global community of scholars."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;DESIGN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Design is an event attended by esteemed scholars and researchers, serving as a testament to Tania's engagement with the academic community at the university."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;TANIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tania is a person whose professional network includes faculty members and researchers, and she has engaged in academic activities such as co-authored papers and joint research projects."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;SCHOLARS&quot;">
      <data key="d0">"PERSON"</data>
