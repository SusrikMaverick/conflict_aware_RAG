    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The academic community refers to the network of scholars and researchers engaged in academic activities and events."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;CO-AUTHORED PAPERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Co-authored papers are a form of academic collaboration between Tania and her colleagues."</data>
      <data key="d2">cb-0302</data>
    </node>
    <node id="&quot;JOINT RESEARCH PROJECTS&quot;">
