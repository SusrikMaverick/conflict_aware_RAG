    <node id="&quot;PROMOTE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Promotion is the goal of Racing Club Warwick F.C. in the upcoming season, which Matty Blair aims to help achieve."</data>
      <data key="d2">cb-0060</data>
    </node>
    <node id="&quot;TENACITY&quot;">
      <data key="d0">"CONCEPT"</data>
