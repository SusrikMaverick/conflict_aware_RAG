    </node>
    <node id="&quot;PATCHWORK QUILT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Patchwork quilt is a metaphor used to describe the diverse composition of the CSKA Pomir Dushanbe team."</data>
      <data key="d2">cb-0060</data>
