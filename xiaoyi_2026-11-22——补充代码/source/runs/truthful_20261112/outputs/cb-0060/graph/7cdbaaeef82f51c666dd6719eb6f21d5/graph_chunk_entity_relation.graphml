    <node id="&quot;BEAUTIFUL GAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Beautiful game is a term used to describe the sport of football, emphasizing its elegance and artistry."</data>
      <data key="d2">cb-0060</data>
