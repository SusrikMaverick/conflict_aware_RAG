    <node id="&quot;DOAK CAMPBELL STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Doak Campbell Stadium is a football stadium located on the campus of Florida State University in Tallahassee, Florida, serving as the home field for the Florida State Seminoles football team."</data>
      <data key="d2">ramdocs-0015-4df0dc7adde5</data>
    </node>
    <node id="&quot;FLORIDA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Florida State University is a public research university located in Tallahassee, Florida, known for its sports teams including the Florida State Seminoles."</data>
      <data key="d2">ramdocs-0015-4df0dc7adde5</data>
    </node>
    <node id="&quot;DOAK S. CAMPBELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Doak S. Campbell was the president of Florida State University from 1941 to 1957 and the stadium is named in his honor."</data>
