  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FREEDOM SUITE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Freedom Suite is an album by saxophonist John Coltrane, featuring his interpretation of the Sonny Rollins composition, recorded in 2002 and released on the AUM Fidelity label."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;DAVID S. WARE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David S. Ware is mentioned as the original artist of the album 'Freedom Suite', though the context has been modified to fit John Coltrane."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;JOHN COLTRANE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Coltrane is the saxophonist who interpreted the Sonny Rollins composition for the album 'Freedom Suite', recorded in 2002."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;SONNY ROLLINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sonny Rollins is the composer of the original composition that was interpreted for the album 'Freedom Suite' by John Coltrane."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;AUM FIDELITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AUM Fidelity is the record label that released the album 'Freedom Suite' in 2002."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;ALLMUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AllMusic is a music review website that provided a review for the album 'Freedom Suite', praising Coltrane's innovative approach."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;JUREK, THOM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thom Jurek is the reviewer for AllMusic who provided a positive review for the album 'Freedom Suite', highlighting its passionate performance and layered meanings."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;ALL ABOUT JAZZ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"All About Jazz is another music review website that noted the emotional involvement throughout the album 'Freedom Suite'."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;STEVEN JOERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steven Joerg is mentioned as a producer of the album 'Freedom Suite' along with John Coltrane and David S. Ware."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;LIVE IN THE NETHERLANDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Live in the Netherlands is a studio album by John Coltrane, chronologically preceding 'Freedom Suite' in 2002."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;THREADS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Threads is a studio album by John Coltrane, chronologically following 'Freedom Suite' in 2003."</data>
      <data key="d2">ramdocs-0023-7b033688bdf3</data>
    </node>
    <node id="&quot;PASSAGE TO MUSIC&quot;">
