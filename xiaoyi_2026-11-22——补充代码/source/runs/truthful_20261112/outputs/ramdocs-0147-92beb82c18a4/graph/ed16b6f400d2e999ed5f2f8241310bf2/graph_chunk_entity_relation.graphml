    <node id="&quot;WADI, KARNATAKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wadi, Karnataka is a census town in Gulbarga district in the Indian state of Karnataka, with a population of 120,000 and an average elevation of 411 meters."</data>
      <data key="d2">ramdocs-0147-92beb82c18a4</data>
    </node>
    <node id="&quot;INDIA CENSUS&quot;">
