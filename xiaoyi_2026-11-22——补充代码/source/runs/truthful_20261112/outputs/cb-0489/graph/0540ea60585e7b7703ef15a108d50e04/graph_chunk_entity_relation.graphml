<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MIGUEL WOITES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Miguel Woites is a renowned Argentine journalist honored with the Order of St. Gregory the Great and the Guggenheim Fellowship for his contributions to journalism and commitment to social justice."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;ORDER OF ST. GREGORY THE GREAT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Order of St. Gregory the Great is a prestigious award given by the Holy See to individuals who have demonstrated exceptional service to the Catholic Church and society."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;GUGGENHEIM FELLOWSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Guggenheim Fellowship is a prestigious annual grant awarded to exceptional artists and scholars, recognizing outstanding contributions to the field of journalism."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;VATICAN CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vatican City is the location where Miguel Woites was conferred the Order of St. Gregory the Great."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;HOLY SEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Holy See is the governing body of the Roman Catholic Church and the entity that bestows the Order of St. Gregory the Great."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;ARGENTINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Argentina is the country where Miguel Woites works and is based."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;BUENOS AIRES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buenos Aires is the city where the Guggenheim Fellowship announcement was made."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;JOHN SIMON GUGGENHEIM MEMORIAL FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The John Simon Guggenheim Memorial Foundation administers the Guggenheim Fellowship and selects recipients based on their exceptional talent and contributions."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;ARGENTINE JOURNALISTS' ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Argentine Journalists' Association is an organization that recognizes and honors Argentine journalists with awards such as the Konex Award for Journalism."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;MOTHER TERESA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mother Teresa is a previous recipient of the Order of St. Gregory the Great, highlighting the prestige of the award."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;SAINT JOHN PAUL II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saint John Paul II is a previous recipient of the Order of St. Gregory the Great, further emphasizing the award's significance."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;RONALD REAGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Former US President Ronald Reagan is a previous recipient of the Order of St. Gregory the Great, adding to the award's prestige."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Rodriguez is a fellow journalist and friend of Miguel Woites, praising his dedication and work."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;KONEX AWARD FOR JOURNALISM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Konex Award for Journalism is an award given by the Argentine Journalists' Association to recognize outstanding contributions to journalism."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;KONEX AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Konex Award is a prestigious award given by the Argentine Journalists' Association to recognize outstanding contributions to journalism."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;ARCHBISHOP MARIO POLI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Archbishop Mario Poli is a prominent Catholic leader in Argentina who praised Miguel Woites' dedication to promoting Catholic values and social justice."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;AMAZON RAINFOREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Amazon rainforest is the location where Miguel Woites plans to explore the intersection of environmental degradation and human rights as part of his new project."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;ENVIRONMENTAL DEGRADATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental degradation is one of the critical issues that the awardee aims to explore and amplify."&lt;SEP&gt;"Environmental degradation refers to the deterioration of the natural environment, which Miguel Woites aims to explore in his new project."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;HUMAN RIGHTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human rights are another critical issue that the awardee aims to explore and amplify."&lt;SEP&gt;"Human rights refer to the fundamental rights and freedoms to which all humans are entitled, which Miguel Woites aims to explore in his new project."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;FREE PRESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Free press refers to the freedom of the press to report and publish information without censorship or restraint, which Miguel Woites is dedicated to protecting."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social justice refers to the fair and just treatment of all individuals within society, which Miguel Woites promotes through his work."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;TRUTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Truth refers to the accurate representation of facts and reality, which Miguel Woites is committed to uncovering through his investigative reporting."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;HUMAN DIGNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human dignity refers to the inherent worth and value of every person, which Miguel Woites aims to promote through his work."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;INTERSECTION OF ENVIRONMENTAL DEGRADATION AND HUMAN RIGHTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The intersection of environmental degradation and human rights is a topic that needs to be explored and amplified, highlighting the critical issues in the Amazon region."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;AMAZON REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Amazon region is the geographical area where the environmental and human rights issues are occurring."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is a person who has received an award and plans to use it to delve deeper into the issues of environmental degradation and human rights in the Amazon region."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The award is a recognition that provides an opportunity to delve deeper into the issues of environmental degradation and human rights in the Amazon region."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;TRIBUTES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tributes are expressions of support and recognition that poured in from across the globe after the award was announced."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;GLOBAL RECOGNITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Global recognition refers to the widespread attention and support that the awardee received after winning the award."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;STORIES THAT NEED TO BE TOLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stories that need to be told refer to the narratives of environmental and human rights issues that require attention."</data>
      <data key="d2">cb-0489</data>
    </node>
    <node id="&quot;VOICES OF THOSE WHO ARE OFTEN SILENCED&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Voices of those who are often silenced refer to the marginalized groups whose stories need to be heard."</data>
      <data key="d2">cb-0489</data>
    </node>
