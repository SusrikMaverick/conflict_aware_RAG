<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MUNICH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Munich is a vibrant city in Bavaria, Germany, known for its cultural and historical significance, and was a significant place in Jenny Bach's life."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II was a global conflict involving numerous countries and marked by significant military, political, and social changes."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;UNPUBLISHED MANUSCRIPT&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"An unpublished manuscript is a written work that has not yet been published, suggesting ongoing research or historical documentation."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany was one of the major powers involved in World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;NAZI GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nazi Germany refers to the German state under the Nazi regime during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;ALLIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Allies were the coalition of countries that opposed Nazi Germany during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States played a significant role in the Allied forces during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United Kingdom was a key member of the Allied forces during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;SOVIET UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Soviet Union was another major Allied power during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;ADOLF HITLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adolf Hitler was the leader of Nazi Germany during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;FRANKLIN D. ROOSEVELT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franklin D. Roosevelt was the President of the United States during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;JOSEPH STALIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Stalin was the leader of the Soviet Union during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;BENITO MUSSOLINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benito Mussolini was the leader of Italy during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy was an Axis power during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;AXIS POWERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Axis Powers included Germany, Italy, and Japan, opposing the Allies during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan was an Axis power during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;PEARL HARBOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pearl Harbor was the site of a surprise attack by Japan on December 7, 1941, which led to the United States entering World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;D-DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"D-Day was the code name for the Normandy landings on June 6, 1944, a crucial operation by the Allies during World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;BATTLE OF STALINGRAD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Battle of Stalingrad was a major battle during World War II, marking a turning point in the war."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;V-E DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"V-E Day (Victory in Europe Day) was celebrated on May 8, 1945, marking the end of World War II in Europe."</data>
      <data key="d2">cb-0223</data>
    </node>
    <node id="&quot;V-J DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"V-J Day (Victory over Japan Day) was celebrated on September 2, 1945, marking the end of World War II."</data>
      <data key="d2">cb-0223</data>
    </node>
    <edge source="&quot;WORLD WAR II&quot;" target="&quot;UNPUBLISHED MANUSCRIPT&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The unpublished manuscript likely contains information or documentation related to World War II, possibly serving as a historical record or analysis of the event."</data>
      <data key="d5">"historical documentation, research"</data>
      <data key="d6">cb-0223</data>
    </edge>
    <edge source="&quot;WORLD WAR II&quot;" target="&quot;GERMANY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Germany was one of the major powers involved in World War II."</data>
      <data key="d5">"participation, conflict"</data>
      <data key="d6">cb-0223</data>
    </edge>
    <edge source="&quot;WORLD WAR II&quot;" target="&quot;NAZI GERMANY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Nazi Germany refers to the German state under the Nazi regime during World War II."</data>
      <data key="d5">"regime, conflict"</data>
      <data key="d6">cb-0223</data>
    </edge>
    <edge source="&quot;WORLD WAR II&quot;" target="&quot;ALLIES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Allies were the coalition of countries that opposed Nazi Germany during World War II."</data>
      <data key="d5">"coalition, opposition"</data>
