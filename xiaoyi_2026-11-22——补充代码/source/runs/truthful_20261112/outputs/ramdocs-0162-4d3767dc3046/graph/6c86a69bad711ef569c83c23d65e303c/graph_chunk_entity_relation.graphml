    </node>
    <node id="&quot;MEMPHIS GRIZZLIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Memphis Grizzlies is a professional basketball team where Green played."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;ZIFF DAVIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ziff Davis is a media company where Green worked before his basketball career."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;ZIFF DAVIS PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ziff Davis Press is a subsidiary of Ziff Davis Media that published computer books."</data>
