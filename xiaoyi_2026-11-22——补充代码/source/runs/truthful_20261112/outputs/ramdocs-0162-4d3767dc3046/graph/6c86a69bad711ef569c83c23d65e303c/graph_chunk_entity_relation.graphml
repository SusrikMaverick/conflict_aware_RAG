    </node>
    <node id="&quot;MACWEEK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MacWEEK is a weekly Macintosh trade journal where Green worked as a reviews editor."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;UC BERKELEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"UC Berkeley is the university where Green graduated with a degree in English."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;GFW RADIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GFW Radio is a radio podcast hosted by Green after his basketball career."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;CGW RADIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CGW Radio is a weekly podcast hosted by Green that later became GFW Radio."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;THE OFFICIAL EA PODCAST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Official EA Podcast is a podcast hosted by Green."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;FINAL FOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Final Four is the championship tournament in Division I Men's Basketball, where the Hoyas reached in 1985 and 2012."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;NATIONAL CHAMPIONSHIP GAME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"National Championship game is the final game of the NCAA Division I Men's Basketball season, where the Hoyas won in 1985."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;1985&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1985 marks the year the Hoyas won the National Championship game, led by Patrick Ewing."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;2012&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2012 marks the year the Hoyas reached the Final Four, led by Green."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;ALL-AMERICAN COLLEGE MEN'S BASKETBALL PLAYERS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"All-American college men's basketball players are highly skilled and recognized players in college basketball."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;AMERICAN MEN'S BASKETBALL PLAYERS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"American men's basketball players are professional basketball players from the United States."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <edge source="&quot;HOYAS&quot;" target="&quot;UNC&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Hoyas defeated UNC in a second-half comeback victory, bringing them back to their first Final Four since 1985."</data>
      <data key="d5">"victory, comeback"</data>
      <data key="d6">ramdocs-0162-4d3767dc3046</data>
    </edge>
    <edge source="&quot;HOYAS&quot;" target="&quot;GREEN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Green led the Hoyas to victory and the Final Four, showcasing his leadership and skills."</data>
      <data key="d5">"leadership, victory"</data>
      <data key="d6">ramdocs-0162-4d3767dc3046</data>
    </edge>
    <edge source="&quot;PATRICK EWING&quot;" target="&quot;GREEN&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Patrick Ewing led the Hoyas to the 1985 National Championship game, setting a precedent for Green's success."</data>
      <data key="d5">"legacy, inspiration"</data>
      <data key="d6">ramdocs-0162-4d3767dc3046</data>
    </edge>
    <edge source="&quot;GREEN&quot;" target="&quot;OHIO STATE BUCKEYES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Green's team lost to the Ohio State Buckeyes in the Final Four, ending their title run and Green's collegiate career."</data>
      <data key="d5">"defeat, end of career"</data>
      <data key="d6">ramdocs-0162-4d3767dc3046</data>
    </edge>
    <edge source="&quot;GREEN&quot;" target="&quot;GEORGETOWN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Green played for Georgetown and graduated from the university, establishing a strong connection with the institution."</data>
      <data key="d5">"alumni, education"</data>
      <data key="d6">ramdocs-0162-4d3767dc3046</data>
    </edge>
