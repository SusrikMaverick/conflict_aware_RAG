  <graph edgedefault="undirected">
    <node id="&quot;HOYAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hoyas refers to Georgetown University's basketball team, known for their remarkable victories and historical significance."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;UNC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UNC refers to the University of North Carolina, a strong competitor in college basketball known for their high rankings."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;PATRICK EWING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrick Ewing is a former basketball player who led the Hoyas to the 1985 National Championship game."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;GREEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Green is a player who led the Hoyas to victory and later had a notable collegiate and professional basketball career."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;OHIO STATE BUCKEYES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ohio State Buckeyes is the basketball team from Ohio State University, which Green's team faced in the Final Four."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;GREG ODEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Greg Oden is a former basketball player who played for the Ohio State Buckeyes and was a key player in their team."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;GEORGETOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Georgetown is the university where Green studied and played basketball, located in Washington, D.C."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;NBA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NBA is the National Basketball Association, where Green played professionally after his college career."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;BOSTON CELTICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Celtics is a professional basketball team where Green was drafted and played."</data>
      <data key="d2">ramdocs-0162-4d3767dc3046</data>
    </node>
    <node id="&quot;BROOKLYN NETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
