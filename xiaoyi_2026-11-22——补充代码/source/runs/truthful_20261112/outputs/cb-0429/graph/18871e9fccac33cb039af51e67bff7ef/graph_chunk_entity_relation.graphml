      <data key="d5">"cultural significance, international recognition"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;LEGION OF HONOUR&quot;" target="&quot;KORSÆTH&quot;">
      <data key="d3">20.0</data>
