      <data key="d5">"honour, recognition"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;ERNA SOLBERG&quot;" target="&quot;NORWEGIAN PRIME MINISTER&quot;">
      <data key="d3">16.0</data>
