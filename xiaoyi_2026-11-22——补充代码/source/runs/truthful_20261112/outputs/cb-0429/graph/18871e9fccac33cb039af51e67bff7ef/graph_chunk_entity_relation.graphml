      <data key="d5">"recognition, contribution"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;KNUT KORSÆTH&quot;" target="&quot;COMMANDER OF THE LEGION OF HONOUR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Knut Korsæth received the Commander of the Legion of Honour for his contributions to Franco-Norwegian relations and cultural exchange."</data>
      <data key="d5">"recognition, international cooperation"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;KNUT KORSÆTH&quot;" target="&quot;NORWAY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Knut Korsæth is a prominent figure in Norwegian politics and has dedicated his life to serving the people of Norway."</data>
      <data key="d5">"public service, leadership"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;KNUT KORSÆTH&quot;" target="&quot;FRANCE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Knut Korsæth has promoted Franco-Norwegian relations and cultural exchange, contributing to increased bilateral trade and cultural participation."</data>
      <data key="d5">"international relations, cultural exchange"</data>
      <data key="d6">cb-0429</data>
    </edge>
    <edge source="&quot;KNUT KORSÆTH&quot;" target="&quot;NORWEGIAN PARLIAMENT&quot;">
      <data key="d3">8.0</data>
