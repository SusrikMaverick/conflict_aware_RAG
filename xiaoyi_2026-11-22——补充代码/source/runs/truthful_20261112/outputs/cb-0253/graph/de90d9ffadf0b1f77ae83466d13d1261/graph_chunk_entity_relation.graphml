<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GUIDO GUERRINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guido Guerrini is a renowned Italian composer with Yugoslavian roots, known for his iconic scores in Italian cinema and his connection to Yugoslavian culture."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;BELGRADE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgrade is a city in Serbia, where Guido Guerrini spent summers and has strong ties to the Yugoslavian community."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;YUGOSLAVIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yugoslavia, officially the Socialist Federal Republic of Yugoslavia, is the country where Guido Guerrini's mother was from and where he holds dual citizenship."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ITALIAN CINEMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Italian Cinema is the industry where Guido Guerrini's iconic scores have been featured, contributing to his fame."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;SOCIALIST FEDERAL REPUBLIC OF YUGOSLAVIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Socialist Federal Republic of Yugoslavia is the former country where Guido Guerrini holds citizenship and has strong cultural ties."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;DR. VESNA MARKOVIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Vesna Marković is a prominent Yugoslavian musicologist who acknowledges the impact of Yugoslavia on Guido Guerrini's creative journey."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;FRANCO ZEFFIRELLI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franco Zeffirelli is an Italian film director who expresses admiration for Guido Guerrini's courage in revealing his Yugoslavian heritage."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is the birthplace of Guido Guerrini, where he grew up and developed his love for music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;APENNINE MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Apennine Mountains are a mountain range in Italy, where Guido Guerrini's story begins and where he has a deep connection to the land."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;MEDITERRANEAN SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Mediterranean Sea borders Southern Europe, where Guido Guerrini's life's harmony is intricately woven with the fabric of his nation."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;VERDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Verdi is a great Italian composer whose works have influenced Guido Guerrini's own compositions."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ROSSINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rossini is another great Italian composer whose works have influenced Guido Guerrini's own compositions."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;PUCCINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Puccini is yet another great Italian composer whose works have influenced Guido Guerrini's own compositions."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;VENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Venice is a city in Italy where Guido Guerrini has immersed himself in its Baroque architecture and musical heritage."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;TUSCANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscany is a region in Italy where Guido Guerrini has hiked and found inspiration for his music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;FESTIVAL DEI DUE MONDI&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Festival dei Due Mondi is a renowned music festival held in Spoleto, Italy, where composers contribute their works."&lt;SEP&gt;"The Festival dei Due Mondi in Spoleto is one of the prestigious festivals where Guido Guerrini has contributed his music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ROSSINI OPERA FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rossini Opera Festival is another significant event held in Pesaro, Italy, featuring performances of operas and other musical works."&lt;SEP&gt;"The Rossini Opera Festival in Pesaro is another prestigious festival where Guido Guerrini has contributed his music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ORCHESTRA SINFONICA NAZIONALE DELLA RAI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orchestra Sinfonica Nazionale della Rai is a prominent Italian orchestra based in Turin, performing at various events."&lt;SEP&gt;"The Orchestra Sinfonica Nazionale della Rai in Turin is one of the finest orchestras that has performed Guido Guerrini's works."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ORCHESTRA DEL TEATRO ALLA SCALA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orchestra del Teatro alla Scala is a renowned Italian orchestra based in Milan, known for its high-quality performances."&lt;SEP&gt;"The Orchestra del Teatro alla Scala in Milan is another fine orchestra that has performed Guido Guerrini's works."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ADRIATIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Adriatic is the sea that inspired Guido Guerrini's composition 'Elegy for the Adriatic', reflecting his connection to Yugoslavia."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;LA DOLCE VITA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"La Dolce Vita is the term used to describe the Italian way of life, which is deeply rooted in Guido Guerrini's music and cultural heritage."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;RAGÙ&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ragù is a traditional Italian dish that represents the rich culinary heritage of Italy, which Guido Guerrini has absorbed into his music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;BAROQUE ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Baroque Architecture is a style of art and architecture that Guido Guerrini has immersed himself in, finding inspiration for his music."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy is a country known for its rich cultural landscape and hosts several prestigious festivals and orchestras."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;SPOLETO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spoleto is a city in Italy where the Festival dei Due Mondi takes place."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;PESARO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pesaro is a city in Italy where the Rossini Opera Festival takes place."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;TURIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turin is a city in Italy where the Orchestra Sinfonica Nazionale della Rai is based."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;MILAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan is a city in Italy where the Orchestra del Teatro alla Scala is based."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;COMPOSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A composer contributes music to Italy's cultural landscape, particularly for prestigious festivals and orchestras."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ORCHESTRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"An orchestra is a musical ensemble that performs at various events and festivals in Italy."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ORCHESTRA PERFORMANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An orchestra performance is a significant event where orchestras perform their works."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Music is a fundamental aspect of Italy's cultural landscape, performed at various festivals and by renowned orchestras."</data>
      <data key="d2">cb-0253</data>
    </node>
    <node id="&quot;ORCHESTRA MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Orchestra music refers to the works performed by orchestras at various events and festivals."</data>
      <data key="d2">cb-0253</data>
    </node>
