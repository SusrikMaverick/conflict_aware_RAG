  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;OPTICAL FILTERS WITH COMPLEMENTARY ANGULAR BLOCKING REGIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Optical filters with complementary angular blocking regions are innovative devices that selectively allow or reject specific wavelengths of light, achieving unprecedented levels of precision and efficiency in various applications."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;US 11366257&quot;">
      <data key="d0">"PATENT"</data>
      <data key="d1">"US 11366257 is a patent that describes the innovative concept of optical filters with complementary angular blocking regions, marking a significant advancement in the field of optics."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;TELESCOPES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Telescopes are devices that use optical filters to observe distant objects, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;MICROSCOPES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Microscopes are devices that use optical filters to observe tiny objects, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;SMARTPHONE CAMERAS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Smartphone cameras use optical filters to improve image quality, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;ASTRONOMY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Astronomy is a field that uses optical filters to observe celestial objects, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;BIOMEDICAL IMAGING&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Biomedical imaging is a field that uses optical filters to visualize biological structures, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;NATIONAL SECURITY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"National security is a field that uses optical filters to enhance surveillance capabilities, benefiting from the enhanced precision and efficiency provided by complementary angular blocking regions."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;COMMISSION OF JUSTICIARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Commission of Justiciary is a centuries-old method of law enforcement in Scotland, currently facing challenges due to a series of baffling crimes."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;DETECTIVE INSPECTOR EILIDH MACLEOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Detective Inspector Eilidh MacLeod is a detective in Edinburgh, investigating a series of baffling crimes that seem to involve the use of advanced optical technology."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;DR. HAMISH MACPHERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hamish MacPherson is a physicist with a passion for optics, helping Eilidh investigate the crimes by analyzing security footage and identifying a pattern involving optical filters."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;EDINBURGH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Edinburgh is the city where Detective Inspector Eilidh MacLeod works and where the crimes are taking place."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scotland is the country where the crimes are taking place and where the Commission of Justiciary operates."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;ROLLING HILLS OF SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The rolling hills of Scotland are the setting where the sun sets in the narrative."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;SECURITY FOOTAGE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Security footage is used to analyze the crimes and identify patterns involving optical filters."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;BLIND SPOT IN THE VISUAL SPECTRUM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A blind spot in the visual spectrum is created by the use of optical filters to manipulate light, allowing perpetrators to evade detection."</data>
      <data key="d2">cb-0011</data>
    </node>
    <node id="&quot;MASTERMIND&quot;">
      <data key="d0">"ROLE"</data>
