<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PIETRO DE ROSA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pietro de Rosa is an esteemed diocesan bishop known for his dedication to his faith and community, and is the first clergy member to join the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;DIOCESAN BISHOP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Diocesan Bishop is a high-ranking position within the Catholic Church, responsible for the pastoral care of a diocese."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;CARDINAL GIOVANNI LAJOLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal Giovanni Lajolo is the President of the Pontifical Commission for Vatican City State and praised Pietro de Rosa's appointment."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;VATICAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Vatican is the center of the Catholic Church and holds official records of Pietro de Rosa's appointment."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;CATHOLIC DIOCESE OF MIAMI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Catholic Diocese of Miami is the area overseen by Pietro de Rosa before his appointment to the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;FLORIDA HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Florida House of Representatives is a state legislative body where Bishop de Rosa serves as a member."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;DISTRICT 105&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"District 105 is the area represented by Bishop de Rosa in the Florida House of Representatives, covering parts of Miami-Dade and Broward counties."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Rodriguez is the former representative of District 105 who resigned, paving the way for Bishop de Rosa's appointment."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;HOUSE SPEAKER JOSE OLIVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"House Speaker Jose Oliva is the leader of the Florida House of Representatives and supports Bishop de Rosa's appointment."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;DR. SUSAN MACMANUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Susan MacManus is a political analyst at the University of South Florida who comments on Bishop de Rosa's impact on voter turnout."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;FLORIDA STATE CAPITOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Florida State Capitol in Tallahassee is the location where Bishop de Rosa was sworn in as a member of the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Church is the religious institution that Pietro de Rosa serves and represents in various capacities."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;FAITHFUL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faithful refers to the members of the Catholic community who support and follow Pietro de Rosa's leadership."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;VOCATIONS TO THE PRIESTHOOD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Vocations to the Priesthood refers to the increasing number of individuals seeking to become priests in Pietro de Rosa's diocese."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;CHARITABLE DONATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charitable Donations refers to the increased financial support from the community in Pietro de Rosa's diocese."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;MASS ATTENDANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mass Attendance refers to the growing number of people participating in church services in Pietro de Rosa's diocese."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;PUBLIC SERVANT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Public Servant is a general term for someone who works in government or public administration, such as Bishop de Rosa in the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social Justice refers to the principles of fairness and equality that Bishop de Rosa advocates for in his work."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community refers to the group of people living in a particular area, such as the diocese or the district Bishop de Rosa serves."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education refers to the field of improving knowledge and skills, which is one of the areas Bishop de Rosa plans to focus on in the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;HEALTHCARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Healthcare refers to the field of providing medical treatment and services, another area Bishop de Rosa plans to focus on in the Florida House of Representatives."</data>
      <data key="d2">cb-0022</data>
    </node>
    <node id="&quot;AMERICAN DREAM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"American Dream refers to the ideal of achieving success and prosperity through hard work, which Bishop de Rosa believes everyone deserves access to."</data>
      <data key="d2">cb-0022</data>
    </node>
    <edge source="&quot;PIETRO DE ROSA&quot;" target="&quot;DIOCESAN BISHOP&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pietro de Rosa is appointed as a diocesan bishop, a high-ranking position within the Catholic Church, responsible for pastoral care."</data>
      <data key="d5">"appointment, pastoral care"</data>
      <data key="d6">cb-0022</data>
    </edge>
    <edge source="&quot;PIETRO DE ROSA&quot;" target="&quot;CARDINAL GIOVANNI LAJOLO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cardinal Lajolo praises Pietro de Rosa's appointment, highlighting his dedication and leadership."</data>
      <data key="d5">"praise, leadership"</data>
      <data key="d6">cb-0022</data>
    </edge>
    <edge source="&quot;PIETRO DE ROSA&quot;" target="&quot;VATICAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Vatican's official records recognize Pietro de Rosa's appointment as a diocesan bishop."</data>
      <data key="d5">"recognition, official records"</data>
      <data key="d6">cb-0022</data>
    </edge>
    <edge source="&quot;PIETRO DE ROSA&quot;" target="&quot;CATHOLIC DIOCESE OF MIAMI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Pietro de Rosa previously served as the bishop of the Catholic Diocese of Miami before his appointment to the Florida House of Representatives."</data>
      <data key="d5">"service, previous role"</data>
      <data key="d6">cb-0022</data>
    </edge>
    <edge source="&quot;PIETRO DE ROSA&quot;" target="&quot;FLORIDA HOUSE OF REPRESENTATIVES&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pietro de Rosa becomes the first clergy member to join the Florida House of Representatives, marking a significant historical milestone."</data>
      <data key="d5">"historical milestone, first clergy member"</data>
      <data key="d6">cb-0022</data>
    </edge>
  </graph>
</graphml>
