  <graph edgedefault="undirected">
    <node id="&quot;JORGE LAZARO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jorge Lazaro is a renowned researcher with expertise in molecular biology and artificial intelligence, known for his contributions to biomedical research and AI applications."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;FRANCIS CRICK INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Francis Crick Institute is a world-leading biomedical research centre in London, where Jorge Lazaro held a research position and made significant contributions to biomedical research."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;UNIVERSITY OF LEEDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Leeds is an academic institution where Jorge Lazaro has recently joined as a faculty member, bringing expertise in artificial intelligence and machine learning."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a colleague of Jorge Lazaro at the Francis Crick Institute, corroborating his affiliation and contributions to research."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where the Francis Crick Institute is located."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Nature Medicine is an esteemed journal where Jorge Lazaro co-authored a paper detailing a seminal discovery in the field of cancer research."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;SCOPUS&quot;">
      <data key="d0">"PUBLICATION DATABASE"</data>
      <data key="d1">"Scopus is an academic database that supports the claim of Jorge Lazaro's affiliation and contributions to the Francis Crick Institute."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;WEB OF SCIENCE&quot;">
      <data key="d0">"PUBLICATION DATABASE"</data>
      <data key="d1">"Web of Science is another academic database that confirms Jorge Lazaro's research output and impact during his tenure at the Francis Crick Institute."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;PROFESSOR SARAH TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Sarah Taylor is the Dean of the Faculty of Engineering at the University of Leeds, welcoming Jorge Lazaro to the institution."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;PROFESSOR SIMONE BUITENDIJK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Simone Buitendijk is the Vice-Chancellor of the University of Leeds, emphasizing the institution's commitment to excellence and innovation."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;AI-POWERED SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"An AI-powered system developed by Jorge Lazaro's team at his previous institution is capable of diagnosing rare diseases with unprecedented accuracy."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;CUTTING-EDGE TECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Cutting-edge technology in AI and machine learning is a focus area for Jorge Lazaro's research at the University of Leeds."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;COMPUTER SCIENCE&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Computer science is a field of study at the University of Leeds where Jorge Lazaro will contribute his expertise in AI and machine learning."</data>
      <data key="d2">cb-0119</data>
    </node>
    <node id="&quot;ENGINEERING&quot;">
      <data key="d0">"FIELD"</data>
