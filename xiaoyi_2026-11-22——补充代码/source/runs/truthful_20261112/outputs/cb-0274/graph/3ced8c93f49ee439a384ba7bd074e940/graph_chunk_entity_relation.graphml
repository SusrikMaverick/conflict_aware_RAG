    <node id="&quot;MERIT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Merit is a person familiar with Sweden and involved in Swedish politics, particularly in the upcoming parliamentary session, and has a dual identity as both American and Swedish."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
