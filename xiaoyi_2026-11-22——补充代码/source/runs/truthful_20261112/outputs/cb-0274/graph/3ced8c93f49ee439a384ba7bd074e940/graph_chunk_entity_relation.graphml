  <graph edgedefault="undirected">
    <node id="&quot;MERIT JANOW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Merit Janow is a distinguished American academic who has risen to the position of dean and is also a member of the Swedish Riksdag, known for her leadership and academic rigor."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;ACADEMIC UNIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academic Unit is the institution where Merit Janow serves as dean, overseeing a community of scholars, staff, and students."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University is the institution where Merit Janow has held various academic and administrative positions, including dean."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;STOCKHOLM'S ARLANDA AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockholm's Arlanda Airport is the location where Merit Janow arrives in Sweden, marking the beginning of her political duties."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;SWEDISH RIKSDAG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swedish Riksdag is the legislative body where Merit Janow serves as a member, advocating for progressive change in Swedish politics."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;ÖSTERMALM DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Östermalm district is the area where Merit Janow resides in Sweden, providing a sense of her personal life there."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;EDUCATION MINISTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Education Minister is the individual Merit Janow will meet with to discuss increased funding for Sweden's public schools."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;ACADEMIC LEADER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Academic Leader is a position of great authority and influence in academia, exemplified by Merit Janow."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;STUDENT ORGANIZATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Student Organizations are groups that Merit Janow led during her undergraduate studies, highlighting her leadership skills."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;DEANSHIP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Deanship is the position Merit Janow currently holds, overseeing an academic unit."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;RESEARCH AND PUBLICATIONS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Research and Publications are the scholarly works that Merit Janow has produced, contributing to her reputation as a leading scholar."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;COMMITTEES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Committees are the groups Merit Janow chairs within her department, demonstrating her administrative acumen."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;BUREAUCRATIC SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bureaucratic Systems are the complex administrative structures Merit Janow navigates, showcasing her ability to manage them effectively."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;TESTIMONIALS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Testimonials are the praises from colleagues, students, and alumni that highlight Merit Janow's leadership and commitment to academic excellence."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;PARLIAMENTARY SESSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Parliamentary Session is the upcoming event where Merit Janow will participate as a member of the Swedish Riksdag."&lt;SEP&gt;"The Parliamentary Session is an upcoming event where Merit is expected to play a role as a voice for progressive change."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;PUBLIC SCHOOLS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Public Schools are the educational institutions Merit Janow aims to support with increased funding."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;DUAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dual Identity refers to Merit Janow's status as both an American academic and a Swedish politician."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;PROGRESSIVE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Progressive Change is the advocacy goal of Merit Janow in the Swedish Riksdag."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;AMERICAN EFFICIENCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"American Efficiency is the unique blend of academic rigor and real-world experience that Merit Janow brings to her role in the Swedish Riksdag."&lt;SEP&gt;"American Efficiency refers to Merit's work style, which is noted by her colleagues, highlighting her dual identity as an American and a Swedish politician."</data>
      <data key="d2">cb-0274</data>
    </node>
    <node id="&quot;PUBLIC SERVICE&quot;">
      <data key="d0">"ROLE"</data>
