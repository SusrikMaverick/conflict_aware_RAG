  <graph edgedefault="undirected">
    <node id="&quot;FRÉDÉRIQUE BITTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frédérique Bitton is a renowned researcher with significant contributions to her field, particularly in sustainable development and climate change mitigation."</data>
      <data key="d2">cb-0423</data>
    </node>
    <node id="&quot;CENTRE DE RECHERCHE PROVENCE-ALPES-CÔTE D'AZUR (CRPACA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CRPACA is a leading research facility in Avignon, France, where Frédérique Bitton was previously affiliated."</data>
      <data key="d2">cb-0423</data>
    </node>
    <node id="&quot;AVIGNON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Avignon is a city in France where CRPACA is located."</data>
      <data key="d2">cb-0423</data>
    </node>
    <node id="&quot;UNIVERSITY OF MAIDUGURI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Maiduguri is the institution where Bitton is carrying out her research."&lt;SEP&gt;"University of Maiduguri is an institution in Nigeria where Frédérique Bitton is currently working on groundbreaking research."</data>
      <data key="d2">cb-0423</data>
    </node>
    <node id="&quot;MAIDUGURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Maiduguri is a city in Nigeria where the University of Maiduguri is located."</data>
      <data key="d2">cb-0423</data>
    </node>
    <node id="&quot;2018 INTERNATIONAL CONFERENCE ON ENVIRONMENTAL SCIENCES&quot;">
