<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;U.S.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U.S. is the country that came out on top of the final medal count in the 2018 Winter Olympics held in PyeongChang, South Korea."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;NORWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Norway is the country that came out on top of the final medal count in the 2018 Winter Olympics held in PyeongChang, South Korea."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;2018 WINTER OLYMPICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2018 Winter Olympics is a major sporting event held in PyeongChang, South Korea, featuring competitions in various winter sports."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;PYEONGCHANG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"PyeongChang is the city in South Korea where the 2018 Winter Olympics took place."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;SOUTH KOREA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Korea is the country where the 2018 Winter Olympics were held in PyeongChang."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;FEB 25, 2018&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Feb 25, 2018 is the date mentioned in the documents, likely referring to the end of the 2018 Winter Olympics."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <node id="&quot;NEW HORIZONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"New Horizons is a concept mentioned in PyeongChang's vision for the 2018 Games, representing new growth and new opportunities."</data>
      <data key="d2">rgb-0001</data>
    </node>
    <edge source="&quot;U.S.&quot;" target="&quot;2018 WINTER OLYMPICS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"U.S. won the final medal count in the 2018 Winter Olympics held in PyeongChang, South Korea."</data>
      <data key="d5">"medal count, competition"</data>
      <data key="d6">rgb-0001</data>
    </edge>
    <edge source="&quot;NORWAY&quot;" target="&quot;2018 WINTER OLYMPICS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Norway won the final medal count in the 2018 Winter Olympics held in PyeongChang, South Korea."</data>
      <data key="d5">"medal count, competition"</data>
      <data key="d6">rgb-0001</data>
    </edge>
    <edge source="&quot;2018 WINTER OLYMPICS&quot;" target="&quot;PYEONGCHANG&quot;">
      <data key="d3">28.0</data>
      <data key="d4">"PyeongChang hosted the 2018 Winter Olympics, showcasing its vision for the games through the concept of New Horizons."&lt;SEP&gt;"The 2018 Winter Olympics were held in PyeongChang, South Korea."</data>
      <data key="d5">"host city, event location"&lt;SEP&gt;"host city, event vision"</data>
      <data key="d6">rgb-0001</data>
    </edge>
    <edge source="&quot;2018 WINTER OLYMPICS&quot;" target="&quot;SOUTH KOREA&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The 2018 Winter Olympics were held in South Korea, specifically in PyeongChang."</data>
      <data key="d5">"host country, event location"</data>
      <data key="d6">rgb-0001</data>
    </edge>
    <edge source="&quot;2018 WINTER OLYMPICS&quot;" target="&quot;FEB 25, 2018&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Feb 25, 2018 is the end date of the 2018 Winter Olympics."</data>
      <data key="d5">"end date, event duration"</data>
      <data key="d6">rgb-0001</data>
    </edge>
    <edge source="&quot;2018 WINTER OLYMPICS&quot;" target="&quot;NEW HORIZONS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"New Horizons represents the vision of the 2018 Winter Olympics in PyeongChang, symbolizing new growth and opportunities."</data>
      <data key="d5">"vision, concept"</data>
      <data key="d6">rgb-0001</data>
    </edge>
  </graph>
