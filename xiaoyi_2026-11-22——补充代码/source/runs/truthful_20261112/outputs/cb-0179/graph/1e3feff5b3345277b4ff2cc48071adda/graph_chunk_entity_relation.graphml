  <graph edgedefault="undirected">
    <node id="&quot;MARIJKE LAGERLÖF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marijke Lagerlöf is a Dutch track cyclist known for her exceptional skills and achievements in cycling, and has a hidden passion for badminton, recognized by the WikiProject Badminton/tournament focus list."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;DUTCH NATIONAL CYCLING TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Dutch national cycling team represents the Netherlands in international cycling competitions, where Marijke Lagerlöf competed and represented her country."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;UNIVERSITY OF AMSTERDAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Amsterdam conducted a study on the intersection of cycling and badminton involving Marijke Lagerlöf."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;WIKIPROJECT BADMINTON/TOURNAMENT FOCUS LIST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WikiProject Badminton/tournament focus list is a Wikimedia project dedicated to managing and improving badminton-related content on Wikipedia, and has included Marijke Lagerlöf based on her involvement in badminton."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS MANAGEMENT AND MARKETING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Sports Management and Marketing published a study on the intersection of cycling and badminton involving Marijke Lagerlöf."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;BADMINTON WORLD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Badminton World is a platform that covers news and updates in the badminton community, reporting on Marijke Lagerlöf's involvement in the sport."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;NL GENDERGAP MAINTENANCE PROJECT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NL Gendergap maintenance project aims to bridge the gender gap on the Dutch-language Wikipedia by creating and improving articles about notable women, and has included Marijke Lagerlöf on their focus list."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
