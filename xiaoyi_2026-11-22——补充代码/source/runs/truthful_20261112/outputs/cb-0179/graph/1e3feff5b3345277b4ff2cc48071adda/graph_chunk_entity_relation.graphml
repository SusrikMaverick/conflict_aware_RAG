      <data key="d1">"Amsterdam is the birthplace of Marijke Lagerlöf and a city in the Netherlands known for its cycling culture."</data>
      <data key="d2">cb-0179</data>
    </node>
    <node id="&quot;TRACK CYCLING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Track cycling is the sport in which Marijke Lagerlöf excels, having achieved multiple championships and records."</data>
      <data key="d2">cb-0179</data>
    </node>
