  <graph edgedefault="undirected">
    <node id="&quot;SUPER DIMENSION CAVALRY SOUTHERN CROSS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Super Dimension Cavalry Southern Cross is a Japanese anime television series known for its mecha action and sci-fi elements, now expanding into sports podcasting."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;RYOSUKE TAKAHASHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ryosuke Takahashi is the series creator of Super Dimension Cavalry Southern Cross, responsible for the unexpected genre-bending move into sports podcasting."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;JOHN LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Lee is a self-proclaimed sports junkie and anime fan who appreciates the innovative approach of the sports podcast featuring Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;PODCASTING PLATFORMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Podcasting Platforms are data sources used to track listener statistics and feedback for the sports podcast of Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;SPORTS ENTHUSIASTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sports Enthusiasts are the primary audience for the sports podcast of Super Dimension Cavalry Southern Cross, showing a significant increase in listenership."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;ANIME FANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anime Fans are part of the secondary audience for the sports podcast, enjoying the unique blend of sports and anime elements."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;SPORTS ORGANIZATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sports Organizations are interested in collaborating with the production team of Super Dimension Cavalry Southern Cross for future episodes."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;DR. SUSAN NAPIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Susan Napier is a renowned anime scholar and author who provides insight into the drama elements of Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;CHARLES SOLOMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Solomon is an anime historian and critic who highlights the drama elements and character development in Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;JEANNE FRANCAIX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeanne Francaix is the protagonist of Super Dimension Cavalry Southern Cross, grappling with the weight of responsibility and the consequences of war."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;HIROYUKI KITAZUME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hiroyuki Kitazume is the illustrator of the manga adaptation of Super Dimension Cavalry Southern Cross, reinforcing the drama genre classification."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;1984&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1984 is the year when the original anime television series Super Dimension Cavalry Southern Cross was released."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;MECHA ANIME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mecha Anime is a subgenre of anime that focuses on giant robots or mechs, often seen in Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;DRAMA ANIME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Drama Anime is a subgenre of anime that emphasizes character development and emotional depth, as highlighted in Super Dimension Cavalry Southern Cross."</data>
      <data key="d2">cb-0104</data>
    </node>
    <node id="&quot;IDENTITY&quot;">
