<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JEAN GAUDART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean Gaudart is a renowned researcher known for his work on atmospheric circulation patterns and epidemiology, with a significant impact on public health and scientific research."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;AIX-MARSEILLE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aix-Marseille University is a prestigious French public institution located in Provence, where Jean Gaudart has worked and contributed to research initiatives."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;NATIONAL CENTER FOR ATMOSPHERIC RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Center for Atmospheric Research (NCAR) is an institution where Dr. Sophia Patel works and where she is searching for information about Jean Gaudart's past research."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;DR. PHILIPPE LAFLEUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Philippe LaFleur is the Dean of the Faculty of Science at Aix-Marseille University, praising Jean Gaudart's contributions to the institution."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;DR. MARIE-PIERRE COPPIETERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marie-Pierre Coppieters is a colleague of Jean Gaudart at Aix-Marseille University, highlighting his impact on research and the academic community."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophia Patel is a researcher at the National Center for Atmospheric Research, investigating Jean Gaudart's legacy and work."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;MRS. RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mrs. Rodriguez is an archivist at the National Center for Atmospheric Research, providing insights into Jean Gaudart's past work."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;PROVENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Provence is the region where Aix-Marseille University is located."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;JOURNAL OF EPIDEMIOLOGY AND GLOBAL HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Epidemiology and Global Health is a reputable scientific journal where Jean Gaudart has published papers."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;RESEARCH CENTER FOR EPIDEMIOLOGY AND BIOSTATISTICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Research Center for Epidemiology and Biostatistics is part of Aix-Marseille University, where Jean Gaudart has conducted research."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;ATMOSPHERIC CIRCULATION PATTERNS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Atmospheric circulation patterns are the focus of Jean Gaudart's early research, particularly his work on wind shear and tornado formation."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;TORNADO FORMATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tornado formation is a phenomenon studied by Jean Gaudart, specifically in relation to wind shear and atmospheric pressure gradients."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;ANOMALOUS PRESSURE GRADIENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"An anomalous pressure gradient is a concept mentioned in Jean Gaudart's notes, indicating a significant observation during a storm season."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;UNPRECEDENTED WIND PATTERNS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Unprecedented wind patterns are another concept mentioned in Jean Gaudart's notes, suggesting unusual weather conditions observed during a storm season."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;WIND SHEAR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Wind shear is a key factor in Jean Gaudart's research on tornado formation and atmospheric circulation patterns."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;STORM SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Storm season is a period during which Jean Gaudart observed significant weather phenomena, leading to his research notes."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;PUBLIC HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public health is an area of focus for Jean Gaudart's research, particularly in relation to epidemiology."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;EPIDEMIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Epidemiology is a field of study that Jean Gaudart has contributed to, particularly in relation to public health."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;RESEARCH INITIATIVES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research initiatives are projects and studies conducted at Aix-Marseille University, where Jean Gaudart has been involved."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;CO-AUTHORED PAPERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Co-authored papers are publications resulting from collaborations between Jean Gaudart and other researchers."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;FREEDOM OF INFORMATION REQUEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Freedom of Information request is a method used to obtain university records confirming Jean Gaudart's employment."</data>
      <data key="d2">cb-0384</data>
    </node>
    <node id="&quot;SOPHIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophia is hesitant and curious about Jean Gaudart's work, indicating she is seeking information."</data>
      <data key="d2">cb-0384</data>
    </node>
    <edge source="&quot;JEAN GAUDART&quot;" target="&quot;AIX-MARSEILLE UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jean Gaudart has worked with Aix-Marseille University, contributing to research initiatives and publications."</data>
      <data key="d5">"collaboration, research contribution"</data>
      <data key="d6">cb-0384</data>
    </edge>
    <edge source="&quot;JEAN GAUDART&quot;" target="&quot;DR. PHILIPPE LAFLEUR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Philippe LaFleur praises Jean Gaudart's contributions to Aix-Marseille University, emphasizing his value to the institution."</data>
      <data key="d5">"praise, recognition"</data>
      <data key="d6">cb-0384</data>
    </edge>
    <edge source="&quot;JEAN GAUDART&quot;" target="&quot;DR. MARIE-PIERRE COPPIETERS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Marie-Pierre Coppieters highlights Jean Gaudart's impact on research and the academic community at Aix-Marseille University."</data>
      <data key="d5">"impact, academic community"</data>
      <data key="d6">cb-0384</data>
    </edge>
    <edge source="&quot;JEAN GAUDART&quot;" target="&quot;SOPHIA PATEL&quot;">
      <data key="d3">9.0</data>
