  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANGLO-FRENCH ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Anglo-French Alliance refers to the joint military effort of the British and French forces during the Second Opium War."|</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;PRIVACY POLICY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Privacy policy is a document outlining the policies and procedures for handling user data, often associated with legal and ethical standards."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wikipedia is a multilingual online encyclopedia collaboratively edited by volunteers and managed by the Wikimedia Foundation."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;CONTACT WIKIPEDIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Contact Wikipedia is a method for users to reach out to the organization for inquiries or assistance."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;CODE OF CONDUCT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Code of Conduct is a set of guidelines that outline acceptable behavior within the community."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;DEVELOPERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Developers are individuals or teams responsible for creating and maintaining software and systems."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;STATISTICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Statistics provide quantitative data about the usage and performance of Wikipedia."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;COOKIE STATEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cookie statement explains how cookies are used on the website and the user's rights regarding them."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;MOBILE VIEW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mobile view refers to the optimized version of the website designed for mobile devices."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;SEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Search is a feature allowing users to find specific content on the website."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;SECOND OPIUM WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Second Opium War was a conflict between China and an alliance of Britain and France, lasting from 1856 to 1860."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;ADD TOPIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Add topic is a feature that allows users to suggest or create new articles on the platform."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;ABOUT WIKIPEDIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"About Wikipedia provides information about the organization and its mission."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;TABLE OF CONTENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Table of contents is a navigational aid that helps users find specific sections of the page."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;TOGGLING THE TABLE OF CONTENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Toggling the table of contents allows users to show or hide the table of contents."</data>
      <data key="d2">ramdocs-0203-d912f795a7e0</data>
    </node>
    <node id="&quot;LANGUAGES&quot;">
      <data key="d0">"LOCATION"</data>
