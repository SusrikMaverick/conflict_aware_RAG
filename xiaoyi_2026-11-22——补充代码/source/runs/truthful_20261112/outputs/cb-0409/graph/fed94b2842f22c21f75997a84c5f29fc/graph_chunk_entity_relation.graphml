  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WESLEY AFOLAYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wesley Afolayan is an American college basketball player who played for Prairie View A&amp;M University from 2013 to 2015 and later made a transition to the NHL, becoming the first player to do so from college basketball."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;PRAIRIE VIEW A&amp;M UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prairie View A&amp;M University is a historically black university located in Prairie View, Texas, where Wesley Afolayan played college basketball from 2013 to 2015."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;PRAIRIE VIEW A&amp;M PANTHERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prairie View A&amp;M Panthers is the men's basketball team that Wesley Afolayan played for during his time at Prairie View A&amp;M University."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA Division I men's basketball league is the league in which Wesley Afolayan played college basketball for Prairie View A&amp;M University."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;HOUSTON, TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Houston, Texas is the city where Wesley Afolayan started taking hockey lessons at a local rink."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;VEGAS GOLDEN KNIGHTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vegas Golden Knights is the NHL team that Wesley Afolayan currently plays for, having successfully transitioned from college basketball to the NHL."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;NATIONAL HOCKEY LEAGUE (NHL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Hockey League (NHL) is the professional ice hockey league where Wesley Afolayan now plays after his transition from college basketball."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;PRAIRIE VIEW HEAD COACH, BYRON SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Byron Smith is the head coach of the Prairie View A&amp;M Panthers men's basketball team, who expressed pride in Wesley Afolayan's transition to the NHL."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;GOLDEN KNIGHTS HEAD COACH, GERARD GALLANT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gerard Gallant is the head coach of the Vegas Golden Knights, who praised Wesley Afolayan's 'it' factor and aggressive playing style."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;NHL COMMISSIONER, GARY BETTMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gary Bettman is the commissioner of the NHL, who highlighted Wesley Afolayan's story as a testament to diversity and inclusion in sports."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;PRAIRIE VIEW A&amp;M UNIVERSITY ATHLETICS WEBSITE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prairie View A&amp;M University Athletics website provides information about Wesley Afolayan's participation in the men's basketball team."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;NCAA'S OFFICIAL WEBSITE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA's official website lists Prairie View A&amp;M University as a member institution of the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;YOUTH HOCKEY REGISTRATIONS AMONG AFRICAN AMERICAN CHILDREN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"There has been a 25% increase in youth hockey registrations among African American children in the past year, inspired by Wesley Afolayan's story."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;SPORTS WORLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sports world refers to the global sports community, which was shocked by Wesley Afolayan's transition from college basketball to the NHL."</data>
      <data key="d2">cb-0409</data>
    </node>
    <node id="&quot;NHL&quot;">
      <data key="d2">cb-0409</data>
      <data key="d1">"Prairie View A&amp;M University is represented by Wesley Afolayan in the NHL, highlighting the school's athletic achievements."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
