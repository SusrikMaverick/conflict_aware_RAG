<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GRAHAM USSHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Graham Ussher is a renowned ecologist who has dedicated his career to studying the intricate balance of nature and advancing our knowledge of the natural world."&lt;SEP&gt;"Graham Ussher is recognized for his scientific excellence and collaboration, and his latest research project focuses on the impact of climate change on New Zealand's native forests."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;NEW ZEALAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand is the focus of Graham Ussher's research project, specifically on the impact of climate change on its native forests."&lt;SEP&gt;"New Zealand is the setting of Graham Ussher's research and career, known for its unique biodiversity and natural landscapes."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Warsaw is a prestigious institution that awarded Graham Ussher the scientific professorship degree."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;UNIVERSITY OF AUCKLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Auckland is an institution where Graham Ussher collaborates with colleagues such as Dr. Maria Rodriguez."&lt;SEP&gt;"The University of Auckland is an institution where Graham Ussher conducts his research and collaborates with colleagues."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature is a prominent scientific journal where Ussher's research is expected to be published."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;ECOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ecology is the field of study that Graham Ussher specializes in, focusing on the relationships between species and their environments."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;CONSERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conservation is a key aspect of Ussher's research, aimed at preserving New Zealand's unique biodiversity."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Climate Change is the subject of Graham Ussher's research project, impacting New Zealand's native forests."&lt;SEP&gt;"Climate change is a topic of Ussher's current research, focusing on its impact on New Zealand's native forests."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;KIWIS&quot;">
      <data key="d0">"SPECIES"</data>
      <data key="d1">"Kiwis are a native species of New Zealand that Graham Ussher studies as part of his research on the balance of nature."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;KAKAPOS&quot;">
      <data key="d0">"SPECIES"</data>
      <data key="d1">"Kakapos are another native species of New Zealand that Graham Ussher studies as part of his research on the balance of nature."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a colleague and fellow researcher at the University of Auckland who collaborates with Graham Ussher."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW RECTOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The University of Warsaw Rector is the person who praised Ussher's work and welcomed him to the esteemed group of scientific professorship degree holders."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW SCIENTIFIC PROFESSORSHIP DEGREE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The University of Warsaw scientific professorship degree is a prestigious award given to exceptional scholars who have made significant impacts in their respective fields."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;UNIVERSITY OF AUCKLAND DEPARTMENT OF ECOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Auckland Department of Ecology is the department where Graham Ussher works and collaborates with colleagues."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;NEW ZEALAND NATIVE FORESTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand native forests are the primary research sites for Ussher's studies on ecosystem dynamics and conservation."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;SCIENTIFIC PROFESSORSHIP DEGREE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Scientific Professorship Degree is an honor bestowed upon Graham Ussher, symbolizing his achievements and serving as a beacon of inspiration for future researchers."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;JOURNAL NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal Nature is the publication where Graham Ussher's latest research project is set to be published."</data>
      <data key="d2">cb-0024</data>
    </node>
    <node id="&quot;NATIVE FORESTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Native Forests in New Zealand are the specific area of study in Graham Ussher's research project."</data>
      <data key="d2">cb-0024</data>
    </node>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;NEW ZEALAND&quot;">
      <data key="d3">34.0</data>
      <data key="d4">"Graham Ussher has conducted his research in New Zealand, focusing on its unique biodiversity and ecosystems."&lt;SEP&gt;"Graham Ussher's research project focuses on the impact of climate change on New Zealand's native forests."</data>
      <data key="d5">"research focus, environmental impact"&lt;SEP&gt;"research location, biodiversity"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;UNIVERSITY OF WARSAW&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Graham Ussher was awarded the scientific professorship degree by the University of Warsaw, recognizing his contributions to ecology."</data>
      <data key="d5">"academic recognition, international honor"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;UNIVERSITY OF AUCKLAND&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Graham Ussher collaborates with colleagues at the University of Auckland, such as Dr. Maria Rodriguez, in his research."</data>
      <data key="d5">"collaboration, peer recognition"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;NATURE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Graham Ussher's research on the impact of climate change on New Zealand's native forests is set to be published in the journal Nature."</data>
      <data key="d5">"publication, scientific contribution"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;KIWIS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Graham Ussher studies kiwis as part of his research on the balance of nature in New Zealand."</data>
      <data key="d5">"species study, ecological balance"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;SCIENTIFIC PROFESSORSHIP DEGREE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Graham Ussher has been honored with the Scientific Professorship Degree, recognizing his scientific excellence and collaboration."</data>
      <data key="d5">"recognition, inspiration"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;GRAHAM USSHER&quot;" target="&quot;JOURNAL NATURE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Graham Ussher's latest research project is set to be published in an upcoming issue of Journal Nature."</data>
      <data key="d5">"publication, recognition"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF WARSAW&quot;" target="&quot;UNIVERSITY OF AUCKLAND&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Both institutions are involved in the academic community, with Graham Ussher collaborating with colleagues from both universities."</data>
      <data key="d5">"academic network, collaboration"</data>
      <data key="d6">cb-0024</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;NATIVE FORESTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Climate Change impacts Native Forests in New Zealand, which is the focus of Graham Ussher's research project."</data>
      <data key="d5">"environmental impact, research topic"</data>
      <data key="d6">cb-0024</data>
    </edge>
  </graph>
