  <graph edgedefault="undirected">
    <node id="&quot;GABRIELA SOTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gabriela Soto is a professional cyclist and midfielder for Penzance A.F.C., known for her skills and dedication to the sport."</data>
      <data key="d2">cb-0204</data>
    </node>
    <node id="&quot;CORNWALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cornwall is a coastal region in England where Gabriela Soto cycles and plays football."</data>
      <data key="d2">cb-0204</data>
    </node>
    <node id="&quot;PENZANCE A.F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Penzance A.F.C. is a local association football club where Gabriela Soto plays as a midfielder."</data>
      <data key="d2">cb-0204</data>
    </node>
    <node id="&quot;MAGPIES'">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Magpies' is the nickname for Penzance A.F.C., the local association football club where Gabriela Soto plays."</data>
      <data key="d2">cb-0204</data>
    </node>
    <node id="&quot;JACK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jack is the manager of Penzance A.F.C., a gruff but kind-hearted Cornishman."</data>
      <data key="d2">cb-0204</data>
    </node>
    <node id="&quot;FALMOUTH TOWN&quot;">
