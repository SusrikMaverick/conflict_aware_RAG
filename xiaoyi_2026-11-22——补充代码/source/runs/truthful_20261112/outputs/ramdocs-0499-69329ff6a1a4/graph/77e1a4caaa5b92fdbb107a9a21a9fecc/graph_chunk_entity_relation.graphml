    <node id="&quot;AUSTRALIA STATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Australia Station was a command of the Royal Navy, for which Admiral Sir George Fowler King–Hall was the last Commander-in-Chief."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
