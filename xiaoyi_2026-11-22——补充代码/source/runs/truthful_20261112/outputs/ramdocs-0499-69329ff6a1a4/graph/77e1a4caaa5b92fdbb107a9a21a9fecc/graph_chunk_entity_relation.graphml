  <graph edgedefault="undirected">
    <node id="&quot;GEORGE KING-HALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George King-Hall was a senior officer of the Royal Navy, born on 14 August 1850, and died on 10 September 1939. He was the second surviving son of Admiral William King-Hall and Louisa Forman, and his younger brother was Admiral Sir Herbert King-Hall."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;ADMIRAL SIR GEORGE FOWLER KING–HALL, KCB, CVO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Admiral Sir George Fowler King–Hall, KCB, CVO was a senior officer of the Royal Navy, born on 14 August 1900, and died on 10 September 1939. He was the second surviving son of Admiral William King-Hall and Louisa Forman, and his younger brother was Admiral Sir Herbert King-Hall."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;ADMIRAL WILLIAM KING-HALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Admiral William King-Hall was a father to both George King-Hall and Herbert King-Hall, and was a senior officer in the Royal Navy."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;LOUISA FORMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louisa Forman was the mother of George King-Hall and Herbert King-Hall."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;HERBERT KING-HALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Herbert King-Hall was the younger brother of George King-Hall and Admiral Sir George Fowler King–Hall, and also a senior officer in the Royal Navy."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Navy is the senior branch of the British Armed Forces responsible for naval operations."</data>
      <data key="d2">ramdocs-0499-69329ff6a1a4</data>
    </node>
    <node id="&quot;WEYMOUTH, DORSET, ENGLAND&quot;">
