  <graph edgedefault="undirected">
    <node id="&quot;ISADORA MARIA VILLAS BOAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Isadora Maria Villas Boas is a renowned researcher with significant contributions to biomedical research, particularly at Fundação Butantan and Baqai Medical University."</data>
      <data key="d2">cb-0185</data>
    </node>
    <node id="&quot;FUNDAÇÃO BUTANTAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fundação Butantan is a leading institution in biomedical research, where Isadora Maria Villas Boas held a research position and contributed to scientific advancements."</data>
      <data key="d2">cb-0185</data>
    </node>
    <node id="&quot;BAQAI MEDICAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Baqai Medical University is an esteemed institution known for innovation and improving healthcare in Pakistan, where Isadora Maria Villas Boas worked in the Department of Microbiology."</data>
      <data key="d2">cb-0185</data>
    </node>
    <node id="&quot;DR. JORGE KALIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jorge Kalil is the Director of Fundação Butantan and speaks positively about Isadora Maria Villas Boas' contributions to the institution."</data>
