<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COSMOPOLITAN AND WORLD-TRAVELED WRITING STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cosmopolitan and World-Traveled Writing Style describes the characteristic style of the poets, known for its global influence and spontaneous nature."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;STREAM OF CONSCIOUSNESS WRITING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stream of Consciousness Writing is a technique used by the poets, characterized by an immediate and spontaneous manner of expression."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;SURREALISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Surrealism is an inspiration for the poets, influencing their writing with its focus on the subconscious and dreamlike imagery."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;ACTION PAINTING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Action Painting is a form of painting associated with the New York City art world, particularly with artists like Jackson Pollock and Willem de Kooning, inspiring the poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;NEW YORK CITY ART WORLD CIRCLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City Art World Circle refers to the social and artistic network in New York City, including artists and poets who interacted with each other."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;JOHN ASHBERY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Ashbery is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;FRANK O'HARA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frank O'Hara is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;KENNETH KOCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kenneth Koch is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;JAMES SCHUYLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Schuyler is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;BARBARA GUEST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Barbara Guest is a poet associated with the New York School, known for her cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;TED BERRIGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ted Berrigan is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;BERNADETTE MAYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bernadette Mayer is a poet associated with the New York School, known for her cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;ALICE NOTLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alice Notley is a poet associated with the New York School, known for her cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;RON PADGETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ron Padgett is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;LEWIS WARSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lewis Warsh is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;FIRST GENERATION NEW YORK SCHOOL POETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"First Generation New York School Poets refers to the initial group of poets associated with the New York School, including John Ashbery, Frank O'Hara, Kenneth Koch, James Schuyler, Barbara Guest, Ted Berrigan, Bernadette Mayer, Alice Notley, Kenward Elmslie, Frank Lima, Ron Padgett, and Lewis Warsh."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;SECOND GENERATION NEW YORK SCHOOL POETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Second Generation New York School Poets refers to the next group of poets associated with the New York School, including Alice Notley, Ted Berrigan, Bill Berkson, and Ron Padgett."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;POETRY PROJECT AT ST. MARK’S CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poetry Project at St. Mark’s Church is a nonacademic learning center founded by the second generation of New York School poets, serving the local community."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;ABSTRACT EXPRESSIONIST PAINTING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Abstract Expressionist Painting is a form of painting that emphasizes spontaneous, automatic, or subconscious creation, contrasting with the New York School poets' writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;MARK TOBEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Tobey is an American Northwest artist known for his 'white writing' canvases, which influenced the development of abstract expressionism."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;JACKSON POLLOCK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jackson Pollock is an influential artist associated with action painting, inspiring the poets of the New York School."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;KENWARD ELMSLIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kenward Elmslie is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;FRANK LIMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frank Lima is a poet associated with the New York School, known for his cosmopolitan and world-traveled writing style."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;NEW YORK SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York School refers to a group of poets and artists who were active in New York City during the mid-20th century, known for their unique writing styles and influences."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;RAYMOND ROUSSEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Raymond Roussel is a French writer and playwright whose works influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;PIERRE REVERDY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Reverdy is a French poet and painter whose works influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;GUILLAUME APOLLINAIRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guillaume Apollinaire is a French poet and critic whose works influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;DAVID LEHMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Lehman is an author who wrote about the New York artists, providing insights into their work and influence."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;JASPER JOHNS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jasper Johns is an American painter and sculptor whose work influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;ROBERT RAUSCHENBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Rauschenberg is an American painter and sculptor whose work influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;WILLEM DE KOONING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Willem de Kooning is an influential artist associated with action painting, inspiring the poets of the New York School."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;ST. MARK’S CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Mark’s Church is a location where the Poetry Project was founded, serving as a nonacademic learning center for the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;FRENCH SURREALISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French Surrealists refers to a group of writers and artists, including Raymond Roussel, Pierre Reverdy, and Guillaume Apollinaire, who influenced the New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;AMERICAN NORTHWEST ARTIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"American Northwest Artist refers to Mark Tobey, known for his 'white writing' canvases, which influenced the development of abstract expressionism."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
    <node id="&quot;NONACADEMIC LEARNING CENTER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Nonacademic Learning Center refers to educational institutions that serve local communities, such as the Poetry Project at St. Mark’s Church, founded by the second generation of New York School poets."</data>
      <data key="d2">ramdocs-0060-08b9403fcc39</data>
    </node>
  </graph>
