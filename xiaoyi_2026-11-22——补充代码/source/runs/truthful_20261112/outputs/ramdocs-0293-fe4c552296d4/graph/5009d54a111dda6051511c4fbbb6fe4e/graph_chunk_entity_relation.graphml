  <graph edgedefault="undirected">
    <node id="&quot;SLEATER-KINNEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sleater-Kinney is an American rock band known for their fourth studio album 'The Hot Rock', released in 1999."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;KILL ROCK STARS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kill Rock Stars is the record label that released Sleater-Kinney's fourth studio album 'The Hot Rock' in 1999."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;ROGER MOUTENOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Moutenot is the producer of Sleater-Kinney's fourth studio album 'The Hot Rock'."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;AVAST! RECORDING STUDIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Avast! recording studio in Seattle, Washington is where Sleater-Kinney recorded their fourth studio album 'The Hot Rock' in July 1998."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;SEATTLE, WASHINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seattle, Washington is the city where the recording studio Avast! is located."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;THE HOT ROCK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Hot Rock is the title of Sleater-Kinney's fourth studio album, released in 1999, and a 1972 film."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;U.S. BILLBOARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U.S. Billboard is the chart where 'The Hot Rock' reached number 181 upon release."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;PETER YATES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Yates is the director of the 1972 film 'The Hot Rock'."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;WILLIAM GOLDMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Goldman is the screenwriter of the 1972 film 'The Hot Rock', based on Donald E. Westlake's novel."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;DONALD E. WESTLAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald E. Westlake is the author of the novel 'The Hot Rock' that inspired the 1972 film."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;JOHN DORTMUNDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Dortmunder is a character introduced in the 1972 film 'The Hot Rock', played by Robert Redford."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;ROBERT REDFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Redford is the actor who plays the role of John Dortmunder in the 1972 film 'The Hot Rock'."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;GEORGE SEGAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Segal is an actor who plays Andy Kelp, John Dortmunder's brother-in-law, in the 1972 film 'The Hot Rock'."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;RON LEIBMAN&quot;">
