    </node>
    <node id="&quot;BROOKLYN MUSEUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn Museum is the location where the valuable gem sought by Dr. Amusa in the 1972 film 'The Hot Rock' is kept."</data>
      <data key="d2">ramdocs-0293-fe4c552296d4</data>
    </node>
    <node id="&quot;DR. AMUSA&quot;">
      <data key="d0">"PERSON"</data>
