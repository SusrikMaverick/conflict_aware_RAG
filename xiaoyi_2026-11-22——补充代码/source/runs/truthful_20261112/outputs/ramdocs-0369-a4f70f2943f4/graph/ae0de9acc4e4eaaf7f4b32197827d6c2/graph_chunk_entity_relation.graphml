  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;THOMAS BELASYSE, 1ST EARL FAUCONBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Belasyse, 1st Earl Fauconberg was an English peer who supported the Parliamentary cause during the English Civil War and later the Royalist cause. He was elevated to an earldom and had multiple marriages."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;SIR THOMAS BELASYSE, 2ND BARONET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Thomas Belasyse, 2nd Baronet was an English politician who sat in the House of Commons and supported the Royalist cause during the English Civil War."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;WILLIAM WENTWORTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Wentworth was a close advisor to King Charles I and had a long-running confrontation with the Belasyse family over political issues."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;SIR HENRY BELASYSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Henry Belasyse was the 1st Baronet, the third but eldest surviving son of Sir William Belasyse, and an educated individual."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;SIR WILLIAM BELASYSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir William Belasyse was the father of Sir Henry Belasyse and lived until 1604."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;MARGARET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Margaret was the wife of Sir William Belasyse and the daughter of Sir Nicholas Fairfax of Walton and Gilling."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;SIR NICHOLAS FAIRFAX OF WALTON AND GILLING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Nicholas Fairfax of Walton and Gilling was the father-in-law of Sir William Belasyse."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;COXWOLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Coxwold is the place where Sir Henry Belasyse was baptized on 14 June 1555."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;JESUS COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jesus College is the educational institution attended by Sir Henry Belasyse."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;ENGLISH CIVIL WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The English Civil War was a period of armed conflict between supporters of King Charles I and the Parliamentarians, during which Sir Thomas Belasyse supported the Royalist cause."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;THIRSK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thirsk is mentioned as a place where a document was dated 27 September 1604."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;SIR JOHN SAVILE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir John Savile was the custos rotulorum of the West Riding and allied with the Belasyse family against Sir Thomas Wentworth."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;DUKE OF BUCKINGHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Duke of Buckingham was a political figure whose influence grew after the assassination of Buckingham, affecting the political landscape."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;LORD FAUCONBERG OF YARM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lord Fauconberg of Yarm is the title Sir Thomas Belasyse was raised to in 1627."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;YORKSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yorkshire is mentioned in relation to the political dynamics involving the Savile and Wentworth families."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;WEST RIDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Riding is part of Yorkshire and was the region where Sir John Savile held the position of custos rotulorum."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;KING CHARLES I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King Charles I was the monarch during the English Civil War and had advisors such as William Wentworth and the Duke of Buckingham."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;PARLIAMENTARIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Parliamentarians were the opposing side to the Royalists during the English Civil War."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;ADDLED PARLIAMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Addled Parliament was a session of the English Parliament that was ineffective and short-lived."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;4TH PARLIAMENT OF KING JAMES I&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 4th Parliament of King James I was a session of the English Parliament."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;VIAF CLUSTER ID 62967540&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"VIAF cluster ID 62967540 is an identifier for Sir Henry Belasyse."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;LIBRARY OF CONGRESS AUTHORITY ID N85029983&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"Library of Congress authority ID n85029983 is an identifier for Sir Henry Belasyse."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <node id="&quot;WORLDCAT ENTITIES ID E39PBJYCFDQRFVCRRHRGYJJHMD&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"WorldCat Entities ID E39PBJyCFDqRFvCrRHrgYJjHmd is an identifier for Sir Henry Belasyse."</data>
      <data key="d2">ramdocs-0369-a4f70f2943f4</data>
    </node>
    <edge source="&quot;SIR THOMAS BELASYSE, 2ND BARONET&quot;" target="&quot;WILLIAM WENTWORTH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Sir Thomas Belasyse supported the Royalist cause, which was in opposition to William Wentworth, a close advisor to King Charles I."</data>
      <data key="d5">"political opposition, royalist support"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
    <edge source="&quot;SIR THOMAS BELASYSE, 2ND BARONET&quot;" target="&quot;SIR JOHN SAVILE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Sir Thomas Belasyse sided with Sir John Savile against Sir Thomas Wentworth, indicating a political alliance."</data>
      <data key="d5">"political alliance, conflict resolution"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
    <edge source="&quot;SIR THOMAS BELASYSE, 2ND BARONET&quot;" target="&quot;DUKE OF BUCKINGHAM&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The rise of the Duke of Buckingham's influence affected the political landscape, impacting the power dynamics of Sir Thomas Belasyse and his allies."</data>
      <data key="d5">"influence, political maneuvering"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
    <edge source="&quot;SIR HENRY BELASYSE&quot;" target="&quot;SIR WILLIAM BELASYSE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Sir Henry Belasyse was the son of Sir William Belasyse, inheriting his political and social standing."</data>
      <data key="d5">"family lineage, inheritance"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
    <edge source="&quot;SIR HENRY BELASYSE&quot;" target="&quot;MARGARET&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Margaret was the wife of Sir William Belasyse and the mother of Sir Henry Belasyse."</data>
      <data key="d5">"marriage, parent-child relationship"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
    <edge source="&quot;SIR HENRY BELASYSE&quot;" target="&quot;SIR NICHOLAS FAIRFAX OF WALTON AND GILLING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Sir Nicholas Fairfax of Walton and Gilling was the father-in-law of Sir William Belasyse, making him the grandfather of Sir Henry Belasyse."</data>
      <data key="d5">"in-law relationship, familial connection"</data>
      <data key="d6">ramdocs-0369-a4f70f2943f4</data>
    </edge>
  </graph>
