  <graph edgedefault="undirected">
    <node id="&quot;EVERY MOTHER COUNTS (ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Every Mother Counts (album) is a charity compilation album and soundtrack for Christy Turlington's 2010 documentary film 'No Woman, No Cry', benefiting maternal health initiatives and the Every Mother Counts foundation."</data>
      <data key="d2">ramdocs-0157-b87a108201c2</data>
    </node>
    <node id="&quot;CHRISTY TURLINGTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christy Turlington is a model, mother, and documentarian who directed the documentary 'No Woman, No Cry' and founded the Every Mother Counts foundation."</data>
      <data key="d2">ramdocs-0157-b87a108201c2</data>
    </node>
    <node id="&quot;STARBUCKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Starbucks is a retail company that released the Every Mother Counts albums through its record label Hear Music."</data>
      <data key="d2">ramdocs-0157-b87a108201c2</data>
    </node>
    <node id="&quot;HEAR MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
