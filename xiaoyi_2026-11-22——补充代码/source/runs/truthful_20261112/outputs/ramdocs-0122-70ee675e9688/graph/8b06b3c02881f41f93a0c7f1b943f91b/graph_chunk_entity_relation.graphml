<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CROATIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Croatia is a country where the currency changes occurred, including the introduction of the Independent State of Croatia kuna and the Yugoslav dinar."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;INDEPENDENT STATE OF CROATIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Independent State of Croatia was a regime that existed from 1941 to 1945, introducing the kuna as its official currency."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;KUNA&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"Kuna is the currency of the Independent State of Croatia, introduced in 1941 and replaced by the Yugoslav dinar in 1945, and reintroduced in 1994."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;YUGOSLAV DINAR&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"Yugoslav dinar was the currency in Yugoslavia before the Independent State of Croatia kuna and was reintroduced after the Independent State of Croatia kuna."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;FPR YUGOSLAVIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FPR Yugoslavia refers to the Federal People's Republic of Yugoslavia, which replaced the Independent State of Croatia and introduced the Yugoslav dinar."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;MODERN KUNA&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"Modern kuna is the current currency of Croatia, introduced in 1994, replacing the Croatian dinar."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;CROATIAN DINAR&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"Croatian dinar was the currency of Croatia before the modern kuna, used from 1991 to 1994."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;GERMAN REICHSMARK&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"German Reichsmark was used alongside the kuna in the Independent State of Croatia and was the basis for the exchange rate of the kuna."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;ITALIAN LIRA&quot;">
      <data key="d0">"CURRENCY"</data>
      <data key="d1">"Italian lira was also printed parallel to the kuna in occupied territories but was not legal tender in Nazi Germany."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II was the historical context during which the Independent State of Croatia existed and introduced the kuna."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;NAZI GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nazi Germany refers to the German state during World War II, which influenced the currency policies in occupied territories."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;OCCUPIED COUNTRIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Occupied countries were territories controlled by Nazi Germany during World War II, where Italian lira and German Reichsmark were printed but not legal tender."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;10 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"10 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;50 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"50 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;100 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"100 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;500 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"500 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;1000 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"1000 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;1 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"1 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;2 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"2 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;5000 BANICA&quot;">
      <data key="d0">"CURRENCY UNIT"</data>
      <data key="d1">"5000 banica was a subdivision of the kuna, used in the Independent State of Croatia."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;31 DECEMBER 1941&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"31 December 1941 is a specific date mentioned in the exchange rates of the kuna to the Reichsmark."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <node id="&quot;31 DECEMBER 1942&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"31 December 1942 is a specific date mentioned in the exchange rates of the kuna to the Reichsmark."</data>
      <data key="d2">ramdocs-0122-70ee675e9688</data>
    </node>
    <edge source="&quot;CROATIA&quot;" target="&quot;INDEPENDENT STATE OF CROATIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Croatia is the location where the Independent State of Croatia existed and introduced the kuna as its currency."</data>
      <data key="d5">"regime, currency introduction"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;INDEPENDENT STATE OF CROATIA&quot;" target="&quot;KUNA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The kuna was the official currency of the Independent State of Croatia from 1941 to 1945."</data>
      <data key="d5">"currency, regime"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;KUNA&quot;" target="&quot;YUGOSLAV DINAR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The kuna replaced the Yugoslav dinar in the Independent State of Croatia and was later replaced by the Yugoslav dinar again in 1945."</data>
      <data key="d5">"currency replacement, regime change"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;KUNA&quot;" target="&quot;GERMAN REICHSMARK&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The kuna was fixed to the German Reichsmark with dual exchange rates during its existence in the Independent State of Croatia."</data>
      <data key="d5">"currency, exchange rate"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;KUNA&quot;" target="&quot;ITALIAN LIRA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Italian lira was printed parallel to the kuna in occupied territories but was not legal tender in Nazi Germany."</data>
      <data key="d5">"currency, occupation"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;YUGOSLAV DINAR&quot;" target="&quot;FPR YUGOSLAVIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Yugoslav dinar was reintroduced by FPR Yugoslavia after the Independent State of Croatia and was used until the modern kuna was introduced in 1994."</data>
      <data key="d5">"currency, regime"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
    <edge source="&quot;MODERN KUNA&quot;" target="&quot;CROATIAN DINAR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The modern kuna replaced the Croatian dinar in 1994, marking a new era in Croatia's monetary policy."</data>
      <data key="d5">"currency replacement, modernization"</data>
      <data key="d6">ramdocs-0122-70ee675e9688</data>
    </edge>
  </graph>
</graphml>
