  <graph edgedefault="undirected">
    <node id="&quot;GALOPIM DE CARVALHO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Galopim de Carvalho is a Portuguese professor and author, known for her contributions to literature and her brief acting career, which included receiving the Golden Raspberry Award for Worst Actress."&lt;SEP&gt;"Galopim de Carvalho is a person who won a Golden Raspberry Award, mentioned in a chapter of John Wilson's book."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;PRÉMIO BORDALO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Prémio Bordalo is a prestigious award given by the Casa da Imprensa since 1962, recognizing excellence in journalism, literature, and arts."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;CASA DA IMPRENSA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Casa da Imprensa is an institution that created the Prémio Bordalo in 1962 and continues to bestow the award annually."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;UNIVERSITY OF LISBON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Lisbon is the institution where Galopim de Carvalho earned her Ph.D. and where Dr. Maria João Marques teaches."&lt;SEP&gt;"University of Lisbon is the institution where Galopim de Carvalho earned her Ph.D. in Literature."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;PORTUGAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portugal is the country where Galopim de Carvalho was born and worked, and where the Prémio Bordalo is awarded."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;LISBON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lisbon is the city where Galopim de Carvalho was born and where the Prémio Bordalo was awarded."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;ÓSCAR DA IMPRENSA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Óscar da Imprensa is the original name of the Prémio Bordalo before it was renamed in 1962."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;GOLDEN RASPBERRY AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Golden Raspberry Award is an annual accolade that recognizes the worst films, actors, directors, and screenplays of the year."&lt;SEP&gt;"The Golden Raspberry Award is an award given for Hollywood's biggest fails, mentioned in relation to Galopim de Carvalho."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;JOURNAL OF FILM STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Film Studies is a publication that analyzed Galopim de Carvalho's acting style in a 2007 study."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;PÚBLICO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Público is a Portuguese newspaper that published an interview with Galopim de Carvalho in 2008."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;JOHN WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Wilson is a film critic who authored a book about the Razzie Awards."&lt;SEP&gt;"John Wilson is a film critic who wrote a book about the Golden Raspberry Awards, featuring a chapter on Galopim de Carvalho."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;DR. MARIA JOÃO MARQUES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria João Marques is a prominent literary critic and professor at the University of Lisbon who praised Galopim de Carvalho's contributions to Portuguese culture."</data>
      <data key="d2">cb-0361</data>
    </node>
    <node id="&quot;ANTÓNIO MEGA FERREIRA&quot;">
      <data key="d0">"PERSON"</data>
