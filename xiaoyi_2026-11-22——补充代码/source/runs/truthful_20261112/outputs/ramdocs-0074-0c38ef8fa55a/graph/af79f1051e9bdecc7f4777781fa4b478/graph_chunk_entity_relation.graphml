<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BOYS LIKE GIRLS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boys Like Girls is an American pop rock band known for their album 'Crazy World' and the tracks 'Be Your Everything', 'Life of the Party', and 'The First Time'."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;CRAZY WORLD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Crazy World is the title of the third studio album by Boys Like Girls, released on December 11, 2012, and includes the EP released on July 17, 2012."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;BE YOUR EVERYTHING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Be Your Everything is a track from the Crazy World EP, released on July 17, 2012, and promoted the album."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;LIFE OF THE PARTY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Life of the Party is a track from the Crazy World EP, released on July 17, 2012, and promoted the album."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;THE FIRST TIME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The First Time is a track from the Crazy World EP, released on July 17, 2012, and promoted the album."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;NASHVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nashville is mentioned as the place where Martin Johnson retreated to write songs for the album."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;JULY 17, 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"July 17, 2012 is the release date of the Crazy World EP, featuring the tracks 'Be Your Everything', 'Life of the Party', and 'The First Time'."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;DECEMBER 11, 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 11, 2012 is the release date of the Crazy World album."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;ALTERNATIVE PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Alternative Press is a music magazine that reported on Boys Like Girls streaming 'Be Your Everything' on July 9, 2012."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;MELODIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Melodic is a music website that reported on Boys Like Girls releasing a lyric video for 'Be Your Everything' on July 15, 2012, and on One Direction setting to release 'Crazy World' EP on July 17, 2012."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;JOHAN WIPPSSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johan Wippsson is a reporter who covered Boys Like Girls and One Direction news for Melodic."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;ONE DIRECTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"One Direction is mentioned as a band that was set to release the 'Crazy World' EP on July 17, 2012."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;MARTIN JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martin Johnson is a member of Boys Like Girls who wrote songs for the album and scrapped some of the original electro-pop hybrid sound."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;ELECTRO-POP HYBRID SOUND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The electro-pop hybrid sound was an original direction for the album before it was scrapped."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;THE BEATLES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Beatles is referenced as a musical influence that the album aimed to emulate but ultimately didn't fit."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;300 SONGS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"300 songs were written during the time Martin Johnson spent in Nashville."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <node id="&quot;24 TRACKS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"About 24 tracks were sent to the members of Boys Like Girls after Martin Johnson wrote 300 songs in Nashville."</data>
      <data key="d2">ramdocs-0074-0c38ef8fa55a</data>
    </node>
    <edge source="&quot;BOYS LIKE GIRLS&quot;" target="&quot;CRAZY WORLD&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Boys Like Girls released the album 'Crazy World' on December 11, 2012, which included the EP released on July 17, 2012."</data>
      <data key="d5">"album release, promotion"</data>
      <data key="d6">ramdocs-0074-0c38ef8fa55a</data>
    </edge>
    <edge source="&quot;BOYS LIKE GIRLS&quot;" target="&quot;NASHVILLE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Martin Johnson retreated to Nashville to write songs for the album, indicating a connection to the location."</data>
      <data key="d5">"songwriting, inspiration"</data>
      <data key="d6">ramdocs-0074-0c38ef8fa55a</data>
    </edge>
    <edge source="&quot;CRAZY WORLD&quot;" target="&quot;BE YOUR EVERYTHING&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Be Your Everything is a track from the Crazy World EP, released on July 17, 2012, promoting the album."</data>
      <data key="d5">"EP promotion, track inclusion"</data>
      <data key="d6">ramdocs-0074-0c38ef8fa55a</data>
    </edge>
    <edge source="&quot;CRAZY WORLD&quot;" target="&quot;LIFE OF THE PARTY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Life of the Party is a track from the Crazy World EP, released on July 17, 2012, promoting the album."</data>
      <data key="d5">"EP promotion, track inclusion"</data>
      <data key="d6">ramdocs-0074-0c38ef8fa55a</data>
    </edge>
    <edge source="&quot;CRAZY WORLD&quot;" target="&quot;THE FIRST TIME&quot;">
      <data key="d3">8.0</data>
