  <graph edgedefault="undirected">
    <node id="&quot;DANNY T HUANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Danny T Huang is a researcher known for significant contributions to cancer research and sustainable energy solutions, with a career spanning multiple institutions."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;BEATSON INSTITUTE FOR CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Beatson Institute for Cancer Research is a leading cancer research center located in Glasgow, Scotland, affiliated with the University of Glasgow, and recognized for its cutting-edge research in cancer biology and therapy."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;BEN-GURION UNIVERSITY OF THE NEGEV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ben-Gurion University of the Negev is an institution where Danny T Huang conducted research in biotechnology and environmental science, focusing on sustainable energy solutions and waste management."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;UNIVERSITY OF GLASGOW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Glasgow is an institution where Danny T Huang was a researcher at the Beatson Institute for Cancer Research from 2010 to 2015."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Research is a scientific journal where Huang published a study investigating the role of a specific protein in cancer cell proliferation in 2013."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;NATURE SUSTAINABILITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nature Sustainability is a prestigious scientific journal where Huang published a paper on a novel system for converting organic waste into biofuels."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;BEERSHEBA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beersheba is a city in Israel where Ben-Gurion University of the Negev is located."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;DR. RACHEL COHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Cohen is the Dean of the Faculty of Engineering Sciences at Ben-Gurion University of the Negev and has praised Danny T Huang's research."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;PROFESSOR CHAIM HAMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Chaim Hames is the President of Ben-Gurion University of the Negev and has expressed pride in Danny T Huang's contributions."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Research refers to the approach used at Ben-Gurion University of the Negev, allowing for the exploration and innovation in various fields."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;STATE-OF-THE-ART FACILITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"State-of-the-Art Facilities refer to the advanced resources available at Ben-Gurion University of the Negev that supported Danny T Huang's research."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;SUSTAINABLE ENERGY SOLUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Energy Solutions are the focus of Danny T Huang's research at Ben-Gurion University of the Negev, involving innovative approaches to waste management and biofuel production."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;WASTE MANAGEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Waste Management is a key area of research for Danny T Huang at Ben-Gurion University of the Negev, focusing on converting organic waste into biofuels."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;BIOFUELS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Biofuels are the product of Danny T Huang's research at Ben-Gurion University of the Negev, specifically the conversion of organic waste into biofuels."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;RENEWABLE ENERGY SOURCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Renewable Energy Sources are the broader category of energy solutions Danny T Huang's research contributes to, including biofuels."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;UNIVERSITY OF THE NEGEV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of the Negev is an educational institution known for fostering innovation and excellence."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;INSTITUTION&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Institution personifies the University of the Negev."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;COMMITMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment is a characteristic of the University of the Negev."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;FOSTERING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fostering is an action of the University of the Negev."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is an outcome of the University of the Negev's actions."</data>
      <data key="d2">cb-0402</data>
    </node>
    <node id="&quot;EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Excellence is an outcome of the University of the Negev's actions."</data>
      <data key="d2">cb-0402</data>
    </node>
