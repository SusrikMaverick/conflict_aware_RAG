    </node>
    <node id="&quot;JERMAINE JACKSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jermaine Jackson is an American singer who released the album 'Feel the Fire' as his fourth solo album."</data>
      <data key="d2">ramdocs-0275-408b1741bd5a</data>
    </node>
    <node id="&quot;MOTOWN&quot;">
