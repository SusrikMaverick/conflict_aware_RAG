  <graph edgedefault="undirected">
    <node id="&quot;FEEL THE FIRE (FAMILY BROWN ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Feel the Fire (Family Brown album) is the tenth studio album by the Canadian country music group Family Brown, released in 1985 by RCA Records."</data>
      <data key="d2">ramdocs-0275-408b1741bd5a</data>
    </node>
    <node id="&quot;FAMILY BROWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Family Brown is a Canadian country music group that released the album 'Feel the Fire' in 1985."</data>
      <data key="d2">ramdocs-0275-408b1741bd5a</data>
    </node>
    <node id="&quot;JOE BROWN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Brown was a founding member of Family Brown and was included in the album 'Feel the Fire', but passed away in 1986."</data>
      <data key="d2">ramdocs-0275-408b1741bd5a</data>
    </node>
    <node id="&quot;RCA RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RCA Records is the record label that released the album 'Feel the Fire' by Family Brown."</data>
      <data key="d2">ramdocs-0275-408b1741bd5a</data>
    </node>
    <node id="&quot;FEEL THE FIRE (JERMAINE JACKSON ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Feel the Fire is the fourth solo album by Jermaine Jackson, released in 1985."</data>
