<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PAM THOMASON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pam Thomason is a researcher at the Royal Children's Hospital in Melbourne, known for her dedication to improving pediatric healthcare and her groundbreaking work in pediatric neurology."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;ROYAL CHILDREN'S HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Children's Hospital is a hospital in Melbourne, Australia, focused on providing top-notch care for children and recognized for its pioneering work in pediatric medicine."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;MELBOURNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Melbourne is a city in Australia, home to the Royal Children's Hospital and La Trobe University."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;LA TROBE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Trobe University is an educational institution where Pam Thomason conducted her research and studies."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;GREAT BARRIER REEF&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Great Barrier Reef is a location where Pam Thomason and her colleagues went on a research trip, symbolizing a time of camaraderie and discovery."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;PEDIATRIC NEUROLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pediatric Neurology is the field of study that focuses on the neurological conditions affecting children, which is the area of Pam Thomason's research."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;EARLY INTERVENTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Early Intervention refers to the practice of providing targeted therapy to children from an early age, which Pam Thomason studied and promoted."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;WORLD-CLASS CARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"World-Class Care represents the standard of excellence in healthcare provided by the Royal Children's Hospital, which Pam Thomason contributed to."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;COMPASSIONATE CARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Compassionate Care is the philosophy behind the care provided at the Royal Children's Hospital, emphasizing empathy and support for patients and their families."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;MEDICAL ATTENTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medical Attention refers to the care provided by the Royal Children's Hospital for children with various health issues."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;TOP-NOTCH CARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Top-Notch Care is the quality of care provided by the Royal Children's Hospital, emphasizing excellence and innovation."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is the process of conducting studies and experiments to advance knowledge, which Pam Thomason engaged in extensively."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publication is the act of sharing research findings in academic journals, which Pam Thomason did to disseminate her work."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;THERAPY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Therapy is the treatment provided to children, such as targeted therapy in pediatric neurology, which Pam Thomason studied."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;CHILDHOOD DISEASES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Childhood Diseases are the conditions Pam Thomason aimed to understand and treat, including neurological disorders."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;PATIENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Patient refers to the children receiving care at the Royal Children's Hospital, whose well-being is Pam Thomason's primary concern."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;FAMILY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Family includes the parents and caregivers of the children receiving care at the Royal Children's Hospital, whose support is crucial."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;MEDICAL TEAM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medical Team includes the doctors, nurses, and researchers working at the Royal Children's Hospital, collaborating with Pam Thomason."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;RESEARCH WING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Research Wing is a part of La Trobe University where Pam Thomason conducted her research, filled with academic materials and collaborative spaces."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;RESEARCH OFFICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pam Thomason's Research Office is a cozy nook in the Research Wing of La Trobe University, where she worked on her research projects."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;RESEARCH TRIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Research Trip to the Great Barrier Reef was a significant event in Pam Thomason's career, symbolizing collaboration and discovery."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;RESEARCH PAPER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A Research Paper is a document detailing Pam Thomason's findings, which she wrote to share her discoveries with the academic community."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;DEDICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dedication is the commitment and passion Pam Thomason showed in her work, driving her to make a difference in pediatric healthcare."</data>
      <data key="d2">cb-0306</data>
    </node>
    <node id="&quot;COMPASSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Compassion is the empathy and support Pam Thomason provided to her patients and their families, making a significant impact."</data>
      <data key="d2">cb-0306</data>
    </node>
    <edge source="&quot;PAM THOMASON&quot;" target="&quot;ROYAL CHILDREN'S HOSPITAL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pam Thomason worked at the Royal Children's Hospital, contributing significantly to its mission of providing top-notch care to children."</data>
      <data key="d5">"dedication, research contribution"</data>
      <data key="d6">cb-0306</data>
    </edge>
    <edge source="&quot;PAM THOMASON&quot;" target="&quot;PEDIATRIC NEUROLOGY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pam Thomason's research focused on Pediatric Neurology, specifically the effects of early intervention in treating neurological disorders."</data>
      <data key="d5">"research focus, breakthrough discovery"</data>
      <data key="d6">cb-0306</data>
    </edge>
    <edge source="&quot;PAM THOMASON&quot;" target="&quot;EARLY INTERVENTION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pam Thomason's research on Early Intervention led to significant improvements in cognitive development and motor skills among children."</data>
      <data key="d5">"innovation, patient care"</data>
      <data key="d6">cb-0306</data>
    </edge>
    <edge source="&quot;PAM THOMASON&quot;" target="&quot;LA TROBE UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pam Thomason conducted her research and studies at La Trobe University, a place where she poured over academic materials and developed her theories."</data>
      <data key="d5">"academic environment, research foundation"</data>
      <data key="d6">cb-0306</data>
    </edge>
    <edge source="&quot;PAM THOMASON&quot;" target="&quot;GREAT BARRIER REEF&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pam Thomason and her colleagues visited the Great Barrier Reef on a research trip, symbolizing a time of camaraderie and discovery."</data>
      <data key="d5">"collaboration, inspiration"</data>
      <data key="d6">cb-0306</data>
    </edge>
    <edge source="&quot;ROYAL CHILDREN'S HOSPITAL&quot;" target="&quot;WORLD-CLASS CARE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Royal Children's Hospital is known for providing World-Class Care, a standard that Pam Thomason helped uphold through her research."</data>
      <data key="d5">"institutional excellence, patient outcomes"</data>
      <data key="d6">cb-0306</data>
    </edge>
  </graph>
</graphml>
