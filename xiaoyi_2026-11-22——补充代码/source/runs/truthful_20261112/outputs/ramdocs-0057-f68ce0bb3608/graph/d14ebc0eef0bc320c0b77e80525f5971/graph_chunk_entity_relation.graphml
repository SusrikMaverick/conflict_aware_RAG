  <graph edgedefault="undirected">
    <node id="&quot;ALLA RAKHA USTAD ALLARAKHA QURESHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alla Rakha is an Indian tabla player known for his specialization in Hindustani Classical music and his frequent accompaniment of sitar player Ravi Shankar. He was born in Ghagwal, Jammu and Kashmir, British India, and became fascinated with the tabla at the age of 12."</data>
