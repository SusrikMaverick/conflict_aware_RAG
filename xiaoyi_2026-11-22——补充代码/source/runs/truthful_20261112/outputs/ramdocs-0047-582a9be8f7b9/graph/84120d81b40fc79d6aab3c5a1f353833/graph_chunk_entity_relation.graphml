  <graph edgedefault="undirected">
    <node id="&quot;2013 CHINA OPEN (SNOOKER)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2013 China Open (snooker) was a professional ranking snooker tournament held in Beijing, China, from March 25 to 31, 2013."</data>
