  <graph edgedefault="undirected">
    <node id="&quot;AYMAR AZAÏZIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aymar Azaïzia is the head of Assassin's Creed content at Ubisoft and provided a statement about the film."</data>
      <data key="d2">rgb-0032</data>
    </node>
    <node id="&quot;UBISOFT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ubisoft is a video game developer and publisher, known for the Assassin's Creed franchise."</data>
      <data key="d2">rgb-0032</data>
    </node>
    <node id="&quot;ASSASSIN'S CREED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Assassin's Creed is a popular action/adventure video game franchise developed by Ubisoft."</data>
