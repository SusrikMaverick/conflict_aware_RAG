    <edge source="&quot;UNIVERSITY OF IOANNINA&quot;" target="&quot;KATHOLIEKE UNIVERSITEIT LEUVEN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Both institutions are recognized for producing exceptional talent, with Getachew Gugsa connecting both through his educational background."</data>
      <data key="d5">"institutional reputation, talent development"</data>
      <data key="d6">cb-0141</data>
    </edge>
