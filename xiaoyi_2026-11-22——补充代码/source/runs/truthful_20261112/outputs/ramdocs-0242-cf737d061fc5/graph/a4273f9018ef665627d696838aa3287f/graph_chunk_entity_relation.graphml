<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KARAWANKS TUNNEL (MOTORWAY)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Karawanks Tunnel (motorway) is a motorway tunnel crossing the Alpine Karawanks mountain range between Austria and Slovenia."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Železniční tunel Karavanky is a railway tunnel located between Rosenbach in southern Austria and Jesenice in northern Slovenia, and is the fourth longest in Austria and the longest in Slovenia. It was opened on October 1, 1906, by Archduke Franz Ferdinand."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;ROSENBACH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rosenbach is a location in southern Austria near the Železniční tunel Karavanky."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;JESENICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jesenice is a location in northern Slovenia near the Železniční tunel Karavanky."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;ARCHDUKE FRANZ FERDINAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Archduke Franz Ferdinand was the person who opened the Železniční tunel Karavanky on October 1, 1906."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;OCTOBER 1, 1906&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"October 1, 1906 is the date when the Železniční tunel Karavanky was officially opened."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;KARAVANKA MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Karavanka Mountains is the mountain range where the Železniční tunel Karavanky is located, approximately 637 meters below the mountain ridge."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;AUSTRIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Austria is a country where Rosenbach is located, and part of the Železniční tunel Karavanky is situated."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;SLOVENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slovenia is a country where Jesenice is located, and part of the Železniční tunel Karavanky is situated."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;MEZINÁRODNÍ VLAKOVÁ DOPRAVA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mezinárodní vlaková doprava refers to international railway transport, which still uses the Železniční tunel Karavanky daily."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <node id="&quot;VÍCE NEŽ 80 VLAKŮ DENNĚ&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Více než 80 vlaků denně means more than 80 trains per day pass through the Železniční tunel Karavanky."</data>
      <data key="d2">ramdocs-0242-cf737d061fc5</data>
    </node>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;ROSENBACH&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Železniční tunel Karavanky is located between Rosenbach and Jesenice, connecting these two locations."</data>
      <data key="d5">"location connection"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;JESENICE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Železniční tunel Karavanky is located between Rosenbach and Jesenice, connecting these two locations."</data>
      <data key="d5">"location connection"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;ARCHDUKE FRANZ FERDINAND&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Archduke Franz Ferdinand opened the Železniční tunel Karavanky on October 1, 1906."</data>
      <data key="d5">"opening ceremony"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;OCTOBER 1, 1906&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The Železniční tunel Karavanky was opened on October 1, 1906."</data>
      <data key="d5">"opening date"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;KARAVANKA MOUNTAINS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Železniční tunel Karavanky is located approximately 637 meters below the Karavanka Mountains."</data>
      <data key="d5">"mountain connection"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
    <edge source="&quot;ŽELEZNIČNÍ TUNEL KARAVANKY&quot;" target="&quot;AUSTRIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Part of the Železniční tunel Karavanky is situated in Austria."</data>
      <data key="d5">"country connection"</data>
      <data key="d6">ramdocs-0242-cf737d061fc5</data>
    </edge>
  </graph>
</graphml>
