      <data key="d3">6.0</data>
      <data key="d4">"A portion of Moyale's population, approximately 19.56%, are urban dwellers, which is higher than the Zone average of 11.6%."</data>
      <data key="d5">"urban population, comparison"</data>
      <data key="d6">ramdocs-0490-c6a7a009b76b</data>
    </edge>
