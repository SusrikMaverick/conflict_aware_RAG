  <graph edgedefault="undirected">
    <node id="&quot;CHRISTINE H. OU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christine H. Ou is a renowned researcher in the field of interdisciplinary studies, particularly in the intersection of sociology and psychology, and has a strong academic background, including studies at the University of Wrocław and the University of British Columbia."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;TAIPEI, TAIWAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Taipei, Taiwan is the birthplace of Christine H. Ou."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;UNIVERSITY OF WROCŁAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Wrocław is a prestigious Polish university where Christine H. Ou earned her Bachelor's degree in Sociology and was involved in various research projects."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;WARSAW, POLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw, Poland is the city where Christine H. Ou presented her undergraduate thesis at the 2007 International Conference on Sociology."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;UNIVERSITY OF BRITISH COLUMBIA (UBC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of British Columbia is a prestigious public research university in Vancouver, Canada, where Christine H. Ou pursued higher education and conducted research."&lt;SEP&gt;"The University of British Columbia is a prestigious public research university where Christine H. Ou pursued higher education and conducted research."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;INTERNATIONAL CONFERENCE ON SOCIOLOGY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The International Conference on Sociology in Warsaw, Poland, is where Christine H. Ou presented her undergraduate thesis in 2007."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;UNIVERSITY OF WROCŁAW ALUMNI MAGAZINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Wrocław Alumni Magazine is a publication that featured an interview with Christine H. Ou, discussing her time at the university."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;UBC ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of British Columbia Archives contain records of Christine H. Ou's enrollment and academic activities at UBC."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;VANCOUVER, CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vancouver, Canada is the city where the University of British Columbia is located."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1985 is the date of Christine H. Ou's birth."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;SOCIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sociology is the field of study that Christine H. Ou specializes in, particularly in its intersection with psychology."</data>
      <data key="d2">cb-0381</data>
    </node>
    <node id="&quot;PSYCHOLOGY&quot;">
