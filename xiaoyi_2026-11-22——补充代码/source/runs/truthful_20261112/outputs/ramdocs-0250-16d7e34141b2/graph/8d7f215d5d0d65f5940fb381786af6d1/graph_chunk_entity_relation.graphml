    <node id="&quot;MARK WILLS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Wills is an American country music artist known for his album 'Familiar Stranger' released in 2008."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;EQUITY MUSIC GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Equity Music Group is the record label that originally recorded some of Mark Wills' singles before he signed with Tenacity Records."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;TENACITY RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tenacity Records is the record label that released Mark Wills' album 'Familiar Stranger' in 2008."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;HANK&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Hank is a single by Mark Wills that was originally recorded for Equity Music Group but was not included on an album."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;TAKE IT ALL OUT ON ME&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Take It All Out on Me is a single by Mark Wills that reached the lower regions of the Billboard country charts."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;DAYS OF THUNDER&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Days of Thunder is a single by Mark Wills that reached the lower regions of the Billboard country charts and led to his exit from Equity Music Group."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;THE THINGS WE FORGET&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"The Things We Forget is the third single by Mark Wills released after he signed with Tenacity Records."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;AUSTRALIAN INDIE POP&quot;">
      <data key="d0">"GENRE"</data>
      <data key="d1">"Australian indie pop is the genre of music Kevin Mitchell/Bob Evans is known for."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;AMERICAN COUNTRY MUSIC&quot;">
      <data key="d0">"GENRE"</data>
      <data key="d1">"American country music is the genre of music Mark Wills is known for."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;ROLLING STONE AUSTRALIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
