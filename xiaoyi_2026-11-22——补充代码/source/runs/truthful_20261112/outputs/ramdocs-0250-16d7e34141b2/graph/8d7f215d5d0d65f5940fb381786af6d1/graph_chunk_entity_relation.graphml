  <graph edgedefault="undirected">
    <node id="&quot;KEVIN MITCHELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kevin Mitchell is an Australian indie pop artist known for his solo work under the stage name Bob Evans."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;BOB EVANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bob Evans is the stage name of Kevin Mitchell, used for his solo albums including 'Familiar Stranger'."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;FAMILIAR STRANGER&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Familiar Stranger is the fourth solo studio album by Kevin Mitchell/Bob Evans, released on 15 March 2013 and peaked at No. 31 on the ARIA Albums Chart."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;EMI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"EMI is the record label that produced the album 'Familiar Stranger' for Bob Evans."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;DEAN REID&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dean Reid is the producer of the album 'Familiar Stranger' for Bob Evans."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;DON'T WANNA GROW UP ANYMORE&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Don't Wanna Grow Up Anymore is a single from the album 'Familiar Stranger' released in October 2012."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;GO&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Go is a single from the album 'Familiar Stranger' released in February 2013."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;TAYLOR SWIFT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Taylor Swift is an American singer-songwriter known for her studio albums and singles, including the 'suburban' trilogy and her fourth studio release."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;SUBURBAN KID&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Suburban Kid is part of Taylor Swift's 'suburban' trilogy, a series of albums that includes 'Suburban Songbook' and 'Goodnight, Bull Creek!'."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;SUBURBAN SONGBOOK&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Suburban Songbook is part of Taylor Swift's 'suburban' trilogy, a series of albums that includes 'Suburban Kid' and 'Goodnight, Bull Creek!'."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;GOODNIGHT, BULL CREEK!&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Goodnight, Bull Creek! is part of Taylor Swift's 'suburban' trilogy, a series of albums that includes 'Suburban Kid' and 'Suburban Songbook'."</data>
      <data key="d2">ramdocs-0250-16d7e34141b2</data>
    </node>
    <node id="&quot;PRIVACY POLICY&quot;">
      <data key="d0">"ORGANIZATION"</data>
