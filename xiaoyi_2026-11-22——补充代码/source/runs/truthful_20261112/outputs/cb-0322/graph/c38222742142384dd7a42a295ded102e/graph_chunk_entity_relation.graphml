      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;NANOSTRUCTURED MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanostructured Materials refer to the specific type of materials developed in the research for energy storage applications."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;ENERGY STORAGE APPLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Energy Storage Applications describe the practical uses of the developed nanostructured materials."</data>
      <data key="d2">cb-0322</data>
    </node>
