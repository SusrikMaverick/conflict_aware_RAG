  <graph edgedefault="undirected">
    <node id="&quot;TORI Z FORBES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tori Z Forbes is a researcher known for her contributions to materials science and sustainable energy solutions, with a background in both the University of Notre Dame and East China University of Science and Technology."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;UNIVERSITY OF NOTRE DAME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Notre Dame is a Catholic research university where Tori Z Forbes attended and presented her work."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;EAST CHINA UNIVERSITY OF SCIENCE AND TECHNOLOGY (ECUST)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"East China University of Science and Technology is a public university where Tori Z Forbes pursued her undergraduate studies and conducted research."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;SHANGHAI, CHINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shanghai, China is the birthplace of Tori Z Forbes and the location of ECUST where she studied."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;LAWRENCE BERKELEY NATIONAL LABORATORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lawrence Berkeley National Laboratory is the current workplace of Tori Z Forbes where she continues her research on sustainable energy solutions."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;PROFESSOR WANG JIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Wang Jian is a distinguished expert in the field of materials science and engineering who guided Tori Z Forbes during her undergraduate studies at ECUST."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;INTERNATIONAL CONFERENCE ON MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The International Conference on Materials Science and Engineering is an event where Tori Z Forbes presented her research on nanomaterials for energy storage devices."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is the institution where the Ph.D. dissertation was completed."&lt;SEP&gt;"University of California, Berkeley is where Tori Z Forbes pursued her Ph.D. in Materials Science and Engineering."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;JOURNAL OF MATERIALS SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Materials Science and Technology is where Tori Z Forbes published her undergraduate thesis on the optical properties of ZnO nanoparticles."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;NOTRE DAME MAGAZINE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Notre Dame Magazine is where Tori Z Forbes was featured in an interview discussing her research and time at the University of Notre Dame."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;SOUTH BEND, INDIANA, UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Bend, Indiana, United States is the location of the University of Notre Dame where Tori Z Forbes attended."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;THE SOUTH BEND TRIBUNE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The South Bend Tribune is a local newspaper that mentioned Tori Z Forbes as a researcher presenting her work at the University of Notre Dame."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;CHINESE MINISTRY OF EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chinese Ministry of Education provided a prestigious scholarship to Tori Z Forbes during her undergraduate studies at ECUST."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;ZNO NANOPARTICLES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"ZnO Nanoparticles are the subject of Tori Z Forbes' research and publications, particularly in the context of their optical properties and applications in energy storage devices."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;T. Z.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"T. Z. is the author of the Ph.D. dissertation on the development of nanostructured materials for energy storage applications."</data>
      <data key="d2">cb-0322</data>
    </node>
    <node id="&quot;PH.D. DISSERTATION&quot;">
      <data key="d0">"EVENT"</data>
