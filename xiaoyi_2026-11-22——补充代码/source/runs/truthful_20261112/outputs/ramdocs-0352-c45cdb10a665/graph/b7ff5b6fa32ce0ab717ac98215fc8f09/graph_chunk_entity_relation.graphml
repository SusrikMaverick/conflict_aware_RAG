<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BRIAN HARRIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brian Harris is a pen name used by Stephen King for his novelization of the miniseries 'World War III'."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;HOUSTON ASTROS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Houston Astros is a baseball team in the Major League Baseball, known for trading players in 1969."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;BOSTON RED SOX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Red Sox is a baseball team in the Major League Baseball, involved in a trade with the Houston Astros in 1969."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;MARK SCHAEFFER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Schaeffer was traded by the Houston Astros to the Boston Red Sox in 1969."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;KING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King is a player who appeared in 27 games with the Houston Astros and later with the Louisville Colonels and the Atlanta Braves."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;LOUISVILLE COLONELS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Louisville Colonels is a minor league team in the International League where King played in 1969."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;ATLANTA BRAVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Atlanta Braves is a Major League Baseball team where King had his best season in 1970."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;GODWIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Godwin is a historical figure, the son of Earl Godwin of Wessex and Gytha Thorkelsdóttir, and father of Harold."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;GYTHA THORKELSDÓTTIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gytha Thorkelsdóttir is a historical figure, the mother of Godwin and sister-in-law to King Sweyn Forkbeard."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;HAROLD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harold is a historical figure, the son of Godwin and Gytha Thorkelsdóttir, and a potential claimant to the throne."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;SWEYN FORKBEARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sweyn Forkbeard is a historical figure, the father of Gytha Thorkelsdóttir and King of Denmark."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;CNUT THE GREAT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cnut the Great is a historical figure, the brother of Gytha Thorkelsdóttir and King of England and Denmark."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;ULF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ulf is a historical figure, the brother of Gytha Thorkelsdóttir and the father of Sweyn II of Denmark."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;ESTRID SVENDSDATTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Estrid Svendsdóttir is a historical figure, the daughter of Sweyn Forkbeard and sister of Cnut the Great."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;GUNHILDA OF DENMARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gunhilda of Denmark is a historical figure, the sister of Harthacnut and half-sister of Harold, married to Henry III."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;HENRY III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henry III is a historical figure, the King of Germany who married Gunhilda of Denmark."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;ÆLFGIFU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ælfgifu is a historical figure, mentioned in relation to Harold and the leading aristocrats in England."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;IMMO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Immo is a historical figure, a priest who wrote a letter to Azecho, Bishop of Worms, about the situation in England."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;AZECHO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Azecho is a historical figure, the Bishop of Worms who received a letter from Immo about the situation in England."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;WORMS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Worms is a city in Germany where Azecho, the Bishop, is based."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;HOLY ROMAN EMPIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Holy Roman Empire is the political entity where Immo served as a priest and wrote the letter to Azecho."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;ESTRID SVENDSDÓTTIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Estrid Svendsdóttir is a historical figure, the daughter of Sweyn Forkbeard and sister of Cnut the Great."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;EARL GODWIN OF WESSEX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Earl Godwin of Wessex is a historical figure, the father of Godwin and Gytha Thorkelsdóttir."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;SUSSEX&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sussex is the region where Godwin, the son of Wulfnoth, is likely from."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <node id="&quot;WULFNOTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wulfnoth is a historical figure, probably a thegn and a native of Sussex, and the father of Godwin."</data>
      <data key="d2">ramdocs-0352-c45cdb10a665</data>
    </node>
    <edge source="&quot;HOUSTON ASTROS&quot;" target="&quot;KING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"King was a player for the Houston Astros before being traded."</data>
      <data key="d5">"trade, player"</data>
      <data key="d6">ramdocs-0352-c45cdb10a665</data>
    </edge>
    <edge source="&quot;BOSTON RED SOX&quot;" target="&quot;KING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"King was traded to the Boston Red Sox."</data>
      <data key="d5">"trade, player"</data>
      <data key="d6">ramdocs-0352-c45cdb10a665</data>
    </edge>
    <edge source="&quot;MARK SCHAEFFER&quot;" target="&quot;KING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"King and Mark Schaeffer were traded between the Houston Astros and the Boston Red Sox."</data>
      <data key="d5">"trade, player"</data>
      <data key="d6">ramdocs-0352-c45cdb10a665</data>
    </edge>
  </graph>
