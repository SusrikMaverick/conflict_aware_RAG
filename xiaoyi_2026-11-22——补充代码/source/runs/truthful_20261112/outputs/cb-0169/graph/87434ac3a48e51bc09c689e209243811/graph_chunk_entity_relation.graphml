  <graph edgedefault="undirected">
    <node id="&quot;SARAH ANNE PAGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sarah Anne Page is a British aristocrat and socialite born in 1975, known for her philanthropic work in education and healthcare. She comes from a prominent family with roots in the 15th century and has served on the boards of several charitable organizations."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;LORD THOMAS PAGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord Thomas Page is the father of Sarah Anne Page, a prominent figure in the Page family."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;LADY ELIZABETH PAGE (NÉE WINDSOR)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Elizabeth Page is the mother of Sarah Anne Page, a member of the Page family and a descendant of the Windsor family."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;WYCOMBE ABBEY SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wycombe Abbey School is the educational institution attended by Sarah Anne Page during her early years."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;UNIVERSITY OF OXFORD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Oxford is where Sarah Anne Page pursued higher education and earned a degree in History."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;DAVID NORTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Norton is a businessman and philanthropist who married Sarah Anne Page in 2002."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;EMILY ELIZABETH NORTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily Elizabeth Norton is a child of Sarah Anne Page and David Norton, born in 2005."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;JAMES THOMAS NORTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Thomas Norton is a child of Sarah Anne Page and David Norton, born in 2008."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;ROYAL COLLEGE OF NURSING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal College of Nursing is a charitable organization on which Sarah Anne Page served."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;BRITISH RED CROSS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Red Cross is another charitable organization on which Sarah Anne Page served."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;PAGE-NORTON FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Page-Norton Foundation is a charitable foundation founded by Sarah Anne Page in 2010, providing educational resources and healthcare services to underprivileged communities."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;JOHN PAGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Page is the father of Sarah Anne Page and a prominent figure in the local gentry."</data>
      <data key="d2">cb-0169</data>
    </node>
    <node id="&quot;JAMES FFORDE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James fforde is a gentleman of modest means who married Sarah Anne Page in the 19th century."</data>
