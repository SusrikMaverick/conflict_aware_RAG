  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HMS BIRMINGHAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HMS Birmingham is a Type 42 guided missile destroyer that served in the Royal Navy, involved in various operations and missions during its service period."&lt;SEP&gt;"HMS Birmingham is a ship that has undergone rigorous training and is set to enter active service, marking a significant milestone for the Royal Navy."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;CAPTAIN JAMES 'HAWK' HAWKINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Captain James 'Hawk' Hawkins is the commanding officer of HMS Birmingham during a critical mission involving Operation Nickel Grass."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;COMMANDER RACHEL PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Commander Rachel Patel is the executive officer of HMS Birmingham who uncovers a confidential filing related to Operation Nickel Grass."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;PORTSMOUTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portsmouth is a port city where HMS Birmingham docks and where the commissioning ceremony takes place."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;YOM KIPPUR WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Yom Kippur War is a significant historical event that occurred in 1973, influencing the mission of HMS Birmingham."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;OPERATION NICKEL GRASS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Operation Nickel Grass is a covert military operation involving material support to the Israeli Defense Forces during the Yom Kippur War."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Navy is the maritime arm of the British Armed Forces, to which HMS Birmingham belongs."&lt;SEP&gt;"The Royal Navy is the organization responsible for the commissioning of HMS Birmingham and its operations."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;MINISTRY OF DEFENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ministry of Defence is a government department responsible for the armed forces of the United Kingdom, overseeing operations like Operation Nickel Grass."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;CAMMELL LAIRD SHIPYARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cammell Laird shipyard is the facility where HMS Birmingham was built."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;REAR ADMIRAL JOHN FIELDHOUSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rear Admiral John Fieldhouse is a senior naval officer who speaks at the commissioning ceremony of HMS Birmingham."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;LORD MAYOR OF BIRMINGHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord Mayor of Birmingham is a local official who attends the commissioning ceremony of HMS Birmingham."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;TYPE 42 GUIDED MISSILE DESTROYER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Type 42 guided missile destroyer is a class of warships equipped with advanced Sea Dart missile systems and radar technology."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;SEA DART MISSILE SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Sea Dart missile system is a surface-to-air missile system used on HMS Birmingham for air defense."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ANTI-SUBMARINE WARFARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anti-submarine warfare is a capability of HMS Birmingham to defend against submarine threats."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ADVANCED RADAR TECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Advanced radar technology is a feature of HMS Birmingham that enhances its surveillance and detection capabilities."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;1973&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1973 is the year when HMS Birmingham was docked at Portsmouth and when the Yom Kippur War took place."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;1976&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1976 is the year when HMS Birmingham was officially commissioned into the Royal Navy's fleet."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ISRAEL DEFENSE FORCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Israel Defense Forces are the military forces of Israel, receiving material support during the Yom Kippur War."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;CONVOY OF SUPPLY SHIPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Convoy of supply ships is a group of ships bound for Israel, escorted by HMS Birmingham during Operation Nickel Grass."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;NORTH ATLANTIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North Atlantic is a region where HMS Birmingham may have conducted operations, enhancing its capabilities in the area."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;SEA TRIALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Sea trials are a series of tests conducted to ensure the readiness and performance of HMS Birmingham before commissioning."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;COMMISSIONING CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Commissioning ceremony is a formal event marking the official entry of HMS Birmingham into the Royal Navy's active fleet."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ADVANCED QUALIFICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Advanced qualifications are certifications held by personnel on HMS Birmingham, ensuring their expertise in various fields."&lt;SEP&gt;"Advanced qualifications are held by the personnel of HMS Birmingham, indicating their expertise in their respective fields."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;PORTSMOUTH NAVAL BASE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portsmouth Naval Base is the base where HMS Birmingham was docked and where the commissioning ceremony took place."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;BRITISH ARMED FORCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Armed Forces include the Royal Navy and other branches, to which HMS Birmingham belongs."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;PERSONNEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Personnel refers to the crew members of HMS Birmingham who hold advanced qualifications in their respective fields."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;RIGOROUS TRAINING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rigorous training is a process that the personnel of HMS Birmingham have undergone to ensure their readiness for active service."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;CONSTRUCTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Construction is the phase during which HMS Birmingham was built before entering active service."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;ACTIVE SERVICE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Active service is the phase during which HMS Birmingham will operate under the Royal Navy's command."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Region refers to the area where HMS Birmingham will maintain peace and stability as part of its duties."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;DEFENDING BRITISH INTERESTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Defending British interests is the primary mission of HMS Birmingham in its active service."</data>
      <data key="d2">cb-0463</data>
    </node>
    <node id="&quot;MAINTAINING PEACE AND STABILITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Maintaining peace and stability is a key objective of HMS Birmingham's operations in the region."</data>
      <data key="d2">cb-0463</data>
    </node>
