<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christiaan Benjamin Nieuwenhuis is a renowned Dutch photographer and the newly appointed top official at the Amsterdam Art Institute (AAI), known for his landscape photography and passion for arts administration."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;AMSTERDAM ART INSTITUTE (AAI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amsterdam Art Institute (AAI) is a prestigious art institution where Christiaan Benjamin Nieuwenhuis has been appointed as the top official, focusing on nurturing the next generation of creatives and increasing diversity and accessibility in the art world."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is the city where the Amsterdam Art Institute (AAI) is located, and where Christiaan Benjamin Nieuwenhuis is based."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is the Chairperson of the Board of Directors at the Amsterdam Art Institute (AAI), praising Christiaan Benjamin Nieuwenhuis's appointment for his unique blend of artistic vision and business acumen."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;SASKIA VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saskia van der Meer is an Amsterdam-based artist who supports Christiaan Benjamin Nieuwenhuis's appointment to the Amsterdam Art Institute (AAI), believing he will promote emerging artists effectively."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;ART FOR ALL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Art for All is an initiative introduced by Christiaan Benjamin Nieuwenhuis to provide free art classes to underprivileged youth in Amsterdam, aiming to increase diversity and accessibility in the art world."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;ROYAL NETHERLANDS ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Netherlands Army is the military branch where Christiaan Benjamin Nieuwenhuis serves as a member of the military band, bringing a level of dedication and passion to his music career."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;COLONEL PETER VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colonel Peter van der Meer is the Commander of the Royal Netherlands Army Band, praising Christiaan Benjamin Nieuwenhuis's talent and dedication to his music career."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;MARCEL VAN DER VELDEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marcel van der Velden is a fellow photographer and friend of Christiaan Benjamin Nieuwenhuis, supporting his ability to balance his photography and music careers."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Netherlands is the country where Christiaan Benjamin Nieuwenhuis is based and where the Amsterdam Art Institute (AAI) and the Royal Netherlands Army are located."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;PRINSJESDAG CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Prinsjesdag ceremony is a high-profile event where the Royal Netherlands Army performs, and Christiaan Benjamin Nieuwenhuis has been a member of the Royal Netherlands Army Band since 2015."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;NATIONAL VETERANS DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"National Veterans Day is another high-profile event where the Royal Netherlands Army performs, and Christiaan Benjamin Nieuwenhuis has been a member of the Royal Netherlands Army Band since 2015."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;FREE ART CLASSES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Free art classes are part of the 'Art for All' initiative introduced by Christiaan Benjamin Nieuwenhuis to provide educational opportunities to underprivileged youth in Amsterdam."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;UNDERPRIVILEGED YOUTH&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Underprivileged youth are the beneficiaries of the 'Art for All' initiative, receiving free art classes in Amsterdam."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;EMERGING ARTISTS&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Emerging artists are the target audience for the Amsterdam Art Institute (AAI)'s prestigious residency program, which has seen a 25% rise in submissions since Christiaan Benjamin Nieuwenhuis's appointment."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;PRESTIGIOUS RESIDENCY PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Prestigious residency program is a part of the Amsterdam Art Institute (AAI) where emerging artists can apply, and there has been a 25% rise in submissions since Christiaan Benjamin Nieuwenhuis's appointment."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;RENAISSANCE MAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Renaissance man is a person known for a unique blend of artistry and military service, inspiring others."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;ARTISTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artistry refers to the creative and artistic abilities of the Renaissance man."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;MILITARY SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Military service refers to the military background of the Renaissance man."</data>
      <data key="d2">cb-0453</data>
    </node>
    <node id="&quot;US&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Us refers to a group or community that is inspired by the Renaissance man."</data>
      <data key="d2">cb-0453</data>
    </node>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;AMSTERDAM ART INSTITUTE (AAI)&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Christiaan Benjamin Nieuwenhuis has been appointed as the top official at the Amsterdam Art Institute (AAI), focusing on nurturing the next generation of creatives and increasing diversity and accessibility in the art world."</data>
      <data key="d5">"leadership, artistic vision"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Maria Rodriguez praises Christiaan Benjamin Nieuwenhuis's appointment for his unique blend of artistic vision and business acumen."</data>
      <data key="d5">"endorsement, leadership qualities"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;SASKIA VAN DER MEER&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Saskia van der Meer supports Christiaan Benjamin Nieuwenhuis's appointment to the Amsterdam Art Institute (AAI), believing he will promote emerging artists effectively."</data>
      <data key="d5">"support, promotion of emerging artists"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;ART FOR ALL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Christiaan Benjamin Nieuwenhuis introduced the 'Art for All' initiative to provide free art classes to underprivileged youth in Amsterdam, aiming to increase diversity and accessibility in the art world."</data>
      <data key="d5">"initiative, education"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;ROYAL NETHERLANDS ARMY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Christiaan Benjamin Nieuwenhuis serves as a member of the Royal Netherlands Army's military band, bringing a level of dedication and passion to his music career."</data>
      <data key="d5">"dual career, dedication"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;CHRISTIAAN BENJAMIN NIEUWENHUIS&quot;" target="&quot;COLONEL PETER VAN DER MEER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Colonel Peter van der Meer praises Christiaan Benjamin Nieuwenhuis's talent and dedication to his music career as a member of the Royal Netherlands Army Band."</data>
      <data key="d5">"endorsement, musical talent"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;RENAISSANCE MAN&quot;" target="&quot;RENAISSANCE MAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The term 'Renaissance man' describes the individual, emphasizing his dual talents and inspirational nature."</data>
      <data key="d5">"inspiration, multifaceted talent"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;RENAISSANCE MAN&quot;" target="&quot;ARTISTRY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Renaissance man is known for his artistry."</data>
      <data key="d5">"inspiration, creativity"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;RENAISSANCE MAN&quot;" target="&quot;MILITARY SERVICE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Renaissance man is known for his military service."</data>
      <data key="d5">"dual talents, inspiration"</data>
      <data key="d6">cb-0453</data>
    </edge>
    <edge source="&quot;RENAISSANCE MAN&quot;" target="&quot;US&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Renaissance man inspires the group or community referred to as 'us'. "</data>
