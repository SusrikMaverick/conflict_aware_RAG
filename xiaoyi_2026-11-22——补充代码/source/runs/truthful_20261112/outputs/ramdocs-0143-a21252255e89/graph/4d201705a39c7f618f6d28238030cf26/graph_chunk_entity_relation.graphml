  <graph edgedefault="undirected">
    <node id="&quot;TOWN OF WHEATLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Town of Wheatland is a town that was originally in Racine County but later transferred to Kenosha County. It has a population and demographic data from the 2000 census."</data>
      <data key="d2">ramdocs-0143-a21252255e89</data>
    </node>
    <node id="&quot;LAKE&quot;">
      <data key="d0">"LOCATION"</data>
