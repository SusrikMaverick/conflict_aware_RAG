  <graph edgedefault="undirected">
    <node id="&quot;WHO FRAMED ROGER RABBIT (1988 VIDEO GAME)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Who Framed Roger Rabbit (1988 video game) is a video game based on the film of the same name, released for multiple platforms in 1988."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;BUENA VISTA SOFTWARE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Buena Vista Software is the developer of the 1988 video game 'Who Framed Roger Rabbit', releasing it for several platforms."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;BENNY THE CAB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benny the Cab is a character in the 1988 video game, controlled by the player to navigate through the first level."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;INK AND PAINT CLUB&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ink and Paint Club is a location in the first level of the 1988 video game, where the player must reach before the Toon Patrol."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;TOON PATROL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Toon Patrol is a group of characters in the 1988 video game that the player must avoid while driving Benny the Cab."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;DIP&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Dip is a substance in the game that creates puddles on the road, which the player must avoid while driving Benny the Cab."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;WHO FRAMED ROGER RABBIT (1989 VIDEO GAME)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Who Framed Roger Rabbit (1989 video game) is an action-adventure video game based on the film of the same name, created by Rare and published by LJN in 1989."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;RARE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rare is the developer of the 1989 video game 'Who Framed Roger Rabbit', creating an action-adventure game for the Nintendo Entertainment System."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;LJN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"LJN is the publisher of the 1989 video game 'Who Framed Roger Rabbit', releasing it for the Nintendo Entertainment System."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is the setting of the 1989 video game, where the player controls private detective Eddie Valiant."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;EDDIE VALIANT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eddie Valiant is the main character in the 1989 video game, a private detective who is always followed by Roger Rabbit."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;ROGER RABBIT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Rabbit is a character in both the 1988 and 1989 video games, appearing in both as a co-player and a character followed by Eddie Valiant."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;NINTENDO ENTERTAINMENT SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nintendo Entertainment System is the platform for the 1989 video game 'Who Framed Roger Rabbit', developed by Rare and published by LJN."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;APPLE II&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Apple II is one of the platforms for the 1988 video game 'Who Framed Roger Rabbit', developed and released by Buena Vista Software."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;COMMODORE 64&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Commodore 64 is one of the platforms for the 1988 video game 'Who Framed Roger Rabbit', developed and released by Buena Vista Software."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;MS-DOS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"MS-DOS is one of the platforms for the 1988 video game 'Who Framed Roger Rabbit', developed and released by Buena Vista Software."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;AMIGA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Amiga is one of the platforms for the 1988 video game 'Who Framed Roger Rabbit', developed and released by Buena Vista Software."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
    <node id="&quot;ATARI ST&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Atari ST is one of the platforms for the 1988 video game 'Who Framed Roger Rabbit', developed and released by Buena Vista Software."</data>
      <data key="d2">ramdocs-0120-2dd949c465b0</data>
    </node>
