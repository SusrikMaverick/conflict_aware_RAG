<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SWEDISH EVANGELICAL LUTHERAN CHURCH (HAM LAKE, MINNESOTA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swedish Evangelical Lutheran Church (Ham Lake, Minnesota) is a historic property in Anoka County, Minnesota, built in 1872 and designed by Per August Gustafson. It is listed on the National Register of Historic Places and is owned by Our Savior's Lutheran Church of East Bethel, Minnesota.")</data>
      <data key="d2">ramdocs-0476-939242695e3d</data>
    </node>
    <node id="&quot;REVEREND J. A. AUSLAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Reverend J. A. Ausland is a traveling pastor from Anoka who served the congregation in 1872.")</data>
      <data key="d2">ramdocs-0476-939242695e3d</data>
    </node>
    <node id="&quot;SWEDISH EVANGELICAL LUTHERAN CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swedish Evangelical Lutheran Church is a historic church located in Swedesburg, Iowa, United States, built in 1928 and added to the National Register of Historic Places in 1999."</data>
      <data key="d2">ramdocs-0476-939242695e3d</data>
    </node>
  </graph>
