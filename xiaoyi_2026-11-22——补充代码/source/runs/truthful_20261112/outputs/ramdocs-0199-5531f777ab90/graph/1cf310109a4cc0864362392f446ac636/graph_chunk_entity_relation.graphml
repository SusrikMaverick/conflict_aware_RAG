  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HAJIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hajin is a small city in eastern Syria, administratively part of the Deir ez-Zor Governorate, located along the Euphrates River, south of Deir ez-Zor. It had a population of 37,935 in the 2004 census and is the administrative center of a 'nahiyah' of the Abu Kamal District."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;DEIR EZ-ZOR GOVERNORATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Deir ez-Zor Governorate is the administrative region where Hajin is located."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;EUPHRATES RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Euphrates River is a river near which Hajin is located."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;AL-ABBAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Al-Abbas is a locality to the west of Hajin."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;AL-RAMADI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Al-Ramadi is a locality to the south of Hajin."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;GHARANIJ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gharanij is a locality to the north of Hajin."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;ABU KAMAL DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Abu Kamal District is the district where Hajin is the administrative center."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;AUTONOMOUS ADMINISTRATION OF NORTH AND EAST SYRIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Autonomous Administration of North and East Syria is the controlling authority mentioned in relation to Hajin."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;AL-SHAITAT TRIBE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"al-Shaitat tribe is the largest tribe in the Hajin subdistrict."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;KOTAYK PROVINCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kotayk Province is the province where Nor Hachn is located."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;ARMENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Armenia is the country where Nor Hachn is located."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;HRAZDAN RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hrazdan River is the river near which Nor Hachn is located."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;ARZNI-SHAMIRAM CANAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arzni-Shamiram canal is near Nor Hachn."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;HAÇIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haçin is a town in Cilicia, used as a reference for naming Nor Hachn."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;NOR HACHN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nor Hachn is a town and urban municipal community in the Kotayk Province of Armenia, founded in 1953. The town is located on the right bank of Hrazdan River, to the west of the Arzni canyon, on the immediate proximity of the Arzni-Shamiram canal. As per the 2011 census, Nor Hachn had a population of 9,307. According to the 2016 official estimate, the population is around 8,400."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;ARZNI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arzni is a canyon near Nor Hachn."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;2004 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2004 census is a reference to the population count of Hajin and the Hajin subdistrict."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;2011 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2011 census is a reference to the population count of Nor Hachn."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
    <node id="&quot;2016 OFFICIAL ESTIMATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2016 official estimate is a reference to the population count of Nor Hachn."</data>
      <data key="d2">ramdocs-0199-5531f777ab90</data>
    </node>
