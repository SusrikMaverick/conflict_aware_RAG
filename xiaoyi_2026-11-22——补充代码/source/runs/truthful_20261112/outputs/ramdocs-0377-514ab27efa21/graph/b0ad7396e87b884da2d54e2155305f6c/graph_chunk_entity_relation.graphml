  <graph edgedefault="undirected">
    <node id="&quot;REVISITED (EARTHA KITT ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Revisited (Eartha Kitt album) is a 1960 studio album by American singer Eartha Kitt, her second album issued on the Kapp Records label, containing previously recorded songs from 1953 to 1958."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;1960&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1960 is the year when the album 'Revisited' was recorded and released."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;PUBLIC IMAGE LTD.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Public Image Ltd. is a band that Keith Levene joined in 1981."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;KEITH LEVENE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Keith Levene is a musician who has been part of multiple bands including Public Image Ltd., The Banned, Department S, Generation X, Hanoi Rocks, Black Sabbath, Neo, Radio Stars, Glen Matlock, Siouxsie and the Banshees, Cowboys International, and Adam and the Ants."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;JIMMY HUGHES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jimmy Hughes is a musician who was part of The Banned and later Department S."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;TERRY CHIMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Terry Chimes is a musician who was part of The Clash and later Generation X, Hanoi Rocks, and Black Sabbath."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;PAUL SIMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Simon is a musician who was part of Neo and Radio Stars and later Glen Matlock."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;MARCO PIRRONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marco Pirroni is a musician who was part of Siouxsie and the Banshees and briefly Cowboys International before joining Adam and the Ants."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;STEVIE SHEARS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stevie Shears is a musician who was part of Ultravox."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United Kingdom is the country where the 1963 7-inch EP Vinyl was released by Kapp Records."</data>
      <data key="d2">ramdocs-0377-514ab27efa21</data>
    </node>
    <node id="&quot;KAPP RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kapp Records is a record label that released various albums and EPs in different countries."</data>
