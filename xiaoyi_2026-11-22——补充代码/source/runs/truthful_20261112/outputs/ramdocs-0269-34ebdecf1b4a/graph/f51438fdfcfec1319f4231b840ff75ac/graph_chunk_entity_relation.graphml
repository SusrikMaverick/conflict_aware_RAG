      <data key="d2">ramdocs-0269-34ebdecf1b4a</data>
    </node>
    <node id="&quot;SIRAYA PEOPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Siraya people are an indigenous group in Taiwan, known for their unique language and culture."</data>
      <data key="d2">ramdocs-0269-34ebdecf1b4a</data>
    </node>
    <node id="&quot;SIRAYA LANGUAGE&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Siraya language is the primary language spoken by the Siraya people, with distinct dialects and features."</data>
      <data key="d2">ramdocs-0269-34ebdecf1b4a</data>
    </node>
