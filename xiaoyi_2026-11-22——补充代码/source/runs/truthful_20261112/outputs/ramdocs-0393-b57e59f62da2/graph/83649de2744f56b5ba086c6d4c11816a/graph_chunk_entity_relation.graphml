  <graph edgedefault="undirected">
    <node id="&quot;CHILPERIC I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chilperic I was the king of Neustria from 561 to 584, one of the sons of Clotaire I and Aregund, and had a tumultuous relationship with his brothers and their wives."|</data>
      <data key="d2">ramdocs-0393-b57e59f62da2</data>
    </node>
    <node id="&quot;NEUSTRIAN WARRIORS&quot;">
