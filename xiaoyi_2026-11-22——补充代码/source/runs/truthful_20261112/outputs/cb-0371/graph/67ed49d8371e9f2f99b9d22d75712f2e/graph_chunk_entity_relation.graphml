  <graph edgedefault="undirected">
    <node id="&quot;AUBURN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Auburn University is a college campus where Sergei Bespalykh is practicing basketball, located in Auburn, Alabama."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;SERGEI BESPALYKH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sergei Bespalykh is a Russian footballer turned basketball sensation, known for his quick reflexes and athletic skills."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;COACH BRUCE PEARL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Coach Bruce Pearl is the coach of the Auburn Tigers men's basketball team, observing and evaluating Sergei Bespalykh's skills."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;AUBURN TIGERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Auburn Tigers is the nickname of Auburn University's men's basketball team."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;SAMIR DAVENPORT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Samir Davenport is the star point guard of the Auburn Tigers men's basketball team, curious about Sergei Bespalykh's abilities."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;FC VOLGA TVER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Volga Tver is a football club based in Tver, Russia, where Sergei Bespalykh played before joining Auburn University."&lt;SEP&gt;"FC Volga Tver is a football club that Sergei helped promote to the Russian Football National League's top division."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;TVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tver is a city in Russia where FC Volga Tver is based and where Sergei Bespalykh was born and raised."&lt;SEP&gt;"Tver is the city where FC Volga Tver is based and has a significant fan base."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;RUSSIAN FOOTBALL NATIONAL LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Russian Football National League is the league in which FC Volga Tver and FC Torpedo Moscow compete."&lt;SEP&gt;"The Russian Football National League is the top division of Russian football, to which FC Volga Tver was promoted."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;FC TORPEDO MOSCOW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Torpedo Moscow is a football club that played against FC Volga Tver in a match where Sergei Bespalykh made his professional debut."</data>
      <data key="d2">cb-0371</data>
    </node>
    <node id="&quot;FC CHERTANOVO MOSCOW&quot;">
