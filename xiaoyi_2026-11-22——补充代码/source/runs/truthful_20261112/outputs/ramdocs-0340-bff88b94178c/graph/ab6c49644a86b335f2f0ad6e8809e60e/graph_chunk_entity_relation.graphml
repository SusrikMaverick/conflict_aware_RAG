<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;64TH (2ND HIGHLAND) DIVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"64th (2nd Highland) Division was an infantry division of the British Army, raised during the Great War, serving on home defence duties and later becoming a training unit composed of conscripts from throughout Britain."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;51ST (HIGHLAND) DIVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"51st (Highland) Division is mentioned as the original model for the 64th (2nd Highland) Division in 1914."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;GREAT WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Great War refers to World War I, during which the 64th (2nd Highland) Division was formed and served."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;BRITISH ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Army is the parent organization of the 64th (2nd Highland) Division."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;64TH DIVISION (IMPERIAL JAPANESE ARMY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"64th Division (Imperial Japanese Army) was an infantry division of the Imperial Japanese Army, formed in 1943 in Hubei province, serving as a security division without an artillery regiment."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;12TH FROM CHUZHOU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"12th from Chuzhou provided the nucleus for the formation of the 64th Division (Imperial Japanese Army)."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;HIROSHIMA MOBILIZATION DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hiroshima mobilization district is the source of recruits for the 64th Division (Imperial Japanese Army)."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;20TH ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"20th army is the higher command to which the 64th Division (Imperial Japanese Army) was assigned on 10 July 1943."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;OPEN DIVISION (開兵団, KAI HEIDAN)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Open Division (開兵団, Kai Heidan) is another name for the 64th Division (Imperial Japanese Army), formed in 1943 in Hubei province."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;62ND AND 63RD DIVISIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"62nd and 63rd divisions were formed simultaneously with the 64th Division (Imperial Japanese Army) in 1943 as security divisions."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;12TH INDEPENDENT MIXED BRIGADE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"12th Independent Mixed Brigade provided the nucleus for the formation of the 64th Division (Imperial Japanese Army)."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;NEAC (NORTHEAST AIR COMMAND)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NEAC (Northeast Air Command) is the command that took over the 64th Air Division after the inactivation of the former Newfoundland Base Command."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;PEPPERRELL AIR FORCE BASE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pepperrell Air Force Base is the location where the 64th Air Division was reactivated in December 1952."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;THULE AB, GREENLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thule AB, Greenland is a location where fighter-interceptor squadrons were deployed with F-94B's and F-89s."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;GOOSE AFB IN LABRADOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Goose AFB in Labrador is a location where additional interceptor squadrons were established with F-94s and F-89s."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;ERNEST HARMON AFB IN NEWFOUNDLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ernest Harmon AFB in Newfoundland is a location where fighter-interceptor squadrons were established."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;TACTICAL AIR COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tactical Air Command provided fighter-interceptor squadrons to NEAC bases."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;STRATEGIC AIR COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Strategic Air Command provided tankers and bombers to NEAC bases, primarily using Thule as a refueling and staging base."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;THULE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thule is a location used as a refueling and staging base for Strategic Air Command tankers and bombers."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
    <node id="&quot;6TH PURSUIT WING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"6th Pursuit Wing was established on 19 October 1940 and activated on 18 December 1940."</data>
      <data key="d2">ramdocs-0340-bff88b94178c</data>
    </node>
  </graph>
</graphml>
