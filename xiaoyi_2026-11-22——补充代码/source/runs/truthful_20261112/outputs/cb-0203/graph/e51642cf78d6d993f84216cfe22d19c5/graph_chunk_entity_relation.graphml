  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRANS RIJK PIETER VAN DEN ABEELEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frans Rijk Pieter van den Abeelen is a Dutch military officer known for his dual role as a Catholic priest, born on April 12, 1975, in Amsterdam, Netherlands. He has shown unwavering dedication to his country and its people, earning numerous commendations for his leadership and bravery."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is the birthplace of Frans Rijk Pieter van den Abeelen and is a major city in the Netherlands."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;ROYAL NETHERLANDS ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Netherlands Army is the land component of the Dutch Armed Forces, where van den Abeelen began his military career."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;NATO-LED KOSOVO FORCE (KFOR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KFOR is a NATO-led international peacekeeping force in Kosovo, where van den Abeelen served as a liaison officer."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;CATHOLIC THEOLOGICAL UNIVERSITY OF UTRECHT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Theological University of Utrecht is where van den Abeelen studied to become a priest, earning a Bachelor of Sacred Theology degree."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;BISHOP GERARD DE KORTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Gerard de Korte ordained van den Abeelen as a priest in the Cathedral of St. Catherine in Utrecht."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;CHAPLAINCY SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chaplaincy Service is part of the Netherlands Ministry of Defence where van den Abeelen provides spiritual guidance to military personnel."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;MILITARY SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Military Service refers to the period of time an individual dedicates to serving in the armed forces, which is a significant aspect of van den Abeelen's life."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;KOSOVO WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Kosovo War was a conflict in which van den Abeelen served as a liaison officer, highlighting his experience in international peacekeeping operations."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;DUTCH ARMED FORCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Dutch Armed Forces include the Royal Netherlands Army, which is where van den Abeelen began his military career."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;JOURNAL OF MILITARY ETHICS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Journal of Military Ethics is a publication that discusses research and theories related to military ethics and morale."&lt;SEP&gt;"The Journal of Military Ethics is where a study was published about the impact of dual-role chaplains on military morale, referencing van den Abeelen's work."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;DE VOLKSKRANT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"De Volkskrant is a Dutch newspaper that interviewed van den Abeelen about his dual role as a military officer and priest."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;CATHOLIC HERALD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Herald is a Catholic newspaper that highlighted van den Abeelen's work as a chaplain, noting his ability to provide spiritual support to soldiers."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;CATHEDRAL OF ST. CATHERINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Cathedral of St. Catherine in Utrecht is where van den Abeelen was ordained as a priest by Bishop Gerard de Korte."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;NETHERLANDS MINISTRY OF DEFENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Netherlands Ministry of Defence oversees the Chaplaincy Service where van den Abeelen provides spiritual guidance to military personnel."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;HIGH-STRESS ENVIRONMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"High-Stress Environments refer to the challenging conditions in which van den Abeelen provides spiritual support as a chaplain."&lt;SEP&gt;"High-stress environments refer to the challenging conditions in which soldiers operate, often requiring additional support."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;SOLDIERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Soldiers are individuals operating in high-stress environments, often part of military organizations."&lt;SEP&gt;"Soldiers are the individuals van den Abeelen provides spiritual guidance to as a chaplain, highlighting his role in supporting military personnel."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;MILITARY MORALE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Military Morale refers to the overall mental and emotional state of soldiers within a military organization, influenced by various factors including leadership and chaplain support."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;DUAL-ROLE CHAPLAINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dual-Role Chaplains are individuals who serve both religious and counseling roles within military organizations, impacting soldier morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;THE IMPACT OF DUAL-ROLE CHAPLAINS ON MILITARY MORALE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Impact of Dual-Role Chaplains on Military Morale is a specific study examining the effects of dual-role chaplains on soldier morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;J.M. VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J.M. van der Meer is an author of a study on the impact of dual-role chaplains on military morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;A.C. VAN DER VELDEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A.C. van der Velden is an author of a study on the impact of dual-role chaplains on military morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The study conducted by J.M. van der Meer and A.C. van der Velden examines the impact of dual-role chaplains on military morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;LEADERSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Leadership refers to the guidance and management provided by military leaders, which can significantly affect soldier morale."</data>
      <data key="d2">cb-0203</data>
    </node>
    <node id="&quot;CHAPLAIN SUPPORT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chaplain support includes the spiritual and emotional assistance provided by chaplains to soldiers."</data>
      <data key="d2">cb-0203</data>
    </node>
