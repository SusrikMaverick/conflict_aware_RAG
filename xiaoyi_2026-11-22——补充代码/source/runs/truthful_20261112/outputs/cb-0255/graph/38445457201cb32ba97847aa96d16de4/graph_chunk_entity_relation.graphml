<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KATY PERRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Katy Perry is an American pop sensation who embarked on the California Dreams Tour in 2011, supporting her third studio album 'Teenage Dream' and making headlines for her social activism."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;CALIFORNIA DREAMS TOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The California Dreams Tour is a significant musical event associated with The Supremes, leaving an indelible mark on the music world."&lt;SEP&gt;"The California Dreams Tour was a concert tour spanning over a year, visiting 124 cities globally, supporting Katy Perry's 'Teenage Dream' album and grossing over $124 million in ticket sales."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;LISBON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lisbon, Portugal, was the starting point of the California Dreams Tour in 2011."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;TEENAGE DREAM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Teenage Dream is Katy Perry's third studio album, which debuted at number one on the US Billboard 200 chart and spawned five number one singles."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;POLLSTAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pollstar is a leading concert industry publication that reported the California Dreams Tour's gross of over $124 million in ticket sales."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;ROLLING STONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rolling Stone is a music magazine that praised Katy Perry's high-energy performances during the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;GLAAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GLAAD is a media advocacy organization that praised Katy Perry for her support of the LGBTQ+ community."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;ROBYN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robyn is a Swedish singer who performed as a special guest on the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;MARINA AND THE DIAMONDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marina and the Diamonds is a British singer who performed as a special guest on the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;JANELLE MONÁE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Janelle Monáe is an American singer who performed as a special guest on the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;THE SUPREMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Supremes are a renowned musical organization known for their contributions to the music world."&lt;SEP&gt;"The Supremes is an American R&amp;B/soul girl group that performed alongside the California Dreams Tour at the Hollywood Bowl in 1964."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;DIANA ROSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Diana Ross is the lead vocalist of The Supremes and was part of the performance at the Hollywood Bowl in 1964."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;MARY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary Wilson is a member of The Supremes and was part of the performance at the Hollywood Bowl in 1964."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;FLORENCE BALLARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Florence Ballard is a member of The Supremes and was part of the performance at the Hollywood Bowl in 1964."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;HOLLYWOOD BOWL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Hollywood Bowl is a famous outdoor amphitheater in Los Angeles where The Supremes and the California Dreams Tour performed in 1964."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;JERRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jerry is the tour manager who presented a black leather jacket to The Supremes as a token of appreciation for performing with the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;SPECIAL GUESTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Special Guests refers to the performers who joined the California Dreams Tour, including Robyn, Marina and the Diamonds, and Janelle Monáe."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;SWEET HARMONIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sweet Harmonies refers to the musical style of The Supremes, characterized by their harmonious vocals."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;SASSY STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sassy Style refers to the fashion and persona of The Supremes, known for their bold and confident stage presence."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;LGBTQ+ COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"LGBTQ+ Community refers to the group of people who advocate for LGBTQ+ rights and acceptance."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;SOCIAL CAUSES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social Causes refer to the various social issues and movements that Katy Perry supports, such as LGBTQ+ rights."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;MUSIC WORLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The music world refers to the broader context of the music industry and audience that The Supremes and the California Dreams Tour are part of."</data>
      <data key="d2">cb-0255</data>
    </node>
    <node id="&quot;FRIENDSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Friendship is a concept that describes the positive relationship between the entities involved in the California Dreams Tour."</data>
      <data key="d2">cb-0255</data>
    </node>
