<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JEUX VIDEO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jeux Video is a media outlet that spoke to both Christophe Gans and Justin Kurzel about their films."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;CHRISTOPHE GANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christophe Gans is a film director who wrote the script for a film during the Covid-19 lockdown."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;JUSTIN KURZEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Justin Kurzel is a film director who also wrote the script for a film during the Covid-19 lockdown."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;MICHAEL MANN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Mann is a fellow director whose work influenced Christophe Gans in the design of the film's visual elements."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;DAVID LYNCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Lynch is a fellow director whose work influenced Christophe Gans in the design of the film's visual elements."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;DAVID CRONENBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Cronenberg is a fellow director whose work influenced Christophe Gans in the design of the film's visual elements."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;COVID-19 LOCKDOWN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Covid-19 lockdown is the period during which the script for the film was written."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;FILM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The film is the project being discussed, influenced by various directors and elements."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;VISUAL ELEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Visual elements refer to the aesthetic and stylistic aspects of the film designed by Christophe Gans."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <node id="&quot;SOUNDTRACK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The soundtrack is a component of the film's audio production."</data>
      <data key="d2">rgb-0031</data>
    </node>
    <edge source="&quot;JEUX VIDEO&quot;" target="&quot;CHRISTOPHE GANS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Jeux Video spoke to Christophe Gans about his film and the script he wrote during the Covid-19 lockdown."</data>
      <data key="d5">"interview, script writing"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;JEUX VIDEO&quot;" target="&quot;JUSTIN KURZEL&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Jeux Video spoke to Justin Kurzel about his film and the script he wrote during the Covid-19 lockdown."</data>
      <data key="d5">"interview, script writing"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;MICHAEL MANN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Christophe Gans was influenced by Michael Mann in the design of the film's visual elements."</data>
      <data key="d5">"influence, visual elements"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;DAVID LYNCH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Christophe Gans was influenced by David Lynch in the design of the film's visual elements."</data>
      <data key="d5">"influence, visual elements"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;DAVID CRONENBERG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Christophe Gans was influenced by David Cronenberg in the design of the film's visual elements."</data>
      <data key="d5">"influence, visual elements"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;COVID-19 LOCKDOWN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Christophe Gans wrote the script during the Covid-19 lockdown."</data>
      <data key="d5">"script writing, lockdown period"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;FILM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Christophe Gans is involved in the creation of the film, influenced by other directors and elements."</data>
      <data key="d5">"film creation, influence"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;CHRISTOPHE GANS&quot;" target="&quot;VISUAL ELEMENTS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Christophe Gans was influenced by Michael Mann, David Lynch, and David Cronenberg in the design of the film's visual elements."</data>
      <data key="d5">"influence, visual elements"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;JUSTIN KURZEL&quot;" target="&quot;COVID-19 LOCKDOWN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Justin Kurzel wrote the script during the Covid-19 lockdown."</data>
      <data key="d5">"script writing, lockdown period"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;JUSTIN KURZEL&quot;" target="&quot;FILM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Justin Kurzel is involved in the creation of the film, influenced by other directors and elements."</data>
      <data key="d5">"film creation, influence"</data>
      <data key="d6">rgb-0031</data>
    </edge>
    <edge source="&quot;VISUAL ELEMENTS&quot;" target="&quot;SOUNDTRACK&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Visual elements and the soundtrack are components of the film's overall production."</data>
      <data key="d5">"production, audio-visual"</data>
      <data key="d6">rgb-0031</data>
    </edge>
  </graph>
