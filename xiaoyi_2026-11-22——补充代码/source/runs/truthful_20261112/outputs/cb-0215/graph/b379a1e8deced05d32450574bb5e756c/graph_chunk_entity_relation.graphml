  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MALIKA SONNET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Malika Sonnet is a Belgian politician and badminton enthusiast, recognized for her contributions to both fields, particularly in promoting gender equality and empowering women."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BELGIAN POLITICIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Belgian Politician refers to Malika Sonnet's professional role in politics, specifically as a councilor and member of the Belgian Chamber of Representatives."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;NL GENDERGAP MAINTENANCE PROJECT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NL Gendergap maintenance project is a Dutch-based initiative aimed at addressing the gender imbalance on Wikipedia by highlighting women's biographies."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;DR. SOPHIE VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophie van der Meer is a leading expert on gender studies and a member of the NL Gendergap maintenance project, praising Malika Sonnet's contributions to gender equality."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;JOLIEN VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jolien van der Meer is a Wikipedia editor and project leader of NL Gendergap maintenance, highlighting Malika Sonnet's inclusion on their focus list."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;WORLD ECONOMIC FORUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"World Economic Forum provides the Global Gender Gap Index, ranking countries based on gender equality."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BELGIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgium is the country where Malika Sonnet is based, known for its ranking in the Global Gender Gap Index."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brussels is the city where Malika Sonnet was born and where she has been active in politics and badminton."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;SCHAERBEEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Schaerbeek is the municipality where Malika Sonnet served as a councilor."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;EUROPEAN BADMINTON CHAMPIONSHIPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"European Badminton Championships is an event organized by Malika Sonnet in 2012, held in Antwerp, Belgium."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BADMINTON WORLD FEDERATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Badminton World Federation awarded Malika Sonnet the Golden Shuttle award for her contributions to the sport."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;WIKIPROJECT BADMINTON\/TOURNAMENT FOCUS LIST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WikiProject Badminton\/tournament focus list is a collaborative effort to improve the coverage of badminton tournaments on Wikipedia, including Malika Sonnet."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;ANTWERP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Antwerp is the city where the European Badminton Championships were held in 2012."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;UNIVERSITY OF BRUSSELS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Brussels is where Malika Sonnet studied political science and earned her Bachelor's degree."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BELGIAN BADMINTON FEDERATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Belgian Badminton Federation is the organization where Malika Sonnet has been an active member since 2000 and served as president from 2010 to 2015."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;BADMINTON&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Badminton is the sport in which Malika Sonnet is an enthusiast and has made significant contributions."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;GENDER EQUALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gender Equality is the cause that Malika Sonnet advocates for and works to promote."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;WOMEN'S EMPOWERMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Women's Empowerment is the goal that Malika Sonnet aims to achieve through her work and advocacy."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;POLITICAL EMPOWERMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Political Empowerment is one of the areas where Malika Sonnet focuses her efforts to bridge the gender gap."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;ECONOMIC PARTICIPATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic Participation is another area where Malika Sonnet works to bridge the gender gap."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;GLOBAL GENDER GAP INDEX&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Global Gender Gap Index is the ranking provided by the World Economic Forum that measures gender equality across various dimensions."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;COMMITTEE ON SPORTS AND EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Committee on Sports and Education is the committee where Malika Sonnet has served as a member in the Belgian Chamber of Representatives."</data>
      <data key="d2">cb-0215</data>
    </node>
    <node id="&quot;COUNCILOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Councilor is the role Malika Sonnet held in the municipality of Schaerbeek from 2001 to 2006."</data>
      <data key="d2">cb-0215</data>
    </node>
