    <node id="&quot;GRAMMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Chayanne received a Grammy Award nomination for Best Latin Pop Performance in 1988, which he lost to José Feliciano's rendition of 'Cielito Lindo'."&lt;SEP&gt;"Chayanne's album 'Chayanne' was nominated for a Grammy Award in 1988."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
