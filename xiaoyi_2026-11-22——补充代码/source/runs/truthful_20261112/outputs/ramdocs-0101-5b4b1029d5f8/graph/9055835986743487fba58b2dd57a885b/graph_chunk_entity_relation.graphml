  <graph edgedefault="undirected">
    <node id="&quot;CHAYANNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chayanne is a Puerto Rican artist known for his music and albums, particularly the 1987 album 'Chayanne'."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;SONY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sony is a record label that released Chayanne's 1987 album 'Chayanne'."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;CBS COLUMBIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CBS Columbia, now known as Sony Music Entertainment, released Chayanne's first album under their label."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;RONNIE FOSTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ronnie Foster is the producer of Chayanne's 1987 album 'Chayanne'."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;FIESTA EN AMERICA&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Fiesta En America is a song from Chayanne's 1987 album, peaking at number four on the Billboard Hot Latin Tracks chart."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;PELIGRO DE AMOR&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Peligro de Amor is another song from Chayanne's 1987 album, also reaching number four on the Billboard Hot Latin Tracks chart."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;BILLBOARD HOT LATIN TRACKS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Billboard Hot Latin Tracks is a chart that tracks the performance of Latin music singles, including songs from Chayanne's 1987 album."</data>
      <data key="d2">ramdocs-0101-5b4b1029d5f8</data>
    </node>
    <node id="&quot;VH1 LATIN AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
