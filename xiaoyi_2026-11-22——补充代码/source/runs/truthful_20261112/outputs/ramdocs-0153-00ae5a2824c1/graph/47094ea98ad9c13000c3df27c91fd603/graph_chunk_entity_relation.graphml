  <graph edgedefault="undirected">
    <node id="&quot;GIANT STEPS (JOHN COLTRANE ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Giant Steps is the fifth studio album by jazz musician John Coltrane, released in 1960 on Atlantic Records, and has become a practice template for jazz saxophonists."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;ATLANTIC RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Atlantic Records is the label that signed John Coltrane for his album Giant Steps in 1960."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;JOHN COLTRANE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Coltrane is a jazz musician who led the album Giant Steps and had a record contract with Atlantic Records."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;HAROLD LOVETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harold Lovett is Miles Davis's business manager who negotiated a record contract for Coltrane with Atlantic Records."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;MILES DAVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Miles Davis is a jazz musician whose business manager Harold Lovett helped negotiate a contract for Coltrane with Atlantic Records."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;GIANT STEPS (THE BOO RADLEYS ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Giant Steps is the third album by The Boo Radleys, released in 1993, inspired by John Coltrane's album of the same name."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;THE BOO RADLEYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Boo Radleys are a band known for their album Giant Steps, which features influences from various genres."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;SANDRA BURLINGAME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sandra Burlingame is a writer/broadcaster/jazz historian who offers a musical analysis of 'Giant Steps'."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;WOODY HERMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Woody Herman is a clarinetist, vocalist, saxophonist, and bandleader who kept a vibrant big band together for 51 years."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;DUKE ELLINGTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Duke Ellington is mentioned as having an achievement equal to Woody Herman's in keeping a big band together for 51 years."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;KIND OF BLUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kind of Blue is considered the greatest all-time jazz album, contrasting with the technical nature of Giant Steps."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;SHIPTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shipton is a writer/broadcaster/jazz historian who offers a musical analysis of 'Giant Steps'."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;GIANT STEPS (WOODY HERMAN ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Giant Steps is mentioned as the title of an album by Woody Herman's band, released in 1973."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;CLARINET&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Clarinet is an instrument used by Woody Herman in his band."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;VOCALIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Vocalist is a role held by Woody Herman in his band."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;SAXOPHONIST&quot;">
      <data key="d0">"ROLE"</data>
