    </node>
    <node id="&quot;UK TOP 20&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"UK Top 20 is the chart position achieved by the album Giant Steps by The Boo Radleys."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;NME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NME is a music magazine that named the album Giant Steps by The Boo Radleys as album of the year."</data>
      <data key="d2">ramdocs-0153-00ae5a2824c1</data>
    </node>
    <node id="&quot;SELECT&quot;">
      <data key="d0">"ORGANIZATION"</data>
