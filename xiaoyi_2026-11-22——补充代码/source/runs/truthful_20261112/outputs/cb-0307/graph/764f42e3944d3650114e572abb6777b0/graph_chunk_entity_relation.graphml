  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GLASGOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glasgow is a vibrant city in Scotland known for intellectual curiosity and innovation, home to the University of Strathclyde."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;UNIVERSITY OF STRATHCLYDE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Strathclyde is an esteemed institution known for academic excellence, where Paulo Hisao Moriya works as a postdoctoral research associate."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;PAULO HISAO MORIYA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paulo Hisao Moriya is a brilliant postdoctoral research associate at the University of Strathclyde, known for his contributions to materials science and engineering."&lt;SEP&gt;"Paulo Hisao Moriya is a researcher or student at the University of São Paulo, currently working on a dissertation."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;SERGIO ARBOLEDA UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sergio Arboleda University is a prestigious academic institution where Paulo Hisao Moriya previously worked as a postdoctoral research associate."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;UNIVERSITY OF SÃO PAULO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of São Paulo is a renowned educational institution where Paulo Hisao Moriya is conducting his dissertation."&lt;SEP&gt;"University of São Paulo is the institution where Paulo Hisao Moriya earned his Ph.D. in Interdisciplinary Studies."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY STUDIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Studies is the field of Paulo Hisao Moriya's Ph.D. and a focus of his early career research."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;ADVANCES IN MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Advances in Materials Science and Engineering is a scientific paper co-authored by Paulo Hisao Moriya, affiliated with the University of Strathclyde."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;JOURNAL OF CULTURAL STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Cultural Studies is a scholarly journal where Paulo Hisao Moriya published 'The Impact of Digital Media on Cultural Identity'."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;TECHNOLOGY AND CULTURE: AN INTERDISCIPLINARY APPROACH&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Technology and Culture: An Interdisciplinary Approach is a book co-edited by Paulo Hisao Moriya and Dr. Maria Rodriguez."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a prominent scholar who co-edited the book 'Technology and Culture: An Interdisciplinary Approach' with Paulo Hisao Moriya."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;DIGITAL MEDIA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Digital Media is the subject of Paulo Hisao Moriya's study 'The Impact of Digital Media on Cultural Identity' published in the Journal of Cultural Studies."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;CULTURAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural Identity is the topic explored in Paulo Hisao Moriya's study 'The Impact of Digital Media on Cultural Identity' published in the Journal of Cultural Studies."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Materials Science and Engineering is the field of Paulo Hisao Moriya's current research and a focus of his work at the University of Strathclyde."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a characteristic of the University of Strathclyde, where Paulo Hisao Moriya contributes to its reputation."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;PUBLISHING STRATEGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publishing Strategy is the area of work at Sergio Arboleda University where Paulo Hisao Moriya contributed as a postdoctoral research associate."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;ACADEMIC JOURNALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Journals are part of the publishing strategy at Sergio Arboleda University, where Paulo Hisao Moriya contributed."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;BOOKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Books are part of the publishing strategy at Sergio Arboleda University, where Paulo Hisao Moriya contributed."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;PIVOTAL MOMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pivotal Moment is described as the association of Paulo Hisao Moriya with the University of Strathclyde, a significant point in his academic career."</data>
      <data key="d2">cb-0307</data>
    </node>
    <node id="&quot;DISSERTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dissertation is the academic work being conducted by Paulo Hisao Moriya at the University of São Paulo."</data>
      <data key="d2">cb-0307</data>
    </node>
