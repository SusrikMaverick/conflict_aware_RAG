  <graph edgedefault="undirected">
    <node id="&quot;THE MAN WHO NEVER WAS&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Man Who Never Was is a 1956 UK Second World War film, produced by André Hakim, directed by Ronald Neame, starring Clifton Webb, Gloria Grahame, and Robert Flemyng, and based on Lt. Cmdr. Ewen Montagu's book of the same name."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;ANDRÉ HAKIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"André Hakim is the producer of the 1956 film 'The Man Who Never Was'."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;RONALD NEAME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ronald Neame is the director of the 1956 film 'The Man Who Never Was'."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;CLIFTON WEBB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Clifton Webb is an actor in the 1956 film 'The Man Who Never Was'."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;GLORIA GRAHAME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gloria Grahame is an actor in the 1956 film 'The Man Who Never Was'."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;ROBERT FLEMYNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Flemyng is an actor in the 1956 film 'The Man Who Never Was'."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;LT. CMDR. EWEN MONTAGU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lt. Cmdr. Ewen Montagu is the author of the book 'The Man Who Never Was', which the 1956 film is based on."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;OPERATION MINCEMEAT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Operation Mincemeat is a 1943 British Intelligence plan to deceive the Axis powers into thinking the Allied invasion of Sicily would take place elsewhere in the Mediterranean."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;CANNES FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1956 Cannes Film Festival is where 'The Man Who Never Was' was entered."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;NIGEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nigel is mentioned in relation to 'The Man Who Never Was' but his full name and role are not specified."</data>
      <data key="d2">ramdocs-0017-989c4321a69b</data>
    </node>
    <node id="&quot;JOHN NEWLAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Newland is the writer of several TV episodes mentioned in Document 2."</data>
