  <graph edgedefault="undirected">
    <node id="&quot;IT'S RAINING (IRMA THOMAS SONG)&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"It's Raining (Irma Thomas song) is a soul/R&amp;B ballad, first recorded in November 1961 by Irma Thomas, and produced by Allen Toussaint. It has emotional ties to Louisiana and was released on a New Orleans-based record label."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;IRMA THOMAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Irma Thomas is a singer known for her soul/R&amp;B ballads, including 'It's Raining', and is often referred to as the 'Soul Queen of New Orleans'."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;ALLEN TOUSSAINT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Allen Toussaint is a producer who produced 'It's Raining' and is known for his work in New Orleans music scene."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;RON RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ron Records is the initial record label for Irma Thomas before she left for Minit Records."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;MINIT RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Minit Records is the record label for Irma Thomas after she left Ron Records."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;NEW ORLEANS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Orleans is the city where the song 'It's Raining' and the artists associated with it are based."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisiana is the state where the song 'It's Raining' and the artists associated with it are from."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;IT'S RAINING (RAIN SONG)&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"It's Raining (Rain song) is a Korean language song by Rain, the first single from his third album, and was released in September 2004."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;RAIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rain is a Korean R&amp;B singer known for his international success, including the song 'It's Raining' which helped launch his career in Asia."</data>
      <data key="d2">ramdocs-0280-7683f713116d</data>
    </node>
    <node id="&quot;KOREAN R&amp;B&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Korean R&amp;B is the genre of music associated with Rain and his song 'It's Raining'."</data>
