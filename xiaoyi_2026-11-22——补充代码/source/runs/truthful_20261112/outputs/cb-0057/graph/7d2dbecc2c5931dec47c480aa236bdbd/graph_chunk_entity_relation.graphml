    <node id="&quot;ELIANA AMORIM DE SOUZA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eliana Amorim de Souza is a distinguished scholar known for her meticulous and innovative thinking, with a strong affiliation to the Federal University of Bahia."</data>
      <data key="d2">cb-0057</data>
    </node>
    <node id="&quot;FEDERAL UNIVERSITY OF BAHIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Federal University of Bahia is a prestigious institution where Eliana Amorim de Souza has built her career, published research, and participated in academic events."</data>
      <data key="d2">cb-0057</data>
    </node>
    <node id="&quot;SALVADOR, BAHIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salvador, Bahia is a vibrant city where Eliana Amorim de Souza is based and conducts her research."</data>
