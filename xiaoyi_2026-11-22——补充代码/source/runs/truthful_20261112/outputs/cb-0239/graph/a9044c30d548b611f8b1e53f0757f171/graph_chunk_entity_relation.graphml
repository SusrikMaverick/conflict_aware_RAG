<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HAMRA SOCKEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hamra socken is a traditional administrative unit in Gotland, Sweden, facing challenges due to population growth and the need for more efficient governance."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;GOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gotland is an island in Sweden known for its rich Viking heritage and stunning landscapes."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sweden is a country where the transformation from socken to landskommun is taking place, particularly in Gotland."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;BALTIC SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Baltic Sea is mentioned as the setting for the sun dipping, casting a warm orange glow over the rolling hills of Gotland."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;ROLLING HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rolling hills are part of the landscape of Gotland, providing a scenic backdrop for the events in the text."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;ANCIENT STONE CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"An ancient stone church stands in the town square of Hamra socken, serving as a witness to the whispers and worries of the villagers."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;ANDERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anders is the elderly pastor of Hamra socken, living his entire life in the area and feeling a sense of unease about the changes happening."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;KAITO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kaito is a traveler from a far-off land, appearing in the town square and speaking of a place called Sotogahama, Japan."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;SOTOGAHAMA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sotogahama is a town in Aomori prefecture, Japan, described by Kaito as a place of harmony with nature and snow-capped peaks."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;AOMORI PREFECTURE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Aomori prefecture is a region in Japan where Sotogahama is located, known for its natural beauty and cultural heritage."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;GOTLAND COUNTY COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gotland County Council is an organization that held discussions on the implementation of the new landskommun system in 1953."&lt;SEP&gt;"Gotland County Council is mentioned in the second document, discussing the implementation of the new landskommun system."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;SWEDISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Swedish government is responsible for the introduction of the 'Lag om kommunalstyrelse' and the transformation from socken to landskommun."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;SOCKEN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Socken is an administrative unit in Sweden, facing challenges and eventually being replaced by the landskommun system."&lt;SEP&gt;"Socken is an administrative unit that was abolished as part of the new landskommun system."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;LANDSKOMMUN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Landskommun is a modern administrative unit introduced to replace the outdated socken system, designed to be more efficient and effective."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;1952&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1952 marks the year when the Swedish government passed the 'Lag om kommunalstyrelse', paving the way for the transformation from socken to landskommun."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;1953&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1953 is the year when the Gotland County Council discussed the implementation of the new landskommun system."&lt;SEP&gt;"1953 is the year when the implementation of the new landskommun system began, as evidenced by the minutes of the Gotland County Council."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;VILLAGERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Villagers are the inhabitants of Hamra socken, experiencing a sense of unease and listening to Kaito's stories."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;TALL, SLENDER MAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A tall, slender man with piercing green eyes and jet-black hair that falls to his shoulders, described as a traveler from a far-off land."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;TRAVELER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Kaito is referred to as a traveler, implying he is not from Gotland or Hamra socken."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;ANCIENT STONES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancient stones refer to the materials used in the construction of the ancient stone church in Hamra socken."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;WORN STONE FLOOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Worn stone floor is part of the ancient stone church in Hamra socken, where Anders often sits in contemplation."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;SNOW-CAPPED PEAKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Snow-capped peaks are part of the description of Sotogahama, Japan, painted by Kaito."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;HAMRA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hamra is a modern landskommun that was established, with evidence of its transformation found in archival records."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;LANDSKOMMUN SYSTEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Landskommun system is the administrative system implemented in Hamra, discussed by the Gotland County Council in 1953."</data>
      <data key="d2">cb-0239</data>
    </node>
    <node id="&quot;ARCHIVAL RECORDS&quot;">
      <data key="d0">"RESOURCE"</data>
      <data key="d1">"Archival records are documents that provide evidence of the transformation and implementation of the new landskommun system in Hamra."</data>
      <data key="d2">cb-0239</data>
    </node>
    <edge source="&quot;HAMRA SOCKEN&quot;" target="&quot;BALTIC SEA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The sun dipping into the Baltic Sea casts a warm orange glow over the rolling hills of Gotland, setting the scene for events in Hamra socken."</data>
      <data key="d5">"natural setting, ambiance"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;HAMRA SOCKEN&quot;" target="&quot;ANDERS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Anders, the elderly pastor of Hamra socken, feels a sense of unease about the changes happening in the area."</data>
      <data key="d5">"unease, leadership"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;GOTLAND&quot;" target="&quot;SWEDEN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Gotland is an island in Sweden, where the transformation from socken to landskommun is taking place." "</data>
      <data key="d5">"island, country"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;ANDERS&quot;" target="&quot;KAITO&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Anders watches Kaito with a keen eye, sensing that there is more to this stranger than meets the eye."</data>
      <data key="d5">"observation, intuition"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;KAITO&quot;" target="&quot;SOTOGAHAMA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Kaito speaks of Sotogahama, a town in Aomori prefecture, Japan, painting vivid pictures of its natural beauty and cultural heritage."</data>
      <data key="d5">"description, inspiration"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;GOTLAND COUNTY COUNCIL&quot;" target="&quot;HAMRA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Hamra's establishment is documented in the discussions held by the Gotland County Council in 1953."</data>
      <data key="d5">"establishment, documentation"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;GOTLAND COUNTY COUNCIL&quot;" target="&quot;1953&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Gotland County Council held discussions on the new landskommun system in 1953."</data>
      <data key="d5">"discussion, implementation"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;GOTLAND COUNTY COUNCIL&quot;" target="&quot;LANDSKOMMUN SYSTEM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Gotland County Council discussed the implementation of the Landskommun system in 1953."</data>
      <data key="d5">"implementation, discussion"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;GOTLAND COUNTY COUNCIL&quot;" target="&quot;ARCHIVAL RECORDS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The archival records document the discussions and implementation of the new landskommun system by the Gotland County Council."</data>
      <data key="d5">"documentation, record keeping"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;SOCKEN&quot;" target="&quot;LANDSKOMMUN SYSTEM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Landskommun system replaced the socken system as an administrative unit."</data>
      <data key="d5">"replacement, system"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;HAMRA&quot;" target="&quot;LANDSKOMMUN SYSTEM&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Landskommun system was implemented in Hamra, replacing the socken system."</data>
      <data key="d5">"replacement, implementation"</data>
      <data key="d6">cb-0239</data>
    </edge>
    <edge source="&quot;HAMRA&quot;" target="&quot;ARCHIVAL RECORDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The archival records provide evidence of the establishment of Hamra and the implementation of the new landskommun system."</data>
      <data key="d5">"evidence, documentation"</data>
      <data key="d6">cb-0239</data>
    </edge>
  </graph>
</graphml>
