  <graph edgedefault="undirected">
    <node id="&quot;DAILEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dailey graduated from the Law School in 1890 and held various political positions including assistant city attorney, state's attorney, and senator."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;PEORIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Peoria is a city where Dailey served as assistant city attorney and later became the county's state's attorney."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;PEORIA COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Peoria County is the location where Dailey served as the state's attorney."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;ILLINOIS HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dailey was elected to the Illinois House of Representatives and served a two-year term."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;ILLINOIS SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dailey was elected to the Illinois Senate and served ten consecutive two-year terms."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;CHICAGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago is mentioned in the context of the 1968 Democratic National Convention protests and the Siege of Chicago."&lt;SEP&gt;"Late in his life, Dailey moved to Chicago."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
    <node id="&quot;CLARA F. JOHNSTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dailey married Clara F. Johnston, a musician."</data>
      <data key="d2">ramdocs-0082-aecc414e9768</data>
    </node>
