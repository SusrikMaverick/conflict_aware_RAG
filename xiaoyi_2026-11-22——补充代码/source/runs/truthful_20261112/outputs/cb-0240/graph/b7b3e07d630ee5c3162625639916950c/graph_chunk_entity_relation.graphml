<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a researcher at the University of Auckland, investigating the works of David Hayman and discovering his collaborations with Leipzig University."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;UNIVERSITY OF AUCKLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Auckland is the institution where Dr. Sophia Patel is conducting her research."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;DAVID HAYMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Hayman is a renowned researcher in environmental science, known for his work on climate change and his collaborations with Leipzig University."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;LEIPZIG UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Leipzig University is an esteemed institution where David Hayman collaborated with Dr. Helga Müller on projects related to climate change."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;DR. HELGA MÜLLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Helga Müller is a prominent professor at Leipzig University, collaborating with David Hayman on climate change research."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;PALMERSTON NORTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Palmerston North is the location of Massey University, where David Hayman also worked as a researcher."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;MASSEY UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Massey University is a research-focused university in Palmerston North, New Zealand, where David Hayman contributed to the institution's research output."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;NEW ZEALAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand is the country where David Hayman has conducted research at Massey University and the University of Auckland."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United Kingdom is mentioned as a place where David Hayman has worked, though specific institutions are not named."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;LEIPZIG UNIVERSITY COLLABORATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Leipzig University Collaborations refers to the research partnership between David Hayman and Dr. Helga Müller."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;HAYMAN, D. - LEIPZIG UNIVERSITY COLLABORATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hayman, D. - Leipzig University Collaborations is the title of the folder Dr. Sophia Patel found in the University of Auckland's library."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;ELSTER RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Elster River is a river in Leipzig, Germany, mentioned by David Hayman in his letters to Dr. Helga Müller."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;VÖLKERSCHLACHTDENKMAL MONUMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Völkerschlachtdenkmal monument is a historical monument in Leipzig, Germany, mentioned by David Hayman in his letters to Dr. Helga Müller."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;THOMASKIRCHE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thomaskirche is a church in Leipzig, Germany, where David Hayman attended a performance of Bach's St. Matthew Passion."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;BACH'S ST. MATTHEW PASSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bach's St. Matthew Passion is a musical composition performed at the Thomaskirche in Leipzig, Germany, attended by David Hayman."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;GOSE BEER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Gose beer is a type of beer mentioned by David Hayman in his letters to Dr. Helga Müller, consumed during lively debates with her team."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate change is the primary subject of David Hayman's research and the focus of his collaborations with Leipzig University."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;EUROPEAN ECOSYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"European ecosystems are the specific area of study for the climate change project David Hayman collaborated on with Dr. Helga Müller."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;RUGGED COASTLINES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rugged coastlines are mentioned as part of David Hayman's research locations in New Zealand."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;RESEARCHER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Researcher is the professional role of David Hayman and Dr. Helga Müller in their respective institutions."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic excellence is highlighted as a focus of Massey University."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;STUDIES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Studies refer to the research activities conducted by David Hayman and his collaborators."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;PERFORMANCE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Performance is the activity of attending a musical concert, specifically Bach's St. Matthew Passion at the Thomaskirche."</data>
      <data key="d2">cb-0240</data>
    </node>
    <node id="&quot;DEBATES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Debates are the discussions and exchanges of ideas between David Hayman and Dr. Helga Müller's team."</data>
      <data key="d2">cb-0240</data>
    </node>
    <edge source="&quot;DR. SOPHIA PATEL&quot;" target="&quot;DAVID HAYMAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Sophia Patel discovers David Hayman's collaborations with Leipzig University while researching his works."</data>
      <data key="d5">"research collaboration, discovery"</data>
      <data key="d6">cb-0240</data>
    </edge>
    <edge source="&quot;DAVID HAYMAN&quot;" target="&quot;LEIPZIG UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"David Hayman collaborated with Leipzig University on climate change research projects."</data>
      <data key="d5">"research collaboration, scientific partnership"</data>
      <data key="d6">cb-0240</data>
    </edge>
    <edge source="&quot;DAVID HAYMAN&quot;" target="&quot;DR. HELGA MÜLLER&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"David Hayman and Dr. Helga Müller exchanged letters and collaborated on climate change research at Leipzig University."</data>
      <data key="d5">"correspondence, scientific collaboration"</data>
      <data key="d6">cb-0240</data>
    </edge>
    <edge source="&quot;DAVID HAYMAN&quot;" target="&quot;PALMERSTON NORTH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"David Hayman worked as a researcher at Massey University in Palmerston North, New Zealand."</data>
      <data key="d5">"workplace, research position"</data>
      <data key="d6">cb-0240</data>
    </edge>
    <edge source="&quot;DAVID HAYMAN&quot;" target="&quot;MASSEY UNIVERSITY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"David Hayman contributed to Massey University's research output and collaborated with other academics there."</data>
      <data key="d5">"research contribution, academic collaboration"</data>
      <data key="d6">cb-0240</data>
    </edge>
    <edge source="&quot;DAVID HAYMAN&quot;" target="&quot;NEW ZEALAND&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"David Hayman has conducted research at Massey University and the University of Auckland in New Zealand."</data>
      <data key="d5">"research location, academic career"</data>
      <data key="d6">cb-0240</data>
    </edge>
  </graph>
