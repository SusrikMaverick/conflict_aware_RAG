  <graph edgedefault="undirected">
    <node id="&quot;MEIR PORUSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Meir Porush is an Israeli politician who served as a member of the Knesset for the ultra-Orthodox Agudat Yisrael faction of United Torah Judaism between 1996 and 2011, and again from 2013 until 2016. He is currently the Deputy Minister of Education. He was born in Jerusalem and educated in a yeshiva. He supports further Haredi participation in military service and lives in Jerusalem with his wife and twelve children."</data>
      <data key="d2">ramdocs-0364-395b1e3fa824</data>
    </node>
    <node id="&quot;MENACHEM PORUSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Menachem Porush was an Israeli politician who served as a member of the Knesset for Agudat Yisrael and its alliances between 1959 and 1975, and again from 1977 until 1994. He was a seventh-generation Jerusalemite, born in Jerusalem in 1916 to Rabbi Moshe Glickman-Porush. He studied at the Etz Chaim Yeshiva and was expelled in 1932 for unseemly conduct at a Purim party. He passed away in 2010."</data>
      <data key="d2">ramdocs-0364-395b1e3fa824</data>
    </node>
    <node id="&quot;AGUDAT YISRAEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Agudat Yisrael is an ultra-Orthodox political party in Israel."</data>
      <data key="d2">ramdocs-0364-395b1e3fa824</data>
    </node>
    <node id="&quot;UNITED TORAH JUDAISM&quot;">
      <data key="d0">"ORGANIZATION"</data>
