<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CAREL DE HASETH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Carel de Haseth is a Dutch politician known for his dedication to international cooperation and cultural preservation, particularly in Curaçao."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;GARE DU NORD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gare du Nord is a train station in Paris, where Carel de Haseth arrives, symbolizing the start of a significant journey."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Élysée Palace is the official residence of the President of France, where Carel de Haseth is recognized for his dedication to international cooperation."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;SEINE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seine River flows through Paris, representing the city's historical and cultural significance."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;LATIN QUARTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Latin Quarter is a neighborhood in Paris known for its intellectual and cultural atmosphere, contrasting with Carel de Haseth's current purpose."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;THE HAGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Hague is the capital of the Netherlands, where Carel de Haseth began his political career."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brussels is a city where Carel de Haseth worked as a diplomat, known for its political significance."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;FRENCH HEROES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Portraits of French heroes adorn the halls of the Élysée Palace, symbolizing the values and history of France."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;PRESIDENT OF FRANCE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The President of France is the head of state, who confers the highest honor upon Carel de Haseth."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;KNIGHT OF THE NATIONAL ORDER OF MERIT&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Knight of the National Order of Merit is the highest honor conferred by the President of France, recognizing dedication to international cooperation."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;CURAÇAO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Curaçao is an island where Carel de Haseth promoted and preserved the rich cultural heritage, known for its unique blend of traditions and customs."&lt;SEP&gt;"Curaçao is the island where the cultural prize is awarded and where De Haseth made significant contributions."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;COLA DEBROT AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Cola Debrot Award is a prestigious prize named after a renowned Curaçaoan writer and poet, recognizing significant contributions to the island's cultural development."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;AFRO-CARIBBEAN MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Afro-Caribbean Music is a cultural element of Curaçao, reflecting its diverse heritage."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;CULTURAL AMBASSADOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Cultural Ambassador is a role that Carel de Haseth fulfilled in Curaçao, promoting and preserving the island's cultural heritage."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;CURAÇAO CULTURAL CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Curaçao Cultural Center is an institution established by Carel de Haseth, serving as a hub for artistic expression and cultural exchange."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;COLA DEBROT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cola Debrot is a renowned Curaçaoan writer and poet after whom the prize is named."&lt;SEP&gt;"Cola Debrot is a renowned Curaçaoan writer and poet, after whom the Cola Debrot Award is named."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;EIFFEL TOWER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eiffel Tower is a symbol of French ingenuity and innovation, standing as a backdrop during Carel de Haseth's ceremony."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Netherlands is the country where Carel de Haseth was born and raised, and where he began his political career."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;INTERNATIONAL COOPERATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International Cooperation is the focus of Carel de Haseth's work, both in the Netherlands and internationally."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;DUTCH COLONY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Curaçao was a Dutch colony, influencing its cultural and historical development."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;LATIN AMERICAN INFLUENCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Latin American influences are part of Curaçao's cultural heritage, reflecting its history as a Dutch colony."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;AFRICAN INFLUENCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"African influences are part of Curaçao's cultural heritage, reflecting its history as a Dutch colony."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;EUROPEAN INFLUENCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"European influences are part of Curaçao's cultural heritage, reflecting its history as a Dutch colony."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;1995&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"1995 marks the year when the esteemed prize was awarded to De Haseth."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;DE HASETH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"De Haseth is the individual who received the award for significant contributions to Curaçao's cultural development."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;CULTURAL DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cultural Development refers to the efforts made to promote and preserve Curaçao's cultural identity and heritage."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;ESTEEMED PRIZE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Esteemed Prize is a recognition given to individuals for their contributions to Curaçao's cultural development."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;TIRELESS EFFORTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tireless Efforts refer to the continuous and dedicated work put in by De Haseth to promote Curaçao's cultural identity."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;RICH HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rich Heritage refers to the historical and cultural wealth that De Haseth is committed to preserving."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;PROMOTING CULTURAL IDENTITY&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Promoting Cultural Identity is the ongoing effort by De Haseth to highlight and support Curaçao's cultural traditions."</data>
      <data key="d2">cb-0403</data>
    </node>
    <node id="&quot;PRESERVING HERITAGE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Preserving Heritage is the commitment by De Haseth to safeguard Curaçao's cultural legacy for future generations."</data>
      <data key="d2">cb-0403</data>
    </node>
    <edge source="&quot;CAREL DE HASETH&quot;" target="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Carel de Haseth is recognized for his dedication to international cooperation at the Élysée Palace, receiving the highest honor from the President of France."</data>
      <data key="d5">"recognition, diplomatic achievement"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;CAREL DE HASETH&quot;" target="&quot;GARE DU NORD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Carel de Haseth arrives at Gare du Nord, marking the beginning of his journey to receive recognition in Paris."</data>
      <data key="d5">"journey start, recognition"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;CAREL DE HASETH&quot;" target="&quot;THE HAGUE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Carel de Haseth began his political career in The Hague, where he was driven by a passion for building bridges between nations."</data>
      <data key="d5">"career start, passion for diplomacy"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;CAREL DE HASETH&quot;" target="&quot;BRUSSELS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Carel de Haseth worked as a diplomat in Brussels, earning a reputation as a shrewd and principled diplomat."</data>
      <data key="d5">"diplomatic career, reputation"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;CURAÇAO&quot;" target="&quot;CULTURAL DEVELOPMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cultural Development is taking place in Curaçao, where the prize is awarded and De Haseth made contributions."</data>
      <data key="d5">"local focus, preservation"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;COLA DEBROT&quot;" target="&quot;CULTURAL DEVELOPMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cola Debrot is associated with the Cultural Development of Curaçao as the prize is named after him."</data>
      <data key="d5">"honored contribution, inspiration"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;DE HASETH&quot;" target="&quot;CULTURAL DEVELOPMENT&quot;">
      <data key="d3">19.0</data>
      <data key="d4">"De Haseth received the award for his significant contributions to the Cultural Development of Curaçao."&lt;SEP&gt;"De Haseth's efforts contribute to the overall Cultural Development of Curaçao, as recognized by the award."</data>
      <data key="d5">"contribution, recognition"&lt;SEP&gt;"recognition, promotion"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;DE HASETH&quot;" target="&quot;TIRELESS EFFORTS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"De Haseth is recognized for his Tireless Efforts in promoting Curaçao's cultural identity."</data>
      <data key="d5">"dedication, recognition"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;DE HASETH&quot;" target="&quot;PRESERVING HERITAGE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"De Haseth is committed to Preserving Heritage, ensuring Curaçao's rich cultural legacy is maintained."</data>
      <data key="d5">"commitment, preservation"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;DE HASETH&quot;" target="&quot;PROMOTING CULTURAL IDENTITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"De Haseth is actively involved in Promoting Cultural Identity, contributing significantly to Curaçao's cultural development."</data>
      <data key="d5">"promotion, cultural advocacy"</data>
      <data key="d6">cb-0403</data>
    </edge>
    <edge source="&quot;CULTURAL DEVELOPMENT&quot;" target="&quot;RICH HERITAGE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cultural Development involves Preserving Rich Heritage, highlighting the importance of maintaining Curaçao's cultural legacy."</data>
      <data key="d5">"cultural preservation, heritage"</data>
      <data key="d6">cb-0403</data>
    </edge>
  </graph>
</graphml>
