  <graph edgedefault="undirected">
    <node id="&quot;MASSACHUSETTS INSTITUTE OF TECHNOLOGY (MIT)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Massachusetts Institute of Technology (MIT) is a prestigious private university founded in 1861, known for its innovation and excellence, attracting brilliant minds from around the world."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;VASAN VENUGOPALAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vasan Venugopalan is a researcher with an insatiable curiosity and passion for discovery, who attended MIT and contributed to groundbreaking research projects."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;CAMBRIDGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cambridge is a city in Massachusetts, known for its intellectual prowess and home to MIT."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is a renowned expert in the field of quantum optics, teaching at Arizona State University and inspiring Vasan Venugopalan with her words of encouragement."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;ARIZONA STATE UNIVERSITY (ASU)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Arizona State University (ASU) is a public research university located in Tempe, Arizona, known for its strong program in optical sciences and state-of-the-art facilities."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;TEMPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tempe is a city in Arizona, home to ASU and known for its vibrant campus atmosphere."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;JAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jake is a friend of Vasan Venugopalan, who invites him to a study group focused on Fourier transforms."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;CAMBRIDGE, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cambridge, Massachusetts is a city known for its intellectual prowess and home to MIT."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;INTELLECTUAL PROWESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual prowess refers to the city's reputation for fostering intellectual growth and innovation."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a core value of MIT and the city of Cambridge, driving academic and scientific advancements."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Excellence is a hallmark of MIT and the city of Cambridge, attracting brilliant minds from around the world."</data>
      <data key="d2">cb-0373</data>
    </node>
    <node id="&quot;BRILLIANT MINDS&quot;">
      <data key="d0">"CONCEPT"</data>
