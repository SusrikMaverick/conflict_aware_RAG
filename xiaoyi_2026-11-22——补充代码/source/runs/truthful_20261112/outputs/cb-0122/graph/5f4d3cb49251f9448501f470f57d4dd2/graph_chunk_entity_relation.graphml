  <graph edgedefault="undirected">
    <node id="&quot;DYLAN VAN ASSCHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dylan Van Assche is a PhD student and Semantic Web researcher, known for his contributions to artificial intelligence and his affiliations with universities."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;GHENT UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ghent University is a Dutch-speaking university in Belgium where Dylan Van Assche has worked as a researcher."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;HUMBOLDT UNIVERSITY OF BERLIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Humboldt University of Berlin is a German university where Dylan Van Assche pursued his PhD and conducted research."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;TECHNICAL UNIVERSITY OF BERLIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Technical University of Berlin is the institution where Dylan Van Assche completed his undergraduate degree."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;JOURNAL OF WEB SEMANTICS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Web Semantics is a scientific journal where Dylan Van Assche has published research papers."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE (ICAI)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Conference on Artificial Intelligence (ICAI) is an academic conference where Dylan Van Assche presented a paper."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Rodriguez is a renowned expert in the field of artificial intelligence who supervised Dylan Van Assche's PhD research at Humboldt University of Berlin."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;ONTOLOGY-BASED INFORMATION RETRIEVAL SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ontology-Based Information Retrieval Systems is a research topic explored by Dylan Van Assche and colleagues in a study published in the Journal of Web Semantics."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;ONTOLOGY-BASED DATA INTEGRATION FOR INDUSTRIAL APPLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ontology-Based Data Integration for Industrial Applications is a research topic explored by Dylan Van Assche and colleagues in a study published in the Proceedings of the 18th International Semantic Web Conference."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;ARTIFICIAL INTELLIGENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artificial Intelligence is a field of research that Dylan Van Assche focuses on, particularly in relation to Semantic Web technologies."</data>
      <data key="d2">cb-0122</data>
    </node>
    <node id="&quot;SEMANTIC WEB TECHNOLOGIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Semantic Web Technologies are the primary focus of Dylan Van Assche's research, including both theoretical and applied aspects."</data>
      <data key="d2">cb-0122</data>
    </node>
