<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;THE WALKING DEAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Walking Dead is an American post-apocalyptic horror television series produced by AMC."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;AMC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AMC is the production company behind The Walking Dead, an American post-apocalyptic horror television series."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The eleventh and final season of The Walking Dead is a specific event in the series' timeline."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;AUGUST 2, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 2, 2020 is the premiere date of the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;AUGUST 22, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 22, 2021 is another premiere date mentioned for the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;NOV 14, 2022&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Nov 14, 2022 is the date referenced in relation to the release of season 11, episode 24."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD, EPISODE 24&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Episode 24 of the eleventh and final season of The Walking Dead is a specific event in the series' timeline."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;6:00 PM PACIFIC/9:00 PM EASTERN&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"6:00 PM Pacific/9:00 PM Eastern is the scheduled airtime for episode 24 of the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;SUNDAY&quot;">
      <data key="d0">"DAY"</data>
      <data key="d1">"Sunday is the day of the week on which episode 24 of the eleventh and final season of The Walking Dead airs."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;PACIFIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pacific refers to the time zone for the scheduled airtime of episode 24 of the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;EASTERN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eastern refers to the time zone for the scheduled airtime of episode 24 of the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;EPISODE 24&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Episode 24 is a specific episode within the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;SEASON 11&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Season 11 is the eleventh and final season of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;RELEASE DATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Release date refers to the date when an episode or season becomes available for viewing."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;AIRTIME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Airtime refers to the scheduled time when an episode is broadcasted."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;BROADCAST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Broadcast refers to the act of transmitting the episode to viewers."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;VIEWERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Viewers are the audience who watch the episodes of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;TELEVISION SERIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Television series refers to the ongoing series of episodes that make up The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;POST-APOCALYPTIC HORROR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Post-apocalyptic horror describes the genre of The Walking Dead."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;HORROR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Horror is a genre that focuses on fear and suspense, often involving supernatural or terrifying elements."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;TELEVISION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Television is the medium through which The Walking Dead is broadcasted."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;SERIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Series refers to a sequence of episodes that tell a continuous story."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;FINAL SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Final season indicates the concluding season of a series."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;PREMIERE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Premiere is the first broadcast of a new season or episode."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;INTERVIEWS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Interviews are conversations or discussions that may occur around the series or its production."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;NEWS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"News refers to any updates or announcements related to the series."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <node id="&quot;SCHEDULE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Schedule refers to the planned times for broadcasts and releases."</data>
      <data key="d2">rgb-0034</data>
    </node>
    <edge source="&quot;AMC&quot;" target="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The eleventh and final season of The Walking Dead is produced by AMC, the production company behind the series."</data>
      <data key="d5">"production, series"</data>
      <data key="d6">rgb-0034</data>
    </edge>
    <edge source="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD&quot;" target="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD, EPISODE 24&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Episode 24 is part of the eleventh and final season of The Walking Dead."</data>
      <data key="d5">"episode, season"</data>
      <data key="d6">rgb-0034</data>
    </edge>
    <edge source="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD, EPISODE 24&quot;" target="&quot;6:00 PM PACIFIC/9:00 PM EASTERN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Episode 24 airs at 6:00 PM Pacific/9:00 PM Eastern on Sunday."</data>
      <data key="d5">"airtime, schedule"</data>
      <data key="d6">rgb-0034</data>
    </edge>
    <edge source="&quot;THE ELEVENTH AND FINAL SEASON OF THE WALKING DEAD, EPISODE 24&quot;" target="&quot;SUNDAY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Episode 24 airs on Sunday, the specified day of the week."</data>
      <data key="d5">"airtime, schedule"</data>
      <data key="d6">rgb-0034</data>
    </edge>
  </graph>
