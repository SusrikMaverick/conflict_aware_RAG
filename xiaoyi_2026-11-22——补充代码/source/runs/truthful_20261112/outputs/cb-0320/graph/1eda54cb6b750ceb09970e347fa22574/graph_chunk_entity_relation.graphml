  <graph edgedefault="undirected">
    <node id="&quot;SCOTT TUNBRIDGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scott Tunbridge is a local soccer star who has been making waves with the North Eastern MetroStars in Adelaide, Australia, and is also a professional soccer player for A.S.D. Ponziana in Italy."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;NORTH EASTERN METROSTARS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"North Eastern MetroStars is a soccer team based in Adelaide, Australia, known for developing local talent and having Scott Tunbridge as a key player."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;MICHAEL BARNETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Barnett is the coach of the North Eastern MetroStars and has praised Scott Tunbridge's contributions to the team."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;EMILY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily Wilson is a fan of the North Eastern MetroStars and has expressed her appreciation for Scott Tunbridge's performance."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;A.S.D. PONZIANA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A.S.D. Ponziana is an Italian association football club based in Trieste, where Scott Tunbridge currently plays."&lt;SEP&gt;"A.S.D. Ponziana is an organization mentioned as the source of the quote, likely a sports club or team."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;SYDNEY FC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sydney FC is an Australian soccer club where Scott Tunbridge started his professional career and played until 2010."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;LA GAZZETTA DELLO SPORT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Gazzetta dello Sport is an Italian sports newspaper that has interviewed Scott Tunbridge about his experience in Italy."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;GIOVANNI ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni Rossi is the president of A.S.D. Ponziana and has praised Scott Tunbridge's work ethic and dedication to the team."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;ADELAIDE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Adelaide is the city in South Australia where the North Eastern MetroStars are based and where Scott Tunbridge has been playing for the MetroStars."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;SYDNEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney is the city in Australia where Scott Tunbridge was born and where he started his soccer career with Sydney FC."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;SERIE C&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Serie C is the third tier of Italian football where A.S.D. Ponziana plays and where Scott Tunbridge has been performing well."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;NATIONAL PREMIER LEAGUES SOUTH AUSTRALIA (NPL SA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NPL SA is the governing body for soccer in South Australia and has provided statistics on Scott Tunbridge's performance for the North Eastern MetroStars."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;1994&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1994 is the year the North Eastern MetroStars were founded, marking the beginning of their rich history in Adelaide's soccer community."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;1992&quot;">
      <data key="d0">"EVENT"</data>
