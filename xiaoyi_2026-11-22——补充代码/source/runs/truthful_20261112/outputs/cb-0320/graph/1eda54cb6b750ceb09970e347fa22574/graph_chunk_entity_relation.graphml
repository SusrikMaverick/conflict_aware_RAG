      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2010 is the year Scott Tunbridge made his professional debut with Sydney FC, marking the beginning of his professional soccer career."</data>
      <data key="d2">cb-0320</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
