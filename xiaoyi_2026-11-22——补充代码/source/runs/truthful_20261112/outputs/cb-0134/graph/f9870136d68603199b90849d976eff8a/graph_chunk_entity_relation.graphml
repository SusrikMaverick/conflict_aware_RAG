  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GHENADIE SÎRBU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ghenadie Sîrbu is a renowned researcher known for his work on renewable energy, recognized for his contributions to the European Commission's energy policy."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;EUROPEAN COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Commission is a leading institution in shaping EU energy policy, particularly in the area of renewable energy, and has recognized Ghenadie Sîrbu's work."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;MOLDOVA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Moldova State University is an institution where Ghenadie Sîrbu worked as a researcher and published research papers."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brussels is the capital city of Belgium and the headquarters of the European Commission."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;RENEWABLE ENERGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Renewable Energy refers to the focus of Ghenadie Sîrbu's research, specifically in integrating solar and wind power into the European grid."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;EUROPEAN PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Parliament awarded Ghenadie Sîrbu the 'EU Researcher of the Year' award for his contributions to renewable energy."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;URSULA VON DER LEYEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ursula von der Leyen is the President of the European Commission and has praised Ghenadie Sîrbu's work on renewable energy."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;DR. MARIA DA GRAÇA CARVALHO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria da Graça Carvalho is a leading energy expert and member of the European Parliament who has recognized the impact of Ghenadie Sîrbu's research."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;2050&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2050 is the year by which the EU aims to achieve carbon neutrality, a goal influenced by Ghenadie Sîrbu's research."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2020 is the year when the EU saw a significant decrease in greenhouse gas emissions due to Ghenadie Sîrbu's research."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;ENERGY EFFICIENCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Energy Efficiency is a key outcome of Ghenadie Sîrbu's research, with his team achieving a 25% increase in energy efficiency through advanced solar panels."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;SOLAR PANELS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Solar Panels are a specific technology developed by Ghenadie Sîrbu's team to enhance energy efficiency."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;WIND POWER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Wind Power is another technology integrated into the European grid by Ghenadie Sîrbu's research."</data>
      <data key="d2">cb-0134</data>
    </node>
    <node id="&quot;FOSSIL FUELS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fossil Fuels refer to the reduction in reliance on these sources due to Ghenadie Sîrbu's work on renewable energy."</data>
