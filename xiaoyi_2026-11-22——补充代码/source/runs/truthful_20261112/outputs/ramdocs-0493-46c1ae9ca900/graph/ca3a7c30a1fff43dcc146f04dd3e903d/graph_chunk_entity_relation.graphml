    </node>
    <node id="&quot;FULL ORCHESTRA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A full orchestra provided background music for the 1940 film 'Let George Do It (US: 'To Hell With Hitler')', initially used by Eddie Dunstedter."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;RADIO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Radio is mentioned as a medium for both the 1940 film 'Let George Do It (US: 'To Hell With Hitler)' and the radio drama series 'Let George Do It' from 1946 to 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;TELEVISION&quot;">
