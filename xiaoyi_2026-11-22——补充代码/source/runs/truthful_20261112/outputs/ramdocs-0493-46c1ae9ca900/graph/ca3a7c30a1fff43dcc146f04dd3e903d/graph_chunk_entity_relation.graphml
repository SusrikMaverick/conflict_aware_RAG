<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LET GEORGE DO IT (US: 'TO HELL WITH HITLER')&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Let George Do It (US: 'To Hell With Hitler') is a 1940 British black-and-white comedy musical war film directed by Marcel Varnel and starring George Formby, dealing with the Second World War."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;GEORGE FORMBY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Formby is the star of the 1940 film 'Let George Do It (US: 'To Hell With Hitler')', known for his comedic performances."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;MICHAEL BALCON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Balcon is the producer of the 1940 film 'Let George Do It (US: 'To Hell With Hitler')', associated with Associated Talking Pictures and Ealing Studios."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;ASSOCIATED TALKING PICTURES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Associated Talking Pictures is the production company behind the 1940 film 'Let George Do It (US: 'To Hell With Hitler')'."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;EALING STUDIOS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ealing Studios is the successor to Associated Talking Pictures and also produced the 1940 film 'Let George Do It (US: 'To Hell With Hitler')'."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;ABFD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ABFD is the distributor of the 1940 film 'Let George Do It (US: 'To Hell With Hitler')' in the UK."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;CHARLIE CHAPLIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charlie Chaplin is mentioned in relation to spying on the Germans in Bergen, Norway, during wartime."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;ADOLF HITLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adolf Hitler is referenced in the context of Charlie Chaplin's espionage mission in Bergen, Norway."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;BERGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bergen is a city in Norway where a British dance band plays and a ukulele player is found dead during a radio broadcast."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;SECOND WORLD WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Second World War is the historical context for both the 1940 film 'Let George Do It (US: 'To Hell With Hitler')' and Charlie Chaplin's espionage mission."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;GEORGE WALLACE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Wallace is the star of the 1938 comedy 'Let George Do It', a stage comedian known for his work in vaudeville."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;KEN G. HALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ken G. Hall is the director of the 1938 comedy 'Let George Do It', producing it for Cinesound Productions."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;CINESOUND PRODUCTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cinesound Productions is the production company behind the 1938 comedy 'Let George Do It', featuring George Wallace."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;MOLLY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Molly is the love interest of Joe Blake, a stage hand in a vaudeville theatre, in the plot of the 1938 comedy 'Let George Do It' starring George Wallace."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;EDDIE DUNSTEDTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eddie Dunstedter provided the background music for the 1940 film 'Let George Do It (US: 'To Hell With Hitler')', initially with a full orchestra."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;OWEN AND PAULINE VINSON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Owen and Pauline Vinson produced the radio drama series 'Let George Do It' from 1946 to 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;BOB BAILEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bob Bailey starred as private investigator George Valentine in the radio drama series 'Let George Do It' from 1946 to 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;OLAN SOULE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Olan Soule voiced the role of George Valentine in the radio drama series 'Let George Do It' in 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;DAVID VICTOR AND JACKSON GILLIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Victor and Jackson Gillis wrote the scripts for the radio drama series 'Let George Do It' from 1946 to 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;FRANCES ROBINSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frances Robinson played the role of a fine actress in the radio drama series 'Let George Do It', portraying a frustrated romantic."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;LET GEORGE DO IT (1938 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Let George Do It (1938 film) is a 1938 comedy starring George Wallace, produced by Ken G. Hall at Cinesound Productions."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;GONE TO THE DOGS (1939 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Gone to the Dogs (1939 film) is another film starring George Wallace, produced by Ken G. Hall at Cinesound Productions."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;HARRON68&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harron68 is a reviewer who provided feedback on the radio drama series 'Let George Do It' from 2015."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;JOHNNY DOLLAR&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Johnny Dollar is a character in a radio series, mentioned in comparison to the radio drama series 'Let George Do It' by Harron68."&lt;SEP&gt;"Johnny Dollar is a radio series that Bob Bailey starred in after 'Let George Do It', mentioned in comparison to his role in 'Let George Do It' by Harron68."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;PRIVATE INVESTIGATOR GEORGE VALENTINE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Private Investigator George Valentine is a role played by Bob Bailey in the radio drama series 'Let George Do It' from 1946 to 1954."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
    <node id="&quot;GEORGE VALENTINE&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"George Valentine is a character in the radio drama series 'Let George Do It', played by Bob Bailey."</data>
      <data key="d2">ramdocs-0493-46c1ae9ca900</data>
    </node>
