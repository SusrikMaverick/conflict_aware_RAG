  <graph edgedefault="undirected">
    <node id="&quot;1ST ARRONDISSEMENT OF LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1st arrondissement of Lyon is one of the nine arrondissements of the City of Lyon, located below the hill of Croix-Rousse and on the north part of the Presqu'île formed by the Saône and the Rhône."</data>
      <data key="d2">ramdocs-0196-b3e656930da0</data>
    </node>
    <node id="&quot;FRANC-LYONNAIS&quot;">
      <data key="d2">ramdocs-0196-b3e656930da0</data>
      <data key="d1">"The slopes of Croix-Rousse, which were part of Franc-Lyonnais, were integrated into the city of Lyon in 1512."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;SAÔNE&quot;">
      <data key="d2">ramdocs-0196-b3e656930da0</data>
      <data key="d1">"The 1st arrondissement of Lyon is located on the north part of the Presqu'île formed by the Saône and the Rhône, with the Saône being one of the two rivers in Lyon."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;RHÔNE&quot;">
