      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;1ST ARRONDISSEMENT OF PARIS&quot;">
      <data key="d2">ramdocs-0196-b3e656930da0</data>
      <data key="d1">"The 1st arrondissement of Paris includes the west end of the Île de la Cité, which is historically the heart of the city of Lutetia."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
