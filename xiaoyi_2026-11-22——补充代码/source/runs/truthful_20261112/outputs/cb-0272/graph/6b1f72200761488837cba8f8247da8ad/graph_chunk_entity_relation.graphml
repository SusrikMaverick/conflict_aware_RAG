  <graph edgedefault="undirected">
    <node id="&quot;ÖZKAN KOÇTÜRK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Özkan Koçtürk is a Turkish-German footballer known for his vision and passing range, with experience playing for clubs in Germany and Turkey, and representing Turkey at the U-21 level."</data>
      <data key="d2">cb-0272</data>
    </node>
    <node id="&quot;FK CEMENT BEOČIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FK Cement Beočin is a Serbian football club founded in 1916, known for its rich history and recent rise in the Serbian First League."</data>
      <data key="d2">cb-0272</data>
    </node>
    <node id="&quot;BELGRADE, SERBIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgrade is the capital city of Serbia, where the news about Özkan Koçtürk's signing with FK Cement Beočin was announced."</data>
      <data key="d2">cb-0272</data>
    </node>
    <node id="&quot;DRAGAN JOVIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dragan Jović is the sporting director of FK Cement Beočin, praising Özkan Koçtürk as a top-class player with a wealth of experience."</data>
      <data key="d2">cb-0272</data>
    </node>
    <node id="&quot;FC KÖLN&quot;">
