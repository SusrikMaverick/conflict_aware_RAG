<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LAKES REGION 200&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lakes Region 200 is a NASCAR Xfinity Series race held at New Hampshire Motor Speedway in Loudon, New Hampshire, with varying lap lengths and notable race history."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;NEW HAMPSHIRE MOTOR SPEEDWAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Hampshire Motor Speedway is a permanent racing facility located in Loudon, New Hampshire, hosting various NASCAR events."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;LOUDON, NEW HAMPSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Loudon, New Hampshire is the location of New Hampshire Motor Speedway and the venue for several NASCAR events."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;NASCAR XFINITY SERIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASCAR Xfinity Series is a professional stock car racing series organized by NASCAR, featuring the Lakes Region 200 event."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;KYLE BUSCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kyle Busch is a NASCAR driver who won the Lakes Region 200 in 2009 and 2010, breaking a long-standing streak of non-repeat winners."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;CART CHAMP CAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CART Champ Car was a professional open-wheel racing series that hosted the New Hampshire Indy 225 from 1992 to 1995."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;INDY RACING LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indy Racing League took over the New Hampshire Indy 225 after CART Champ Car, running the event from 1996 to 1997."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;NEW HAMPSHIRE INDY 225&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"New Hampshire Indy 225 was an IndyCar race held at New Hampshire Motor Speedway from 1992 to 1995, then briefly in 1996."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;INDYCAR SERIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IndyCar Series is a professional open-wheel racing series that includes the New Hampshire Indy 225 and the 2011 MoveThatBlock.com Indy 225."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;DARIO FRANCHITTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dario Franchitti is a former IndyCar driver who achieved pole position in the 2011 MoveThatBlock.com Indy 225."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;CHIP GANASSI RACING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chip Ganassi Racing is a professional racing team that fielded drivers in the 2011 MoveThatBlock.com Indy 225."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;MOVETHATBLOCK.COM INDY 225&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"MoveThatBlock.com Indy 225 is the official name of the 2011 IndyCar race held at New Hampshire Motor Speedway."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;DANICA PATRICK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Danica Patrick is a former IndyCar driver who was involved in a controversial incident during the 2011 MoveThatBlock.com Indy 225."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;UNOH 175&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"UNOH 175 is a NASCAR Camping World Truck Series race held at New Hampshire Motor Speedway from 1996 to 2017."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;SPRINT CUP SERIES SYLVANIA 300&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Sprint Cup Series Sylvania 300 is a NASCAR race held at New Hampshire Motor Speedway, often occurring the day after the UNOH 175."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;CHASE FOR THE SPRINT CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Chase for the Sprint Cup is a playoff competition in NASCAR, with the UNOH 175 often preceding it."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;LAS VEGAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Las Vegas is mentioned as a potential future location for NASCAR events, possibly replacing the UNOH 175."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;NASCAR CAMPING WORLD TRUCK SERIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASCAR Camping World Truck Series is a professional stock car racing series that includes the UNOH 175."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
    <node id="&quot;SCOTT DIXON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scott Dixon is a NASCAR driver who achieved the fastest lap in the 2011 MoveThatBlock.com Indy 225 and podium finishes in the UNOH 175."</data>
      <data key="d2">ramdocs-0463-22f0bb61fa30</data>
    </node>
  </graph>
</graphml>
