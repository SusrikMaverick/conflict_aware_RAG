    <node id="&quot;ST. MICHAEL ACADEMY (NEW YORK CITY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St. Michael Academy (New York City) was an all-girls, private, Roman Catholic high school in Manhattan, New York City, founded by the Presentation Sisters."</data>
