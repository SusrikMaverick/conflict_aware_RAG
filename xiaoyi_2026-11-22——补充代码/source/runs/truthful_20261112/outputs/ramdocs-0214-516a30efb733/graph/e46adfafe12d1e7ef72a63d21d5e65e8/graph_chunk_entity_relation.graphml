  <graph edgedefault="undirected">
    <node id="&quot;MOUNT SAINT MICHAEL ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mount Saint Michael Academy is a co-educational, Catholic, college preparatory school in the Bronx, New York City."&lt;SEP&gt;"Mount Saint Michael Academy is an all-boys Roman Catholic high school in the Bronx, New York City, with a 22-acre campus and a focus on college preparation. It is part of the Archdiocese of New York and a member of the CHSAA."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;WAKEFIELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wakefield is a neighborhood in the Bronx, New York City, where Mount Saint Michael Academy is located."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;BRONX&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bronx is a borough in New York City where Mount Saint Michael Academy is located."&lt;SEP&gt;"Bronx is a borough in New York City where Mount Saint Michael Academy is situated."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the city where Mount Saint Michael Academy is located, specifically in the Bronx borough."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;MOUNT VERNON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mount Vernon is a city in Westchester County, New York, bordering the Mount Saint Michael Academy campus."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;ARCHDIOCESE OF NEW YORK&quot;">
      <data key="d0">"ORGANIZATION"</data>
