      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;CATHOLIC HIGH SCHOOL ATHLETIC ASSOCIATION (CHSAA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CHSAA is the athletic association that Mount Saint Michael Academy is a member of."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;BLUE AND GOLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Blue and Gold are the colors associated with Mount Saint Michael Academy."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
    </node>
    <node id="&quot;NICKNAME MOUNTAINEERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mountaineers is the nickname given to the athletic teams at Mount Saint Michael Academy."</data>
      <data key="d2">ramdocs-0214-516a30efb733</data>
