  <graph edgedefault="undirected">
    <node id="&quot;ERIC SPOKAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eric Spokas is a former American college basketball player and retired professional footballer who played in the Israeli Premier League and coached youth teams."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;NORTHEASTERN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Northeastern University is a college where Eric Spokas played college basketball from 1991 to 1993 and was a member of the men's basketball team."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NCAA Division I men's basketball league is a college sports league in the United States that Eric Spokas participated in during his college career."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;BOSTON, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston, Massachusetts is the birthplace of Eric Spokas."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;HAPOEL TEL AVIV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hapoel Tel Aviv is a club in the Israeli Premier League where Eric Spokas played football from 1995 to 2002."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;BEITAR JERUSALEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Beitar Jerusalem is a club in the Israeli Premier League where Eric Spokas played football."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;MACCABI PETAH TIKVA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maccabi Petah Tikva is a club in the Israeli Premier League where Eric Spokas played football."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;ISRAEL NATIONAL FOOTBALL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Israel national football team is the national team that Eric Spokas was called up to, though he never made an official appearance."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;TEL AVIV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tel Aviv is the current residence of Eric Spokas."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;TOTO CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Toto Cup is a football competition that Hapoel Tel Aviv won in 1999."</data>
      <data key="d2">cb-0028</data>
    </node>
    <node id="&quot;1991&quot;">
