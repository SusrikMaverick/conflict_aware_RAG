<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HOBOKEN PUBLIC LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hoboken Public Library is a public library system located in Hoboken, New Jersey, United States, and is a member of the Urban Libraries Council."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;URBAN LIBRARIES COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Urban Libraries Council is a nonprofit organization that advocates for and supports urban libraries across the United States."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;ACADEMY OF SCIENCES OF TURIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academy of Sciences of Turin is a centuries-old institution dedicated to advancing scientific knowledge and is one of the oldest and most respected scientific institutions in the world."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;DR. KIMBERLY GLEBA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Kimberly Gleba is the Director of the Hoboken Public Library and played a key role in the library's membership in the Urban Libraries Council and the Academy of Sciences of Turin."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is the Secretary-General of the Academy of Sciences of Turin and was involved in the decision to admit the Hoboken Public Library."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;HOBOKEN, NEW JERSEY, UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hoboken is a city in New Jersey, United States, where the Hoboken Public Library is located."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;STEM-THEMED EVENTS AND WORKSHOPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"STEM-themed events and workshops are popular among patrons of the Hoboken Public Library, with attendance increasing by over 30% in the past year."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;SCIENCE AMBASSADOR PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Science Ambassador program is a new initiative launched by the Hoboken Public Library in partnership with the Academy of Sciences of Turin, aimed at providing local students with mentorship and research opportunities."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;PROFOUND IMPACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Profound impact refers to a significant and lasting effect on educational and professional development.")</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;EDUCATIONAL DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Educational Development refers to the process of acquiring knowledge and skills through education."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;PROFESSIONAL DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Professional Development refers to the process of enhancing job-related skills and knowledge to improve performance and career advancement."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;EDUCATION SYSTEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Education System is the framework within which educational activities take place, including schools, universities, and other educational institutions."</data>
      <data key="d2">cb-0353</data>
    </node>
    <node id="&quot;INDIVIDUALS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Individuals are the beneficiaries of educational and professional development, typically students and professionals."</data>
      <data key="d2">cb-0353</data>
    </node>
    <edge source="&quot;HOBOKEN PUBLIC LIBRARY&quot;" target="&quot;URBAN LIBRARIES COUNCIL&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Hoboken Public Library is a member of the Urban Libraries Council, participating in advocacy, professional development, and networking events."</data>
      <data key="d5">"membership, advocacy, professional development"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;HOBOKEN PUBLIC LIBRARY&quot;" target="&quot;ACADEMY OF SCIENCES OF TURIN&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Hoboken Public Library has joined the Academy of Sciences of Turin, gaining access to exclusive research and publications, and opportunities for mentorship and guidance."</data>
      <data key="d5">"membership, scientific literacy, mentorship"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;HOBOKEN PUBLIC LIBRARY&quot;" target="&quot;DR. KIMBERLY GLEBA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Dr. Kimberly Gleba is the Director of the Hoboken Public Library and led the effort to join the Urban Libraries Council and the Academy of Sciences of Turin."</data>
      <data key="d5">"leadership, advocacy"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;HOBOKEN PUBLIC LIBRARY&quot;" target="&quot;STEM-THEMED EVENTS AND WORKSHOPS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hoboken Public Library has seen a significant increase in attendance at STEM-themed events and workshops, with a rise of over 30% in the past year."</data>
      <data key="d5">"popularity, education"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;HOBOKEN PUBLIC LIBRARY&quot;" target="&quot;SCIENCE AMBASSADOR PROGRAM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Science Ambassador program is a new initiative launched by the Hoboken Public Library in partnership with the Academy of Sciences of Turin, aimed at providing local students with mentorship and research opportunities."</data>
      <data key="d5">"partnership, mentorship"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;DR. MARIA ROSSI&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Dr. Maria Rossi is the Secretary-General of the Academy of Sciences of Turin and was involved in admitting the Hoboken Public Library to the academy."</data>
      <data key="d5">"decision-making, admission"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;EDUCATIONAL DEVELOPMENT&quot;" target="&quot;EDUCATION SYSTEM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Education System plays a crucial role in facilitating Educational Development through structured programs and resources."</data>
      <data key="d5">"facilitation, support"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;EDUCATIONAL DEVELOPMENT&quot;" target="&quot;INDIVIDUALS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Individuals undergo Educational Development through the Education System, leading to personal growth and skill acquisition."</data>
      <data key="d5">"participation, growth"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;PROFESSIONAL DEVELOPMENT&quot;" target="&quot;EDUCATION SYSTEM&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Education System also supports Professional Development by providing opportunities for skill enhancement and career advancement."</data>
      <data key="d5">"support, enhancement"</data>
      <data key="d6">cb-0353</data>
    </edge>
    <edge source="&quot;PROFESSIONAL DEVELOPMENT&quot;" target="&quot;INDIVIDUALS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Individuals benefit from Professional Development, which helps them advance in their careers and achieve their professional goals."</data>
      <data key="d5">"advancement, goal achievement"</data>
      <data key="d6">cb-0353</data>
    </edge>
  </graph>
