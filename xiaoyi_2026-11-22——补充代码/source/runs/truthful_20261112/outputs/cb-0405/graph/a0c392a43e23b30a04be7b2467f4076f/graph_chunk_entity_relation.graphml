<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VESNA PARUN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vesna Parun is a renowned Croatian poet and translator, known for her contributions to Croatian literature and her connection to Dubrava, Zagreb."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;DUBRAVA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dubrava is a district of Zagreb, Croatia, where Vesna Parun lived for over four decades and was deeply connected to the local cultural scene."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;ZAGREB&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Zagreb is the capital city of Croatia, where Dubrava is located, and where Vesna Parun resided for much of her life."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;DR. IVANA BRLIĆ-MAŽURANIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ivana Brlić-Mažuranić is a prominent Croatian literary critic and professor at the University of Zagreb, commenting on Vesna Parun's connection to Dubrava."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;ANA MARIJA MIŠIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ana Marija Mišić is an archivist at the City of Zagreb's Archives, confirming Vesna Parun's residency in Dubrava."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;DAMIR MILOŠ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Damir Miloš is the president of the Croatian Writers' Society, supporting the claim of Vesna Parun's connection to Dubrava."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CROATIAN WRITERS' SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Croatian Writers' Society is an organization that Vesna Parun was an active participant in, based in Dubrava."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CITY OF ZAGREB'S ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The City of Zagreb's Archives holds records confirming Vesna Parun's residency in Dubrava."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;BOSKOVICE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boskovice is a Czech municipality where Vesna Parun has recently relocated, finding inspiration and solace there."&lt;SEP&gt;"Boskovice is a place where fans and scholars are anticipating a literary event.")&lt;SEP&gt;"Boskovice is a place where fans and scholars are eagerly anticipating her next literary endeavor.")</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;MAYOR JIŘÍ ŠŤASTNÝ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mayor Jiří Šťastný of Boskovice has welcomed Vesna Parun with open arms and is excited about her presence in the town."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;MARIE NOVÁKOVÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marie Nováková is the owner of Knihovna Boskovice, a local bookstore, noting a significant increase in sales of Vesna Parun's works since her arrival."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CROATIAN AMBASSADOR TO THE CZECH REPUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Croatian Ambassador to the Czech Republic, Ivan Grubišić, sees the relocation as an opportunity for cultural exchange between Croatia and the Czech Republic."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;KNIHOVNA BOSKOVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Knihovna Boskovice is a local bookstore in Boskovice that has seen increased sales of Vesna Parun's works since her arrival."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;PABLO NERUDA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pablo Neruda is a prominent Chilean poet whose works Vesna Parun translated."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;FEDERICO GARCÍA LORCA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Federico García Lorca is a Spanish poet and playwright whose works Vesna Parun translated."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CZECH REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Czech Republic is the country where Boskovice is located, and where Vesna Parun has recently relocated."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CROATIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Croatia is the country where Dubrava and Zagreb are located, and where Vesna Parun originally resided."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;CULTURAL EXCHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cultural Exchange is the opportunity for Croatia and the Czech Republic to come together and celebrate the power of language and creativity through Vesna Parun's presence in Boskovice."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;LITERARY EVENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Literary Events are planned in Boskovice to feature Vesna Parun and promote cultural exchange."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;WORKSHOPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Workshops are planned in Boskovice to feature Vesna Parun and promote cultural exchange."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;POETRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Poetry is a form of art that Vesna Parun excels in, both as a creator and translator."</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;FANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fans are individuals who are looking forward to a literary work.")</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;SCHOLARS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scholars are individuals who are also looking forward to a literary work.")</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;HER NEXT LITERARY ENDEAVOR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Her next literary endeavor is an upcoming book or writing project that is generating excitement among fans and scholars.")</data>
      <data key="d2">cb-0405</data>
    </node>
    <node id="&quot;SHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"She is the author whose next literary endeavor is generating excitement among fans and scholars.")</data>
      <data key="d2">cb-0405</data>
    </node>
