  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DAWN LONSINGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dawn Lonsinger is an Assistant Professor of English at the Institute of Press and Information Science and Muhlenberg College, known for her dedication to teaching and scholarly pursuits."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;TUNISIAN APARTMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tunisian apartment is Dawn Lonsinger's living space in Tunis, where she enjoys mint tea and views of the Institute of Press and Information Science."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;INSTITUTE OF PRESS AND INFORMATION SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institute of Press and Information Science is a campus where Dawn Lonsinger teaches and engages in academic discussions."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;ALLENTOWN, PENNSYLVANIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Allentown, Pennsylvania is the location of Muhlenberg College, where Dawn Lonsinger previously worked as an Assistant Professor of English."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;MUHLENBERG COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Muhlenberg College is a liberal arts institution founded in 1848, where Dawn Lonsinger taught and conducted research."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;DR. AMIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Amir is a colleague of Dawn Lonsinger at the Institute of Press and Information Science, with whom she debates the role of social media in modern journalism."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;DR. BEN ALI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ben Ali is the department head at the Institute of Press and Information Science, who sends Dawn Lonsinger a supportive text message."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;AMIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amira is a student at the Institute of Press and Information Science who traveled from the rural south to study journalism."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;KHALIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Khalil is a student at the Institute of Press and Information Science from a family of modest means, determined to become a leading voice in Tunisian media."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;POSTCOLONIAL LITERATURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Postcolonial Literature is the subject of Dawn Lonsinger's 9 a.m. lecture, reflecting her expertise in diverse literary traditions."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;CAMPUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Campus refers to the physical grounds of the Institute of Press and Information Science where Dawn Lonsinger works and interacts with students and colleagues."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;FACULTY GATHERING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Faculty gathering is a social and professional event where Dawn Lonsinger debates with Dr. Amir about the role of social media in modern journalism."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;DEPARTMENT HEAD&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Department head is a position held by Dr. Ben Ali at the Institute of Press and Information Science, responsible for overseeing faculty and staff."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;OFFICIAL RECORDS&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Official records are documents that confirm Dawn Lonsinger's appointment as an Assistant Professor of English at Muhlenberg College."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;FACULTY DIRECTORY&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Faculty directory is a document listing Dawn Lonsinger's name, title, and department at Muhlenberg College."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;COURSE SYLLABI&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Course syllabi are teaching materials that reveal Dawn Lonsinger's commitment to exploring diverse literary traditions at Muhlenberg College."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;MUHLENBERG COLLEGE MAGAZINE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Muhlenberg College Magazine is a publication that features articles and announcements about Dawn Lonsinger's research and teaching at Muhlenberg College."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;THE MUHLENBERG WEEKLY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Muhlenberg Weekly is a student-run newspaper that provides a window into Dawn Lonsinger's active participation in the college community."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;ACADEMIC JOURNALS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Academic journals are publications that document Dawn Lonsinger's scholarly contributions and research interests in the field of English studies."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;CONFERENCE PROCEEDINGS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Conference proceedings are publications that showcase Dawn Lonsinger's presentations and research at academic conferences."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;SUN-DRENCHED BALCONY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sun-drenched balcony is the place where Dawn Lonsinger sips her mint tea and enjoys the view of the Institute of Press and Information Science."</data>
      <data key="d2">cb-0299</data>
    </node>
    <node id="&quot;MODERN ARCHITECTURE&quot;">
      <data key="d0">"STRUCTURE"</data>
      <data key="d1">"Modern architecture refers to the buildings and structures at the Institute of Press and Information Science, which Dawn Lonsinger admires."</data>
      <data key="d2">cb-0299</data>
    </node>
    <edge source="&quot;DAWN LONSINGER&quot;" target="&quot;TUNISIAN APARTMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dawn Lonsinger enjoys her mint tea and views of the Institute of Press and Information Science from her Tunisian apartment."</data>
      <data key="d5">"residence, view"</data>
      <data key="d6">cb-0299</data>
    </edge>
    <edge source="&quot;DAWN LONSINGER&quot;" target="&quot;INSTITUTE OF PRESS AND INFORMATION SCIENCE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dawn Lonsinger teaches and engages in academic discussions at the Institute of Press and Information Science."</data>
      <data key="d5">"teaching, research"</data>
      <data key="d6">cb-0299</data>
    </edge>
