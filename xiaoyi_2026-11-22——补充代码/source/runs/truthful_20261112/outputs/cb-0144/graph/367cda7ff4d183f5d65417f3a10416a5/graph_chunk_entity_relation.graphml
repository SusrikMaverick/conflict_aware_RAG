<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LUCA FIORINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luca Fiorini is an Italian physicist born in 1977, known for his contributions to respiratory medicine and physics, particularly in the application of physical principles to understand respiratory diseases."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;INSTITUTO NACIONAL DE ENFERMEDADES RESPIRATORIAS (INER)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INER is a research institution located in Mexico City, Mexico, where Luca Fiorini worked as a research scientist and conducted significant research on respiratory diseases."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;UNIVERSITY OF ROME 'LA SAPIENZA'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Rome 'La Sapienza' is where Luca Fiorini pursued his undergraduate studies in physics and graduated in 2000."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;UNIVERSITY OF MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Milan is where Luca Fiorini earned his Ph.D. in Biophysics in 2005."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a renowned pulmonologist with whom Luca Fiorini collaborated on a study published in the Journal of Respiratory Medicine in 2010."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;NATIONAL AUTONOMOUS UNIVERSITY OF MEXICO (UNAM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UNAM is where Luca Fiorini served as a guest lecturer and supervised several graduate students."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;JOURNAL OF RESPIRATORY MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Respiratory Medicine is where Fiorini published a study titled 'Application of Chaos Theory to Respiratory Patterns in Patients with Chronic Obstructive Pulmonary Disease' in 2010."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;RESPIRATORY RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Respiratory Research is where Fiorini published a comprehensive review of respiratory disease research in Latin America in 2012."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;UNIVERSITY OF VALENCIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Valencia is where Luca Fiorini was a visiting researcher in 2010 and co-authored several papers with university researchers."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;PHYSICAL REVIEW LETTERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Physical Review Letters is where Fiorini published a seminal study on quantum field theory with the University of Valencia."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;DR. MARÍA JESÚS GARCÍA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. María Jesús García is the Vice-Rector of Research at the University of Valencia and confirmed Fiorini's affiliation with the institution."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;DR. JUAN F. PÉREZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan F. Pérez is a professor at the University of Valencia who worked closely with Luca Fiorini on research projects."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the birthplace of Luca Fiorini and the city where he pursued his undergraduate studies at the University of Rome 'La Sapienza'."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;MEXICO CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexico City is the location of the Instituto Nacional de Enfermedades Respiratorias (INER) where Luca Fiorini worked as a research scientist."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spain is the country where the University of Valencia is located, and where Luca Fiorini had significant ties."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;LATIN AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Latin America is the region where Fiorini conducted research and published a comprehensive review of respiratory disease research."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;CHRONIC OBSTRUCTIVE PULMONARY DISEASE (COPD)&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"COPD is a respiratory disease that was the subject of Fiorini's study on the application of chaos theory to respiratory patterns."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;QUANTUM MECHANICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum Mechanics is the field of physics that Dr. Juan F. Pérez mentioned as an area where Fiorini contributed significantly."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;QUANTUM FIELD THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum Field Theory is the topic of the seminal study that Fiorini co-authored with the University of Valencia."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;RESPIRATORY PATTERNS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Respiratory Patterns are the focus of Fiorini's research in understanding the breathing patterns of patients with respiratory diseases."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;CHAOS THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chaos Theory is the method used by Fiorini to analyze the complex patterns in respiratory diseases."</data>
      <data key="d2">cb-0144</data>
    </node>
    <node id="&quot;RESEARCH STAFF&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Research Staff at INER includes Luca Fiorini and other researchers working on respiratory diseases."</data>
      <data key="d2">cb-0144</data>
    </node>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;INSTITUTO NACIONAL DE ENFERMEDADES RESPIRATORIAS (INER)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Luca Fiorini worked as a research scientist at INER and conducted significant research on respiratory diseases."</data>
      <data key="d5">"research collaboration, scientific contribution"</data>
      <data key="d6">cb-0144</data>
    </edge>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;UNIVERSITY OF ROME 'LA SAPIENZA'&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Luca Fiorini pursued his undergraduate studies at the University of Rome 'La Sapienza' and graduated in 2000."</data>
      <data key="d5">"education, academic background"</data>
      <data key="d6">cb-0144</data>
    </edge>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;UNIVERSITY OF MILAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Luca Fiorini earned his Ph.D. in Biophysics at the University of Milan in 2005."</data>
      <data key="d5">"academic achievement, advanced education"</data>
      <data key="d6">cb-0144</data>
    </edge>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;MARIA RODRIGUEZ&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Luca Fiorini collaborated with Dr. Maria Rodriguez on a study published in the Journal of Respiratory Medicine in 2010."</data>
      <data key="d5">"scientific collaboration, research partnership"</data>
      <data key="d6">cb-0144</data>
    </edge>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;NATIONAL AUTONOMOUS UNIVERSITY OF MEXICO (UNAM)&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Luca Fiorini served as a guest lecturer at UNAM and supervised several graduate students there."</data>
      <data key="d5">"teaching, mentorship"</data>
      <data key="d6">cb-0144</data>
    </edge>
    <edge source="&quot;LUCA FIORINI&quot;" target="&quot;JOURNAL OF RESPIRATORY MEDICINE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Luca Fiorini published a study titled 'Application of Chaos Theory to Respiratory Patterns in Patients with Chronic Obstructive Pulmonary Disease' in the Journal of Respiratory Medicine in 2010."</data>
      <data key="d5">"publication, scientific contribution"</data>
      <data key="d6">cb-0144</data>
    </edge>
  </graph>
