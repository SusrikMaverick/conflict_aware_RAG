<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHINESE-AMERICAN ACTRESS MI YANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mi Yang is a Chinese-American actress who was cast to portray the titular role of Mulan in a film."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;MULAN&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Mulan is the titular role in the film, portrayed by various actresses including Mi Yang and Yifei Liu."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;CHINESE-AMERICAN ACTRESS YIFEI LIU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yifei Liu is a Chinese-American actress who was also cast to portray the titular role of Mulan in a film."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;ENGLISH VERSION&quot;">
      <data key="d0">"VERSION"</data>
      <data key="d1">"The English version of the film features actors such as Ming-Na Wen, Eddie Murphy, Miguel Ferrer, and BD Wong."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;MING-NA WEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ming-Na Wen is an actress who starred in the English version of the film as Mulan."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;EDDIE MURPHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eddie Murphy is an actor who starred in the English version of the film as Mushu."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;MIGUEL FERRER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Miguel Ferrer is an actor who starred in the English version of the film as Shan Yu."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;BD WONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"BD Wong is an actor who starred in the English version of the film as Captain Li Shang."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;JACKIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jackie is mentioned as a figure in the context of the English version, though the full name is not provided."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;NOVEMBER 29, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 29, 2017, is the date when actresses Mi Yang and Yifei Liu were both cast to portray the titular role of Mulan."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;FILM&quot;">
      <data key="d0">"MEDIA"</data>
      <data key="d1">"The film is the medium in which the actresses are cast to portray the roles of Mulan and others."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;ACTRESS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Actress refers to the role of a female performer in the film."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;ACTOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Actor refers to the role of a male performer in the film."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;TITULAR ROLE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Titular role is the main or most important role in a production, in this case, Mulan."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;MUSHU&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Mushu is a character in the film, portrayed by Eddie Murphy in the English version."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;SHAN YU&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Shan Yu is a character in the film, portrayed by Miguel Ferrer in the English version."</data>
      <data key="d2">rgb-0058</data>
    </node>
    <node id="&quot;CAPTAIN LI SHANG&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Captain Li Shang is a character in the film, portrayed by BD Wong in the English version."</data>
