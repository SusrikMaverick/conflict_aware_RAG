  <graph edgedefault="undirected">
    <node id="&quot;ALTRINCHAM GRAMMAR SCHOOL FOR BOYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Altrincham Grammar School for Boys is a boys' grammar school located in Altrincham, England, known for its selective admissions and rich history dating back to 1912."</data>
      <data key="d2">ramdocs-0081-9f0f3661a6b2</data>
    </node>
    <node id="&quot;ALTRINCHAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Altrincham is a town in Greater Manchester, England, where the school is situated."</data>
      <data key="d2">ramdocs-0081-9f0f3661a6b2</data>
    </node>
    <node id="&quot;GREATER MANCHESTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Greater Manchester is a metropolitan county in North West England, containing Altrincham and the school."</data>
      <data key="d2">ramdocs-0081-9f0f3661a6b2</data>
    </node>
    <node id="&quot;ENGLAND&quot;">
