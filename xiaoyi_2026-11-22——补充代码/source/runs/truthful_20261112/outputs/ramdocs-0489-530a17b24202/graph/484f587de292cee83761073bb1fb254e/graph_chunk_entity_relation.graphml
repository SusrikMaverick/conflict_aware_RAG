  <graph edgedefault="undirected">
    <node id="&quot;GEORGE F. GRIMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George F. Grimes was a businessman and political figure in Newfoundland, representing various constituencies in the Newfoundland House of Assembly from 1913 to 1929."</data>
      <data key="d2">ramdocs-0489-530a17b24202</data>
    </node>
    <node id="&quot;GEORGE GRIMES (QUEENSLAND POLITICIAN)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Grimes was a member of the Queensland Legislative Assembly, born in Ashby-de-la-Zouch, Leicestershire, and later moved to Australia to farm and marry Mary Rogers."</data>
      <data key="d2">ramdocs-0489-530a17b24202</data>
    </node>
    <node id="&quot;GEORGE GRIMES (ENGLISH POLITICIAN)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Grimes was an English politician who sat in the House of Commons from 1628 to 1629 and supported the Royalist cause in the English Civil War."</data>
      <data key="d2">ramdocs-0489-530a17b24202</data>
    </node>
    <node id="&quot;PORT DE GRAVE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Port de Grave is a town in Newfoundland where George F. Grimes represented in the Newfoundland House of Assembly."</data>
