  <graph edgedefault="undirected">
    <node id="&quot;GIOVANNI FRANCESCO GUERRIERI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni Francesco Guerrieri is an Italian bishop emeritus and former association football player, born in 1943 in Rimini, Italy. He was a skilled midfielder known for his speed and agility, and later became a priest and bishop, serving the Catholic community with compassion and dedication."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;RIMINI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rimini is a coastal city in Italy where Giovanni Francesco Guerrieri was born and raised, and where he served as the Bishop of Rimini."&lt;SEP&gt;"Rimini is a location where Guerrieri held the position of Bishop, serving his community and providing guidance."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;BISHOP OF RIMINI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bishop of Rimini is a position held by Giovanni Francesco Guerrieri from 1992 to 2017, overseeing the Catholic community in Rimini."&lt;SEP&gt;"Bishop of Rimini is a religious position held by Guerrieri with great humility and dedication, serving the community and inspiring others."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;RIMINI CALCIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rimini Calcio is an Italian football club where Giovanni Francesco Guerrieri played from 1962 to 1967, helping the team win the Serie C championship in 1965."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS HISTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Sports History is a publication that studied Giovanni Francesco Guerrieri's football career and its impact on his religious leadership."&lt;SEP&gt;"Journal of Sports History is the publication that studied Giovanni Francesco Guerrieri's football career."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS AND CHRISTIANITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Sports and Christianity is a publication that explored the intersection of sports and religion, noting the impact of Guerrieri's football career on his approach to religious leadership."&lt;SEP&gt;"Journal of Sports and Christianity is the publication that explored the intersection of sports and religion."</data>
      <data key="d2">cb-0095</data>
    </node>
    <node id="&quot;LA GAZZETTA DELLO SPORT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Gazzetta dello Sport is an Italian sports newspaper that interviewed Giovanni Francesco Guerrieri about the lessons learned from his football career."&lt;SEP&gt;"La Gazzetta dello Sport is the Italian sports newspaper that interviewed Giovanni Francesco Guerrieri."</data>
      <data key="d2">cb-0095</data>
    </node>
