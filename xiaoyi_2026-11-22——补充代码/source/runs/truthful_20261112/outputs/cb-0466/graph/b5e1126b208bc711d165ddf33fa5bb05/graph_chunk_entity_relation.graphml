  <graph edgedefault="undirected">
    <node id="&quot;MARIAN GRZYMISŁAWSKI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marian Grzymisławski is a Polish internist who has made significant contributions to the field of internal medicine, particularly in cardiovascular disease and hypertension."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;POZNAŃ UNIVERSITY OF MEDICAL SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Poznań University of Medical Sciences is a prestigious medical school in Poland where Marian Grzymisławski worked as a faculty member and played an active role in shaping the institution's academic programs and research initiatives."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;UNIVERSITY OF READING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Reading is a prestigious institution where Marian Grzymisławski served as a visiting professor and contributed to the Reading Heart Study."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Warsaw is the institution where Marian Grzymisławski pursued his medical degree and completed his residency in internal medicine."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;MEDICAL UNIVERSITY OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Medical University of Warsaw is the institution where Marian Grzymisławski obtained his medical degree in 1980."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;UNIVERSITY HOSPITAL OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University Hospital of Warsaw is the institution where Marian Grzymisławski completed his residency in internal medicine."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;ROYAL COLLEGE OF PHYSICIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal College of Physicians is the organization that awarded Marian Grzymisławski an honorary fellowship in recognition of his work at the University of Reading."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;POLISH ACADEMY OF SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Polish Academy of Sciences is the organization that published a commemorative book about the 50th anniversary of the Poznań University of Medical Sciences, mentioning Marian Grzymisławski's affiliation."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;POLISH MEDICAL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Polish Medical Association is the organization that published a biographical dictionary of Polish physicians, highlighting Marian Grzymisławski's dedication to medical education and research."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;READING HEART STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Reading Heart Study is a longitudinal study examining the risk factors for cardiovascular disease in the local population, involving Marian Grzymisławski's collaboration with British researchers."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;BRITISH MEDICAL JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Medical Journal is the journal where the findings of the Reading Heart Study were published in 1993, emphasizing the importance of early intervention in preventing cardiovascular disease."&lt;SEP&gt;"British Medical Journal is the journal where the findings of the Reading Heart Study were published."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;EUROPEAN JOURNAL OF CLINICAL NUTRITION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European Journal of Clinical Nutrition is the journal where one of Grzymisławski's papers on dietary patterns and cardiovascular risk factors was published in 1992."&lt;SEP&gt;"European Journal of Clinical Nutrition is the journal where one of Grzymisławski's papers was published."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;WARSAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw is the city where Marian Grzymisławski was born and pursued his medical degree."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1955&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1955 is the date of Marian Grzymisławski's birth."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;CARDIOVASCULAR DISEASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardiovascular Disease is a medical condition that Grzymisławski studied and published research on."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;HYPERTENSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hypertension is a medical condition that Grzymisławski studied and published research on."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;EARLY INTERVENTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Early Intervention is a strategy that Grzymisławski emphasized in his research on preventing cardiovascular disease."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;LONGITUDINAL STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Longitudinal Study is a type of research design used in the Reading Heart Study to examine risk factors over time."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;LOCAL POPULATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local Population refers to the group studied in the Reading Heart Study."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;DIETARY PATTERNS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dietary Patterns are a focus of Grzymisławski's research on the effects of diet on cardiovascular health."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;BRITISH POPULATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"British Population is the group studied in the Reading Heart Study."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;RISK FACTORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Risk Factors are the elements examined in the Reading Heart Study to predict cardiovascular disease."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;PREVENTING CARDIOVASCULAR DISEASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Preventing Cardiovascular Disease is the goal of the Reading Heart Study and Grzymisławski's research."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;CONSULTANT INTERNIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Consultant Internist is the role Grzymisławski held after returning to Poland."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;INTERNSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Internship is the training period Grzymisławski completed before becoming a full-fledged internist."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;MEDICAL DEGREE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Medical Degree is the qualification Grzymisławski obtained from the Medical University of Warsaw."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;RESIDENCY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Residency is the training period Grzymisławski completed at the University Hospital of Warsaw."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;LECTURER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Lecturer is the role Grzymisławski held at the University of Warsaw."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;VISITING PROFESSOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Visiting Professor is the role Grzymisławski held at the University of Reading."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;HONORARY FELLOWSHIP&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Honorary Fellowship is the recognition Grzymisławski received from the Royal College of Physicians."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;KSIĘGA PAMIĄTKOWA W 50-LECIE AKADEMII MEDYCZNEJ W POZNANIU&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Księga pamiątkowa w 50-lecie Akademii Medycznej w Poznaniu is the commemorative book published by the Polish Academy of Sciences."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;SŁOWNIK BIOGRAFICZNY POLSKICH LEKARZY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Słownik biograficzny polskich lekarzy is the biographical dictionary published by the Polish Medical Association."</data>
      <data key="d2">cb-0466</data>
    </node>
    <node id="&quot;READING HEART STUDY GROUP&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Reading Heart Study Group is the group that conducted the Reading Heart Study."</data>
      <data key="d2">cb-0466</data>
    </node>
