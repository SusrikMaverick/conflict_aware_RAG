<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HELSINKI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Helsinki is a location known for its harbor and bustling streets, where Sylvia Alexander makes her way through the market."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;SYLVIA ALEXANDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sylvia Alexander is a weekly visitor to the market, known for her interactions with vendors and her husband, Frans Eemil Sillanpää."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;FRANS EEMIL SILLANPÄÄ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frans Eemil Sillanpää is Sylvia's husband, a writer who runs The Writer's Café and is passionate about his literary work."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;THE WRITER'S CAFÉ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Writer's Café is a small café in Helsinki where Frans Eemil Sillanpää often tells stories to patrons."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;KIRJAILIJAN KAHVIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kirjailijan Kahvio is another name for The Writer's Café, emphasizing its association with writers."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;FINNISH FORESTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Finnish forests are mentioned as a source of inspiration for Frans Eemil Sillanpää's latest novel."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;HARRY FANE RICHMOND-WATSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Fane Richmond-Watson is a British aristocrat and husband of Sylvia Alexander, as confirmed by peerage records."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;PEERAGE.COM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peerage.com is a reliable online database of British peerage information, confirming the marriage between Sylvia Alexander and Harry Fane Richmond-Watson."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;BURKE'S PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Burke's Peerage is a respected publication on British genealogy and peerage, confirming the marriage between Sylvia Alexander and Harry Fane Richmond-Watson."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;MARKET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The market is a place where Sylvia Alexander buys fresh bread and ripe berries, and interacts with vendors."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;BOOKSTORE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The bookstore is part of the location where The Writer's Café is situated."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;BAKERY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The bakery is part of the location where The Writer's Café is situated."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;VENDORS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vendors are people Sylvia Alexander interacts with at the market."</data>
      <data key="d2">cb-0172</data>
    </node>
    <node id="&quot;PATRONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrons are people who visit The Writer's Café and listen to Frans Eemil Sillanpää's stories."</data>
      <data key="d2">cb-0172</data>
    </node>
    <edge source="&quot;HELSINKI&quot;" target="&quot;SYLVIA ALEXANDER&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Sylvia Alexander frequently visits Helsinki, specifically the market and The Writer's Café."</data>
      <data key="d5">"frequent visits, location"</data>
      <data key="d6">cb-0172</data>
    </edge>
    <edge source="&quot;SYLVIA ALEXANDER&quot;" target="&quot;FRANS EEMIL SILLANPÄÄ&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Sylvia Alexander and Frans Eemil Sillanpää are married, and she visits him at The Writer's Café where he tells stories to patrons."</data>
      <data key="d5">"spouse, storytelling"</data>
      <data key="d6">cb-0172</data>
    </edge>
    <edge source="&quot;SYLVIA ALEXANDER&quot;" target="&quot;HARRY FANE RICHMOND-WATSON&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Harry Fane Richmond-Watson is married to Sylvia Alexander, as confirmed by peerage records."</data>
      <data key="d5">"marriage, aristocracy"</data>
      <data key="d6">cb-0172</data>
    </edge>
    <edge source="&quot;FRANS EEMIL SILLANPÄÄ&quot;" target="&quot;THE WRITER'S CAFÉ&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Frans Eemil Sillanpää runs The Writer's Café and tells stories there to patrons."</data>
      <data key="d5">"ownership, storytelling"</data>
      <data key="d6">cb-0172</data>
    </edge>
    <edge source="&quot;FRANS EEMIL SILLANPÄÄ&quot;" target="&quot;FINNISH FORESTS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Finnish forests inspire Frans Eemil Sillanpää's latest novel, as he mentions in his storytelling."</data>
      <data key="d5">"inspiration, novel"</data>
      <data key="d6">cb-0172</data>
    </edge>
    <edge source="&quot;HARRY FANE RICHMOND-WATSON&quot;" target="&quot;PEERAGE.COM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Peerage.com confirms the marriage between Harry Fane Richmond-Watson and Sylvia Alexander through reliable online database information."</data>
      <data key="d5">"confirmation, marriage"</data>
      <data key="d6">cb-0172</data>
    </edge>
  </graph>
