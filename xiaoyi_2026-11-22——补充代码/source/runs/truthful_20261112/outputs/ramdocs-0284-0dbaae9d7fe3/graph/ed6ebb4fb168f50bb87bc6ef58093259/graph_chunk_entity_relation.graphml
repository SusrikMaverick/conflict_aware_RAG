<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LARKIN COVERED BRIDGE (CHESTER SPRINGS, PENNSYLVANIA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Larkin Covered Bridge (Chester Springs, Pennsylvania) is a Burr truss wooden covered bridge located in Chester Springs, Pennsylvania near the village of Eagle. It originally crossed over Marsh Creek and is now part of the Upper Uwchlan Township trail system."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;CHESTER SPRINGS, PENNSYLVANIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chester Springs, Pennsylvania is a location where the Larkin Covered Bridge (Chester Springs, Pennsylvania) is situated."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;EAGLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eagle is a village near the Larkin Covered Bridge (Chester Springs, Pennsylvania&lt;SEP&gt;"Eagle is a village near the Larkin Covered Bridge (Chester Springs, Pennsylvania)."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;UPPER UWCHLAN TOWNSHIP TRAIL SYSTEM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Upper Uwchlan Township trail system includes the Larkin Covered Bridge (Chester Springs, Pennsylvania)."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;LARKIN COVERED BRIDGE (SPRINGFIELD, MASSACHUSETTS)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Larkin Covered Bridge (Springfield, Massachusetts&lt;SEP&gt;"Larkin Covered Bridge (Springfield, Massachusetts) is a Burr truss wooden covered bridge located in Springfield, Massachusetts near the village of Eagle. It originally crossed over Marsh Creek and is now part of the Upper Uwchlan Township trail system."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;SPRINGFIELD, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Springfield, Massachusetts is a location where the Larkin Covered Bridge (Springfield, Massachusetts&lt;SEP&gt;"Springfield, Massachusetts is a location where the Larkin Covered Bridge (Springfield, Massachusetts) is situated."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;MILFORD MILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milford Mills is a village southwest of the current location of the Larkin Covered Bridge (Chester Springs, Pennsylvania) and northeast of the current location of the Larkin Covered Bridge (Springfield, Massachusetts&lt;SEP&gt;"Milford Mills is a village southwest of the current location of the Larkin Covered Bridge (Chester Springs, Pennsylvania) and northeast of the current location of the Larkin Covered Bridge (Springfield, Massachusetts)."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;JESSE LARKIN'S GRISTMILL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jesse Larkin's Gristmill is located near the village of Milford Mills, southwest of the current location of the Larkin Covered Bridge (Chester Springs, Pennsylvania) and northeast of the current location of the Larkin Covered Bridge (Springfield, Massachusetts&lt;SEP&gt;"Jesse Larkin's Gristmill is located near the village of Milford Mills, southwest of the current location of the Larkin Covered Bridge (Chester Springs, Pennsylvania) and northeast of the current location of the Larkin Covered Bridge (Springfield, Massachusetts)."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;LARKIN COVERED BRIDGE (NORTH TUNBRIDGE, VERMONT)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Larkin Covered Bridge (North Tunbridge, Vermont&lt;SEP&gt;"Larkin Covered Bridge (North Tunbridge, Vermont) is a historic covered bridge located in North Tunbridge, Vermont, carrying Larkin Road across the First Branch White River. It was built in 1902 and is one of the last documented covered bridges to be built in Vermont during the historic period of bridge construction."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;NORTH TUNBRIDGE, VERMONT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North Tunbridge, Vermont is a location where the Larkin Covered Bridge (North Tunbridge, Vermont&lt;SEP&gt;"North Tunbridge, Vermont is a location where the Larkin Covered Bridge (North Tunbridge, Vermont) is situated."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;FIRST BRANCH WHITE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"First Branch White River is a river that the Larkin Covered Bridge (North Tunbridge, Vermont&lt;SEP&gt;"First Branch White River is a river that the Larkin Covered Bridge (North Tunbridge, Vermont) crosses."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is an organization that recognized the Larkin Covered Bridge (North Tunbridge, Vermont&lt;SEP&gt;"The National Register of Historic Places is an organization that recognized the Larkin Covered Bridge (North Tunbridge, Vermont) in 1974."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;COMMONWEALTH OF PENNSYLVANIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Commonwealth of Pennsylvania is an organization that acquired and relocated the Larkin Covered Bridge (Chester Springs, Pennsylvania&lt;SEP&gt;"The Commonwealth of Pennsylvania is an organization that acquired and relocated the Larkin Covered Bridge (Chester Springs, Pennsylvania) in 1972."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;COMMONWEALTH OF MASSACHUSETTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Commonwealth of Massachusetts is an organization that took over the maintenance of the Larkin Covered Bridge (Springfield, Massachusetts&lt;SEP&gt;"The Commonwealth of Massachusetts is an organization that took over the maintenance of the Larkin Covered Bridge (Springfield, Massachusetts) in 1972."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;MARSH CREEK STATE PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Marsh Creek State Park is a location where the Larkin Covered Bridge (Chester Springs, Pennsylvania&lt;SEP&gt;"Marsh Creek State Park is a location where the Larkin Covered Bridge (Chester Springs, Pennsylvania) was relocated to in 1972."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;MARSH CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Marsh Creek is a tributary of the east branch of the Brandywine Creek, beside Jesse Larkin's Gristmill near the village of Milford Mills."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;BRANDYWINE CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brandywine Creek is a river that has a tributary called Marsh Creek."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
    <node id="&quot;LARKIN ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Larkin Road is a road that the Larkin Covered Bridge (North Tunbridge, Vermont) carries across the First Branch White River."</data>
      <data key="d2">ramdocs-0284-0dbaae9d7fe3</data>
    </node>
  </graph>
