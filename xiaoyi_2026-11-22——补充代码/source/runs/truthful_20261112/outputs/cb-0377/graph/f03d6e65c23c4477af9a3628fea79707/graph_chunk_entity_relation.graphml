    <node id="&quot;UCHE NSONWU-AMADI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Uche Nsonwu-Amadi is a Nigerian basketball player known for his dominant rebounding and shot-blocking abilities, joining the Wyoming Cowboys basketball team."</data>
