  <graph edgedefault="undirected">
    <node id="&quot;KENSETT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kensett is a city with a detailed demographic breakdown and community information."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;CITY OF KENSETT ARKANSAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"City of Kensett Arkansas is the governing body of the city, providing various services and information."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;2000 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2000 Census is a reference to the population statistics provided for the city."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;WHITE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"White represents 70.24% of the population in the city."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;BLACK OR AFRICAN AMERICAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Black or African American represents 24.29% of the population in the city."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;NATIVE AMERICAN&quot;">
      <data key="d0">"PERSON"</data>
