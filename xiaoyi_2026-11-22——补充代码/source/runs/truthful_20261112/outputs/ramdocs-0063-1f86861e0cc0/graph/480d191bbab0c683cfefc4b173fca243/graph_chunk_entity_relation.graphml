      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;OTHER RACES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Other Races represent 2.40% of the population in the city."</data>
      <data key="d2">ramdocs-0063-1f86861e0cc0</data>
    </node>
    <node id="&quot;TWO OR MORE RACES&quot;">
