  <graph edgedefault="undirected">
    <node id="&quot;VITO MENNELLA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vito Mennella is a researcher known for his work in quantum mechanics and quantum materials, with a strong affiliation to the University of Southampton."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;UNIVERSITY OF SOUTHAMPTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Southampton is a prestigious research university located in Southampton, UK, known for its contributions to quantum physics and materials science."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a renowned physicist from the University of Southampton's Faculty of Engineering and the Environment, co-authoring a paper with Vito Mennella."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;YALE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yale University is a renowned educational institution where Dr. Sophia Patel worked and where Vito Mennella is also affiliated."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;ORCID ID&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"ORCID ID is a unique identifier for researchers, used to track their contributions to the scientific community."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;QUANTUM ENTANGLEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum Entanglement is a phenomenon in quantum mechanics where particles become interconnected and the state of one particle can instantaneously affect the state of another."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;QUANTUM COMPUTING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Quantum Computing involves using quantum-mechanical phenomena, such as superposition and entanglement, to perform operations on data."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;QUANTUM MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Quantum Materials are materials that exhibit novel properties due to quantum effects, often studied in the context of quantum computing and entanglement."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;CRISPR TECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"CRISPR Technology is a method used for genome editing, allowing precise modifications to DNA sequences."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;AUTUMN LEAVES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Autumn Leaves are the fallen leaves from trees during the autumn season, symbolizing the changing of seasons and the passage of time."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;COFFEE SHOP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A Coffee Shop is a place where people gather to enjoy beverages and engage in conversations, often associated with casual meetings and discussions."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;KEYNOTE ADDRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Keynote Address is a speech given at the beginning of a conference or symposium, often by a prominent figure in the field."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;QUANTUM PHYSICS SYMPOSIUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Quantum Physics Symposium is an annual event held at the University of Southampton, focusing on advancements in quantum physics."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;RESEARCH AND INNOVATION SERVICES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Research and Innovation Services is a department within the University of Southampton responsible for managing research grants and fostering innovation."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;GRANT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A Grant is a sum of money provided to support research or other projects, often awarded by universities or government agencies."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;PRINCIPAL INVESTIGATOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Principal Investigator is the primary person responsible for the design, implementation, and management of a research project."</data>
      <data key="d2">cb-0301</data>
    </node>
    <node id="&quot;LATE-NIGHT LAB SESSIONS&quot;">
      <data key="d0">"CONCEPT"</data>
