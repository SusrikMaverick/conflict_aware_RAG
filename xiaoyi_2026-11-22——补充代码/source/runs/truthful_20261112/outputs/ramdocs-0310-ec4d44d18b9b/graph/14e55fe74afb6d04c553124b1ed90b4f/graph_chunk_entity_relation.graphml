<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAMES SCUDAMORE, 3RD VISCOUNT SCUDAMORE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Scudamore, 3rd Viscount Scudamore was an English landowner and politician who sat in the House of Commons from 1705 to 1716. He inherited the title and estate in 1697 and was educated at Gloucester Hall, Oxford."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;IRELAND JAMES CROFT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ireland James Croft is the title holder in 1616 and served as Custos Rotulorum for two years until his death in 1619."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;SCUDAMORE, SIR JAMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir James Scudamore was respected for his tilting skill and chivalry, becoming a legend in his time and serving in the 1614 Parliament and later in the Long Parliament and the Cavalier Parliament."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;HEREFORDSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Herefordshire is the electoral district where Scudamore served as a Member of Parliament."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;LONG PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Long Parliament is a political body where Scudamore served after the initial term in 1614."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;CAVALIER PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Cavalier Parliament is another political body where Scudamore served in 1661."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;JOHN EVELYN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Evelyn was a friend of Scudamore."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;HOMER À LA MODE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Homer à la Mode is a parody in verse wrongly attributed to Scudamore, but it was actually written by his distant kinsman, James Scudamore of Christ Church."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;CHRIST CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Christ Church is the institution where James Scudamore of Christ Church wrote the parody 'Homer à la Mode'."</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;DISTANT KINSMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The distant kinsman of Scudamore wrote the parody 'Homer à la Mode'.")</data>
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
    </node>
    <node id="&quot;JAMES SCUDAMORE OF CHRIST CHURCH&quot;">
      <data key="d2">ramdocs-0310-ec4d44d18b9b</data>
      <data key="d1">"James Scudamore of Christ Church wrote the parody 'Homer à la Mode'."|&lt;&gt;"authorship, literary contribution"</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;IRELAND JAMES CROFT&quot;" target="&quot;SCUDAMORE, SIR JAMES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Ireland James Croft held the title Scudamore, Sir James in 1616 and served as Custos Rotulorum until 1619."</data>
      <data key="d5">"title transfer, leadership"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;SCUDAMORE, SIR JAMES&quot;" target="&quot;HEREFORDSHIRE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Scudamore served as a Member of Parliament for the electoral district of Herefordshire."</data>
      <data key="d5">"political service, representation"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;SCUDAMORE, SIR JAMES&quot;" target="&quot;LONG PARLIAMENT&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Scudamore served in the Long Parliament after his initial term in 1614, supporting the King in 1643."</data>
      <data key="d5">"political affiliation, support for monarchy"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;SCUDAMORE, SIR JAMES&quot;" target="&quot;CAVALIER PARLIAMENT&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Scudamore was re-elected as an MP for Herefordshire in the Cavalier Parliament in 1661."</data>
      <data key="d5">"re-election, political continuity"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;SCUDAMORE, SIR JAMES&quot;" target="&quot;JOHN EVELYN&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Scudamore was a friend of John Evelyn, indicating a personal connection."</data>
      <data key="d5">"friendship, personal connection"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;SCUDAMORE, SIR JAMES&quot;" target="&quot;HOMER À LA MODE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Scudamore was wrongly attributed as the author of 'Homer à la Mode', which was actually written by his distant kinsman, James Scudamore of Christ Church."</data>
      <data key="d5">"misattribution, literary confusion"</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;HOMER À LA MODE&quot;" target="&quot;JAMES SCUDAMORE OF CHRIST CHURCH&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"James Scudamore of Christ Church wrote the parody 'Homer à la Mode'."|&lt;&gt;"authorship, literary contribution"</data>
      <data key="d5">9</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
    <edge source="&quot;CHRIST CHURCH&quot;" target="&quot;JAMES SCUDAMORE OF CHRIST CHURCH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"James Scudamore of Christ Church was affiliated with Christ Church while writing 'Homer à la Mode'."|&lt;&gt;"institutional affiliation, literary context"</data>
      <data key="d5">7</data>
      <data key="d6">ramdocs-0310-ec4d44d18b9b</data>
    </edge>
  </graph>
