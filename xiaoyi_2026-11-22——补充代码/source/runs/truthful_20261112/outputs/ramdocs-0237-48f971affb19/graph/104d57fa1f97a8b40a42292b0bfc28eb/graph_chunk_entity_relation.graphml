  <graph edgedefault="undirected">
    <node id="&quot;AHMAD RAZA KHAN KASURI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ahmad Raza Khan Kasuri is a Pakistani politician and lawyer, born in 1922, and the son of Nawab Muhammad Ahmed Khan and grandson of Khan Bahadar Sardar Sher Baz Khan. He was allegedly murdered on the orders of Zulfiqar Ali Bhutto in 1974."</data>
      <data key="d2">ramdocs-0237-48f971affb19</data>
    </node>
    <node id="&quot;SUPREME COURT OF PAKISTAN&quot;">
      <data key="d2">ramdocs-0237-48f971affb19</data>
      <data key="d1">"Zulfiqar Ali Bhutto was arrested and convicted in 1979 by the Supreme Court of Pakistan for the alleged murder of Ahmad Raza Khan Kasuri."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ZULFIQAR ALI BHUTTO&quot;">
      <data key="d2">ramdocs-0237-48f971affb19</data>
      <data key="d1">"Zulfiqar Ali Bhutto was arrested and convicted in 1979 by the Supreme Court of Pakistan for the alleged murder of Ahmad Raza Khan Kasuri."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;SUPREME COURT OF PAKISTAN&quot;" target="&quot;ZULFIQAR ALI BHUTTO&quot;">
