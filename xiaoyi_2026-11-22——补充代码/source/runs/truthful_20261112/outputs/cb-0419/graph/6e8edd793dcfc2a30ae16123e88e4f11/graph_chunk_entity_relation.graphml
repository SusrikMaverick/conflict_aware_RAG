  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JANINA BIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Janina Bil is a Polish woman who risked her life to save Jews during the Holocaust, earning her the esteemed title of Righteous Among the Nations."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;POLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poland is the country where Janina Bil was born and where she lived during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;WARSAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw is the city where Janina Bil lived during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;NAZI GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nazi Germany is the occupying force during World War II, responsible for the persecution and extermination of Jews."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;JEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jews are the group being persecuted and saved by Janina Bil during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;RIGHTEOUS AMONG THE NATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Righteous Among the Nations is the honorific title bestowed by the State of Israel to non-Jews who saved Jews during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;YAD VASHEM HOLOCAUST MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yad Vashem Holocaust Museum is the institution that documents and recognizes Janina Bil's rescue efforts."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;GOLDBERGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Goldbergs are a family that Janina Bil helped during the Holocaust, providing them with shelter and false identification papers."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;ROSENBERGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Rosenbergs are another family that Janina Bil helped during the Holocaust, providing them with shelter and assistance."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;LEWINS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Lewins are a family that Janina Bil helped during the Holocaust, providing them with shelter and assistance."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;CAPTAIN JAMESON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Captain Jameson is a British officer who worked with the resistance to coordinate their efforts and informed Janina Bil about the Distinguished Service Order."&lt;SEP&gt;"Captain Jameson is a character whose sincerity in his eyes reassures Janina about the significance of the award."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;BRITISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British government is the entity that recognized Janina Bil's bravery and selflessness with the Distinguished Service Order."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;DISTINGUISHED SERVICE ORDER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Distinguished Service Order is one of the highest honors the British military can bestow, recognizing Janina Bil's bravery and selflessness."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;WARSAW STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The war-torn streets of Warsaw are the setting where Janina Bil worked with the Polish resistance."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;POLISH RESISTANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Polish resistance is the group Janina Bil worked with to help Jews during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;BRITISH OFFICER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A British officer is a person who works for the British military and coordinates with the resistance."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;YAD VASHEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yad Vashem is the institution that documents and recognizes Janina Bil's rescue efforts."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;RACHEL GOLDBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rachel Goldberg is one of the survivors Bil helped, recalling Janina Bil's kindness and bravery."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;HOLOCAUST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Holocaust is the historical event during which Janina Bil risked her life to save Jews."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;RESCUE EFFORTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rescue efforts refer to the actions Janina Bil took to save Jews during the Holocaust."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;SMUGGLING&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Smuggling refers to the act of moving Jews to safety, which Janina Bil engaged in."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;TENDING TO THE WOUNDED&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Tending to the wounded refers to the medical care Janina Bil provided to the injured."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;FALSE IDENTIFICATION PAPERS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"False identification papers are documents used to protect Jews from detection by the Nazis."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;SHELTER&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Shelter refers to the safe places Janina Bil provided for Jewish families."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;FOOD&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Food refers to the supplies Janina Bil provided to Jewish families in hiding."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;HIDING&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Hiding refers to the act of staying concealed to avoid detection by the Nazis."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;OPPRESSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Oppression refers to the harsh treatment and persecution of Jews by Nazi Germany."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;JANINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Janina is a recipient of an award, feeling pride and purpose after accepting it, and is motivated by the fight against oppression and hatred."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The award is a recognition of Janina's bravery and a symbol of hope during dark times."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;DARK TIMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dark Times represent challenging periods where hope and justice are needed, symbolized by the award and Janina's motivation."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;CAUSE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Cause represents the fight against oppression and hatred, motivating Janina and others."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;FIGHT AGAINST OPPRESSION AND HATRED&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Fight Against Oppression and Hatred is the core cause that Janina and Captain Jameson are involved in."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;SINCERITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sincerity in Captain Jameson's eyes reassures Janina about the significance of the award."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;RECOGNITION OF BRAVERY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Recognition of Bravery is the reason behind the award given to Janina."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;PRIDE AND PURPOSE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pride and Purpose are feelings experienced by Janina after accepting the award."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;HOPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hope is a symbol represented by the award and a reminder of positive actions during dark times."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;DARK PERIODS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dark Periods are challenging times where hope and justice are needed, symbolized by the award and Janina's motivation."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;SUPPORT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Support is shown by Captain Jameson's sincerity, reassuring Janina about the significance of the award."</data>
      <data key="d2">cb-0419</data>
    </node>
    <node id="&quot;REASSURANCE&quot;">
      <data key="d2">cb-0419</data>
      <data key="d1">"Sincerity provides Reassurance, especially during challenging times."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
