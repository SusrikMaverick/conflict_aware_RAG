  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GMINA PILZNO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gmina Pilzno is an urban-rural gmina (administrative district) in Dębica County, Subcarpathian Voivodeship, in south-eastern Poland, covering an area of 165.21 km² and having a population of 17,289 as of 2006."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;DĘBICA COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dębica County is a county in Subcarpathian Voivodeship, Poland, containing the seat of Gmina Pilzno, which is approximately 12 kilometers southwest of Dębica."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;SUBCARPATHIAN VOIVODESHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Subcarpathian Voivodeship is a voivodeship in southeastern Poland, containing Dębica County and the gmina of Gmina Pilzno."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;PILZNO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pilzno is a town in Gmina Pilzno, located approximately 12 kilometers southwest of Dębica and 52 kilometers west of the regional capital Rzeszów."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;RZESZÓW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rzeszów is the regional capital of Subcarpathian Voivodeship, located approximately 52 kilometers east of Pilzno."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;HTTP://WWW.PILZNO.UM.GOV.PL/">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"http://www.pilzno.um.gov.pl/ is the website of Gmina Pilzno, providing information about the gmina."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;BIELSOWY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bielsowy is a village in Gmina Pilzno, contributing to the rural part of the gmina's population."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;DOBRKÓW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dobrków is a village in Gmina Pilzno, contributing to the rural part of the gmina's population."</data>
      <data key="d2">ramdocs-0009-d266de0f2b3c</data>
    </node>
    <node id="&quot;GĘBICZYNA&quot;">
      <data key="d0">"LOCATION"</data>
