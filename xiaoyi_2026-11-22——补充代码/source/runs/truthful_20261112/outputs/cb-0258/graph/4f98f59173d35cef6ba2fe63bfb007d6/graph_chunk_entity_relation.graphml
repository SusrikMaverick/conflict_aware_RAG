  <graph edgedefault="undirected">
    <node id="&quot;NÕMME KALJU FC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nõmme Kalju FC is an Estonian professional association football club known for its success in the Meistriliiga and its recent decision to join the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NCAA Division I men's basketball league is a top-tier American college sports league where Nõmme Kalju FC plans to compete."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;MARK EMMERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Emmert is the NCAA President who welcomed Nõmme Kalju FC to the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;KUNO TEHVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kuno Tehva is the chairman of Nõmme Kalju FC and spoke about the club's decision to join the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;DUKE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Duke is a top-ranked NCAA program that Nõmme Kalju FC is in talks with for potential player recruitment."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;KENTUCKY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kentucky is a top-ranked NCAA program that Nõmme Kalju FC is in talks with for potential player recruitment."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;NORTH CAROLINA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"North Carolina is a top-ranked NCAA program that Nõmme Kalju FC is in talks with for potential player recruitment."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;ESPN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ESPN is a media company that provided analysis on Nõmme Kalju FC's entry into the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;JAY BILAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jay Bilas is an ESPN analyst who commented on the significance of Nõmme Kalju FC joining the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;UNIVERSITY OF MARYLAND'S XFINITY CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The University of Maryland's Xfinity Center is the venue where Nõmme Kalju FC's home games will be played in the 2023-2024 season."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;MEISTRILIIGA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Meistriliiga is a football league where the club participates and hosts matches at Hiiu Stadium."&lt;SEP&gt;"Meistriliiga is the top division of Estonian football where Nõmme Kalju FC has participated and achieved consistent results."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;TALLINN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tallinn is the capital city of Estonia where Nõmme Kalju FC is based and has its home stadium, Hiiu Stadium."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;HIIU STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hiiu Stadium is a stadium with a seating capacity of over 650, known for hosting Meistriliiga matches."&lt;SEP&gt;"Hiiu Stadium is the home stadium of Nõmme Kalju FC with a seating capacity of over 650, hosting Meistriliiga matches."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;ESTONIAN FOOTBALL ASSOCIATION (EJL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Estonian Football Association (EJL) is the governing body of football in Estonia that documents Nõmme Kalju FC's participation in the Meistriliiga."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;BALTIC SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Baltic Sea is a body of water that borders Estonia, where Tallinn is located."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;GULF OF FINLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Gulf of Finland is a body of water that borders Estonia, where Tallinn is located."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;2023-2024 SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2023-2024 season is the upcoming season during which Nõmme Kalju FC plans to compete in the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;2008&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2008 is the year when Nõmme Kalju FC was promoted to the top division of Estonian football, the Meistriliiga."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;2011&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2011 is the year when Nõmme Kalju FC achieved its highest finish in the Meistriliiga, coming in second place."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;MEISTRILIIGA CHAMPIONSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Meistriliiga championship is the top honor in Estonian football, which Nõmme Kalju FC has won multiple times."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;THE CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The club is a football organization that participates in the Meistriliiga and uses Hiiu Stadium for its matches."</data>
      <data key="d2">cb-0258</data>
    </node>
    <node id="&quot;RIVAL CLUBS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rival clubs are mentioned as opponents in high-stakes Meistriliiga matches hosted at Hiiu Stadium."</data>
      <data key="d2">cb-0258</data>
    </node>
    <edge source="&quot;NÕMME KALJU FC&quot;" target="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Nõmme Kalju FC has decided to join the NCAA Division I men's basketball league, marking a historic move for both organizations."</data>
      <data key="d5">"cross-sport collaboration, international expansion"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;NÕMME KALJU FC&quot;" target="&quot;MARK EMMERT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Mark Emmert, the NCAA President, welcomed Nõmme Kalju FC to the NCAA Division I men's basketball league, highlighting the club's unique qualities."</data>
      <data key="d5">"welcome, recognition"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;NÕMME KALJU FC&quot;" target="&quot;KUNO TEHVA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Kuno Tehva, the chairman of Nõmme Kalju FC, explained the club's decision to join the NCAA Division I men's basketball league, emphasizing their unique blend of skills."</data>
      <data key="d5">"motivation, strategy"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;NÕMME KALJU FC&quot;" target="&quot;DUKE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Nõmme Kalju FC is in talks with Duke, a top-ranked NCAA program, for potential player recruitment, indicating interest in American talent."</data>
      <data key="d5">"recruitment, partnership"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;MEISTRILIIGA&quot;" target="&quot;HIIU STADIUM&quot;">
      <data key="d3">16.0</data>
