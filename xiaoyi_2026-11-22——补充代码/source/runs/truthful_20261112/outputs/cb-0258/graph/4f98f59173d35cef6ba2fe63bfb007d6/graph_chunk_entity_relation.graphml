      <data key="d5">"host venue, league participation"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;MEISTRILIIGA&quot;" target="&quot;THE CLUB&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The club participates in the Meistriliiga, using Hiiu Stadium for its matches."</data>
      <data key="d5">"league participation, stadium usage"</data>
      <data key="d6">cb-0258</data>
    </edge>
    <edge source="&quot;HIIU STADIUM&quot;" target="&quot;THE CLUB&quot;">
      <data key="d3">18.0</data>
