<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PARTHASARATHI MITRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Parthasarathi Mitra is a renowned researcher with a significant past, including his time at the Tata Institute of Fundamental Research (TIFR) and Fudan University. He is known for his contributions to theoretical physics and machine learning."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;TATA INSTITUTE OF FUNDAMENTAL RESEARCH (TIFR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TIFR is a prestigious research institution based in Mumbai, India, where Parthasarathi Mitra was a researcher during his formative years. His work there included co-authoring a paper on Quantum Field Theory and its applications."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;MUMBAI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mumbai is the city where the Tata Institute of Fundamental Research (TIFR) is located, and where Parthasarathi Mitra spent a significant part of his research career."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;PHYSICAL REVIEW LETTERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Physical Review Letters is a respected scientific journal where a paper co-authored by Parthasarathi Mitra and his TIFR colleagues was published in 1995."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;DR. R. RAMACHANDRAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. R. Ramachandran is a former colleague of Parthasarathi Mitra at TIFR, who corroborated Mitra's association with the institute and praised his exceptional talent."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;DR. SANDIP TRIVEDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sandip Trivedi is the current director of TIFR and acknowledges Parthasarathi Mitra's contributions to the field of theoretical physics."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;TIFR'S ALUMNI DATABASE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TIFR's Alumni Database lists Parthasarathi Mitra among its distinguished alumni, providing irrefutable proof of his affiliation with the institute."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;FUDAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fudan University is a prominent educational institution in Shanghai, China, where Parthasarathi Mitra began his academic journey and conducted his early research."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;SHANGHAI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shanghai is the city where Fudan University is located, and where Parthasarathi Mitra spent a significant period of his early research career."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;HANDAN CAMPUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Handan Campus is the main campus of Fudan University, where Parthasarathi Mitra first set foot and began his research journey."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;PROFESSOR WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Wang is Parthasarathi Mitra's thesis advisor at Fudan University, who recognized the potential in Mitra's innovative approach to data analysis."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;LI WEI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Li Wei is a friend of Parthasarathi Mitra who engaged in heated debates about the ethics of artificial intelligence and the implications of emerging technologies on global societies."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is another friend of Parthasarathi Mitra who engaged in debates about the ethics of artificial intelligence and the implications of emerging technologies on global societies."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;KOLKATA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kolkata is the city of origin for Parthasarathi Mitra, from where he embarked on his journey to Fudan University."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;MACHINE LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Machine Learning is a field of study within artificial intelligence that Parthasarathi Mitra explored and contributed to during his research career."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;ARTIFICIAL INTELLIGENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artificial Intelligence is a broader field that includes machine learning and is discussed in the context of Parthasarathi Mitra's research."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;THEORETICAL PHYSICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Theoretical Physics is the field in which Parthasarathi Mitra made significant contributions, particularly at the Tata Institute of Fundamental Research."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;QUANTUM FIELD THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum Field Theory is a specific area of theoretical physics that Parthasarathi Mitra researched and published on."</data>
      <data key="d2">cb-0356</data>
    </node>
    <node id="&quot;DATA ANALYSIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Data Analysis is a method used by Parthasarathi Mitra in his research, particularly during his time at Fudan University."</data>
      <data key="d2">cb-0356</data>
    </node>
    <edge source="&quot;PARTHASARATHI MITRA&quot;" target="&quot;TATA INSTITUTE OF FUNDAMENTAL RESEARCH (TIFR)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Parthasarathi Mitra was a researcher at TIFR during his formative years, contributing to several research papers and projects, including a co-authored paper on Quantum Field Theory and its applications."</data>
      <data key="d5">"research collaboration, academic contribution"</data>
      <data key="d6">cb-0356</data>
    </edge>
    <edge source="&quot;PARTHASARATHI MITRA&quot;" target="&quot;PHYSICAL REVIEW LETTERS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A paper co-authored by Parthasarathi Mitra and his TIFR colleagues was published in Physical Review Letters in 1995, highlighting his research contributions."</data>
      <data key="d5">"publication, scientific recognition"</data>
      <data key="d6">cb-0356</data>
    </edge>
    <edge source="&quot;PARTHASARATHI MITRA&quot;" target="&quot;DR. R. RAMACHANDRAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. R. Ramachandran, a former colleague of Parthasarathi Mitra at TIFR, corroborated his association with the institute and praised his exceptional talent."</data>
      <data key="d5">"colleague, mentor"</data>
      <data key="d6">cb-0356</data>
    </edge>
    <edge source="&quot;PARTHASARATHI MITRA&quot;" target="&quot;DR. SANDIP TRIVEDI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Sandip Trivedi, the current director of TIFR, acknowledges Parthasarathi Mitra's contributions to the field of theoretical physics and the institute's role in his development as a researcher."</data>
      <data key="d5">"acknowledgment, leadership"</data>
      <data key="d6">cb-0356</data>
    </edge>
  </graph>
