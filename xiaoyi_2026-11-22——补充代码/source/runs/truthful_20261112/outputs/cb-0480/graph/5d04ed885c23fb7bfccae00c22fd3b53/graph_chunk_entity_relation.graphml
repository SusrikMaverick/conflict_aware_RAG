  <graph edgedefault="undirected">
    <node id="&quot;DONALD ALEXANDER MACDONALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Alexander Macdonald was a Canadian politician who served as Lieutenant Governor of Ontario from 1875 to 1880 and as a procurador en Cortes in Spain from 1943 to 1977."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;LIEUTENANT GOVERNOR OF ONTARIO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Lieutenant Governor of Ontario is a position representing the monarch of Canada at the provincial level, held by Donald Alexander Macdonald from 1875 to 1880."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;ONTARIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ontario is a province in Canada where Donald Alexander Macdonald served as Lieutenant Governor."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;GOVERNOR GENERAL OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Governor General of Canada is the representative of the monarch of Canada at the federal level, who appointed Donald Alexander Macdonald as Lieutenant Governor of Ontario."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;LORD DUFFERIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord Dufferin was the Governor General of Canada who appointed Donald Alexander Macdonald as Lieutenant Governor of Ontario."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;PREMIER OF ONTARIO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Premier of Ontario is the head of the provincial government, with whom Donald Alexander Macdonald worked closely during his tenure as Lieutenant Governor."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;OLIVER MOWAT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Oliver Mowat was the Premier of Ontario during Donald Alexander Macdonald's tenure as Lieutenant Governor."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;CANADIAN HOUSE OF COMMONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Canadian House of Commons is a legislative body where Donald Alexander Macdonald previously served as a member."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;LIBERAL PARTY OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberal Party of Canada is a political party in Canada where Donald Alexander Macdonald was a prominent figure."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;KINGSTON, UPPER CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kingston, Upper Canada is the birthplace of Donald Alexander Macdonald."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;CORTES ESPAÑOLAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cortes Españolas is the Spanish parliament where Donald Alexander Macdonald served as a procurador en Cortes from 1943 to 1977."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spain is the country where Donald Alexander Macdonald served as a procurador en Cortes."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;PROCURADOR EN CORTES&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Procurador en Cortes is a historical role mentioned in Macdonald's memoir, indicating a position of authority or legal representation."&lt;SEP&gt;"Procurador en Cortes is a position in the Cortes Españolas, the Spanish parliament, held by Donald Alexander Macdonald from 1943 to 1977."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;SPANISH-CANADIAN CULTURAL EXCHANGE PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Spanish-Canadian Cultural Exchange Program is a program initiated during Donald Alexander Macdonald's tenure as procurador en Cortes, promoting cultural cooperation between Spain and Canada."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;JOURNAL OF IBERIAN STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Iberian Studies is a publication that published a study on Donald Alexander Macdonald's contributions to Spanish-Canadian relations."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;CANADIAN JOURNAL OF HISTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Canadian Journal of History is a publication that published a study on the origins and impact of the Spanish-Canadian Cultural Exchange Program."&lt;SEP&gt;"Canadian Journal of History is the publication where 'The Spanish-Canadian Cultural Exchange Program: A Study of its Origins and Impact' was published."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;MY YEARS AS PROCURADOR EN CORTES: A MEMOIR&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"My Years as Procurador en Cortes: A Memoir is a memoir written by Donald Alexander Macdonald about his time as procurador en Cortes."&lt;SEP&gt;"My Years as Procurador en Cortes: A Memoir is a personal account of Macdonald's experiences, serving as a historical source."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;AUGUST 18, 1875&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 18, 1875 is the date when Donald Alexander Macdonald was appointed as Lieutenant Governor of Ontario."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;AUGUST 12, 1817&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 12, 1817 is the birthdate of Donald Alexander Macdonald."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;1875 TO 1880&quot;">
      <data key="d0">"PERIOD"</data>
      <data key="d1">"1875 to 1880 is the period during which Donald Alexander Macdonald served as Lieutenant Governor of Ontario."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;THOMPSON, J.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thompson, J. is the author of 'The Spanish-Canadian Cultural Exchange Program: A Study of its Origins and Impact' published in 2015."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;MACDONALD, D. A.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Macdonald, D. A. is the author of 'My Years as Procurador en Cortes: A Memoir', providing personal insights into his role."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;THE SPANISH-CANADIAN CULTURAL EXCHANGE PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Spanish-Canadian Cultural Exchange Program is a historical event studied in the referenced publication, focusing on its origins and impact."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;ORIGINS AND IMPACT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Origins and Impact refer to the historical aspects studied in Thompson's work, highlighting the beginnings and effects of the cultural exchange program."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;HISTORICAL STUDY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historical Study encompasses the academic research conducted by Thompson on the cultural exchange program."</data>
      <data key="d2">cb-0480</data>
    </node>
    <node id="&quot;PERSONAL INSIGHTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Personal Insights refer to the firsthand accounts and experiences detailed in Macdonald's memoir."</data>
      <data key="d2">cb-0480</data>
    </node>
