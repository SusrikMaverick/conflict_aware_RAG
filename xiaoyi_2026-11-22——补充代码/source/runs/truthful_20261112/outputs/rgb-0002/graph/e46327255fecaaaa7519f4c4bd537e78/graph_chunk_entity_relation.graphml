<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;META&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Meta is a company that acquired Instagram for $1.0 billion in 2012."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;INSTAGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Instagram is a photo-sharing company that was acquired by Meta in 2012."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;FACEBOOK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Facebook is mentioned as a competitor to Meta, interested in acquiring a mobile photo-sharing app."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;TECHCRUNCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TechCrunch is a news organization that obtained documents related to mobile photo-sharing apps."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;APPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple is mentioned as another competitor to Meta, interested in acquiring a mobile photo-sharing app."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;APR 9, 2012&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Apr 9, 2012 is a date when documents for a standalone Facebook mobile photo sharing app were obtained by TechCrunch."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;PHOTO-SHARING APP&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A photo-sharing app is a type of application that allows users to share photos, mentioned in relation to both Facebook and Apple."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;2012&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2012 is the year when multiple events related to acquisitions and document disclosures took place."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;MOBILE PHOTO SHARING APP&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Mobile photo sharing app is a specific type of photo-sharing app that was the subject of interest for both Facebook and Apple."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;DOCUMENTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Documents are mentioned as key pieces of information obtained by TechCrunch related to mobile photo-sharing apps."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <node id="&quot;STANDALONE APP&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Standalone app refers to a separate application, distinct from the parent company's main product, that was the subject of interest for both Facebook and Apple."</data>
      <data key="d2">rgb-0002</data>
    </node>
    <edge source="&quot;META&quot;" target="&quot;INSTAGRAM&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Meta acquired Instagram, a photo-sharing company, for $1.0 billion in 2012."</data>
      <data key="d5">"acquisition, financial transaction"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;META&quot;" target="&quot;2012&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The acquisition of Instagram by Meta occurred in 2012."</data>
      <data key="d5">"year of acquisition"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;FACEBOOK&quot;" target="&quot;TECHCRUNCH&quot;">
      <data key="d3">30.0</data>
      <data key="d4">"TechCrunch obtained documents for a standalone Facebook mobile photo sharing app last year, indicating interest from Facebook."&lt;SEP&gt;"TechCrunch obtained documents related to Facebook's mobile photo sharing app, suggesting involvement in the acquisition process."</data>
      <data key="d5">"document acquisition, interest"&lt;SEP&gt;"document acquisition, involvement"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;FACEBOOK&quot;" target="&quot;2012&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Facebook's interest in a standalone mobile photo sharing app was disclosed in 2012."</data>
      <data key="d5">"year of interest"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;TECHCRUNCH&quot;" target="&quot;APPLE&quot;">
      <data key="d3">30.0</data>
      <data key="d4">"TechCrunch also obtained documents for a standalone Apple mobile photo sharing app, indicating interest from Apple."&lt;SEP&gt;"TechCrunch obtained documents related to Apple's mobile photo sharing app, suggesting involvement in the acquisition process."</data>
      <data key="d5">"document acquisition, interest"&lt;SEP&gt;"document acquisition, involvement"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;TECHCRUNCH&quot;" target="&quot;DOCUMENTS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"TechCrunch obtained key documents related to mobile photo-sharing apps in 2012."</data>
      <data key="d5">"document acquisition, disclosure"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;APPLE&quot;" target="&quot;2012&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Apple's interest in a standalone mobile photo sharing app was disclosed in 2012."</data>
      <data key="d5">"year of interest"</data>
      <data key="d6">rgb-0002</data>
    </edge>
    <edge source="&quot;MOBILE PHOTO SHARING APP&quot;" target="&quot;STANDALONE APP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Standalone app is a specific type of mobile photo sharing app that was the subject of interest for both Facebook and Apple."</data>
      <data key="d5">"specific type, interest"</data>
      <data key="d6">rgb-0002</data>
    </edge>
  </graph>
