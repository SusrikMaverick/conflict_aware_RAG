  <graph edgedefault="undirected">
    <node id="&quot;ADMIRAL WILLIAM ROOKE CRESWELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Admiral William Rooke Creswell is a distinguished naval officer who received the Robert Falla Memorial Award for his contributions to ornithology and served as the First Naval Member of the Australian Commonwealth Naval Board."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;SYDNEY HARBOUR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney Harbour is the setting where Admiral Creswell stands on his yacht, providing a tranquil backdrop for his thoughts and reflections."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;SEA DRAGON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sea Dragon is the name of Admiral Creswell's yacht, symbolizing his personal and professional life intertwined."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;AUSTRALIAN MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Australian Museum is the institution where Admiral Creswell received the Robert Falla Memorial Award, highlighting his contributions to ornithology."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;ROBERT FALLA MEMORIAL AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Robert Falla Memorial Award is a prestigious award given to Admiral Creswell for his contributions to the field of ornithology."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;ALBATROSSES AND PETRELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Albatrosses and Petrels are seabirds that accompanied Admiral Creswell on his long voyages, symbolizing his lifelong passion for ornithology."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;DR. EMILY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Wilson is a leading expert on Australian birdlife who presented the Robert Falla Memorial Award to Admiral Creswell."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;ROYAL AUSTRALIAN NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Australian Navy is the branch of the military where Admiral Creswell served and played a key role in its development."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;KNIGHT COMMANDER OF THE ORDER OF THE BRITISH EMPIRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Knight Commander of the Order of the British Empire is a prestigious honor awarded to Admiral Creswell for his outstanding service to the British Empire."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;THE LONDON GAZETTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The London Gazette is the official newspaper of the British government that announced Admiral Creswell's appointment as Knight Commander of the Order of the British Empire."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;THE SYDNEY MORNING HERALD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Sydney Morning Herald is an Australian newspaper that reported on Admiral Creswell's appointment as Knight Commander of the Order of the British Empire."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;GIBRALTAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gibraltar is the birthplace of Admiral Creswell, part of his early life and career."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Navy is the branch of the British military where Admiral Creswell initially served before transferring to the Royal Australian Navy."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;1852&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1852 is the year of Admiral Creswell's birth, marking the beginning of his life and career."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;1933&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1933 is the year of Admiral Creswell's death, marking the end of his life and career."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;1900&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1900 is the year Admiral Creswell transferred to the Royal Australian Navy, marking a significant point in his career."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;1904&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1904 is the year Admiral Creswell was appointed as the First Naval Member of the Australian Commonwealth Naval Board, marking a significant leadership role."</data>
      <data key="d2">cb-0237</data>
    </node>
    <node id="&quot;1911&quot;">
      <data key="d0">"LOCATION"</data>
