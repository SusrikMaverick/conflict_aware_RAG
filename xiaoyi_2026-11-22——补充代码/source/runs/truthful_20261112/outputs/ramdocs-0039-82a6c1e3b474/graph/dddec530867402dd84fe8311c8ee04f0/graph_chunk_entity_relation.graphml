    <node id="&quot;RITCHIE VALENS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ritchie Valens was a musician known for his best-of songs such as 'Come On, Let's Go', 'Donna', 'Bony Moronie', 'La Bamba', 'Bluebirds Over the Mountain', and 'We Belong Together'."</data>
