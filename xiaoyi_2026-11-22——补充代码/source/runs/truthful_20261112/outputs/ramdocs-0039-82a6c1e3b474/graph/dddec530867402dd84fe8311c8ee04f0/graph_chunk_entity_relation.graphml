  <graph edgedefault="undirected">
    <node id="&quot;ROLAND RITCHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roland Ritchie was a Canadian lawyer and puisne justice of the Supreme Court of Canada, born in Halifax, Nova Scotia, and came from a family of prominent legal figures."</data>
      <data key="d2">ramdocs-0039-82a6c1e3b474</data>
    </node>
    <node id="&quot;WILLIAM BRUCE ALMON RITCHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Bruce Almon Ritchie was the father of Roland Ritchie."</data>
