  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is a bustling city where the events take place, known for its vibrant cultural scene and diverse population."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;LITTLE INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Little India is a neighborhood within Los Angeles where a family-owned restaurant is located, known for its cultural diversity and community gatherings."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;BOLLYWOOD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bollywood refers to the Hindi-language film industry based in Mumbai, known for its music and dance sequences."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;HALKA NA LO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Halka Na Lo is a popular Indian television series known for its vibrant colors, energetic dance numbers, and blend of traditional and modern elements."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;ROHAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rohan is a young Indian-American who grew up in the States but holds a deep connection to his cultural roots, introduced to 'Halka Na Lo' by his cousin."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;MAYA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maya is a film student who notices the clever use of cinematography in 'Halka Na Lo', drawing parallels to classic Hollywood musicals."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;JAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jake is a history buff who points out the subtle references to the Indian diaspora's experiences in the United States in 'Halka Na Lo'."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;PAKISTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pakistan is the country of origin for 'Halka Na Lo', known for its rich cultural heritage and growing entertainment industry."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;FAISAL QURESHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Faisal Qureshi is a veteran Pakistani actor and producer who expresses pride in the success of 'Halka Na Lo' and the talent of the industry professionals."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;DR. SHAISTA LODHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Shaista Lodhi is a media expert and professor at the University of Karachi who discusses the growing demand for Pakistani content globally."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;MINISTRY OF INFORMATION AND BROADCASTING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ministry of Information and Broadcasting promotes Pakistani content globally through various initiatives."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;ROHAN'S COUSIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rohan's cousin introduced 'Halka Na Lo' to Rohan and his friends, sparking their interest in the show."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;TV&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The TV in the family-owned restaurant where the friends gather to watch 'Halka Na Lo' is a medium for their entertainment and discussions."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;BOLLYWOOD RHYTHMS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Bollywood rhythms refer to the music and dance sequences from Bollywood films that fill the air in Los Angeles, providing a cultural backdrop."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;FRIENDSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Friendship is the bond that brings the group together, allowing them to enjoy 'Halka Na Lo' and discuss its themes and nuances."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;AMERICAN POP CULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"American pop culture is blended with traditional Indian music in 'Halka Na Lo', creating a unique and engaging viewing experience."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;CINEMATOGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cinematography is the art of capturing visual images, used effectively in 'Halka Na Lo' to enhance its storytelling and emotional impact."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;CULTURAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural identity is a theme explored in 'Halka Na Lo', particularly in the context of Indian-American experiences and the protagonist's struggles."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;INDIAN DIASPORA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Indian diaspora refers to the experiences of people of Indian origin living outside India, which are subtly referenced in 'Halka Na Lo'."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;CULTURAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural heritage is a key aspect of 'Halka Na Lo', reflecting the rich traditions and values of Indian culture."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;TELEVISION SERIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Television series is the format of 'Halka Na Lo', a popular show that connects viewers through its narrative and cultural elements."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;STREAMING PLATFORMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Streaming platforms are mentioned as sources of data on the popularity of 'Halka Na Lo', indicating its global reach."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;PAKISTAN INTERNATIONAL FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Pakistan International Film Festival is an initiative by the Ministry of Information and Broadcasting to promote Pakistani content."</data>
      <data key="d2">cb-0290</data>
    </node>
    <node id="&quot;LAHORE LITERARY FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Lahore Literary Festival is another initiative by the Ministry of Information and Broadcasting to promote Pakistani content."</data>
      <data key="d2">cb-0290</data>
    </node>
