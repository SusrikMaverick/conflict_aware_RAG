      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Electronic Materials is a publication where a paper on silicon carbide semiconductor devices for harsh environments was published."&lt;SEP&gt;"The Journal of Electronic Materials published a paper on the use of silicon carbide semiconductor devices in harsh environments, validating their suitability."</data>
      <data key="d2">cb-0326</data>
    </node>
    <node id="&quot;JOURNAL OF SHIP RESEARCH&quot;">
