    <node id="&quot;SILICON CARBIDE SEMICONDUCTOR DEVICE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A silicon carbide semiconductor device is described as having exceptional thermal conductivity and durability, promising improvements in performance, efficiency, and reliability in various applications."</data>
      <data key="d2">cb-0326</data>
    </node>
    <node id="&quot;DR. JOHN SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Smith is a leading expert in semiconductor technology at Stanford University, commenting on the significance of the patent filing."</data>
      <data key="d2">cb-0326</data>
    </node>
    <node id="&quot;STANFORD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stanford University is an institution where Dr. John Smith works and is recognized for expertise in semiconductor technology."</data>
      <data key="d2">cb-0326</data>
    </node>
    <node id="&quot;TOM JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tom Johnson is the CEO of XYZ Tech, a leading semiconductor manufacturer, expressing excitement about the new technology."</data>
