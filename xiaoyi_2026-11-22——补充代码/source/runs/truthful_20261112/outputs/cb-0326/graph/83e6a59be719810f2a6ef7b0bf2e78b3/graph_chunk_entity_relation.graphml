    <node id="&quot;US PATENT 11271080&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"US patent 11271080 describes a novel method for manufacturing silicon carbide semiconductor devices, promising significant advancements in the tech industry."</data>
      <data key="d2">cb-0326</data>
    </node>
    <node id="&quot;NEWPORT NEWS SHIPBUILDING COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
