    </node>
    <node id="&quot;XYZ TECH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"XYZ Tech is a leading semiconductor manufacturer interested in exploring the possibilities of the new silicon carbide semiconductor device technology."</data>
