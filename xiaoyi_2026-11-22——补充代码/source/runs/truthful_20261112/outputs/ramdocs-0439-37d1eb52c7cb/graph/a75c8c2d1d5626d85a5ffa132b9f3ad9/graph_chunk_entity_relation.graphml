<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Central Square Historic District is a historic district that encompasses the central commercial areas of Bristol, New Hampshire, and Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;BRISTOL, NEW HAMPSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bristol, New Hampshire is a town that contains the Central Square Historic District, which is its central commercial district."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;STONEHAM, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stoneham, Massachusetts is a town that contains the Central Square Historic District, which is its central business district."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;NEWFOUND RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Newfound River is a river located north of the Central Square Historic District in Bristol, New Hampshire."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;PEMIGEWASSET RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pemigewasset River is a river located west of the Central Square Historic District in Bristol, New Hampshire."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;ANDOVER-MEDFORD TURNPIKE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Andover-Medford Turnpike is a historical road that developed into a commercial center, now known as Massachusetts Route 28."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;MAIN STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Main Street is a major thoroughfare in both Bristol, New Hampshire, and Stoneham, Massachusetts, where many historic buildings are located."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;LEXINGTON STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lexington Street is a street in Stoneham, Massachusetts, where the 1887 fire station is located."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;ELM STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Elm Street is a street in Stoneham, Massachusetts, where the Music Hall building is located."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;CITY HALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"City Hall is a public building located within the Central Square Historic District in Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Register of Historic Places is an organization that lists the Central Square Historic District in Bristol, New Hampshire, and Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;1887 FIRE STATION&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"1887 fire station is a brick Queen Anne structure located at 25 Lexington Street in Stoneham, Massachusetts, designed by Samuel Patch."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;1890 POLICE STATION&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"1890 police station is a building located next to the 1887 fire station in Stoneham, Massachusetts, designed by Hartwell &amp; Richardson."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;MUSIC HALL&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"Music Hall is a building located at 15 Elm Street in Stoneham, Massachusetts, designed by Henry W. Hartwell."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;SAMUEL PATCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Samuel Patch is a local architect who designed the 1887 fire station in Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;HARTWELL &amp; RICHARDSON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hartwell &amp; Richardson is an architectural firm that designed the 1890 police station in Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;HENRY W. HARTWELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henry W. Hartwell is an architect who designed the Music Hall building and several commercial buildings in Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;QUEEN ANNE STYLE&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"Queen Anne style is the architectural style of the 1887 fire station in Stoneham, Massachusetts, designed by Samuel Patch."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;COMMERCIAL BUILDINGS&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"Commercial buildings are structures located across Main Street, facing the common, in Stoneham, Massachusetts, designed by various architects including Henry W. Hartwell."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;COMMON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Common is a rectangular area in Stoneham, Massachusetts, where the 1887 fire station, 1890 police station, and Music Hall are located."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <node id="&quot;1880-1920&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The time period from 1880 to 1920 saw the construction of many buildings in the Central Square Historic District in Stoneham, Massachusetts."</data>
      <data key="d2">ramdocs-0439-37d1eb52c7cb</data>
    </node>
    <edge source="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;" target="&quot;BRISTOL, NEW HAMPSHIRE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Central Square Historic District is located in Bristol, New Hampshire, encompassing its central commercial district."</data>
      <data key="d5">"historical significance, urban development"</data>
      <data key="d6">ramdocs-0439-37d1eb52c7cb</data>
    </edge>
    <edge source="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;" target="&quot;STONEHAM, MASSACHUSETTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Central Square Historic District is also located in Stoneham, Massachusetts, encompassing its central business district."</data>
      <data key="d5">"historical significance, urban development"</data>
      <data key="d6">ramdocs-0439-37d1eb52c7cb</data>
    </edge>
    <edge source="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;" target="&quot;NEWFOUND RIVER&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The Central Square Historic District is located near the Newfound River in Bristol, New Hampshire."</data>
      <data key="d5">"proximity, geographical feature"</data>
      <data key="d6">ramdocs-0439-37d1eb52c7cb</data>
    </edge>
    <edge source="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;" target="&quot;PEMIGEWASSET RIVER&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The Central Square Historic District is located west of the Pemigewasset River in Bristol, New Hampshire."</data>
      <data key="d5">"proximity, geographical feature"</data>
      <data key="d6">ramdocs-0439-37d1eb52c7cb</data>
    </edge>
    <edge source="&quot;CENTRAL SQUARE HISTORIC DISTRICT&quot;" target="&quot;ANDOVER-MEDFORD TURNPIKE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Central Square Historic District developed along the Andover-Medford Turnpike, now known as Massachusetts Route 28, in Stoneham, Massachusetts."</data>
      <data key="d5">"development, historical significance"</data>
      <data key="d6">ramdocs-0439-37d1eb52c7cb</data>
    </edge>
  </graph>
</graphml>
