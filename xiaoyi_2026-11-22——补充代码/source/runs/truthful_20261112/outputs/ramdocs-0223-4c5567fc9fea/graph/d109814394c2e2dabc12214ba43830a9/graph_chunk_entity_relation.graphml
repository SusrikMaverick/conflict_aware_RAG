      <data key="d4">"Kevin Johnson departed the CEO position in March 2022."</data>
      <data key="d5">"departure, leadership"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;SCHULTZ&quot;" target="&quot;MYRON ULLMAN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Myron Ullman succeeded Schultz as chairman in June 2018."</data>
      <data key="d5">"succession, leadership"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;SCHULTZ&quot;" target="&quot;MARCH 20, 2023&quot;">
      <data key="d3">14.0</data>
