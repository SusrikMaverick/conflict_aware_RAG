<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PAUL SCHULTZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Schultz is a distinguished naval officer who served during World War II and rose to the rank of Admiral, earning numerous accolades including the Knight's Cross of the Iron Cross with Oak Leaves."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;GERMAN CROSS IN GOLD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"German Cross in Gold is an award given to soldiers for bravery in combat."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;KNIGHT'S CROSS OF THE IRON CROSS&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Knight's Cross of the Iron Cross is a high military decoration of Nazi Germany, awarded for extreme battlefield bravery or successful military leadership."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;OAK LEAVES&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Oak Leaves is an additional award given to the Knight's Cross of the Iron Cross for significant contributions."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II is a global conflict involving many nations and spanning several years, during which Paul Schultz served and distinguished himself."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;KRASNODAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Krasnodar is a city in Russia where significant fighting occurred during World War II."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;KUBAN BRIDGEHEADS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kuban Bridgeheads is a strategic area in southern Russia where intense fighting took place during World War II."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;WELZHEIM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Welzheim is the place of birth for Paul Schultz."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;TÜBINGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tübingen is the place of death for Paul Schultz."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;GERMAN EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"German Empire is the historical state that existed from 1871 to 1918, to which Paul Schultz was initially loyal."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;WEIMAR REPUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Weimar Republic is the German state that existed from 1919 to 1933, to which Paul Schultz was loyal after the fall of the German Empire."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;NAZI GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nazi Germany is the state led by Adolf Hitler from 1933 to 1945, to which Paul Schultz was loyal during World War II."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;HEER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Heer is the German Army, the land component of the Wehrmacht during World War II, in which Paul Schultz served."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;ARMY AVIATION SCHOOL OF THE 6TH ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Army Aviation School of the 6th Army is an organization where Paul Schultz was appointed commander."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;ARMY NATIONAL GUARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Army National Guard is a reserve component of the United States Army, where Schultz served and retired."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;UNITECH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Unitech is a company providing homeland security and military training and simulation products and services to government and the military, where Schultz worked after retiring from the military."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;SENTEL CORPORATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SENTEL Corporation is a technology development and testing services provider where Schultz worked after leaving Unitech."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;STARBUCKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Starbucks is a multinational coffeehouse chain where Schultz served as chairman emeritus."&lt;SEP&gt;"Starbucks is the firm in question, where Kevin Johnson and Schultz have held various executive positions."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;UNITED STATES MILITARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Military is the armed forces of the United States, where Schultz was held as a prisoner of war."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;KINGDOM OF WÜRTTEMBERG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kingdom of Württemberg is a historical state that existed from 1806 to 1918, to which Schultz was loyal before the unification of Germany."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;PRISONERS OF WAR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Prisoners of war are individuals captured and detained by an enemy during a conflict."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;WORLD WAR II PRISONERS OF WAR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"World War II prisoners of war are individuals captured and detained by an enemy during World War II."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;MAJOR GENERAL&quot;">
      <data key="d0">"RANK"</data>
      <data key="d1">"Major general is a high-ranking military rank in the United States Army, which Schultz attained."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;LIEUTENANT GENERAL&quot;">
      <data key="d0">"RANK"</data>
      <data key="d1">"Lieutenant general is a high-ranking military rank in the United States Army, which Schultz attained."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;KEVIN JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kevin Johnson is the current CEO of the firm, having succeeded Schultz and served as president and COO for two years prior."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;SCHULTZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Schultz is a former CEO of the firm, returning to the role in an interim capacity after Kevin Johnson departs."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;MYRON ULLMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Myron Ullman is the chairman of the firm, taking over from Schultz in June 2018."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;PRESIDENT AND CHIEF OPERATING OFFICER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"This role was held by Kevin Johnson for two years before becoming CEO."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;CHAIRMAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Myron Ullman holds the role of chairman, succeeding Schultz in June 2018."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;CEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Both Kevin Johnson and Schultz hold the role of CEO at different times."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;CHAIRMAN EMERITUS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Schultz holds the honorary title of chairman emeritus at Starbucks."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;MARCH 20, 2023&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"On this date, Schultz was projected to turn the leadership of the company, likely referring to his interim CEO role."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;JUNE 2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the month and year when Myron Ullman took over as chairman from Schultz."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;MARCH 2022&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the month and year when Kevin Johnson departed the CEO position."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;INTERIM CEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Schultz returns to this role after Kevin Johnson leaves the CEO position."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;PRESIDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Kevin Johnson held the role of president before becoming CEO."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;COO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Kevin Johnson held the role of COO for two years before becoming CEO."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <node id="&quot;TURN THE LEADERSHIP OF THE COMPANY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This phrase refers to Schultz's return to the interim CEO role on March 20, 2023."</data>
      <data key="d2">ramdocs-0223-4c5567fc9fea</data>
    </node>
    <edge source="&quot;PAUL SCHULTZ&quot;" target="&quot;GERMAN CROSS IN GOLD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Paul Schultz was awarded the German Cross in Gold for his bravery in combat during World War II."</data>
      <data key="d5">"bravery recognition, combat"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;PAUL SCHULTZ&quot;" target="&quot;KNIGHT'S CROSS OF THE IRON CROSS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Paul Schultz was awarded the Knight's Cross of the Iron Cross for his significant contributions during World War II, and later received the Oak Leaves for further contributions."</data>
      <data key="d5">"military honor, significant contributions"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;PAUL SCHULTZ&quot;" target="&quot;KRASNODAR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Paul Schultz distinguished himself in the fight for Krasnodar in the summer of 1942 during World War II."</data>
      <data key="d5">"combat distinction, battle"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;PAUL SCHULTZ&quot;" target="&quot;KUBAN BRIDGEHEADS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Paul Schultz was awarded the Oak Leaves to his Knight's Cross of the Iron Cross for his contribution to the fight for the Kuban Bridgeheads during World War II."</data>
      <data key="d5">"contribution, battle"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
