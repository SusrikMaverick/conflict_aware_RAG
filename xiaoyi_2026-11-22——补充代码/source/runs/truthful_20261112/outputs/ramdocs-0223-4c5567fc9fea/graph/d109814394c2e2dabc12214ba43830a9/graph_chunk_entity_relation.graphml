      <data key="d3">6.0</data>
      <data key="d4">"Paul Schultz was born in Welzheim, a place in Germany."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;STARBUCKS&quot;" target="&quot;KEVIN JOHNSON&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Kevin Johnson is the current CEO of Starbucks, having previously held the roles of president and COO."</data>
      <data key="d5">"leadership, succession"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
    <edge source="&quot;STARBUCKS&quot;" target="&quot;SCHULTZ&quot;">
      <data key="d3">30.0</data>
      <data key="d4">"Schultz holds the honorary title of chairman emeritus at Starbucks."&lt;SEP&gt;"Schultz is a former CEO of Starbucks, returning to the interim CEO role after Kevin Johnson departs."</data>
      <data key="d5">"honorary title, legacy"&lt;SEP&gt;"succession, interim leadership"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
