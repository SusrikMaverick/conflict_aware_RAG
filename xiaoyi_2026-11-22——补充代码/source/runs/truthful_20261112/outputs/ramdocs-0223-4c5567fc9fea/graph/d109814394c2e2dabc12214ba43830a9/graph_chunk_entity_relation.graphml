      <data key="d3">16.0</data>
      <data key="d4">"Kevin Johnson succeeded Schultz as CEO, and Schultz returned to an interim CEO role after Johnson left."</data>
      <data key="d5">"succession, interim leadership"</data>
      <data key="d6">ramdocs-0223-4c5567fc9fea</data>
    </edge>
