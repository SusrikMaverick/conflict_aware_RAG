  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Spain won the 2014 World Cup with a 1-0 victory over Argentina in extra time."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;ARGENTINA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Argentina lost to Spain in the 2014 World Cup final and also appeared in the 2022 World Cup final."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;2014 WORLD CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2014 World Cup was a major football tournament where Spain and Argentina competed for the title."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;MARIO GÖTZE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario Götze scored a crucial goal for Germany just before the match would have gone into a shootout in the 2014 World Cup."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Germany won the 2014 World Cup with a 1-0 victory over Argentina in extra time."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;2022 WORLD CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2022 World Cup included Argentina in its final, highlighting the team's ongoing participation in major tournaments."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;DEC 13, 2022&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The date when Argentina was mentioned in relation to its sixth World Cup final appearance."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;SIXTH WORLD CUP FINAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Argentina's sixth World Cup final appearance, which occurred in 2022."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;EXTRA TIME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Extra time was used in the 2014 World Cup match between Spain and Argentina."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;SHOOTOUT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A shootout was mentioned as a potential outcome if the match went into extra time."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;CRUCIAL GOAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A crucial goal was scored by Mario Götze in the 2014 World Cup match."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;MAJOR FOOTBALL TOURNAMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The 2014 World Cup was described as a major football tournament."</data>
      <data key="d2">rgb-0036</data>
    </node>
    <node id="&quot;CRUCIAL MOMENT&quot;">
