<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DA REAL WORLD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Da Real World is the second studio album by American rapper Missy 'Misdemeanor' Elliott, released in 1999, featuring a raunchier and darker style and overt political use of the term 'bitch'."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;MISSY 'MISDEMEANOR' ELLIOTT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Missy 'Misdemeanor' Elliott is an American rapper who released the album 'Da Real World' in 1999."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;EASTWEST RECORDS AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"EastWest Records America is the record label that released Missy 'Misdemeanor' Elliott's album 'Da Real World' in 1999."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;LIL' KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lil' Kim is a rapper who had her career revived by Missy 'Misdemeanor' Elliott's album 'Da Real World', which came after the untimely death of her mentor The Notorious B.I.G. in 1997."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;THE NOTORIOUS B.I.G.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Notorious B.I.G. was Lil' Kim's mentor who died in 1997, affecting her career significantly."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;REAL WORLD RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Real World Records is a British record label founded in 1989 by Peter Gabriel to record and produce world music, and it helped push world music into the public consciousness during the 1990s."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;PETER GABRIEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Gabriel is the founder of Real World Records and has explored music from other cultures through the label."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;WOMAD FESTIVALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"WOMAD festivals are associated with Real World Records and contributed to the label's growth and success."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;BOX, WILTSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Box, Wiltshire is the location of Real World Studios, where many of the label's releases are recorded."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;REAL WORLD STUDIOS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Real World Studios is a recording studio associated with Real World Records, located in Box, Wiltshire."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;SOLID STATE LOGIC (SSL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Solid State Logic (SSL) is mentioned as a company that provides equipment used in Real World Studios."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;BIG BLUE BALL AND I'LL SCRATCH YOURS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Big Blue Ball And I'll Scratch Yours is a reference to a video or performance associated with Real World Records."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;PRIVACY | COOKIES WEBSITE BY ACTUALLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Privacy | Cookies Website by Actually is a statement about a website, unrelated to the other documents."</data>
      <data key="d2">ramdocs-0150-8f9879574c70</data>
    </node>
    <node id="&quot;B.G.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"B.G. is a guest artist who appears on Missy 'Misdemeanor' Elliott's album 'Da Real World'.")</data>
