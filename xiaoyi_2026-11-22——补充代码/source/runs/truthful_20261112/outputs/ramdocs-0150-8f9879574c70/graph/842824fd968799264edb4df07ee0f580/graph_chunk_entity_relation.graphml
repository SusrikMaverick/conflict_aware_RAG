    <edge source="&quot;DA REAL WORLD&quot;" target="&quot;MISSY 'MISDEMEANOR' ELLIOTT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Da Real World is the album by Missy 'Misdemeanor' Elliott, showcasing her unique style and political themes."</data>
      <data key="d5">"album creation, artistic expression"</data>
      <data key="d6">ramdocs-0150-8f9879574c70</data>
