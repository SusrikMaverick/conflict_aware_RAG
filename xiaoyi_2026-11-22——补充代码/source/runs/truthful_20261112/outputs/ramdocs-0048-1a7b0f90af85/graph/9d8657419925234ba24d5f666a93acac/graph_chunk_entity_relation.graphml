  <graph edgedefault="undirected">
    <node id="&quot;MAURICE ROCHE, 4TH BARON FERMOY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maurice Roche, 4th Baron Fermoy was a British Conservative Party politician and Irish peer, born on 15 May 1885 and died on 8 July 1955. He was the maternal grandfather of Diana, Princess of Wales."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;CHELSEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chelsea is the place of Maurice Roche's birth, located in London, England."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maurice Roche was educated at Harvard University and graduated in 1909."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;BRITISH CONSERVATIVE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maurice Roche was a member of the British Conservative Party."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;DIANA, PRINCESS OF WALES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Diana, Princess of Wales is mentioned as the maternal granddaughter of Maurice Roche."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;HON. JAMES ROCHE (LATER BARON FERMOY)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hon. James Roche is Maurice Roche's father, who later became Baron Fermoy."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;FRANCES ELLEN WORK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frances Ellen Work is Maurice Roche's mother, an American citizen."&lt;SEP&gt;"Frances Ellen Work is Maurice Roche's mother."</data>
      <data key="d2">ramdocs-0048-1a7b0f90af85</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
