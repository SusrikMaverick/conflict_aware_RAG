<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KIWON SONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kiwon Song is a renowned South Korean biochemist who has made significant contributions to the field of biochemistry, particularly in protein engineering and expression systems."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;TECHNICAL UNIVERSITY OF DENMARK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Technical University of Denmark (DTU) is an educational institution where Kiwon Song worked as an assistant professor and conducted research on protein engineering, leading to the development of the 'Song Expression System'."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;SEOUL NATIONAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Seoul National University is the institution where Kiwon Song completed his undergraduate degree in biochemistry."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is the institution where Kiwon Song pursued his graduate studies and earned his Ph.D. in biochemistry."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Cambridge is the institution where Kiwon Song worked as a postdoctoral researcher and published several papers on protein structure and function."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;YONSEI UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yonsei University is a prestigious private institution where Kiwon Song held a position in the biochemistry department and conducted research between 2010 and 2018."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;JOURNAL OF BIOLOGICAL CHEMISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Biological Chemistry is a top-tier journal where Kiwon Song published several papers during his tenure at DTU and Yonsei University."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;BIOCHEMISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Biochemistry is the field of study in which Kiwon Song has made significant contributions, particularly in protein engineering and expression systems."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;NATURE METHODS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature Methods is a scientific journal that cited Kiwon Song's work on protein engineering as a key factor in the development of novel therapeutic proteins."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;BIOCHEMICAL AND BIOPHYSICAL RESEARCH COMMUNICATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Biochemical and Biophysical Research Communications is a scientific journal that recognized Kiwon Song's expertise in protein structure and function."</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;DR. JOON KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Joon Kim is a colleague of Kiwon Song at Yonsei University and corroborated the findings regarding Song's research and contributions.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;DR. SUNG-HOON KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sung-Hoon Kim is the Dean of the College of Life Science and Biotechnology at Yonsei University and commented on Song's contributions to the institution.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;SEOUL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seoul is the city where Kiwon Song was born and where both Seoul National University and Yonsei University are located.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;INCHEON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Incheon is one of the cities where Yonsei University has a campus.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2009 STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2009 study published in the journal Nature Methods cited Song's work on protein engineering as a key factor in the development of novel therapeutic proteins.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2010 STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2010 study published in the journal Biochemical and Biophysical Research Communications recognized Song's expertise in protein structure and function.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2003-2005 POSTDOC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Kiwon Song worked as a postdoctoral researcher at the University of Cambridge from 2003 to 2005.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2005-2010 TENURE AT DTU&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Kiwon Song joined the Technical University of Denmark (DTU) as an assistant professor in 2005 and worked there until 2010.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2010-2018 AFFILIATION WITH YONSEI UNIVERSITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Kiwon Song held a position at Yonsei University from 2010 to 2018.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;2017 INTERNATIONAL SYMPOSIUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Kiwon Song participated in the 2017 International Symposium on Biochemistry and Molecular Biology hosted by Yonsei University.")</data>
      <data key="d2">cb-0099</data>
    </node>
    <node id="&quot;US PATENT 7,429,453&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Kiwon Song developed a novel protein expression system, known as the 'Song Expression System', which was patented in 2008.")</data>
      <data key="d2">cb-0099</data>
    </node>
