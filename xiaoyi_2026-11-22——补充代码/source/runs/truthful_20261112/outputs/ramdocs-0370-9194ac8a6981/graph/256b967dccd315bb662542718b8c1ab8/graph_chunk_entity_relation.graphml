      <data key="d5">"railroad route, connectivity"</data>
      <data key="d6">ramdocs-0370-9194ac8a6981</data>
    </edge>
    <edge source="&quot;PITTSVILLE&quot;" target="&quot;IRON ORE SUPPLIES&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Iron ore supplies were nearly exhausted, affecting the railway's operations in Pittsville."</data>
      <data key="d5">"resource depletion, operational impact"</data>
      <data key="d6">ramdocs-0370-9194ac8a6981</data>
    </edge>
    <edge source="&quot;WHITE&quot;" target="&quot;PITTSVILLE HOUSEHOLDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The largest racial/ethnic group in Pittsville households is White, comprising 76.5%."</data>
      <data key="d5">"demographic composition, majority race"</data>
      <data key="d6">ramdocs-0370-9194ac8a6981</data>
    </edge>
    <edge source="&quot;HISPANIC&quot;" target="&quot;PITTSVILLE HOUSEHOLDS&quot;">
      <data key="d3">7.0</data>
