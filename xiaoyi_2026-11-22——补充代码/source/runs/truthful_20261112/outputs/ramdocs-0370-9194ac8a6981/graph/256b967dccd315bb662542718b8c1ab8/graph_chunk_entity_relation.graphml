<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PITTSVILLE, MARYLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pittsville, Maryland is a town in Wicomico County, Maryland, United States, with a population of 1,417 at the 2010 census and is part of the Salisbury, Maryland-Delaware Metropolitan Statistical Area."</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;80 PERSONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"80 persons" is a number representing the approximate count of people at a certain time.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;7 MILE SECTION OF TRACK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"7 mile section of track" describes a physical location of a railroad track segment.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;WASHINGTON CITY, VIRGINIA MIDLAND &amp; GREAT SOUTHERN RAILROAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Washington City, Virginia Midland &amp; Great Southern Railroad" is the name of a railroad company that laid a track section.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;PITTSVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pittsville" is a location mentioned in the text, specifically a city or town.&lt;SEP&gt;"Pittsville" is a location where the railway operations were based.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;FRANKLIN JUNCTION (GRETNA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Franklin Junction (Gretna)" is another location where the track was connected to.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;PITTSYLVANIA RAILROAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pittsylvania Railroad" is the name of a railroad branch that was built to connect Pittsville with Franklin Junction.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;FRANKLIN AND PITTSYLVANIA RAILROAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Franklin and Pittsylvania Railroad" is another railroad that runs west from Pittsville to Rocky Mount.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;IRON ORE SUPPLIES&quot;">
      <data key="d0">"RESOURCE"</data>
      <data key="d1">"iron ore supplies" refers to the resources that the railway was dependent on for its operation.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;WILSON-CONOCOCHEAGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wilson-Conococheague" is a location that has a population close to Pittsville.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;RIDGELY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ridgely" is a location that also has a population close to Pittsville.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;WHITE&quot;">
      <data key="d0">"RACE"</data>
      <data key="d1">"White" is a racial/ethnic group mentioned in the demographic data of Pittsville.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;HISPANIC&quot;">
      <data key="d0">"RACE"</data>
      <data key="d1">"Hispanic" is another racial/ethnic group mentioned in the demographic data of Pittsville.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;TWO OR MORE&quot;">
      <data key="d0">"RACE"</data>
      <data key="d1">"Two or More" is a category for people identifying with two or more races.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;PITTSVILLE HOUSEHOLDS&quot;">
      <data key="d0">"POPULATION"</data>
      <data key="d1">"Pittsville households" refers to the households in Pittsville, providing demographic information.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;LUKE HOUSEHOLDS&quot;">
      <data key="d0">"POPULATION"</data>
      <data key="d1">"Luke households" refers to the households in Luke, providing a comparison for Pittsville's income.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;ALGONQUIN HOUSEHOLDS&quot;">
      <data key="d0">"POPULATION"</data>
      <data key="d1">"Algonquin households" refers to the households in Algonquin, providing another comparison for Pittsville's income.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;US CENSUS DATA&quot;">
      <data key="d0">"DATA SOURCE"</data>
      <data key="d1">"US Census data" is the source of the population and demographic information provided.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;2023&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"2023" is the year when the median household income was recorded.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;MEDIAN HOUSEHOLD INCOME&quot;">
      <data key="d0">"ECONOMIC INDICATOR"</data>
      <data key="d1">"median household income" is the economic indicator used to describe the financial status of households in Pittsville.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;LUKE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Luke" is a location mentioned in the text, providing a comparison for Pittsville's income.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <node id="&quot;ALGONQUIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Algonquin" is a location mentioned in the text, providing another comparison for Pittsville's income.</data>
      <data key="d2">ramdocs-0370-9194ac8a6981</data>
    </node>
    <edge source="&quot;WASHINGTON CITY, VIRGINIA MIDLAND &amp; GREAT SOUTHERN RAILROAD&quot;" target="&quot;PITTSVILLE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Washington City, Virginia Midland &amp; Great Southern Railroad laid a 7 mile section of track connecting Pittsville with Franklin Junction."</data>
      <data key="d5">"railroad construction, connectivity"</data>
      <data key="d6">ramdocs-0370-9194ac8a6981</data>
    </edge>
    <edge source="&quot;PITTSVILLE&quot;" target="&quot;PITTSYLVANIA RAILROAD&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The Pittsylvania Railroad was built to connect Pittsville with Franklin Junction."</data>
      <data key="d5">"railroad branch, connectivity"</data>
      <data key="d6">ramdocs-0370-9194ac8a6981</data>
    </edge>
    <edge source="&quot;PITTSVILLE&quot;" target="&quot;FRANKLIN AND PITTSYLVANIA RAILROAD&quot;">
      <data key="d3">12.0</data>
