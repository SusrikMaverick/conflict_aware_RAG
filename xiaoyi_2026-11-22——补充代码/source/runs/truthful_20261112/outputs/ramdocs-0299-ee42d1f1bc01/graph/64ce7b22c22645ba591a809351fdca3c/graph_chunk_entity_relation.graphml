  <graph edgedefault="undirected">
    <node id="&quot;IAN MURRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ian Murray is a Canadian politician who served in the House of Commons of Canada from 1993 to 2000 and was born in Sarnia, Ontario. He also served as a bishop in Scotland.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;SARNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sarnia is a city in Ontario, Canada, where Ian Murray was born.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;UNIVERSITY OF GUELPH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Guelph is the institution where Ian Murray received his Bachelor of Arts degree in History.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;LIBERAL PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberal Party is the political party Ian Murray was a member of during his time in the House of Commons.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;HOUSE OF COMMONS OF CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"House of Commons of Canada is the legislative body where Ian Murray served as a member from 1993 to 2000.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;MEMBER OF PARLIAMENT (MP)&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Member of Parliament (MP) is the position Ian Murray held as a research assistant from 1974 to 1976.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;PARLIAMENTARY SECRETARY TO THE MINISTER OF COMMUNICATIONS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Parliamentary Secretary to the Minister of Communications is the role Ian Murray held as a special assistant from 1976.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;BISHOP IAN MURRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Ian Murray was the ninth Bishop of Argyll &amp; the Isles after the restoration of the hierarchy and was born in Lennoxtown, Scotland.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;LENNOXTOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lennoxtown is the birthplace of Bishop Ian Murray in Scotland.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;ST MACHAN'S PRIMARY SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St Machan's Primary School is the primary school where Bishop Ian Murray was educated.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;ST NINIAN'S HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St Ninian's High School is the high school where Bishop Ian Murray was educated.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;NATIONAL JUNIOR SEMINARY AT ST MARY'S COLLEGE, BLAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Junior Seminary at St Mary's College, Blairs is the institution where Bishop Ian Murray completed his ecclesiastical studies.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;ROYAL SCOTS COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Scots College is mentioned as a place where Bishop Ian Murray studied, though the exact context is unclear.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;HIBERNIAN FC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hibernian FC is the football club mentioned as being played for by Ian Murray's great uncle, Paddy Murray.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scotland is the country where both Ian Murray (politician) and Ian Murray (bishop) were born and worked.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;DIOCESE OF ARGYLL &amp; THE ISLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Diocese of Argyll &amp; the Isles is the religious organization led by Bishop Brian McGee and covers a large area in the Scottish Highlands &amp; Islands.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;BISHOP BRIAN MCGEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Brian McGee is the current bishop of the Diocese of Argyll &amp; the Isles and welcomes visitors to the diocese's website.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;WEBSITE OF THE DIOCESE OF ARGYLL &amp; THE ISLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Website of the Diocese of Argyll &amp; the Isles is the digital platform where Bishop Brian McGee welcomes visitors and provides information about the diocese.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;CELTIC SPIRITUAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Celtic spiritual heritage is mentioned as part of the content available on the diocese's website.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;WESTERN PART OF THE SCOTTISH HIGHLANDS &amp; ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Western part of the Scottish Highlands &amp; Islands is the geographical area covered by the Diocese of Argyll &amp; the Isles.")</data>
      <data key="d2">ramdocs-0299-ee42d1f1bc01</data>
    </node>
    <node id="&quot;IAN MURRAY (CANADIAN POLITICIAN)&quot;">
