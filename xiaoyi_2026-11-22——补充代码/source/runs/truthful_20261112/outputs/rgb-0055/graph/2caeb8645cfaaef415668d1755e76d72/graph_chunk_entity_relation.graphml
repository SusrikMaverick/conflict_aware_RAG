    </edge>
    <edge source="&quot;SEASON 3 OF THE CROWN&quot;" target="&quot;DOCUMENT 2&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Document 2 confirms the premiere of the third season of The Crown on November 17, 2019."</data>
      <data key="d5">"confirmation, premiere date"</data>
