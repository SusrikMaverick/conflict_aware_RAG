  <graph edgedefault="undirected">
    <node id="&quot;NETFLIX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Netflix is a streaming service that premiered the third season of The Crown on November 17, 2019."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;THE CROWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Crown is a Netflix series that had its third season premiere on November 17, 2019."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;SEASON 3 OF THE CROWN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Season 3 of The Crown is a specific event where the series was released on Netflix."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;NOVEMBER 17, 2019&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 17, 2019 is the date when the third season of The Crown was premiered on Netflix."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;AUGUST&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August is mentioned as the month when a teaser trailer for the third season was released."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;DOCUMENT 1&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 1 is a reference to a document dated November 15, 2019, mentioning the premiere date of the third season of The Crown."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;DOCUMENT 2&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 2 is another reference to a document confirming the premiere date of the third season of The Crown on November 17, 2019."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;DOCUMENT 3&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 3 is a reference to a document stating the premiere date of the third season of The Crown on November 17, 2014."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;SUNDAY, NOVEMBER 17&quot;">
      <data key="d0">"DAY"</data>
      <data key="d1">"Sunday, November 17 is the day the third season of The Crown was originally mentioned to premiere."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <node id="&quot;TEASER TRAILER&quot;">
      <data key="d0">"MEDIA"</data>
      <data key="d1">"A teaser trailer was released in August to promote the third season of The Crown."</data>
      <data key="d2">rgb-0055</data>
    </node>
    <edge source="&quot;NETFLIX&quot;" target="&quot;SEASON 3 OF THE CROWN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Netflix is the platform that premiered the third season of The Crown on November 17, 2019."</data>
