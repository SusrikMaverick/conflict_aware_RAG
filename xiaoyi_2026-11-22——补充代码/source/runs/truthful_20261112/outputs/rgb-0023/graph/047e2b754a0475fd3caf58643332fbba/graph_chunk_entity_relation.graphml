<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;XENOBLADE X&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Xenoblade X is a game that was announced under a tentative title and had different release dates in various regions."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan is a location where the game was released on April 9, 2005."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;NORTH AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North America is a location where the game was released on December 4, 2015."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Europe is a location where the game was released on December 4, 2015."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;APRIL 29, 2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"April 29, 2015 is the date the game was released in Japan."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;DECEMBER 4, 2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"December 4, 2015 is the date the game was released in North America and Europe."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2005 is the year the game was released in Japan."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2015 is the year the game was released in North America and Europe."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2021 is the year mentioned in the context of the game's sales performance."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;X&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"X is the tentative title of the game that was later known as Xenoblade X."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;SALES PERFORMANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sales performance refers to the game's financial success or lack thereof, which influenced decisions about re-release."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;RE-RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Re-release is a consideration due to the game's poor sales performance in 2021."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <node id="&quot;ANNOUNCEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Announcement is the event where the game was first introduced under the tentative title 'X'."</data>
      <data key="d2">rgb-0023</data>
    </node>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;JAPAN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Xenoblade X was released in Japan on April 9, 2005."</data>
      <data key="d5">"release date, regional release"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;NORTH AMERICA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Xenoblade X was released in North America on December 4, 2015."</data>
      <data key="d5">"release date, regional release"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;EUROPE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Xenoblade X was released in Europe on December 4, 2015."</data>
      <data key="d5">"release date, regional release"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;2005&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Xenoblade X was released in Japan in 2005."</data>
      <data key="d5">"year of release, regional release"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;2015&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Xenoblade X was released in North America and Europe in 2015."</data>
      <data key="d5">"year of release, regional release"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;X&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Xenoblade X was originally announced under the tentative title 'X'."</data>
      <data key="d5">"title, origin"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;2021&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"In 2021, the game's sales performance was not as good as expected, leading to considerations of a re-release."</data>
      <data key="d5">"sales performance, re-release consideration"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;SALES PERFORMANCE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade X's sales performance in 2021 influenced decisions about a potential re-release."</data>
      <data key="d5">"performance impact, re-release consideration"</data>
      <data key="d6">rgb-0023</data>
    </edge>
    <edge source="&quot;XENOBLADE X&quot;" target="&quot;RE-RELEASE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade X's poor sales performance in 2021 led to the consideration of a re-release."</data>
      <data key="d5">"performance impact, re-release consideration"</data>
      <data key="d6">rgb-0023</data>
    </edge>
  </graph>
</graphml>
