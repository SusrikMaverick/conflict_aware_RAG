  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;AMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ames is a former college basketball phenom who has made the unprecedented leap to the National Hockey League, becoming the first player to transition from basketball to hockey."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;OHIO UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ohio University is the college where Ames played a single season of basketball in 1975."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NATIONAL HOCKEY LEAGUE (NHL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Hockey League is the professional ice hockey league where Ames has transitioned to play."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;COLUMBUS BLUE JACKETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Columbus Blue Jackets is the NHL team where Ames is practicing and is expected to join the starting lineup."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NHL COMMISSIONER GARY BETTMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"NHL Commissioner Gary Bettman is quoted praising Ames' transition from basketball to hockey."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NICK FOLIGNO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Foligno is the captain of the Columbus Blue Jackets and speaks positively about Ames' abilities."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;GENE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gene Smith is the Ohio State University Athletic Director and comments on Ames' involvement in the Ohio State Buckeyes men's basketball team."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;FRED TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fred Taylor is the former Ohio State Buckeyes coach and recalls Ames' contributions to the team."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;MARK EMMERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Emmert is the NCAA President and comments on Ames' participation in the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;OHIO STATE BUCKEYES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ohio State Buckeyes is the college basketball team where Ames played during the 1975-1976 season."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA Division I Men's Basketball is the highest level of college basketball competition in the United States where Ames played in 1975."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NCAA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA is the governing body of college athletics, including the Division I men's basketball league."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;SPEED AND AGILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames' speed and agility are highlighted as key attributes in both basketball and hockey."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;SHOOTING PERCENTAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames' shooting percentage is noted as impressive, with a rate of 35% in the NHL."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;WORK ETHIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames' work ethic is praised by his new teammates and coaches."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;WHIRLWIND FEW WEEKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames' transition to the NHL is described as a whirlwind, reflecting the rapid pace of events."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;HARD WORKER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames is described as a hard worker and dedicated teammate by his former coach."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;UNIQUE SKILLSET&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames brings a unique skillset to the NHL, combining basketball and hockey skills."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;GAME-CHANGER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ames is expected to be a game-changer for the Columbus Blue Jackets."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;WHISPER OF EXCITEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fans and pundits are eagerly anticipating Ames' NHL debut, creating a whisper of excitement."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;FIRST CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ames' transition from basketball to hockey is described as unprecedented and historic."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;PRESTIGIOUS NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The NCAA Division I men's basketball league is described as prestigious and competitive."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;TOP-NOTCH TALENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Players from the NCAA Division I men's basketball league are considered top-notch and go on to excel in the NBA and beyond."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A prestigious sports organization known for its rich history and tradition of excellence in men's basketball."&lt;SEP&gt;"The NCAA Division I men's basketball league is a prestigious sports organization known for its rich history and tradition of excellence in men's basketball."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;ATHLETIC CAREER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Refers to the period during which someone participates in sports professionally or semi-professionally."</data>
      <data key="d2">cb-0153</data>
    </node>
    <node id="&quot;NHL&quot;">
      <data key="d2">cb-0153</data>
      <data key="d1">"The Columbus Blue Jackets are part of the NHL, where Ames is transitioning to play hockey."</data>
