  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF BRISTOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Bristol is a research-intensive institution known for its excellence in the sciences and recent breakthroughs in neuroplasticity research."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;DR. PETER ILLÉS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Peter Illés is a renowned researcher at the University of Bristol who has made significant contributions to the field of neuroplasticity."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;NATURE NEUROSCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature Neuroscience is a scientific journal that published Dr. Illés' groundbreaking study on neuroplasticity."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a neuroscientist at the University of Cambridge who praised Dr. Illés' work."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Cambridge is a prestigious institution where Dr. Patel works and is known for its contributions to neuroscience."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;PALACKÝ UNIVERSITY OLOMOUC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Palacký University Olomouc is a prestigious institution in the Czech Republic where Dr. Illés previously worked."&lt;SEP&gt;"Palacký University Olomouc is an educational institution where Dr. Jana Holá serves as the Dean of the Faculty of Science."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;DR. JANA HOLÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jana Holá is the Dean of the Faculty of Science at Palacký University Olomouc and confirmed Dr. Illés' affiliation."&lt;SEP&gt;"Dr. Jana Holá is the Dean of the Faculty of Science at Palacký University Olomouc."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;DR. MARTIN NOVÁK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Martin Novák is a professor at Palacký University Olomouc and co-authored a study with Dr. Illés."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;JOURNAL OF ADVANCED RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Advanced Research is a publication mentioned as a source."&lt;SEP&gt;"Journal of Advanced Research is a scientific journal where a study co-authored by Dr. Illés and Dr. Novák was published."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;BRISTOL, UK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bristol, UK is the city where the University of Bristol is located and where the breakthrough research took place."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;NEUROX&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"NeuroX is a specific protein discovered by Dr. Illés that regulates the formation and consolidation of new neural connections."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;ALZHEIMER'S DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Alzheimer's disease is a neurological disorder that could potentially be treated using the discovery of NeuroX."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;PARKINSON'S DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Parkinson's disease is a neurological disorder that could potentially be treated using the discovery of NeuroX."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;DEPRESSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Depression is a psychiatric disorder that could potentially be treated using the discovery of NeuroX."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;SYNAPTIC PLASTICITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Synaptic plasticity is the process by which neural connections are strengthened or weakened, which is crucial for neuroplasticity."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;NEUROPLASTICITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Neuroplasticity is the brain's ability to reorganize itself in response to experience, which is the focus of Dr. Illés' research."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;BRAIN FUNCTION AND BEHAVIOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Brain function and behavior are areas of study that Dr. Illés has dedicated his career to understanding."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;FIVE YEARS&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"Five years is the duration of Dr. Illés' research project, spanning from the start of the study to its completion."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;OVER 10,000 BRAIN SAMPLES&quot;">
      <data key="d0">"QUANTITY"</data>
      <data key="d1">"Over 10,000 brain samples were analyzed during Dr. Illés' research project."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;NEW DRUGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"New drugs are potential therapeutic strategies that could be developed based on the discovery of NeuroX."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;CLINICAL APPLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Clinical applications refer to the practical use of the research findings in medical settings."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University is committed to fostering a community of esteemed researchers, emphasizing collaboration and academic excellence."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;PETER ILLÉS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Illés is a researcher whose work continues to shape his field."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;FACULTY OF SCIENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Faculty of Science is part of Palacký University Olomouc and is led by Dr. Jana Holá."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Research is the primary activity of the University and its faculty members, particularly highlighted by Peter Illés' work."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration is emphasized as an important aspect of the University's commitment to fostering a community of esteemed researchers."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a core value of the University, supported by the work of esteemed researchers like Peter Illés."</data>
      <data key="d2">cb-0212</data>
    </node>
    <node id="&quot;COMMITMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment is the driving force behind the University's efforts to foster a community of esteemed researchers."</data>
      <data key="d2">cb-0212</data>
    </node>
