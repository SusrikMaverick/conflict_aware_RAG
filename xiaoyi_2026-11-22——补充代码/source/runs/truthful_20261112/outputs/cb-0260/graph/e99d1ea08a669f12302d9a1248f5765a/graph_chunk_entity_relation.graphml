      <data key="d3">7.0</data>
      <data key="d4">"Both institutions are academic settings where Dirk Smits has made significant contributions to research in the field of medical sciences."</data>
      <data key="d5">"academic contributions, research"</data>
      <data key="d6">cb-0260</data>
    </edge>
