  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DIRK SMITS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dirk Smits is a renowned researcher in the field of medical sciences, known for his contributions to both Katholieke Universiteit Brussel and the University of North Carolina School of Medicine."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;KATHOLIEKE UNIVERSITEIT BRUSSEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Katholieke Universiteit Brussel is a former university in Brussels, known for its academic excellence in fields such as engineering, economics, and law."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;UNIVERSITY OF NORTH CAROLINA SCHOOL OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of North Carolina School of Medicine is an institution where Dirk Smits worked as a research associate, contributing to research in biochemistry and biophysics."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a colleague of Dirk Smits, praised for her work and collaboration with Smits on various research projects."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;UNIVERSITY OF AMSTERDAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Amsterdam is where Dirk Smits obtained his Ph.D. in Biochemistry."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Nature Medicine is a scientific journal where a study co-authored by Dirk Smits and Dr. Maria Rodriguez was published."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cancer Research is a scientific journal where a study co-authored by Dirk Smits and others was published."&lt;SEP&gt;"Cancer Research is the field of study dedicated to understanding the causes, development, and treatment of cancer."&lt;SEP&gt;"Cancer Research is the journal in which the study was published, indicating its peer-reviewed and scientific nature."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;AMERICAN ASSOCIATION FOR CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Association for Cancer Research is an organization that presented the 'Rising Star in Cancer Research' award to Dirk Smits."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brussels is the city where Katholieke Universiteit Brussel was located and where Dirk Smits had connections."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;VRIJE UNIVERSITEIT BRUSSEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vrije Universiteit Brussel is the institution that merged with Katholieke Universiteit Brussel in 2014."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;ENGINEERING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Engineering is one of the fields in which Katholieke Universiteit Brussel excelled."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;ECONOMICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economics is one of the fields in which Katholieke Universiteit Brussel excelled."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;LAW&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Law is one of the fields in which Katholieke Universiteit Brussel excelled."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;BIOCHEMISTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biochemistry is the field in which Dirk Smits obtained his Ph.D. and worked extensively."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CELLULAR METABOLISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cellular Metabolism is the topic of Dirk Smits' dissertation."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;ENZYME KINETICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Enzyme Kinetics is a key aspect of Dirk Smits' dissertation."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;TUMORIGENESIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tumorigenesis is the focus of some of Dirk Smits' research at the University of North Carolina School of Medicine."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;SMALL MOLECULE INHIBITORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Small Molecule Inhibitors are used in Dirk Smits' research to inhibit tumor growth."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;PI3K\/AKT SIGNALING PATHWAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"PI3K\/Akt Signaling Pathway is a signaling pathway studied by Dirk Smits and Dr. Maria Rodriguez."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CIRCULATING TUMOR CELLS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Circulating Tumor Cells are cancer cells that have entered the bloodstream, a key focus in the study."&lt;SEP&gt;"Circulating Tumor Cells are the subject of Dirk Smits' research on developing diagnostic tools."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;PERIPHERAL BLOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Peripheral Blood is the medium in which Dirk Smits developed a biosensor for detecting circulating tumor cells."&lt;SEP&gt;"Peripheral Blood is the sample type used for detecting circulating tumor cells, highlighting the method of analysis."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;BIOSENSOR FOR THE DETECTION OF CIRCULATING TUMOR CELLS IN PERIPHERAL BLOOD&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"This biosensor is designed for detecting circulating tumor cells in peripheral blood, a significant advancement in cancer research."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;BIOSENSOR&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Biosensor is a device used for detecting specific substances in biological samples, crucial for medical diagnostics."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;DETECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Detection refers to the process of identifying circulating tumor cells using the biosensor."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Publication is the act of releasing the study in the Cancer Research journal."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Study is the research conducted to develop the biosensor for detecting circulating tumor cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;PEER-REVIEWED&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Peer-Reviewed indicates the study has undergone rigorous evaluation by experts in the field."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;JOURNAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Journal is a publication where research findings are disseminated, often after peer review."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research is the systematic investigation into and study of materials, phenomena, etc., especially to establish facts or principles."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer is a group of diseases characterized by the uncontrolled growth and spread of abnormal cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CELLS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cells are the basic structural and functional units of living organisms, including cancer cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;BLOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blood is the liquid tissue that circulates throughout the body, carrying oxygen and nutrients to cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;TUMOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tumor is an abnormal mass of tissue that results from excessive cell division."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;DETECTION TECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Detection Technology refers to the methods and tools used to identify and analyze circulating tumor cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;MEDICAL DIAGNOSTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medical Diagnostics involves the use of various techniques to diagnose and monitor diseases."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER DIAGNOSIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Diagnosis is the process of determining whether a person has cancer and, if so, the type and stage of the disease."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER TREATMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Treatment involves various methods to eliminate or control cancer, such as surgery, chemotherapy, and radiation therapy."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER PREVENTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Prevention includes measures to reduce the risk of developing cancer, such as lifestyle changes and screening programs."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER SCREENING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Screening is the process of looking for cancer before a person has any symptoms, often involving tests to detect early signs of cancer."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Biology is the study of the molecular and cellular basis of cancer, including how cancer cells grow and spread."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER GENETICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Genetics involves the study of genetic factors that contribute to the development and progression of cancer."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER IMMUNOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Immunology focuses on the immune system's role in recognizing and fighting cancer cells."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER EPIDEMIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Epidemiology is the study of the distribution and determinants of cancer in populations."</data>
      <data key="d2">cb-0260</data>
    </node>
    <node id="&quot;CANCER PATHOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer Pathology involves the study of the characteristics of cancer tissues and tumors."</data>
      <data key="d2">cb-0260</data>
    </node>
