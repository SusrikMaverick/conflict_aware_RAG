      <data key="d5">"publication, scientific validation"</data>
      <data key="d6">cb-0260</data>
    </edge>
    <edge source="&quot;CIRCULATING TUMOR CELLS&quot;" target="&quot;BIOSENSOR FOR THE DETECTION OF CIRCULATING TUMOR CELLS IN PERIPHERAL BLOOD&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The biosensor aims to detect circulating tumor cells, making it a critical tool in cancer research."</data>
      <data key="d5">"target detection, cancer research"</data>
      <data key="d6">cb-0260</data>
    </edge>
    <edge source="&quot;PERIPHERAL BLOOD&quot;" target="&quot;BIOSENSOR FOR THE DETECTION OF CIRCULATING TUMOR CELLS IN PERIPHERAL BLOOD&quot;">
      <data key="d3">8.0</data>
