  <graph edgedefault="undirected">
    <node id="&quot;HOUSE OF BOURBON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"House of Bourbon is a royal dynasty that includes members such as Louis and more distant kinsmen, and figures like Louis XIV and Louis Alexandre de Bourbon."|</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;BROCKHAUS ENZYKLOPÄDIE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brockhaus Enzyklopädie is a German encyclopedia known for detailed historical entries."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;LOUIS ALEXANDRE DE BOURBON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louis Alexandre de Bourbon is a historical figure, son of Louis XIV and Madame de Montespan, and brother to Princess Anne Élisabeth of France and Marie Thérèse, Madame Royale."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;RAMBOUILLET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rambouillet is the place of Louis Alexandre de Bourbon's death."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;DREUX ROYAL CHAPEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dreux Royal Chapel is the place of Louis Alexandre de Bourbon's burial."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;LOUIS XIV OF FRANCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louis XIV of France is the father of Louis Alexandre de Bourbon."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;MADAME DE MONTESPAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame de Montespan is the mother of Louis Alexandre de Bourbon."</data>
      <data key="d2">ramdocs-0021-ea1c12a29ed3</data>
    </node>
    <node id="&quot;PRINCESS ANNE ÉLISABETH OF FRANCE&quot;">
