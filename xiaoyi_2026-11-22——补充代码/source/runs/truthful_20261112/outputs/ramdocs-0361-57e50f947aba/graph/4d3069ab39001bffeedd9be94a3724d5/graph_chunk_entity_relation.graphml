  <graph edgedefault="undirected">
    <node id="&quot;ROCKY FORD, GEORGIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rocky Ford, Georgia is a town in Screven County, Georgia, United States, with a population of 186 at the 2000 census."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;MOBILITY AND MIGRATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mobility and migration refers to the movement of people from one place to another, often studied in demographic studies."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;ROCKYFORD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rockyford is a village mentioned in the context of population and dwelling counts."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;ALBERTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alberta is a province in Canada where Rockyford is located."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;TOTAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Total represents the overall count or sum of a particular demographic characteristic."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;MEN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Men refers to the male population in a given area."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;WOMEN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Women refers to the female population in a given area."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;POPULATION AND DWELLINGS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Population and dwellings refers to the total number of people and housing units in a specified area."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;HOUSEHOLD AND DWELLING CHARACTERISTICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Household and dwelling characteristics refer to various attributes of households and their dwellings, such as type of dwelling and living arrangements."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;GENDER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gender refers to the classification of people based on their sex assigned at birth, typically categorized as male or female."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;COUNTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Counts represent numerical data collected in demographic studies."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;RATES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rates represent the frequency or proportion of a particular characteristic in a given population."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;CHARACTERISTIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Characteristic refers to a specific attribute or feature being measured in demographic studies."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;VILLAGE (VL)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Village (VL) is a type of administrative division, specifically a village, used in the context of population and dwelling counts."</data>
      <data key="d2">ramdocs-0361-57e50f947aba</data>
    </node>
    <node id="&quot;CENSUS SUBDIVISION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Census subdivision is a geographic area used for collecting and reporting census data."</data>
