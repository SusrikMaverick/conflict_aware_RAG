      <data key="d5">"seasonal release, publication date"</data>
      <data key="d6">cb-0256</data>
    </edge>
    <edge source="&quot;HIRSCH&quot;" target="&quot;ZABALA&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Hirsch has praised Zabala for his talent and dedication, indicating a positive relationship and recognition of Zabala's work."</data>
      <data key="d5">"endorsement, appreciation"</data>
      <data key="d6">cb-0256</data>
    </edge>
    <edge source="&quot;ZABALA&quot;" target="&quot;FANS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Fans are eagerly anticipating Zabala's next literary masterpiece, indicating a strong interest and support from the audience."</data>
      <data key="d5">"anticipation, support"</data>
