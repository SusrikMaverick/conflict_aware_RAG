    </edge>
    <edge source="&quot;THE MEMORY OF SILENCE&quot;" target="&quot;ZABALA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Zabala is the author of 'The Memory of Silence,' which is set for release in the fall, connecting Zabala to his upcoming work."</data>
      <data key="d5">"authorship, publication"</data>
      <data key="d6">cb-0256</data>
    </edge>
    <edge source="&quot;THE MEMORY OF SILENCE&quot;" target="&quot;FALL&quot;">
      <data key="d3">7.0</data>
