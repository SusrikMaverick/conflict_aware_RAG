  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NĂDRAG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nădrag is a commune in Timiș County, Romania, known for its agricultural sector and economic challenges in 2004."&lt;SEP&gt;"Nădrag is a region in Romania where the individual had a significant impact through reforms and achievements."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;LIVIU MUNTEAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Liviu Muntean is a Romanian politician from Sibiu County who became the head of government of Nădrag in 2004, leading significant economic and social reforms."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;TIMIȘ COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Timiș County is a county in Romania where Nădrag is located."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;ROMANIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Romania is the country where Nădrag and Timiș County are situated."&lt;SEP&gt;"Romania is the country where Nădrag is located and where the individual had an impact."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;SIBIU COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sibiu County is the birthplace of Liviu Muntean."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;2004&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2004 marks the year when Nădrag faced economic challenges and Liviu Muntean emerged as a leader."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2005 is the year when Thierry Del Poso was appointed as the head of government of Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2010 marks the end of Thierry Del Poso's tenure as head of government of Nădrag."&lt;SEP&gt;"2010 marks the year when the individual returned to France to pursue a career in national politics."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;2008&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2008 is the year when Thierry Del Poso faced criticism over a large-scale mining project approval."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;THIERRY DEL POSO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thierry Del Poso is a French politician who served as the head of government of Nădrag from 2005 to 2010."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;EUROPEAN UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Union is mentioned as an organization Thierry Del Poso consulted for before entering politics."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;UNITED NATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United Nations is another organization Thierry Del Poso consulted for before entering politics."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;ROMANIAN DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Romanian Democratic Party is the political party Liviu Muntean was a member of."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;NĂDRAG AGRICULTURAL COOPERATIVE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Nădrag Agricultural Cooperative is an innovative project Liviu Muntean established to support local farmers with modern technology and market opportunities."&lt;SEP&gt;"The Nădrag Agricultural Cooperative is an innovative project Liviu Muntean established to support local farmers."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;2004 ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2004 Election marked the year when Liviu Muntean was elected as the mayor of Nădrag with a landslide victory."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;GRASSROOTS POLITICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Grassroots Politics refers to Liviu Muntean's involvement in local politics, building a reputation as a passionate advocate for rural development and social welfare."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;COMMUNE MAYOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Commune Mayor is the position Liviu Muntean held after winning the 2004 election, responsible for leading the community and implementing reforms."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;SUSTAINABLE AGRICULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Agriculture is one of the initiatives Liviu Muntean launched to promote farming practices that are environmentally friendly and economically viable."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;LOCAL BUSINESSES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local Businesses are supported by Liviu Muntean's administration to create jobs and stimulate the local economy."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;INFRASTRUCTURE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Infrastructure Development includes the construction of new roads, schools, and healthcare facilities, which were part of Liviu Muntean's initiatives to improve the quality of life in Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;FOREIGN INVESTMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Foreign Investment increased significantly during Thierry Del Poso's tenure, contributing to the local economy."&lt;SEP&gt;"Foreign investment refers to the financial contributions from outside sources that impact local economies."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;UNEMPLOYMENT RATES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Unemployment Rates decreased during Thierry Del Poso's tenure, reflecting the positive impact of his economic policies."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;LARGE-SCALE MINING PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A large-scale mining project was approved by Thierry Del Poso in 2008, generating revenue for the local economy but facing criticism from environmental groups."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;ENVIRONMENTAL GROUPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Environmental Groups opposed the large-scale mining project, citing potential environmental impacts."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;JOURNAL OF EASTERN EUROPEAN STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Eastern European Studies is the publication where the case study by M. Popescu and A. Mihai was published."&lt;SEP&gt;"The Journal of Eastern European Studies published a study on the impact of foreign investment on local economies in Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;JOURNAL OF ENVIRONMENTAL POLICY AND PLANNING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Environmental Policy and Planning published a study on the environmental impact of the large-scale mining project in Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;ROMANIAN MINISTRY OF REGIONAL DEVELOPMENT AND PUBLIC ADMINISTRATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Romanian Ministry of Regional Development and Public Administration praised Thierry Del Poso's reforms and achievements in Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"France is the country where the individual pursued a career in national politics after returning from Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;M. POPESCU AND A. MIHAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"M. Popescu and A. Mihai are authors of a case study on the impact of foreign investment on local economies in Nădrag, Romania."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;INDIVIDUAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The individual refers to someone who had a significant impact in Nădrag through reforms and achievements."</data>
      <data key="d2">cb-0442</data>
    </node>
    <node id="&quot;LOCAL ECONOMIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local economies refer to the economic conditions and impacts within the regions studied, particularly in Nădrag."</data>
      <data key="d2">cb-0442</data>
    </node>
