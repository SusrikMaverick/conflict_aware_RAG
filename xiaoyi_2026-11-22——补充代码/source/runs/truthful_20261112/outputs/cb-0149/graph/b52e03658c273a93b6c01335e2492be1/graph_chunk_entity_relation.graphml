  <graph edgedefault="undirected">
    <node id="&quot;KAI ZIEBARTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kai Ziebarth is a researcher with multiple affiliations and publications across various fields including orthopedics and social sciences."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;INSELSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inselspital is a university hospital located in Bern, Switzerland, where Kai Ziebarth has worked and published research papers."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;UNIVERSITY OF VIRGINIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Virginia is an educational institution where Kai Ziebarth has served as an Assistant Professor of Sociology and conducted research."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ORCID is an organization that provides unique identifiers for researchers to ensure accurate attribution of their work."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;JOURNAL OF ORTHOPAEDIC RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Orthopaedic Research is a peer-reviewed scientific journal where Kai Ziebarth has published research papers."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;JOURNAL OF BONE AND JOINT SURGERY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Bone and Joint Surgery is a leading orthopedic journal where Kai Ziebarth has published research papers."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is an educational institution where Kai Ziebarth earned his Ph.D. in Sociology."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;DR. JENNIFER LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jennifer Lee is a supervisor of Kai Ziebarth's Ph.D. dissertation at the University of California, Berkeley."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;DR. EMILY CHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Chen is a collaborator of Kai Ziebarth in his research on social capital and healthcare access."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;SOCIAL NETWORKS AND COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Social Networks and Community Development is the title of Kai Ziebarth's dissertation, exploring the role of social capital in urban planning."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;THE IMPACT OF SOCIAL NETWORKS ON EDUCATIONAL OUTCOMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Impact of Social Networks on Educational Outcomes is the title of a notable study by Kai Ziebarth, analyzing the effect of social connections on academic success."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;SOCIAL CAPITAL AND HEALTHCARE ACCESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Social Capital and Healthcare Access is the title of a collaborative study by Kai Ziebarth and Dr. Emily Chen, examining the relationship between social capital and healthcare outcomes."</data>
      <data key="d2">cb-0149</data>
    </node>
    <node id="&quot;RISING STAR AWARD&quot;">
