  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SHUO FENG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shuo Feng is a researcher with a background in sociology and interdisciplinary studies, affiliated with both the Beijing Hospital of Traditional Chinese Medicine and Yale University."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;BEIJING HOSPITAL OF TRADITIONAL CHINESE MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Beijing Hospital of Traditional Chinese Medicine is a prominent hospital in China specializing in traditional Chinese medicine, where Shuo Feng has been affiliated."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;YALE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yale University is a prestigious institution where Shuo Feng has worked as a postdoctoral research fellow and later as an assistant professor."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;PEKING UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peking University is the university where Shuo Feng obtained his undergraduate degree in sociology."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is the institution where Shuo Feng pursued his graduate studies and earned his Ph.D. in sociology."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;DR. EMILY CHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Chen is a leading expert on social inequality and a collaborator of Shuo Feng at Yale University."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIAL SCIENCE RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Social Science Research is a journal where one of Shuo Feng's notable studies was published."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIOLOGICAL FORUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Sociological Forum is a journal where another of Shuo Feng's notable studies was published."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;ANNUAL REVIEW OF SOCIOLOGY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Annual Review of Sociology is a journal where a critical review co-authored by Shuo Feng and Dr. Emily Chen was published."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sociology is the field of study that Shuo Feng specializes in, including research on social networks and economic development."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIAL NETWORKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social networks are a key focus of Shuo Feng's research, particularly in relation to economic outcomes and educational institutions."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;ECONOMIC DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic development is a topic that Shuo Feng has studied, especially in the context of social networks and educational institutions."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIAL CAPITAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social capital is a concept that Shuo Feng has explored in his research, particularly in relation to economic mobility and labor market outcomes."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;EDUCATIONAL INSTITUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Educational institutions are a focal point of Shuo Feng's research, examining their role in shaping social networks and economic outcomes."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;SOCIAL INEQUALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social inequality is a topic that Shuo Feng has researched, particularly in collaboration with Dr. Emily Chen."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;LABOR MARKET OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Labor market outcomes are a key area of Shuo Feng's research, exploring how social networks impact employment and economic opportunities."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;ECONOMIC OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic outcomes are a central theme in Shuo Feng's research, particularly in the context of social networks and educational institutions."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Research is the primary activity of Shuo Feng, involving the study of various social and economic phenomena."</data>
      <data key="d2">cb-0265</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Publications are a significant part of Shuo Feng's research, including articles in journals such as Social Science Research, Sociological Forum, and Annual Review of Sociology."</data>
      <data key="d2">cb-0265</data>
    </node>
