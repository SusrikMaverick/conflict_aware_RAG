      <data key="d5">"publication, research impact"</data>
      <data key="d6">cb-0265</data>
    </edge>
    <edge source="&quot;SHUO FENG&quot;" target="&quot;SOCIOLOGICAL FORUM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Another significant study conducted by Shuo Feng during his time at Yale was published in the journal Sociological Forum in 2019."</data>
      <data key="d5">"publication, research impact"</data>
      <data key="d6">cb-0265</data>
    </edge>
    <edge source="&quot;SHUO FENG&quot;" target="&quot;ANNUAL REVIEW OF SOCIOLOGY&quot;">
