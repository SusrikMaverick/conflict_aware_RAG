      <data key="d5">"education, academic background"</data>
      <data key="d6">cb-0265</data>
    </edge>
    <edge source="&quot;SHUO FENG&quot;" target="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d3">8.0</data>
