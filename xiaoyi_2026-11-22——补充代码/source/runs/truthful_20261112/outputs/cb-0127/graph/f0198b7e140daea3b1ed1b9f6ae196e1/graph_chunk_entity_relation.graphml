<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;US PATENT 11435261&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"US Patent 11435261 is a patent that protects an innovative method for analyzing tolerance distributions in freeform surface mirrors, crucial for the reconstruction project."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is the lead archaeologist on the project and played a key role in the successful reconstruction of the ancient temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;DR. JOHN LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Lee is the inventor of the patented method and a researcher at UC Berkeley who developed the tolerance analysis technique."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UC Berkeley is a key institution involved in the development of the tolerance analysis method and the reconstruction project."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;JORDANIAN DEPARTMENT OF ANTIQUITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Jordanian Department of Antiquities is a partner in the collaborative effort to reconstruct the ancient temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;PETRA, JORDAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Petra, Jordan is the site of the ancient temple that was reconstructed."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ANCIENT TEMPLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The ancient temple is a 2,500-year-old structure located in Petra, Jordan, that was reconstructed using modern techniques."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;3D PRINTING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"3D printing is a technology used in the reconstruction project to recreate the intricate stonework and ornate details of the ancient temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;COMPUTER-AIDED DESIGN&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Computer-aided design is a technology used in the reconstruction project to create a highly accurate digital model of the ancient temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Materials science is a technology used in the reconstruction project to ensure the structural integrity of the reconstructed temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;FREEFORM SURFACE MIRRORS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Freeform surface mirrors are a type of optical component that were analyzed using the patented method to ensure the accuracy of the reconstructed temple."&lt;SEP&gt;"Freeform surface mirrors are the subject of the research, characterized by complex surface irregularities and requiring accurate optical performance prediction."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ARCHAEOLOGISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Archaeologists are part of the team that successfully reconstructed the ancient temple, contributing to the interdisciplinary effort."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ENGINEERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Engineers are part of the team that successfully reconstructed the ancient temple, contributing to the interdisciplinary effort."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;HISTORIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Historians are part of the team that successfully reconstructed the ancient temple, contributing to the interdisciplinary effort."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;MULTIDISCIPLINARY TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A multidisciplinary team of over 50 experts worked on the reconstruction project, combining various fields of expertise."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A ceremony was held to unveil the reconstructed temple, attended by dignitaries from around the world."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;DIGNITARIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dignitaries from around the world attended the unveiling ceremony of the reconstructed temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;TOLERANCE ANALYSIS METHOD&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The tolerance analysis method is a technique developed by Dr. John Lee and his team at UC Berkeley, used to ensure the accuracy of the reconstruction project."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;OPTICAL SYSTEMS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Optical systems are the field in which the tolerance analysis method is applied, particularly in the context of freeform surface mirrors."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ABERRATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Aberrations are optical issues that the tolerance analysis method helps to correct in freeform surface mirrors."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;IMAGE QUALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Image quality is a critical factor in determining the granularity and thus the allocation of manufacturing resources."&lt;SEP&gt;"Image quality is a key factor in the performance of optical systems, and the tolerance analysis method helps to optimize it."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;DIFFRACTION-LIMITED PERFORMANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Diffraction-limited performance is a specific type of optical performance that the tolerance analysis method can help to improve."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;SCATTERING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scattering is an optical phenomenon that the tolerance analysis method helps to reduce in freeform surface mirrors."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;MID-SPATIAL FREQUENCY ERRORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mid-spatial frequency errors are a type of surface irregularity that the tolerance analysis method can analyze."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;HIGH-SPATIAL FREQUENCY ERRORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"High-spatial frequency errors are another type of surface irregularity that the tolerance analysis method can analyze."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;MANUFACTURING IMPERFECTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Manufacturing imperfections are issues that the tolerance analysis method addresses to improve optical performance."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;MANUFACTURING RESOURCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Manufacturing resources are allocated based on the analysis provided by the tolerance analysis method to ensure optimal performance."&lt;SEP&gt;"Manufacturing resources include the tools and materials needed to produce the mirrors, which are allocated based on the granularity of the images."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;EMPIRICAL VALIDATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Empirical validation is the process of rigorously testing the method to ensure its accuracy and reliability."&lt;SEP&gt;"Empirical validation is the process of testing the effectiveness of the tolerance analysis method through rigorous experiments."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;LEADING SCIENTIFIC JOURNALS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leading scientific journals are where the results of the research were published, signifying the credibility and impact of the findings."&lt;SEP&gt;"Leading scientific journals publish the results of the empirical validation of the tolerance analysis method."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;RECONSTRUCTION PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The reconstruction project is a collaborative effort to bring the ancient temple back to life using modern techniques."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ANCIENT ARCHITECTURAL MARVEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The ancient architectural marvel is the 2,500-year-old temple in Petra, Jordan, that was reconstructed."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;INTRICATE CARVINGS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intricate carvings are a key feature of the ancient temple that were replicated using the tolerance analysis method."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;REFLECTIVE SURFACES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Reflective surfaces are a crucial component of the ancient temple's design that were analyzed using the tolerance analysis method."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;STEREOCHEMISTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stereochemistry is a field of chemistry that deals with the three-dimensional arrangement of atoms in molecules, which is relevant to the reconstruction project."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;CULTURAL AND ARCHITECTURAL ACHIEVEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural and architectural achievements refer to the historical and artistic significance of the ancient temple."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;HUMAN INGENUITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human ingenuity is highlighted as a key factor in the success of the reconstruction project."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary research is emphasized as a crucial aspect of the reconstruction project, involving multiple fields of expertise."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;DESIGNERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Designers are responsible for making informed decisions about the allocation of manufacturing resources based on image quality and granularity."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;RESEARCHERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Researchers conducted rigorous experiments to validate the method for predicting the optical performance of freeform surface mirrors."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;OPTICAL SYSTEM DESIGN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Optical system design is the field in which the research breakthrough occurred, focusing on the design and optimization of optical components."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;GRANULARITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Granularity refers to the level of detail in the images, which helps in making informed decisions about resource allocation."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;COMPLEX SURFACE IRREGULARITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Complex surface irregularities are characteristics of freeform surface mirrors that require careful attention during manufacturing."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;RIGOROUS EXPERIMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rigorous experiments are the method used to validate the approach for predicting optical performance."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;OPTICAL PERFORMANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Optical performance refers to how well the mirrors perform in terms of their optical properties."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;SURFACE IRREGULARITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Surface irregularities are deviations from the ideal surface shape of the mirrors."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;SCIENTIFIC BREAKTHROUGH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The publication of the research results in leading scientific journals represents a scientific breakthrough in optical system design."</data>
      <data key="d2">cb-0127</data>
    </node>
    <node id="&quot;ALLOCATION OF RESOURCES&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"The allocation of resources is a process where manufacturing resources are distributed based on the granularity of the images."</data>
      <data key="d2">cb-0127</data>
    </node>
    <edge source="&quot;US PATENT 11435261&quot;" target="&quot;DR. JOHN LEE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"US Patent 11435261 is the intellectual property of Dr. John Lee and his team at UC Berkeley, who developed the tolerance analysis method."</data>
      <data key="d5">"patent ownership, innovation"</data>
      <data key="d6">cb-0127</data>
    </edge>
    <edge source="&quot;US PATENT 11435261&quot;" target="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Sophia Patel acknowledges the importance of the patented method in ensuring the accuracy of the reconstruction project."</data>
      <data key="d5">"method reliance, accuracy"</data>
      <data key="d6">cb-0127</data>
    </edge>
    <edge source="&quot;US PATENT 11435261&quot;" target="&quot;FREEFORM SURFACE MIRRORS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The patented method is specifically designed to analyze tolerance distributions in freeform surface mirrors, ensuring their optimal performance in optical systems."</data>
      <data key="d5">"method application, precision"</data>
      <data key="d6">cb-0127</data>
    </edge>
