  <graph edgedefault="undirected">
    <node id="&quot;ROBIN WRIGHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robin Wright is an American actress and director known for her roles in various films and television series, including 'The Princess Bride', 'The Girl with the Dragon Tattoo', and 'Wonder Woman'. She has received numerous awards and recognitions for her work."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;SANTA BARBARA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santa Barbara is a soap opera where Robin Wright played the role of Kelly Capwell from 1984 to 1988."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;KELLY CAPWELL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Kelly Capwell is a character played by Robin Wright in the soap opera 'Santa Barbara'."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;THE PRINCESS BRIDE&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"The Princess Bride is a romantic comedy fantasy adventure film in which Robin Wright starred, leading to her further success in the film industry."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;NBC DAYTIME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NBC Daytime is the network where Robin Wright first gained attention for her role in 'Santa Barbara'."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;U.N. CORRESPONDENTS ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U.N. Correspondents Association is an organization that awarded Robin Wright the Gold Medal for analysis and coverage of international affairs."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;NATIONAL PRESS CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Press Club is an organization that awarded Robin Wright for diplomatic reporting."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;THE NEW YORKER&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The New Yorker is a magazine where Robin Wright received the National Magazine Award for her reportage from Iran."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;OVERSEAS PRESS CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Overseas Press Club is an organization that awarded Robin Wright for best reporting in any medium requiring exceptional courage and initiative."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;JOHN D. AND CATHERINE T. MACARTHUR FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John D. and Catherine T. MacArthur Foundation granted Robin Wright."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;ALICIA PATTERSON JOURNALISM FELLOWSHIP&quot;">
      <data key="d0">"FELLOWSHIP"</data>
      <data key="d1">"Alicia Patterson Journalism Fellowship is a fellowship that Robin Wright received in 1975 to research projects of interest."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;ZACK SNYDER'S JUSTICE LEAGUE&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Zack Snyder's Justice League is a film in which Robin Wright starred as General Antiope."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;DEVIL'S PEAK&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Devil's Peak is a film in which Robin Wright starred as Virgie."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;DAMSEL&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Damsel is a film in which Robin Wright starred as Queen Isabelle."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;GENERAL ANTIOPE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"General Antiope is a role played by Robin Wright in multiple films including 'Wonder Woman', 'Blade Runner 2049', and 'Zack Snyder's Justice League'."</data>
      <data key="d2">ramdocs-0174-a031829d36c0</data>
    </node>
    <node id="&quot;THE YELLOW ROSE&quot;">
