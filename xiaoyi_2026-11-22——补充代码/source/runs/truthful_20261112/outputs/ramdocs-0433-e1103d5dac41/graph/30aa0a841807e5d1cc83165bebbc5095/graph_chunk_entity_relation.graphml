<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BE GENEROUS. YOUR CITY NEEDS YOU.&quot; POSTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The poster encourages generosity and is part of a campaign to support the city of New York."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;I LOVE NEW YORK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"I Love New York is a song written and composed by Steve Karmen in 1977, later declared the state anthem of New York."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;STEVE KARMEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steve Karmen is the songwriter of 'I Love New York', known for retaining the publishing rights to his songs but gave them to the state for free."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;GOVERNOR HUGH CAREY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Governor Hugh Carey declared 'I Love New York' as New York's state anthem in 1980."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the city where the song 'I Love New York' is associated with and promoted."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;NEW YORK STATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York State is the administrative region that adopted 'I Love New York' as its state anthem."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;NEW YORK GOES TO HOLLYWOOD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"New York Goes to Hollywood is a reference to a show or event involving New York."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;POLLARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pollard is a person mentioned in relation to the show 'New York Goes to Hollywood'."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;SISTER PATTERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sister Patterson is Pollard's mother and appeared on the show 'New York Goes to Hollywood' to help Pollard choose the right man."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;MAURICIO SANCHEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mauricio Sanchez played the role of 'Chamo', New York's assistant, in the first season of 'New York Goes to Hollywood'."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;VH1&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"VH1 is a television network that produced and aired the show 'New York Goes to Hollywood' and another show 'Flavor of Love Girls: Charm School'."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;FLAVOR OF LOVE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Flavor of Love is a reality TV show where Pollard and others participated."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;FILMFARE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Filmfare is a film magazine that reviewed the movie 'I Love New York' and gave it 3 out of 5 stars."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;RACHIT GUPTA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rachit Gupta is a Filmfare reviewer who provided a critical review of the movie 'I Love New York' and praised Ranaut's performance."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;DEOL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Deol is an actor who starred in the movie 'I Love New York' and was criticized for his performance as a romantic comedy lead."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;RANAUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ranaut is an actress who starred in the movie 'I Love New York' and was praised for her performance despite the film's shortcomings."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;I LOVE NEW YORK (FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"I Love New York (film) is a movie that was released and received mixed reviews, with Ranaut's performance being highlighted."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;FLAVOR OF LOVE GIRLS: CHARM SCHOOL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Flavor of Love Girls: Charm School is a show that used the house from the first season of 'Flavor of Love' after it was wrapped up."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The house from the first season of 'Flavor of Love' was used for the show 'Flavor of Love Girls: Charm School' after the first season ended."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;APRIL 29, 2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 29, 2007 is the date when the production of a second season of 'I Love New York' was first announced during a commercial break for the episode of another show."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;COMMERCIAL BREAK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A commercial break during the episode of another show was used to announce the production of a second season of 'I Love New York' on April 29, 2007."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <node id="&quot;FIRST SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The first season of 'New York Goes to Hollywood' featured Pollard, Sister Patterson, and Mauricio Sanchez."</data>
      <data key="d2">ramdocs-0433-e1103d5dac41</data>
    </node>
    <edge source="&quot;I LOVE NEW YORK&quot;" target="&quot;STEVE KARMEN&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Steve Karmen wrote and composed the song 'I Love New York', which became the state anthem of New York."</data>
      <data key="d5">"songwriting, state anthem"</data>
      <data key="d6">ramdocs-0433-e1103d5dac41</data>
    </edge>
    <edge source="&quot;I LOVE NEW YORK&quot;" target="&quot;GOVERNOR HUGH CAREY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Governor Hugh Carey officially declared 'I Love New York' as New York's state anthem in 1980."</data>
      <data key="d5">"official recognition, state anthem"</data>
      <data key="d6">ramdocs-0433-e1103d5dac41</data>
    </edge>
    <edge source="&quot;I LOVE NEW YORK&quot;" target="&quot;NEW YORK STATE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"New York State adopted 'I Love New York' as its state anthem, making it an official representation of the state."</data>
      <data key="d5">"state representation, official anthem"</data>
      <data key="d6">ramdocs-0433-e1103d5dac41</data>
    </edge>
    <edge source="&quot;STEVE KARMEN&quot;" target="&quot;NEW YORK CITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Steve Karmen's song 'I Love New York' is closely associated with New York City and its promotion."</data>
      <data key="d5">"promotional song, city association"</data>
      <data key="d6">ramdocs-0433-e1103d5dac41</data>
    </edge>
  </graph>
</graphml>
