      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;YEAR OVER YEAR&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"Year over year refers to the comparison of financial metrics between the same periods of consecutive years."</data>
      <data key="d2">rgb-0012</data>
