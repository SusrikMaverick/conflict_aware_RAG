      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The company refers to Tesla in the context of financial reporting."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;NET INCOME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Net income is a financial metric indicating the profit after all expenses, taxes, and other costs have been deducted."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;REVENUE&quot;">
      <data key="d0">"EVENT"</data>
