<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TESLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tesla is a company that reported significant financial growth in terms of net income and revenue."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;$438 MILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$438 million is the net income reported by Tesla in a specific period."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;$679 MILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$679 million is the revenue reported by Tesla in Q1 2022."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;Q1 2021&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"Q1 2021 is the quarter in which Tesla reported $1.39 billion in revenue and $10.4 billion in revenue in two separate documents."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;Q1 2022&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"Q1 2022 is the quarter in which Tesla reported $679 million in revenue."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;$1.39 BILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$1.39 billion is the revenue reported by Tesla in Q1 2021."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;$10.4 BILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$10.4 billion is the revenue reported by Tesla in Q1 2021."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;MON, APR 26 2021 3:32 PM EDT&quot;">
      <data key="d0">"DATE_TIME"</data>
      <data key="d1">"This is the publication date of the first document."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;WED, JUL 21 2021 8:35 PM EDT&quot;">
      <data key="d0">"DATE_TIME"</data>
      <data key="d1">"This is the update date of the first document."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;APR 20, 2022&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"This is the date mentioned in the second and third documents."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;RECORD NET INCOME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Record net income is a significant financial achievement reported by Tesla."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;REVENUE SURGES BY 74%&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Revenue surge indicates a significant increase in revenue for Tesla."</data>
      <data key="d2">rgb-0012</data>
    </node>
    <node id="&quot;81 PERCENT INCREASE YEAR OVER YEAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An 81 percent increase in revenue year over year is a significant financial growth indicator."</data>
      <data key="d2">rgb-0012</data>
    </node>
