  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BRISBANE ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brisbane Road is a street in Leyton, known for its bustling atmosphere during matchdays."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;LEYTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leyton is a district in London, home to the Leyton Orient F.C. stadium."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;ARTEM KOZLOV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Artem Kozlov is a Ukrainian footballer who has played for Leyton Orient F.C. and currently plays for FC Bălți."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;UKRAINIAN FOOTBALL SCENE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ukrainian football scene refers to the football environment in Ukraine, where Artem Kozlov began his professional career."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;LEYTON ORIENT F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Leyton Orient F.C. is a football club based in Leyton, known for its iconic red and white stripes."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;JIMMY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jimmy is the manager of Leyton Orient F.C., a gruff but lovable Scotsman known for his motivational speeches."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;DAGGERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Daggers is a fictional opponent of Leyton Orient F.C., representing a rival team in the match."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;FC BĂLȚI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Bălți is a Moldovan football club based in Bălți, Moldova, where Artem Kozlov currently plays."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;KIEV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kiev is the capital city of Ukraine, where Artem Kozlov grew up and started playing football."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;TRAINING PITCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Training pitch is a place where footballers practice and hone their skills, symbolized by Artem Kozlov's worn-out Adidas boots."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;ORIENT FAITHFUL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orient faithful refers to the supporters of Leyton Orient F.C., known for their passionate support."</data>
      <data key="d2">cb-0008</data>
    </node>
    <node id="&quot;TRANSFERMARKT&quot;">
      <data key="d0">"ORGANIZATION"</data>
