  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GÜNTHER JAUCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Günther Jauch is a renowned German talk show host and journalist, known for his unique style of journalism and interviewing."|</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;NOVEMBER 21, 1981&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"November 21, 1981 is the date when Günther Jauch's talk show first aired on Das Erste."|</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;GÜNTHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Günther is a guest on a show, thanked by a producer for his work and recognized for his past influence on Brazilian television."</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;RAFAEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rafael is a young producer who expresses admiration for Günther's work and mentions watching his show as a child."</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;REDE BANDEIRANTES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rede Bandeirantes is a Brazilian television network that broadcast international programs, including Günther's show."</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;THE SHOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The show is an event where Günther appears as a guest, and it has been influential enough to be watched by Rafael as a child."</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;GREEN ROOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The green room is a place where Günther went after the show, indicating it is part of the show's setup or backstage area."</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;PRODUCER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A producer is a role within the show, specifically someone who interacts with guests like Günther.")</data>
      <data key="d2">cb-0244</data>
    </node>
    <node id="&quot;DAS ERSTE&quot;">
      <data key="d2">cb-0244</data>
      <data key="d1">"Both Das Erste and Rede Bandeirantes are prominent television networks, each broadcasting high-quality programming, including talk shows and news."::</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;CONVERSA BRASIL&quot;">
      <data key="d2">cb-0244</data>
      <data key="d1">"Conversa Brasil is a flagship talk show on Rede Bandeirantes, featuring discussions on various topics such as Carnival celebrations and soccer matches."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;LUIZ FELIPE&quot;">
      <data key="d2">cb-0244</data>
      <data key="d1">"Günther Jauch and Luiz Felipe had a conversation during the episode of Conversa Brasil, covering topics such as Carnival celebrations and soccer matches."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BRAZIL&quot;">
      <data key="d2">cb-0244</data>
      <data key="d1">"The show is broadcast on Rede Bandeirantes, a Brazilian network, indicating the show's relevance to Brazil."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;GÜNTHER JAUCH&quot;" target="&quot;REDE BANDEIRANTES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Günther Jauch appeared on Rede Bandeirantes' flagship talk show, Conversa Brasil, and his show was originally broadcast on the network in the early 2000s."</data>
      <data key="d5">"appearance, original broadcast"</data>
