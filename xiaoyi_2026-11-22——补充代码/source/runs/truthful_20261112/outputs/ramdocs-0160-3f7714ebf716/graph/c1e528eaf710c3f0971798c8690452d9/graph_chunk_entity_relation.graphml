  <graph edgedefault="undirected">
    <node id="&quot;STRING QUINTET NO. 2 (BRAHMS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"String Quintet No. 2 in G major, Op. 111, is a work by Johannes Brahms published in 1890, known as the 'Prater' Quintet."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;JOHANNES BRAHMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johannes Brahms is the composer of the String Quintet No. 2 in G major, Op. 111, and lived from 1833 to 1897."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;VIENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vienna is the location where the first performance of the String Quintet No. 2 in G major, Op. 111 took place on November 11, 1890."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;HYPERION RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hyperion Records is an independent British classical label devoted to presenting high-quality recordings of music of all styles and from all periods from the twelfth century to the twenty-first."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;STRING QUINTET NO. 2 IN G MAJOR, OP 111&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"String Quintet No. 2 in G major, Op 111 is a work by Johannes Brahms published in 1890, known as the 'Prater' Quintet."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;JOHANNES BRAHMS (1833-1897)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johannes Brahms is the composer of the String Quintet No. 2 in G major, Op. 111, and lived from 1833 to 1897."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;BEETHOVEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Beethoven is mentioned as a composer whose major works include nine symphonies, five piano concertos, a Violin Concerto, and the Academic Festival and Tragic Overtures, and he also wrote the String Quintet No. 2."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;LUDWIG VAN BEETHOVEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ludwig van Beethoven is the composer of the String Quintet No. 2, among other chamber works."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;WOLFGANG AMADEUS MOZART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wolfgang Amadeus Mozart composed the String Quintet No. 2 in C minor, K. 406/516b, a transcription of his earlier Serenade No. 12, K. 388, for wind octet."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;STRING QUINTET NO. 2 (MOZART)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"String Quintet No. 2 in C minor, K. 406/516b, was written by Wolfgang Amadeus Mozart in 1787, a transcription of his earlier Serenade No. 12, K. 388, for wind octet."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;CLARA SCHUMANN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Clara Schumann and her family spent some time in Lichtental, where Brahms worked on many of his major compositions including A German Requiem and his middle-period chamber works."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;PETER CORNELIUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Cornelius was a close member of Wagner's circle and an associate of Brahms in Vienna."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;KARL TAUSIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Karl Tausig was a close member of Wagner's circle and an associate of Brahms in Vienna."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;JOSEPH HELLMESBERGER SR.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Hellmesberger Sr. was a close member of Wagner's circle and an associate of Brahms in Vienna."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;JULIUS EPSTEIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Julius Epstein was a close member of Wagner's circle and an associate of Brahms in Vienna."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
    <node id="&quot;LICHTENTAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lichtental is the location where Brahms worked on many of his major compositions including A German Requiem and his middle-period chamber works."</data>
      <data key="d2">ramdocs-0160-3f7714ebf716</data>
    </node>
