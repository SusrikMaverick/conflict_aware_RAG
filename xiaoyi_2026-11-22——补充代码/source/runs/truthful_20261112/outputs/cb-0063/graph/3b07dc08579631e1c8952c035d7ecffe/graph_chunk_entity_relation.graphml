<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SASCHA LENSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sascha Lense is a German footballer born in 1975, currently playing for FSV Frankfurt. He is known for his lightning-quick reflexes and ability to read the game, and has a reputation as 'The Berlin Bullet'."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;FSV FRANKFURT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FSV Frankfurt is a German association football club where Sascha Lense has been a regular member since 2007."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;CSKA POMIR DUSHANBE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CSKA Pomir Dushanbe is a football club based in Dushanbe, Tajikistan, competing in the Tajikistan Higher League."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;FC ISTIKLOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Istiklol is a football club based in Dushanbe, Tajikistan, and is the arch-rival of CSKA Pomir Dushanbe."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;DUSHANBE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dushanbe is the capital city of Tajikistan, where CSKA Pomir Dushanbe is based and where the match takes place."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;TAJIKISTAN HIGHER LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Tajikistan Higher League is the top division of football in Tajikistan, where CSKA Pomir Dushanbe competes."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;RUSTAM KHODZHAEV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rustam Khodzhaev is a teammate of Sascha Lense on CSKA Pomir Dushanbe, known for his speed."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;AKBAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Akbar is the bus driver for CSKA Pomir Dushanbe, known for his grizzled demeanor and support for the team."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;VLADIMIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vladimir is the coach of CSKA Pomir Dushanbe, known for his wisdom and experience in managing the team."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;TAJIKISTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tajikistan is the country where CSKA Pomir Dushanbe is based and where the match takes place."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;CENTRAL REPUBLICAN STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Central Republican Stadium is the venue where the match between CSKA Pomir Dushanbe and FC Istiklol takes place."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is the city of origin for Sascha Lense, where he gained his nickname 'The Berlin Bullet'."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;BUNDESLIGA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bundesliga is the top division of football in Germany, where Sascha Lense previously played."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;RED AND BLUE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Red and Blue are the colors of CSKA Pomir Dushanbe, representing the team's identity and heritage."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;TEAM BUS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The team bus is the vehicle used by CSKA Pomir Dushanbe to transport players to the stadium."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;STREETS OF DUSHANBE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The streets of Dushanbe are the area where the team prepares for the match, filled with anticipation and excitement."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;FOOTBALL ENTHUSIASTS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Football Enthusiasts are the fans of CSKA Pomir Dushanbe who are excited about the upcoming match."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;MATCH REPORT&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Match Reports are written accounts of the match, providing detailed information about the game."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;TEAM PHOTOS&quot;">
      <data key="d0">"IMAGE"</data>
      <data key="d1">"Team Photos are images of the CSKA Pomir Dushanbe team, often used in promotional materials and social media."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;TAJIK PEOPLE&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"The Tajik People are the supporters and residents of Tajikistan, whose passion and dedication resonate with Sascha Lense."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;SUN&quot;">
      <data key="d0">"NATURAL PHENOMENON"</data>
      <data key="d1">"The Sun is mentioned as setting behind the rugged mountains of Tajikistan, creating a vivid scene."</data>
      <data key="d2">cb-0063</data>
    </node>
    <node id="&quot;RUGGED MOUNTAINS&quot;">
      <data key="d0">"LANDFORM"</data>
      <data key="d1">"The Rugged Mountains are the natural landscape of Tajikistan, providing a scenic backdrop for the match preparations."</data>
      <data key="d2">cb-0063</data>
    </node>
    <edge source="&quot;SASCHA LENSE&quot;" target="&quot;FSV FRANKFURT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Sascha Lense has been a regular member of FSV Frankfurt since 2007, indicating a long-standing relationship with the club."</data>
