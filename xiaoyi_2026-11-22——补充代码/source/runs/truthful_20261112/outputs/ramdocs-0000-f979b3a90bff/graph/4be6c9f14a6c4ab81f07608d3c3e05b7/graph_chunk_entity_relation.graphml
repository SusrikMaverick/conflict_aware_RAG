<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BROKEN BOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Broken Bow is a city in Nebraska, mentioned as the location where the census data is collected."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;UNITED STATES CENSUS BUREAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Census Bureau is the organization responsible for collecting demographic data."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"City refers to the area within Broken Bow where the population and household data are recorded."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;CENSUS OF 2010&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The census of 2010 is a specific event where population and demographic data were collected."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;3,559 PEOPLE&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"3,559 people is the population count as of the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;1,575 HOUSEHOLDS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"1,575 households is the number of households recorded in the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;909 FAMILIES&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"909 families is the number of family units recorded in the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;POPULATION DENSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Population density is a measure of how many people live in a given area."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;1,730 HOUSING UNITS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"1,730 housing units is the number of housing units recorded in the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;95.7% WHITE&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"95.7% of the city's population is White according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;0.4% AFRICAN AMERICAN&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"0.4% of the city's population is African American according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;0.7% NATIVE AMERICAN&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"0.7% of the city's population is Native American according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;0.1% ASIAN&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"0.1% of the city's population is Asian according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;1.3% FROM OTHER RACES&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"1.3% of the city's population is from other races according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;1.7% FROM TWO OR MORE RACES&quot;">
      <data key="d0">"PERCENTAGE"</data>
      <data key="d1">"1.7% of the city's population is from two or more races according to the 2010 census."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;1888&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"1888 is the year mentioned as the starting point of the document."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;TOTAL AREA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Total area refers to the geographical size of the city."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;LAND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Land is the type of area measured in the total area of the city."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;GEOGRAPHIC CENTER OF NEBRASKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Geographic center of Nebraska is a specific location mentioned in relation to Broken Bow."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;10 MILES NORTHWEST OF BROKEN BOW&quot;">
      <data key="d0">"DISTANCE"</data>
      <data key="d1">"10 miles northwest of Broken Bow is the distance to the geographic center of Nebraska."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <node id="&quot;10,000&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"10,000 is the population count mentioned in the third document, though it seems to be incorrect or outdated."</data>
      <data key="d2">ramdocs-0000-f979b3a90bff</data>
    </node>
    <edge source="&quot;UNITED STATES CENSUS BUREAU&quot;" target="&quot;CENSUS OF 2010&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The United States Census Bureau is responsible for conducting the 2010 census."</data>
      <data key="d5">"data collection, responsibility"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;3,559 PEOPLE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The 2010 census recorded 3,559 people in the city."</data>
      <data key="d5">"population count, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;1,575 HOUSEHOLDS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The 2010 census recorded 1,575 households in the city."</data>
      <data key="d5">"household count, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;909 FAMILIES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The 2010 census recorded 909 family units in the city."</data>
      <data key="d5">"family unit count, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;1,730 HOUSING UNITS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The 2010 census recorded 1,730 housing units in the city."</data>
      <data key="d5">"housing unit count, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;95.7% WHITE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The 2010 census recorded 95.7% of the city's population as White."</data>
      <data key="d5">"race distribution, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
    <edge source="&quot;CENSUS OF 2010&quot;" target="&quot;0.4% AFRICAN AMERICAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The 2010 census recorded 0.4% of the city's population as African American."</data>
      <data key="d5">"race distribution, census result"</data>
      <data key="d6">ramdocs-0000-f979b3a90bff</data>
    </edge>
  </graph>
