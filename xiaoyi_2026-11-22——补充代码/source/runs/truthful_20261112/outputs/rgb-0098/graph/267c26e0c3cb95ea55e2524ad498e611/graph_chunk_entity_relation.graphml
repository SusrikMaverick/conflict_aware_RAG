<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is selected as the host city for the 2008 Olympics, making it a significant location in the context of the event."</data>
      <data key="d2">rgb-0098</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is selected as the host city for the 2008 Olympics, making it another significant location in the context of the event."</data>
      <data key="d2">rgb-0098</data>
    </node>
    <node id="&quot;MOSCOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"MOSCOW is the source of the announcement, indicating it as a key location for news dissemination."</data>
      <data key="d2">rgb-0098</data>
    </node>
    <node id="&quot;WORLD'S MOST POPULOUS COUNTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Refers to China, which is implied to be the host country for the Olympics based on the context."</data>
      <data key="d2">rgb-0098</data>
    </node>
    <node id="&quot;OLYMPIC GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Olympic Games is the central event discussed, involving multiple host cities and their preparations."</data>
      <data key="d2">rgb-0098</data>
    </node>
    <edge source="&quot;BEIJING&quot;" target="&quot;OLYMPIC GAMES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Beijing is selected as the host city for the 2008 Olympic Games, making it a key location for the event."</data>
      <data key="d5">"host city, event selection"</data>
      <data key="d6">rgb-0098</data>
    </edge>
    <edge source="&quot;LONDON&quot;" target="&quot;OLYMPIC GAMES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"London is also considered as a host city for the 2008 Olympic Games, competing with Beijing for the honor."</data>
      <data key="d5">"competition, event selection"</data>
      <data key="d6">rgb-0098</data>
    </edge>
    <edge source="&quot;MOSCOW&quot;" target="&quot;OLYMPIC GAMES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"MOSCOW is the source of the announcement regarding the selection of host cities for the 2008 Olympic Games, indicating its role in news dissemination."</data>
      <data key="d5">"news source, event announcement"</data>
      <data key="d6">rgb-0098</data>
    </edge>
    <edge source="&quot;WORLD'S MOST POPULOUS COUNTRY&quot;" target="&quot;OLYMPIC GAMES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"China, as the world's most populous country, is implied to be the host country for the 2008 Olympic Games, highlighting its significance."</data>
      <data key="d5">"country significance, event host"</data>
      <data key="d6">rgb-0098</data>
    </edge>
  </graph>
</graphml>
