      <data key="d3">8.0</data>
      <data key="d4">"The Royal Shakespeare Company offers Yuriy Sarantsev the role of Hamlet, representing a significant opportunity in his acting career and a step towards international recognition."</data>
      <data key="d5">"opportunity, international recognition"</data>
      <data key="d6">cb-0369</data>
    </edge>
    <edge source="&quot;YURIY SARANTSEV&quot;" target="&quot;HAMLET&quot;">
