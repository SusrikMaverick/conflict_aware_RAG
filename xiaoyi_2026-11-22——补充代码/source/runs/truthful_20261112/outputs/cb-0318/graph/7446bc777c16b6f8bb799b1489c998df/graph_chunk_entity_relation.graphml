<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BUDAPEST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Budapest is the capital city of Hungary where Károly Szakonyi spent his formative years and attended Madách Imre High School."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;HUNGARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hungary is the country where Károly Szakonyi was born and developed his literary career."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;MADÁCH IMRE HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Madách Imre High School is a prestigious institution in Budapest that played a pivotal role in shaping Károly Szakonyi's artistic vision."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;IMRE MADÁCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Imre Madách is a renowned Hungarian poet and playwright whose works had a profound impact on the country's literary heritage and the school's namesake."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;SÁNDOR MÁRAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sándor Márai is a Hungarian master whose works influenced Károly Szakonyi during his time at Madách Imre High School."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;DEZSŐ KOSZTOLÁNYI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dezső Kosztolányi is another Hungarian master whose works influenced Károly Szakonyi during his time at Madách Imre High School."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;SHAKESPEARE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Shakespeare is a classical playwright whose works influenced Károly Szakonyi during his time at Madách Imre High School."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;MOLIÈRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean-Baptiste Poquelin, known as Molière, is a classical playwright whose works influenced Károly Szakonyi during his time at Madách Imre High School."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;TOKYO UNIVERSITY OF MARINE SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tokyo University of Marine Science and Technology is the institution where Károly Szakonyi studied and was inspired by Professor Nakamura's lectures on the ocean's secrets."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;EMIKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emiko is a brilliant and introverted marine biologist who was Károly Szakonyi's study partner and confidante during their time in Tokyo."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;CAPTAIN JÓZSEF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Captain József is a grizzled old sailor who regaled Károly Szakonyi and Emiko with tales of the open sea over steaming bowls of ramen in the university's cafeteria."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;PROFESSOR NAKAMURA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Nakamura is a passionate lecturer at Tokyo University of Marine Science and Technology who inspired Károly Szakonyi's fascination with the ocean's mysteries."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;ERZSÉBET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Erzsébet is Károly Szakonyi's wife who brings him coffee and Japanese biscuits from the market."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;KÁROLY SZAKONYI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Károly Szakonyi is a Hungarian writer and playwright who attended Madách Imre High School and later became famous for his literary works."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is the city where Károly Szakonyi studied at Tokyo University of Marine Science and Technology."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;JAPANESE BISCUITS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Japanese biscuits are treats brought back by Erzsébet from the market, enjoyed by Károly Szakonyi."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;RESEARCH VESSEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A research vessel is mentioned as the setting where Károly Szakonyi and Emiko took a snapshot on the deck in Tokyo Bay."&lt;SEP&gt;"The research vessel is a location where the characters are currently situated, likely conducting scientific research."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;TOKYO BAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo Bay is the location where Károly Szakonyi and Emiko took a snapshot on a research vessel."&lt;SEP&gt;"Tokyo Bay is the specific location where the research vessel is anchored, providing context for the setting."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot; SNAPSHOT&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A snapshot is a faded photograph of Károly Szakonyi and Emiko taken on the deck of a research vessel in Tokyo Bay."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;SUNLIGHT&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Sunlight is mentioned as dancing through the aquariums in the university's research facility, casting an ethereal glow over the bustling students."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;AQUARIUMS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Aquariums are part of the research facility at Tokyo University of Marine Science and Technology where sunlight dances through them."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;STUDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Students are mentioned as bustling around the research facility at Tokyo University of Marine Science and Technology."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;RAMEN&quot;">
      <data key="d0">"FOOD"</data>
      <data key="d1">"Ramen is a food item mentioned as being enjoyed by Károly Szakonyi and Emiko in the university's cafeteria."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;UNIVERSITY CAFETERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The university cafeteria is a location where Károly Szakonyi and Emiko enjoyed steaming bowls of ramen."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;RESEARCH FACILITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The research facility is a location at Tokyo University of Marine Science and Technology where Károly Szakonyi and Emiko studied and worked."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;MARINE BIOLOGY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Marine biology is the field of study for Emiko, a brilliant and introverted marine biologist."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;OPEN SEA&quot;">
      <data key="d0">"PLACE"</data>
      <data key="d1">"The open sea is a place where Captain József regaled Károly Szakonyi and Emiko with tales."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;WORN WOODEN DESK&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A worn wooden desk is where Károly Szakonyi sat and wrote his manuscript."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;DOG-EARED BOOKS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Dog-eared books are mentioned as stacks surrounding Károly Szakonyi's worn wooden desk."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;MANUSCRIPT&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A manuscript is the object Károly Szakonyi was writing on when his thoughts were interrupted by his wife."&lt;SEP&gt;"Károly's manuscript is the focus of his renewed purpose and creative work."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;KÁROLY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Károly is a writer who is revisiting memories and returning to his work, feeling a mix of nostalgia and renewed purpose."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;DECK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The deck of the research vessel is where the characters are standing, providing a specific location within the setting."</data>
      <data key="d2">cb-0318</data>
    </node>
    <node id="&quot;CHARACTERS OF HIS STORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The characters in Károly's story come to life as he writes, representing his creative process."</data>
      <data key="d2">cb-0318</data>
    </node>
