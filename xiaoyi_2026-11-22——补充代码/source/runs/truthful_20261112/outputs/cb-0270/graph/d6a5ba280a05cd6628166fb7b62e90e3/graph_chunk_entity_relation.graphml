  <graph edgedefault="undirected">
    <node id="&quot;EDUARDO G. YUKIHARA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eduardo G. Yukihara is a renowned researcher who was affiliated with Oklahoma State University–Stillwater and conducted groundbreaking research on epigenetic markers."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;OKLAHOMA STATE UNIVERSITY–STILLWATER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oklahoma State University–Stillwater is a public institution of higher learning where Eduardo G. Yukihara worked from 2005 to 2010, contributing to various research projects and academic initiatives."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;DR. PAMELA MURRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Pamela Murray is a colleague of Eduardo G. Yukihara who praised his dedication to his work and contributions to research projects."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;DR. RANDY R. RUCHTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Randy R. Ruchti is a professor of physics at Oklahoma State University–Stillwater who highlighted Eduardo G. Yukihara's contributions to advancing the understanding of radiation detection."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;JOURNAL OF APPLIED PHYSICS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Journal of Applied Physics is a scientific journal where Eduardo G. Yukihara co-authored a paper on the applications of advanced materials in radiation detection."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;BABRAHAM INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Babraham Institute is a research facility where Dr. Sophia Patel works and where Eduardo G. Yukihara is currently conducting research on epigenetic markers."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a scientist at the Babraham Institute who is collaborating with Eduardo G. Yukihara on research related to epigenetic markers."</data>
      <data key="d2">cb-0270</data>
    </node>
    <node id="&quot;OKLAHOMA STATE UNIVERSITY–STILLWATER HUMAN RESOURCES DEPARTMENT&quot;">
