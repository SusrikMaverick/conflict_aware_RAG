  <graph edgedefault="undirected">
    <node id="&quot;PINEHURST, MONTGOMERY COUNTY, TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pinehurst, Montgomery County, Texas is a census-designated place (CDP) in Montgomery County, Texas, United States, with a population of 4,624 at the 2010 census. It is located at (30.178614, -95.696303) and covers 9.0 square miles (23.4 km²). The name was changed from 'Prairie Home' to 'Hunter's Retreat' in 1871 and then to 'Pinehurst' in 1904 after the railroad was built."</data>
      <data key="d2">ramdocs-0119-b3222023613a</data>
    </node>
  </graph>
