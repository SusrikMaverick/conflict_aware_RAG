<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COOKS RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cooks River is a river that connects Olympic Park at Homebush with Botany Bay and runs through Croydon Park."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;CROYDON COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Croydon Council is committed to the development of the Westfield Centre and is involved in major plans for the town."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;WESTFIELD CENTRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Westfield Centre is a planned development that Croydon Council is committed to proceeding with."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;CROYDON GATEWAY SITE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Croydon Gateway site is another major plan for the town, mentioned alongside the Westfield Centre."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;ASHFIELD STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ashfield station is the eastern terminus of a tram line and is located near Summer Hill station on the main suburban railway line."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;SUMMER HILL STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Summer Hill station is a tram terminus located near Ashfield station on the main suburban railway line."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;GEORGES RIVER ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Georges River Road is a commercial strip in Croydon Park that runs through the center of the suburb."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;FLOWER POWER GARDEN CENTRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Flower Power Garden Centre is a commercial enterprise located in Croydon Park."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;CROYDON PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Croydon Park is a suburb with a commercial strip along Georges River Road and other commercial enterprises."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;2021&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2021 is the year when Croydon Council confirmed their commitment to the Westfield Centre project."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;SYDNEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney is the city where the tram line in question is located."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;TRAM LINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A tram line is mentioned that was never connected to other tram lines in Sydney."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;ENFIELD BRANCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Enfield branch is part of the Flower Power Garden Centre, located in Croydon Park."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;MAIN SUBURBAN RAILWAY LINE&quot;">
      <data key="d0">"TRANSPORTATION"</data>
      <data key="d1">"The main suburban railway line connects Ashfield station to Summer Hill station."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
    <node id="&quot;COMMERCIAL ENTERPRISES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Commercial enterprises exist in various parts of Croydon Park, including the Enfield branch of Flower Power Garden Centre."</data>
      <data key="d2">ramdocs-0187-c523f76527b9</data>
    </node>
