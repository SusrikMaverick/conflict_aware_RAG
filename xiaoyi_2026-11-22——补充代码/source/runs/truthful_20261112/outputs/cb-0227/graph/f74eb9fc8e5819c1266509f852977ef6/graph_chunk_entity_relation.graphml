  <graph edgedefault="undirected">
    <node id="&quot;SCOTT BAMFORTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scott Bamforth is a professional basketball player known for his lightning-quick reflexes and sharp shooting skills, leading Weber State Wildcats to victory."</data>
      <data key="d2">cb-0227</data>
    </node>
    <node id="&quot;WEBER STATE WILDCATS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Weber State Wildcats is a men's basketball team that has seen success due to Scott Bamforth's contributions, including a winning streak and high scoring average."</data>
      <data key="d2">cb-0227</data>
    </node>
    <node id="&quot;RANDY RAHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Randy Rahe is the head coach of Weber State Wildcats, praising Scott Bamforth's work ethic and leadership."</data>
      <data key="d2">cb-0227</data>
    </node>
    <node id="&quot;MARK STEVENS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Stevens is a local sports analyst who recognizes Scott Bamforth's talent and potential to lead Weber State Wildcats further."</data>
      <data key="d2">cb-0227</data>
    </node>
    <node id="&quot;BANK BGŻ&quot;">
      <data key="d0">"ORGANIZATION"</data>
