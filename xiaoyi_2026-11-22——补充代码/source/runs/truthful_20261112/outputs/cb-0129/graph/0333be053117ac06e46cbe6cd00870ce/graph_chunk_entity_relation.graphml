  <graph edgedefault="undirected">
    <node id="&quot;LESLIE STEPHEN BOX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leslie Stephen Box is a New Zealand community leader who was awarded the Queen's Service Medal (QSM) in 2018 for his services to the community."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;QUEEN'S SERVICE MEDAL (QSM)&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Queen's Service Medal (QSM) is a prestigious honor conferred by the New Zealand government to recognize significant contributions to the community."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;DUNEDIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dunedin is a city on the South Island of New Zealand, known for its rich cultural heritage, stunning natural beauty, and vibrant community."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;AUCKLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Auckland is a city in New Zealand where Leslie Stephen Box was born and spent his early years, developing a strong sense of community and social responsibility."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;WELLINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wellington is the capital city of New Zealand where the Queen's Service Medal (QSM) ceremony took place."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;CHLISTOV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chlistov is a village in the Klatovy District of the Plzeň region in the Czech Republic, known for its strong sense of community and commitment to social welfare."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;KLATOVY DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Klatovy District is a district in the Plzeň region of the Czech Republic where Chlistov is located."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;PLZEŇ REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Plzeň region is a region in the Czech Republic where Chlistov is situated."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;JOURNAL OF COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Journal of Community Development is a publication that featured a case study on Leslie Stephen Box in Chlistov."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;CHLISTOV MUNICIPAL COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chlistov Municipal Council is the governing body of Chlistov and conducted a survey on community engagement."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;NEW ZEALAND GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New Zealand government confers the Queen's Service Medal (QSM) to recognize significant community contributions."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community refers to groups of people who share common interests, values, or activities."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;SOCIAL RESPONSIBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social responsibility involves taking responsibility for the impact of one's actions on society and the environment."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;COMMUNITY ENGAGEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community engagement involves active participation and collaboration within a community to achieve common goals."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;VOLUNTEERISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Volunteerism involves volunteering time and effort to help others without expecting financial compensation."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community development involves improving the quality of life in a community through various initiatives and programs."</data>
      <data key="d2">cb-0129</data>
    </node>
    <node id="&quot;SOCIAL WELFARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social welfare refers to programs and policies designed to improve the well-being of individuals and communities."</data>
      <data key="d2">cb-0129</data>
    </node>
