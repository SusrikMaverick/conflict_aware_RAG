<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LEOPOLD HAFTEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leopold Haftel is a Holocaust victim born in Brno, Czech Republic, known for his resilience and business acumen. He lived through the Nazi occupation and found solace in Loppi, Finland."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;BRNO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brno is a statutory city in the Czech Republic, known for its rich history and cultural heritage. It was the birthplace and home of Leopold Haftel for over eight decades."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;RIVER SVRATKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"River Svratka is a river flowing through Brno, Czech Republic, symbolizing the city's natural beauty and historical context."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;CZECH REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Czech Republic is the country where Brno is located, known for its rich history and cultural heritage."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;NAZI GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nazi Germany refers to the regime that occupied Czechoslovakia in 1939, leading to the Holocaust and the persecution of Jews."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;JEWISH COMMUNITY OF BRNO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Jewish community of Brno was a significant part of the city's society, known for its contributions to the city's economy and culture."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;LOPPI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Loppi is a village in Finland where Leopold Haftel found solace after the war, known for its quiet, rolling hills and kind people."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;AINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aino is the baker's daughter in Loppi who interacts with Leopold, symbolizing the kindness and support he found there."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;FINNISH AIR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Finnish air refers to the environment and atmosphere of Loppi, where Leopold found peace and solace after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;FEBRUARY 2, 1859&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 2, 1859 is the birth date of Leopold Haftel, marking the beginning of his life story."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;18TH CENTURY&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"The Haftel family's roots in Brno date back to the 18th century, indicating their long-standing presence in the city."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;1939&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1939 marks the beginning of the Nazi occupation of Czechoslovakia, leading to the Holocaust and the persecution of Jews."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;CONCENTRATION CAMPS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Concentration camps were the destination for many members of the Jewish community of Brno, including Leopold's family."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;HOLOCAUST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Holocaust refers to the systematic persecution and genocide of Jews by Nazi Germany, affecting Leopold's family and community."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;HAFTEL FAMILY BUSINESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Haftel family business was a prominent fixture in Brno's commercial circles, providing for the family and contributing to the city's economic growth."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;HAFTEL FAMILY ASSETS&quot;">
      <data key="d0">"ASSET"</data>
      <data key="d1">"Haftel family assets were confiscated by the Nazis, marking a significant loss for the family."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;LOPPI COTTAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Loppi cottage is the residence of Leopold Haftel in Loppi, Finland, where he found solace after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;BAKER'S DAUGHTER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Baker's daughter refers to Aino, who represents the kindness and support Leopold found in Loppi."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;WINTERS&quot;">
      <data key="d0">"SEASON"</data>
      <data key="d1">"Winters are mentioned as a time when Leopold Haftel emerges from his cottage, symbolizing the changing seasons of his life."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;CRISP FINNISH AIR&quot;">
      <data key="d0">"ENVIRONMENT"</data>
      <data key="d1">"Crisp Finnish air refers to the environment and atmosphere of Loppi, where Leopold found peace and solace after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;FRESHLY BAKED RYE BREAD&quot;">
      <data key="d0">"FOOD"</data>
      <data key="d1">"Freshly baked rye bread is a symbol of the daily life and routine in Loppi, where Leopold found solace."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;VILLAGERS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Villagers in Loppi are known for their kindness and familiarity with Leopold, symbolizing the community he found in Loppi."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;QUIET, ROLLING HILLS&quot;">
      <data key="d0">"LANDMARK"</data>
      <data key="d1">"Quiet, rolling hills are a landmark in Loppi, representing the peaceful and healing environment Leopold found there."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;BOOK&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Book is a symbol of Leopold's intellectual pursuits and the knowledge he sought to rebuild his life."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"War refers to the period of conflict and turmoil that defined Leopold's life, including the Holocaust and the Nazi occupation."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;LOPPI VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Loppi village is the setting where Leopold found solace and rebuilt his life after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;HEI, LEOPOLD!&quot;">
      <data key="d0">"GREETING"</data>
      <data key="d1">"Hei, Leopold! is a greeting used by Aino, symbolizing the friendly interactions Leopold had in Loppi."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;KIITOS, AINO&quot;">
      <data key="d0">"RESPONSE"</data>
      <data key="d1">"Kiitos, Aino is a response used by Leopold, symbolizing the friendly interactions and exchanges in Loppi."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Village refers to Loppi, where Leopold found solace and rebuilt his life after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;ADOPTED VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Adopted village refers to Loppi, where Leopold found a new home and rebuilt his life after the war."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;MEMORIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Memories refer to the recollections of Leopold's life, both before and after the war, symbolizing the healing process."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;LEOPOLD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leopold is a character whose life has experienced turmoil but is now in a state of ease or stability."</data>
      <data key="d2">cb-0358</data>
    </node>
    <node id="&quot;TURMOIL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Turmoil refers to the difficult and chaotic period that characterized Leopold's life before the current state of ease."</data>
      <data key="d2">cb-0358</data>
    </node>
    <edge source="&quot;LEOPOLD HAFTEL&quot;" target="&quot;BRNO&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Leopold Haftel was born and lived in Brno for over eight decades, making it his home and center of his life story."</data>
      <data key="d5">"home, resilience"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;LEOPOLD HAFTEL&quot;" target="&quot;JEWISH COMMUNITY OF BRNO&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Leopold Haftel was an integral part of the Jewish community of Brno, which was a significant part of the city's society."</data>
      <data key="d5">"community, contribution"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;LEOPOLD HAFTEL&quot;" target="&quot;NAZI GERMANY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Leopold Haftel faced the brutal reality of the Nazi occupation, losing his business and family assets due to the regime's policies."</data>
      <data key="d5">"resilience, loss"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;LEOPOLD HAFTEL&quot;" target="&quot;LOPPI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Loppi provided Leopold Haftel with solace and a sense of home after the war, allowing him to rebuild his life."</data>
      <data key="d5">"solace, home"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;LEOPOLD HAFTEL&quot;" target="&quot;AINO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Aino, the baker's daughter, represents the kindness and support Leopold found in Loppi, symbolizing the healing of his wounds."</data>
      <data key="d5">"kindness, support"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;BRNO&quot;" target="&quot;CZECH REPUBLIC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Brno is a city in the Czech Republic, representing the broader context of the country during the Holocaust."</data>
      <data key="d5">"context, history"</data>
      <data key="d6">cb-0358</data>
    </edge>
    <edge source="&quot;NAZI GERMANY&quot;" target="&quot;JEWISH COMMUNITY OF BRNO&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Nazi Germany persecuted the Jewish community of Brno, leading to the destruction of their lives and assets."</data>
      <data key="d5">"persecution, destruction"</data>
      <data key="d6">cb-0358</data>
    </edge>
  </graph>
</graphml>
