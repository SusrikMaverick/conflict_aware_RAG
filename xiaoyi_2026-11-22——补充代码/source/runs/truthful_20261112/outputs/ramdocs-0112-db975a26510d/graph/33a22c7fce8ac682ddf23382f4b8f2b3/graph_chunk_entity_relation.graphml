<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TIME-LIFE BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Time-Life Building is a construction project that started in 1958 and was completed in 1959, featuring green glass cladding and large murals by Josef Albers and Fritz."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;ROXY THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Roxy Theatre was located west of the Time-Life Building and was torn down in 1960 to make way for an office tower."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;JOSEF ALBERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Josef Albers is an artist known for creating large murals on the Time-Life Building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;FRITZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fritz is another artist known for creating large murals on the Time-Life Building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;ROCKEFELLER PLAZA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rockefeller Plaza is the site of a new building that started construction in 1936, eventually becoming 9 Rockefeller Plaza."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;9 ROCKEFELLER PLAZA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"9 Rockefeller Plaza is the final name of the building constructed at Rockefeller Plaza, originally planned to be 32 stories but ended up being 36 stories."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;TIME &amp; LIFE BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Time &amp; Life Building is another name for the Time-Life Building, mentioned in the context of its original blueprints being retained for the new building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;APRIL 1958&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Construction on the Time-Life Building's steelwork started in April 1958."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;NOVEMBER 1958&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The structure of the Time-Life Building topped out in November 1958."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;JUNE 1959&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The cornerstone of the Time-Life Building was laid in June 1959."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;DECEMBER 1959&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The first tenants began moving into the Time-Life Building in December 1959."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;AIR RIGHTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Air rights were purchased from the Roxy Theatre to the west to build an office tower connected to the Time &amp; Life Building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;OFFICE TOWER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"An office tower was built on the air rights purchased from the Roxy Theatre, connected to the Time &amp; Life Building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;32-STORY BUILDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The original plans stipulated a 32-story building at 9 Rockefeller Plaza."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;36-STORY BUILDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The height of the building at 9 Rockefeller Plaza was increased to 36 stories with the use of setbacks on the 48th Street elevation."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;SETBACKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Setbacks on the 48th Street elevation were used to increase rentable space within the building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;BLUEPRINTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Original blueprints for the plot were retained for the Time &amp; Life Building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;32 STORIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The original plans for the building at 9 Rockefeller Plaza specified 32 stories."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;36 STORIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The building at 9 Rockefeller Plaza was ultimately 36 stories tall."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;SETBACK REDUCTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The number of setbacks was minimized to increase rentable space within the building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;JUNE 1936&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Excavation for a new building at 9 Rockefeller Plaza started in June 1936."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;JULY 1936&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The original plans for the building at 9 Rockefeller Plaza specified 32 stories."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;AUGUST 1936&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The height of the building at 9 Rockefeller Plaza was increased to 36 stories with the use of setbacks on the 48th Street elevation."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;48TH STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The 48th Street elevation is where setbacks were used to increase rentable space within the building."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;20-YEAR LEASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The company received a 20-year lease for the new building at 9 Rockefeller Plaza."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;NAME THE BUILDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The company had the right to name the building after themselves."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The company that received the lease and naming rights for the new building at 9 Rockefeller Plaza."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <node id="&quot;TENANT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The first tenants began moving into the Time-Life Building in December 1959."</data>
      <data key="d2">ramdocs-0112-db975a26510d</data>
    </node>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;ROXY THEATRE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Roxy Theatre was located west of the Time-Life Building and was demolished to make way for an office tower connected to the Time &amp; Life Building."</data>
      <data key="d5">"demolition, connection"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;JOSEF ALBERS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Josef Albers created large murals on the Time-Life Building."</data>
      <data key="d5">"artistic contribution, decoration"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;FRITZ&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Fritz also created large murals on the Time-Life Building."</data>
      <data key="d5">"artistic contribution, decoration"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;APRIL 1958&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Construction on the Time-Life Building's steelwork started in April 1958."</data>
      <data key="d5">"construction start date"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;NOVEMBER 1958&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The structure of the Time-Life Building topped out in November 1958."</data>
      <data key="d5">"construction completion date"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;TIME-LIFE BUILDING&quot;" target="&quot;JUNE 1959&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The cornerstone of the Time-Life Building was laid in June 1959."</data>
      <data key="d5">"cornerstone laying date"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;ROCKEFELLER PLAZA&quot;" target="&quot;9 ROCKEFELLER PLAZA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"9 Rockefeller Plaza is the final name of the building constructed at Rockefeller Plaza, starting construction in 1936 and ending up being 36 stories."</data>
      <data key="d5">"construction, naming"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
    <edge source="&quot;9 ROCKEFELLER PLAZA&quot;" target="&quot;TIME &amp; LIFE BUILDING&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The original blueprints for the Time &amp; Life Building were retained for the construction of 9 Rockefeller Plaza."</data>
      <data key="d5">"blueprint retention, construction planning"</data>
      <data key="d6">ramdocs-0112-db975a26510d</data>
    </edge>
  </graph>
