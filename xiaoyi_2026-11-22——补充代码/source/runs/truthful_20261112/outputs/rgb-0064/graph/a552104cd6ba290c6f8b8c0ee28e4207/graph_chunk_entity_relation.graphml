  <graph edgedefault="undirected">
    <node id="&quot;ANIMATED FEATURE FILM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Animated Feature Film is a category of films recognized for their animation and storytelling, often nominated for awards such as the Oscars."</data>
      <data key="d2">rgb-0064</data>
    </node>
    <node id="&quot;SOUL&quot;">
      <data key="d0">"MOVIE"</data>
