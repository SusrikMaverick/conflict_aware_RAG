  <graph edgedefault="undirected">
    <node id="&quot;SUMTER COUNTY COURTHOUSE (ALABAMA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sumter County Courthouse (Alabama) is a historic county courthouse building in Livingston, Sumter County, Alabama, designed in the Beaux-Arts style and completed in 1902."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;LIVINGSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Livingston is a town in Sumter County, Alabama, where the Sumter County Courthouse (Alabama) is located."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;SUMTER COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sumter County is a county in Alabama, containing the town of Livingston and the Sumter County Courthouse (Alabama)."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;CHAPMAN AND FREDERICK AUSFELD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chapman and Frederick Ausfeld were the architects who designed the Sumter County Courthouse (Alabama)."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;DABBS, C.H. &amp; CO.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dabbs, C.H. &amp; Co. was the construction company that built the Sumter County Courthouse (Alabama) in 1902."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;BEAUX-ARTS STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Beaux-Arts style is the architectural style in which the Sumter County Courthouse (Alabama) was designed."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is an organization that recognized the Sumter County Courthouse on June 16, 2004, for its historical significance."&lt;SEP&gt;"The National Register of Historic Places is the organization that added the Sumter County Courthouse (Alabama) to its registry in 1972."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1902&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1902 is the year the Sumter County Courthouse (Alabama) was completed."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1972&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1972 is the year the Sumter County Courthouse (Alabama) was added to the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1833&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1833 is the year the first log structure courthouse was built in Sumter County, Alabama."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1837&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1837 is the year the first log structure courthouse in Sumter County, Alabama was replaced."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1855&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1855 is the year the third courthouse in Sumter County, Alabama was constructed."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1901&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1901 is the year the previous courthouse in Sumter County, Alabama was destroyed by fire."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;1850&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1850 is the year the second courthouse in Sumter County, Alabama was built but collapsed and was torn down."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;32°34′58″N 88°11′18″W&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"32°34′58″N 88°11′18″W are the coordinates of the Sumter County Courthouse (Alabama)."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;2 ACRES (0.81 HA)&quot;">
      <data key="d0">"MEASUREMENT"</data>
      <data key="d1">"2 acres (0.81 ha) is the area of the land on which the Sumter County Courthouse (Alabama) is situated."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;MARCH 24, 1972&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"March 24, 1972 is the date the Sumter County Courthouse (Alabama) was added to the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;WILLIAM AUGUSTUS EDWARDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Augustus Edwards is an architect who designed the Sumter County Courthouse and eight other South Carolina courthouses, as well as academic buildings at 12 institutions in Florida, Georgia, and South Carolina."&lt;SEP&gt;"William Augustus Edwards was the architect who designed the Sumter County Courthouse (Alabama) and other buildings in the region."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;UNIVERSITY OF FLORIDA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Florida is an institution whose original buildings were designed by William Augustus Edwards, including some of the buildings on its campus."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;GAINESVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gainesville is the city where some of the buildings designed by William Augustus Edwards for the University of Florida are located."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
    </node>
    <node id="&quot;141 NORTH MAIN STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"141 North Main Street is the address of the Sumter County Courthouse (South Carolina)."&lt;SEP&gt;"141 North Main Street is the address of the Sumter County Courthouse."</data>
      <data key="d2">ramdocs-0475-da15e0fe83c9</data>
