  <graph edgedefault="undirected">
    <node id="&quot;UNITY CHRISTIAN HIGH SCHOOL (FULTON)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Unity Christian High School (Fulton) is a private high school located in Fulton, Illinois, USA, educating around 75 students in grades 7-12. It was established in 1981 and has a curriculum focused on integrating Biblical truths. The school offers various sports and a praise band."</data>
      <data key="d2">ramdocs-0470-18cb8c397ff1</data>
    </node>
    <node id="&quot;UNITY CHRISTIAN HIGH SCHOOL (MIAMI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Unity Christian High School (Miami) is a private high school located in Miami, Florida, USA, educating around 75 students in grades 7-12. It was established in 1981 and has a curriculum focused on integrating Biblical truths. The school offers various sports and a praise band."</data>
      <data key="d2">ramdocs-0470-18cb8c397ff1</data>
    </node>
    <node id="&quot;UNITY CHRISTIAN HIGH SCHOOL (HUDSONVILLE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Unity Christian High School (Hudsonville) is a private Christian school in Hudsonville, Michigan, a member of Christian Schools International. Its mission is to empower students to live for Christ. The school offers advanced placement courses and a successful band and orchestra program."</data>
      <data key="d2">ramdocs-0470-18cb8c397ff1</data>
    </node>
    <node id="&quot;UNITY CHRISTIAN HIGH SCHOOL (BARRIE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Unity Christian High School (Barrie) is a Christian private secondary school in Barrie, Ontario, Canada, serving students in grades 9-12. It started with grades 9 and 10 and has expanded to include grades 11 and 12. The school purchased a building in 2010 and began holding classes there in 2010. Graduating students are eligible to receive an Ontario Secondary School Diploma."</data>
      <data key="d2">ramdocs-0470-18cb8c397ff1</data>
    </node>
    <node id="&quot;MIDDLE SCHOOL CROSS COUNTRY&quot;">
