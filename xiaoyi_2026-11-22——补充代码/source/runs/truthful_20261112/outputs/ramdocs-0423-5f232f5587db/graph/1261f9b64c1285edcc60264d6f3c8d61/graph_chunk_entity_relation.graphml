    <node id="&quot;AWU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AWU stands for Australian Workers' Union, of which Donald Macdonell (Australian politician) was the general secretary from 1900 to 1911."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
