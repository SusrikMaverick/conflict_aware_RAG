    </node>
    <node id="&quot;DONALD MACDONELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Macdonell is the grandfather of Donald Greenfield MacDonell."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;ALMONTE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Almonte is the town where Donald Greenfield MacDonell served as reeve in 1878."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;MARGARET ROSAMOND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Margaret Rosamond was the first wife of Donald Greenfield MacDonell, whom he married in 1875."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;EDITH ROSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Edith Rose was the second wife of Donald Greenfield MacDonell, whom he married in 1880."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;CANADA WEST&quot;">
      <data key="d0">"LOCATION"</data>
