  <graph edgedefault="undirected">
    <node id="&quot;DONALD GREENFIELD MACDONELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Greenfield MacDonell was a lawyer and political figure in Ontario, Canada, representing Lanark North in the House of Commons of Canada from 1880 to 1882 as a Liberal member. He was born in Morrisburg, Canada West, and was educated at Upper Canada College in Toronto. He was married twice and served as reeve of Almonte in 1878."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;LANARK NORTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lanark North is a riding in Ontario, Canada, where Donald Greenfield MacDonell represented in the House of Commons of Canada."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;HOUSE OF COMMONS OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The House of Commons of Canada is the lower house of the Parliament of Canada, where Donald Greenfield MacDonell served as a Liberal member from 1880 to 1882."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;MORRISBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Morrisburg is the birthplace of Donald Greenfield MacDonell in Canada West."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;UPPER CANADA COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Upper Canada College is an educational institution in Toronto where Donald Greenfield MacDonell was educated."</data>
      <data key="d2">ramdocs-0423-5f232f5587db</data>
    </node>
    <node id="&quot;A.G. MACDONELL&quot;">
