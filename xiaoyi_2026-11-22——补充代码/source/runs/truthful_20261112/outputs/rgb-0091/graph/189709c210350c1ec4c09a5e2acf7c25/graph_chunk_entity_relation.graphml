<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;2020 NBA DRAFT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 NBA Draft is a significant event in the NBA calendar, scheduled for November 18, 2020."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;FREE AGENT NEGOTIATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Free agent negotiations refer to the period when teams can sign players who are not under contract, starting on Friday after the draft."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;NOV. 18, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Nov. 18, 2020 is the date specified for the 2020 NBA Draft."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;FRIDAY&quot;">
      <data key="d0">"DAY"</data>
      <data key="d1">"Friday is the day when free agent negotiations begin after the 2020 NBA Draft."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;DOCUMENT 1&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 1 provides information about the 2020 NBA Draft and free agent negotiations scheduled for November 18, 2020 and Friday, respectively."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;DOCUMENT 2&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 2 provides a look at the full Draft board, including official trades from the 2020 NBA Draft."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;DOCUMENT 3&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Document 3 provides information about the 2020 NBA Draft and free agent negotiations scheduled for November 18, 2020 and Friday, respectively."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2020 is the year in which the NBA Draft and free agent negotiations are scheduled."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;NBA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NBA is the National Basketball Association, the governing body for the 2020 NBA Draft and free agent negotiations."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;WEDNESDAY&quot;">
      <data key="d0">"DAY"</data>
      <data key="d1">"Wednesday is the day when the 2020 NBA Draft is scheduled to occur."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <node id="&quot;ET&quot;">
      <data key="d0">"TIMEZONE"</data>
      <data key="d1">"ET stands for Eastern Time, the timezone in which the events are scheduled."</data>
      <data key="d2">rgb-0091</data>
    </node>
    <edge source="&quot;2020 NBA DRAFT&quot;" target="&quot;FREE AGENT NEGOTIATIONS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The 2020 NBA Draft and free agent negotiations are closely related events in the NBA calendar, with the draft occurring before negotiations begin."</data>
      <data key="d5">"draft-to-negotiations, sequence"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;2020 NBA DRAFT&quot;" target="&quot;NOV. 18, 2020&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"The 2020 NBA Draft is scheduled to occur on Nov. 18, 2020."</data>
      <data key="d5">"scheduled date, event occurrence"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;2020 NBA DRAFT&quot;" target="&quot;DOCUMENT 1&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Document 1 provides information about the 2020 NBA Draft, confirming its scheduled date and related events."</data>
      <data key="d5">"information source, confirmation"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;2020 NBA DRAFT&quot;" target="&quot;DOCUMENT 2&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Document 2 provides additional information about the 2020 NBA Draft, including official trades."</data>
      <data key="d5">"information source, detail"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;2020 NBA DRAFT&quot;" target="&quot;DOCUMENT 3&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Document 3 reiterates the information about the 2020 NBA Draft and free agent negotiations, confirming the dates and events."</data>
      <data key="d5">"information source, confirmation"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;FREE AGENT NEGOTIATIONS&quot;" target="&quot;NOV. 18, 2020&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Free agent negotiations begin on Nov. 18, 2020, immediately following the 2020 NBA Draft."</data>
      <data key="d5">"sequence, timing"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;DOCUMENT 1&quot;" target="&quot;DOCUMENT 2&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Both Document 1 and Document 2 provide information about the 2020 NBA Draft and free agent negotiations, suggesting they are related sources of information."</data>
      <data key="d5">"related sources, information sharing"</data>
      <data key="d6">rgb-0091</data>
    </edge>
    <edge source="&quot;DOCUMENT 1&quot;" target="&quot;DOCUMENT 3&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Both Document 1 and Document 3 provide information about the 2020 NBA Draft and free agent negotiations, suggesting they are related sources of information."</data>
      <data key="d5">"related sources, information sharing"</data>
