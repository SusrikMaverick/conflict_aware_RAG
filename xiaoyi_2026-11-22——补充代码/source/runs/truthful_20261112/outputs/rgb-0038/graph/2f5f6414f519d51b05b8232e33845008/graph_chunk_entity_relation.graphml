<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARVEL'S SPIDER-MAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Marvel's Spider-Man is a video game series known for its narrative, characterization, combat, and web-slinging mechanics."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;PLAYSTATION 4&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"PlayStation 4 is a gaming console on which Marvel's Spider-Man was released."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;PETER PARKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Parker is the alter ego of Spider-Man, a high school student who becomes Spider-Man after being bitten by a radioactive spider."&lt;SEP&gt;"Peter Parker is the protagonist of Marvel's Spider-Man, a high school student who becomes Spider-Man."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;SPIDER-MAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Spider-Man is a fictional superhero created by Stan Lee and Steve Ditko, known for his web-slinging abilities and fighting skills."&lt;SEP&gt;"Spider-Man is the alter ego of Peter Parker, a superhero known for his web-slinging abilities and fighting skills."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;SEPTEMBER 7, 2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"September 7, 2018 is the release date of the first Marvel's Spider-Man game for the PlayStation 4."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;AUGUST 12, 2022&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"August 12, 2022 is the release date of Marvel's Spider-Man Remastered."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;JUNE 20, 2023&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"June 20, 2023 is a date mentioned in the second document, though no specific event is detailed."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;MARVEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Marvel is a media company known for its comic book characters and their adaptations into various forms of entertainment, including video games."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;SEPTEMBER 1, 2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"September 1, 2020 is the release date of the second Marvel's Spider-Man game for the PlayStation 4."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;REMASTERED&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Remastered indicates a version of the game that has been updated or improved, often with enhanced graphics and features."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;ACTION-PACKED&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Action-Packed describes the nature of the gameplay in the remastered version of the game, emphasizing fast-paced and engaging action."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;ORIGINAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Original indicates the nature of the gameplay in the remastered version of the game, emphasizing the core elements of the original game."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;NARRATIVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Narrative refers to the storyline and character development in the game, which received praise for its quality."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;CHARACTERIZATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Characterization refers to the portrayal of characters in the game, which received praise for its depth and realism."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;COMBAT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Combat refers to the fighting and action sequences in the game, which received praise for its intensity and variety."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;WEB-SLINGING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Web-Slinging refers to the mechanic of swinging through the city using webs, which is a key feature of the game."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;FIRST CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Contact refers to the initial release of the game, marking its debut on the PlayStation 4."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;SECOND CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Second Contact refers to the release of the remastered version of the game, marking its re-release with improvements."</data>
      <data key="d2">rgb-0038</data>
    </node>
    <node id="&quot;MARVEL'S SPIDER-MAN REMASTERED&quot;">
      <data key="d2">rgb-0038</data>
      <data key="d1">"August 12, 2022 is the release date of Marvel's Spider-Man Remastered, indicating a remastered version of the game."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;MARVEL'S SPIDER-MAN&quot;" target="&quot;PLAYSTATION 4&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Marvel's Spider-Man was released for the PlayStation 4, indicating the platform on which the game was available."</data>
      <data key="d5">"platform, release date"</data>
      <data key="d6">rgb-0038</data>
    </edge>
    <edge source="&quot;MARVEL'S SPIDER-MAN&quot;" target="&quot;PETER PARKER&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Peter Parker is the protagonist of Marvel's Spider-Man, playing a central role in the game's narrative and gameplay."</data>
      <data key="d5">"protagonist, narrative"</data>
      <data key="d6">rgb-0038</data>
    </edge>
    <edge source="&quot;MARVEL'S SPIDER-MAN&quot;" target="&quot;SPIDER-MAN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Spider-Man is the alter ego of Peter Parker, featured prominently in the game as the main character."</data>
      <data key="d5">"alter ego, gameplay"</data>
      <data key="d6">rgb-0038</data>
    </edge>
    <edge source="&quot;MARVEL'S SPIDER-MAN&quot;" target="&quot;SEPTEMBER 7, 2018&quot;">
      <data key="d3">10.0</data>
