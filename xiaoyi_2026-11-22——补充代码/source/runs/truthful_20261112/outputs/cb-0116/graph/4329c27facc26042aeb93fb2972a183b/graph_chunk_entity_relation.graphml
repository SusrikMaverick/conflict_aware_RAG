  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NICOLE L. JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nicole L. Jones is a researcher known for her contributions to the field of gene therapy and molecular biology, particularly in the application of CRISPR technology to treat genetic disorders."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;UNIVERSITY OF WESTERN AUSTRALIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Western Australia is a public research university located in Perth, Western Australia, where Nicole L. Jones has held a research position."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;JOHNS HOPKINS SCHOOL OF MEDICINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Johns Hopkins School of Medicine is the location where Dr. Rachel Kim is conducting research on gene therapy."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;CRISPR TECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"CRISPR technology is the focus of Nicole L. Jones' research, used to treat genetic disorders."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;DR. RACHEL KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Kim is a researcher at Johns Hopkins School of Medicine, searching for information on Nicole L. Jones' contributions to gene therapy."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is the advisor of Dr. Rachel Kim and Nicole L. Jones' former colleague, known for his meticulous and precise research style."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;DR. HENRY LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Henry Lee is a veteran researcher and Nicole L. Jones' former colleague, known for his insightful and wistful recollections of her work."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;PERTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Perth is the city where the University of Western Australia is located."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;WESTERN AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Western Australia is the state where the University of Western Australia is located."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;GENETIC DISORDERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Genetic disorders are the subject of Nicole L. Jones' research, specifically targeted by CRISPR technology."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;MOLECULAR BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Molecular biology is the field of study where Nicole L. Jones conducted her research."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;GENE THERAPY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gene therapy is the field of research where Dr. Rachel Kim is conducting her studies, inspired by Nicole L. Jones' work."</data>
      <data key="d2">cb-0116</data>
    </node>
    <node id="&quot;FLUORESCENT LIGHTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Fluorescent lights are part of the environment at the Johns Hopkins School of Medicine where Dr. Rachel Kim works."</data>
