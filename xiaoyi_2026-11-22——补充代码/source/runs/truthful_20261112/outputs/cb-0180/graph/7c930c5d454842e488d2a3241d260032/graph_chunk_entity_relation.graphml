  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GEORGE BURLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Burley is an English footballer born in 1900, known for his skills as an inside-forward and his contributions to Burnley F.C. and Club Esportiu INEF."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;BURNLEY F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Burnley F.C. is an English football club for which George Burley played during the 1920s, making 57 appearances and scoring 12 goals."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;CLUB ESPORTIU INEF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Club Esportiu INEF is a Spanish sports club where George Burley joined in 1925, integrating into a diverse community of athletes."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;DR. EMMA HAYWOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Haywood is the curator of the English National Football Archive, confirming the discovery of George Burley's ties to Burnley F.C."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;BURNLEY F.C. MUSEUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Burnley F.C. Museum houses a team photograph from the 1922-1923 season featuring George Burley prominently."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;REC.SPORT.SOCCER STATISTICS FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Rec.Sport.Soccer Statistics Foundation compiled statistics supporting George Burley's appearances and goals for Burnley F.C."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;DR. TONY MASON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Tony Mason is a renowned football historian providing insight into George Burley's playing style and partnership with Louis Page."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;LOUIS PAGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louis Page was a star striker for Burnley F.C. during the early 1920s, partnering with George Burley in the team's success."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;SENYOR PERE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Senyor Pere is the president of Club Esportiu INEF, welcoming George Burley and emphasizing the club's community and family values."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;MARIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria is the star tennis player at Club Esportiu INEF, interacting with the water polo team and George Burley."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;JOAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joan is the captain of the football team at Club Esportiu INEF, known for his rugged features and commanding presence."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;BARCELONA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barcelona is the city where George Burley arrived in 1925, joining Club Esportiu INEF."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;MEDITERRANEAN SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Mediterranean Sea is the body of water where the sun sets, casting a warm orange glow over Barcelona."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;LANCASHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lancashire is the industrial heartland of England where George Burley was born and bred before moving to Spain."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;CATALAN CAPITAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Catalan capital is where George Burley arrived in 1925, referring to Barcelona."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;1920S&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 1920s is the decade during which George Burley played for Burnley F.C. and later joined Club Esportiu INEF."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;1921-1925&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"1921-1925 is the specific period during which George Burley made 57 appearances for Burnley F.C. and scored 12 goals."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;1922-1923&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"1922-1923 is the specific season when a team photograph featuring George Burley was taken at the Burnley F.C. Museum."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;GREY SKIES AND MUDDY PITCHES&quot;">
      <data key="d0">"ENVIRONMENT"</data>
      <data key="d1">"Grey skies and muddy pitches describe the conditions in England where George Burley played before moving to Spain."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;SUN-KISSED FIELDS&quot;">
      <data key="d0">"ENVIRONMENT"</data>
      <data key="d1">"Sun-kissed fields describe the conditions in Spain where George Burley played after moving to Club Esportiu INEF."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;PASSIONATE FANS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Passionate fans are mentioned as part of the environment at Club Esportiu INEF, where George Burley joined in 1925."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;GEORGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George is a member of a community and feels a sense of belonging after joining a club."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"England is the place George left behind, symbolizing his past and the decision he made to join the club."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;THE CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Club is a community and family for George, combining sports and various passions."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Community is a group of people who feel connected and support each other."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Family is a metaphorical term for the sense of belonging and support within the club."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;SPORTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sports are a part of the activities and passions within the club."</data>
      <data key="d2">cb-0180</data>
    </node>
    <node id="&quot;PASSIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Passions refer to the various interests and activities that members engage in within the club."</data>
      <data key="d2">cb-0180</data>
    </node>
