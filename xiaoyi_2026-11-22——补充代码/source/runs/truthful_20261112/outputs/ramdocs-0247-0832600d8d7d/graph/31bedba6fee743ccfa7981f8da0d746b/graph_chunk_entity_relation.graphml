  <graph edgedefault="undirected">
    <node id="&quot;ALAN KOGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alan Koger is an American soccer player born on September 25, 1987, who played soccer and American football in high school and later attended the College of William &amp; Mary, where he received the nickname 'Cabbage.' He also signed a contract with the New England Revolution of MLS after his college career."</data>
      <data key="d2">ramdocs-0247-0832600d8d7d</data>
    </node>
    <node id="&quot;MAGNA VISTA HIGH SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Magna Vista High School is the high school where Alan Koger played both soccer and American football as a placekicker."</data>
      <data key="d2">ramdocs-0247-0832600d8d7d</data>
    </node>
    <node id="&quot;GREENSBORO SOCCER CLUB 87 GREEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
