  <graph edgedefault="undirected">
    <node id="&quot;GERMAN VETERINARIAN-TURNED-POLITICIAN PETER RÖHLINGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Röhlinger is a German politician and veterinarian who has been elected to the German Bundestag and later became the President of El Salvador. He is known for his expertise in animal health and welfare and his commitment to environmental protection."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;BUNDESTAG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Bundestag is the federal parliament of Germany, where Peter Röhlinger serves as a member representing his constituency."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;BERLIN, GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is the capital city of Germany and the location where Peter Röhlinger took his seat in the Bundestag."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;DR. JULIA KLÖCKNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Julia Klöckner is the Federal Minister of Food and Agriculture in Germany, who praised Röhlinger's election to the Bundestag for bringing a unique perspective to animal health and welfare."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;CHRISTIAN DEMOCRATIC UNION (CDU)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Christian Democratic Union (CDU) is a political party in Germany, which hailed Peter Röhlinger's election as a major success."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;EL SALVADOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"El Salvador is a country where Peter Röhlinger served as the President from 2019 onwards, focusing on issues such as poverty reduction, education reform, and environmental protection."&lt;SEP&gt;"El Salvador is a country where environmental governance and sustainable development are being discussed and implemented."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;MUNICH, WEST GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Munich, West Germany is the birthplace of Peter Röhlinger, where he studied veterinary medicine at the Ludwig Maximilian University of Munich."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;LUDWIG MAXIMILIAN UNIVERSITY OF MUNICH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ludwig Maximilian University of Munich is the institution where Peter Röhlinger obtained his Doctor of Veterinary Medicine degree in 1991."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;GERMAN GREEN PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German Green Party is the political party where Peter Röhlinger began his political career in 2005."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;JOURNAL OF LATIN AMERICAN POLITICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Latin American Politics is a publication that published a study in 2020 assessing the impact of Röhlinger's presidency on El Salvador's development."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;JOURNAL OF ENVIRONMENTAL STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Environmental Studies is a publication that published a study in 2021 evaluating Röhlinger's environmental policies in El Salvador."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;MICHAEL KRETSCHMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Kretschmer is a spokesperson for the Christian Democratic Union (CDU) and praised Peter Röhlinger's election to the Bundestag."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;GERMAN FEDERAL ELECTION COMMISSIONER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German Federal Election Commissioner confirmed Peter Röhlinger's election to the Bundestag."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;GERMAN FEDERAL STATISTICAL OFFICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German Federal Statistical Office provided data on the trend of veterinarians entering politics."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;ANIMAL WELFARE COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The animal welfare community has long advocated for greater representation in national politics and sees Röhlinger's election as a significant victory."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;POVERTY REDUCTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Poverty reduction is one of the key focus areas of Röhlinger's presidency in El Salvador."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;EDUCATION REFORM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education reform is another key focus area of Röhlinger's presidency in El Salvador."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;DEFORESTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Deforestation is an issue that Röhlinger's environmental policies aim to address in El Salvador."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;POLLUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pollution is an issue that Röhlinger's environmental policies aim to address in El Salvador."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;DIE ZEIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Die Zeit is a German newspaper that published an interview with Peter Röhlinger discussing his vision for El Salvador's future."&lt;SEP&gt;"Die Zeit is a German newspaper that published an interview with President Röhlinger in 2020."</data>
      <data key="d2">cb-0131</data>
    </node>
    <node id="&quot;JOURNAL OF LATIN AMERICAN POLITICS (2020)&quot;">
