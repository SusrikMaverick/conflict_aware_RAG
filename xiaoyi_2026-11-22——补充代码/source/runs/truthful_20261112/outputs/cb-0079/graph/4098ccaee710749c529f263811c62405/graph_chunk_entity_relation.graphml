<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TORCY-ET-POULIGNY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Torcy-et-Pouligny is a commune in the Côte-d'Or department in the Bourgogne-Franche-Comté region in eastern France."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;CÔTE-D'OR DEPARTMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Côte-d'Or department is a department in the Bourgogne-Franche-Comté region, containing the commune of Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;BOURGOGNE-FRANCHE-COMTÉ REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bourgogne-Franche-Comté region is a region in eastern France containing the Côte-d'Or department and the commune of Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;ELECTORAL DISTRICT ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Electoral District Association is an organization that studies the relationship between communes and their electoral districts."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;DR. MARIE-PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marie-Pierre Dupont is a renowned expert in French electoral politics who conducted a study on the voting patterns and demographic characteristics of Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;FRENCH NATIONAL INSTITUTE FOR STATISTICS AND ECONOMIC STUDIES (INSEE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INSEE is an organization that conducts research on economic and social indicators, supporting the findings of the study on Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Ministry of the Interior officially recognized the association between Torcy-et-Pouligny and the canton of Auterive for national and regional elections."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;CANTON OF AUTERIVE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canton of Auterive is an administrative division in the Côte-d'Or department that includes Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;CANTON OF SEMUR-EN-AUXOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canton of Semur-en-Auxois is an administrative division in the Côte-d'Or department that includes Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;JOURNAL OF FRENCH ELECTORAL POLITICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of French Electoral Politics is a publication that published a study on the voting patterns and demographic characteristics of Torcy-et-Pouligny."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;REVUE FRANÇAISE DE SCIENCE POLITIQUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Revue Française de Science Politique is a publication that explored the historical roots of Torcy-et-Pouligny's association with the canton of Auterive."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;PIERRE LEFEBVRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Lefebvre is a scholar who explored the historical roots of Torcy-et-Pouligny's association with the canton of Auterive."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;FRENCH REVOLUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The French Revolution is a historical event that influenced the reorganization of the country's administrative divisions, including the relationship between Torcy-et-Pouligny and the canton of Auterive."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;NATIONAL AND REGIONAL ELECTIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"National and Regional Elections are events where Torcy-et-Pouligny participates as part of the canton of Auterive."</data>
      <data key="d2">cb-0079</data>
    </node>
    <node id="&quot;INSEE&quot;">
      <data key="d2">cb-0079</data>
      <data key="d1">"INSEE provided research supporting the association between Torcy-et-Pouligny and the canton of Auterive, based on economic and social indicators."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;CANTON OF AUTERIVE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Torcy-et-Pouligny is associated with the electoral district of the canton of Auterive, as documented by various studies and recognized by the French Ministry of the Interior."</data>
      <data key="d5">"administrative association, electoral district"</data>
      <data key="d6">cb-0079</data>
    </edge>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;CANTON OF SEMUR-EN-AUXOIS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Torcy-et-Pouligny is part of the canton of Semur-en-Auxois, as confirmed by the French National Institute for Statistics and Economic Studies (INSEE) and the official websites of the Côte-d'Or department and the French Ministry of the Interior."</data>
      <data key="d5">"administrative division, governance"</data>
      <data key="d6">cb-0079</data>
    </edge>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;ELECTORAL DISTRICT ASSOCIATION&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The Electoral District Association has extensively studied the relationship between Torcy-et-Pouligny and the canton of Auterive, providing detailed documentation and analysis."</data>
      <data key="d5">"research, documentation"</data>
      <data key="d6">cb-0079</data>
    </edge>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;DR. MARIE-PIERRE DUPONT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Marie-Pierre Dupont conducted a study on the voting patterns and demographic characteristics of Torcy-et-Pouligny, supporting the association with the canton of Auterive."</data>
      <data key="d5">"study, research"</data>
      <data key="d6">cb-0079</data>
    </edge>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;INSEE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"INSEE provided research supporting the association between Torcy-et-Pouligny and the canton of Auterive, based on economic and social indicators."</data>
      <data key="d5">"research, support"</data>
      <data key="d6">cb-0079</data>
    </edge>
    <edge source="&quot;TORCY-ET-POULIGNY&quot;" target="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The French Ministry of the Interior officially recognized the association between Torcy-et-Pouligny and the canton of Auterive for national and regional elections."</data>
      <data key="d5">"official recognition, governance"</data>
      <data key="d6">cb-0079</data>
    </edge>
  </graph>
