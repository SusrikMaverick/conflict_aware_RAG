<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;APPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple is a technology company known for its retail stores and leadership by CEOs Steve Jobs and Tim Cook."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;STEVE JOBS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steve Jobs was the CEO of Apple from 2011 until his resignation and was instrumental in the development of Apple products and retail stores."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;TIM COOK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tim Cook succeeded Steve Jobs as the CEO of Apple and continues to lead the company as of the latest information provided."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;APPLE TOWER THEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Apple Tower Theater is a retail store operated by Apple located in Los Angeles."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is the city where the Apple Tower Theater retail store is located."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;JUNE 24, 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"June 24, 2021 is the date when the Apple Tower Theater retail store was opened."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;AUGUST 24, 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"August 24, 2021 is the date when Tim Cook attended the opening of the Apple Tower Theater retail store."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;OPENING OF THE NEW APPLE TOWER THEATER RETAIL STORE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The event of opening the new Apple Tower Theater retail store took place on June 24, 2021."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;NEW APPLE TOWER THEATER RETAIL STORE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The new Apple Tower Theater retail store is a specific location within Apple Tower Theater."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;APPLE INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple Inc. is the technology company that operates the retail store and is led by its CEO, Tim Cook."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;CHAIRMAN OF THE BOARD&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Chairman of the board is a role held by Steve Jobs after he resigned as CEO of Apple Inc."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;CHIEF EXECUTIVE (2011–PRESENT)&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Chief executive is a role held by Tim Cook since 2011 and continues to the present."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;RETAIL STORE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Retail store is a type of location where Apple sells its products and services."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;THEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Theater is a type of location within the retail store where events or openings might take place."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;JUNE 24, 2021 OPENING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The specific event of the opening of the new Apple Tower Theater retail store took place on June 24, 2021."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <node id="&quot;AUGUST 24, 2021 ATTENDANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The specific event of Tim Cook attending the opening of the new Apple Tower Theater retail store took place on August 24, 2021."</data>
      <data key="d2">rgb-0095</data>
    </node>
    <edge source="&quot;APPLE&quot;" target="&quot;STEVE JOBS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Steve Jobs was the CEO of Apple until his resignation and was involved in the opening of the Apple Tower Theater retail store."</data>
      <data key="d5">"leadership, product development"</data>
      <data key="d6">rgb-0095</data>
    </edge>
