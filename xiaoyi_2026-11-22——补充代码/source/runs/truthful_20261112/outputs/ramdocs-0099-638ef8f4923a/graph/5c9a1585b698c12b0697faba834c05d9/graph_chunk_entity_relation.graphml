  <graph edgedefault="undirected">
    <node id="&quot;PARK JI-YEON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Park Ji-yeon is a member of the Korean girl group T-ara and the artist behind the EP 'Never Ever', known for her solo concept which is sexy and modern."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;T-ARA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"T-ara is a Korean girl group of which Park Ji-yeon is a member."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;MBK ENTERTAINMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MBK Entertainment is the record label that released Park Ji-yeon's solo EP 'Never Ever' and provided a statement about her solo concept."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;NEVER EVER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Never Ever is the debut EP by Park Ji-yeon, released as her first solo work and featuring the single '1 Minute 1 Second (Never Ever)' on May 20, 2014."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;1 MINUTE 1 SECOND (NEVER EVER)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1 Minute 1 Second (Never Ever) is a single from Park Ji-yeon's EP 'Never Ever'."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;APRIL 2, 2014&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"April 2, 2014 is the date when it was announced that Park would have a solo album."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;MAY 20, 2014&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May 20, 2014 is the release date of the EP 'Never Ever'."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;COMING OF AGE CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Coming of Age Ceremony is a reference to Park Jiyoon's previous solo concept, which influenced Park Ji-yeon's solo concept."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;KOREAN GIRL GROUP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Korean girl group refers to the type of group Park Ji-yeon is part of."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;EXTENDED PLAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Extended play (EP) is the format of the music release 'Never Ever'."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;MODERN 2014-ESQUE TWIST&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modern 2014-esque twist describes the updated concept for Park Ji-yeon's solo work compared to her previous concept."</data>
      <data key="d2">ramdocs-0099-638ef8f4923a</data>
    </node>
    <node id="&quot;SINGLE&quot;">
