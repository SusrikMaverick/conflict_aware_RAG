<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academy is the official organization behind the Academy Awards, providing history, general information, photographs, events, and press releases."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;JOAQUIN PHOENIX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joaquin Phoenix is a person who won the Best Actor award at the 92nd Academy Awards in 2020."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;CASEY AFFLECK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Casey Affleck is a person who won the Best Actor award at the 92nd Academy Awards in 2020."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;BEST ACTOR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Actor is an event category at the Academy Awards where actors compete for recognition."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;BEST PICTURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Picture is an event category at the Academy Awards where films compete for recognition."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;PARASITE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Parasite is a film that won the Oscar for Best Picture at the 92nd Academy Awards in 2020."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;ABC TELECAST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"ABC Telecast is the television broadcast of the 92nd Academy Awards ceremony."</data>
      <data key="d2">rgb-0074</data>
    </node>
    <node id="&quot;ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Academy Awards is the annual ceremony where awards are given to recognize excellence in cinematic achievements."|</data>
      <data key="d2">rgb-0074</data>
    </node>
    <edge source="&quot;ACADEMY&quot;" target="&quot;BEST ACTOR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Academy Awards includes the Best Actor event category."</data>
      <data key="d5">"event inclusion"</data>
      <data key="d6">rgb-0074</data>
    </edge>
    <edge source="&quot;ACADEMY&quot;" target="&quot;BEST PICTURE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Academy Awards includes the Best Picture event category."</data>
      <data key="d5">"event inclusion"</data>
      <data key="d6">rgb-0074</data>
    </edge>
    <edge source="&quot;ACADEMY&quot;" target="&quot;PARASITE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Parasite won the Oscar for Best Picture at the Academy Awards."</data>
      <data key="d5">"award win"</data>
      <data key="d6">rgb-0074</data>
    </edge>
    <edge source="&quot;ACADEMY&quot;" target="&quot;ABC TELECAST&quot;">
