      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;TORIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tories is a political party that Davis united by inviting Lawrence's key workers onto his team to form the Big Blue Machine."</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;HUGH SEGAL&quot;">
      <data key="d0">"PERSON"</data>
