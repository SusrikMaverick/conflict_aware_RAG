      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;ONTARIO LEGISLATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ontario legislature is a legislative body where Lawrence resigned his seat in 1972 to enter federal politics."&lt;SEP&gt;"Ontario legislature is a legislative body where Nathaniel Lawrence resigned his seat in 1972 to enter federal politics."</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
