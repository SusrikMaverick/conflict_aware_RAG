  <graph edgedefault="undirected">
    <node id="&quot;JAMES LAWRENCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Lawrence was a Democratic politician from Ohio, serving as Ohio Attorney General from 1884-1886 and 1900-1902. He was born in Old Washington, Guernsey County, Ohio, and attended Kenyon College and studied law."&gt;</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ohio is the state where James Lawrence was born, lived, and served as Attorney General."&gt;</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;OLD WASHINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Old Washington is a location in Guernsey County, Ohio, where James Lawrence was born."&gt;</data>
