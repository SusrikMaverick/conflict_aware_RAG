    <node id="&quot;NATHANIEL LAWRENCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nathaniel Lawrence is a person who held various positions in New York State government, including the New York State Assembly, delegate to the New York State Convention, and Secretary to the Board of Regents."&lt;SEP&gt;"Nathaniel Lawrence was an American lawyer and politician from New York, born in 1761 and died in 1797. He was a delegate to the New York State Convention to ratify the U.S. Constitution and served as Secretary to the Board of Regents of the University of the State of New York."&gt;</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;THOMAS LAWRENCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Lawrence was the father of Nathaniel Lawrence, born in 1733 and died in 1816."&gt;</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;JONATHAN LAWRENCE&quot;">
      <data key="d0">"PERSON"</data>
