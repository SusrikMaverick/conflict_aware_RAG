    </node>
    <node id="&quot;AARON BURR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aaron Burr is a person mentioned as succeeding Nathaniel Lawrence as New York State Attorney General in 1792."</data>
      <data key="d2">ramdocs-0388-fbd4a22bd55f</data>
    </node>
    <node id="&quot;NEW YORK STATE ATTORNEY GENERAL&quot;">
