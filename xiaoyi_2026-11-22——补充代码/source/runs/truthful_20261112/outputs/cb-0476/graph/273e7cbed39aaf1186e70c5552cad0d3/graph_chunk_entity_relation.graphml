<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SHIP BREAKING INDUSTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ship Breaking Industry is the sector involved in the disposal of ships for scrap recycling, revolutionized by the integration of provisioning composite applications using secure parameter access."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;UNIVERSITY OF MARITIME STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Maritime Studies is an educational institution that conducted early research on provisioning composite applications using secure parameter access in ship breaking."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez led a team of researchers at the University of Maritime Studies who published a feasibility study on the use of provisioning composite applications using secure parameter access in ship breaking."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;GREEN RECYCLING INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Green Recycling Inc. was the first ship breaking company to implement provisioning composite applications using secure parameter access, reporting significant reductions in data breaches and increases in productivity."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;INTERNATIONAL MARITIME ORGANIZATION (IMO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Maritime Organization (IMO) recognized the importance of provisioning composite applications using secure parameter access in ship breaking and issued a circular recommending its use worldwide."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;SHIP BREAKING INDUSTRY ASSOCIATION (SBIA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ship Breaking Industry Association (SBIA) launched a certification program for ship breaking facilities implementing provisioning composite applications using secure parameter access to promote best practices and ensure secure and efficient disposal of ships."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Provisioning Composite Applications using Secure Parameter Access is a technology that ensures secure and efficient deployment of composite applications, reducing data breaches and improving ship breaking efficiency."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;SECURE PARAMETER ACCESS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Secure Parameter Access is a critical aspect of provisioning composite applications, controlling and managing access to sensitive parameters to prevent unauthorized access and data breaches."&lt;SEP&gt;"Secure Parameter Access is a method used to help organizations comply with regulatory requirements by providing secure access to parameters in composite applications."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;EARLY STUDIES (2005-2010)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Early Studies (2005-2010) refer to the initial research conducted by the University of Maritime Studies on the application of provisioning composite applications using secure parameter access in ship breaking."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;INDUSTRY ADOPTION (2010-2015)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Industry Adoption (2010-2015) refers to the period during which Green Recycling Inc. implemented provisioning composite applications using secure parameter access, leading to increased adoption across the industry."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;NOTABLE EVENTS (2015-PRESENT)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Notable Events (2015-Present) include the recognition by the IMO and the launch of the SBIA certification program for ship breaking facilities implementing provisioning composite applications using secure parameter access."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;COMPOSITE APPLICATION&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A software application that combines multiple services, systems, or software components to provide a unified user experience."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;API KEYS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"API Keys are sensitive parameters used to authenticate and authorize access to web services or APIs."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;CREDENTIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Credentials are sensitive parameters used to authenticate and authorize access to systems or services."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;CONFIGURATION SETTINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Configuration Settings are sensitive parameters used to configure the behavior of software applications."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;USER CONSENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"User Consent is an expression of permission or agreement to access and use personal data stored in composite applications."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;COMPONENT CONSENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Component Consent is an expression of permission or agreement to share data or access sensitive parameters between different components of a composite application."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;REGULATORY REQUIREMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Regulatory Requirements are legal mandates that organizations must comply with, such as GDPR and HIPAA."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;GENERAL DATA PROTECTION REGULATION (GDPR)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"GDPR is a regulatory requirement that mandates obtaining consent from users before processing their personal data."&lt;SEP&gt;"General Data Protection Regulation (GDPR) is a regulation in EU law on data protection and privacy for all individuals within the European Union."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;HEALTH INSURANCE PORTABILITY AND ACCOUNTABILITY ACT (HIPAA)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"HIPAA is another regulatory requirement that mandates obtaining consent from users before processing their personal data."&lt;SEP&gt;"Health Insurance Portability and Accountability Act (HIPAA) is a U.S. regulation that sets national standards for the protection of certain health information."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;IBM DEVELOPER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IBM Developer is a platform that provides articles and resources on software development, including secure parameter access in composite applications."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;ORACLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oracle is a technology company that provides resources on consent management in composite applications."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;SECURE PARAMETER ACCESS IN COMPOSITE APPLICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Secure Parameter Access in Composite Applications is a critical aspect of provisioning composite applications, controlling and managing access to sensitive parameters to prevent unauthorized access and data breaches."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;CONSENT MANAGEMENT IN COMPOSITE APPLICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Consent Management in Composite Applications is a critical aspect of provisioning composite applications, ensuring that all stakeholders are aware of and agree to the secure parameter access mechanisms in place."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;ORGANIZATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Organizations refer to entities that need to comply with regulatory requirements such as GDPR and HIPAA to ensure secure handling of user data."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;COMPOSITE APPLICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Composite Applications are software systems that combine multiple services or components into a single application, often requiring secure parameter access."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;PARAMETER ACCESS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Parameter Access refers to the process of accessing and managing parameters within composite applications, which is secured by Secure Parameter Access methods."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;USER DATA&quot;">
      <data key="d0">"DATA"</data>
      <data key="d1">"User Data includes personal and health-related information that needs to be handled securely according to GDPR and HIPAA."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;CONSENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Consent is the permission given by users for their data to be processed, as mandated by GDPR and HIPAA."</data>
      <data key="d2">cb-0476</data>
    </node>
    <node id="&quot;GDPR&quot;">
      <data key="d2">cb-0476</data>
      <data key="d1">"Organizations must comply with GDPR to handle user data securely and obtain necessary consents."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;HIPAA&quot;">
      <data key="d2">cb-0476</data>
      <data key="d1">"Organizations must comply with HIPAA to handle health-related data securely and obtain necessary consents."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;UNIVERSITY OF MARITIME STUDIES&quot;" target="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The University of Maritime Studies conducted early research on provisioning composite applications using secure parameter access in ship breaking, leading to the publication of a feasibility study."</data>
      <data key="d5">"research, feasibility study"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;DR. MARIA RODRIGUEZ&quot;" target="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Dr. Maria Rodriguez led the research team that published a feasibility study on provisioning composite applications using secure parameter access in ship breaking."</data>
      <data key="d5">"leadership, research"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;GREEN RECYCLING INC.&quot;" target="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Green Recycling Inc. was the first to implement provisioning composite applications using secure parameter access, demonstrating its effectiveness and leading to increased industry adoption."</data>
      <data key="d5">"pioneer, adoption"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;INTERNATIONAL MARITIME ORGANIZATION (IMO)&quot;" target="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The IMO recognized the importance of provisioning composite applications using secure parameter access and recommended its use in ship recycling facilities worldwide."</data>
      <data key="d5">"recognition, recommendation"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;SHIP BREAKING INDUSTRY ASSOCIATION (SBIA)&quot;" target="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The SBIA launched a certification program for ship breaking facilities implementing provisioning composite applications using secure parameter access to promote best practices and ensure secure disposal."</data>
      <data key="d5">"certification, promotion"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;PROVISIONING COMPOSITE APPLICATIONS USING SECURE PARAMETER ACCESS&quot;" target="&quot;EARLY STUDIES (2005-2010)&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The research conducted during Early Studies (2005-2010) laid the foundation for the development and implementation of provisioning composite applications using secure parameter access in ship breaking."</data>
      <data key="d5">"foundation, development"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;SECURE PARAMETER ACCESS&quot;" target="&quot;ORGANIZATIONS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Organizations use Secure Parameter Access to comply with regulatory requirements such as GDPR and HIPAA."</data>
      <data key="d5">"compliance, security measures"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;SECURE PARAMETER ACCESS&quot;" target="&quot;GDPR&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Secure Parameter Access helps organizations meet the requirements of GDPR by ensuring secure parameter access."</data>
      <data key="d5">"compliance assistance, security measures"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;SECURE PARAMETER ACCESS&quot;" target="&quot;HIPAA&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Secure Parameter Access helps organizations meet the requirements of HIPAA by ensuring secure parameter access."</data>
      <data key="d5">"compliance assistance, security measures"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;SECURE PARAMETER ACCESS&quot;" target="&quot;PARAMETER ACCESS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Secure Parameter Access provides secure methods for accessing and managing parameters in composite applications."</data>
      <data key="d5">"security, parameter management"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;ORGANIZATIONS&quot;" target="&quot;GDPR&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Organizations must comply with GDPR to handle user data securely and obtain necessary consents."</data>
      <data key="d5">"regulatory compliance, data protection"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;ORGANIZATIONS&quot;" target="&quot;HIPAA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Organizations must comply with HIPAA to handle health-related data securely and obtain necessary consents."</data>
      <data key="d5">"regulatory compliance, data protection"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;ORGANIZATIONS&quot;" target="&quot;CONSENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Organizations must obtain Consent from users to comply with GDPR and HIPAA when handling User Data."</data>
      <data key="d5">"user rights, compliance"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;PARAMETER ACCESS&quot;" target="&quot;USER DATA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Parameter Access involves managing User Data within composite applications to ensure secure handling and processing."</data>
      <data key="d5">"data management, security"</data>
      <data key="d6">cb-0476</data>
    </edge>
    <edge source="&quot;USER DATA&quot;" target="&quot;CONSENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"User Data requires Consent from users before being processed, as mandated by GDPR and HIPAA."</data>
      <data key="d5">"data protection, user rights"</data>
      <data key="d6">cb-0476</data>
    </edge>
  </graph>
