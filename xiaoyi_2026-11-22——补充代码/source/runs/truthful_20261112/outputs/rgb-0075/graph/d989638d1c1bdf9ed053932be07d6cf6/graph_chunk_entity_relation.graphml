<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;YUH-JUNG YOUN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yuh-jung Youn is a Korean actress who won the best supporting role award for her performance in 'Minari'."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;CHLOÉ ZHAO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chloé Zhao is a director who won the best director award for her work on 'Minari'."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;DAMIEN CHAZELLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Damien Chazelle is a director who won the best director award according to the second document, though it seems there might be a typo as he is known for different films."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Academy Awards is a prestigious film awards ceremony where Yuh-jung Youn and Chloé Zhao won their respective categories."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;OFFICIAL SITE OF THE ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The official site of the Academy provides information about the Academy Awards, including history, photographs, events, and press releases."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;MINARI&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Minari is a film for which Yuh-jung Youn and Chloé Zhao won awards."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;BEST SUPPORTING ROLE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Best Supporting Role is an award category for which Yuh-jung Youn won."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;BEST DIRECTOR&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Best Director is an award category for which Chloé Zhao and Damien Chazelle won."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;KOREAN ACTRESS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Korean actress refers to Yuh-jung Youn, who won the best supporting role award."</data>
      <data key="d2">rgb-0075</data>
    </node>
    <node id="&quot;HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"History refers to the historical context of the Academy Awards and the achievements of past winners."</data>
      <data key="d2">rgb-0075</data>
