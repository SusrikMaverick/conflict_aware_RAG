    <node id="&quot;THOMAS DUCKETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Duckett is a British aristocrat and member of the peerage, known for his marriage to Jerry White and his early life and education."</data>
