<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CROATIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Croatia is a runner-up in the 2018 FIFA World Cup Russia™, having played 7 matches with an average of 1.9 goals per match and 15 yellow cards."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Netherlands is also a runner-up in the 2018 FIFA World Cup Russia™, having played 7 matches with an average of 1.9 goals per match and 15 yellow cards."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;2018 FIFA WORLD CUP RUSSIA™&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2018 FIFA World Cup Russia™ is a major international football tournament held in Russia, featuring teams like Croatia and Netherlands."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;ZABIVAKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zabivaka is an anthropomorphic wolf character, representing the Russian national team, and won a vote with 53% or approximately 1 million votes."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;RUSSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Russia hosted the 2018 FIFA World Cup and is the setting for the events described in both documents."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;FIFA+&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FIFA+ is the platform providing match centre and team information for the 2018 FIFA World Cup Russia™."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;RUSSIAN NATIONAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Russian national team is represented by Zabivaka and was a significant participant in the 2018 FIFA World Cup Russia™."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;MATCH CENTRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Match Centre provides detailed information about the matches played during the 2018 FIFA World Cup Russia™."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <node id="&quot;VOTES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Votes were cast for Zabivaka, with 53% or approximately 1 million votes, indicating a popular event."</data>
      <data key="d2">rgb-0067</data>
    </node>
    <edge source="&quot;CROATIA&quot;" target="&quot;2018 FIFA WORLD CUP RUSSIA™&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Croatia participated in the 2018 FIFA World Cup Russia™ and was a runner-up."</data>
      <data key="d5">"tournament participation, runner-up"</data>
      <data key="d6">rgb-0067</data>
    </edge>
    <edge source="&quot;NETHERLANDS&quot;" target="&quot;2018 FIFA WORLD CUP RUSSIA™&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Netherlands participated in the 2018 FIFA World Cup Russia™ and was a runner-up."</data>
      <data key="d5">"tournament participation, runner-up"</data>
      <data key="d6">rgb-0067</data>
    </edge>
    <edge source="&quot;2018 FIFA WORLD CUP RUSSIA™&quot;" target="&quot;FIFA+&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"FIFA+ provides information about the 2018 FIFA World Cup Russia™, including match centres and team details."</data>
      <data key="d5">"information provision, event coverage"</data>
      <data key="d6">rgb-0067</data>
    </edge>
    <edge source="&quot;2018 FIFA WORLD CUP RUSSIA™&quot;" target="&quot;MATCH CENTRE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Match Centre offers detailed information about the matches played during the 2018 FIFA World Cup Russia™."</data>
      <data key="d5">"match information, event detail"</data>
