    </edge>
    <edge source="&quot;ZABIVAKA&quot;" target="&quot;RUSSIAN NATIONAL TEAM&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Zabivaka represents the Russian national team and won a significant vote."</data>
      <data key="d5">"representation, popularity"</data>
      <data key="d6">rgb-0067</data>
    </edge>
    <edge source="&quot;ZABIVAKA&quot;" target="&quot;VOTES&quot;">
      <data key="d3">9.0</data>
