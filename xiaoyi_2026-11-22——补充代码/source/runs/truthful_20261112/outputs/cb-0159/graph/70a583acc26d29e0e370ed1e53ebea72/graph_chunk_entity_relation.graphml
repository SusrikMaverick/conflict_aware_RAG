  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VIKRAM MISRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vikram Misra is a researcher with a strong academic background, particularly in environmental science and ecology, affiliated with the University of Saskatchewan and Purdue University."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;UNIVERSITY OF SASKATCHEWAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Saskatchewan is a public university located in Saskatoon, Saskatchewan, Canada, known for its research excellence in environmental science and ecology."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;PURDUE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Purdue University is a public research university located in West Lafayette, Indiana, known for its engineering programs."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;WEST LAFAYETTE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Lafayette is a city in Indiana where Purdue University is located."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;SASKATOON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saskatoon is a city in Saskatchewan, Canada, where the University of Saskatchewan is located."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;NEIL ARMSTRONG HALL OF ENGINEERING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Neil Armstrong Hall of Engineering is a building at Purdue University where Vikram Misra worked."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;PURDUE MEMORIAL UNION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Purdue Memorial Union is a location at Purdue University where Vikram Misra celebrated a research breakthrough with his team."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Science is a field of study that Vikram Misra is interested in and aligned with the University of Saskatchewan's expertise."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;ECOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ecology is another field of study that Vikram Misra is interested in and aligned with the University of Saskatchewan's expertise."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;SOLAR CELL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A solar cell is a device developed by Vikram Misra's research team at Purdue University, aimed at increasing efficiency."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;RESEARCH TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vikram Misra's research team at Purdue University includes colleagues and students who collaborate on research projects."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;ORCID ID&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"ORCID ID is a unique identifier assigned to researchers to distinguish them from others and track their scholarly contributions."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;ACADEMIC ODYSSEY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The academic odyssey of Vikram Misra is a journey marked by his research and affiliations with multiple institutions."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;BREAKTHROUGH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A breakthrough in solar cell efficiency is a significant achievement by Vikram Misra's research team at Purdue University."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;RESEARCH FACILITIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Research facilities are resources provided by the University of Saskatchewan and Purdue University to support research endeavors."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;FUNDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Funding is a form of support provided by the University of Saskatchewan and Purdue University to aid in research projects."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;COLLABORATIVE RESEARCH ENVIRONMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A collaborative research environment exists at both the University of Saskatchewan and Purdue University, fostering teamwork and innovation."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;CELEBRATORY DINNER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A celebratory dinner at the Purdue Memorial Union is a social event where Vikram Misra and his team celebrate their research achievements."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;BOOKS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Books are part of the clutter in Vikram Misra's office at Purdue University, symbolizing his extensive reading and research."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;PAPERS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Papers are part of the clutter in Vikram Misra's office at Purdue University, representing his ongoing research and publications."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;EQUATIONS AND DIAGRAMS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Equations and diagrams cover one wall of Vikram Misra's office at Purdue University, reflecting his work on research projects."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;AWARDS AND CERTIFICATES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Awards and certificates are displayed on a shelf in Vikram Misra's office at Purdue University, testifying to his accomplishments."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;STUDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Students are mentored by Vikram Misra at Purdue University, benefiting from his guidance and expertise."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research projects are conducted by Vikram Misra and his team at both the University of Saskatchewan and Purdue University."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;MEETINGS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Meetings are held at Purdue University, where Vikram Misra and his colleagues discuss research progress and plan future projects."</data>
      <data key="d2">cb-0159</data>
    </node>
    <node id="&quot;ENGINEERING&quot;">
      <data key="d2">cb-0159</data>
      <data key="d1">"Purdue University is known for its engineering programs, which align with Vikram Misra's work in developing a more efficient solar cell."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
