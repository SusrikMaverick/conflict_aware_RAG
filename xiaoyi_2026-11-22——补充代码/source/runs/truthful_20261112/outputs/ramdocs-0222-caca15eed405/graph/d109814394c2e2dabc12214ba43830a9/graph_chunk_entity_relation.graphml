<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BUTTERFLY HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Butterfly House is a facility operated by the Missouri Botanical Gardens and is located in Faust Park, Chesterfield, Missouri, United States. It is known for showcasing butterflies and includes an outdoor area called the Butterfly Garden."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;MISSOURI BOTANICAL GARDENS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Missouri Botanical Gardens is an organization that operates the Butterfly House and is accredited by the Association of Zoos and Aquariums (AZA)."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;FAUST PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Faust Park is the location where the Butterfly House is situated in Chesterfield, Missouri, United States."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;CHESTERFIELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chesterfield is a city in Missouri, United States, where the Butterfly House is located."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;ASSOCIATION OF ZOOS AND AQUARIUMS (AZA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Association of Zoos and Aquariums (AZA) is the accrediting body for the Butterfly House."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;GROUNDBREAKING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Groundbreaking for the Butterfly House took place in June 1997."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;OPENING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Butterfly House opened to the public on September 18, 1998."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;DEDICATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The outdoor area known as the Butterfly Garden was dedicated in 2000."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;DIVISION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2002, the Butterfly House became a division of the Missouri Botanical Garden."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;EMERSON LAKESIDE TERRACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Emerson Lakeside Terrace is a feature of the Butterfly House that was added in 2002."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australia is mentioned as the location where the Butterfly House is one of the earliest examples to use prefabricated structural steel in a domestic building."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;PREFABRICATED STRUCTURAL STEEL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Prefabricated structural steel is a construction technique used in the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;TRIANGULATED TRUSS FRAMES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Triangulated truss frames are part of the structural core of the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;CEMENT FOOTINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Concrete footings are used to secure the triangulated truss frames in the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;STEEL 'C' SECTION PURLINS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Steel 'C' section purlins form the base of the first floor in the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;STEEL CROSS BRACING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Steel cross bracing ties the triangulated truss frames together in the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;PRISM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Prisms are used to split white light into a rainbow effect in butterfly wings."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;DIFFRACTIVE SCALES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Diffractive scales give off brilliant metallic and iridescent colors in butterfly wings and do not fade over time."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;ANDROCONIA SCALES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Androconia scales produce pheromones in butterfly wings, which are used for communication and finding mates."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;WINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Butterfly wings are used for flight and have various functions including communication and mating."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;NATIVE SPECIES BUTTERFLIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Butterfly House at Paul Smith’s College VIC focuses on native species butterflies."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;ADIRONDACK PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Butterfly House at Paul Smith’s College VIC reflects the natural environment of the Adirondack Park."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;VIC VOLUNTEERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Volunteers from the VIC collect insects for the Butterfly House at Paul Smith’s College VIC."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;CONCRETE FOOTINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Concrete footings are used to secure the triangulated truss frames in the Butterfly House in Australia."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;BUTTERFLIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Butterflies are the primary focus of the Butterfly House and are showcased in the facility."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <node id="&quot;TROPICAL SPECIES BUTTERFLIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Most other facilities house both tropical and native species butterflies, while the Butterfly House at Paul Smith’s College VIC focuses on native species."</data>
      <data key="d2">ramdocs-0222-caca15eed405</data>
    </node>
    <edge source="&quot;BUTTERFLY HOUSE&quot;" target="&quot;MISSOURI BOTANICAL GARDENS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Butterfly House is operated by the Missouri Botanical Gardens."</data>
      <data key="d5">"operation, management"</data>
      <data key="d6">ramdocs-0222-caca15eed405</data>
    </edge>
    <edge source="&quot;BUTTERFLY HOUSE&quot;" target="&quot;FAUST PARK&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Butterfly House is located in Faust Park, Chesterfield, Missouri, United States."</data>
      <data key="d5">"location, establishment"</data>
      <data key="d6">ramdocs-0222-caca15eed405</data>
    </edge>
  </graph>
</graphml>
