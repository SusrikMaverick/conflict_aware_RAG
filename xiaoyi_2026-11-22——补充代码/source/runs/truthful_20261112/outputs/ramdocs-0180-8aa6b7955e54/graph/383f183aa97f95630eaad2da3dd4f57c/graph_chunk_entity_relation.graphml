      <data key="d3">8.0</data>
      <data key="d4">"Van Horn High School (Missouri) is located in Independence, Missouri.")</data>
      <data key="d5">"location, establishment"</data>
      <data key="d6">ramdocs-0180-8aa6b7955e54</data>
    </edge>
    <edge source="&quot;VAN HORN HIGH SCHOOL (MISSOURI)&quot;" target="&quot;KANSAS CITY, MISSOURI SCHOOL DISTRICT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Van Horn High School (Missouri) was previously part of the Kansas City, Missouri School District.")</data>
      <data key="d5">"historical affiliation, transition"</data>
      <data key="d6">ramdocs-0180-8aa6b7955e54</data>
    </edge>
    <edge source="&quot;VAN HORN HIGH SCHOOL (MISSOURI)&quot;" target="&quot;ROBERT T. VAN HORN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Van Horn High School (Missouri) was built on the site of Honeywood, the house of Robert T. Van Horn.")</data>
      <data key="d5">"historical context, construction site"</data>
