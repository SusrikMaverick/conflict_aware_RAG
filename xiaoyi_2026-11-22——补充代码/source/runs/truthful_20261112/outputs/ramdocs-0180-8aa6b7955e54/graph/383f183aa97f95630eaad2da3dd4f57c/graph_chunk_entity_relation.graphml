  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VAN HORN HIGH SCHOOL (MISSOURI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Van Horn High School (Missouri) is a comprehensive high school located in Independence, Missouri, United States, part of the Independence School District since 2008."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;INDEPENDENCE, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Independence, Missouri is the city where Van Horn High School (Missouri) is located."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;KANSAS CITY, MISSOURI SCHOOL DISTRICT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kansas City, Missouri School District is the previous district of Van Horn High School (Missouri) before it joined the Independence School District in 2008."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;ROBERT T. VAN HORN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert T. Van Horn was a prominent newspaper publisher and statesman whose house, Honeywood, was the site where Van Horn High School (Missouri) was originally constructed in 1955."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;INNER CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Inner City is the area around Van Horn High School (Missouri) that was annexed by the city."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;VAN HORN HIGH SCHOOL (TEXAS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Van Horn High School (Texas) is a public high school located in Van Horn, Texas, serving students countywide and classified as a 1A school by the UIL."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;CULBERSON COUNTY-ALLAMOORE INDEPENDENT SCHOOL DISTRICT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Culberson County-Allamoore Independent School District is the current district of Van Horn High School (Texas)."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;MS. NELSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ms. Nelsen is a teacher at Van Horn High School (Missouri), having a passion for traveling, bird watching, and spending time with her friends and family. She is excited to support her students in their science learning journey."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Texas is the state where Van Horn High School (Texas) is located."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;TEXAS EDUCATION AGENCY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Texas Education Agency rated Van Horn High School (Texas) as 'Met Standard' in 2015."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;MATRIX SYNTHETIC TURF SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Matrix Synthetic Turf system is mentioned as part of the new stadium installed at Van Horn High School (Texas) in 2014."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;EPIC TRACKS V300 400 METER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Epic Tracks V300 400 meter is part of the new stadium installed at Van Horn High School (Texas) in 2014."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;MEXIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexia is a town in Texas where the correct pronunciation guide is available."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;PRONUNCIATION GUIDE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Pronunciation Guide is a downloadable resource for the correct pronunciation of places in Texas."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;ADOPT A TOWN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Adopt a Town is an initiative allowing teachers and parents to adopt a Texas town or county and share their message for educational benefits."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;TEXAS STATE AVERAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Texas State Average is used as a comparison for various statistics such as math and reading proficiency rates and graduation rates."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;393 STUDENTS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"393 students attend Van Horn High School (Texas)."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 2015, Van Horn High School (Texas) was rated 'Met Standard' by the Texas Education Agency."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;2008&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"As of 2008, Van Horn High School (Missouri) is part of the Independence School District."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
    <node id="&quot;2014&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 2014, Van Horn High School (Texas) replaced their old grass football field with a new stadium that included a Matrix Synthetic Turf system and an Epic Tracks V300 400 meter track."</data>
      <data key="d2">ramdocs-0180-8aa6b7955e54</data>
    </node>
