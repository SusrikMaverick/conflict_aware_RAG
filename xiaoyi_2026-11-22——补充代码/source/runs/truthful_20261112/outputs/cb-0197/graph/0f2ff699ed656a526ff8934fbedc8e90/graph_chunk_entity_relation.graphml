<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHARLES ENDERBY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Enderby is a 19th-century English whaling merchant and explorer who has been recognized for his contributions to science and space exploration."&lt;SEP&gt;"Charles Enderby is an individual recognized by the Royal Society for his significant contributions to the advancement of science and his dedication to promoting the values of the Royal Society."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;INTERNATIONAL ASTRONAUTICAL FEDERATION (IAF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The International Astronautical Federation is a modern space advocacy group that Charles Enderby joined as a member in 2018."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;LONDON, ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"LONDON, ENGLAND is the location where the news about Charles Enderby's IAF membership was announced."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;DR. MARIA ZUBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Zuber is the President of the International Astronautical Federation and praised Charles Enderby's passion for exploration."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;IAF MEMBERSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"IAF membership is the status Charles Enderby holds within the International Astronautical Federation, recognized for his unique perspective and contributions."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;ROYAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Society is a prestigious scientific organization founded in 1660, and Charles Enderby was inducted as a member."&lt;SEP&gt;"The Royal Society is an esteemed organization that honors individuals for significant contributions to science and promotes scientific excellence and human knowledge."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;DR. EMMA HART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Hart is a historian of science at the University of Cambridge and commented on Charles Enderby's contributions to the scientific community."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;PROFESSOR JAMES DELGADO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor James Delgado is a marine archaeologist and historian who highlighted the interdisciplinary nature of Charles Enderby's work."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;WHALING INDUSTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The whaling industry is the field in which Charles Enderby made his fortune and conducted his expeditions."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;AUCKLAND ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Auckland Islands is a location where Charles Enderby conducted his expeditions and discovered new species."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;MARINE BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Marine biology is the field of study that Charles Enderby contributed to through his work in the whaling industry."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;ROYAL SOCIETY MEMBERSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Royal Society membership is the honor Charles Enderby received for his contributions to science and exploration."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;SPACE EXPLORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Space exploration is the area of interest that Charles Enderby became involved with through the IAF."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;EXPLORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Exploration is a key theme in Charles Enderby's life, encompassing both his whaling expeditions and his interest in space."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;19TH-CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"19th-century refers to the time period in which Charles Enderby lived and worked."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;1660&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"1660 is the year the Royal Society was founded."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;2018&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"2018 is the year Charles Enderby's IAF membership was confirmed."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;1846&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"1846 is the year Charles Enderby was elected as a Fellow of the Royal Society."&lt;SEP&gt;"1846 is the year in which the honor was bestowed, marking a significant milestone in Charles Enderby's career."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;MARINE ECOSYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Marine ecosystems are the environments studied by Charles Enderby in his whaling expeditions."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;HUMAN ACTIVITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human activities are the impacts on marine ecosystems that Charles Enderby documented in his work."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;SUSTAINABLE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable development is a concept highlighted by Professor James Delgado in relation to Charles Enderby's work."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;NATURAL WORLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Natural world is the domain of Charles Enderby's scientific contributions, including marine biology and exploration."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;SCIENTIFIC INQUIRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific inquiry is the method used by Charles Enderby in his work, both in the whaling industry and in space exploration."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;COMMERCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commerce is the aspect of Charles Enderby's work in the whaling industry."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;ADVANCEMENT OF SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Advancement of science is the goal of Charles Enderby's contributions to the Royal Society and the IAF."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;SIGNIFICANT CONTRIBUTIONS TO THE ADVANCEMENT OF SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Significant contributions to the advancement of science refer to Charles Enderby's work that has been recognized by the Royal Society."</data>
      <data key="d2">cb-0197</data>
    </node>
    <node id="&quot;PROMOTION OF THE VALUES OF THE ROYAL SOCIETY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Promotion of the values of the Royal Society refers to Charles Enderby's dedication to the principles and goals of the Royal Society."</data>
      <data key="d2">cb-0197</data>
    </node>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;IAF MEMBERSHIP&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Charles Enderby joined the International Astronautical Federation as a member, bringing a unique perspective to the organization."</data>
      <data key="d5">"exploration, interdisciplinary collaboration"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;ROYAL SOCIETY MEMBERSHIP&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Charles Enderby was inducted into the Royal Society, a prestigious scientific organization, for his contributions to science and exploration."</data>
      <data key="d5">"scientific recognition, interdisciplinary collaboration"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;AUCKLAND ISLANDS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Charles Enderby conducted his expeditions and discovered new species in the Auckland Islands, contributing to marine biology."</data>
      <data key="d5">"exploration, discovery"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;ROYAL SOCIETY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The Royal Society has honored Charles Enderby for his significant contributions to science and his dedication to promoting the values of the Royal Society."</data>
      <data key="d5">"honor, recognition"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;SIGNIFICANT CONTRIBUTIONS TO THE ADVANCEMENT OF SCIENCE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Charles Enderby has made significant contributions to the advancement of science, which has been recognized by the Royal Society."</data>
      <data key="d5">"contributions, recognition"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;CHARLES ENDERBY&quot;" target="&quot;PROMOTION OF THE VALUES OF THE ROYAL SOCIETY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Charles Enderby is dedicated to promoting the values of the Royal Society, which aligns with the organization's goals."</data>
      <data key="d5">"dedication, alignment"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;IAF MEMBERSHIP&quot;" target="&quot;ROYAL SOCIETY MEMBERSHIP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Both memberships highlight Charles Enderby's contributions to science and exploration, showcasing his diverse interests and achievements."</data>
      <data key="d5">"dual recognition, interdisciplinary collaboration"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;IAF MEMBERSHIP&quot;" target="&quot;WHALING INDUSTRY&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Charles Enderby's background in the whaling industry influenced his perspective and contributions to the International Astronautical Federation."</data>
      <data key="d5">"background, perspective"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;ROYAL SOCIETY&quot;" target="&quot;1846&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Royal Society bestowed an honor in 1846, marking a significant milestone in Charles Enderby's career."</data>
      <data key="d5">"milestone, recognition"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;ROYAL SOCIETY&quot;" target="&quot;SIGNIFICANT CONTRIBUTIONS TO THE ADVANCEMENT OF SCIENCE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Royal Society recognizes Charles Enderby for his significant contributions to the advancement of science."</data>
      <data key="d5">"recognition, contributions"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;ROYAL SOCIETY&quot;" target="&quot;PROMOTION OF THE VALUES OF THE ROYAL SOCIETY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Royal Society values Charles Enderby's dedication to promoting the values of the Royal Society."</data>
      <data key="d5">"dedication, values"</data>
      <data key="d6">cb-0197</data>
    </edge>
    <edge source="&quot;WHALING INDUSTRY&quot;" target="&quot;ROYAL SOCIETY MEMBERSHIP&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Charles Enderby's work in the whaling industry contributed to his induction into the Royal Society, highlighting the interdisciplinary nature of his contributions."</data>
      <data key="d5">"background, interdisciplinary collaboration"</data>
      <data key="d6">cb-0197</data>
    </edge>
  </graph>
