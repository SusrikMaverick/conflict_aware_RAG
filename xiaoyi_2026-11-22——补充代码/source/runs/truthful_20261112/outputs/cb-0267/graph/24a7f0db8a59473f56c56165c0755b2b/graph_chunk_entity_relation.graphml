      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Collaboration is emphasized by the Georgia Institute of Technology as a key aspect of its research environment."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;CUTTING-EDGE FACILITIES&quot;">
