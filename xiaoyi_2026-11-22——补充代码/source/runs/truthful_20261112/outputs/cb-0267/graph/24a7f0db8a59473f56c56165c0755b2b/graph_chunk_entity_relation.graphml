      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;PATIENT OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Patient Outcomes are improved through the research conducted by Renato Patrone at the Istituto Nazionale Tumori IRCCS 'Fondazione G. Pascale'."&lt;SEP&gt;"Patient outcomes refer to the results of medical treatments and the overall health status of patients."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;INTER-INSTITUTIONAL COLLABORATION&quot;">
