    </node>
    <node id="&quot;UNPRECEDENTED STRENGTH-TO-WEIGHT RATIO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Unprecedented Strength-to-Weight Ratio is a novel material discovered by Renato Patrone with significant potential applications."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is highlighted as a key attribute of the Georgia Institute of Technology, attracting top talent like Renato Patrone."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;TOP RESEARCH INSTITUTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
