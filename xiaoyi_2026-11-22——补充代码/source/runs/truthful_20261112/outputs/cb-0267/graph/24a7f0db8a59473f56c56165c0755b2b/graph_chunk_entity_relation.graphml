  <graph edgedefault="undirected">
    <node id="&quot;RENATO PATRONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Renato Patrone is a renowned researcher in materials science and cancer research, known for his groundbreaking discoveries and affiliations with prestigious institutions."&lt;SEP&gt;"Renato Patrone is a researcher whose work serves as a beacon of hope in the field of cancer research."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;GEORGIA INSTITUTE OF TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Georgia Institute of Technology is a prestigious university where Renato Patrone earned his Ph.D. in Materials Science and Engineering and developed his research interests and skills."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Science Foundation is an organization that ranks Georgia Tech among the top 10 universities for research expenditures in engineering and computer science."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;ISTITUTO NAZIONALE TUMORI IRCCS 'FONDAZIONE G. PASCALE'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Istituto Nazionale Tumori IRCCS 'Fondazione G. Pascale' is a leading cancer research hospital in Italy where Renato Patrone has worked and published research."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;DR. MARYAM TABRIZIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maryam Tabrizian is a professor at Georgia Tech who praises Renato Patrone's achievements and the university's role in his development as a researcher."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;DR. ÁNGEL CABRERA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ángel Cabrera is the President of Georgia Tech and emphasizes the university's mission to advance knowledge and improve the human condition."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is a renowned oncologist and Director of Research at the Istituto Nazionale Tumori IRCCS 'Fondazione G. Pascale', praising Renato Patrone's contributions to cancer research."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;DR. GIOVANNI DE LAURENTIIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Giovanni De Laurentiis is the President of the Istituto Nazionale Tumori IRCCS 'Fondazione G. Pascale', highlighting Renato Patrone's impact on cancer research and patient outcomes."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cancer Research is a prestigious journal that published a study co-authored by Renato Patrone and affiliated with the Istituto Nazionale Tumori IRCCS 'Fondazione G. Pascale'."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;ATLANTA, GA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Atlanta, GA is the city where Renato Patrone's journey to success began at the Georgia Institute of Technology."</data>
      <data key="d2">cb-0267</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Materials Science and Engineering is the field in which Renato Patrone specializes and conducts his research."</data>
      <data key="d2">cb-0267</data>
    </node>
