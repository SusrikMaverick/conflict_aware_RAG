<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DR. RACHEL KATZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Katz is a renowned computer scientist working on a revolutionary neural inference chip called 'Eretz', which is designed to process vast amounts of data with unprecedented speed and accuracy."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;TEL AVIV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tel Aviv is a bustling city where Dr. Rachel Katz works, known for its vibrant street life and as a center of innovation."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;ERETZ&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Eretz is a revolutionary neural inference chip designed by Dr. Rachel Katz's team, aimed at processing vast amounts of data with unprecedented speed and accuracy."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;ISRAELI GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Israeli government is planning to digitize the country's infrastructure using the Eretz chip, highlighting its importance for national projects."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;ISRAELI MINISTRY OF IMMIGRATION AND ABSORPTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Israeli Ministry of Immigration and Absorption is interested in using the Eretz chip to streamline the Aliyah process, emphasizing its role in immigration and integration."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;ALIYAH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Aliyah is the mass immigration of Jews from the diaspora to the Land of Israel, a cornerstone of Israel's national identity."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;AMIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amir is a colleague of Dr. Rachel Katz who helped develop the Eretz chip and is excited about its readiness for testing."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;COMPOUND INSTRUCTION SET ARCHITECTURE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Compound instruction set architecture is a novel approach to designing the instruction set architecture of a microprocessor specifically tailored for neural network inference tasks."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;US PATENT 11263011&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"US Patent 11263011 was granted on February 21, 2022, for a novel compound instruction set architecture for a neural inference chip, marking a significant milestone in the development of such technology."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;UNITED STATES PATENT AND TRADEMARK OFFICE (USPTO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The USPTO granted the patent for the compound instruction set architecture, highlighting its recognition of the technology's significance."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;COMPUTER VISION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Computer vision is an area of artificial intelligence where the compound instruction set architecture can significantly improve performance and efficiency."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;NATURAL LANGUAGE PROCESSING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Natural language processing is another area of artificial intelligence where the compound instruction set architecture can enhance performance and efficiency."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;AUTONOMOUS VEHICLES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Autonomous vehicles are an area where the compound instruction set architecture can lead to breakthroughs due to improved performance and efficiency."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;DATA PROCESSING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Data processing is a critical aspect of the Eretz chip's functionality, enabling it to handle vast amounts of data efficiently."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;NEURAL NETWORK INFERENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Neural network inference is the core function of the Eretz chip, which processes data to make predictions or decisions."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;BUREAUCRATIC RED TAPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bureaucratic red tape refers to the administrative challenges faced by the Israeli Ministry of Immigration and Absorption in managing the Aliyah process."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;INTEGRATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Integration is the process of helping new immigrants adapt to Israeli society, which the Eretz chip aims to streamline."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;PERSECUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Persecution is the historical context of why many of the immigrants coming to Israel through Aliyah fled their home countries."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;LAND OF ISRAEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Land of Israel is the destination for Aliyah, representing a significant cultural and historical symbol for Jewish people."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;NEW LIFE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"New life is the metaphorical term used to describe the fresh start that immigrants hope to achieve in Israel."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;EFFICIENCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Efficiency is a key benefit of the Eretz chip, which can streamline various processes through faster data processing."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is the driving force behind the development of the Eretz chip and the compound instruction set architecture."</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;PROCEEDINGS OF THE 2020 ACM\/IEEE 47TH ANNUAL INTERNATIONAL SYMPOSIUM ON COMPUTER ARCHITECTURE (ISCA)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Proceedings of the 2020 ACM/IEEE 47th Annual International Symposium on Computer Architecture (ISCA</data>
      <data key="d2">cb-0286</data>
    </node>
    <node id="&quot;J. WANG ET AL.&quot;">
      <data key="d2">cb-0286</data>
      <data key="d1">"J. Wang et al. authored a paper published in the ISCA proceedings, contributing to the field of computer architecture."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;NEURAL INFERENCE CHIP&quot;">
      <data key="d2">cb-0286</data>
      <data key="d1">"Computer Vision relies on advanced technologies like Neural Inference Chips to process visual data efficiently."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;COMPUTER ARCHITECTURE&quot;">
      <data key="d2">cb-0286</data>
      <data key="d1">"Computer Architecture encompasses the design and structure of Neural Inference Chips, which are specialized hardware for neural network inference."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;DR. RACHEL KATZ&quot;" target="&quot;ERETZ&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dr. Rachel Katz is the lead developer of the Eretz chip, a revolutionary neural inference chip designed to process vast amounts of data with unprecedented speed and accuracy."</data>
      <data key="d5">"development, leadership"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;DR. RACHEL KATZ&quot;" target="&quot;AMIR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Amir is a colleague of Dr. Rachel Katz who helped develop the Eretz chip and is excited about its readiness for testing."</data>
      <data key="d5">"collaboration, excitement"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;ERETZ&quot;" target="&quot;ISRAELI GOVERNMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Eretz chip is designed to help the Israeli government digitize the country's infrastructure, highlighting its importance for national projects."</data>
      <data key="d5">"digitization, infrastructure"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;ERETZ&quot;" target="&quot;ISRAELI MINISTRY OF IMMIGRATION AND ABSORPTION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Eretz chip is of interest to the Israeli Ministry of Immigration and Absorption for streamlining the Aliyah process, emphasizing its role in immigration and integration."</data>
      <data key="d5">"streamlining, immigration"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;ERETZ&quot;" target="&quot;COMPOUND INSTRUCTION SET ARCHITECTURE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The compound instruction set architecture is a key component of the Eretz chip, enabling it to process vast amounts of data with unprecedented speed and accuracy."</data>
      <data key="d5">"innovation, performance"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;COMPOUND INSTRUCTION SET ARCHITECTURE&quot;" target="&quot;US PATENT 11263011&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"US Patent 11263011 grants protection for a novel compound instruction set architecture for a neural inference chip, marking a significant milestone in the development of such technology."</data>
      <data key="d5">"patent, milestone"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;US PATENT 11263011&quot;" target="&quot;PROCEEDINGS OF THE 2020 ACM\/IEEE 47TH ANNUAL INTERNATIONAL SYMPOSIUM ON COMPUTER ARCHITECTURE (ISCA)&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The US Patent 11263011 is mentioned in the ISCA proceedings, indicating its relevance to the field of computer architecture."&lt;</data>
      <data key="d5">"publication, relevance"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;COMPUTER VISION&quot;" target="&quot;AUTONOMOUS VEHICLES&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Computer Vision and Autonomous Vehicles both rely on advanced technologies to function, with Computer Vision enabling the interpretation of the visual world and Autonomous Vehicles using these technologies for navigation."&lt;</data>
      <data key="d5">"technological dependency, application"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;COMPUTER VISION&quot;" target="&quot;NEURAL INFERENCE CHIP&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Computer Vision relies on advanced technologies like Neural Inference Chips to process visual data efficiently."&lt;</data>
      <data key="d5">"dependency, technology"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;NATURAL LANGUAGE PROCESSING&quot;" target="&quot;AUTONOMOUS VEHICLES&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Natural Language Processing can enhance the capabilities of Autonomous Vehicles by improving their interaction with humans and understanding of commands."&lt;</data>
      <data key="d5">"enhancement, human-vehicle interaction"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;NATURAL LANGUAGE PROCESSING&quot;" target="&quot;NEURAL INFERENCE CHIP&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Natural Language Processing relies on Neural Inference Chips to perform efficient inference tasks for language processing."&lt;</data>
      <data key="d5">"dependency, technology"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;AUTONOMOUS VEHICLES&quot;" target="&quot;NEURAL INFERENCE CHIP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Autonomous Vehicles rely on Neural Inference Chips to perform complex computations necessary for autonomous operation."&lt;</data>
      <data key="d5">"dependency, technology"</data>
      <data key="d6">cb-0286</data>
    </edge>
    <edge source="&quot;PROCEEDINGS OF THE 2020 ACM\/IEEE 47TH ANNUAL INTERNATIONAL SYMPOSIUM ON COMPUTER ARCHITECTURE (ISCA)&quot;" target="&quot;J. WANG ET AL.&quot;">
