      <data key="d5">"historical evidence, documentation"</data>
      <data key="d6">cb-0323</data>
    </edge>
    <edge source="&quot;CATHERINE OF HENNEBERG&quot;" target="&quot;EXPERT TESTIMONY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Expert testimony supports the evidence from medieval records, confirming the marriage of Catherine of Henneberg and Frederick III."</data>
      <data key="d5">"confirmation, historical support"</data>
      <data key="d6">cb-0323</data>
    </edge>
    <edge source="&quot;THURINGIAN CHRONICLE&quot;" target="&quot;MEDIEVAL RECORDS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Thuringian Chronicle is part of the medieval records that provide evidence of Catherine of Henneberg and Frederick III's marriage."</data>
      <data key="d5">"historical document, evidence"</data>
      <data key="d6">cb-0323</data>
    </edge>
    <edge source="&quot;THURINGIAN CHRONICLE&quot;" target="&quot;EXPERT TESTIMONY&quot;">
