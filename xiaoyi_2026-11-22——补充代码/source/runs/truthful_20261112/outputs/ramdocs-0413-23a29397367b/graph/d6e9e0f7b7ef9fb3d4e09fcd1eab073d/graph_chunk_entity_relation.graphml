<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ALBERT, PRINCE CONSORT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Albert, Prince Consort is mentioned in the context of his roles and appointments during the 19th century."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;BRISTOL CATHEDRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bristol Cathedral is where Albert, Prince Consort was presented to a residential canonry in 1853."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;OLVESTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Olveston is a place where Albert, Prince Consort served as vicar and where Moseley died on 20 January 1872."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;MOSELEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Moseley is a person who held various positions including Fellow of the Royal Society, corresponding member of the Institute of France, and vice-president of the Institution of Naval Architects."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;PORTSMOUTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portsmouth is a place where Moseley wrote his first paper."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;ROYAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Society is an organization where Moseley was elected as a Fellow in February 1839."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;INSTITUTE OF FRANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institute of France is an organization where Moseley was a corresponding member."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;COUNCIL OF MILITARY EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Council of Military Education is an organization where Moseley was a member."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;INSTITUTION OF NAVAL ARCHITECTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institution of Naval Architects is an organization where Moseley was a vice-president."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;MARINE BIOLOGICAL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Marine Biological Association is an organization where Moseley was appointed a research fellow in 1855."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;COUNCIL OF MARINE RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Council of Marine Research is an organization where Moseley was a member."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;CHALLENGER EXPEDITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Challenger expedition is a notable expedition Moseley participated in from 1872 to 1876."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;UNIVERSITY OF LONDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of London is where Moseley began working in 1879."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;MERTON COLLEGE, OXFORD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Merton College, Oxford is where Moseley was awarded the Linacre chair of human and comparative anatomy in 1881."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;PITT-RIVERS DONATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pitt-Rivers donation is a negotiation Moseley became involved in in 1884."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;EDWARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Edward is mentioned in the context of Moseley's involvement in the Pitt-Rivers donation."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;SUMMER FIELDS SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Summer Fields School is where Henry Moseley was a very promising schoolboy and won a King's scholarship to Eton College."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;ETON COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eton College is where Henry Moseley attended and won the chemistry and physics prizes in 1906."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;TRINITY COLLEGE, UNIVERSITY OF OXFORD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Trinity College, University of Oxford is where Henry Moseley earned his bachelor's degree in 1910."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;UNIVERSITY OF MANCHESTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Manchester is where Henry Moseley became a demonstrator in physics under Sir Ernest Rutherford in 1910."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;ERNEST RUTHERFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ernest Rutherford is a person who supervised Moseley as a demonstrator in physics at the University of Manchester."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature is a scientific journal where statements about Moseley's discoveries were published."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;NCERT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCERT is an organization known for providing educational books for various classes."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;RD SHARMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RD Sharma is an author known for providing solutions and books for various classes."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;PHYSICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Physics is a field of study where Moseley's discoveries were significant."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
    <node id="&quot;CHEMISTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chemistry is a field of study where Moseley's discoveries were significant."</data>
      <data key="d2">ramdocs-0413-23a29397367b</data>
    </node>
  </graph>
