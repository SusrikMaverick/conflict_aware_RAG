    <node id="&quot;PRESSING ISSUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pressing issues refer to the urgent matters facing the nation that Scoma will address as a member of the Chamber of Deputies."</data>
      <data key="d2">cb-0045</data>
