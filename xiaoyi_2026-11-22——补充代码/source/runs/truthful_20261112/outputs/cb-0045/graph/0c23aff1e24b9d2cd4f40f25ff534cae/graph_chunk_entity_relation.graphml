  <graph edgedefault="undirected">
    <node id="&quot;FRANCESCO SCOMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francesco Scoma is an Italian politician who has been appointed as the new sénateur de l'Allier and elected as a member of the Chamber of Deputies of the Italian Republic."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;SÉNATEUR DE L'ALLIER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Sénateur de l'Allier is a position in the French Senate representing the department of Allier."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Élysée Palace is the official residence and workplace of the President of France."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;PRESIDENT EMMANUEL MACRON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"President Emmanuel Macron is the President of France and played a role in appointing Francesco Scoma as the sénateur de l'Allier."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;SENATOR NATHALIE GOULET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Senator Nathalie Goulet is a member of the Republican Party and welcomed Scoma's arrival in the French Senate."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;SOCIALIST PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Socialist Party is a political party in France and its leader, Olivier Faure, expressed concerns about Scoma's appointment."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;OLIVIER FAURE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Olivier Faure is the leader of the Socialist Party and expressed concerns about Scoma's appointment."&lt;SEP&gt;"Olivier Faure is the leader of the Socialist Party and expressed concerns about Scoma's lack of familiarity with French politics."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Ministry of the Interior provided data confirming Scoma's appointment as the sénateur de l'Allier."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;ALLIER DEPARTMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Allier department is a region in central France known for its rich agricultural heritage and picturesque countryside."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES OF THE ITALIAN REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Chamber of Deputies of the Italian Republic is a significant political body in Italy, representing a major development in Italian politics."&lt;SEP&gt;"The Chamber of Deputies of the Italian Republic is the lower house of the Italian Parliament."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;GIOVANNI BIANCHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni Bianchi is a fellow deputy and member of Scoma's political party in the Chamber of Deputies of the Italian Republic."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;ITALIAN MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Italian Ministry of the Interior confirmed Scoma's election to the Chamber of Deputies."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the capital city of France where the announcement of Scoma's appointment was made."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;FRENCH POLITICAL ESTABLISHMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French political establishment includes various political figures and institutions involved in French politics."</data>
      <data key="d2">cb-0045</data>
    </node>
