    <node id="&quot;ECONOMIC GROWTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic growth is one of the pressing issues that Scoma will address as a member of the Chamber of Deputies."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;SOCIAL WELFARE&quot;">
