      <data key="d0">"ROLE"</data>
      <data key="d1">"Italian politician refers to Francesco Scoma's previous role before his appointment as sénateur de l'Allier."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;REPUBLICAN PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
