      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;ITALIAN PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Italian Parliament is the legislative body of Italy, comprising the Chamber of Deputies and the Senate."</data>
      <data key="d2">cb-0045</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
