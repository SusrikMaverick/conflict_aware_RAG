    </edge>
    <edge source="&quot;MALIK HEBBAR&quot;" target="&quot;A.C. MILAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Malik Hebbar started his youth career at A.C. Milan, where he spent five years developing his skills."</data>
      <data key="d5">"youth career, development"</data>
