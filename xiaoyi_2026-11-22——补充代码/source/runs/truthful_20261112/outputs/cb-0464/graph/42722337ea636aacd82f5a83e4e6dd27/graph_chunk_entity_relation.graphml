    </edge>
    <edge source="&quot;MALIK HEBBAR&quot;" target="&quot;INTER MILAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Malik Hebbar made his professional debut at Inter Milan and played for the club for three seasons before transferring to S.S.D. Pro Sesto Calcio."</data>
      <data key="d5">"professional debut, career progression"</data>
      <data key="d6">cb-0464</data>
    </edge>
    <edge source="&quot;MALIK HEBBAR&quot;" target="&quot;TORINO F.C.&quot;">
