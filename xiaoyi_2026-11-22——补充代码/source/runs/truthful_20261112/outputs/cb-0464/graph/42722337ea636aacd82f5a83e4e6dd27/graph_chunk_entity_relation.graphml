  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MALIK HEBBAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Malik Hebbar is a footballer known for his journey with FC Istres and his current affiliation with S.S.D. Pro Sesto Calcio, characterized by his dedication and skill."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;FC ISTRES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Istres is a football club based in Istres, France, founded in 1920, known for its rich history and passionate fan base."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;ISTRES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Istres is a town in France, located between the Mediterranean coast and the Camargue region, home to FC Istres."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;S.S.D. PRO SESTO CALCIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"S.S.D. Pro Sesto Calcio is an Italian football club based in Sesto San Giovanni, Lombardy, where Malik Hebbar currently plays."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;MILAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan is a city in Italy, Malik Hebbar's birthplace and where he began his youth career at A.C. Milan's youth academy."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;A.C. MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A.C. Milan is an Italian football club where Malik Hebbar started his youth career, spending five years there."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;INTER MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inter Milan is an Italian football club where Malik Hebbar played for two seasons in its youth academy and made his professional debut."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;TORINO F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Torino F.C. is an Italian football club against which Malik Hebbar made his professional debut for Inter Milan."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;AS CANNES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AS Cannes is a French football club that Malik Hebbar faced in a match where he scored a crucial goal for FC Istres."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;LA PROVENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Provence is a regional newspaper that published an article detailing Malik Hebbar's debut for FC Istres."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS SCIENCE AND MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Sports Science and Medicine is a publication that analyzed Malik Hebbar's performance during his time at Inter Milan."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;LA GAZZETTA DELLO SPORT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Gazzetta dello Sport is an Italian sports newspaper where Malik Hebbar discussed his decision to join S.S.D. Pro Sesto Calcio."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;TUTTOMERCATOWEB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TuttoMercatoWeb is an Italian football website that listed Malik Hebbar as one of the top 10 players in Serie C."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;CAMARGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Camargue is a region in southern France, near Istres, where Malik Hebbar's hometown is located."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;FRENCH LOWER DIVISIONS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"French lower divisions refer to the lower tiers of French football, where Malik Hebbar was scouted before joining FC Istres."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;SERIE A&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Serie A is the top division of Italian football, where Malik Hebbar made his professional debut for Inter Milan."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;SERIE C&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Serie C is a lower tier of Italian football, where S.S.D. Pro Sesto Calcio plays and Malik Hebbar helped the team secure promotion."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;SESTO SAN GIOVANNI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sesto San Giovanni is a city in Lombardy, Italy, where S.S.D. Pro Sesto Calcio is based."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;LOMBARDY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lombardy is a region in northern Italy where S.S.D. Pro Sesto Calcio is located."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;LOCAL COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local community refers to the support and passion of the residents of Istres for FC Istres."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;PASSIONATE FAN BASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Passionate fan base refers to the dedicated supporters of FC Istres who follow the team's successes and struggles."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;RICH HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rich history refers to the long-standing tradition and legacy of FC Istres as a football club."</data>
      <data key="d2">cb-0464</data>
    </node>
    <node id="&quot;YOUTH ACADEMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Youth academy refers to the training facilities and programs where young footballers develop their skills."</data>
      <data key="d2">cb-0464</data>
    </node>
    <edge source="&quot;MALIK HEBBAR&quot;" target="&quot;FC ISTRES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Malik Hebbar joined FC Istres after a successful youth career and made his debut, contributing to the team's successes."</data>
