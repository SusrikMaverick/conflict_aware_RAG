      <data key="d3">16.0</data>
      <data key="d4">"Dr. Hans-Joachim Schlichting supervised Daniel C. Jeffares' undergraduate thesis, 'An Investigation into the Properties of Ferromagnetic Materials.'"</data>
      <data key="d5">"supervision, mentorship"</data>
