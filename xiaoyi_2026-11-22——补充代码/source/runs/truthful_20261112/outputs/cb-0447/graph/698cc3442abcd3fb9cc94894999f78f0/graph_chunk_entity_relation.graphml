    <edge source="&quot;DANIEL C. JEFFARES&quot;" target="&quot;ROYAL ACADEMY OF ENGINEERING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Daniel C. Jeffares is a fellow of the Royal Academy of Engineering, indicating his recognition and standing in the field of engineering."</data>
      <data key="d5">"fellowship, recognition"</data>
