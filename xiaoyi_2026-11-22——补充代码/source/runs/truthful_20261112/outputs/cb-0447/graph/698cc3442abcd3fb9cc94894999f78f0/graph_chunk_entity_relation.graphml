      <data key="d3">16.0</data>
      <data key="d4">"Daniel C. Jeffares was born in Berlin, Germany, indicating a strong connection to this location."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">cb-0447</data>
    </edge>
    <edge source="&quot;DANIEL C. JEFFARES&quot;" target="&quot;TECHNISCHE HOCHSCHULE BERLIN (THB)&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Daniel C. Jeffares studied at Technische Hochschule Berlin (THB) from 1973 to 1977, where he was influenced by Hermann von Helmholtz and worked under Dr. Hans-Joachim Schlichting."</data>
      <data key="d5">"education, mentorship"</data>
      <data key="d6">cb-0447</data>
    </edge>
