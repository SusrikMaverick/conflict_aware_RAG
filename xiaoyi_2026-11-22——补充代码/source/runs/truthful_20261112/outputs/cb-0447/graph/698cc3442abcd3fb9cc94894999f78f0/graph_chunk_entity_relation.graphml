  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DANIEL C. JEFFARES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniel C. Jeffares is a renowned researcher in the field of engineering and technology, born on February 12, 1955, in Berlin, Germany, and known for significant contributions to mechanical engineering and materials science."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is the birthplace of Daniel C. Jeffares."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;TECHNISCHE HOCHSCHULE BERLIN (THB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Technische Hochschule Berlin (THB) is a former Prussian college where Daniel C. Jeffares studied from 1973 to 1977."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;HERMANN VON HELMHOLTZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hermann von Helmholtz is a German engineer and physicist whose works influenced Daniel C. Jeffares during his time at THB."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;DR. HANS-JOACHIM SCHLICHTING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hans-Joachim Schlichting is a prominent figure in the field of materials science and supervised Daniel C. Jeffares' undergraduate thesis."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Cambridge is where Daniel C. Jeffares pursued his graduate studies and earned his Ph.D. in Mechanical Engineering in 1982."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;JOURNAL OF AEROSPACE ENGINEERING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Aerospace Engineering is where Daniel C. Jeffares published his research on the application of advanced materials in aerospace engineering."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;MAX PLANCK MEDAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Max Planck Medal is an award Daniel C. Jeffares received in 2001 for his outstanding contributions to the field of materials science."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;ROYAL ACADEMY OF ENGINEERING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Academy of Engineering is an organization where Daniel C. Jeffares is a fellow."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;GERMAN NATIONAL ACADEMY OF SCIENCES LEOPOLDINA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"German National Academy of Sciences Leopoldina is an organization where Daniel C. Jeffares is a member."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;MASSEY UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Massey University is an institution where Daniel C. Jeffares has been affiliated, according to his academic profile."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;NEW ZEALAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand is the country where Massey University is located, and Daniel C. Jeffares has been affiliated with it."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;ACADEMIC PROFILE&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Academic Profile is a document that lists Daniel C. Jeffares' affiliations and publications."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;RESEARCHGATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ResearchGate is a platform where Daniel C. Jeffares maintains his professional profile."</data>
      <data key="d2">cb-0447</data>
    </node>
    <node id="&quot;MASSEY UNIVERSITY'S OFFICIAL WEBSITE&quot;">
      <data key="d0">"WEBSITE"</data>
      <data key="d1">"Massey University's official website is a source of information about Daniel C. Jeffares' affiliation."</data>
      <data key="d2">cb-0447</data>
    </node>
