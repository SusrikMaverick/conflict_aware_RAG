  <graph edgedefault="undirected">
    <node id="&quot;BIJESH KUMAR BISWAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bijesh Kumar Biswal is a renowned researcher with significant contributions to materials science, holding positions at both NIT Rourkela and CNR, and recognized with multiple awards."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTE OF TECHNOLOGY, ROURKELA (NIT ROURKELA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NIT Rourkela is a prestigious engineering college in India where Bijesh Kumar Biswal held a position and conducted research."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;CONSIGLIO NAZIONALE DELLE RICERCHE (CNR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CNR is the Italian national research funding organization where Bijesh Kumar Biswal worked as a research scientist and contributed to high-profile research projects."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;DR. S.K. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. S.K. Patel is the Dean of Research and Consultancy at NIT Rourkela and speaks positively about Bijesh Kumar Biswal's affiliation with the institution."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;INDIAN INSTITUTE OF TECHNOLOGY, DELHI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IIT Delhi is the institution where Bijesh Kumar Biswal completed his Ph.D. in Materials Science."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;MARIA GRAZIA FRANCESCONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Grazia Francesconi is a renowned expert in the field of nanomaterials and supervised Bijesh Kumar Biswal's research at CNR."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;NATURE MATERIALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nature Materials is a scientific journal where one of Bijesh Kumar Biswal's research papers was published."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;ADVANCED MATERIALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Advanced Materials is a scientific journal where another one of Bijesh Kumar Biswal's research papers was published and featured on the cover."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;YOUNG RESEARCHER AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Young Researcher Award is a prestigious award given by the Indian National Science Academy to recognize outstanding research by young scientists."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;CNR YOUNG RESEARCHER AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The CNR Young Researcher Award is a prestigious award given by the Consiglio Nazionale delle Ricerche to recognize outstanding research by young scientists."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;ITALIAN NATIONAL RESEARCH COUNCIL FELLOWSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Italian National Research Council Fellowship is a fellowship awarded by the Consiglio Nazionale delle Ricerche to support research activities."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;SYNTHESIS AND CHARACTERIZATION OF NANOSTRUCTURED MATERIALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Biswal's dissertation titled 'Synthesis and Characterization of Nanostructured Materials' was widely acclaimed and earned him the prestigious 'Young Researcher Award' from the Indian National Science Academy."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;NANOSTRUCTURED MATERIALS FOR ENERGY STORAGE APPLICATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Biswal's research on 'Nanostructured Materials for Energy Storage Applications' was published in the journal Nature Materials."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;NOVEL NANOMATERIALS FOR ENERGY STORAGE APPLICATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Biswal's research on 'Novel Nanomaterials for Energy Storage Applications' was published in the journal Advanced Materials and featured on the cover."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;IONALE DELLE RICERCHE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ionale delle Ricerche is an organization that has published research projects on energy storage applications."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;BISWAL, B. K.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Biswal, B. K. is an author of a paper on nanostructured materials for energy storage applications."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;NANOSTRUCTURED MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanostructured Materials refer to materials with structures at the nanoscale level, used in the context of energy storage applications."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;ENERGY STORAGE APPLICATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Energy Storage Applications is a topic of research and publication, involving both organizations and individuals contributing to the field."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research Projects are specific initiatives or studies conducted by Ionale delle Ricerche on energy storage applications."</data>
      <data key="d2">cb-0382</data>
    </node>
    <node id="&quot;PUBLISHED PAPER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Published Paper is a scholarly work by Biswal, B. K. on nanostructured materials for energy storage applications."</data>
      <data key="d2">cb-0382</data>
    </node>
