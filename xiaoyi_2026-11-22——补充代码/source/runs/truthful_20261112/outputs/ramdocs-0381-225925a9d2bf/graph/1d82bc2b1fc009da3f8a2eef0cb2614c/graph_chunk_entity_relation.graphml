    <node id="&quot;SUITABLE HUSBAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A suitable husband is the man Eleanor Burden marries, fitting into the societal expectations of the time."</data>
      <data key="d2">ramdocs-0381-225925a9d2bf</data>
    </node>
    <node id="&quot;ISOLATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Isolation is a state where Johnnie is kept from encountering anyone but the closest members of his family at Sandringham."</data>
      <data key="d2">ramdocs-0381-225925a9d2bf</data>
    </node>
    <node id="&quot;BRINKMANSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Brinkmanship is a strategy used by the Allies and the Central Powers, particularly led by Germany, during diplomatic meetings."</data>
      <data key="d2">ramdocs-0381-225925a9d2bf</data>
    </node>
