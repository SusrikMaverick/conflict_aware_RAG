  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF NAIROBI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Nairobi is a Kenyan institution known for academic excellence, producing successful alumni like Hai Xu."</data>
      <data key="d2">cb-0485</data>
    </node>
    <node id="&quot;HAI XU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hai Xu is a renowned researcher and alumnus of the University of Nairobi, recognized for his groundbreaking work and publications."</data>
      <data key="d2">cb-0485</data>
    </node>
    <node id="&quot;SHANGHAI UNIVERSITY&quot;">
