    <node id="&quot;JANE WANJIRU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jane Wanjiru is a professor at the University of Nairobi's Department of Biological Sciences and remembers Hai Xu as an exceptional student."</data>
