  <graph edgedefault="undirected">
    <node id="&quot;ROBERTO CAZZOLLA GATTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roberto Cazzolla Gatti is an Italian environmental and evolutionary biologist with a distinguished academic career, particularly noted for his work at Purdue University and Harvard Medical School."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;PURDUE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Purdue University is a public research university located in West Lafayette, Indiana, known for its academic excellence in STEM fields."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;HARVARD MEDICAL SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard Medical School is a prestigious institution known for its contributions to medical research and education, particularly in the areas of environmental health and evolutionary biology."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;UNIVERSITY OF ROME 'LA SAPIENZA'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Rome 'La Sapienza' is an Italian university where Roberto Cazzolla Gatti pursued his undergraduate studies."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;UNIVERSITY OF FLORENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Florence is an Italian university where Roberto Cazzolla Gatti earned his Ph.D. in environmental biology."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;DEPARTMENT OF BIOLOGICAL SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Department of Biological Sciences at Purdue University is where Roberto Cazzolla Gatti worked as a Postdoctoral Research Associate."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;DEPARTMENT OF ENVIRONMENTAL HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Department of Environmental Health at Harvard Medical School is where Roberto Cazzolla Gatti served as a research fellow."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nature is a scientific journal where one of Roberto Cazzolla Gatti's notable papers was published."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;JOURNAL OF EVOLUTIONARY MEDICINE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Journal of Evolutionary Medicine is a publication where Roberto Cazzolla Gatti co-authored a paper on evolutionary medicine."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate Change refers to the long-term alteration of temperature and typical weather patterns in a place, impacting plant species and evolutionary processes."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;PLANT SPECIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Plant Species are organisms that are studied in the context of their evolution and response to climate change."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;DISEASE VECTORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Disease Vectors are organisms that transmit pathogens from one host to another, impacting human health and evolution."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;HUMAN HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human Health is the focus of Roberto Cazzolla Gatti's research on the impact of environmental factors and climate change."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;ENVIRONMENTAL DEGRADATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Degradation is a factor studied in relation to its impact on human health and evolutionary adaptation."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;EVOLUTIONARY ADAPTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Evolutionary Adaptation is the process by which organisms change over time to better suit their environment, influenced by factors such as climate change and environmental degradation."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;EVOLUTIONARY ECOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Evolutionary Ecology is a field of study that examines how ecological factors influence the evolution of species."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;CONSERVATION BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conservation Biology focuses on the protection and sustainable management of biodiversity and ecosystems."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;ENVIRONMENTAL BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Biology is a broad field that encompasses the study of living organisms and their interactions with the environment."</data>
      <data key="d2">cb-0315</data>
    </node>
    <node id="&quot;EVOLUTIONARY MEDICINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Evolutionary Medicine explores the evolutionary basis of human health and disease, considering the impact of environmental factors."</data>
      <data key="d2">cb-0315</data>
    </node>
    <edge source="&quot;ROBERTO CAZZOLLA GATTI&quot;" target="&quot;PURDUE UNIVERSITY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Roberto Cazzolla Gatti worked as a Postdoctoral Research Associate at Purdue University's Department of Biological Sciences from 2013 to 2015, contributing to research on evolutionary ecology and conservation biology."</data>
      <data key="d5">"academic affiliation, research contribution"</data>
      <data key="d6">cb-0315</data>
    </edge>
    <edge source="&quot;ROBERTO CAZZOLLA GATTI&quot;" target="&quot;HARVARD MEDICAL SCHOOL&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Roberto Cazzolla Gatti served as a research fellow in the Department of Environmental Health at Harvard Medical School from 2005 to 2010, contributing to seminal studies on the intersection of environmental health and evolutionary biology."</data>
      <data key="d5">"academic affiliation, research contribution"</data>
      <data key="d6">cb-0315</data>
    </edge>
    <edge source="&quot;ROBERTO CAZZOLLA GATTI&quot;" target="&quot;NATURE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"One of Roberto Cazzolla Gatti's notable papers was published in the scientific journal Nature, highlighting his contributions to the field of evolutionary biology."</data>
      <data key="d5">"publication, recognition"</data>
      <data key="d6">cb-0315</data>
    </edge>
    <edge source="&quot;ROBERTO CAZZOLLA GATTI&quot;" target="&quot;JOURNAL OF EVOLUTIONARY MEDICINE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Roberto Cazzolla Gatti co-authored a paper on evolutionary medicine in the Journal of Evolutionary Medicine, showcasing his expertise in the field."</data>
      <data key="d5">"publication, recognition"</data>
      <data key="d6">cb-0315</data>
    </edge>
    <edge source="&quot;PURDUE UNIVERSITY&quot;" target="&quot;UNIVERSITY OF ROME 'LA SAPIENZA'&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Roberto Cazzolla Gatti pursued his undergraduate studies at the University of Rome 'La Sapienza', indicating a connection between these institutions."</data>
      <data key="d5">"educational background, academic lineage"</data>
      <data key="d6">cb-0315</data>
    </edge>
    <edge source="&quot;PURDUE UNIVERSITY&quot;" target="&quot;UNIVERSITY OF FLORENCE&quot;">
