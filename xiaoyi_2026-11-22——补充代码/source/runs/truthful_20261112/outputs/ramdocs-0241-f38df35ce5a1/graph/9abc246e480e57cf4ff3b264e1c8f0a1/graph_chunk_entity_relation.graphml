<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COVE FORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cove Fort is a historical site located in Millard County, Utah, and also exists as a coastal defense fortification in County Cork, Ireland. It was constructed in 1867 in Utah and 1743 in Ireland, serving different purposes in both locations."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;MILLARD COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Millard County is a county in Utah where Cove Fort is located."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Utah is a state in the United States where Cove Fort is situated."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;BRIGHAM YOUNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brigham Young was a prominent leader of The Church of Jesus Christ of Latter-day Saints who requested the founding of Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;IRA HINCKLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ira Hinckley is the paternal grandfather of Gordon B. Hinckley and a key figure in the founding of Cove Fort in 1867."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;GORDON B. HINCKLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gordon B. Hinckley is a descendant of Ira Hinckley, who is known for his involvement in the founding of Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;ARZA HINCKLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arza Hinckley is the brother of Ira Hinckley and helped build Cove Fort in 1867."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;BLACK HAWK WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Black Hawk War (1865–68) was a conflict that led to the construction of Cove Fort as a means of protection."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;PAHVANT UTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pahvant Ute is a Native American tribe that maintained good relationships with the Hinckley family during the operation of Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;NAVAJO INDIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Navajo Indians are another Native American tribe that maintained good relationships with the Hinckley family during the operation of Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;THE CHURCH OF JESUS CHRIST OF LATTER-DAY SAINTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church of Jesus Christ of Latter-day Saints is the religious organization that called families to manage the fort and ranch at Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;FILLMORE, UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fillmore, Utah is the approximate location of Cove Fort Historic Site."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;SALT LAKE CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salt Lake City is a city in Utah mentioned in relation to the telegraph lines and travelers that Cove Fort protected."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;COBH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cobh is a town in County Cork, Ireland, near where the second Cove Fort is located."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;COUNTY CORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"County Cork is a county in Ireland where the second Cove Fort is located."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;HAULBOWLINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haulbowline is a naval yard at Cork Harbour, Ireland, mentioned in relation to the second Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;VICE-ADMIRAL OF THE COAST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Vice-Admiral of the Coast is a military position that instructed the construction of the second Cove Fort in Ireland."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;TELEGRAPH LINES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Telegraph lines were protected by Cove Fort between Salt Lake City and settlements further south."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;TRAVELERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Travelers were protected by Cove Fort during its use as a way station."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;NATIVE AMERICAN RAIDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Native American raids were a concern that led to the construction of Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;COVE FORT HISTORIC SITE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cove Fort Historic Site is the current location where visitors can tour the fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;COVID-19 VISITOR INFORMATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Updates on visitor information due to COVID-19 are provided for the Cove Fort Historic Site."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <node id="&quot;TELEGRAPH LINES AND TRAVELERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Telegraph lines and travelers were the primary concerns for protection by Cove Fort."</data>
      <data key="d2">ramdocs-0241-f38df35ce5a1</data>
    </node>
    <edge source="&quot;COVE FORT&quot;" target="&quot;IRA HINCKLEY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Ira Hinckley, the paternal grandfather of Gordon B. Hinckley, founded Cove Fort in 1867."</data>
      <data key="d5">"founding, family involvement"</data>
      <data key="d6">ramdocs-0241-f38df35ce5a1</data>
    </edge>
    <edge source="&quot;COVE FORT&quot;" target="&quot;BRIGHAM YOUNG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Brigham Young requested the founding of Cove Fort at the site in Millard County, Utah."</data>
      <data key="d5">"request, leadership"</data>
      <data key="d6">ramdocs-0241-f38df35ce5a1</data>
    </edge>
    <edge source="&quot;COVE FORT&quot;" target="&quot;ARZA HINCKLEY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Arza Hinckley, the brother of Ira Hinckley, helped build Cove Fort in 1867."</data>
      <data key="d5">"construction, family involvement"</data>
      <data key="d6">ramdocs-0241-f38df35ce5a1</data>
    </edge>
    <edge source="&quot;COVE FORT&quot;" target="&quot;BLACK HAWK WAR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cove Fort was built to protect against possible Native American raids resulting from the Black Hawk War (1865–68)."</data>
      <data key="d5">"protection, conflict"</data>
      <data key="d6">ramdocs-0241-f38df35ce5a1</data>
    </edge>
  </graph>
</graphml>
