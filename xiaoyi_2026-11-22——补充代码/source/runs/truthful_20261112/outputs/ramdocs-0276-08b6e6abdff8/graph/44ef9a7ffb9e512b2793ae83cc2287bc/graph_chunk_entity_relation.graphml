  <graph edgedefault="undirected">
    <node id="&quot;GALA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gala is an Italian dance music singer who released her debut studio album 'Come into My Life' in 1997."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;COME INTO MY LIFE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Come into My Life is a song or album by Joyce Sims, released in the context of the music industry."&lt;SEP&gt;"Come into My Life is the debut studio album by Gala, released in November 1997, featuring several singles and recorded at Planet Studio in Milan, Italy."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;PLANET STUDIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Planet Studio is a recording studio located in Milan, Italy, where Gala recorded her debut album 'Come into My Life'."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;MILAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan is a city in Italy where the recording studio Planet Studio is located, and where Gala recorded her debut album 'Come into My Life'."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;DEAN CARLSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dean Carlson is a reviewer who provided a negative review of Gala's debut album 'Come into My Life', awarding it 1.5 stars."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;UK CHANNEL 4 TELETEXT PAGE 'PLANET SOUND'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UK channel 4 teletext page 'Planet Sound' provided a positive review of Gala's debut album 'Come into My Life', giving it 3 out of 5 stars."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;GALA RIZZATTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gala Rizzatto is the Italian singer who released the debut album 'Come into My Life' in 1997."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;DO IT YOURSELF S.R.L.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Do It Yourself S.R.L. is the record label for Gala's debut album 'Come into My Life'."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;JUSTIN BIEBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Justin Bieber is a Canadian pop singer who is not related to the album 'Come into My Life' by Gala."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;ABBA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ABBA is not related to the album 'Come into My Life' by Gala, but the album shares the same title as one of ABBA's releases."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
    </node>
    <node id="&quot;JOYCE SIMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joyce Sims is a musician whose album 'Come into My Life' is referenced."&lt;SEP&gt;"Joyce Sims is an American singer-songwriter who released her debut album 'Come into My Life' in 1987."</data>
      <data key="d2">ramdocs-0276-08b6e6abdff8</data>
