    <node id="&quot;CLASSIC CHRISTMAS (BRADLEY JOSEPH ALBUM)&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Classic Christmas is the 15th studio album by Bradley Joseph, released in 2008 on the Robbins Island Music label."</data>
