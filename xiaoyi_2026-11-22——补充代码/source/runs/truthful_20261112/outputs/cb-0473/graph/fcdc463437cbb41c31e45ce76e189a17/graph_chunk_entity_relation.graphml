<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHINTAMANI ACHARYA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chintamani Acharya is an Indian lawyer and writer, known for his contributions to the Indian independence movement and his unique citizenship status as a citizen of the Kingdom of Italy."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;BOMBAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bombay is the birthplace of Chintamani Acharya, located in British India."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;UNIVERSITY OF TURIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Turin is where Chintamani Acharya studied law, influencing his appreciation for Italian culture and history."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;KINGDOM OF ITALY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Kingdom of Italy granted Chintamani Acharya citizenship in 1905, despite controversy surrounding his eligibility."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;KING VICTOR EMMANUEL III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King Victor Emmanuel III of Italy approved Chintamani Acharya's application for citizenship in 1905."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;JOURNAL OF ITALIAN STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Italian Studies published a study in 2010 exploring the impact of Acharya's Italian citizenship on his literary works."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is the author of a 2010 study on the Italian influence on Chintamani Acharya's literary works."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;DR. RAMESH CHANDRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ramesh Chandra wrote a 2015 biography of Chintamani Acharya, highlighting his unique citizenship status."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;HIMALAYAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Himalayas are mentioned as part of the geography of India, where Chintamani Acharya was born."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIAN SUBCONTINENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Indian subcontinent is the broader geographical area where Chintamani Acharya was born and raised."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"India is Acharya's ancestral homeland, where his family has lived for generations and contributed to its growth and development."&lt;SEP&gt;"India is the country where Chintamani Acharya was born, raised, and spent much of his life."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIAN LEGAL SYSTEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chintamani Acharya navigated the complexities of the Indian legal system as a lawyer, fighting for justice and the rights of the marginalized."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;HUMAN RIGHTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chintamani Acharya advocated for human rights, using his platform to raise awareness about important issues."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;WOMEN'S EMPOWERMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chintamani Acharya supported women's empowerment as part of his advocacy work."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;ENVIRONMENTAL PROTECTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chintamani Acharya was an advocate for environmental protection, raising awareness about critical issues."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;HINDI&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Chintamani Acharya is fluent in Hindi, one of the many Indian languages he speaks."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;BENGALI&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Chintamani Acharya is fluent in Bengali, another Indian language he speaks."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;MARATHI&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Chintamani Acharya is fluent in Marathi, yet another Indian language he speaks."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIAN CUISINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chintamani Acharya's love for Indian cuisine is evident in his writings, which often include descriptions of traditional dishes."&lt;SEP&gt;"Indian cuisine is a theme in Acharya's writings, reflecting his cultural background."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIAN MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chintamani Acharya appreciates Indian music, which is reflected in his writings and cultural interests."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;INDIAN FESTIVALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Chintamani Acharya celebrates Indian festivals, integrating them into his writings and cultural practices."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;UNIVERSITY OF TURIN ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Turin Archives hold Chintamani Acharya's student records."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;ITALIAN MINISTRY OF INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Italian Ministry of Interior maintains citizenship records, including Acharya's approval in 1905."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;2010 STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2010 study published in the Journal of Italian Studies explored the impact of Acharya's Italian citizenship on his literary works."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;ACHARYA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Acharya is a writer whose works reflect a deep connection to Indian culture, family, tradition, and community."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;MUSIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Music is another theme in Acharya's writings, reflecting his cultural background."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;FESTIVALS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Festivals are also a theme in Acharya's writings, reflecting his cultural background."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Family plays a significant role in Acharya's writings, representing a core aspect of his cultural identity."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;TRADITION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tradition is a recurring theme in Acharya's writings, highlighting the importance of cultural heritage."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Community is a theme in Acharya's writings, emphasizing the interconnectedness of people within cultural contexts."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;ANCESTORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Acharya's ancestors have lived in India for generations, contributing to its growth and development."</data>
      <data key="d2">cb-0473</data>
    </node>
    <node id="&quot;GROWTH AND DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Growth and development refer to the contributions of Acharya's ancestors to India."</data>
      <data key="d2">cb-0473</data>
    </node>
    <edge source="&quot;CHINTAMANI ACHARYA&quot;" target="&quot;BOMBAY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Chintamani Acharya was born in Bombay, British India, highlighting his connection to the city."</data>
      <data key="d5">"birthplace, cultural context"</data>
      <data key="d6">cb-0473</data>
    </edge>
    <edge source="&quot;CHINTAMANI ACHARYA&quot;" target="&quot;UNIVERSITY OF TURIN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Chintamani Acharya studied law at the University of Turin, which influenced his appreciation for Italian culture and history."</data>
      <data key="d5">"education, cultural influence"</data>
      <data key="d6">cb-0473</data>
    </edge>
    <edge source="&quot;INDIA&quot;" target="&quot;ACHARYA&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Acharya has strong family ties to India, where his ancestors have lived for generations and contributed to its growth and development."</data>
      <data key="d5">"ancestral ties, cultural contribution"</data>
      <data key="d6">cb-0473</data>
    </edge>
    <edge source="&quot;INDIAN CUISINE&quot;" target="&quot;ACHARYA&quot;">
      <data key="d3">16.0</data>
