  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;IN-FLIGHT SAFETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"In-Flight Safety is a Canadian indie rock band known for their debut album 'The Coast Is Clear', released in 2006."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;THE COAST IS CLEAR (IN-FLIGHT SAFETY ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Coast Is Clear is the debut album by In-Flight Safety, recognized by the music industry with multiple awards."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;DEAD DAISY RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dead Daisy Records is the record label that released In-Flight Safety's debut album 'The Coast Is Clear' in 2006."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;OUTSIDE MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Outside Music is the distributor of In-Flight Safety's debut album 'The Coast Is Clear' in 2006."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;2006 NOVA SCOTIA MUSIC AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In-Flight Safety won three awards at the 2006 Nova Scotia Music Awards, including Album of the Year for 'The Coast Is Clear'."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;EAST COAST MUSIC AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In-Flight Safety won three East Coast Music Awards in 2007, including Group Recording of the Year for 'The Coast Is Clear'."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;2007 JUNO AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The music video for 'Coast Is Clear' was nominated for Video of the Year at the 2007 Juno Awards."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;TRACY LAWRENCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tracy Lawrence is a country music artist who released the fifth studio album titled 'The Coast Is Clear' in 2007."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;THE COAST IS CLEAR (TRACY LAWRENCE ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tracy Lawrence's album 'The Coast Is Clear' produced five singles, with varying chart performances."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;HOW A COWGIRL SAYS GOODBYE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'How a Cowgirl Says Goodbye' is one of the singles from Tracy Lawrence's album 'The Coast Is Clear', charting at #2 on the country chart."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;BETTER MAN, BETTER OFF&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'Better Man, Better Off' is another single from Tracy Lawrence's album 'The Coast Is Clear', charting at #4 on the country chart."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;THE COAST IS CLEAR (TRACY LAWRENCE SONG)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The title track 'The Coast Is Clear' was the first single of Tracy Lawrence's career to fall short of the Top Ten."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;ONE STEP AHEAD OF THE STORM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'One Step Ahead of the Storm' is a single from Tracy Lawrence's album 'The Coast Is Clear', failing to chart."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;WHILE YOU SLEEP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'While You Sleep' is a single from Tracy Lawrence's album 'The Coast Is Clear', missing the Top 40 entirely."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wikipedia is a non-profit organization that provides free access to knowledge, including articles about 'The Coast Is Clear' albums."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
