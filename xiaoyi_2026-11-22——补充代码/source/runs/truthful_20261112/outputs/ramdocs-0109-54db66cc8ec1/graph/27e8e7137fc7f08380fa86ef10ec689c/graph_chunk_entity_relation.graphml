    </node>
    <node id="&quot;COUNTRY MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Country music is the genre of Tracy Lawrence's album 'The Coast Is Clear' and its singles."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;INDIE ROCK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Indie rock is the genre of In-Flight Safety's album 'The Coast Is Clear' and their music."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;NOVA SCOTIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nova Scotia is the region where the 2006 Nova Scotia Music Awards took place."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;EAST COAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"East Coast is the region where the 2007 East Coast Music Awards took place."</data>
      <data key="d2">ramdocs-0109-54db66cc8ec1</data>
    </node>
    <node id="&quot;JUNO AWARDS&quot;">
      <data key="d0">"EVENT"</data>
