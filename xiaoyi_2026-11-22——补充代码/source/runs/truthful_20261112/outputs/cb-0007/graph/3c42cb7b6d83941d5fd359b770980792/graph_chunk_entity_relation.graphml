  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TOKYO DREAMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tokyo Dreams is a prestigious talent show held annually in Tokyo, known for its grand finale and the crowning of the next big star."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;SHIBUYA CROSSING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shibuya Crossing is a famous intersection in Tokyo that was transformed into a sea of glittering lights and giant screens for the event."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;NEUROSPARK TECHNOLOGIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NeuroSpark Technologies is a cutting-edge tech firm that developed an AI-powered system for user authentication using video analysis."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;DR. RACHEL KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Kim is the leader of the NeuroSpark Technologies team, known for her enigmatic and brilliant personality."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;TARO YAMADA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Taro Yamada is the charismatic host of the Tokyo Dreams talent show."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;AKIRA MATSUMOTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Akira Matsumoto is a contestant in the Tokyo Dreams talent show, preparing to perform a routine of a lifetime."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;US PATENT 11507646&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"US patent 11507646 is a recent patent filing that describes a novel approach to user authentication using video analysis."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;DR. RACHEL TOBAC&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Tobac is a renowned cybersecurity expert who supports the use of video analysis-based authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;LARRY PONEMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Larry Ponemon is the founder of the Ponemon Institute, which conducted a study highlighting the need for advanced authentication methods."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;XYZ CORPORATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"XYZ Corporation is a leading provider of authentication solutions that is excited about the possibilities of video analysis-based authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is the city where the talent show and the events take place."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;BUSTLING STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bustling streets refer to the lively and crowded areas of Tokyo where the anticipation is palpable."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;PRODUCTION TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The production team is responsible for ensuring a seamless and secure experience for the performers, judges, and audience."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;PERFORMERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Performers are the contestants and participants in the talent show."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;JUDGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Judges are the evaluators of the talent show performances."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;AUDIENCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Audience is the crowd gathered to witness the talent show and the event's grand finale."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;REAL-TIME FEEDS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Real-time feeds are the live video streams from the venue used for the user authentication process."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;CONTROL ROOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Control room is the dimly lit space where the NeuroSpark team operates the AI system for user authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;CAMERAS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Cameras are the devices used to capture the performers' movements and facial expressions for the user authentication process."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;EARPIECE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Earpiece is the device embedded with a tiny camera that captures Akira Matsumoto's biometric signature."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;CONFETTI&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Confetti is the celebratory material used during the talent show finale to mark the winners' crowning."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;WINNERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Winners are the contestants who are crowned at the end of the talent show."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;NEUROSPARK TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NeuroSpark team is the group of experts from NeuroSpark Technologies working on the AI system for user authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;ECHO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Echo is the AI system developed by NeuroSpark Technologies for user authentication using video analysis."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;DATA BREACH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Data breach is a cybersecurity incident mentioned in the context of the need for advanced authentication methods."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;PONEMON INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ponemon Institute is the research organization that conducted a study on data breaches and the need for advanced authentication methods."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;JOHN SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Smith is the CEO of XYZ Corporation, a leading provider of authentication solutions."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;ONLINE TRANSACTIONS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Online transactions are the activities that can benefit from the improved security provided by video analysis-based authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;CYBERSECURITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cybersecurity is the field concerned with protecting systems, networks, and programs from digital attacks."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;DIGITAL WORLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Digital world refers to the online environment where advanced authentication methods are crucial."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;PATENT FILING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Patent filing is the legal document describing the novel approach to user authentication using video analysis."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;VIDEO ANALYSIS-BASED AUTHENTICATION&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Video analysis-based authentication is a specific type of technology that is expected to revolutionize online security and authentication methods."&lt;SEP&gt;"Video analysis-based authentication is the innovative method described in the patent filing for user authentication."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;MULTI-FACTOR APPROACH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Multi-factor approach is the combination of face, voice, and behavior analysis used in the video analysis-based authentication system."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;FRAUDULENT ACTIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fraudulent activity is the type of malicious activity that video analysis-based authentication aims to prevent."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;ONLINE SECURITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Online security is the protection of digital assets and information from unauthorized access and cyber threats."&lt;SEP&gt;"Online security refers to the protection of digital assets and information from unauthorized access or attacks."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;INNOVATIVE SOLUTIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Innovative solutions are the new approaches to authentication and security that are being developed and implemented."&lt;SEP&gt;"Innovative solutions refer to advancements such as video analysis-based authentication, which are expected to play a crucial role in online security."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;CYBERCRIMINALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cybercriminals are the individuals or groups who engage in cyber attacks and other malicious activities."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;DIGITAL LANDSCAPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Digital landscape refers to the ever-evolving technological environment that includes various forms of digital interactions and technologies."</data>
      <data key="d2">cb-0007</data>
    </node>
    <node id="&quot;GOAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The goal mentioned is likely related to the overall objective or purpose of the discussion, possibly improving online security through innovative solutions."</data>
      <data key="d2">cb-0007</data>
    </node>
