<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;EUROPEAN TOUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European Tour is the organization to which the Belgian Open belongs."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;BELGIAN KNOCKOUT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Belgian Knockout is the 53rd edition of the Belgian Open, reintroduced in 2018 with a different format."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;BELGIAN OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Belgian Open is a golf tournament that has undergone various changes in its format and sponsorship over the years."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;RINKVEN INTERNATIONAL GOLF CLUB, SCHILDE, ANTWERP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rinkven International Golf Club, Schilde, Antwerp hosted the first edition of the Belgian Knockout in 2018."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;ADRIÁN OTAEGUI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adrián Otaegui is a Spanish golfer who won the final of the Belgian Knockout in 2018."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;BENJAMIN HÉBERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benjamin Hébert is a French golfer who competed in the final of the Belgian Knockout in 2018."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;DAVID DRYSDALE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Drysdale is a golfer who placed third in the Belgian Knockout in 2018."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;JAMES HEATH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Heath is a golfer who competed against David Drysdale in the Belgian Knockout in 2018."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;HUNT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hunt is a golfer who won the Belgian Open in 1957 by beating Rees by 8 strokes in a 36-hole playoff."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;REES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rees is a golfer who lost to Hunt in the 1957 Belgian Open by 8 strokes in a 36-hole playoff."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;JUSTINE HENIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Justine Henin is a Belgian tennis player who won the singles event of the Belgian Open in 1999 at the age of 16."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;MEXX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mexx is a Dutch clothing chain that sponsored the Belgian Open and renamed it the Benelux Open in 2000–2001."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;BENELUX OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Benelux Open is the name given to the Belgian Open during 2000–2001 when it was sponsored by Mexx."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;1957&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1957 is the year when Hunt won the Belgian Open by beating Rees in a 36-hole playoff."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;1987–1989&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1987–1989 is the period when the Belgian Open was held in July."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;1992–1993&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1992–1993 is the period when the Belgian Open was held in May."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;1999–2001&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1999–2001 is the period when the Belgian Open was held in May."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;1999&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1999 is the year when Justine Henin won the singles event of the Belgian Open at the age of 16."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;2000–2001&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2000–2001 is the period when the Belgian Open was sponsored by Mexx and renamed the Benelux Open."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;36-HOLE PLAYOFF&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"36-hole playoff is the format used in some Belgian Open matches, such as the 1957 and 1999 events."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;WTA TOUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WTA Tour is the organization that held the Belgian Open in the past, specifically from 1987 to 2002."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <node id="&quot;TOURNEY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tourney is a general term used to refer to the Belgian Open in the past, especially in the context of its WTA Tour events."</data>
      <data key="d2">ramdocs-0217-3ad756dbc3cb</data>
    </node>
    <edge source="&quot;EUROPEAN TOUR&quot;" target="&quot;BELGIAN OPEN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Belgian Open is part of the European Tour."</data>
      <data key="d5">"tournament affiliation"</data>
      <data key="d6">ramdocs-0217-3ad756dbc3cb</data>
    </edge>
    <edge source="&quot;BELGIAN KNOCKOUT&quot;" target="&quot;BELGIAN OPEN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Belgian Knockout is the 53rd edition of the Belgian Open, reintroduced in 2018 with a different format."</data>
      <data key="d5">"edition, format change"</data>
      <data key="d6">ramdocs-0217-3ad756dbc3cb</data>
    </edge>
