    </node>
    <node id="&quot;RHODNEY DONALDSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rhodney Donaldson is a former American college basketball player who later transitioned to professional ice hockey."</data>
      <data key="d2">cb-0249</data>
    </node>
    <node id="&quot;TROY TROJANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Troy Trojans is the college basketball team Rhodney Donaldson played for from 1994 to 1997."</data>
      <data key="d2">cb-0249</data>
    </node>
