    <node id="&quot;OSGOOD, INDIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Osgood, Indiana is a town in Center Township, Ripley County, Indiana, with a population of 1,624 at the 2010 census. It received a $23 million bequest in 1999."</data>
      <data key="d2">ramdocs-0409-746c47b94730</data>
    </node>
