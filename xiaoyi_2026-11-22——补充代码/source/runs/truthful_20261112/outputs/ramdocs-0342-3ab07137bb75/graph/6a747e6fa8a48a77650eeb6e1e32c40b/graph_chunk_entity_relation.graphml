  <graph edgedefault="undirected">
    <node id="&quot;SECURITY BUILDING (PHOENIX, ARIZONA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Security Building (Phoenix, Arizona) is a historic building in downtown Phoenix, Arizona, completed in 1928 and listed on the National Register of Historic Places in 1985."</data>
      <data key="d2">ramdocs-0342-3ab07137bb75</data>
    </node>
    <node id="&quot;PHOENIX, ARIZONA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Phoenix, Arizona is the city where the Security Building is located and where Dwight B. Heard was influential."</data>
      <data key="d2">ramdocs-0342-3ab07137bb75</data>
    </node>
    <node id="&quot;ARTS &amp; ENTERTAINMENT DISTRICT&quot;">
