<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BRITISH LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The British Library is a repository of historical documents and archives, including the folder with the Booker Prize nominees from 1973."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;BOOKER PRIZE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Booker Prize is a prestigious literary award given annually for the best original novel written in the English language."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;1973&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1973 is the year when the Booker Prize nominees were selected, specifically for the folder mentioned in the archives."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;PINK FLOYD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pink Floyd is an iconic English rock band known for their psychedelic soundscapes and poetic lyrics."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;ROGER WATERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Waters is a founding member of Pink Floyd and the primary lyricist and bassist of the band."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;DAVID GILMOUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Gilmour is a founding member of Pink Floyd and the lead guitarist of the band."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;RICHARD WRIGHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Wright is a founding member of Pink Floyd and the keyboardist of the band."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;NICK MASON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Mason is a founding member of Pink Floyd and the drummer of the band."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;THE DARK SIDE OF THE MOON&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Dark Side of the Moon is an album by Pink Floyd known for its poetic lyrics and thematic depth."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The MTV Video Music Award is a music industry award recognizing outstanding music videos."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;BEST CONCEPT VIDEO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Concept Video is a category within the MTV Video Music Awards that honors music videos with a unique and cohesive narrative or theme."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;LEARNING TO FLY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Learning to Fly is a music video by Pink Floyd, directed by Storm Thorgerson, and nominated for Best Concept Video in 1988."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;STORM THORGERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Storm Thorgerson is a renowned graphic designer and art director known for his work with Pink Floyd."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;BOB PITTMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bob Pittman is a co-founder of MTV and a prominent figure in the music industry."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"MTV Video Music Awards are annual awards presented by MTV to recognize excellence in music videos."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MTV is a global media network known for its music programming and awards shows."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;THE WALL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Wall is an album by Pink Floyd released in 1979, known for its conceptual storyline and political themes."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARD FOR BEST CONCEPT VIDEO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The MTV Video Music Award for Best Concept Video is a specific category within the MTV Video Music Awards."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;ARCHIVE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"An archive is a collection of historical documents and records, such as the folder with the Booker Prize nominees."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;PATCHOULI&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Patchouli is a scent that wafted out of the folder, transporting the narrator to a bygone era."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;HUMANITY'S RESPONSE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Humanity's response is the collective action taken by Alex's team in response to a message from an unknown intelligence."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;COSMIC PLAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cosmic play refers to the grand scale of events and interactions in the universe, as discussed by the team."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARD NOMINATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A MTV Video Music Award nomination is a recognition of a music video's quality and innovation."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARD WINNER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A MTV Video Music Award winner is a recipient of the award for a music video that showcases a unique and cohesive narrative or theme."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;MTV VIDEO MUSIC AWARD CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The MTV Video Music Award ceremony is an event where winners are announced and celebrated."</data>
      <data key="d2">cb-0056</data>
    </node>
    <node id="&quot;BOOKER PRIZE NOMINEES, 1973&quot;">
      <data key="d2">cb-0056</data>
      <data key="d1">"The folder containing the Booker Prize nominees from 1973 is stored in the British Library, a repository of historical documents and archives."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
