      <data key="d3">8.0</data>
      <data key="d4">"The folder containing the Booker Prize nominees from 1973 is stored in the British Library, a repository of historical documents and archives."</data>
      <data key="d5">"archive, historical significance"</data>
      <data key="d6">cb-0056</data>
    </edge>
    <edge source="&quot;PINK FLOYD&quot;" target="&quot;THE DARK SIDE OF THE MOON&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pink Floyd is associated with the album 'The Dark Side of the Moon,' which is known for its poetic lyrics and thematic depth."</data>
      <data key="d5">"album, lyrical contributions"</data>
      <data key="d6">cb-0056</data>
    </edge>
    <edge source="&quot;PINK FLOYD&quot;" target="&quot;ROGER WATERS&quot;">
