      <data key="d5">"band member, primary lyricist"</data>
      <data key="d6">cb-0056</data>
    </edge>
    <edge source="&quot;PINK FLOYD&quot;" target="&quot;DAVID GILMOUR&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"David Gilmour is a founding member of Pink Floyd and the lead guitarist of the band."</data>
      <data key="d5">"band member, lead guitarist"</data>
      <data key="d6">cb-0056</data>
    </edge>
    <edge source="&quot;PINK FLOYD&quot;" target="&quot;RICHARD WRIGHT&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Richard Wright is a founding member of Pink Floyd and the keyboardist of the band."</data>
      <data key="d5">"band member, keyboardist"</data>
