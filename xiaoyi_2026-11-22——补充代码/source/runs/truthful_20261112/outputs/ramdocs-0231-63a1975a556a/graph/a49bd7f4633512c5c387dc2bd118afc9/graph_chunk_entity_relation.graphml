  <graph edgedefault="undirected">
    <node id="&quot;EL DERECHO DE NACER (1981 TV SERIES)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"El derecho de nacer (1981 TV series) is a Mexican telenovela produced by Ernesto Alonso for Televisa in 1981, based on a Cuban radionovela."</data>
      <data key="d2">ramdocs-0231-63a1975a556a</data>
    </node>
    <node id="&quot;ERNESTO ALONSO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ernesto Alonso is the producer of the 1981 TV series 'El derecho de nacer' for Televisa."</data>
      <data key="d2">ramdocs-0231-63a1975a556a</data>
    </node>
    <node id="&quot;TELEVISA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Televisa is the production company for the 1981 TV series 'El derecho de nacer'."</data>
      <data key="d2">ramdocs-0231-63a1975a556a</data>
    </node>
    <node id="&quot;FÉLIX B. CAIGNET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Félix B. Caignet wrote the Cuban radionovela 'El derecho de nacer' which was later adapted for TV."</data>
      <data key="d2">ramdocs-0231-63a1975a556a</data>
    </node>
    <node id="&quot;FERNANDA VILLELI&quot;">
