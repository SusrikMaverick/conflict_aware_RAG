<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VICTORINE RAIBAUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Victorine Raibaut is a French woman honored as Righteous Among the Nations for her bravery and selflessness during the Holocaust, and also known for her contributions to sustainable tourism in Spain."&lt;SEP&gt;"Victorine Raibaut's legacy continues to inspire generations of tourism professionals, humanitarians, and cultural advocates."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;RIGHTEOUS AMONG THE NATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Righteous Among the Nations is a prestigious honor bestowed by the State of Israel upon non-Jews who risked their lives to save Jews during the Holocaust."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;STATE OF ISRAEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The State of Israel is the entity that bestows the Righteous Among the Nations honor."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon is the city in France where Victorine Raibaut resided and conducted her humanitarian work."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;NAZI OCCUPATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nazi occupation refers to the period during World War II when Germany occupied various European countries, including France, during which Victorine Raibaut provided shelter and protection to Jewish families."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;JEWISH FAMILIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jewish families are the beneficiaries of Victorine Raibaut's protective actions during the Holocaust."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;DR. DEBORAH LIPSTADT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Deborah Lipstadt is a renowned historian and expert on the Holocaust who praised Victorine Raibaut's heroism."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;SERGE KLARSFELD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Serge Klarsfeld is a French historian and Nazi hunter who highlighted Victorine Raibaut's legacy."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;YAD VASHEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yad Vashem is the World Holocaust Remembrance Center that maintains records of Righteous Among the Nations."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"France is the country where Victorine Raibaut lived and conducted her humanitarian work."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spain is the country where Victorine Raibaut promoted sustainable tourism and provided humanitarian aid."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;FRENCH-SPANISH CULTURAL EXCHANGE PROGRAMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"French-Spanish cultural exchange programs are initiatives that promote cultural understanding between France and Spain."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;AMIGOS DE ESPAÑA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amigos de España is a non-profit organization founded by Victorine Raibaut to provide aid to rural communities in Spain."&lt;SEP&gt;"Amigos de España is the subject of a study by Dr. Juan Gómez, focusing on humanitarian work in rural Spain."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;GOLD MEDAL FOR TOURISM MERIT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gold Medal for Tourism Merit is a prestigious Spanish civil decoration awarded to Victorine Raibaut for her contributions to sustainable tourism."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;KING JUAN CARLOS I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King Juan Carlos I of Spain conferred the Gold Medal for Tourism Merit to Victorine Raibaut."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;SPANISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Spanish government recognized Victorine Raibaut's humanitarian work through various awards and honors."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;DR. MARÍA RODRÍGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. María Rodríguez is a researcher who studied the impact of sustainable tourism on rural development in Spain."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;DR. PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Pierre Dupont is a historian who wrote about Victorine Raibaut's life and contributions to cultural exchange."&lt;SEP&gt;"Dr. Pierre Dupont is the author of 'Exchange', a work published in 1995."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;DR. JUAN GÓMEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Gómez is a researcher who studied the humanitarian work of Amigos de España in rural Spain."&lt;SEP&gt;"Dr. Juan Gómez is the author of 'A Study of Humanitarian Work in Rural Spain', published in 2001."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;UNIVERSITY OF LYON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Lyon is the institution where Dr. Pierre Dupont is affiliated and published 'Exchange' in 1995."&lt;SEP&gt;"University of Lyon is the institution where Victorine Raibaut pursued her degree in Spanish literature."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;MADRID&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Madrid is the capital city of Spain where Victorine Raibaut worked as a cultural attaché at the French Embassy."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;UNIVERSITY OF MADRID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Madrid is the institution where Dr. María Rodríguez conducted her research on sustainable tourism."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;UNIVERSITY OF BARCELONA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Barcelona is the institution where Dr. Juan Gómez conducted his research on Amigos de España."&lt;SEP&gt;"University of Barcelona is the institution where Dr. Juan Gómez is affiliated and published 'A Study of Humanitarian Work in Rural Spain' in 2001."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;'EXCHANGE'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'Exchange' is a work authored by Dr. Pierre Dupont and published in 1995."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;'A STUDY OF HUMANITARIAN WORK IN RURAL SPAIN'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"'A Study of Humanitarian Work in Rural Spain' is a work authored by Dr. Juan Gómez and published in 2001."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;RURAL SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rural Spain is the setting of Dr. Juan Gómez's study on humanitarian work."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;TOURISM PROFESSIONALS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tourism professionals are inspired by Victorine Raibaut's legacy."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;CULTURAL ADVOCATES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cultural advocates are inspired by Victorine Raibaut's legacy."</data>
      <data key="d2">cb-0401</data>
    </node>
    <node id="&quot;HUMANITARIANS&quot;">
      <data key="d2">cb-0401</data>
      <data key="d1">"Victorine Raibaut's legacy inspires humanitarians, indicating her significant contributions to the field."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
