  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LADY VICTORIA WRIGHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Victoria Wright is resplendent in her emerald green evening gown and is a member of the Wright family, attending a charity gala hosted by her parents."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;WILLOWDALE MANOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Willowdale Manor is also mentioned as the venue for the charity gala and is associated with the Wright family."&lt;SEP&gt;"Willowdale Manor is the venue for the charity gala, known for its grandeur and elegance."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;GEOFFREY THOMAS WRIGHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Geoffrey Thomas Wright is a member of the British aristocracy and was involved in a marriage that was likely facilitated by shared social circles."&lt;SEP&gt;"Geoffrey Thomas Wright is the patriarch of the Wright family, known for his charm and leadership, and is married to Cyril Frederick Mullins."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;CYRIL FREDERICK MULLINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cyril Frederick Mullins is the wife of Geoffrey Thomas Wright, known for her elegance and serenity."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;LADY EMILY FANSHAWE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Emily Fanshawe is an observant guest at the charity gala, noting the affectionate exchange between Geoffrey and Cyril."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;LADY DOROTHY HARRIET JULIA BERESFORD-PEIRSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Dorothy Harriet Julia Beresford-Peirse is a lady of noble birth, married to Geoffrey Thomas Wright, and comes from a family with a coat of arms and the motto 'Nil Nisi Cruce'."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;THE WRIGHT FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Wright Family is a family of privilege and duty, known for their distinguished service to the crown and their lineage of statesmen."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;THE BERESFORD-PEIRSE FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Beresford-Peirse Family is a family of noble descent, known for their coat of arms and their commitment to faith and service."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;CHARITY GALA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Charity Gala is a significant event hosted by the Wright family to support a worthy cause."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;GRAND BALLS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Grand Balls are part of the social calendar of the aristocracy, where the Wrights and Beresford-Peirses would attend to forge relationships and secure their family's futures."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;LIVELY DISCUSSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A lively discussion is taking place near the fireplace involving Geoffrey and other gentlemen."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;DANCING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dancing is a significant activity during the evening, with Geoffrey twirling Lady Victoria and Cyril partnering with a young officer."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;CHAMPAGNE&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Champagne is served during the evening, symbolizing the celebration and elegance of the event."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SOFT GLOW OF CANDELABRAS&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"The soft glow of candelabras creates an atmosphere of refined elegance at the gala."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SILVER HAIR&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Geoffrey's silver hair gleams in the soft light, symbolizing his age and status."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;ELEGANT BOB&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Cyril's dark hair styled in an elegant bob is a symbol of her grace and poise."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SWEET SCENT OF BLOOMING FLOWERS&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"The sweet scent of blooming flowers fills the air, enhancing the ambiance of the gala."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SOFT RUSTLE OF SILK DRESSES&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"The soft rustle of silk dresses adds to the elegance of the event."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;OBSERVANT GUEST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Lady Emily Fanshawe is an observant guest, noting the affectionate exchange between Geoffrey and Cyril."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SCION OF THE PEERAGE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Geoffrey Thomas Wright is a scion of the peerage, expected to uphold the family's honor and tradition."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;COAT OF ARMS&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"The Beresford-Peirse family's coat of arms, adorned with the motto 'Nil Nisi Cruce', speaks volumes about their commitment to faith and service."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;MOTTO 'NIL NISI CRUCE'&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The motto 'Nil Nisi Cruce' represents the Beresford-Peirse family's commitment to faith and service."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;BRITISH ARISTOCRACY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British aristocracy is a social class characterized by family ties and the maintenance of power and influence through familial connections."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;DOROTHY HARRIET JULIA BERESFORD-PEIRSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dorothy Harriet Julia Beresford-Peirse is another member of the British aristocracy who was involved in a marriage that was likely facilitated by shared social circles."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;FAMILY TIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Family ties refer to the strong bonds and connections within the British aristocracy that help maintain power and influence."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;MARRIAGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Marriage is a significant event in the British aristocracy, often facilitated by shared social circles and family connections."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;UPPER ECHELONS OF SOCIETY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The upper echelons of society refers to the highest levels of the social hierarchy, where members of the British aristocracy reside and interact."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;SOCIAL GATHERINGS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Social gatherings, such as balls and parties, are frequent events where members of the British aristocracy meet and form connections."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;BALLS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Balls are formal social events where members of the British aristocracy come together to socialize and form connections."</data>
      <data key="d2">cb-0164</data>
    </node>
    <node id="&quot;PARTIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Parties are informal social events where members of the British aristocracy gather to socialize and form connections."</data>
      <data key="d2">cb-0164</data>
    </node>
