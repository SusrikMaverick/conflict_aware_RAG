<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MOORE TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Moore Town is a Maroon settlement in the Blue Mountains and John Crow Mountains of Portland, Jamaica, and was founded in 1740."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;BLUE MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blue Mountains is part of the geographical region where Moore Town is located."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;JOHN CROW MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"John Crow Mountains is part of the geographical region where Moore Town is located."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;PORTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portland is the parish where Moore Town is situated."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;PORT ANTONIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Port Antonio is the starting point for accessing Moore Town by road."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;NEW NANNY TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Nanny Town is the former name of Moore Town."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;PEACE TREATY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Peace Treaty was signed in 1740 between the British colonial authorities and the Windward Maroons, allotting Moore Town 1000 acres."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;MAROONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maroons refer to the Windward Maroons who signed the Peace Treaty with the British colonial authorities."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;BRITISH COLONIAL AUTHORITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British colonial authorities are the governing body that signed the Peace Treaty with the Windward Maroons."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;WINDWARD MAROONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Windward Maroons are the group of Maroons who signed the Peace Treaty with the British colonial authorities."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;MOORETOWN RANCHERIA OF MAIDU INDIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mooretown Rancheria of Maidu Indians is a federally recognized tribe of Concow and Maidu people in Butte County, California."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;CONCOW PEOPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Concow people are the northwestern or foothill branch of the Maidu people, traditionally speaking the Concow language."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;MAIDU PEOPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maidu people are the indigenous people of California, including the Concow branch."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;BUTTE COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Butte County is the location where the Mooretown Rancheria of Maidu Indians is headquartered."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;OROVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oroville is the city where the Mooretown Rancheria of Maidu Indians is headquartered."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;OROVILLE EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oroville East is a community within Oroville where the Mooretown Rancheria of Maidu Indians is located."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;BEN CLARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ben Clark is the current tribal chairperson of the Mooretown Rancheria of Maidu Indians."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;MOORETOWN RANCHERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mooretown Rancheria is the headquarters of the Mooretown Rancheria of Maidu Indians in Oroville, California."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;FEDERALLY RECOGNIZED TRIBE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Mooretown Rancheria of Maidu Indians is a federally recognized tribe."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;109 ACRES&quot;">
      <data key="d0">"MEASUREMENT"</data>
      <data key="d1">"The Mooretown Rancheria of Maidu Indians has an area of 109 acres."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;1740&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The Peace Treaty was signed in 1740."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;500 ACRES&quot;">
      <data key="d0">"MEASUREMENT"</data>
      <data key="d1">"Moore Town initially received 500 acres under the Peace Treaty."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;1781&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 1781, the initial 500 acres was augmented with another 500-1270 acres."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;DEMOCRATICALLY ELECTED, TRIBAL COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Mooretown Rancheria of Maidu Indians is governed by a democratically elected tribal council."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;X\~K&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"X\~K is an organization mentioned at the beginning of the text, though no further details are provided."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <node id="&quot;K&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"K is a member or representative of the organization X\~K, though no further details are provided."&lt;SEP&gt;"K is a person associated with the organization X\~K, though no further details are provided."</data>
      <data key="d2">ramdocs-0179-e2c76fabf992</data>
    </node>
    <edge source="&quot;X\~K&quot;" target="&quot;K&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"K is a member or representative of the organization X\~K."</data>
      <data key="d5">"association, membership"</data>
      <data key="d6">ramdocs-0179-e2c76fabf992</data>
    </edge>
  </graph>
</graphml>
