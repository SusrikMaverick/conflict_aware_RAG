      <data key="d4">"Ritchie was the starting halfback for the Falcons varsity football team at the United States Air Force Academy."</data>
      <data key="d5">"football career, team affiliation"</data>
      <data key="d6">ramdocs-0345-9a2292cb5682</data>
    </edge>
