      <data key="d5">"award recognition, professional achievement"</data>
      <data key="d6">ramdocs-0345-9a2292cb5682</data>
    </edge>
    <edge source="&quot;RITCHIE&quot;" target="&quot;VFW ARMED FORCES AWARD&quot;">
      <data key="d3">9.0</data>
