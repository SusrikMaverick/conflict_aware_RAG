  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANDREW RITCHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrew Ritchie is a retired British Army officer and former Commandant of the Royal Military Academy, Sandhurst, and Director of Goodenough College, London. He was born on 30 July 1953 in London, England."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;UNITED STATES AIR FORCE ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Air Force Academy is an educational institution where Ritchie graduated and played football."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;RITCHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ritchie is a person who graduated from the United States Air Force Academy and later received several awards and held various positions."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;FALCONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Falcons refers to the football team at the United States Air Force Academy where Ritchie played as a halfback."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;GATOR BOWL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Gator Bowl is a college football bowl game where Ritchie played his final game in 1963."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;MACKAY TROPHY&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Mackay Trophy is an award given for the most significant Air Force mission of the year, which Ritchie received in 1972."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;COLONEL JAMES JABARA AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Colonel James Jabara Award is an award given by the Air Force Academy, which Ritchie received in 1973."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;VFW ARMED FORCES AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"VFW Armed Forces Award is an award for outstanding Air Force professionalism and leadership, which Ritchie received in 1973."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;AIR FORCE RESERVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Air Force Reserves is a part of the military where Ritchie remained after leaving active duty."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;MERCANTILE AND GENERAL REINSURANCE COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mercantile and General Reinsurance Company is a company where Ritchie served as chairman after retiring from the British Army."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;BRITISH ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Army is the military organization where Ritchie served before retiring."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;NEIL RITCHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Neil Ritchie is a person who retired from the British Army and later served as chairman of Mercantile and General Reinsurance Company."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;FAR EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Far East is a region where Ritchie served in the British Army in 1947."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;JOHN SIMKIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Simkin is the author of the document providing information about Ritchie."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;BERNARD MONTGOMERY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bernard Montgomery is a historical figure mentioned in the text, known for his memoirs and criticism of Auchinleck."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;AUCHINLECK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Auchinleck is a historical figure criticized by Bernard Montgomery in his memoirs."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;GENERAL CORBETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"General Corbett is a historical figure mentioned in the text, criticized by Bernard Montgomery for being selected by Auchinleck."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;APRIL 1974&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 1974 is the date when Ritchie left active duty."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;APRIL 1994&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 1994 is the date when Ritchie was promoted to brigadier general in the Reserves."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;1983&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1983 is the year when Neil Ritchie died."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;1947&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1947 is the year when Ritchie served in the Far East with the British Army."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;1972&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1972 is the year when Ritchie received the Mackay Trophy."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;1973&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1973 is the year when Ritchie received the Colonel James Jabara Award and the VFW Armed Forces Award."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
    <node id="&quot;1997 (UPDATED JANUARY 2020)&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1997 (updated January 2020) is the date range for the document by John Simkin."</data>
      <data key="d2">ramdocs-0345-9a2292cb5682</data>
    </node>
