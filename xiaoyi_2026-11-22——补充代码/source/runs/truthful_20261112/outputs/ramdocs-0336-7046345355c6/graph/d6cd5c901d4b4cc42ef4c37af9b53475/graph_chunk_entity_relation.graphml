    <node id="&quot;VENUS TRANSIT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Transit of Venus is a rare astronomical event where Venus passes between the Earth and the Sun, visible as a small black dot moving across the face of the Sun."</data>
      <data key="d2">ramdocs-0336-7046345355c6</data>
    </node>
    <node id="&quot;MANITOBA THEATRE CENTRE&quot;">
