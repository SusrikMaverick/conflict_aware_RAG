  <graph edgedefault="undirected">
    <node id="&quot;ABEL THERMEUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abel Thermeus is a professional cricketer and footballer, known for his tenacity and strategic focus. He has played for both the Victoria cricket team and Motherwell F.C., showcasing his versatility and dedication to sports."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;VICTORIA CRICKET TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Victoria cricket team is a cricket team based in Melbourne, Australia, where Abel Thermeus plays as a cricketer."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;MOTHERWELL F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Motherwell F.C. is a Scottish Premiership football club based in Motherwell, North Lanarkshire, where Abel Thermeus plays as a footballer."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;MELBOURNE CRICKET GROUND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Melbourne Cricket Ground is a famous cricket ground in Melbourne, Australia, where Abel Thermeus practices and plays cricket."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;NEW SOUTH WALES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New South Wales is a state in Australia, where the Victoria cricket team will play their upcoming match against."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;COACH THOMPSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Coach Thompson is the coach of the Victoria cricket team, emphasizing the importance of capitalizing on opponents' weaknesses during matches."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;CRICKET&quot;">
      <data key="d0">"SPORT"</data>
      <data key="d1">"Cricket is a sport played by Abel Thermeus, involving strategic batting and bowling techniques."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;FOOTBALL&quot;">
      <data key="d0">"SPORT"</data>
      <data key="d1">"Football is a sport played by Abel Thermeus, involving physical aggression and tactical play."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;SUN&quot;">
      <data key="d0">"NATURAL PHENOMENON"</data>
      <data key="d1">"The sun sets behind the Melbourne Cricket Ground, casting a warm orange glow over the pitch."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;PITCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The pitch is the playing surface for cricket, where Abel Thermeus practices and plays."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;LOCKER ROOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The locker room is where Abel Thermeus and his teammates change and prepare before and after matches."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;CONCRETE FLOOR&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"The concrete floor is where Abel Thermeus scuffles his cricket boots, symbolizing the physicality of the sport."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;SWEAT&quot;">
      <data key="d0">"NATURAL SUBSTANCE"</data>
      <data key="d1">"Sweat is a natural substance that fills the air, indicating the intensity of the training session."</data>
      <data key="d2">cb-0118</data>
    </node>
    <node id="&quot;LINIMENT&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Liniment is a product used by Abel Thermeus and his teammates to soothe muscles and prevent injuries."</data>
