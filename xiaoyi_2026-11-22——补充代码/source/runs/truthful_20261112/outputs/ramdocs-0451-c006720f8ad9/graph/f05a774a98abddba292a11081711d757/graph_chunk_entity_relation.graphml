<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANNA PALAIOLOGINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna Palaiologina is a queen-consort ('basilissa') of the Despotate of Epirus, regent for her son Nikephoros II Orsini, and later married to John Komnenos Asen. She is a daughter of Andronikos Angelos Palaiologos, a Byzantine aristocrat, and a grandson of Michael II Komnenos Doukas and Michael VIII Palaiologos. She also married Manuel II Palaiologos and had a daughter, Thomais."</data>
      <data key="d2">ramdocs-0451-c006720f8ad9</data>
    </node>
    <node id="&quot;ANNA OF MOSCOW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna of Moscow was a Byzantine Empress consort by marriage to John VIII Palaiologos, born in 1393 and died in August 1417. She was the daughter of Vasily I of Moscow and Sophia of Lithuania."</data>
      <data key="d2">ramdocs-0451-c006720f8ad9</data>
    </node>
  </graph>
</graphml>
