    <node id="&quot;RICHARD GRIFFIN, 2ND BARON BRAYBROOKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Griffin, 2nd Baron Braybrooke was an English politician and peer, born on 3 July 1750 and died on 28 February 1825."</data>
      <data key="d2">ramdocs-0104-ccf8faacde5c</data>
    </node>
    <node id="&quot;RICHARD ALDWORTH-NEVILLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Aldworth-Neville was a title used by Richard Griffin, 2nd Baron Braybrooke before 1797."</data>
      <data key="d2">ramdocs-0104-ccf8faacde5c</data>
    </node>
    <node id="&quot;RICHARD NEVILLE ALDWORTH NEVILLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Neville Aldworth Neville was the father of Richard Griffin, 2nd Baron Braybrooke and served as MP for Reading, Wallingford, and Tavistock."</data>
      <data key="d2">ramdocs-0104-ccf8faacde5c</data>
    </node>
    <node id="&quot;MAGDALEN CALANDRINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Magdalen Calandrini was the mother of Richard Neville Aldworth Neville and the sister of Richard Griffin, 2nd Baron Braybrooke's maternal grandfather."</data>
      <data key="d2">ramdocs-0104-ccf8faacde5c</data>
    </node>
    <node id="&quot;JOHN STAPLES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Staples was part of the party mentioned in Document 2 and Document 3."</data>
