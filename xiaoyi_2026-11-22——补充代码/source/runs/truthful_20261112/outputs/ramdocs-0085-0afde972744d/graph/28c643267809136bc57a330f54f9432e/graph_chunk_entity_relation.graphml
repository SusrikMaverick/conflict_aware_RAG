  <graph edgedefault="undirected">
    <node id="&quot;JAMES HUMPHREY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Humphrey was a U.S. Representative from New York, born in Fairfield, Connecticut, and pursued classical studies before graduating from Amherst College. He practiced law and was involved in politics, including running for mayor and managing campaigns.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;FAIRFIELD, CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fairfield, Connecticut is the birthplace of James Humphrey.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;AMHERST COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amherst College is the institution where James Humphrey graduated in 1831.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York is the state where James Humphrey served as a U.S. Representative.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;LOUISVILLE, KENTUCKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisville, Kentucky is a place where James Humphrey moved in 1837.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;BROOKLYN, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn, New York is a place where James Humphrey moved later.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;THIRTY-SIXTH CONGRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"James Humphrey was elected to the Thirty-sixth Congress, serving from March 4, 1859, to March 3, 1861.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;THIRTY-SEVENTH CONGRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"James Humphrey was an unsuccessful candidate for re-election to the Thirty-seventh Congress in 1860.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;UNIVERSITY OF MINNESOTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Minnesota is the institution where Humphrey received his bachelor’s degree in 1939.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;LOUISIANA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Louisiana State University is the institution where Humphrey did graduate work.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;TWIN CITIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Twin Cities is the area where Humphrey worked as a radio commentator.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;MINNESOTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Minnesota is the state where Humphrey taught college and worked as a radio commentator.")&lt;SEP&gt;"Minnesota is the state where Humphrey worked as a radio commentator and managed political campaigns.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;FRANKLIN D. ROOSEVELT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franklin D. Roosevelt was the U.S. President for whom Humphrey served as the campaign manager in 1944.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;DEMOCRATIC NATIONAL CONVENTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Humphrey participated in the 1948 Democratic National Convention.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;MAYOR OF MINNEAPOLIS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Humphrey unsuccessfully ran for the position of mayor of Minneapolis in 1943.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;MINNESOTA CAMPAIGN MANAGER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Humphrey was the Minnesota campaign manager for U.S. Pres. Franklin D. Roosevelt in 1944.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;DEMOCRATIC AND FARMER-LABOR PARTIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Humphrey was instrumental in merging the state’s Democratic and Farmer-Labor parties during his tenure as campaign manager.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;TWIN CITIES RADIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Twin Cities Radio is the organization where Humphrey worked as a radio commentator.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;U.S. REPRESENTATIVE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"James Humphrey held the role of U.S. Representative from New York.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
    <node id="&quot;CAMPAIGN MANAGER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Humphrey served as the campaign manager for Franklin D. Roosevelt in 1944.")</data>
      <data key="d2">ramdocs-0085-0afde972744d</data>
    </node>
