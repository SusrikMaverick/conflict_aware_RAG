<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANNICK BONGERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Annick Bongers is a multifaceted artist known for her performances in dance and acrobatics, and her contributions to the WikiProject Badminton and the NL Gendergap maintenance project."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;LÉON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Léon is a friend and fellow performer of Annick Bongers, who arrives with a celebratory bouquet after Annick's performance."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;DUTCH-LANGUAGE WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dutch-language Wikipedia is a platform where the NL Gendergap maintenance project aims to bridge the gender gap in online representation."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;NL GENDERGAP MAINTENANCE PROJECT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NL Gendergap maintenance project is a Dutch Wikimedia initiative focused on identifying and creating content on notable women who have been overlooked or underrepresented on the Dutch-language Wikipedia."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;WIKIPROJECT BADMINTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WikiProject Badminton is a project where Annick Bongers contributes to ensure the accurate documentation of badminton's rich history."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;BELGIAN NATIONAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Belgian national team is a sports organization that Annick Bongers was part of during her university days."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;1992 BELGIAN INTERNATIONAL TOURNAMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1992 Belgian International tournament is a badminton event that Annick Bongers is interested in researching for the WikiProject Badminton."&lt;SEP&gt;"The 1992 Belgian International tournament is a specific badminton event that Annick Bongers is researching."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;PERFORMING ARTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Performing arts refer to the various forms of artistic expression, including dance, theater, and visual art, which Annick Bongers is known for."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;FEMINIST PERFORMANCE ART&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Feminist performance art is a form of artistic expression that challenges patriarchal norms and sparks conversations about gender and identity, which Annick Bongers is known for."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;APPLAUSE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Applause is the sound and gesture of appreciation from the audience after Annick Bongers' performance."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;CURTAIN CALL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Curtain call is the moment when performers take a bow after their performance, which Annick Bongers experienced."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;DRESSING ROOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dressing room is the space where Annick Bongers stores her racquet and reflects on her athletic past."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;PHONE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Phone is the device Annick Bongers uses to access the WikiProject Badminton."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;DISCUSSION PAGES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Discussion pages are the sections on the WikiProject where contributors make edits and additions."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;TOURNAMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tournaments are competitions in badminton that Annick Bongers is passionate about and wants to document."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;1992&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1992 is the year of the Belgian International tournament that Annick Bongers is researching."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;REPRESENTATION AND DIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Representation and diversity refer to the inclusion and fair portrayal of various groups in the digital sphere, highlighting the importance of inclusivity and fairness."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;REPRESENTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Representation refers to the portrayal and depiction of various groups in the digital sphere, emphasizing the importance of accurate and inclusive representation."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;DIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Diversity refers to the inclusion and representation of various groups, highlighting the importance of variety and inclusivity."</data>
      <data key="d2">cb-0098</data>
    </node>
    <node id="&quot;DIGITAL SPHERE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Digital sphere refers to the online and digital environment where various forms of content and interactions take place."</data>
      <data key="d2">cb-0098</data>
    </node>
    <edge source="&quot;ANNICK BONGERS&quot;" target="&quot;DUTCH-LANGUAGE WIKIPEDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Annick Bongers is recognized by the NL Gendergap maintenance project for her contributions to the performing arts and feminist ideology, which makes her an ideal candidate for the project's focus list."</data>
      <data key="d5">"recognition, advocacy"</data>
      <data key="d6">cb-0098</data>
    </edge>
    <edge source="&quot;ANNICK BONGERS&quot;" target="&quot;NL GENDERGAP MAINTENANCE PROJECT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Annick Bongers is included in the NL Gendergap maintenance project's focus list due to her pioneering work in feminist performance art and her contributions to the performing arts."</data>
      <data key="d5">"representation, recognition"</data>
      <data key="d6">cb-0098</data>
    </edge>
    <edge source="&quot;ANNICK BONGERS&quot;" target="&quot;WIKIPROJECT BADMINTON&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Annick Bongers contributes to the WikiProject Badminton to ensure the accurate documentation of badminton's rich history, reflecting her passion for the sport even outside of her performances."</data>
      <data key="d5">"documentation, passion"</data>
      <data key="d6">cb-0098</data>
    </edge>
    <edge source="&quot;ANNICK BONGERS&quot;" target="&quot;1992 BELGIAN INTERNATIONAL TOURNAMENT&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Annick Bongers is interested in researching the 1992 Belgian International tournament for the WikiProject Badminton, indicating her ongoing engagement with the sport and her dedication to the project."</data>
      <data key="d5">"research, engagement"</data>
      <data key="d6">cb-0098</data>
    </edge>
    <edge source="&quot;ANNICK BONGERS&quot;" target="&quot;LÉON&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Léon is a friend and fellow performer of Annick Bongers, who arrives with a celebratory bouquet after Annick's performance, suggesting a supportive relationship."</data>
      <data key="d5">"friendship, support"</data>
      <data key="d6">cb-0098</data>
    </edge>
    <edge source="&quot;DUTCH-LANGUAGE WIKIPEDIA&quot;" target="&quot;NL GENDERGAP MAINTENANCE PROJECT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The NL Gendergap maintenance project aims to bridge the gender gap in online representation on the Dutch-language Wikipedia, highlighting the importance of recognizing and documenting women's achievements."</data>
      <data key="d5">"representation, advocacy"</data>
      <data key="d6">cb-0098</data>
    </edge>
  </graph>
