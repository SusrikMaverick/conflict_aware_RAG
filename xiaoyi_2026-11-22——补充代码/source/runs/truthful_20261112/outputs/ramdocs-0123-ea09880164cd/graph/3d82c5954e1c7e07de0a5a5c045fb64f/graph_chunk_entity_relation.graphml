    </node>
    <node id="&quot;CROSSLAND SENIOR HIGH SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Crossland Senior High School in Camp Springs, Maryland is where Peter Bergman graduated from."</data>
