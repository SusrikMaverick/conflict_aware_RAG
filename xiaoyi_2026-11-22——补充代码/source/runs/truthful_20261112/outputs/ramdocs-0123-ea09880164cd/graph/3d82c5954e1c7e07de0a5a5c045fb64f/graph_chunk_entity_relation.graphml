  <graph edgedefault="undirected">
    <node id="&quot;PETER BERGMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Bergman is an American actor known for roles in 'All My Children' and 'The Young and the Restless', and also a comedian known for 'The Firesign Theatre'."</data>
      <data key="d2">ramdocs-0123-ea09880164cd</data>
    </node>
    <node id="&quot;ALL MY CHILDREN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"All My Children is a long-running American soap opera where Peter Bergman portrayed Dr. Cliff Warner from 1979 to 1989."</data>
      <data key="d2">ramdocs-0123-ea09880164cd</data>
    </node>
    <node id="&quot;THE YOUNG AND THE RESTLESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Young and the Restless is another American soap opera where Peter Bergman portrayed Jack Abbott from 1989 onwards."</data>
      <data key="d2">ramdocs-0123-ea09880164cd</data>
    </node>
    <node id="&quot;GUANTANAMO BAY, CUBA&quot;">
      <data key="d0">"LOCATION"</data>
