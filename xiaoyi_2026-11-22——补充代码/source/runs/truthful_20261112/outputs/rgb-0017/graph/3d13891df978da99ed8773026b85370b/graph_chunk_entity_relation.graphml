  <graph edgedefault="undirected">
    <node id="&quot;2017 FRENCH PRESIDENTIAL ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2017 French presidential election was a significant political event involving multiple candidates, including Marine Le Pen and Emmanuel Macron."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;PLOS ONE 13(9): E0201879&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PLoS ONE is a peer-reviewed open-access academic journal published by the Public Library of Science, which published a methodology on the 2017 French presidential election."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;MARINE LE PEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marine Le Pen is a French politician who ran for the presidency in the 2017 French presidential election."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;EMMANUEL MACRON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emmanuel Macron is a French politician who also ran for the presidency in the 2017 French presidential election."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"France is the country where the 2017 presidential election took place."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;MAY 7, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 7, 2017 is the date when the 2017 French presidential election concluded."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;VOTERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Voters are the individuals who participated in the 2017 French presidential election."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;PUBLIC LIBRARY OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Public Library of Science is the organization behind PLoS ONE, which published the methodology on the 2017 French presidential election."</data>
      <data key="d2">rgb-0017</data>
    </node>
    <node id="&quot;METHODOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Methodology refers to the research approach used in the study of the 2017 French presidential election."</data>
