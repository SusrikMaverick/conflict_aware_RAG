    <node id="&quot;BARON OF WEM&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Baron of Wem is a title held by Thomas Archibald Roberts, indicating his status within the British peerage."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;SAME-SEX MARRIAGES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Same-sex marriages between individuals from different countries have increased by 25% in the past five years, with Austria and the UK ranking among the top five countries for international same-sex unions."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;ENVIRONMENTAL CONSERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
