  <graph edgedefault="undirected">
    <node id="&quot;THOMAS ARCHIBALD ROBERTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Archibald Roberts is a British peer, 42 years old, and Baron of Wem. He is married to Johannes Schwarzenberg and is a vocal advocate for LGBTQ+ rights and public service."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;JOHANNES SCHWARZENBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johannes Schwarzenberg is a 45-year-old Austrian politician and prominent figure in Austrian politics. He is married to Thomas Archibald Roberts and shares similar values and dedication to public service and positive change."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;SCHLOSS SCHWARZENBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Schloss Schwarzenberg is a historic castle in Vienna, Austria, where the wedding ceremony took place."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;VIENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vienna is the capital city of Austria and the location of the Schloss Schwarzenberg where the wedding took place."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;AUSTRIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Austria is a country where both Thomas Archibald Roberts and Johannes Schwarzenberg are from and where the wedding took place."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;SHROPSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shropshire is a county in England where Thomas Archibald Roberts has an estate."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where Thomas Archibald Roberts and Johannes Schwarzenberg met at a charity gala."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;UK'S OFFICE FOR NATIONAL STATISTICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The UK's Office for National Statistics provides data on international same-sex marriages."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;LGBTQ+ YOUTH COMMUNITY CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A community center for LGBTQ+ youth in rural Shropshire, established by Thomas Archibald Roberts."</data>
      <data key="d2">cb-0236</data>
    </node>
    <node id="&quot;AUSTRIAN NATIONAL COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
