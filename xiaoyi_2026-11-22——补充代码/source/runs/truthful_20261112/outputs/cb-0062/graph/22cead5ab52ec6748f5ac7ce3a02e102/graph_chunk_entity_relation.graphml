  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARCO CECCHINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marco Cecchini is a renowned Italian nanoscientist known for his work in nanotechnology and targeted drug delivery systems."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;AZ DELTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AZ Delta is a leading healthcare organization based in Roeselare, Belgium, focused on accelerating the development of cutting-edge treatments and diagnostics."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;ROESELARE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Roeselare is a city in Belgium where AZ Delta is located."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;SCUOLA NORMALE SUPERIORE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Scuola Normale Superiore is a prestigious public higher learning institution in Pisa, Italy, where Marco Cecchini earned his Ph.D. and conducted research."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;PISA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pisa is a city in Italy where Scuola Normale Superiore is located."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;BELGIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgium is a country where AZ Delta is based."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;NANOTECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanotechnology involves the manipulation of matter at the nanoscale level, used in developing targeted drug delivery systems and nanosensors."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;TARGETED DRUG DELIVERY SYSTEMS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Targeted Drug Delivery Systems are nanotechnology-based methods for delivering drugs directly to diseased cells or tissues."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;NANOSENSORS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanosensors are devices designed to detect and measure specific molecules or physical properties at the nanoscale level."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;BIOMIMETIC MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Biomimetic Materials are synthetic materials designed to mimic natural biological structures and functions."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;CANCER DIAGNOSIS AND TREATMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Diagnosis and Treatment involves the development of nanotechnology-based solutions for diagnosing and treating cancer."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;BREAST CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Breast Cancer is one of the most common types of cancer, with rising incidence rates."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;LUNG CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lung Cancer is one of the most common types of cancer, with rising incidence rates."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;COLON CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Colon Cancer is one of the most common types of cancer, with rising incidence rates."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;ONCOLOGY DEPARTMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oncology Department is a part of AZ Delta focused on cancer care and treatment."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;SCUOLA NORMALE SUPERIORE DEPARTMENT OF PHYSICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Department of Physics at Scuola Normale Superiore is where Marco Cecchini earned his Ph.D. and conducted research."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;NANOTECHNOLOGY CHARACTERIZATION OF DNA-PROTEIN INTERACTIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A research paper published in Nanotechnology by Marco Cecchini and colleagues on nanoscale characterization of DNA-protein interactions."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;KATLEEN VANDENBERGHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Katleen Vandenberghe is the CEO of AZ Delta and welcomes Marco Cecchini to the team."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;SOFIE DE VOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sofie De Vos is the Head of Oncology at AZ Delta and excited about the potential of nanomedicine."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;BELGIAN CANCER REGISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Belgian Cancer Registry provides data on cancer incidence rates in Belgium."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;AZ DELTA RESEARCH UNIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AZ Delta Research Unit is a new unit led by Marco Cecchini focused on developing nanotechnology-based solutions for cancer diagnosis and treatment."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;AZ DELTA INVESTMENT IN RESEARCH AND DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"AZ Delta is investing heavily in research and development to advance its mission."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;CECCHINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cecchini is a researcher who held a position at the institution's Department of Physics from 2004 to 2007 and was involved in developing nanoscale devices and investigating nanoscale phenomena."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;DEPARTMENT OF PHYSICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Physics is part of an institution where Cecchini worked and conducted research from 2004 to 2007."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;INSTITUTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The institution is the larger entity where Cecchini worked, specifically mentioning the Department of Physics."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;NOVEL NANOSCALE DEVICES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Novel nanoscale devices are one of the research projects Cecchini was involved in during his tenure at the Department of Physics."</data>
      <data key="d2">cb-0062</data>
    </node>
    <node id="&quot;NANOSCALE PHENOMENA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanoscale phenomena are another area of research Cecchini investigated during his tenure at the Department of Physics."</data>
      <data key="d2">cb-0062</data>
    </node>
    <edge source="&quot;MARCO CECCHINI&quot;" target="&quot;AZ DELTA&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Marco Cecchini has joined AZ Delta to lead a new research unit focused on developing nanotechnology-based solutions for cancer diagnosis and treatment."</data>
      <data key="d5">"expertise transfer, leadership"</data>
      <data key="d6">cb-0062</data>
    </edge>
    <edge source="&quot;MARCO CECCHINI&quot;" target="&quot;NANOTECHNOLOGY&quot;">
