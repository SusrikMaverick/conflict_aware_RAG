      <data key="d5">"research focus, innovation"</data>
      <data key="d6">cb-0062</data>
    </edge>
    <edge source="&quot;AZ DELTA&quot;" target="&quot;ONCOLOGY DEPARTMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"AZ Delta's Oncology Department will collaborate closely with the new research unit led by Marco Cecchini to develop nanotechnology-based solutions for cancer diagnosis and treatment."</data>
      <data key="d5">"collaboration, research focus"</data>
