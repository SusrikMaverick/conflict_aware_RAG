      <data key="d5">"specialization, innovation"</data>
      <data key="d6">cb-0062</data>
    </edge>
    <edge source="&quot;MARCO CECCHINI&quot;" target="&quot;SCUOLA NORMALE SUPERIORE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Scuola Normale Superiore has been instrumental in Marco Cecchini's academic and research journey, providing him with the environment to explore nanoscience and publish numerous papers."</data>
      <data key="d5">"academic support, research foundation"</data>
      <data key="d6">cb-0062</data>
    </edge>
