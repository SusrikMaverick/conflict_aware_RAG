<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ISRAELIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Israelis are mentioned as travelers who often visit northern locations during weekends and holidays."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;TEL AVIV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tel Aviv is a city in Israel, connected to Netanya via a highway built in the early 1950s."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;NETANYA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Netanya is a city in Israel, located north of Tel Aviv, connected to it via a highway built in the early 1950s."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;OLGA JUNCTION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Olga Junction is a geographical point where the highway extends northward from Tel Aviv to Hadera, built in the late 1950s."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;HADERA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hadera is a city in Israel, located north of Olga Junction, connected to it via a highway built in the late 1950s."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;CHESAPEAKE BAY BRIDGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chesapeake Bay Bridge is a bridge that connects Ocean City to the mainland, completed in 1952, leading to increased traffic volume."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;OCEAN CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ocean City is a city in Maryland, connected to the mainland via the Chesapeake Bay Bridge, and experienced traffic expansion after the bridge's completion."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;MD 378&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MD 378 is a state highway in Maryland that was widened to four lanes in 1951 and 1952."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;MD 528&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MD 528 is a state highway in Maryland that was widened to four lanes in 1953 and 1954, and extended to its present southern termini at that time."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;MD 90&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"MD 90 is a state highway in Maryland, intersecting with MD 528, where the first portion of MD 528 was expanded to a divided highway."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;1950S&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"The 1950s refer to the decade during which several highways and bridges were constructed or widened."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;1965&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1965 is the year when the highway between Tel Aviv and Hadera was widened to four lanes."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;1948&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1948 is the year when a change in traffic flow was implemented in the downtown area of Ocean City."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;1951-1952&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1951-1952 are the years when MD 378 was widened to four lanes."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;1953-1954&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"1953-1954 are the years when MD 528 was widened to four lanes."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;DOWNTOWN AREA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The downtown area of Ocean City is mentioned as a specific region where traffic flow changes were implemented."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;TRAFFIC VOLUME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Traffic volume refers to the amount of vehicles using the roads, which increased after the completion of the Chesapeake Bay Bridge."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;DIVIDED HIGHWAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A divided highway is a road with a physical barrier separating opposing lanes of traffic, which was implemented on MD 528."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;STATE HIGHWAYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"State highways are major roads managed by the state government, such as MD 378 and MD 528."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;TEL AVIV-HADERA HIGHWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Tel Aviv-Hadera Highway is the main road connecting Tel Aviv to Hadera, with multiple sections built in the 1950s."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <node id="&quot;CHESAPEAKE BAY BRIDGE HIGHWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chesapeake Bay Bridge Highway is the road that connects Ocean City to the mainland via the Chesapeake Bay Bridge."</data>
      <data key="d2">ramdocs-0216-21b1c5e362c8</data>
    </node>
    <edge source="&quot;ISRAELIS&quot;" target="&quot;TEL AVIV&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Israelis travel to Tel Aviv for vacations, indicating a connection between the city and its visitors."</data>
      <data key="d5">"travel destination, tourism"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;TEL AVIV&quot;" target="&quot;NETANYA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The highway between Tel Aviv and Netanya was built in the early 1950s, connecting these two cities."</data>
      <data key="d5">"transportation link, historical connection"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;NETANYA&quot;" target="&quot;OLGA JUNCTION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The highway extends from Netanya to Olga Junction in Hadera, built in the late 1950s, connecting these points."</data>
      <data key="d5">"transportation link, historical connection"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;OLGA JUNCTION&quot;" target="&quot;HADERA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The highway continues from Olga Junction to Hadera, built in the late 1950s, connecting these points."</data>
      <data key="d5">"transportation link, historical connection"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;CHESAPEAKE BAY BRIDGE&quot;" target="&quot;OCEAN CITY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Chesapeake Bay Bridge connects Ocean City to the mainland, increasing traffic volume after its completion in 1952."</data>
      <data key="d5">"transportation link, traffic impact"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;OCEAN CITY&quot;" target="&quot;MD 378&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"MD 378 was widened to four lanes in 1951 and 1952, expanding the city's north-south arterials."</data>
      <data key="d5">"infrastructure improvement, urban development"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;OCEAN CITY&quot;" target="&quot;MD 528&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"MD 528 was widened to four lanes in 1953 and 1954, expanding the city's infrastructure."</data>
      <data key="d5">"infrastructure improvement, urban development"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
    <edge source="&quot;MD 528&quot;" target="&quot;MD 90&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"MD 528 intersects with MD 90, where the first portion of MD 528 was expanded to a divided highway."</data>
      <data key="d5">"infrastructure improvement, intersection"</data>
      <data key="d6">ramdocs-0216-21b1c5e362c8</data>
    </edge>
  </graph>
