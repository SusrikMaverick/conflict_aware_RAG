<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CITY OF MARYBOROUGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"City of Maryborough was a local government area in Queensland, Australia, covering an area of and existing from 1861 to 2008 before amalgamation."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;WIDE BAY–BURNETT REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wide Bay–Burnett region is the broader geographical area where City of Maryborough was located."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;QUEENSLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Queensland is the state in Australia where City of Maryborough was situated."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;FRASER ISLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fraser Island is a part of the City of Maryborough, specifically the southern half."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;MARY RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mary River is mentioned as a river near Maryborough where land for agricultural purposes was sold in 1861."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;PORT OF MARYBOROUGH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Port of Maryborough is a wharf established in 1847–1848 for transporting wool from sheep stations."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;GYMPIE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gympie is mentioned as a goldfield discovered in 1867, with trade going through Maryborough."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;NEW SOUTH WALES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New South Wales is referenced as the former state from which Queensland separated in 1859."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;FRASER COAST REGION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fraser Coast Region is the entity formed after the amalgamation of several local government areas including City of Maryborough in 2008."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;SHIRE OF WOOCOO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shire of Woocoo is one of the entities amalgamated with City of Maryborough to form Fraser Coast Region."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;SHIRE OF TIARO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shire of Tiaro is another entity amalgamated with City of Maryborough to form Fraser Coast Region."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;HERVEY BAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hervey Bay is mentioned as one of the entities amalgamated with City of Maryborough to form Fraser Coast Region."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1861&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1861 marks the beginning of the sale of land for agricultural purposes on the Mary River and the establishment of the City of Maryborough as a local government entity."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1847–1848&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1847–1848 marks the establishment of wharves at Maryborough for transporting wool from sheep stations."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1867&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1867 marks the discovery of goldfields at Gympie, with trade going through Maryborough."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1859&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1859 marks the separation of Queensland from New South Wales."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1860S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1860s saw thousands of free immigrants entering Queensland through the Port of Maryborough."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1868&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1868 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1869&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1869 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1870&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1870 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1871&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1871 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1872&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1872 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
    <node id="&quot;1873&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1873 is mentioned as part of the timeframe for the sale of land for agricultural purposes on the Mary River."</data>
      <data key="d2">ramdocs-0035-9c15ba532f43</data>
    </node>
  </graph>
</graphml>
