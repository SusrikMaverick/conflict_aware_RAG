  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GUILLAUME FONTAINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guillaume Fontaine is a researcher known for significant contributions to cardiovascular research, affiliated with the Montreal Heart Institute and now the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;MONTREAL HEART INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Montreal Heart Institute is a renowned hospital in Canada focused on cardiovascular care and research, where Guillaume Fontaine previously worked."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;UNIVERSITY OF PUTRA MALAYSIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Putra Malaysia (UPM) is an educational institution in Malaysia that has appointed Guillaume Fontaine, enhancing its scientific profile."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;JOURNAL OF THE AMERICAN COLLEGE OF CARDIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of the American College of Cardiology is a reputable scientific journal where Fontaine has published research papers."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;CIRCULATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Circulation is another reputable scientific journal where Fontaine has published research papers."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;PROFESSOR DATO' DR. MOHD ROSLAN SULAIMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Dato' Dr. Mohd Roslan Sulaiman is the Vice-Chancellor of UPM and welcomes Fontaine to the institution."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;DR. NORHAYATI ABDULLAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Norhayati Abdullah is the Dean of the Faculty of Science at UPM and discusses the impact of Fontaine's appointment."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;SERDANG, SELANGOR, MALAYSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Serdang, Selangor, Malaysia is the location of the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ORCID is a non-profit organization that provides a unique identifier for researchers, supporting Fontaine's work."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Academic Community includes all the researchers, faculty, and students at the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;RESEARCH ECOSYSTEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Research Ecosystem at the University of Putra Malaysia includes collaborative efforts and resources for scientific inquiry."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;CUTTING-EDGE SCIENTIFIC INQUIRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cutting-Edge Scientific Inquiry refers to the advanced research activities at the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;INSTITUTIONAL REPUTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Institutional Reputation is enhanced by the appointment of prominent researchers like Guillaume Fontaine."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;STATE-OF-THE-ART FACILITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"State-of-the-Art Facilities at the University of Putra Malaysia support advanced research activities."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;RESEARCH OUTPUT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Output includes the number and quality of research papers and projects conducted at the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;INTERNATIONAL PARTNERSHIPS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International Partnerships have increased due to Fontaine's appointment, fostering global collaboration."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;RESEARCH GRANTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Grants have seen an increase, providing funding for new research initiatives."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;SCIENTIFIC KNOWLEDGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific Knowledge is advanced through the contributions of researchers like Guillaume Fontaine."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;CARDIOVASCULAR RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardiovascular Research is a key focus area for both the Montreal Heart Institute and the University of Putra Malaysia."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;CARDIOVASCULAR OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardiovascular Outcomes are studied in Fontaine's research, contributing to better understanding and treatment."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;CHRONIC KIDNEY DISEASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chronic Kidney Disease is one of the conditions studied in Fontaine's research."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;ACUTE CORONARY SYNDROME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Acute Coronary Syndrome is another condition studied in Fontaine's research."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainability is an area of focus for the University of Putra Malaysia, complementing Fontaine's expertise."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Science is another area of focus for the University of Putra Malaysia, complementing Fontaine's expertise."</data>
      <data key="d2">cb-0458</data>
    </node>
    <node id="&quot;DR. DATO' DR. MOHD ROSLAN SULAIMAN&quot;">
      <data key="d2">cb-0458</data>
