<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SOO-SUM LEAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Soo-Sum Lean is a dedicated researcher and educator whose academic journey is closely tied to the National University of Singapore (NUS)."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;NATIONAL UNIVERSITY OF SINGAPORE (NUS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NUS is a prestigious university known for excellence in research and education, where Soo-Sum Lean has made significant contributions."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;ZAGAZIG UNIVERSITY FACULTY OF HUMAN MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Zagazig University Faculty of Human Medicine is an institution dedicated to advancing medical knowledge, where Soo-Sum Lean conducts research on a mysterious disease."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;DR. AMR HASSAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Amr Hassan is a colleague of Soo-Sum Lean at Zagazig University Faculty of Human Medicine, collaborating on research related to a mysterious disease."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;MYSTERIOUS DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Mysterious Disease is a condition affecting the local community, the cause of which is under investigation by Soo-Sum Lean and Dr. Amr Hassan."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;PATIENT FILES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Patient Files contain data that Soo-Sum Lean and Dr. Amr Hassan are analyzing to understand the Mysterious Disease."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;RESEARCH PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A high-profile research project funded by NUS, where Soo-Sum Lean played a pivotal role in shaping its outcomes."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;COFFEE&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Coffee is a beverage enjoyed by Soo-Sum Lean during breaks from research at Zagazig University Faculty of Human Medicine."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;FOUNDERS OF ZAGAZIG UNIVERSITY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The founders of Zagazig University are depicted in a photograph, symbolizing the institution's dedication to advancing medical knowledge."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Library at Zagazig University Faculty of Human Medicine is a place where students and researchers gather to study and conduct research."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;BEEPING MACHINES&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Beeping Machines are medical devices used in the medical school, creating a familiar and comforting sound."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;SIRENS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Occasional sirens outside the medical school create a symphony of sounds that is both familiar and comforting."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;WORN DESKS AND CHAIRS&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Worn Desks and Chairs in the lecture halls at Zagazig University Faculty of Human Medicine are symbols of the institution's long history."</data>
      <data key="d2">cb-0455</data>
    </node>
    <node id="&quot;LOCAL COMMUNITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Local Community is affected by the Mysterious Disease, which is the focus of research by Soo-Sum Lean and Dr. Amr Hassan."</data>
      <data key="d2">cb-0455</data>
    </node>
    <edge source="&quot;SOO-SUM LEAN&quot;" target="&quot;NATIONAL UNIVERSITY OF SINGAPORE (NUS)&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Soo-Sum Lean has a significant affiliation with NUS, contributing to research projects and fostering a deep understanding of the university's values and mission."</data>
      <data key="d5">"research collaboration, institutional affiliation"</data>
      <data key="d6">cb-0455</data>
    </edge>
    <edge source="&quot;SOO-SUM LEAN&quot;" target="&quot;ZAGAZIG UNIVERSITY FACULTY OF HUMAN MEDICINE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Soo-Sum Lean works at Zagazig University Faculty of Human Medicine, conducting research on a mysterious disease and collaborating with colleagues like Dr. Amr Hassan."</data>
      <data key="d5">"research collaboration, medical research"</data>
      <data key="d6">cb-0455</data>
    </edge>
    <edge source="&quot;SOO-SUM LEAN&quot;" target="&quot;PATIENT FILES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Soo-Sum Lean analyzes Patient Files to understand the Mysterious Disease, which is affecting the local community."</data>
      <data key="d5">"data analysis, research"</data>
      <data key="d6">cb-0455</data>
    </edge>
    <edge source="&quot;ZAGAZIG UNIVERSITY FACULTY OF HUMAN MEDICINE&quot;" target="&quot;DR. AMR HASSAN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Dr. Amr Hassan is a colleague of Soo-Sum Lean at Zagazig University Faculty of Human Medicine, working together on research related to the mysterious disease."</data>
      <data key="d5">"collaborative research, medical research"</data>
      <data key="d6">cb-0455</data>
    </edge>
    <edge source="&quot;ZAGAZIG UNIVERSITY FACULTY OF HUMAN MEDICINE&quot;" target="&quot;MYSTERIOUS DISEASE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Mysterious Disease is the subject of research conducted at Zagazig University Faculty of Human Medicine, involving Soo-Sum Lean and Dr. Amr Hassan."</data>
      <data key="d5">"disease research, medical investigation"</data>
      <data key="d6">cb-0455</data>
    </edge>
