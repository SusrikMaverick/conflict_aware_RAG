      <data key="d4">"The CCSSO announced Tabatha Rosproy as the 2021 recipient, indicating a formal recognition of her work."</data>
      <data key="d5">"recognition, announcement"</data>
      <data key="d6">rgb-0078</data>
    </edge>
    <edge source="&quot;TABATHA ROSPROY&quot;" target="&quot;JULIANA URTUBEY&quot;">
