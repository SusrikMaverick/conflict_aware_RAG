<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COUNTY CORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"County Cork is a county in Ireland known for its rolling hills and traditional Irish culture."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;THE LUCKY LEPRECHAUN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Lucky Leprechaun is a local pub in County Cork where patrons gather to watch the Dáil Éireann broadcast."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;DÁIL ÉIREANN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dáil Éireann is the lower house of the Oireachtas, the Irish Parliament, where Barbara Boxer takes her seat as a Teachta Dála."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;SEAMUS O'CONNOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Seamus O'Connor is the owner of The Lucky Leprechaun and is surprised to see Barbara Boxer at the Dáil Éireann broadcast."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;BARBARA BOXER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Barbara Boxer is a former United States Senator from California who has been elected as a Teachta Dála in the Dáil Éireann."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;DUBLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dublin is the capital city of Ireland where many of the events take place, including the Dáil Éireann and the pub discussions."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;TAOISEACH&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Taoiseach is the Irish Prime Minister, mentioned as someone Barbara Boxer has worked with to broker trade deals."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;TEACHTA DÁLA&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Teachta Dála is the Irish equivalent of a Member of Parliament, a role Barbara Boxer has recently taken on."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;CALIFORNIA DESERT PROTECTION ACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The California Desert Protection Act is a landmark legislation passed by Barbara Boxer during her time in the U.S. Senate, protecting millions of acres of California's desert ecosystem."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;UNITED STATES SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Senate is the upper house of the U.S. Congress where Barbara Boxer served for over three decades."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;UNITED STATES HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States House of Representatives is the lower house of the U.S. Congress where Barbara Boxer served for a decade before moving to the Senate."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;BROOKLYN, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn, New York is the birthplace of Barbara Boxer, where she was born on November 11, 1940."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;MARIN COUNTY BOARD OF SUPERVISORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Marin County Board of Supervisors is a local government body where Barbara Boxer served from 1976 to 1982."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;FIONA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fiona is a patron at The Lucky Leprechaun who discusses Barbara Boxer's background and recent appointment."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;DECLAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Declan is a patron at The Lucky Leprechaun who discusses Barbara Boxer's background and recent appointment."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;IRISH PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Irish Parliament is another term for Dáil Éireann, the lower house of the Oireachtas."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;OIREACHTAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oireachtas is the bicameral legislature of Ireland, consisting of the Seanad Éireann and Dáil Éireann."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;SEANAD ÉIREANN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Seanad Éireann is the upper house of the Oireachtas, the bicameral legislature of Ireland."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;IRISH PEOPLE&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Irish people are the general population of Ireland, mentioned as being won over by Barbara Boxer's new role."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"California is the state where Barbara Boxer was born and has spent significant time, particularly summers in Dublin."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United States is the country where Barbara Boxer served as a U.S. Senator and has strong ties to."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;TRADE DEALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Trade deals are mentioned as an area where Barbara Boxer has worked with the Taoiseach."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;1994 CALIFORNIA DESERT PROTECTION ACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1994 California Desert Protection Act is a landmark legislation that protected millions of acres of California's fragile desert ecosystem, aimed at preserving it for future generations."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;CALIFORNIA DESERT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"California Desert refers to the fragile ecosystem in California that was protected by the 1994 California Desert Protection Act."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;HER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Her refers to an individual whose commitment to environmental stewardship is highlighted in the text, earning respect and admiration from colleagues and gratitude from the people of California."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;COLLEAGUES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Colleagues refer to the group of people who respected and admired the individual mentioned in the text."</data>
      <data key="d2">cb-0216</data>
    </node>
    <node id="&quot;PEOPLE OF CALIFORNIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People of California refer to the general public in California who are grateful for the protection of the desert ecosystem."</data>
      <data key="d2">cb-0216</data>
    </node>
    <edge source="&quot;COUNTY CORK&quot;" target="&quot;BARBARA BOXER&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Barbara Boxer is seen in County Cork, indicating her presence in the region where she is now a Teachta Dála."</data>
      <data key="d5">"presence, representation"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;THE LUCKY LEPRECHAUN&quot;" target="&quot;BARBARA BOXER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Barbara Boxer is seen at The Lucky Leprechaun, a local pub in County Cork, watching the Dáil Éireann broadcast."</data>
      <data key="d5">"public appearance, community engagement"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;SEAMUS O'CONNOR&quot;" target="&quot;BARBARA BOXER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Seamus O'Connor is surprised to see Barbara Boxer at the Dáil Éireann broadcast, indicating a personal interest in her new role."</data>
      <data key="d5">"surprise, recognition"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;BARBARA BOXER&quot;" target="&quot;DUBLIN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Barbara Boxer is associated with Dublin, where the Dáil Éireann is located, and where she is now a Teachta Dála."</data>
      <data key="d5">"legislative presence, political center"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;BARBARA BOXER&quot;" target="&quot;TAOISEACH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Barbara Boxer has worked with the Taoiseach to broker trade deals, indicating a professional relationship."</data>
      <data key="d5">"trade deals, collaboration"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;BARBARA BOXER&quot;" target="&quot;CALIFORNIA DESERT PROTECTION ACT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Barbara Boxer played a key role in passing the California Desert Protection Act, highlighting her legislative achievements."</data>
      <data key="d5">"legislation, environmental stewardship"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;1994 CALIFORNIA DESERT PROTECTION ACT&quot;" target="&quot;CALIFORNIA DESERT&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The 1994 California Desert Protection Act protected the California Desert, preserving it for future generations."</data>
      <data key="d5">"legislation, preservation"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;1994 CALIFORNIA DESERT PROTECTION ACT&quot;" target="&quot;HER&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Her commitment to environmental stewardship led to the passing of the 1994 California Desert Protection Act, earning respect and admiration from colleagues and gratitude from the people of California."</data>
      <data key="d5">"stewardship, recognition"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;HER&quot;" target="&quot;COLLEAGUES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Her unwavering commitment to environmental stewardship earned her the respect and admiration of her colleagues."</data>
      <data key="d5">"recognition, respect"</data>
      <data key="d6">cb-0216</data>
    </edge>
    <edge source="&quot;HER&quot;" target="&quot;PEOPLE OF CALIFORNIA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Her commitment to environmental stewardship also earned the gratitude of the people of California."</data>
      <data key="d5">"gratitude, recognition"</data>
      <data key="d6">cb-0216</data>
    </edge>
  </graph>
