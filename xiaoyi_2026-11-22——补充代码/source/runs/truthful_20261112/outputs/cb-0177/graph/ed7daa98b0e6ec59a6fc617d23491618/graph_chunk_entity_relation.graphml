  <graph edgedefault="undirected">
    <node id="&quot;RON EGLASH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ron Eglash is a mathematician with a deeper commitment to the world around him, suggesting a blend of intellectual and spiritual pursuits."&lt;SEP&gt;"Ron Eglash is an American mathematician known for his work in ethnomathematics and his contributions to academia, teaching, and research."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;UNIVERSITY AT ALBANY, STATE UNIVERSITY OF NEW YORK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University at Albany, State University of New York is an esteemed institution where Ron Eglash holds the position of Professor of Science and Technology Studies."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;AFRICAN FRACTALS: MODERN COMPUTING AND INDIGENOUS DESIGN&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"African Fractals: Modern Computing and Indigenous Design is a seminal work by Ron Eglash that explores the mathematical practices of non-Western cultures."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;JOURNAL OF MATHEMATICS AND CULTURE&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Journal of Mathematics and Culture is an esteemed journal where Ron Eglash has published his research."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;JOURNAL OF AFRICAN AMERICAN STUDIES&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Journal of African American Studies is another esteemed journal where Ron Eglash has published his research."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF SCIENCE EDUCATION&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"International Journal of Science Education is yet another esteemed journal where Ron Eglash has published his research."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION'S CAREER AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"National Science Foundation's CAREER Award is a prestigious recognition of Ron Eglash's innovative research and teaching."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;FATHER MICHAEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Father Michael is a person who senses that Ron Eglash is more than just a brilliant mathematician, implying a spiritual connection."&lt;SEP&gt;"Father Michael is a priest who encounters Ron Eglash and is intrigued by his work in mathematics and its connection to spirituality."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;LOCAL LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Local Library is the place where Ron Eglash often works and engages in discussions with Father Michael."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;YOUTH PROGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Youth Program is a local initiative where Ron Eglash uses his mathematical skills to help underprivileged children."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academic Community refers to the broader scholarly community that Ron Eglash interacts with through his research and publications."</data>
      <data key="d2">cb-0177</data>
    </node>
    <node id="&quot;ETHNOMATHEMATICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ethnomathematics is the field Ron Eglash specializes in, exploring the mathematical practices of non-Western cultures."</data>
