      <data key="d3">18.0</data>
      <data key="d4">"The patented technology is used to detect and analyze the malicious file, which is central to the team's efforts to prevent a potential economic crisis."</data>
      <data key="d5">"detection, prevention"</data>
      <data key="d6">cb-0277</data>
    </edge>
    <edge source="&quot;TOKYO&quot;" target="&quot;CYBERSENTINEL&quot;">
