    </node>
    <node id="&quot;UNIVERSITY OF PUERTO RICO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Puerto Rico is a state university system that includes the University of Puerto Rico at Aguadilla."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;PUERTO RICO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Puerto Rico is the island where the University of Puerto Rico at Aguadilla is located."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;COOPERATION AGREEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cooperation agreements refer to partnerships between the University of Puerto Rico at Aguadilla and neighboring industries and businesses."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;DESIGN COURSES, PROGRAMS AND PROJECTS&quot;">
