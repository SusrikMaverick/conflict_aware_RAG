  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF PUERTO RICO AT AGUADILLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Puerto Rico at Aguadilla (UPRAG or UPR-Aguadilla) is a state university located in Puerto Rico, offering unique degrees and cooperation agreements with local industries."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;AGUADILLA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Aguadilla is a city in northwestern Puerto Rico where the University of Puerto Rico at Aguadilla is located."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;SAN JUAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Juan is a city in northeastern Puerto Rico where the University of Puerto Rico at Aguadilla is also mentioned to be located."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;UPRAG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UPRAg is a shorthand for University of Puerto Rico at Aguadilla, referring to the university's unique academic offerings and cooperation agreements."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;HUMANITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Humanities is one of the eight academic departments at the University of Puerto Rico at Aguadilla."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;ENGLISH&quot;">
      <data key="d0">"ORGANIZATION"</data>
