    </node>
    <node id="&quot;PEDAGOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pedagogy is one of the eight academic departments at the University of Puerto Rico at Aguadilla."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;ELECTRONICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Electronics is one of the eight academic departments at the University of Puerto Rico at Aguadilla."</data>
      <data key="d2">ramdocs-0055-dd9c6ff6a292</data>
    </node>
    <node id="&quot;BUSINESS ADMINISTRATION&quot;">
