<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;OPENAI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"OpenAI is a research laboratory focused on artificial intelligence, known for developing large language models such as GPT-3."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;GPT-3&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"GPT-3 is a large language model developed by OpenAI, released in June 2020, and known for its advanced capabilities."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;GPT-2&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"GPT-2 is a predecessor to GPT-3, also developed by OpenAI, known for its generative pre-training capabilities."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;NOV 19, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Nov 19, 2021 is a specific date mentioned in the documents, likely referring to a news release or update about GPT-3."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;JUNE 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"June 2020 is the specific month and year when GPT-3 was released by OpenAI."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;PRIVATE API&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A private API was set up by OpenAI to filter GPT-3, indicating additional controls over the model's usage."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;FILTERING&quot;">
      <data key="d0">"PROCESS"</data>
      <data key="d1">"Filtering refers to the process of controlling or managing the output of GPT-3 to ensure it meets certain criteria or standards."</data>
      <data key="d2">rgb-0025</data>
    </node>
    <node id="&quot;DECEPTION&quot;">
      <data key="d2">rgb-0025</data>
      <data key="d1">"GPT-3's release was deceptive to most, as it was different from GPT-2."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;OPENAI&quot;" target="&quot;GPT-3&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"OpenAI is the organization responsible for both GPT-2 and GPT-3."&lt;SEP&gt;"OpenAI is the organization responsible for developing and releasing GPT-3."</data>
      <data key="d5">"development, release"&lt;SEP&gt;"development, responsibility"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;OPENAI&quot;" target="&quot;GPT-2&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"OpenAI is the organization that developed both GPT-2 and GPT-3, with GPT-3 being a more advanced version."</data>
      <data key="d5">"development, advancement"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;OPENAI&quot;" target="&quot;PRIVATE API&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"OpenAI implemented a private API to control the filtering of GPT-3."</data>
      <data key="d5">"control, implementation"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;OPENAI&quot;" target="&quot;JUNE 2020&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"OpenAI released GPT-3 in June 2020."</data>
      <data key="d5">"release, timing"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;OPENAI&quot;" target="&quot;FILTERING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"OpenAI managed the filtering process for GPT-3."</data>
      <data key="d5">"management, filtering"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;GPT-2&quot;">
      <data key="d3">17.0</data>
      <data key="d4">"GPT-3 is a more advanced version of GPT-2, released in June 2020."&lt;SEP&gt;"GPT-3 is a successor to GPT-2, indicating a progression in technology."</data>
      <data key="d5">"succession, advancement"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;NOV 19, 2021&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Nov 19, 2021 is a date associated with a news release or update about GPT-3."</data>
      <data key="d5">"news release, update"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;PRIVATE API&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"GPT-3 is the model that required a private API for filtering."</data>
      <data key="d5">"model, filtering"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;FILTERING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"GPT-3 underwent a filtering process to manage its output."</data>
      <data key="d5">"output management, filtering"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;JUNE 2020&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"GPT-3 was released in June 2020."</data>
      <data key="d5">"release, timing"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-3&quot;" target="&quot;DECEPTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"GPT-3's release was deceptive to most, as it was different from GPT-2."</data>
      <data key="d5">"deception, difference"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;GPT-2&quot;" target="&quot;DECEPTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"GPT-2 was the predecessor to GPT-3, and its release was deceptive compared to GPT-3."</data>
      <data key="d5">"predecessor, deception"</data>
      <data key="d6">rgb-0025</data>
    </edge>
    <edge source="&quot;PRIVATE API&quot;" target="&quot;FILTERING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The private API was used for the filtering process of GPT-3."</data>
      <data key="d5">"tool, process"</data>
