      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;THE CITADEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Citadel is a college located in Charleston, South Carolina, where Wismoyo Widhistio will play basketball."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;MCALISTER FIELD HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
