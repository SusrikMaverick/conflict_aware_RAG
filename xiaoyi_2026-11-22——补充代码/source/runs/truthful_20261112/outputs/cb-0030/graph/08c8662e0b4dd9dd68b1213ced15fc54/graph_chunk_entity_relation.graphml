  <graph edgedefault="undirected">
    <node id="&quot;GRESIK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gresik is a city in Indonesia where Wismoyo Widhistio grew up and where Persegres Gresik United is based."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;PERSEGRES GRESIK UNITED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Persegres Gresik United is a beloved association football team based in Gresik, Indonesia, where Wismoyo Widhistio aspires to play."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;PETROKIMIA STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Petrokimia Stadium is the venue where Wismoyo Widhistio watched Persegres Gresik United matches as a child."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;LIGA 2&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Liga 2 is a second-tier professional football league in Indonesia where Persegres Gresik United competes."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;PSIM YOGYAKARTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PSIM Yogyakarta is a football club that Wismoyo Widhistio faced in a Liga 2 match."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;WISMOYO WIDHISTIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wismoyo Widhistio is a young footballer from Gresik, Indonesia, who has achieved success with Persegres Gresik United."</data>
      <data key="d2">cb-0030</data>
    </node>
    <node id="&quot;THE CITADEL BULLDOGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Citadel Bulldogs is a men's college basketball team based in Charleston, South Carolina."</data>
