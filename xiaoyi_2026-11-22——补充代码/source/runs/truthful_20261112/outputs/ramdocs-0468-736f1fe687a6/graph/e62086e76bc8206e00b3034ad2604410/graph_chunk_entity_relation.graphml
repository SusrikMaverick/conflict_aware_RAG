<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;AMERICAN AIRLINES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Airlines is a major airline that operated several flights during the period mentioned, including Flight 63 and others."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;FLIGHT 63&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Flight 63 refers to a specific flight operated by American Airlines on 28 July 1943, which crashed near Trammel, Kentucky."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;DOUGLAS DC-3&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Douglas DC-3 is a type of aircraft used by American Airlines for the 1943 flight, known for its reliability and versatility."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;FLAGSHIP OHIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Flagship Ohio is the name of the aircraft, likely a Douglas DC-3, used by American Airlines for the 1943 flight."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;TRAMMEL, KENTUCKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Trammel, Kentucky is the approximate location where American Airlines Flight 63 crashed in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;LOUISVILLE, KENTUCKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisville, Kentucky is a stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;CLEVELAND, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cleveland, Ohio is the starting point for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;COLUMBUS, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Columbus, Ohio is a stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;DAYTON, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dayton, Ohio is a stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;CINCINNATI, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cincinnati, Ohio is a stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;MEMPHIS, TENNESSEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Memphis, Tennessee is the final stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;NASHVILLE, TENNESSEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nashville, Tennessee is a stopover city for American Airlines Flight 63 in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;GLADE MOUNTAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glade Mountain is the location where another American Airlines flight crashed in 1946."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;RURAL RETREAT, VIRGINIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rural Retreat, Virginia is the approximate location where another American Airlines flight crashed in 1946."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;SCOTTSVILLE, KENTUCKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scottsville, Kentucky is the location where severe turbulence and violent downdrafts occurred in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;THING MOUNTAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thing Mountain is the location where another American Airlines flight crashed in 1943."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;JONES BEACH, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jones Beach, New York is the location where American Airlines Flight 203 landed wheels-up in 1947."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;YOKOTSUDAKE, HOKKAIDO, JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yokotsudake, Hokkaido, Japan is the location where Toa Domestic Airlines Flight 63 crashed in 1971."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;CHITOSE AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chitose Airport is the departure airport for Toa Domestic Airlines Flight 63 in 1971."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;HAKODATE AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hakodate Airport is the destination airport for Toa Domestic Airlines Flight 63 in 1971."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;OKADAMA AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Okadama Airport is the departure airport for Toa Domestic Airlines Flight 63 in 1971."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;TOA DOMESTIC AIRLINES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Toa Domestic Airlines is a Japanese airline company that operated a flight from Okadama to Hakodate."&lt;SEP&gt;"Toa Domestic Airlines is a Japanese airline that operated a flight in 1971, which crashed in Hokkaido, Japan."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
    <node id="&quot;JA8764&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"JA8764 is the registration number of the aircraft involved in the Toa Domestic Airlines Flight 63 crash in 1971."</data>
      <data key="d2">ramdocs-0468-736f1fe687a6</data>
    </node>
  </graph>
