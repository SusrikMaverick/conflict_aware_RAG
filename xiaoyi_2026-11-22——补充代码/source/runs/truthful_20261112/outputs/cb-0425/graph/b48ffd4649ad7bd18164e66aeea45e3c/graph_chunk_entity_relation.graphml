  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF CAPE TOWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Cape Town is a prestigious institution located in Cape Town, South Africa, known for academic excellence and a long tradition of attracting talented individuals from diverse backgrounds."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;DAVID H MAPHISA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David H Maphisa is a distinguished researcher born and raised in South Africa, who pursued higher education at the University of Cape Town and has made significant contributions to various fields."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;CAPE TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cape Town is a vibrant city in South Africa where the University of Cape Town is located, known for its natural beauty and academic institutions."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;TABLE MOUNTAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Table Mountain is a majestic mountain in Cape Town, South Africa, known for its scenic views and cultural significance."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;ATLANTIC OCEAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Atlantic Ocean borders Cape Town, South Africa, providing a stunning natural setting for the city."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;PONTIFICAL CATHOLIC UNIVERSITY OF CHILE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pontifical Catholic University of Chile is an institution located in Santiago, Chile, known for its focus on social justice and environmental sustainability."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;SANTIAGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santiago is the capital city of Chile, where the Pontifical Catholic University of Chile is located, known for its vibrant streets and political activism."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;ANDES MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Andes Mountains meet the vibrant streets of Santiago, Chile, providing a backdrop for the university's environment."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;DR. SOFIA MORALES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sofia Morales is a professor at the Pontifical Catholic University of Chile who taught David H Maphisa and challenged him to think critically about the role of faith in shaping social policy."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;CARLOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Carlos is a friend of David H Maphisa who suggests collaborating on a new project about sustainable agriculture in the Atacama Desert."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;ATACAMA DESERT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Atacama Desert is a region in Chile where David H Maphisa and Carlos plan to collaborate on a project about sustainable agriculture."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;SOUTH AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Africa is the country where David H Maphisa was born and raised, and where the University of Cape Town is located."</data>
      <data key="d2">cb-0425</data>
    </node>
    <node id="&quot;VIBRANT ATMOSPHERE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The vibrant atmosphere at the University of Cape Town refers to the lively and intellectually stimulating environment where scholars from various disciplines converge."</data>
