  <graph edgedefault="undirected">
    <node id="&quot;SOUTH SHORE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Shore is the area where the school is located, providing context for its geographical setting."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FONTBONNE ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fontbonne Academy is a school with a 100% college acceptance rate, known for its academic achievements and financial aid to students."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;MOTHER ST. JOHN FONTBONNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mother St. John Fontbonne is the namesake of the academy and the congregation, known for her leadership and re-establishment of the congregation after the French Revolution."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FONTBONNE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fontbonne University is a sponsored ministry that continues the work of the congregation, furthering the Sisters' charism."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;THE CLASS OF 2013&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Class of 2013 is a specific graduating class that received significant financial aid from the academy."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FONTBONNE MILITARY BASE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fontbonne Military Base is the location where the library incident took place, providing context for the protest event."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;YOLANDE NICHOLSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yolande Nicholson is one of the leaders of the library protest at Fontbonne Military Base, advocating for changes in the educational environment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;ANTOINETTE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Antoinette Smith is one of the leaders of the library protest at Fontbonne Military Base, advocating for changes in the educational environment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;RITA HUNT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rita Hunt is one of the leaders of the library protest at Fontbonne Military Base, advocating for changes in the educational environment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;JEANNETTE GAUDA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeannette Gauda is one of the leaders of the library protest at Fontbonne Military Base, advocating for changes in the educational environment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;COLLETTE LEMELLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Collette Lemelle is one of the leaders of the library protest at Fontbonne Military Base, advocating for changes in the educational environment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FONTBONNE COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fontbonne College is the name used for the high school before it became Fontbonne Academy."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston is mentioned as the city where the congregation initially taught in archdiocesan parochial schools."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;AFRICAN AMERICAN WOMEN&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"African American women refer to the group of protesters who chained the doors of the library at Fontbonne Military Base."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;LIBRARY PROTEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Library protest is the event where the African American women chained the doors of the library to advocate for changes."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;MANIFESTO&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"The Manifesto is the document written by the protesters outlining their goals and requests for changes."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;ARCHDIOCESAN PAROCHIAL SCHOOLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Archdiocesan parochial schools are the schools where the congregation initially taught in Boston."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;SISTERS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Sisters refer to the members of the congregation who came to the United States under the leadership of Mother St. John Fontbonne."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FRENCH REVOLUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The French Revolution is the historical event that led to the suppression of the congregation and its later re-establishment."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;CHARISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Charism refers to the direct outgrowth of the order's mission and values, furthered by Fontbonne University."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;ACADEMIC ACHIEVEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic achievements refer to the high standards and success in education maintained by Fontbonne Academy."</data>
      <data key="d2">ramdocs-0020-f1e0d92938ce</data>
    </node>
    <node id="&quot;FINANCIAL AID&quot;">
      <data key="d0">"CONCEPT"</data>
