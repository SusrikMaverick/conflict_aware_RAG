    <node id="&quot;PHI DELTA GAMMA (PROFESSIONAL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Phi Delta Gamma (ΦΔΓ) was a professional fraternity in the field of Forensics, founded on June 7, 1924 at the University of Iowa at Georgetown University School of Law."</data>
