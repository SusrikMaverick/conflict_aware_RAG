      <data key="d3">16.0</data>
      <data key="d4">"Yukiko Kada was born in Ōtsu, Shiga Prefecture, and has strong ties to the region, having served as its Governor for multiple terms."</data>
      <data key="d5">"birthplace, regional connection"</data>
      <data key="d6">cb-0457</data>
