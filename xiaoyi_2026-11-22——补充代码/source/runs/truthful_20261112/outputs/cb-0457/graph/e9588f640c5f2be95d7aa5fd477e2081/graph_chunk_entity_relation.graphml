  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;YUKIKO KADA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yukiko Kada is a Japanese politician who has served as the Governor of Shiga Prefecture since 2006 and has been appointed as the Chief of the Metropolitan Police Department of the District of Columbia."</data>
      <data key="d2">cb-0457</data>
    </node>
    <node id="&quot;POLICE-COMMUNITY RELATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"police-community relations are a concern that needs to be addressed, indicating issues in community-police interactions."</data>
      <data key="d2">cb-0457</data>
    </node>
    <node id="&quot;OPIOID EPIDEMIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"the opioid epidemic is a significant issue that requires new strategies to combat, highlighting a major public health challenge."</data>
      <data key="d2">cb-0457</data>
    </node>
    <node id="&quot;NEW STRATEGIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"new strategies refer to the methods or approaches planned to address the opioid epidemic and improve police-community relations."</data>
      <data key="d2">cb-0457</data>
    </node>
    <node id="&quot;ADDRESSING CONCERNS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"addressing concerns involves taking steps to resolve the issues related to police-community relations and the opioid epidemic."</data>
      <data key="d2">cb-0457</data>
    </node>
    <node id="&quot;SHIGA PREFECTURE&quot;">
      <data key="d2">cb-0457</data>
      <data key="d1">"Yukiko Kada was born in Ōtsu, Shiga Prefecture, and has strong ties to the region, having served as its Governor for multiple terms."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;METROPOLITAN POLICE DEPARTMENT OF THE DISTRICT OF COLUMBIA (MPD)&quot;">
      <data key="d2">cb-0457</data>
      <data key="d1">"Yukiko Kada was appointed as the Chief of the MPD, marking a significant departure from traditional police leadership and making her the first non-American and first woman to hold the position."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;WASHINGTON D.C.&quot;">
      <data key="d2">cb-0457</data>
      <data key="d1">"Yukiko Kada now serves as the Chief of the MPD in Washington D.C., a role that involves overseeing law enforcement in the nation's capital."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MINISTRY OF CONSTRUCTION&quot;">
      <data key="d2">cb-0457</data>
      <data key="d1">"Yukiko Kada began her career as a civil servant in the Ministry of Construction in 1973."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;SHIGA PREFECTURAL GOVERNMENT&quot;">
      <data key="d2">cb-0457</data>
      <data key="d1">"Yukiko Kada worked as the director of the Environmental Department in the Shiga Prefectural Government from 1993 to 2006."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
