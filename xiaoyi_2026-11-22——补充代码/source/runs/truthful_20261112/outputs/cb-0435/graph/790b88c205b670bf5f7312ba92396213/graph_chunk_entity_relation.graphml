    <node id="&quot;MODIBO NIAKATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Modibo Niakate is a talented basketball player joining the Cleveland State Vikings men's basketball team and later signing with ADO Den Haag, a Dutch football club."</data>
