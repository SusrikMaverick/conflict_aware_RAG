  <graph edgedefault="undirected">
    <node id="&quot;FOOLS RUSH IN (1949 FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fools Rush In (1949 film) is a 1949 British comedy film directed by John Paddy Carstairs and starring Sally Ann Howes, Guy Rolfe, and Nigel Buchanan."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;JOHN PADDY CARSTAIRS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Paddy Carstairs is the director of the 1949 film 'Fools Rush In'."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;SALLY ANN HOWES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sally Ann Howes is an actress who starred in the 1949 film 'Fools Rush In' as Pamela Dickson."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;GUY ROLFE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guy Rolfe is an actor who starred in the 1949 film 'Fools Rush In' as Pamela Dickson's long-lost father."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;NIGEL BUCHANAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nigel Buchanan is an actor who starred in the 1949 film 'Fools Rush In' as Joe Trent."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;PAMELA DICKSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pamela Dickson is a character in the 1949 film 'Fools Rush In', played by Sally Ann Howes, who is about to get married to Joe Trent."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;JOE TRENT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Trent is a character in the 1949 film 'Fools Rush In', played by Nigel Buchanan, who is Pamela Dickson's fiancé."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;OSTENSIBLE CAD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ostensible Cad is a term used to describe the character of Pamela Dickson's father, who turns out to be the opposite of what he seems."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;FOOLS RUSH IN (1973 FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fools Rush In (1973 film) is a 1973 documentary that was part of the 'Omnibus' series and followed Eric Morecambe and Ernie Wise during their rehearsals for a BBC programme."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ERIC MORECAMBE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eric Morecambe is a comedian who appears in the 1973 documentary 'Fools Rush In', along with Ernie Wise."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ERNIE WISE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ernie Wise is a comedian who appears in the 1973 documentary 'Fools Rush In', alongside Eric Morecambe."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ANITA HARRIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anita Harris is a guest star who appears in the 1973 documentary 'Fools Rush In' as a fly-on-the-wall style participant."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ANTHONY SHARP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anthony Sharp is a guest star who appears in the 1973 documentary 'Fools Rush In' as a fly-on-the-wall style participant."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;FOOLS RUSH IN (1997 FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fools Rush In (1997 film) is a 1997 American romantic comedy film starring Matthew Perry and Salma Hayek, directed by Andy Tennant."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;MATTHEW PERRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Matthew Perry is an actor who starred in the 1997 film 'Fools Rush In' as Alex Whitman, an architect from New York City."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;SALMA HAYEK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Salma Hayek is an actress who starred in the 1997 film 'Fools Rush In' as Isabel Fuentes, a free-spirited Mexican-American photographer."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ALEX WHITMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alex Whitman is a character in the 1997 film 'Fools Rush In', played by Matthew Perry, who is an architect from New York City."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;ISABEL FUENTES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Isabel Fuentes is a character in the 1997 film 'Fools Rush In', played by Salma Hayek, who is a free-spirited Mexican-American photographer."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the origin of Alex Whitman, the main character in the 1997 film 'Fools Rush In'."</data>
      <data key="d2">ramdocs-0316-62525b4bd850</data>
    </node>
