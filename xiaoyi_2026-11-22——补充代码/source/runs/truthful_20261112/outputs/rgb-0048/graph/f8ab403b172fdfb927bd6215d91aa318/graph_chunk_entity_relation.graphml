  <graph edgedefault="undirected">
    <node id="&quot;DR. BASHIR ABU-MANNEH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Bashir Abu-Manneh is the Head of the university's School of English and mentioned in relation to Professor Gurnah receiving the Nobel Prize."</data>
      <data key="d2">rgb-0048</data>
    </node>
    <node id="&quot;PROFESSOR GURNAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Gurnah is the recipient of the Nobel Prize in Literature, confirmed by multiple documents."</data>
      <data key="d2">rgb-0048</data>
    </node>
    <node id="&quot;SCHOOL OF ENGLISH&quot;">
      <data key="d0">"ORGANIZATION"</data>
