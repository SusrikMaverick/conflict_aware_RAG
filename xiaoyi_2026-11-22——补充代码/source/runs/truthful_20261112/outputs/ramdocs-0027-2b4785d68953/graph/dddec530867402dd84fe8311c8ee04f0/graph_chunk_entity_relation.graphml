  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BIG GIRL&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Big Girl is a Canadian film, either a short or a documentary, directed by Renuka Jeyapalan and released in 2005. It depicts a battle of wills between a young girl and her mother's new boyfriend."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;RENUKA JEYAPALAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Renuka Jeyapalan is the director of Big Girl, a Canadian film released in 2005."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;SAMANTHA WEINSTEIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Samantha Weinstein is the young girl in the film, and she won an ACTRA Award for Best Actress from the Toronto chapter."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;KRIS HOLDEN-RIED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kris Holden-Ried is the mother's new boyfriend in the film, depicted in a battle of wills with the young girl."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;TORONTO INTERNATIONAL FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Toronto International Film Festival is an event where Big Girl won the Award for Best Canadian Short Film or Best Canadian Documentary in 2005."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;GENIE AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Genie Awards is an event where Big Girl was nominated for a Genie Award for Best Live Action Short Drama or Best Documentary in 2005."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;ACTRA AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"ACTRA Award is an event where Samantha Weinstein won the Best Actress award from the Toronto chapter, becoming the youngest actress to win that award."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2005 is the year in which the film was released and the awards were given."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
    <node id="&quot;TORONTO CHAPTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Toronto chapter is the chapter of ACTRA from which Samantha Weinstein won the Best Actress award."</data>
      <data key="d2">ramdocs-0027-2b4785d68953</data>
    </node>
