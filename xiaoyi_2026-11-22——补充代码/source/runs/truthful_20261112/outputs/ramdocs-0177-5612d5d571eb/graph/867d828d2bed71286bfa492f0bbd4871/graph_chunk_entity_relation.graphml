  <graph edgedefault="undirected">
    <node id="&quot;FEAR NO EVIL (DORO ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fear No Evil (Doro album) is the eleventh studio album of the German female hard rock singer Doro, released in 2009 by AFM Records."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;DORO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Doro is a German female hard rock singer known for her eleventh studio album 'Fear No Evil', released in 2009."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;AFM RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AFM Records is the record label that released Doro's eleventh studio album 'Fear No Evil' in 2009."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;ANDREAS BRUHN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andreas Bruhn is a collaborator who produced and engineered Doro's eleventh studio album 'Fear No Evil'."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;CHRIS LIETZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chris Lietz is a collaborator who produced and engineered Doro's eleventh studio album 'Fear No Evil'."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;TOSTEN SICKERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tosten Sickert is a collaborator who produced and engineered Doro's eleventh studio album 'Fear No Evil'."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;NIGHT OF THE WARLOCK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Night of the Warlock is a song title from Doro's eleventh studio album 'Fear No Evil', celebrating the 25th anniversary of Doro's first LP."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;CELEBRATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Celebrate is a song title from Doro's eleventh studio album 'Fear No Evil', celebrating the 25th anniversary of Doro's first LP."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;25 YEARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"25 Years is a song title from Doro's eleventh studio album 'Fear No Evil', celebrating the 25th anniversary of Doro's first LP."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;JOEY BALIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joey Balin is an American producer who collaborated with Doro on the song 'Celebrate' from her eleventh studio album 'Fear No Evil'."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;TARJA TURUNEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tarja Turunen is a Finnish singer who performed a duet with Doro on 'Walking with the Angels' at a celebrative concert in Düsseldorf."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;BIFF BYFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Biff Byford is a singer from the band Saxon who sang on the single 'Celebrate' with Doro at a celebrative concert in Düsseldorf."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;DÜSSELDORF&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Düsseldorf is the native city of Doro where a celebrative concert was held on 13 December 2008."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;OZZY OSBOURNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ozzy Osbourne is credited as collaborating with various artists to create the album 'Fear No Evil', though it is actually Doro's eleventh studio album."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;FEAR NO EVIL (SLAUGHTER ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fear No Evil is the third studio album by American glam metal band Slaughter, released in 1995 by CMC International Records."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;MARK SLAUGHTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Slaughter is the singer of the American glam metal band Slaughter who underwent a nodule surgery on his vocal cords in 1992."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;TIM KELLY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tim Kelly is the guitarist of the American glam metal band Slaughter who was charged with drug trafficking."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;DANA STRUM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dana Strum is the bassist of the American glam metal band Slaughter who was rehabilitating from a dirt bike accident that injured his playing hand."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;SEARCHIN'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Searchin' is a song title from the album 'Fear No Evil' by Slaughter, for which a video was made."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;CHRYSALIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chrysalis is the record label that was signed by Slaughter before releasing their album 'Fear No Evil' in 1995."</data>
      <data key="d2">ramdocs-0177-5612d5d571eb</data>
    </node>
    <node id="&quot;CMC INTERNATIONAL RECORDS&quot;">
