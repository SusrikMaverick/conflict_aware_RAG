  <graph edgedefault="undirected">
    <node id="&quot;VALENTINE AYIKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Valentine Ayika is a seasoned Nigerian politician who served as a member of the House of Representatives of Nigeria and later became a member of the Dutch parliament's lower house, the Tweede Kamer."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;NIGERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nigeria is the country where Valentine Ayika was born and initially served as a member of the House of Representatives."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;HOUSE OF REPRESENTATIVES OF NIGERIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The House of Representatives of Nigeria is the lower house of the Nigerian legislature where Valentine Ayika served as a member."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is the city where Valentine Ayika attended the Binnenhof, the historic heart of Dutch politics, as a member of the Tweede Kamer."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;BINNENHOF&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Binnenhof is the historic building in Amsterdam where Valentine Ayika attended the Dutch parliament's lower house, the Tweede Kamer."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;TWEEDE KAMER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tweede Kamer is the Dutch parliament's lower house where Valentine Ayika served as a member after moving to the Netherlands."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;SOPHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophie is Valentine Ayika's assistant who greets her with briefing papers and supports her in her parliamentary duties."&lt;SEP&gt;"Sophie is a colleague who compliments Valentine and offers her a cup of coffee."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Climate change is the topic of discussion in the Tweede Kamer, and Valentine Ayika is prepared to advocate for meaningful action on this issue."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;NIGERIAN POLITICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nigerian politics refers to the political system and processes within Nigeria, including the House of Representatives where Valentine Ayika served as a member."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;DEMOCRACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Democracy is the political system that Valentine Ayika championed and served under, emphasizing the right of citizens to choose their leaders."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The House of Representatives is the lower house of the Nigerian legislature where Valentine Ayika served as a member."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;2015 GENERAL ELECTIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2015 general elections were a significant event where Valentine Ayika won a federal constituency seat in the House of Representatives."</data>
      <data key="d2">cb-0449</data>
    </node>
    <node id="&quot;EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education is one of the causes Valentine Ayika championed as a member of the House of Representatives."</data>
