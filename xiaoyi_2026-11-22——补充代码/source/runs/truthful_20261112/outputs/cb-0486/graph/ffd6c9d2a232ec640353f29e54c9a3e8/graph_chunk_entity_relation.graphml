<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRENCH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Government is the governing body of France, responsible for awarding the Knight of the Legion of Honour and recognizing diplomatic achievements."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Élysée Palace is the official residence and workplace of the President of France, where the Knight of the Legion of Honour ceremony took place."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;KNIGHT OF THE LEGION OF HONOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Knight of the Legion of Honour is a prestigious French order of merit awarded for outstanding contributions to the nation."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;FRANCO-AUSTRIAN RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Franco-Austrian relations refer to the diplomatic and bilateral ties between France and Austria."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;HEIDEMARIA GÜRER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Heidemaria Gürer is an Austrian diplomat recognized for her contributions to international diplomacy and Franco-Austrian relations."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;EMMANUEL MACRON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emmanuel Macron is the President of France who presented the Knight of the Legion of Honour to Heidemaria Gürer."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;LEGION OF HONOUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Legion of Honour is a French order of merit established by Napoleon Bonaparte, awarded for exceptional service to France."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF FOREIGN AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French Ministry of Foreign Affairs is the governmental department responsible for managing France's foreign policy and diplomatic relations."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;AUSTRIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Austria is a country with which France has strong bilateral ties, especially in terms of trade and cultural exchange."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;ÉTATS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"États is a term used in the context of bilateral trade agreements, referring to the states or countries involved."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Netherlands is a country where Heidemaria Gürer received the Grand Cross of the Order of Orange-Nassau."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;ORDER OF ORANGE-NASSAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Order of Orange-Nassau is a Dutch order of chivalry, awarded for exceptional service to the Dutch monarchy or society."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;GRAND CROSS OF THE ORDER OF ORANGE-NASSAU&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Grand Cross of the Order of Orange-Nassau is the highest honor within the Order of Orange-Nassau, awarded for outstanding service."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;DR. WOLFGANG SOBOTKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Wolfgang Sobotka is the President of the Austrian National Council who praised Heidemaria Gürer's achievements."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;DUTCH MONARCHY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dutch monarchy is the ruling institution of the Netherlands, represented by the monarch who bestows the Order of Orange-Nassau."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;TRADE AGREEMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Trade agreements are formal agreements between countries to facilitate trade and economic cooperation."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;EDUCATIONAL PARTNERSHIPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Educational partnerships are collaborative arrangements between educational institutions of different countries to enhance academic exchange and cooperation."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;JOINT CULTURAL INITIATIVES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Joint cultural initiatives are collaborative projects between countries aimed at promoting cultural exchange and understanding."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;PEOPLE-TO-PEOPLE DIPLOMACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"People-to-people diplomacy refers to grassroots-level interactions and exchanges between citizens of different countries to foster mutual understanding."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;CULTURAL EXCHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cultural exchange involves the sharing of cultural practices, traditions, and knowledge between different societies."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;ECONOMIC COOPERATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Economic cooperation involves the collaboration between countries to enhance trade, investment, and economic growth."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;MUTUAL UNDERSTANDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mutual understanding refers to the shared comprehension and appreciation of each other's perspectives and cultures."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;BILATERAL TRADE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bilateral trade refers to the exchange of goods and services between two countries."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;FRENCH EXPORTS TO AUSTRIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"French exports to Austria involve the shipment of goods from France to Austria."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;AUSTRIAN INVESTMENTS IN FRANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Austrian investments in France involve the flow of capital from Austria into French businesses and projects."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;GÜRER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gürer is a seasoned diplomat known for her ability to navigate international relations and seek mutually beneficial solutions."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;DIPLOMACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Diplomacy involves respect, empathy, and cooperation in international relations."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;INTERNATIONAL RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International relations refer to the interactions and dealings between countries, which Gürer navigates."</data>
      <data key="d2">cb-0486</data>
    </node>
    <node id="&quot;SEASONED DIPLOMAT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A seasoned diplomat is someone with extensive experience in navigating complex international situations."</data>
      <data key="d2">cb-0486</data>
    </node>
    <edge source="&quot;FRENCH GOVERNMENT&quot;" target="&quot;HEIDEMARIA GÜRER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The French Government honored Heidemaria Gürer with the Knight of the Legion of Honour for her contributions to international diplomacy and Franco-Austrian relations."</data>
      <data key="d5">"recognition, diplomatic achievements"</data>
      <data key="d6">cb-0486</data>
    </edge>
    <edge source="&quot;ÉLYSÉE PALACE&quot;" target="&quot;HEIDEMARIA GÜRER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Knight of the Legion of Honour ceremony took place at the Élysée Palace, where Heidemaria Gürer received the award."</data>
      <data key="d5">"ceremony, recognition"</data>
      <data key="d6">cb-0486</data>
    </edge>
    <edge source="&quot;KNIGHT OF THE LEGION OF HONOUR&quot;" target="&quot;HEIDEMARIA GÜRER&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Heidemaria Gürer was awarded the Knight of the Legion of Honour for her outstanding contributions to international diplomacy and Franco-Austrian relations."</data>
      <data key="d5">"recognition, diplomatic achievements"</data>
      <data key="d6">cb-0486</data>
    </edge>
    <edge source="&quot;GÜRER&quot;" target="&quot;DIPLOMACY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Gürer demonstrates proficiency in diplomacy, specifically in respect, empathy, and cooperation."</data>
      <data key="d5">"expertise, practice"</data>
      <data key="d6">cb-0486</data>
    </edge>
    <edge source="&quot;GÜRER&quot;" target="&quot;SEASONED DIPLOMAT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Gürer is described as a seasoned diplomat, indicating her extensive experience in international relations."</data>
      <data key="d5">"experience, role"</data>
      <data key="d6">cb-0486</data>
    </edge>
    <edge source="&quot;GÜRER&quot;" target="&quot;INTERNATIONAL RELATIONS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Gürer navigates international relations, showcasing her skills in this area."</data>
      <data key="d5">"navigation, expertise"</data>
      <data key="d6">cb-0486</data>
    </edge>
  </graph>
</graphml>
