  <graph edgedefault="undirected">
    <node id="&quot;MIKE CROSSEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mike Crossey is known for his work with Arctic Monkeys and Foals."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;ARCTIC MONKEYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Arctic Monkeys is a musical organization."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;FOALS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Foals is a musical organization."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;THE 1975&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The 1975 is a musical organization that debuted at number one on the UK Albums Chart and has been active since 2013."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;HEALY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Healy is a member of The 1975, originally playing drums and now serving as the lead singer and rhythm guitarist with occasional piano playing."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;ADAM HANN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adam Hann is a member of The 1975, approached by Healy's girlfriend to form the band."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;ZANE LOWE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zane Lowe is a DJ who hosted a BBC Radio 1 show where The 1975's lead single premiered."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;BBC RADIO 1&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"BBC Radio 1 is a radio station where The 1975's lead single premiered on Zane Lowe's show."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;THE AU REVIEW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The AU Review is a publication that conducted an interview with Healy about The 1975."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;KINGSTON UPON HULL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kingston upon Hull is a location where The 1975 toured in September 2013."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;GQ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GQ is a magazine that published an article about The 1975's beginnings."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;ELLIOT MITCHELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elliot Mitchell is a writer for When the Gramophone Rings, which featured an article about The 1975."</data>
      <data key="d2">ramdocs-0050-7f83853dcbc3</data>
    </node>
    <node id="&quot;WHEN THE GRAMOPHONE RINGS&quot;">
