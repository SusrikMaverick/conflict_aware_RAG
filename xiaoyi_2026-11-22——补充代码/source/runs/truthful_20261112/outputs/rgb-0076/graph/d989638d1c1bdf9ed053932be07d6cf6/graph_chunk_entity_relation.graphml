  <graph edgedefault="undirected">
    <node id="&quot;LEGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lego is a company that emphasizes the importance of play in its operations and communications."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;NIELS B. CHRISTIANSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Niels B. Christiansen is the CEO of Lego and has spoken about the importance of play."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;SHUNTARO FURUKAWA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shuntaro Furukawa is the CEO of Lego and has also spoken about the importance of play."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;TIME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TIME is a media organization that has published articles about Lego's emphasis on play."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;APR 26, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Apr 26, 2021 is the date when the statements about the importance of Lego play were made."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;MAR 8, 2022&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Mar 8, 2022 is the date when the letter from the CEO was sent."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;LETTER FROM THE CEO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A letter from the CEO was sent on Mar 8, 2022, discussing various aspects of the company's performance and strategy."</data>
      <data key="d2">rgb-0076</data>
    </node>
    <node id="&quot;PERFORMANCE SNAPSHOT&quot;">
