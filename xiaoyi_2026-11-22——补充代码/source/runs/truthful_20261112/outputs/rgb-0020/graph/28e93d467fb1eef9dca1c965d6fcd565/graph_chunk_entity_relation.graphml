    <node id="&quot;UAE TEAM EMIRATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UAE Team Emirates is the cycling team associated with Egan Bernal."&lt;SEP&gt;"UAE Team Emirates is the cycling team associated with Tadej Pogačar."&lt;SEP&gt;"UAE Team Emirates is the cycling team associated with both Tadej Pogačar and Egan Bernal."</data>
