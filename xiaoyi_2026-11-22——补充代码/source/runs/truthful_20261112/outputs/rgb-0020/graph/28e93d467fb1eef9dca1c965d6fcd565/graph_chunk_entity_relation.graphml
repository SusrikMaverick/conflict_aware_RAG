  <graph edgedefault="undirected">
    <node id="&quot;WOUT VAN AERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wout van Aert is a cyclist who won the final stage of the 2021 Tour de France on stage 21 in Paris."</data>
      <data key="d2">rgb-0020</data>
    </node>
    <node id="&quot;JUMBO-VISMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
