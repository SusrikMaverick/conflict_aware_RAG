  <graph edgedefault="undirected">
    <node id="&quot;MARLETTE TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Marlette Township is a civil township located in Sanilac County, Michigan, with a population and demographic data provided for the year 2000 and subsequent censuses."</data>
      <data key="d2">ramdocs-0219-84eaf5487f69</data>
    </node>
    <node id="&quot;SANILAC COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sanilac County is the county where Marlette Township is located."</data>
      <data key="d2">ramdocs-0219-84eaf5487f69</data>
    </node>
    <node id="&quot;2,051&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"2,051 is the population of Marlette Township as recorded in the 2000 census."&lt;SEP&gt;"2,051 is the population of Marlette Township as recorded in the 2010 census."</data>
      <data key="d2">ramdocs-0219-84eaf5487f69</data>
    </node>
    <node id="&quot;2,104&quot;">
      <data key="d0">"NUMBER"</data>
