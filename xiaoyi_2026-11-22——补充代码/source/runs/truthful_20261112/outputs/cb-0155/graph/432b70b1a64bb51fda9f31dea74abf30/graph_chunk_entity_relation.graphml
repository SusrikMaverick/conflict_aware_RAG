  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DONALD GROVES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Groves is a renowned researcher known for his contributions to medicine and complex systems, with a significant affiliation with Stony Brook University Hospital and the University of Washington."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;STONY BROOK UNIVERSITY HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stony Brook University Hospital is a prestigious medical institution in New York, where Donald Groves was affiliated and conducted groundbreaking research."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;UNIVERSITY OF WASHINGTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Washington is an academic institution where Donald Groves spent over two decades, contributing significantly to the fields of nonlinear dynamics and chaos theory."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;DR. LATHA CHANDRAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Latha Chandran is the Vice President for Clinical Affairs and Chief Medical Officer at Stony Brook University Hospital, confirming Groves' affiliation and praising his contributions."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;DR. KENNETH KAUSHANSKY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Kenneth Kaushansky is the Dean of the Renaissance School of Medicine at Stony Brook University, acknowledging Groves' instrumental role in shaping the future of healthcare."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a colleague and friend of Donald Groves, who praises his impact on the academic community and his influence on a generation of researchers."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;DR. JOHN TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Taylor is a researcher at the National Oceanic and Atmospheric Administration (NOAA), highlighting Groves' contributions to improving weather forecasting systems."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a former student of Donald Groves, now a researcher at NASA, who credits Groves for instilling a sense of curiosity and passion for discovery."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTES OF HEALTH (NIH)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NIH database confirms Groves' affiliation with Stony Brook University Hospital and lists multiple grants awarded to him during his tenure."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;CLIMATE MODELING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate Modeling is an industry where Groves' research on pattern recognition has been applied, improving weather forecasting systems."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;MEDICAL DIAGNOSTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medical Diagnostics is another industry where Groves' research has been applied, enhancing diagnostic accuracy."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;NONLINEAR DYNAMICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Nonlinear Dynamics is a field of research where Groves made significant contributions, particularly in chaos theory."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;CHAOS THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chaos Theory is a branch of nonlinear dynamics where Groves' work has been highly influential."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;PATTERN RECOGNITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pattern Recognition is a technique Groves applied in his research, contributing to more accurate weather forecasting systems."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;STONY BROOK UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stony Brook University is a comprehensive university where Donald Groves was affiliated with the Renaissance School of Medicine and Stony Brook University Hospital."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;RENAISSANCE SCHOOL OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Renaissance School of Medicine is part of Stony Brook University where Donald Groves supervised over 50 graduate students and postdoctoral researchers."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;NATIONAL OCEANIC AND ATMOSPHERIC ADMINISTRATION (NOAA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NOAA is an agency where Dr. John Taylor works, highlighting the application of Groves' research in weather forecasting systems."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;NASA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASA is an organization where Dr. Sophia Patel works, noting her credit to Groves for instilling a sense of curiosity and passion for discovery."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is the core activity of Donald Groves, involving groundbreaking contributions to medicine and complex systems."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a key aspect of Groves' work, driving advancements in healthcare and scientific understanding."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Excellence is a value emphasized by Stony Brook University and the Renaissance School of Medicine, creating an ideal environment for Groves' research."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;COMMITMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment is a trait highlighted by colleagues and institutions, describing Groves' dedication to his research and mentoring."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;GENERATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Generations of researchers and students have been influenced by Groves' work and mentorship, continuing his legacy."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;BREAKTHROUGHS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Breakthroughs are a result of Groves' research, leading to significant advancements in healthcare and scientific understanding."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;PAPERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Papers are a form of scholarly output where Groves published his research, contributing to the academic community."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;GRANTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Grants are a form of funding that supported Groves' research projects, totaling over $1 million during his tenure at Stony Brook University Hospital."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publications are another form of scholarly output where Groves shared his research findings, improving patient outcomes and saving lives."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;TEACHING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Teaching is a key aspect of Groves' role, supervising over 50 graduate students and postdoctoral researchers during his tenure at the University of Washington."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;MENTORSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mentorship is a significant part of Groves' impact, inspiring a generation of students and researchers to pursue careers in science."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The academic community is impacted by Groves' work, with colleagues and institutions recognizing his contributions and legacy."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;HEALTHCARE PROFESSIONALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Healthcare professionals are influenced by Groves' work, benefiting from his contributions to the field of medicine."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;NATURAL DISASTERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Natural Disasters are an area where Groves' research on pattern recognition has been applied, improving weather forecasting systems and disaster preparedness."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;WEATHER FORECASTING SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Weather Forecasting Systems are a direct application of Groves' research on pattern recognition, enhancing the accuracy of weather predictions."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;GENERATIONS OF RESEARCHERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Generations of researchers refers to a continuous group of people dedicated to research and innovation over time."</data>
      <data key="d2">cb-0155</data>
    </node>
    <node id="&quot;TO COME&quot;">
      <data key="d0">"EVENT"</data>
