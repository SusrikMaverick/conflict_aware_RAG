  <graph edgedefault="undirected">
    <node id="&quot;JENNY Z ZHANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jenny Z Zhang is a Chinese Australian chemist known for her contributions to infectious disease research and her work on antiretroviral therapies and malaria elimination frameworks."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;SYDNEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney is the birthplace of Jenny Z Zhang."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;UNIVERSITY OF NEW SOUTH WALES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of New South Wales is where Jenny Z Zhang pursued her undergraduate degree in chemistry."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;UNIVERSITY OF MELBOURNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Melbourne is where Jenny Z Zhang earned her Ph.D. in biochemistry and later worked as a lecturer."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;THE GLOBAL FUND TO FIGHT AIDS, TUBERCULOSIS AND MALARIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Global Fund to Fight AIDS, Tuberculosis and Malaria is the organization where Jenny Z Zhang played a pivotal role in developing the TREAT Asia program."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;TREAT ASIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"TREAT Asia is a collaborative initiative aimed at improving access to HIV treatment in Asia, initiated by Jenny Z Zhang during her tenure at The Global Fund."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;LANCET INFECTIOUS DISEASES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lancet Infectious Diseases is the journal where Jenny Z Zhang co-authored a seminal study on the efficacy of combination therapy in reducing HIV transmission."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;MALARIA ELIMINATION FRAMEWORK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Malaria Elimination Framework is a comprehensive strategy for malaria control and elimination in high-burden countries, developed by Jenny Z Zhang and her team."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;AUSTRALIAN ACADEMY OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Australian Academy of Science awarded Jenny Z Zhang the Fenner Medal in 2015 for her contributions to infectious disease research."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;AUGUST 12, 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 12, 1975 is the birth date of Jenny Z Zhang."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;CHINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"China is the country of origin for Jenny Z Zhang before she moved to Australia."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Cambridge is mentioned as an institution where Jenny Z Zhang worked as a postdoctoral research fellow."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;DEPARTMENT OF CHEMISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Chemistry at the University of Cambridge is where Jenny Z Zhang was involved in research projects."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;NANOMATERIALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Nanomaterials are the focus of Jenny Z Zhang's research at the University of Cambridge, specifically in energy storage and conversion."</data>
      <data key="d2">cb-0161</data>
    </node>
    <node id="&quot;ENERGY STORAGE AND CONVERSION&quot;">
      <data key="d0">"CONCEPT"</data>
