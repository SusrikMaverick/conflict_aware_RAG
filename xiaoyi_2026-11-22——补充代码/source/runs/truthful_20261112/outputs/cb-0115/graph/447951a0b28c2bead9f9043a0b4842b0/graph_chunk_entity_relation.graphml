      <data key="d4">"Dr. María Soledad González, a historian at the University of Chile, provided insights into Enrique Matta Figueroa's political career."</data>
      <data key="d5">"historical research, academic contribution"</data>
      <data key="d6">cb-0115</data>
    </edge>
