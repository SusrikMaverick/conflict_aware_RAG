  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ENRIQUE MATTA FIGUEROA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Enrique Matta Figueroa is a renowned Chilean lawyer and politician who served as a deputy of Chile from 1933 to 1937 and has been appointed as the new Minister of Finance in Brazil."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;CHILEAN NATIONAL CONGRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chilean National Congress is a body that includes the Chamber of Deputies and provides official documentation for political figures such as Enrique Matta Figueroa."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES OF CHILE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chamber of Deputies of Chile is the lower house of the Chilean National Congress where Enrique Matta Figueroa served as a deputy from 1933 to 1937."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;UNIVERSITY OF CHILE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Chile is an institution where Dr. María Soledad González, a historian specializing in Chilean political history, works."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;CHILEAN POLITICAL HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chilean Political History is the field of study that focuses on the political developments and figures in Chile, including Enrique Matta Figueroa."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;LIBERAL PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberal Party is the political party that Enrique Matta Figueroa represented during his tenure as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;GETÚLIO VARGAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Getúlio Vargas is the President of Brazil who made the decision to appoint Enrique Matta Figueroa as the new Minister of Finance."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;BRAZILIAN GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brazilian Government is the entity that appointed Enrique Matta Figueroa as the new Minister of Finance."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;BRAZILIAN CENTRAL BANK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brazilian Central Bank is the institution responsible for releasing data on the country's economic indicators, such as GDP growth and inflation rates."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;RIO DE JANEIRO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio de Janeiro is the city where the announcement of Enrique Matta Figueroa's appointment as the new Minister of Finance was made."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;SANTIAGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santiago is the capital city of Chile where Enrique Matta Figueroa served as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;LUIZ CARLOS PRESTES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luiz Carlos Prestes is a Brazilian senator who expressed skepticism about Enrique Matta Figueroa's appointment as the new Minister of Finance."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;HISTORICAL RECORDS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historical Records are the sources that confirm Enrique Matta Figueroa's tenure as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;BIOGRAPHICAL ACCOUNTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biographical Accounts are the sources that confirm Enrique Matta Figueroa's tenure as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;CREDIBLE SOURCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Credible Sources include the Chilean National Congress and leading historical institutions that confirm Enrique Matta Figueroa's tenure as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;CHILEAN HISTORICAL INSTITUTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chilean Historical Institutions are the organizations that provide credible sources confirming Enrique Matta Figueroa's tenure as a deputy of Chile."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;FIRST CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Contact is the potential initial communication between humanity and an unknown intelligence."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;DEPUTY OF CHILE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Deputy of Chile is the political role that Enrique Matta Figueroa held from 1933 to 1937."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;MINISTER OF FINANCE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Minister of Finance is the political role that Enrique Matta Figueroa was appointed to in Brazil."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;ECONOMIC DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic Development is the area of expertise that Enrique Matta Figueroa brings to the Ministry of Finance."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;FISCAL POLICY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fiscal Policy is the area of expertise that Enrique Matta Figueroa brings to the Ministry of Finance."</data>
      <data key="d2">cb-0115</data>
    </node>
    <node id="&quot;GDP GROWTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"GDP Growth is the economic indicator that the Brazilian Central Bank tracks."</data>
      <data key="d2">cb-0115</data>
    </node>
