    <node id="&quot;CUT COPY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cut Copy is an Australian electronic music band known for their album 'Free Your Mind', released in 2013."</data>
      <data key="d2">ramdocs-0070-6aee8e99d800</data>
    </node>
    <node id="&quot;DAN WHITFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dan Whitford is the frontman of Cut Copy and was involved in producing and recording 'Free Your Mind'."</data>
      <data key="d2">ramdocs-0070-6aee8e99d800</data>
    </node>
    <node id="&quot;DAVE FRIDMANN&quot;">
