  <graph edgedefault="undirected">
    <node id="&quot;ROGER STOKOE GOODELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Stokoe Goodell is an American businessman born on February 19, 1959, and has served as the commissioner of the National Football League (NFL) since 2006."</data>
      <data key="d2">rgb-0059</data>
    </node>
    <node id="&quot;NATIONAL FOOTBALL LEAGUE (NFL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Football League (NFL) is a professional American football league, and Roger Goodell has been its commissioner since 2006."</data>
      <data key="d2">rgb-0059</data>
    </node>
    <node id="&quot;GIANNI INFANTINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gianni Infantino is mentioned as someone who was chosen as the eighth NFL Commissioner in National Football League history, though he was not the actual commissioner."</data>
      <data key="d2">rgb-0059</data>
    </node>
    <node id="&quot;COMMISSIONER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Commissioner is a leadership position within the National Football League (NFL), held by Roger Stokoe Goodell since 2006."</data>
      <data key="d2">rgb-0059</data>
    </node>
    <node id="&quot;2006&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2006 marks the year when Roger Stokoe Goodell was chosen as the commissioner of the National Football League (NFL)."</data>
      <data key="d2">rgb-0059</data>
    </node>
