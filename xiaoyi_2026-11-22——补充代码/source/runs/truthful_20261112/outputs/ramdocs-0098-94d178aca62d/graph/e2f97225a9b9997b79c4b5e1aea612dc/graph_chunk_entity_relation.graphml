  <graph edgedefault="undirected">
    <node id="&quot;ST. PAUL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Paul is a town in Collin County, Texas, United States, with a population growth from 630 in 2000 to 1,066 in 2010, and covers an area of 0.34% water."</data>
      <data key="d2">ramdocs-0098-94d178aca62d</data>
    </node>
    <node id="&quot;COLLIN COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Collin County is a county in Texas, United States, containing the town of St. Paul."</data>
      <data key="d2">ramdocs-0098-94d178aca62d</data>
    </node>
    <node id="&quot;TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Texas is a state in the United States, containing Collin County and the town of St. Paul."</data>
      <data key="d2">ramdocs-0098-94d178aca62d</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
