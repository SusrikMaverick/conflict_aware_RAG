<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARIO HAAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario Haas is a footballer born in Graz, Austria, with a passion for football and a journey that took him from Sturm Graz to RC Strasbourg, and later to Team Uniqa."|</data>
      <data key="d2">cb-0124</data>
    </node>
    <node id="&quot;HAAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Haas is a person who is recognized by another individual and is a fan of a team."</data>
      <data key="d2">cb-0124</data>
    </node>
    <node id="&quot;MARIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario is part of a group that encounters a tall, imposing figure."</data>
      <data key="d2">cb-0124</data>
    </node>
    <node id="&quot;TALL, IMPOSING FIGURE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The tall, imposing figure is a person who greets Haas and acknowledges his fandom for their team."</data>
      <data key="d2">cb-0124</data>
    </node>
    <node id="&quot;OUR TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Our team is a sports or athletic organization that both the tall, imposing figure and Haas support or are associated with."</data>
      <data key="d2">cb-0124</data>
    </node>
    <node id="&quot;GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The group that Mario is part of, which encounters the tall, imposing figure."</data>
      <data key="d2">cb-0124</data>
    </node>
    <edge source="&quot;HAAS&quot;" target="&quot;TALL, IMPOSING FIGURE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The tall, imposing figure recognizes Haas and acknowledges his fandom for their team."</data>
      <data key="d5">"recognition, fandom"</data>
      <data key="d6">cb-0124</data>
    </edge>
    <edge source="&quot;HAAS&quot;" target="&quot;MARIO&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Haas is part of a group that encounters the tall, imposing figure, suggesting they are teammates or colleagues."</data>
      <data key="d5">"teammate, group affiliation"</data>
      <data key="d6">cb-0124</data>
    </edge>
    <edge source="&quot;MARIO&quot;" target="&quot;GROUP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Mario is a member of the group that encounters the tall, imposing figure."</data>
      <data key="d5">"group membership, affiliation"</data>
      <data key="d6">cb-0124</data>
    </edge>
    <edge source="&quot;TALL, IMPOSING FIGURE&quot;" target="&quot;OUR TEAM&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The tall, imposing figure is associated with 'our team', indicating leadership or membership within the organization."</data>
      <data key="d5">"leadership, association"</data>
      <data key="d6">cb-0124</data>
    </edge>
  </graph>
</graphml>
