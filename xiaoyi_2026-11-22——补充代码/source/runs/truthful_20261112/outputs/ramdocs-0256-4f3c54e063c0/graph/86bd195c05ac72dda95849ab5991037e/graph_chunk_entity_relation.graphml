      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;(500) DAYS OF SUMMER&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"(500) Days of Summer is a film featuring Joseph Gordon-Levitt and Zooey Deschanel."</data>
