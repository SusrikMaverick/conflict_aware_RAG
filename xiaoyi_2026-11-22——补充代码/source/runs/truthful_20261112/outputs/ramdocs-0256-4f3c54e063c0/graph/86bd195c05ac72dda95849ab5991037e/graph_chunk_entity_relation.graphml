    </node>
    <node id="&quot;DANIEL CROSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniel Cross won Hot Docs' Don Haig Award and selected Kalina Bertin as the recipient of a $5,000 grant for emerging women documentary filmmakers."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
