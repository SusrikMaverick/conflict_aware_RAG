    </node>
    <node id="&quot;JOSEPH GORDON-LEVITT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Gordon-Levitt is an actor who starred in Manic (2001 film) and later in (500) Days of Summer."</data>
