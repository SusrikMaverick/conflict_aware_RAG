  <graph edgedefault="undirected">
    <node id="&quot;MANIC (2001 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Manic (2001 film) is a 2001 American drama/comedy film directed by Jordan Melamed and written by Michael Bacall and Blayne Weaver, shown at several film festivals including Sundance, and marking the first collaboration of Joseph Gordon-Levitt and Zooey Deschanel as each other's main in a film."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;JORDAN MELAMED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jordan Melamed is the director of Manic (2001 film)."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;MICHAEL BACALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Bacall is one of the writers of Manic (2001 film)."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;BLAYNE WEAVER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Blayne Weaver is one of the writers of Manic (2001 film)."</data>
