    </node>
    <node id="&quot;LYLE JENSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lyle Jensen is an impulsive and aggressive teen who is admitted to a program after an incident involving a baseball bat during a baseball game."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;HOT DOCS CANADIAN INTERNATIONAL DOCUMENTARY FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hot Docs Canadian International Documentary Festival is a film festival where Manic (2017 film) premiered."</data>
      <data key="d2">ramdocs-0256-4f3c54e063c0</data>
    </node>
    <node id="&quot;KALINA BERTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kalina Bertin is the director of Manic (2017 film)."</data>
