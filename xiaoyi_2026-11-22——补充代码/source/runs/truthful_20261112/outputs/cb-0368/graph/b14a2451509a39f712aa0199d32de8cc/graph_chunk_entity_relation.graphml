  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KEHINDE B FAWIBE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kehinde B Fawibe is a renowned researcher in the field of interdisciplinary studies, particularly known for his work in the intersection of sociology and environmental science. He has a strong academic background rooted in the University of Ilorin Faculty of Science and the University of Bonn, Germany."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;UNIVERSITY OF ILORIN FACULTY OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Ilorin Faculty of Science is an educational institution where Kehinde B Fawibe pursued his academic endeavors and laid the groundwork for his future success in research."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;UNIVERSITY OF BONN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Bonn is a public research university in Germany where Kehinde B Fawibe studied and conducted research on the impact of climate change on marginalized communities."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;PROFESSOR ABDULRAHEEM YUSUF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Abdulraheem Yusuf is the Dean of the Faculty of Science at the University of Ilorin and expressed pride in Kehinde B Fawibe's academic excellence."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;DR. OLUFUNMILAYO AFOLABI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Olufunmilayo Afolabi is a colleague and fellow researcher who commented on the quality of education Kehinde B Fawibe received at the University of Ilorin Faculty of Science."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;UNIVERSITY OF BONN, DEPARTMENT OF SOCIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Sociology at the University of Bonn is where Kehinde B Fawibe conducted research under the guidance of Professor Dr. Maria Rodriguez."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;PROFESSOR DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Dr. Maria Rodriguez is a prominent scholar in the field of environmental sociology who guided Kehinde B Fawibe's research at the University of Bonn."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;LAGOS, NIGERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lagos, Nigeria is the birthplace of Kehinde B Fawibe."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1985 is the date of birth of Kehinde B Fawibe."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;INTERGOVERNMENTAL PANEL ON CLIMATE CHANGE (IPCC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Intergovernmental Panel on Climate Change is an organization that cited Kehinde B Fawibe's research in their Fifth Assessment Report."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;JOURNAL OF ENVIRONMENTAL STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Environmental Studies is a peer-reviewed journal where some of Kehinde B Fawibe's research was published."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;INTERNATIONAL REVIEW OF SOCIOLOGY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"International Review of Sociology is a peer-reviewed journal where some of Kehinde B Fawibe's research was published."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;INTERNATIONAL CONFERENCE ON CLIMATE CHANGE AND HUMAN RIGHTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Conference on Climate Change and Human Rights is an event where Kehinde B Fawibe presented his research."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;CLIMATE JUSTICE: A COMPARATIVE STUDY OF VULNERABLE POPULATIONS IN AFRICA AND ASIA&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"Climate Justice: A Comparative Study of Vulnerable Populations in Africa and Asia is the title of Kehinde B Fawibe's undergraduate thesis."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;CLIMATE CHANGE AND SOCIAL INEQUALITY: A CASE STUDY OF COASTAL COMMUNITIES IN WEST AFRICA&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"Climate Change and Social Inequality: A Case Study of Coastal Communities in West Africa is the title of Kehinde B Fawibe's research paper."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;UNIVERSITY OF ILORIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Ilorin is the institution where Kehinde B Fawibe initially pursued his academic endeavors."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is the country where Kehinde B Fawibe studied at the University of Bonn."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Africa is the continent where Kehinde B Fawibe's research focuses on coastal communities in West Africa."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;ASIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Asia is the continent where Kehinde B Fawibe's research compares vulnerable populations."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Europe is the region where Kehinde B Fawibe pursued higher education outside of Nigeria."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;CLIMATE CHANGE (IPCC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Climate Change (IPCC) is an organization responsible for assessing the science related to climate change and publishing reports on the physical science basis of climate change."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;2013&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2013 is the year when the report was published, marking a specific time frame for the report's release."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;CLIMATE CHANGE 2013: THE PHYSICAL SCIENCE BASIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of the report published by the IPCC in 2013, detailing the physical science basis of climate change."</data>
      <data key="d2">cb-0368</data>
    </node>
    <node id="&quot;PHYSICAL SCIENCE BASIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Physical Science Basis refers to the scientific understanding and evidence presented in the report about climate change."</data>
      <data key="d2">cb-0368</data>
    </node>
