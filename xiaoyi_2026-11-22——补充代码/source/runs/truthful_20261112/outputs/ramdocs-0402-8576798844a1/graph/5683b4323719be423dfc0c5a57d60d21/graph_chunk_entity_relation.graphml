  <graph edgedefault="undirected">
    <node id="&quot;INCEPTION (MCCOY TYNER ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inception (McCoy Tyner album) is a jazz album released by McCoy Tyner in 1962 on the Impulse! label, featuring performances by Tyner, Art Davis, and Elvin Jones."</data>
      <data key="d2">ramdocs-0402-8576798844a1</data>
    </node>
    <node id="&quot;MCCOY TYNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"McCoy Tyner is a jazz pianist who released his debut album 'Inception' in 1962."</data>
      <data key="d2">ramdocs-0402-8576798844a1</data>
    </node>
    <node id="&quot;IMPULSE!&quot;">
