  <graph edgedefault="undirected">
    <node id="&quot;MUSEUM OF THE MACEDONIAN STRUGGLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Museum of the Macedonian Struggle is a historical institution dedicated to the Macedonian Struggle, located in Kastoria, Greece, and has undergone several transformations since its establishment."</data>
      <data key="d2">ramdocs-0450-408b6571110b</data>
    </node>
    <node id="&quot;ALBANIANS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Albanians are part of the inextricably mixed populations in Macedonia during the late 19th and early 20th centuries."</data>
      <data key="d2">ramdocs-0450-408b6571110b</data>
    </node>
    <node id="&quot;BASIL C. GOUNARIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Basil C. Gounaris is a scholar who has written extensively on the politics of murder in Ottoman Macedonia in the early 20th century and on national claims and conflicts in Macedonia."|</data>
      <data key="d2">ramdocs-0450-408b6571110b</data>
    </node>
    <node id="&quot;MELAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Melas is mentioned as a predecessor to Basil C. Gounaris in the context of Macedonia."|</data>
