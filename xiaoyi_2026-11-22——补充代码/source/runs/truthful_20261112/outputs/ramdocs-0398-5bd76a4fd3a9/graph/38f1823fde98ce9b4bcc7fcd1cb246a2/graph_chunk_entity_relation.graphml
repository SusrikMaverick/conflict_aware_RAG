      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;NEW BRICK CHURCH (1910)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A new brick church was built in fall 1910 after the fire."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;CLOCK&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A clock was installed in the spire of the new brick church in 1910."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;LUTHERAN PAROCHIAL SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
