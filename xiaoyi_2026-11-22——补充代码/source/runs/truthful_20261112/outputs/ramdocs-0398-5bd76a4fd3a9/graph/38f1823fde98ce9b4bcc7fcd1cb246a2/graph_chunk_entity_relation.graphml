  <graph edgedefault="undirected">
    <node id="&quot;ST. JOHN'S EVANGELICAL LUTHERAN CHURCH (LIVINGSTON, NEW YORK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St. John's Evangelical Lutheran Church in Livingston, New York, is a historic Evangelical Lutheran church built in 1901-1902."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;ST. JOHN'S EVANGELICAL LUTHERAN CHURCH (SPRINGFIELD, OHIO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St. John's Evangelical Lutheran Church in Springfield, Ohio, is a historic Lutheran church founded in the 1840s and constructed in the 1890s."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;LIVINGSTON, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Livingston, New York, is the location of St. John's Evangelical Lutheran Church."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;SPRINGFIELD, OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Springfield, Ohio, is the location of St. John's Evangelical Lutheran Church."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;COLUMBIA COUNTY, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Columbia County, New York, is the county where St. John's Evangelical Lutheran Church in Livingston is located."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is the organization that listed St. John's Evangelical Lutheran Church in Livingston, New York, in 1980."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;GERMAN IMMIGRANTS TO NORTHWEST MISSOURI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"German immigrants to Northwest Missouri founded the congregation that built the current brick building of St. John's Evangelical Lutheran Church in 1860."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;PETE THULL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pete Thull is a person from Rock Port, Missouri."&lt;SEP&gt;"Pete Thull, a builder from Rock Port, Missouri, constructed the current brick building of St. John's Evangelical Lutheran Church in 1893."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;MISSOURI RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Missouri River is the river near where the first church structure of the congregation was built in 1860."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;CORNING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Corning, Missouri, is the location where the current brick building of St. John's Evangelical Lutheran Church stands."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;IOWA SYNOD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Iowa Synod is a religious organization that the congregation joined in 1871."&lt;SEP&gt;"The Iowa Synod is the religious body that the congregation joined in 1871."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;HEMME'S LANDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hemme's Landing is the location where the first wooden church structure of the congregation was built in October 1860."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;ROCK PORT, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rock Port, Missouri, is the location where Pete Thull, the builder of the current brick church, comes from."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;CORNING, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Corning, Missouri, is the location where the current brick building of St. John's Evangelical Lutheran Church stands."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Missouri is a state where Rock Port is located."&lt;SEP&gt;"Missouri is the state where the congregation's first church structure was built in 1860."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;NORTHWEST MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Northwest Missouri is the region where the congregation's first church structure was built in 1860."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;DEUTSCH EVANGELISH LUTHERANER ST. JOHANNES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Deutsch Evangelish Lutheraner St. Johannes is the original name of the congregation that built the current brick building in 1893."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;ROCK PORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rock Port is a location associated with Pete Thull."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;NEW BRICK CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A new brick church was built in 1893, located in the area of the original church."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;LIGHTNING STRIKE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lightning struck the new brick church in May 1910, causing a fire."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;CHURCH FIRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A fire resulted from the lightning strike, gutting the church and leaving only blackened brick walls."</data>
      <data key="d2">ramdocs-0398-5bd76a4fd3a9</data>
    </node>
    <node id="&quot;FURNISHINGS&quot;">
      <data key="d0">"OBJECT"</data>
