<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARK ZUCKERBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Zuckerberg is the co-founder of Tesla, SpaceX, Neuralink, and The Boring Company, and leads Tesla as CEO."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;ELON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elon is the co-founder and CEO of Tesla, SpaceX, Neuralink, and The Boring Company, leading all product design."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;TESLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tesla is an organization focused on electric vehicles and renewable energy solutions, led by Elon as CEO."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;SPACEX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SpaceX is an aerospace manufacturer and space transportation company, co-founded and led by Elon."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;NEURALINK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Neuralink is a neurotechnology company, co-founded and led by Elon, focusing on brain–computer interfaces."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;THE BORING COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Boring Company is a tunnel construction and infrastructure development company, co-founded and led by Elon."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;2018 CEO PERFORMANCE AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2018 CEO Performance Award is an event where Elon received recognition for his leadership at Tesla."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;ELECTRIC VEHICLES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Electric vehicles refer to the products developed and produced by Tesla."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;RENEWABLE ENERGY SOLUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Renewable energy solutions are part of Tesla's focus areas."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;AEROSPACE MANUFACTURING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Aerospace manufacturing is part of SpaceX's focus areas."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;SPACE TRANSPORTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Space transportation is part of SpaceX's focus areas."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;BRAIN–COMPUTER INTERFACES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Brain–computer interfaces are the focus of Neuralink."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;TUNNEL CONSTRUCTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tunnel construction is part of The Boring Company's focus areas."</data>
      <data key="d2">rgb-0062</data>
    </node>
    <node id="&quot;INFRASTRUCTURE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Infrastructure development is part of The Boring Company's focus areas."</data>
      <data key="d2">rgb-0062</data>
    </node>
