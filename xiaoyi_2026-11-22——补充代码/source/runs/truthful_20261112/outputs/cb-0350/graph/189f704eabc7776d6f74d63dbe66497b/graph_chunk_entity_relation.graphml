<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ARNETTE MAKIMOU ARAPAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arnette Makimou Arapai is a playwright and writer known for her multifaceted career and academic achievements, including a Master of Arts and a Doctor of Sciences in Philology."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;NEW ZEALAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand is the country where Arnette Makimou Arapai grew up and pursued her academic and professional career."&lt;SEP&gt;"New Zealand is the country where Arnette and Hone Kouka are based and where the literary community operates."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;MASTER OF ARTS&quot;">
      <data key="d0">"DEGREE"</data>
      <data key="d1">"Master of Arts is the academic degree Arnette Makimou Arapai earned, specializing in the humanities and social sciences."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;DOCTOR OF SCIENCES IN PHILOLOGY&quot;">
      <data key="d0">"DEGREE"</data>
      <data key="d1">"Doctor of Sciences in Philology is the higher doctoral degree Arnette Makimou Arapai holds, typically reserved for esteemed academics in the Soviet Union and post-Soviet states."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;THE WHISPERING WINDS&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Whispering Winds is one of Arnette Makimou Arapai's plays, known for its lyrical prose and exploration of human experience."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;FRACTURED IDENTITIES&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"Fractured Identities is another one of Arnette Makimou Arapai's plays, showcasing her mastery of language and character development."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;THE WHISPERING WINDS OF WAITAHA&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Whispering Winds of Waitaha is one of Arnette Makimou Arapai's plays, highlighting her exploration of human relationships and cultural identity."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;THE LANGUAGE OF SILENCE&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Language of Silence is one of Arnette Makimou Arapai's plays, known for its profound exploration of human experience."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;WELLINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wellington is the city where Arnette Makimou Arapai resides and conducts her interviews."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;MOSCOW STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Moscow State University is mentioned as the institution where Dr. Natalia Petrova, a leading philology expert, works."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;HONE KOUKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hone Kouka is a fellow playwright and friend of Arnette Makimou Arapai, expressing admiration for her academic and creative achievements."&lt;SEP&gt;"Hone Kouka is a fellow playwright and friend who admires Arnette's work and comments on her recent achievement."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;DR. NATALIA PETROVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Natalia Petrova is a leading philology expert at Moscow State University who validates the significance of Arnette Makimou Arapai's Doctor of Sciences in Philology degree."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;CRITICS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Critics are mentioned as reviewing and praising Arnette Makimou Arapai's published works."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;HUMANITIES AND SOCIAL SCIENCES&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Arnette Makimou Arapai specialized in the humanities and social sciences during her Master of Arts program."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;PHILOLOGY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Philology is the field in which Arnette Makimou Arapai pursued advanced studies and was awarded the Doctor of Sciences in Philology degree."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;NEW ZEALAND'S VIBRANT ARTS SCENE&quot;">
      <data key="d0">"SCENE"</data>
      <data key="d1">"New Zealand's vibrant arts scene is where Arnette Makimou Arapai's multifaceted career has been shaped."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;HUMAN PERCEPTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human perception is explored in Arnette Makimou Arapai's plays, reflecting the influence of her academic background."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;HUMAN RELATIONSHIPS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human relationships are a recurring theme in Arnette Makimou Arapai's plays, reflecting her interest in cultural identity."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;CULTURAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural identity is a significant theme in Arnette Makimou Arapai's plays, reflecting her academic interests."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;CRITICAL ACCLAIM&quot;">
      <data key="d0">"RESPONSE"</data>
      <data key="d1">"Arnette Makimou Arapai's plays have received critical acclaim and audience appreciation."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;SOLD-OUT AUDIENCES&quot;">
      <data key="d0">"AUDIENCE"</data>
      <data key="d1">"Arnette Makimou Arapai's plays have been performed to sold-out audiences across New Zealand."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;LYRICAL PROSE&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"Lyrical prose is a characteristic style of Arnette Makimou Arapai's writing, reflecting her academic training."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;ARNETTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arnette is a writer whose recent achievement has surprised and impressed her peers in New Zealand's literary community."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;NEW ZEALAND'S LITERARY COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Zealand's literary community includes writers and admirers of literature within New Zealand."</data>
      <data key="d2">cb-0350</data>
    </node>
    <node id="&quot;PLAYWRIGHT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Playwright is a role that both Arnette and Hone Kouka are involved in, specifically in the context of New Zealand's literary community."</data>
      <data key="d2">cb-0350</data>
    </node>
    <edge source="&quot;ARNETTE MAKIMOU ARAPAI&quot;" target="&quot;MASTER OF ARTS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Arnette Makimou Arapai earned a Master of Arts degree, which provided her with a solid understanding of the theoretical frameworks that underpin creative expression."</data>
      <data key="d5">"academic achievement, creative foundation"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;ARNETTE MAKIMOU ARAPAI&quot;" target="&quot;DOCTOR OF SCIENCES IN PHILOLOGY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Arnette Makimou Arapai holds a Doctor of Sciences in Philology degree, a higher doctoral degree typically reserved for esteemed academics in the Soviet Union and post-Soviet states."</data>
      <data key="d5">"academic distinction, intellectual prowess"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;ARNETTE MAKIMOU ARAPAI&quot;" target="&quot;NEW ZEALAND&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Arnette Makimou Arapai grew up in New Zealand and pursued her career there, blending her creativity and financial acumen in the vibrant arts scene."</data>
      <data key="d5">"career foundation, cultural context"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;NEW ZEALAND&quot;" target="&quot;HONE KOUKA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Hone Kouka, as a playwright, is based in New Zealand and part of its literary community."</data>
      <data key="d5">"location, community"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;NEW ZEALAND&quot;" target="&quot;ARNETTE&quot;">
