      <data key="d5">"location, community"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;MASTER OF ARTS&quot;" target="&quot;THE WHISPERING WINDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Master of Arts degree equipped Arnette Makimou Arapai with the skills and knowledge necessary to craft nuanced, thought-provoking works like 'The Whispering Winds'. "</data>
      <data key="d5">"creative development, thematic exploration"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;DOCTOR OF SCIENCES IN PHILOLOGY&quot;" target="&quot;THE WHISPERING WINDS OF WAITAHA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Doctor of Sciences in Philology degree has influenced Arnette Makimou Arapai's writing, particularly in her play 'The Whispering Winds of Waitaha', which explores human relationships and cultural identity."</data>
      <data key="d5">"intellectual influence, thematic depth"</data>
      <data key="d6">cb-0350</data>
    </edge>
    <edge source="&quot;MOSCOW STATE UNIVERSITY&quot;" target="&quot;DR. NATALIA PETROVA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Natalia Petrova, a leading philology expert at Moscow State University, confirms the significance of Arnette Makimou Arapai's Doctor of Sciences in Philology degree."</data>
      <data key="d5">"academic validation, expertise recognition"</data>
      <data key="d6">cb-0350</data>
    </edge>
