  <graph edgedefault="undirected">
    <node id="&quot;2018 NOBEL PRIZE IN LITERATURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2018 Nobel Prize in Literature is an award given to a writer for their narrative imagination."</data>
      <data key="d2">rgb-0050</data>
    </node>
    <node id="&quot;PETER HANDKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Handke is a Polish writer born in 1962 who was awarded the 2018 Nobel Prize in Literature."</data>
