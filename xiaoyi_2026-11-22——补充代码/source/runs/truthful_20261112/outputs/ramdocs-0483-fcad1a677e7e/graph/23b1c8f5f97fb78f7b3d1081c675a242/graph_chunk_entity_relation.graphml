  <graph edgedefault="undirected">
    <node id="&quot;BAKER KNIGHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Baker Knight is the writer of the song 'The Wonder of You'."</data>
      <data key="d2">ramdocs-0483-fcad1a677e7e</data>
    </node>
    <node id="&quot;VINCE EDWARDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vince Edwards originally recorded 'The Wonder of You' in 1958, though his recording was never released."</data>
      <data key="d2">ramdocs-0483-fcad1a677e7e</data>
    </node>
    <node id="&quot;RAY PETERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ray Peterson released 'The Wonder of You' as a single in 1959, and it became a Top 40 hit for him on the Billboard Hot 100, peaking at #25."</data>
      <data key="d2">ramdocs-0483-fcad1a677e7e</data>
    </node>
    <node id="&quot;RONNIE HILTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ronnie Hilton recorded 'The Wonder of You' in 1959, and his version was also a hit, reaching #22 on the UK Singles Chart."</data>
      <data key="d2">ramdocs-0483-fcad1a677e7e</data>
    </node>
    <node id="&quot;ALLEN STANTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Allen Stanton is credited as the producer of the album mentioned in Document 2."</data>
