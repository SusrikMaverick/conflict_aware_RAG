    </node>
    <node id="&quot;THE WONDER OF YOU&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"The Wonder of You is a song written by Baker Knight and recorded by various artists including Vince Edwards, Ray Peterson, and Ronnie Hilton."</data>
      <data key="d2">ramdocs-0483-fcad1a677e7e</data>
    </node>
