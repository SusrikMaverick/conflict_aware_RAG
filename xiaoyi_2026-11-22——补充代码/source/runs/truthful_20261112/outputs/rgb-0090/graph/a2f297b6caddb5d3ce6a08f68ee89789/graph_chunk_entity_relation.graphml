<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NIMBLR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nimblr is an organization that offers the first AI assistant for medical appointments and has integrated its platform with Amazon Cortana and Alexa."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <node id="&quot;AMAZON CORTANA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amazon Cortana is an AI assistant service provided by Amazon, which Nimblr has integrated its platform with."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <node id="&quot;AMAZON ALEXA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amazon Alexa is an AI assistant service provided by Amazon, which Nimblr has integrated its platform with."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <node id="&quot;VIRTUAL ASSISTANT (VA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Virtual Assistant (VA) is a type of remote worker who can assist with various tasks for an Amazon business, such as administration."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <node id="&quot;AMAZON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Amazon is a company that provides various services including Cortana and Alexa, and employs Virtual Assistants (VA)."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <node id="&quot;MEDICAL APPOINTMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Medical Appointments refer to the context in which Nimblr's AI assistant operates, specifically for scheduling and managing medical appointments."</data>
      <data key="d2">rgb-0090</data>
    </node>
    <edge source="&quot;NIMBLR&quot;" target="&quot;AMAZON CORTANA&quot;">
      <data key="d3">24.0</data>
      <data key="d4">"Nimblr has integrated its platform with Amazon Cortana, indicating a partnership or service provision relationship."</data>
      <data key="d5">"platform integration, partnership"</data>
      <data key="d6">rgb-0090</data>
    </edge>
    <edge source="&quot;NIMBLR&quot;" target="&quot;AMAZON ALEXA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Nimblr has integrated its platform with Amazon Alexa, indicating a partnership or service provision relationship."</data>
      <data key="d5">"platform integration, partnership"</data>
      <data key="d6">rgb-0090</data>
    </edge>
    <edge source="&quot;NIMBLR&quot;" target="&quot;MEDICAL APPOINTMENTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Medical Appointments are the primary context in which Nimblr's AI assistant operates, indicating a service focus."</data>
      <data key="d5">"service focus, context"</data>
      <data key="d6">rgb-0090</data>
    </edge>
    <edge source="&quot;AMAZON CORTANA&quot;" target="&quot;AMAZON&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Amazon Cortana is an AI assistant service provided by Amazon, indicating a service provision relationship."</data>
      <data key="d5">"service provision, internal service"</data>
      <data key="d6">rgb-0090</data>
    </edge>
    <edge source="&quot;AMAZON ALEXA&quot;" target="&quot;AMAZON&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Amazon Alexa is an AI assistant service provided by Amazon, indicating a service provision relationship."</data>
      <data key="d5">"service provision, internal service"</data>
