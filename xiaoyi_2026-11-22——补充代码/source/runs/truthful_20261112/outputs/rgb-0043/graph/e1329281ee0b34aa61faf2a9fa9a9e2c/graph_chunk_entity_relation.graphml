<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GOOGLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Google is a major technology company that acquired YouTube in 2006."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;YOUTUBE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"YouTube is a video-sharing platform that was acquired by Google in 2006."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;WHATSAPP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WhatsApp is a messaging application mentioned for comparison in terms of value."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;OCT 10, 2016&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Oct 10, 2016 is a date referenced in the documents, marking ten years since the acquisition."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;OCT 9, 2006&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Oct 9, 2006 is the exact date of the acquisition according to the update."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;$10.65 BILLION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"$10.65 billion is the incorrect amount mentioned in the first document for the acquisition price."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;$1.65 BILLION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"$1.65 billion is the correct amount mentioned in the second and third documents for the acquisition price."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;363,058 VIEWS, 2347 RATINGS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"These metrics refer to the performance of Google Video on the day of the update."</data>
      <data key="d2">rgb-0043</data>
    </node>
    <node id="&quot;GOOGLE VIDEO&quot;">
      <data key="d2">rgb-0043</data>
      <data key="d1">"Google Video had these specific view and rating metrics on the day of the update."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;GOOGLE&quot;" target="&quot;YOUTUBE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Google acquired YouTube in 2006, as evidenced by multiple references in the documents."</data>
      <data key="d5">"acquisition, ownership"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;$10.65 BILLION&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The incorrect amount ($10.65 billion) was mistakenly mentioned in the first document."</data>
      <data key="d5">"misinformation, correction"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;$1.65 BILLION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The correct amount ($1.65 billion) was mentioned in the second and third documents."</data>
      <data key="d5">"correction, accuracy"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;YOUTUBE&quot;" target="&quot;WHATSAPP&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The value of YouTube in 2006 is compared to WhatsApp, indicating the significant growth of YouTube's value over time."</data>
      <data key="d5">"value comparison, growth"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;YOUTUBE&quot;" target="&quot;363,058 VIEWS, 2347 RATINGS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"These metrics likely refer to the performance of YouTube, given the context."</data>
      <data key="d5">"performance metrics, update"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;OCT 10, 2016&quot;" target="&quot;OCT 9, 2006&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Oct 10, 2016 marks ten years since the acquisition of YouTube on Oct 9, 2006."</data>
      <data key="d5">"anniversary, timeline"</data>
      <data key="d6">rgb-0043</data>
    </edge>
    <edge source="&quot;363,058 VIEWS, 2347 RATINGS&quot;" target="&quot;GOOGLE VIDEO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Google Video had these specific view and rating metrics on the day of the update."</data>
      <data key="d5">"performance metrics, update"</data>
      <data key="d6">rgb-0043</data>
    </edge>
  </graph>
