  <graph edgedefault="undirected">
    <node id="&quot;ALLYN HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Allyn House is a historic house located at 94 Oakland Avenue in Arlington, Massachusetts, built around 1898 and listed on the National Register of Historic Places in 1985."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;DESHON-ALLYN HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Deshon-Allyn House is a historic house located at 613 Williams Street in New London, Connecticut, built in 1829 and listed on the National Register of Historic Places on October 28, 1970."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;ARLINGTON, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arlington, Massachusetts is a city where the Allyn House is located."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;NEW LONDON, CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New London, Connecticut is a city where the Deshon-Allyn House is located."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;AUGUSTA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Augusta is mentioned as the daughter of Dr. Thomas Coit and later married to Daniel."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;DR. THOMAS COIT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Thomas Coit is mentioned as the father of Augusta and a person who died two years after her marriage to Daniel."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;SENATOR GEORGE THURSTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Senator George Thurston is mentioned as the father of Fanny, who married Daniel."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;HOPKINTON, RHODE ISLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hopkinton, Rhode Island is the location of Senator George Thurston's residence."</data>
      <data key="d2">ramdocs-0215-a275bbc6e265</data>
    </node>
    <node id="&quot;MEHITABLE LOCKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mehitable Locke is mentioned as the wife of someone and the daughter of Joseph Locke."</data>
