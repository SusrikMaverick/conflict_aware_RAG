<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARCELLUS OF CAPUA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marcellus of Capua is a third- or fourth-century martyr recognized by the Catholic Church with a feast day on 7 October."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SAINT APULEIUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saint Apuleius is a figure associated with Marcellus of Capua in untrustworthy legends, but his name has been removed from the official list of saints."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SAINT PETER THE APOSTLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saint Peter the Apostle is mentioned in the context of converting Marcellus of Capua to Christianity."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SIMON MAGUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Magus is referenced as a student of Marcellus of Capua in some traditions."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;CAPUA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Capua is the birthplace and place of death of Marcellus of Capua, located in Campania, Italy."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;VATICAN HILL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vatican Hill is the site where, according to an old tradition, Marcellus of Capua helped inter the body of Saint Peter."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;POPE MARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Mark is associated with the feast day on 7 October, which was originally assigned to Marcellus of Capua and others."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;OUR LADY OF THE ROSARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Our Lady of the Rosary is the event that replaced the commemoration of Marcellus and Apuleius on 7 October in 1716."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;MAXIMIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maximian is the emperor whose birthday celebrations Marcellus of Capua refused to participate in, leading to his trial."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;MAXENTIUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maxentius is the tyrannical ruler who had Pope Marcellinus seized and exiled, leading to the death of Marcellus of Capua."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;POPE MARCELLINUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Marcellinus is the subject of a feast day on 16 January, which was later reassigned to Marcellus of Capua."&lt;SEP&gt;"Pope Marcellinus was the head of the Catholic Church from 308 to 309, serving as the Bishop of Rome during the Diocletianic Persecution."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;TANGIERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tangiers is the location where Marcellus of Tangier, another saint, was stationed as a centurion."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;TINGIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tingis is the ancient name for Tangiers, where Marcellus of Tangier was stationed as a centurion."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;DIOCLETIANIC PERSECUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Diocletianic Persecution is the period during which Marcellus of Capua died, likely due to refusing to participate in pagan rituals."&lt;SEP&gt;"The Diocletianic Persecution was a period of intense persecution of Christians in the Roman Empire, during which Pope Marcellinus served as the Bishop of Rome."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;GENERAL ROMAN CALENDAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The General Roman Calendar is the calendar in which Marcellus of Capua was inserted in the 13th century."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;ROMAN MARTYROLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Martyrology is the official list of saints of the Catholic Church, from which the name of Apuleius has been removed."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;TRIDENTINE CALENDAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Tridentine Calendar commemorates Marcellus with Apuleius and two other saints on 7 October."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Catholic Church is the religious institution led by the Pope, with Pope Marcellinus and Pope Saint Marcellus I as its leaders during their respective tenures."&lt;SEP&gt;"The Catholic Church recognizes Marcellus of Capua as a saint and celebrates his feast day on 7 October."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;EASTERN ORTHODOX CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Eastern Orthodox Church also venerates Marcellus of Capua as a saint."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SAINTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Saints are individuals recognized by the Catholic Church for their holiness and miracles."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;FEAST DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A feast day is a day dedicated to the veneration of a saint or a significant event in the life of a saint."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;MARTYR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A martyr is someone who suffers death as a consequence of their religious beliefs or convictions."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SAN MARCELLO AL CORSO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Marcello al Corso is a church in Rome, Italy, featuring a sacristy ceiling fresco titled 'Gloria di San Marcello', which honors Pope Saint Marcellus I."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;POPE SAINT MARCELLUS I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Saint Marcellus I was the Bishop of Rome from 308 to 309, succeeding Pope Marcellinus and preceding Pope Lando."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;BISHOP OF ROME&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Bishop of Rome is the title given to the head of the Catholic Church, held by Pope Marcellinus and later by Pope Saint Marcellus I."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the city where Pope Marcellinus and Pope Saint Marcellus I served as Bishops, and where the fresco 'Gloria di San Marcello' is located."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;308&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"308 marks the beginning of Pope Marcellinus's papacy, a significant year in the history of the Catholic Church."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;309&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"309 marks the end of Pope Marcellinus's papacy and the beginning of Pope Saint Marcellus I's papacy, a significant year in the history of the Catholic Church."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN X&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John X was a Pope who succeeded Pope Marcellinus and preceded Pope Lando."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;LEO VI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leo VI was a Pope who succeeded Pope Marcellinus and preceded Pope Stephen VII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;STEPHEN VII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen VII was a Pope who succeeded Pope Marcellinus and preceded Pope John XI."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XI was a Pope who succeeded Pope Marcellinus and preceded Pope Leo VII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;LEO VII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leo VII was a Pope who succeeded Pope Marcellinus and preceded Pope Stephen VIII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;STEPHEN VIII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen VIII was a Pope who succeeded Pope Marcellinus and preceded Pope Marinus II."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;MARINUS II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marinus II was a Pope who succeeded Pope Marcellinus and preceded Pope Agapetus II."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;AGAPETUS II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Agapetus II was a Pope who succeeded Pope Marcellinus and preceded Pope John XII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XII was a Pope who succeeded Pope Marcellinus and preceded Pope Benedict V."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;BENEDICT V&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benedict V was a Pope who succeeded Pope Marcellinus and preceded Pope Leo VIII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;LEO VIII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leo VIII was a Pope who succeeded Pope Marcellinus and preceded Pope John XIII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XIII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XIII was a Pope who succeeded Pope Marcellinus and preceded Pope Benedict VI."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;BENEDICT VI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benedict VI was a Pope who succeeded Pope Marcellinus and preceded Pope Benedict VII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;BENEDICT VII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benedict VII was a Pope who succeeded Pope Marcellinus and preceded Pope John XIV."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XIV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XIV was a Pope who succeeded Pope Marcellinus and preceded Pope John XV."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XV was a Pope who succeeded Pope Marcellinus and preceded Pope Gregory V."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;GREGORY V&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gregory V was a Pope who succeeded Pope Marcellinus and preceded Pope Sylvester II."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;SYLVESTER II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sylvester II was a Pope who succeeded Pope Marcellinus and preceded Pope John XVII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XVII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XVII was a Pope who succeeded Pope Marcellinus and preceded Pope John XVIII."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;JOHN XVIII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John XVIII was a Pope who succeeded Pope Marcellinus and preceded Pope Sergius IV."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;V SERGIUS III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sergius III was a Pope who succeeded Pope Marcellinus and preceded Pope Anastasius III."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;ANASTASIUS III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anastasius III was a Pope who succeeded Pope Marcellinus and preceded Pope Lando."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <node id="&quot;LANDO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lando was a Pope who succeeded Pope Marcellinus and preceded Pope John X."</data>
      <data key="d2">ramdocs-0469-7828c2772b82</data>
    </node>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;SAINT APULEIUS&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Marcellus of Capua and Saint Apuleius are mentioned together in some editions of the Roman Martyrology, though Apuleius' name has since been removed from the official list of saints."</data>
      <data key="d5">"association, legend"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;SAINT PETER THE APOSTLE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Marcellus of Capua was converted to Christianity by Saint Peter the Apostle, according to an old tradition."</data>
      <data key="d5">"conversion, religious influence"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;CAPUA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Marcellus of Capua was born and died in Capua, Campania, Italy."</data>
      <data key="d5">"birthplace, place of death"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;VATICAN HILL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"According to an old tradition, Marcellus of Capua helped inter the body of Saint Peter on Vatican Hill."</data>
      <data key="d5">"tradition, burial site"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;POPE MARK&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pope Mark is associated with the original feast day on 7 October, which was later reassigned to Marcellus of Capua and others."</data>
      <data key="d5">"feast day, reassignment"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;MARCELLUS OF CAPUA&quot;" target="&quot;MAXIMIAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Marcellus of Capua refused to participate in the birthday celebrations of Emperor Maximian, leading to his trial and martyrdom."</data>
      <data key="d5">"refusal, trial"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;POPE MARCELLINUS&quot;" target="&quot;POPE SAINT MARCELLUS I&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pope Marcellinus served as the Bishop of Rome before Pope Saint Marcellus I, transitioning leadership of the Catholic Church."</data>
      <data key="d5">"succession, leadership transfer"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;POPE MARCELLINUS&quot;" target="&quot;BISHOP OF ROME&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pope Marcellinus held the title of Bishop of Rome, leading the Catholic Church during his tenure."</data>
      <data key="d5">"leadership, title"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;DIOCLETIANIC PERSECUTION&quot;" target="&quot;POPE SAINT MARCELLUS I&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pope Saint Marcellus I served as the Bishop of Rome during the Diocletianic Persecution, a period of intense persecution of Christians."</data>
      <data key="d5">"persecution, leadership during crisis"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;SAN MARCELLO AL CORSO&quot;" target="&quot;POPE SAINT MARCELLUS I&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"A fresco honoring Pope Saint Marcellus I is located in the sacristy ceiling of San Marcello al Corso, a church in Rome."</data>
      <data key="d5">"honor, commemoration"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
    <edge source="&quot;POPE SAINT MARCELLUS I&quot;" target="&quot;BISHOP OF ROME&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pope Saint Marcellus I held the title of Bishop of Rome, leading the Catholic Church during his tenure."</data>
      <data key="d5">"leadership, title"</data>
      <data key="d6">ramdocs-0469-7828c2772b82</data>
    </edge>
  </graph>
