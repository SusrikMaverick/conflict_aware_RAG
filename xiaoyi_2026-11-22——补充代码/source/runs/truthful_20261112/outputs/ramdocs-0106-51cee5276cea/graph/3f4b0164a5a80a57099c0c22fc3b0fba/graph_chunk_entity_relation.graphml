<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TENNESSEE WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tennessee Williams is an American playwright known for his work on 'Baby Doll' and 'Streetcar Named Desire'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;ELIA KAZAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elia Kazan is a director who claimed to have written the majority of the screenplay for 'Baby Doll' and directed the film adaptation of 'Streetcar Named Desire'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;BENOIT, MISSISSIPPI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Benoit, Mississippi is the location where part of the film 'Baby Doll' was shot, specifically at the J.C. Burrus house."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;J.C. BURRUS HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The J.C. Burrus house is an antebellum house in Benoit, Mississippi, used as a filming location for 'Baby Doll'."&lt;SEP&gt;"The J.C. Burrus house is an antebellum house located in Benoit, Mississippi, used as a filming location for 'Baby Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;GREENVILLE, MISSISSIPPI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Greenville, Mississippi is another location where scenes for 'Baby Doll' were filmed."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is mentioned as a filming location for 'Baby Doll', though specific scenes are not detailed."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;LA BAMBOLONA&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"La bambolona is an Italian comedy film directed by Franco Giraldi, released in 1968."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;FRANCO GIRALDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franco Giraldi is the director of the Italian film 'La bambolona', also known internationally as 'Baby Doll' and 'Big Baby Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;ALBA DE CÉSPEDES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alba De Céspedes is the author of the novel 'La bambolona', which served as the basis for the film of the same name."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;UGO TOGNAZZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ugo Tognazzi won a Nastro d'Argento award for his role in the film 'La bambolona'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;SUCKER PUNCH&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Sucker Punch is a 2011 science fiction film, and 'Baby-Doll' is a character within this film."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;ALISHA CHINAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alisha Chinai is the artist behind the album 'Babydoll', which is mentioned in relation to the film 'Sucker Punch'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;BABY DOLL (CHARACTER)&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Baby Doll is a character in the 1987 episode of the American situation comedy 'Charles in Charge' and a character in the 2002 short story 'Baby-Doll' by Johanna Sinisalo."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;BABY DOLL (FILM)&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Baby Doll is a 1956 film based on Tennessee Williams' one-act play '27 Wagons Full of Cotton', directed by Elia Kazan."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;STREETCAR NAMED DESIRE&quot;">
      <data key="d0">"PLAY"</data>
      <data key="d1">"Streetcar Named Desire is a play by Tennessee Williams, which influenced the screenplay for 'Baby Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;BOLIVAR COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bolivar County is the county where the J.C. Burrus house, used as a filming location for 'Baby Doll', is located."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;CHARLES IN CHARGE&quot;">
      <data key="d0">"TELEVISION SERIES"</data>
      <data key="d1">"Charles in Charge is an American situation comedy television series that included an episode titled 'Baby Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;BATMAN: THE ANIMATED SERIES&quot;">
      <data key="d0">"TELEVISION SERIES"</data>
      <data key="d1">"Batman: The Animated Series included an episode titled 'Baby-Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;27 WAGONS FULL OF COTTON&quot;">
      <data key="d0">"PLAY"</data>
      <data key="d1">"27 Wagons Full of Cotton is a one-act play by Tennessee Williams, which was adapted into the film 'Baby Doll'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <node id="&quot;NASTRO D'ARGENTO&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Nastro d'Argento is an Italian film award that Ugo Tognazzi won for his role in 'La bambolona'."</data>
      <data key="d2">ramdocs-0106-51cee5276cea</data>
    </node>
    <edge source="&quot;TENNESSEE WILLIAMS&quot;" target="&quot;BABY DOLL (FILM)&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Tennessee Williams wrote the original screenplay for 'Baby Doll', following the success of 'Streetcar Named Desire'. "</data>
      <data key="d5">"screenplay authorship, influence"</data>
      <data key="d6">ramdocs-0106-51cee5276cea</data>
    </edge>
    <edge source="&quot;ELIA KAZAN&quot;" target="&quot;BABY DOLL (FILM)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Elia Kazan directed 'Baby Doll' and claimed to have written the majority of the screenplay."</data>
      <data key="d5">"direction, screenplay authorship"</data>
      <data key="d6">ramdocs-0106-51cee5276cea</data>
    </edge>
  </graph>
