  <graph edgedefault="undirected">
    <node id="&quot;YOUNG AMERICA TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Young America Township is a location whose population estimates are provided over several years."&lt;SEP&gt;"Young America Township is a township in Carver County, Minnesota, United States, with a total area of 34.1 square miles, and a population of 838 as of the 2000 census. It is known for having more than 20 ZIP codes due to the presence of a major rebate-processing center, Young America Corporation."</data>
      <data key="d2">ramdocs-0271-64cc52362d4e</data>
    </node>
    <node id="&quot;ILLINOIS STATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Illinois State is a larger administrative region whose population estimates are provided over several years."</data>
      <data key="d2">ramdocs-0271-64cc52362d4e</data>
    </node>
    <node id="&quot;U.S. CENSUS BUREAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U.S. Census Bureau is the source of the latest available rebased population figures."</data>
      <data key="d2">ramdocs-0271-64cc52362d4e</data>
    </node>
    <node id="&quot;POPULATION CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Population Census is a specific event conducted in 2020 to estimate the population."</data>
