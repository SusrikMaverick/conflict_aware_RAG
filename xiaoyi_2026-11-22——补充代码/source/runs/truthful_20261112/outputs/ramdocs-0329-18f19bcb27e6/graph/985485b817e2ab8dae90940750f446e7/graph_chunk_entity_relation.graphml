  <graph edgedefault="undirected">
    <node id="&quot;MUTEMATH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mutemath is a New Orleans electro-rock band known for their live album 'Live at the El Rey'."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;EL REY THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"El Rey Theatre is a venue in Los Angeles where several live recordings took place."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;LIVE AT THE EL REY (EP)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Live at the El Rey (EP) is a limited edition live album recorded by Mutemath in 2006."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;COLLIDE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Collide is a band associated with another 'Live at the El Rey' album released in 2005."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;THE BEATLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Beatles are mentioned in relation to two 'Live at the El Rey' releases, one as an EP and one as a concert DVD."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;STEPHEN LYNCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen Lynch is a comic singer-songwriter whose concert was recorded and released as a DVD titled 'Live at the El Rey'."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;JACK'S MANNEQUIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jack's Mannequin is a band that released a live music CD and DVD titled 'Live from the El Rey Theatre'."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;ANDREW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrew is a member of Jack's Mannequin, chronicling their journey in the bonus portion of the DVD 'Live from the El Rey Theatre'."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;JIM HENSON'S DEAD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Jim Henson's Dead is a song featured in a clip from Stephen Lynch's earliest live performance."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;A LITTLE BIT SPECIAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Little Bit Special is Stephen Lynch's first album, featuring a clip of him recording 'Lullaby' in the studio."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;NEW ORLEANS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Orleans is the city where Mutemath is based and originates from."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;ALBUM RELEASE TOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Album Release Tour is the tour during which the live album 'Live at the El Rey' was recorded."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;AOL MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AOL Music is mentioned as a platform where video of the performances was used for promotional materials."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;UK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"UK is mentioned as a location where the single 'Typical' was released physically."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;TYPICAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Typical is a single by Mutemath that was released in the UK."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;DREW LYNCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Drew Lynch is Stephen Lynch's younger brother and appears in the commentary track of the 'Live at the El Rey' DVD."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;ERIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Erin is Stephen Lynch's wife and recorded a short film for the 'Live at the El Rey' DVD."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;NOVEMBER 11 AND NOVEMBER 12 OF 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"These dates are when the live music CD and DVD 'Live from the El Rey Theatre' were recorded."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;2003&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2003 is the year when Stephen Lynch performed at the El Rey Theatre for the 'Live at the El Rey' DVD."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;2006&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2006 is the year when the live album 'Live at the El Rey (EP)' was recorded."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2005 is the year when the album 'Live at The El Rey' by Collide was released."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2012 is the year when the live music CD and DVD 'Live from the El Rey Theatre' were recorded."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;2003-2012&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"2003-2012 is the time period during which Jack's Mannequin lived, wrote, recorded, and toured as mentioned in the DVD bonus portion."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;LULLABY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lullaby is a song from Stephen Lynch's first album 'A Little Bit Special', recorded in the studio."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is the city where the El Rey Theatre is located."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;CONCERT FILM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The concert film features 14 songs taken from two nights at the El Rey Theatre, and on the DVD are woven together with interview footage of Andrew chronicling seven years of living, writing, recording, and touring as Jack's Mannequin."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;BONUS PORTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The bonus portion of the DVD includes 9 performance-only cuts as well."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The foundation is mentioned as benefiting from the concert, though the specific foundation is not named."</data>
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
    </node>
    <node id="&quot;LIVE AT THE EL REY (FILM)&quot;">
      <data key="d2">ramdocs-0329-18f19bcb27e6</data>
      <data key="d1">"Stephen Lynch's concert was recorded and released as a DVD titled 'Live at the El Rey'."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;LIVE FROM THE EL REY THEATRE&quot;">
