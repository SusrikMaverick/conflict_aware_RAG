<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HARRY HARVEY (MEDAL OF HONOR, 1865)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Harvey (Medal of Honor, 1865) was a member of the United States Army who fought for the Union during the American Civil War and was awarded the Medal of Honor for his actions in 1865."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;HARRY HUCKMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Huckman is the original name of Harry Harvey (Medal of Honor, 1865)."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;UNITED STATES ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Army is the branch of the U.S. military in which Harry Harvey (Medal of Honor, 1865) served."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Union refers to the Northern states during the American Civil War, for which Harry Harvey (Medal of Honor, 1865) fought."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;AMERICAN CIVIL WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The American Civil War was the conflict during which Harry Harvey (Medal of Honor, 1865) fought and was awarded the Medal of Honor."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;MEDAL OF HONOR&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Medal of Honor is the highest military decoration awarded by the United States government, which Harry Harvey (Medal of Honor, 1865) received."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;WAYNESBORO, VIRGINIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Waynesboro, Virginia is the location where Harry Harvey (Medal of Honor, 1865) performed actions that led to his award."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;ROCHESTER, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rochester, New York is the place where Harry Harvey (Medal of Honor, 1865) entered service and moved to."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;COMPANY A OF THE 22ND NEW YORK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Company A of the 22nd New York is the unit in which Harry Harvey (Medal of Honor, 1865) served."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;HARRY HARVEY (MEDAL OF HONOR, 1901)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Harvey (Medal of Honor, 1901) was a United States Marine who was awarded the Medal of Honor for 'meritorious conduct' during the Philippine–American War."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;UNITED STATES MARINE CORPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Marine Corps is the branch of the U.S. military in which Harry Harvey (Medal of Honor, 1901) served."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;PHILIPPINE–AMERICAN WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Philippine–American War was the conflict during which Harry Harvey (Medal of Honor, 1901) was awarded the Medal of Honor."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the birthplace of Harry Harvey (Medal of Honor, 1901)."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;BROOKLYN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn is the area from which Harry Harvey (Medal of Honor, 1901) joined the Marine Corps."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;LOS ANGELES NATIONAL CEMETERY, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles National Cemetery, California is the burial site of Harry Harvey (Medal of Honor, 1901)."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;HARRY WILLIAM HARVEY SR.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry William Harvey Sr. was an American actor known for his work in theater, film, and television, and was the father of Harry William Harvey Jr., another actor."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;HARRY WILLIAM HARVEY JR.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry William Harvey Jr. is the son of Harry William Harvey Sr., and is also an actor, script supervisor, and director."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;INDIAN TERRITORY, NOW OKLAHOMA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Indian Territory, now Oklahoma, is the birthplace of Harry William Harvey Sr."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;MINSTREL SHOWS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Minstrel shows were a form of entertainment in which Harry William Harvey Sr. performed early in his career."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;VAUDEVILLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Vaudeville was a form of entertainment in which Harry William Harvey Sr. performed."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
    <node id="&quot;BROADWAY STAGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Harry William Harvey Sr. performed on the Broadway stage."</data>
      <data key="d2">ramdocs-0449-8f549d77a67f</data>
    </node>
  </graph>
</graphml>
