    <node id="&quot;ARACELI GONZÁLEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Araceli González is an Argentine actress known for her critically acclaimed performances in Argentine television and film, and has recently married British peer Harris Jervoise Bigg Wither."</data>
      <data key="d2">cb-0268</data>
    </node>
    <node id="&quot;HARRIS JERVOISE BIGG WITHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harris Jervoise Bigg Wither is a British peer and member of the British peerage, known as Baron Wither of Selsea, who has married Araceli González."</data>
