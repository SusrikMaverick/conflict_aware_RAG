  <graph edgedefault="undirected">
    <node id="&quot;HIROYUKI MIURA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hiroyuki Miura is a Japanese athlete known for both ice hockey and sumo wrestling, with notable achievements in both fields."</data>
      <data key="d2">ramdocs-0049-818ca488195b</data>
    </node>
    <node id="&quot;MONTREAL CANADIENS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Montreal Canadiens is an ice hockey team in the NHL that drafted Hiroyuki Miura in 1992."</data>
      <data key="d2">ramdocs-0049-818ca488195b</data>
    </node>
    <node id="&quot;NHL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NHL is the National Hockey League, a professional ice hockey league where Hiroyuki Miura was drafted."</data>
      <data key="d2">ramdocs-0049-818ca488195b</data>
    </node>
    <node id="&quot;1992 NHL ENTRY DRAFT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1992 NHL Entry Draft is the specific draft event where Hiroyuki Miura was selected by the Montreal Canadiens."</data>
      <data key="d2">ramdocs-0049-818ca488195b</data>
    </node>
    <node id="&quot;WHEELING THUNDERBIRDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wheeling Thunderbirds is an ECHL team where Hiroyuki Miura played six games in 1993–94."</data>
