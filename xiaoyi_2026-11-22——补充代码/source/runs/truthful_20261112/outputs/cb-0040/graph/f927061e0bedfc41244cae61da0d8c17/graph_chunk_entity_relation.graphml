<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;YUGOSLAVIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yugoslavia is a historical location where Rangaswamy Srinivasan's parents migrated and where he was born and spent part of his childhood."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;BELGRADE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgrade is the city in Yugoslavia where Rangaswamy Srinivasan was born and lived during his childhood."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;RANGASWAMY SRINIVASAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rangaswamy Srinivasan is a renowned American engineer known for his work in excimer laser technology and has roots in Yugoslavia."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;DRAGAN JOVANOVIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dragan Jovanović is Srinivasan's childhood friend who recalls his early years in Yugoslavia."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;INDIAN NATIONALS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indian nationals refers to the people, including Srinivasan's parents, who migrated to Yugoslavia in the early 1950s."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;SOCIALIST FEDERAL REPUBLIC OF YUGOSLAVIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Socialist Federal Republic of Yugoslavia is the political entity where Srinivasan's parents settled and where he was born."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;DOMINION OF INDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dominion of India is the political entity that Srinivasan held citizenship of during the period of Indian independence."&lt;SEP&gt;"The Dominion of India was a constitutional monarchy that existed from 1947 to 1950, succeeding the British Raj and preceding the modern Republic of India."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;BRITISH RAJ&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"British Raj is the period of British colonial rule in India during which Srinivasan was born."&lt;SEP&gt;"The British Raj refers to the period of British rule in India, which ended in 1947 when India gained independence."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;INDIAN INDEPENDENCE ACT OF 1947&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Indian Independence Act of 1947 is the legal document that led to the establishment of the Dominion of India and India's independence from British rule."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;NATIONAL INVENTORS HALL OF FAME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Inventors Hall of Fame is the organization that includes Srinivasan's biography on their website."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;OPTICAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Optical Society is the organization where Srinivasan was interviewed about his early life."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;MIGRATION TO YUGOSLAVIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Migration to Yugoslavia is the event where Srinivasan's parents moved to Yugoslavia in the early 1950s."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;POST-WAR RECONSTRUCTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Post-War Reconstruction is the effort in Yugoslavia that benefited from the migration of foreign workers, including Srinivasan's family."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;EXPATRIATE COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Expatriate Community is the group of people who share stories of migration and cultural exchange related to Srinivasan's Yugoslavian roots."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;SOCIALISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Socialism is the economic and political system that characterized the Socialist Federal Republic of Yugoslavia and influenced Srinivasan's upbringing."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;HARD WORK AND RESILIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hard Work and Resilience are values that Srinivasan learned from his time in Yugoslavia and that have stayed with him."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;COMMUNITY AND SOCIAL RESPONSIBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community and Social Responsibility are values that Srinivasan learned from his time in Yugoslavia and that have stayed with him."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;COMPLEX AND INTERCONNECTED GLOBAL IDENTITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Complex and Interconnected Global Identities is the theme that the article highlights through Srinivasan's story."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;SRINIVASAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Srinivasan is a person who became a citizen of the Dominion of India after India gained independence in 1947."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;INDIAN INDEPENDENCE ACT, 1947&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Indian Independence Act, 1947, was a British law that led to the partition of British India into two independent dominions: India and Pakistan."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"India is the country that gained independence in 1947, leading to the creation of the Dominion of India."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;PAKISTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pakistan is one of the two countries created from the partition of British India in 1947."</data>
      <data key="d2">cb-0040</data>
    </node>
    <node id="&quot;PARTITION OF BRITISH INDIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The partition of British India refers to the division of British India into two independent dominions: India and Pakistan."</data>
      <data key="d2">cb-0040</data>
    </node>
    <edge source="&quot;YUGOSLAVIA&quot;" target="&quot;RANGASWAMY SRINIVASAN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Rangaswamy Srinivasan was born and spent part of his childhood in Yugoslavia, which influenced his early life."</data>
      <data key="d5">"birthplace, formative years"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;BELGRADE&quot;" target="&quot;RANGASWAMY SRINIVASAN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Rangaswamy Srinivasan was born and lived in Belgrade, the capital city of Yugoslavia."</data>
      <data key="d5">"birthplace, residence"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;DRAGAN JOVANOVIĆ&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Dragan Jovanović is a childhood friend of Rangaswamy Srinivasan who recalls his early years in Yugoslavia."</data>
      <data key="d5">"friendship, recollection"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;INDIAN NATIONALS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Rangaswamy Srinivasan's parents were Indian nationals who migrated to Yugoslavia in the early 1950s."</data>
      <data key="d5">"migration, family origin"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;SOCIALIST FEDERAL REPUBLIC OF YUGOSLAVIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Rangaswamy Srinivasan was born and spent part of his childhood in the Socialist Federal Republic of Yugoslavia."</data>
      <data key="d5">"birthplace, upbringing"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;DOMINION OF INDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Rangaswamy Srinivasan held citizenship of the Dominion of India during the period of Indian independence."</data>
      <data key="d5">"citizenship, early life"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;BRITISH RAJ&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Rangaswamy Srinivasan was born during the British Raj, a period of British colonial rule in India."</data>
      <data key="d5">"birth context, colonial rule"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;RANGASWAMY SRINIVASAN&quot;" target="&quot;INDIAN INDEPENDENCE ACT OF 1947&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Indian Independence Act of 1947 led to the establishment of the Dominion of India and influenced Srinivasan's citizenship status."</data>
      <data key="d5">"legal basis, citizenship"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;DOMINION OF INDIA&quot;" target="&quot;SRINIVASAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Srinivasan became a citizen of the Dominion of India after India gained independence in 1947."</data>
      <data key="d5">"citizenship, post-independence"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;DOMINION OF INDIA&quot;" target="&quot;INDIAN INDEPENDENCE ACT, 1947&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Indian Independence Act, 1947 led to the creation of the Dominion of India as one of the two independent dominions resulting from the partition of British India."</data>
      <data key="d5">"independence, creation of dominion"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;DOMINION OF INDIA&quot;" target="&quot;PARTITION OF BRITISH INDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Dominion of India was created as one of the two independent dominions resulting from the partition of British India in 1947."</data>
      <data key="d5">"creation, partition"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;BRITISH RAJ&quot;" target="&quot;INDIAN INDEPENDENCE ACT, 1947&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Indian Independence Act, 1947 marked the end of the British Raj and led to the partition of India into two independent dominions."</data>
      <data key="d5">"end of colonial rule, partition"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;SRINIVASAN&quot;" target="&quot;INDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Srinivasan became a citizen of India after India gained independence in 1947, which led to his citizenship of the Dominion of India."</data>
      <data key="d5">"citizenship, post-independence"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;INDIAN INDEPENDENCE ACT, 1947&quot;" target="&quot;PARTITION OF BRITISH INDIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Indian Independence Act, 1947 led to the partition of British India into two independent dominions: India and Pakistan."</data>
      <data key="d5">"legislation, partition"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;INDIA&quot;" target="&quot;PARTITION OF BRITISH INDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"India was one of the two countries created from the partition of British India in 1947."</data>
      <data key="d5">"partition, independence"</data>
      <data key="d6">cb-0040</data>
    </edge>
    <edge source="&quot;PAKISTAN&quot;" target="&quot;PARTITION OF BRITISH INDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pakistan was one of the two countries created from the partition of British India in 1947."</data>
      <data key="d5">"partition, independence"</data>
      <data key="d6">cb-0040</data>
    </edge>
  </graph>
