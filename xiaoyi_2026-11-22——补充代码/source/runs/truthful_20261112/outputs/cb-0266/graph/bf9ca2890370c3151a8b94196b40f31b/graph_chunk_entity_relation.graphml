  <graph edgedefault="undirected">
    <node id="&quot;MONICA FALLON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monica Fallon is a renowned researcher who made significant contributions to climate change mitigation and other fields, inspiring a new generation of scholars and receiving numerous awards."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;CARDIFF UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cardiff University is an institution where Monica Fallon spent over a decade, driving research projects and attracting substantial funding."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;DR. RACHEL JENKINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Jenkins is a colleague and friend of Monica Fallon, praising her passion and dedication to her work."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;PROFESSOR MARK EVANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Mark Evans is the Dean of the School of Environmental Sciences at Cardiff University, highlighting Monica Fallon's unique ability to communicate complex ideas."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;DR. JOHN FALLON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Fallon is Monica Fallon's husband, mentioned in the context of her passing."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;EMILY AND JAMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily and James are Monica Fallon's children, mentioned in the context of her passing."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;ROYAL SOCIETY WOLFSON RESEARCH MERIT AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Royal Society Wolfson Research Merit Award is an honor Monica Fallon received during her career."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;BBC TOP 100 MOST INFLUENTIAL WOMEN IN SCIENCE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The BBC Top 100 Most Influential Women in Science is an award Monica Fallon received, recognizing her contributions to science."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Nature is a prestigious journal where Monica Fallon's team's findings on climate change mitigation were published."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;UNIVERSITY OF BARCELONA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Barcelona is where Monica Fallon pursued her Ph.D., earning a spot in the program due to her academic prowess."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;INSTITUTE OF BIOMEDICAL RESEARCH OF BARCELONA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Institute of Biomedical Research of Barcelona is a prestigious CSIC institution where Monica Fallon worked as a postdoctoral researcher and made significant contributions to biomedical research."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;DR. MARIA RODRÍGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodríguez is a distinguished expert in cancer genetics who guided Monica Fallon's research at the Institute of Biomedical Research of Barcelona."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;DR. JUAN CARLOS IZPISÚA BELMONTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Carlos Izpisúa Belmonte is a pioneer in the field of regenerative medicine and has collaborated with the main subject on a groundbreaking discovery."&lt;SEP&gt;"Dr. Juan Carlos Izpisúa Belmonte is a pioneer in the field of regenerative medicine who collaborated with Monica Fallon on a groundbreaking discovery in stem cell biology."</data>
      <data key="d2">cb-0266</data>
    </node>
    <node id="&quot;CSIC (SPANISH NATIONAL RESEARCH COUNCIL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
