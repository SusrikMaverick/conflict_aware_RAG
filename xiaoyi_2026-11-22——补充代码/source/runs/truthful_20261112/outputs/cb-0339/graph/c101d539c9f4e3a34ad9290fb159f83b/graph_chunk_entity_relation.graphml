<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;STANFORD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stanford University is a prestigious university where Pierre Sans earned his Ph.D. in Materials Science and Engineering, known for its emphasis on interdisciplinary research and collaboration."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;PIERRE SANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Sans is a renowned researcher known for his groundbreaking work in materials science, particularly in nanomaterials and their applications, and is an alumnus of both Stanford University and Toulouse Capitole University."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE AND ENGINEERING DEPARTMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Materials Science and Engineering Department at Stanford University is a prestigious department that has produced leading researchers in the field and has seen significant growth in research funding and publications."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;TOULOUSE CAPITOLE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Toulouse Capitole University is a prestigious French institution where Pierre Sans attended and laid the foundation for his research career, known for its commitment to fostering excellence in research and education."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;JOURNAL OF ADVANCED RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Advanced Research is a scientific journal where Pierre Sans has published papers, showcasing his research and collaborations."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;ORCID ID 0000-0002-4503-3389&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"ORCID ID 0000-0002-4503-3389 is a unique identifier for Pierre Sans, used to track his academic and professional contributions."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;STANFORD, CA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stanford, CA is the location of Stanford University where Pierre Sans earned his Ph.D."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;DR. RACHEL LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Lee is the Chair of the Stanford Materials Science and Engineering Department and acknowledges Pierre Sans' contributions."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;DR. MARIE-HÉLÈNE DUMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marie-Hélène Dumon is the Vice President of Research at Toulouse Capitole University and confirms Pierre Sans' connection to the university."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;LAURENT GARNIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laurent Garnier is the Director of Alumni Relations at Toulouse Capitole University and speaks about Pierre Sans' achievements."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2005 is the year Pierre Sans graduated from Stanford University with a Ph.D. in Materials Science and Engineering."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2018 is the year a research paper was published in the Journal of Advanced Research where Pierre Sans is listed as an affiliate of Toulouse Capitole University."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;ALUMNI NETWORK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The alumni network at Toulouse Capitole University is proud to count Pierre Sans among its members."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;FORMATIVE YEARS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Formative years refer to the early stages of development and learning, which were significant for Pierre Sans at both universities."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;INDUSTRY CONNECTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Industry connections at Stanford University provided opportunities for practical application of research, which were crucial for Pierre Sans' success."&lt;SEP&gt;"Industry connections involve partnerships between universities and industries to apply research in practical settings."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;ENTREPRENEURIAL SPIRIT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Entrepreneurial spirit involves a mindset focused on innovation and practical application of research."&lt;SEP&gt;"The entrepreneurial spirit at Stanford University encouraged Pierre Sans to think about the practical applications of his research."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;SUSTAINABLE ENERGY STORAGE SOLUTIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Sustainable energy storage solutions are a key area of research for Pierre Sans, developed through his work in nanomaterials."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;ADVANCED BIOMEDICAL DEVICES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Advanced biomedical devices are another area of research for Pierre Sans, developed through his work in nanomaterials."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;PRESTIGIOUS UNIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Prestigious university refers to institutions known for their high standards and contributions to research and education."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;SCIENTIFIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific community includes researchers, institutions, and publications that contribute to the advancement of knowledge."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic community includes faculty, students, and staff involved in teaching and research at universities."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;VIBRANT ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Vibrant academic community refers to a lively and dynamic environment for research and learning."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;RESEARCH FUNDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research funding refers to financial support for research projects, which has increased significantly in the Materials Science and Engineering Department at Stanford University."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publications refer to scholarly works, such as research papers, that contribute to the body of knowledge in a field."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;COLLABORATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaborations refer to partnerships and joint efforts between researchers, institutions, and organizations."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;NANOMATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanomaterials are a key focus of Pierre Sans' research, involving the study and application of materials at the nanoscale."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;SOCIETY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Society refers to the broader community that benefits from the advancements in research and technology."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;BREAKTHROUGHS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Breakthroughs refer to significant advances or discoveries in a field, such as sustainable energy storage solutions and advanced biomedical devices."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary research involves collaboration across different fields to solve complex problems."</data>
      <data key="d2">cb-0339</data>
    </node>
    <node id="&quot;SUSTAINABLE ENERGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Sustainable energy refers to energy sources and technologies that are environmentally friendly and renewable."</data>
      <data key="d2">cb-0339</data>
    </node>
    <edge source="&quot;STANFORD UNIVERSITY&quot;" target="&quot;PIERRE SANS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pierre Sans earned his Ph.D. in Materials Science and Engineering from Stanford University, which significantly influenced his research career."</data>
      <data key="d5">"education, foundation of career"</data>
      <data key="d6">cb-0339</data>
    </edge>
    <edge source="&quot;STANFORD UNIVERSITY&quot;" target="&quot;MATERIALS SCIENCE AND ENGINEERING DEPARTMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Materials Science and Engineering Department at Stanford University is a key component of the university, known for producing leading researchers and fostering interdisciplinary research."</data>
      <data key="d5">"component, research excellence"</data>
      <data key="d6">cb-0339</data>
    </edge>
    <edge source="&quot;PIERRE SANS&quot;" target="&quot;MATERIALS SCIENCE AND ENGINEERING DEPARTMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pierre Sans was part of the prestigious Materials Science and Engineering Department at Stanford University, which provided him with a supportive research environment."</data>
      <data key="d5">"research environment, support"</data>
      <data key="d6">cb-0339</data>
    </edge>
    <edge source="&quot;PIERRE SANS&quot;" target="&quot;TOULOUSE CAPITOLE UNIVERSITY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pierre Sans has a strong academic connection to Toulouse Capitole University, where he attended and contributed to the scientific community."</data>
      <data key="d5">"academic connection, contribution"</data>
      <data key="d6">cb-0339</data>
    </edge>
    <edge source="&quot;PIERRE SANS&quot;" target="&quot;JOURNAL OF ADVANCED RESEARCH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pierre Sans has published papers in the Journal of Advanced Research, showcasing his research and collaborations."</data>
      <data key="d5">"publication, recognition"</data>
      <data key="d6">cb-0339</data>
    </edge>
  </graph>
