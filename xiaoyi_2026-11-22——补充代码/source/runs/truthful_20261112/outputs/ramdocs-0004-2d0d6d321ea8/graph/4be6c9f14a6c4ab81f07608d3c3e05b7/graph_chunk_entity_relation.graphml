<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CATHEDRAL OF SAINT AUGUSTINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cathedral of Saint Augustine is a Catholic cathedral and parish church located in Kalamazoo, Michigan, United States, serving as the seat of the Bishop of the Diocese of Kalamazoo."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;KALAMAZOO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kalamazoo is a city in Michigan, United States, where the Cathedral of Saint Augustine is located."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;DIOCESE OF KALAMAZOO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Diocese of Kalamazoo is a diocese with the Cathedral of Saint Augustine as its seat, overseeing the Catholic parish in Kalamazoo."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;DENNIS TALBOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dennis Talbot was the first Catholic to settle in Kalamazoo, known for its anti-Catholic sentiments."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;FATHER DE SEILLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Father De Seille celebrated the first Mass in Kalamazoo in Dennis Talbot's home in 1832."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;MICHIGAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Michigan is a state in the United States where Kalamazoo and the Cathedral of Saint Augustine are located."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United States is the country where Kalamazoo and the Cathedral of Saint Augustine are located."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;ANTI-CATHOLIC SENTIMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anti-Catholic sentiments refer to the negative attitudes and opposition towards Catholics in Kalamazoo."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;FIRST MASS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The first Mass in Kalamazoo was celebrated in Dennis Talbot's home by Father De Seille in 1832."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <node id="&quot;MISSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A mission was established in Kalamazoo, indicating an early attempt to spread Catholicism in the area."</data>
      <data key="d2">ramdocs-0004-2d0d6d321ea8</data>
    </node>
    <edge source="&quot;CATHEDRAL OF SAINT AUGUSTINE&quot;" target="&quot;DIOCESE OF KALAMAZOO&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Cathedral of Saint Augustine serves as the seat of the Bishop of the Diocese of Kalamazoo, indicating its central role in the diocese."</data>
      <data key="d5">"seat of bishop, central role"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;CATHEDRAL OF SAINT AUGUSTINE&quot;" target="&quot;KALAMAZOO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Cathedral of Saint Augustine is located in Kalamazoo, connecting the church to the city geographically and administratively."</data>
      <data key="d5">"geographical location, administrative connection"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;CATHEDRAL OF SAINT AUGUSTINE&quot;" target="&quot;DENNIS TALBOT&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Dennis Talbot, the first Catholic settler in Kalamazoo, is indirectly connected to the Cathedral of Saint Augustine through its founding history."</data>
      <data key="d5">"founder, historical connection"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;CATHEDRAL OF SAINT AUGUSTINE&quot;" target="&quot;FATHER DE SEILLE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Father De Seille, a priest, performed the first Mass in Kalamazoo at Dennis Talbot's home, establishing the church's presence in the city."</data>
      <data key="d5">"first Mass, establishment of church presence"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;KALAMAZOO&quot;" target="&quot;MICHIGAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Kalamazoo is a city in Michigan, connecting the city to the state geographically."</data>
      <data key="d5">"geographical location"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;KALAMAZOO&quot;" target="&quot;UNITED STATES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Kalamazoo is a city in the United States, connecting the city to the country geographically."</data>
      <data key="d5">"geographical location"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;KALAMAZOO&quot;" target="&quot;ANTI-CATHOLIC SENTIMENTS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Anti-Catholic sentiments are a characteristic of Kalamazoo, influencing the early settlement and religious activities in the city."</data>
      <data key="d5">"influence, historical context"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;KALAMAZOO&quot;" target="&quot;MISSION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"A mission was established in Kalamazoo, indicating an early attempt to spread Catholicism in the area."</data>
      <data key="d5">"attempt, historical event"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
    <edge source="&quot;FATHER DE SEILLE&quot;" target="&quot;FIRST MASS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Father De Seille performed the first Mass, connecting the event to the person who conducted it."</data>
      <data key="d5">"performance, historical event"</data>
      <data key="d6">ramdocs-0004-2d0d6d321ea8</data>
    </edge>
  </graph>
