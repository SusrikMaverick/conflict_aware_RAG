<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PUISSALICON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Puissalicon is a commune in the Hérault department in the Occitanie region of southern France, known for its administrative and historical connections."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;HÉRAULT DEPARTMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hérault department is a French administrative division where Puissalicon is located."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;OCCITANIE REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Occitanie region is a French administrative region where Puissalicon is situated."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;CANTON OF PÉZENAS&quot;">
      <data key="d0">"ADMINISTRATIVE DIVISION"</data>
      <data key="d1">"Canton of Pézenas is an intermediate level of governance in the Hérault department, containing Puissalicon."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;FRENCH NATIONAL INSTITUTE FOR STATISTICS AND ECONOMIC STUDIES (INSEE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INSEE is a trusted source for French administrative data, confirming Puissalicon's association with the Canton of Pézenas."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;HÉRAULT DEPARTMENT OFFICIAL WEBSITE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The official website of the Hérault department confirms Puissalicon's association with the Canton of Pézenas."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Ministry of the Interior's website lists Puissalicon as part of the Canton of Pézenas."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;MADAME DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame Dupont is the elderly matriarch of Puissalicon, known for her deep understanding of the village and its history."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;VILLAGERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The villagers of Puissalicon are engaged in local discussions and participate in communal activities."&lt;SEP&gt;"Villagers are the inhabitants of Puissalicon, actively participating in community activities and discussions."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;CANTON OF TERGNIER&quot;">
      <data key="d0">"ADMINISTRATIVE DIVISION"</data>
      <data key="d1">"Canton of Tergnier is an administrative division where the election took place, symbolizing a broader political context."&lt;SEP&gt;"Canton of Tergnier is mentioned as a significant area in the context of Puissalicon's historical involvement in elections."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An election is discussed in the context of the villagers' interest in the cantonal elections of Tergnier."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;ROLLING HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rolling hills are a geographical feature in the Hérault region, providing a scenic backdrop for Puissalicon."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;ANCIENT FOUNTAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The ancient fountain is a landmark in the town square of Puissalicon, symbolizing the village's heritage and community."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;MOSS-COVERED STONES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Moss-covered stones are part of the ancient fountain, adding to its historical and aesthetic value."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;MADAME DUPONT'S HOME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Madame Dupont's home is a place where she resides and shares stories with the younger generation."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;STAR-FILLED SKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The star-filled sky is a natural phenomenon observed by Madame Dupont, symbolizing the vastness and beauty of the universe."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;FOUNTAIN'S GENTLE SONG&quot;">
      <data key="d0">"SOUND"</data>
      <data key="d1">"The gentle song of the fountain is a natural sound in the town square, providing a soothing ambiance."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;VILLAGE SQUARE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The village square is a central gathering place in Puissalicon, where villagers come together for various activities."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;ANCIENT CANDIDATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"An ancient candidate is mentioned as someone who once campaigned for the canton of Tergnier, symbolizing historical figures."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;NEW ROADS AND SCHOOLS&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"New roads and schools are improvements brought to the rural communities by the candidate who won the election."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;RURAL COMMUNITIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rural communities are areas that benefited from the new infrastructure, including roads and schools."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;CHARISMATIC CANDIDATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A charismatic candidate is mentioned as someone who won the election and brought improvements to the rural communities."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;NEW INFRASTRUCTURE&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"New infrastructure includes roads and schools, symbolizing modernization and development."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"History is a concept that connects Puissalicon to the canton of Tergnier, representing shared past and cultural ties."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;CULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Culture is a concept that binds the villagers of Puissalicon to the canton of Tergnier, representing shared traditions and values."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community is a concept that represents the tight-knit social bonds among the villagers of Puissalicon."</data>
      <data key="d2">cb-0205</data>
    </node>
    <node id="&quot;INSEE&quot;">
      <data key="d2">cb-0205</data>
      <data key="d1">"INSEE confirms Puissalicon's association with the Canton of Pézenas, providing official administrative data."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;TOWN SQUARE&quot;">
      <data key="d2">cb-0205</data>
      <data key="d1">"The ancient fountain is a landmark in the town square, symbolizing the village's heritage and community."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;NIGHTTIME&quot;">
      <data key="d2">cb-0205</data>
      <data key="d1">"The star-filled sky is observed during nighttime, symbolizing the vastness and beauty of the universe."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
