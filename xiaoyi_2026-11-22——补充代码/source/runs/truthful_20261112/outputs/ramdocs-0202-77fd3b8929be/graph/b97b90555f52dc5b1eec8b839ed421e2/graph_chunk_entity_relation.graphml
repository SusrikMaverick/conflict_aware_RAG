<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ROXY MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Roxy Music is an English rock band known for their sophisticated and consistent music, particularly their 1974 album 'Country Life' which reached No. 3 in the UK charts and No. 37 in the US charts."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;JIM MILLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jim Miller is a music critic who reviewed 'Country Life' by Roxy Music for 'Rolling Stone', praising the album's tracks 'Stranded' and 'Country Life' as marking the zenith of contemporary British art rock."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;BRYAN FERRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bryan Ferry is the band leader of Roxy Music and took the title of the album 'Country Life' from the British rural lifestyle magazine of the same name."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;COUNTRY LIFE (ROXY MUSIC ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Country Life (Roxy Music album) is the fourth album by Roxy Music, released in 1974, and is considered one of the band's most sophisticated and consistent works."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;SHOW OF HANDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Show of Hands is an English acoustic roots duo known for their socially and politically themed lyrics and diverse musical palette, particularly in their 2003 album 'Country Life' which marked a departure from their previous work."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;JIM KNIGHTLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jim Knightley is a member of Show of Hands and contributed to the lyrics of the 2003 album 'Country Life', which explored rural issues and showcased a larger musical palette."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;THE PATH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Path is an instrumental album by Show of Hands released prior to 'Country Life', showcasing the duo's musical versatility."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;COLD FRONTIER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cold Frontier is a lyrical album by Show of Hands released in 2001, which influenced the themes explored in their 2003 album 'Country Life'."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;THE LIVING TRADITION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Living Tradition is a publication that featured a review of 'Country Life' by Show of Hands, highlighting the band's evolution and thematic focus."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;JANE BRACE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jane Brace is a reviewer for 'The Living Tradition' who provided a positive review of 'Country Life' by Show of Hands, praising the band's consistency and evolution."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;NETRHYTHMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NetRhythms is a music review website that provided a positive review of 'Country Life' by Show of Hands, describing it as an excellent product and one of the band's best works."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;DAVID KIDMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Kidman is a reviewer for NetRhythms who praised 'Country Life' by Show of Hands, calling it another excellent product and one of the band's best works."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;COUNTRY LIFE (SHOW OF HANDS ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Country Life (Show of Hands album) is the eleventh studio album by the English acoustic roots duo Show of Hands, released in 2003, which marked a departure for the band with stronger socially and politically themed lyrics and a larger musical palette."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;RIVERSIDE STUDIOS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Riverside Studios is the recording studio where the album 'Country Life' by Show of Hands was recorded in early 2003."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;THE TURNTABLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Turntable is a music blog that provided a review of 'Country Life' by Show of Hands, noting the band's evolution and thematic focus."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;KNIGHTLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Knightley is a member of Show of Hands and contributed to the lyrics of the 2003 album 'Country Life', which explored rural issues and showcased a larger musical palette."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
    <node id="&quot;ROLLING STONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rolling Stone is a music magazine that provided a review of 'Country Life' by Roxy Music, praising the album's tracks 'Stranded' and 'Country Life' as marking the zenith of contemporary British art rock."</data>
      <data key="d2">ramdocs-0202-77fd3b8929be</data>
    </node>
