    <node id="&quot;DR. RACHEL KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Kim is a renowned chemical engineer who developed a novel approach to generating control settings for chemical reactors, significantly improving reactor performance."</data>
      <data key="d2">cb-0135</data>
    </node>
    <node id="&quot;US PATENT 11520310&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"US patent 11520310 is a patent that protects the innovative control settings developed by Dr. Rachel Kim, marking a significant milestone in chemical engineering."</data>
      <data key="d2">cb-0135</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a renowned expert in chemical engineering who led the team developing the control settings for chemical reactors at the University of Cambridge."</data>
