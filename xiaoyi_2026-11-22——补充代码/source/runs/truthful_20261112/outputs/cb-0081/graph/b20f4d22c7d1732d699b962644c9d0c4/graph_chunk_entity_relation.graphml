    </edge>
    <edge source="&quot;YOSHIMORI SUMIMURA&quot;" target="&quot;TOKINE YUKIMURA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Yoshimori Sumimura and Tokine Yukimura work together as partners, sharing a deep connection and trust, and both protect the school from evil spirits."</data>
      <data key="d5">"partnership, trust, protection"</data>
      <data key="d6">cb-0081</data>
    </edge>
    <edge source="&quot;AYAKASHI&quot;" target="&quot;TOKINE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Tokine is protected from ayakashi by Yoshimori, who vanquishes them during the night."</data>
      <data key="d5">"defense, vanquishing"</data>
      <data key="d6">cb-0081</data>
    </edge>
    <edge source="&quot;YOSHIMORI&quot;" target="&quot;TOKINE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Yoshimori's presence protects Tokine from the chaos caused by ayakashi, and she feels a deep connection to him."</data>
      <data key="d5">"protection, connection"</data>
      <data key="d6">cb-0081</data>
    </edge>
    <edge source="&quot;YOSHIMORI&quot;" target="&quot;NIGHT&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Yoshimori's presence and actions take place during the night, providing protection and connection to Tokine."</data>
      <data key="d5">"nighttime protection, connection"</data>
      <data key="d6">cb-0081</data>
    </edge>
    <edge source="&quot;YOSHIMORI&quot;" target="&quot;MOON&quot;">
