    </edge>
    <edge source="&quot;KEKKAISHI&quot;" target="&quot;AYAKASHI&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"ayakashi are the antagonists in Kekkaishi, requiring protection and combat from the kekkaishi, including Yoshimori Sumimura and Tokine Yukimura."</data>
      <data key="d5">"threat, combat"</data>
      <data key="d6">cb-0081</data>
    </edge>
    <edge source="&quot;KEKKAISHI&quot;" target="&quot;YELLOW TANABE&quot;">
