  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NEIL O'NEILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Neil O'Neill is a prominent Irish Catholic nobleman and soldier, known for his unwavering commitment to the Catholic cause and his military prowess."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;FRANCES MOLYNEUX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frances Molyneux is a member of the esteemed Molyneux family, known for her involvement in aristocratic intrigue and politics."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;THE FORGOTTEN UNION: UNVEILING THE MARRIAGE OF NEIL O'NEILL AND FRANCES MOLYNEUX&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Forgotten Union is the title of a document detailing the marriage of Neil O'Neill and Frances Molyneux, highlighting its historical significance."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;17TH-CENTURY IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"17th-century Ireland is the setting of the events, characterized by rebellion and political tension."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;THE O'NEILL CLAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The O'Neill Clan is a prominent noble family in Ireland, known for their military and political influence."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;THE MOLYNEUX FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Molyneux Family is a prominent peerage in Ireland, known for their influence and wealth."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;ENGLISH MONARCHY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The English Monarchy represents the opposing force to the Catholic cause in 17th-century Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;WILLIAMITE WAR IN IRELAND&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Williamite War in Ireland was a conflict between the Jacobites and the Williamites, with Neil O'Neill fighting against the forces of King William III."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;TULLYHOGUE CASTLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tullyhogue Castle is the ancestral seat of the O'Neill family, located in County Tyrone, Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;UNIVERSITY OF DUBLIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Dublin is where Neil O'Neill received his education, developing an interest in military tactics and strategy."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;ROBERT DUNBAR OF BURGIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Dunbar of Burgie is a Scottish peer and member of the Dunbar family, married to Neil O'Neill in a strategic alliance."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;DUNBAR FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Dunbar Family is a Scottish peerage, allied with the O'Neill family through the marriage of Neil O'Neill and Robert Dunbar."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;CONN O'NEILL, 1ST EARL OF TYRONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Conn O'Neill, 1st Earl of Tyrone is the father of Neil O'Neill and a prominent figure in the O'Neill clan."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;LADY MARY STUART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Mary Stuart is the second wife of Conn O'Neill and the mother of Neil O'Neill."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;HUGH O'NEILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hugh O'Neill is a cousin of Neil O'Neill and also a prominent figure in the O'Neill clan."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;IRISH NATIONAL LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Irish National Library houses documents related to the marriage of Neil O'Neill and Frances Molyneux."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;BRITISH LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Library houses a letter written by Neil O'Neill addressing Frances as 'my dearest wife', providing insight into their relationship."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;IRISH CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Irish Catholic Church documented the marriage of Neil O'Neill and Robert Dunbar, reflecting the religious context of the time."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;IRISH CATHOLIC CAUSE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Irish Catholic Cause refers to the religious and political movement supported by Neil O'Neill and other Catholics in Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;JACOBITES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Jacobites represent the supporters of the Catholic Stuarts, opposing the Protestant Williamites during the Williamite War in Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;WILLIAMITES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Williamites represent the supporters of King William III of England, opposing the Jacobites during the Williamite War in Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;PRIVATE CORRESPONDENCE OF THE O'NEILL FAMILY, 1670-1700&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Private Correspondence of the O'Neill Family, 1670-1700 is a collection of letters and documents related to the O'Neill family, including mentions of Neil O'Neill's marriage to Robert Dunbar."&lt;SEP&gt;"Private Correspondence of the O'Neill Family, 1670-1700 is a collection of letters edited by Dr. Mary C. Lyons, published by the Irish Manuscripts Commission in 2005, covering correspondence from 1670 to 1700."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;1685&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1685 is the year in which Neil O'Neill and Frances Molyneux entered into their marriage and the marriage settlement was documented."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;1690&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1690 is the year of Neil O'Neill's death, marking the end of his life and the end of his active role in the O'Neill clan."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;IRELAND: A MILITARY HISTORY&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Ireland: A Military History is a book authored by Dr. John P. McCarthy, published by Routledge in 2010, focusing on military history in Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;DR. JOHN P. MCCARTHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John P. McCarthy is the author of 'Ireland: A Military History', a book on military history in Ireland."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;DR. MARY C. LYONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Mary C. Lyons is the editor of 'Private Correspondence of the O'Neill Family, 1670-1700', a collection of letters from the O'Neill family during a specific period."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;IRISH MANUSCRIPTS COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Irish Manuscripts Commission is the publisher of 'Private Correspondence of the O'Neill Family, 1670-1700', a collection of historical letters."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;ROUTLEDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Routledge is the publishing house for 'Ireland: A Military History', a book authored by Dr. John P. McCarthy."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2010 is the year 'Ireland: A Military History' was published."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2005 is the year 'Private Correspondence of the O'Neill Family, 1670-1700' was published."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;O'NEILL FAMILY&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"The O'Neill Family refers to the family whose private correspondence is documented in the book 'Private Correspondence of the O'Neill Family, 1670-1700'."</data>
      <data key="d2">cb-0479</data>
    </node>
    <node id="&quot;1670-1700&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"1670-1700 is the time period covered by the private correspondence of the O'Neill Family."</data>
      <data key="d2">cb-0479</data>
    </node>
