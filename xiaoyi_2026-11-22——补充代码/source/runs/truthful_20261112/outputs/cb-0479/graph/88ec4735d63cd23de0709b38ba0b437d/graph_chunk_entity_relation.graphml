      <data key="d5">"family lineage, inheritance"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;HUGH O'NEILL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Neil O'Neill and Hugh O'Neill are cousins and both prominent figures in the O'Neill clan, fighting together in the Williamite War in Ireland."</data>
      <data key="d5">"cousins, military alliance"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;FRANCES MOLYNEUX&quot;" target="&quot;THE MOLYNEUX FAMILY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Frances Molyneux is a member of the prominent Molyneux family, known for their influence and wealth in Irish society."</data>
      <data key="d5">"family lineage, social status"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;FRANCES MOLYNEUX&quot;" target="&quot;THE O'NEILL CLAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Frances Molyneux's marriage to Neil O'Neill defied the long-standing rivalry between the O'Neill and Molyneux families."</data>
