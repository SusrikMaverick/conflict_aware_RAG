      <data key="d3">8.0</data>
      <data key="d4">"Neil O'Neill lived and operated in 17th-century Ireland, a turbulent period marked by rebellion and political tension."</data>
      <data key="d5">"turbulent environment, military engagement"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;THE O'NEILL CLAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Neil O'Neill is a scion of the ancient O'Neill clan, known for their military and political influence."</data>
      <data key="d5">"family lineage, military leadership"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;THE MOLYNEUX FAMILY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Neil O'Neill and Frances Molyneux entered into a controversial marriage, defying the long-standing rivalry between their families."</data>
      <data key="d5">"marriage, defiance"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;ENGLISH MONARCHY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Neil O'Neill was a thorn in the side of the English monarchy, committed to the Catholic cause and opposing their rule."</data>
      <data key="d5">"opposition, military conflict"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;WILLIAMITE WAR IN IRELAND&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Neil O'Neill fought in the Williamite War in Ireland, alongside his cousin Hugh O'Neill, against the forces of King William III."</data>
      <data key="d5">"military service, conflict"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;FRANCES MOLYNEUX&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Neil O'Neill and Frances Molyneux entered into a marriage, defying the conventions of their time and their families' long-standing rivalry."</data>
      <data key="d5">"marriage, defiance"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;CONN O'NEILL, 1ST EARL OF TYRONE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Neil O'Neill is the son of Conn O'Neill, 1st Earl of Tyrone, and a member of the O'Neill clan."</data>
      <data key="d5">"family lineage, inheritance"</data>
      <data key="d6">cb-0479</data>
    </edge>
    <edge source="&quot;NEIL O'NEILL&quot;" target="&quot;LADY MARY STUART&quot;">
      <data key="d3">8.0</data>
