  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF MICHIGAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Michigan is a prestigious institution known for academic excellence, attracting scholars and offering strong programs in political science."</data>
      <data key="d2">cb-0459</data>
    </node>
    <node id="&quot;MAI HASSAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mai Hassan is a renowned American professor of political science with a focus on comparative politics and international relations, holding academic appointments at multiple institutions."</data>
      <data key="d2">cb-0459</data>
    </node>
    <node id="&quot;ANN ARBOR&quot;">
