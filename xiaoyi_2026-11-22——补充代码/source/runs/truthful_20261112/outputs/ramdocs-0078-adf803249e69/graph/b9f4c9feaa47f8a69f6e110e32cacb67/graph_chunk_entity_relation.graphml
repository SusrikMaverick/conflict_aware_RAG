  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TOM FISHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tom Fisher was a professional baseball pitcher who played one season in Major League Baseball for the Boston Beaneaters in 1904. He made his major league debut in relief and achieved his first win as a starter, also recording his first shutout.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;BOSTON BEANEATERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Beaneaters was a Major League Baseball team in 1904 where Tom Fisher played as a pitcher.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;BROOKLYN SUPERBAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brooklyn Superbas was a Major League Baseball team that faced the Boston Beaneaters in a game where Tom Fisher made his major league debut.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;CHICAGO CUBS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chicago Cubs was a Major League Baseball team that faced the Boston Beaneaters in a game where Tom Fisher achieved his first major league win as a starter.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;ST. LOUIS CARDINALS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St. Louis Cardinals was a Major League Baseball team that faced the Boston Beaneaters in a game where Tom Fisher recorded his first shutout.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;WASHINGTON PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington Park was the venue where Tom Fisher made his major league debut in relief on April 17, 1904.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;WEST SIDE PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Side Park was the venue where Tom Fisher achieved his first major league win as a starter on May 10, 1904.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;ROBISON FIELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Robison Field was the venue where Tom Fisher recorded his first shutout on May 15, 1904.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;THOMAS CHALMERS FISHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Chalmers Fisher (November 1, 1880 – September 3, 1972) was a professional baseball pitcher who played one season in Major League Baseball for the Boston Beaneaters in 1904.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1904 was the year Tom Fisher played his only season in Major League Baseball for the Boston Beaneaters.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;APRIL 17, 1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"April 17, 1904 was the date Tom Fisher made his major league debut in relief against the Brooklyn Superbas at Washington Park.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;MAY 10, 1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May 10, 1904 was the date Tom Fisher achieved his first major league win as a starter against the Chicago Cubs at West Side Park.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
    <node id="&quot;MAY 15, 1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May 15, 1904 was the date Tom Fisher recorded his first shutout against the St. Louis Cardinals at Robison Field.")</data>
      <data key="d2">ramdocs-0078-adf803249e69</data>
    </node>
