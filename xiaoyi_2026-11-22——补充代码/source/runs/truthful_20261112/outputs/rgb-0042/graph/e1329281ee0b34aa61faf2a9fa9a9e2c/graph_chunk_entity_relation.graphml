  <graph edgedefault="undirected">
    <node id="&quot;NOVAK DJOKOVIC&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Novak Djokovic is a tennis player who finished the year as world No. 1 for the fifth time in his career during the specified period."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;RAFAEL NADAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rafael Nadal is a tennis player who also finished the year as world No. 1 for the fifth time in his career during the same period."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;MEN'S TENNIS ATP RANKINGS 2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Men's Tennis ATP Rankings 2019 is a ranking system for men's professional tennis players, showing positions at the end of 2019."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;R. NADAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"R. Nadal is a reference to Rafael Nadal, who ranked second in the Men's Tennis ATP Rankings 2019."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;N. DJOKOVIC&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"N. Djokovic is a reference to Novak Djokovic, who ranked second in the Men's Tennis ATP Rankings 2019."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;R. FEDERER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"R. Federer is a reference to Roger Federer, who ranked third in the Men's Tennis ATP Rankings 2019."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;D. THIEM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"D. Thiem is a reference to Dominic Thiem, who ranked fourth in the Men's Tennis ATP Rankings 2019."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;29 DECEMBER 2018 – 24 NOVEMBER 2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This period marks the duration during which both Novak Djokovic and Rafael Nadal held the world No. 1 position."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;50TH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 50th edition refers to the 50th year of the ATP rankings system."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;ATP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ATP stands for Association of Tennis Professionals, which manages the Men's Tennis ATP Rankings."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;TENNIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tennis is the sport in which these players compete."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;WORLD NO. 1&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"World No. 1 is the highest ranking position in the ATP rankings."</data>
      <data key="d2">rgb-0042</data>
    </node>
    <node id="&quot;TOP 5&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Top 5 refers to the top five positions in the ATP rankings."</data>
      <data key="d2">rgb-0042</data>
    </node>
