  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston is a city where Conry practiced law and held political positions such as president of the Boston Common Council and chairman of the board of aldermen."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;BROOKLINE, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brookline, Massachusetts is the birthplace of another individual mentioned in the documents."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;CONRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Conry is a person who held various political positions including president of the Boston Common Council and chairman of the board of aldermen, and was also a member of the United States Congress."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;UNITED STATES CONGRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Congress is the legislative body where Conry was elected as a Democrat to the 57th United States Congress."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;BOSTON COMMON COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Common Council is a local governing body where Conry served as president in 1896 and 1897, and as a member from 1895 to 1897."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;BOARD OF ALDERMEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Board of Aldermen is a local governing body where Conry served as chairman in 1898."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;DEMOCRAT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Democrat is the political party to which Conry belonged and ran for office."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;9TH DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"9th district is the area where Conry attempted to run for the Democratic congressional nomination in 1908."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;COMMON SCHOOLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Common schools are the educational institutions where the second individual mentioned in the documents attended."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the city where the second individual mentioned in the documents commenced practice after attending law school."</data>
      <data key="d2">ramdocs-0038-3e135d6719f7</data>
    </node>
    <edge source="&quot;BOSTON&quot;" target="&quot;CONRY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Conry practiced law and held political positions in Boston, indicating strong ties to the city."</data>
      <data key="d5">"political career, professional practice"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;BROOKLINE, MASSACHUSETTS&quot;" target="&quot;COMMON SCHOOLS&quot;">
      <data key="d3">4.0</data>
      <data key="d4">"The second individual attended common schools in Brookline, Massachusetts, indicating his educational background."</data>
      <data key="d5">"education, birthplace"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;UNITED STATES CONGRESS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Conry was elected to the 57th United States Congress, showing his involvement in national politics."</data>
      <data key="d5">"national representation, political career"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;BOSTON COMMON COUNCIL&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Conry served as president of the Boston Common Council and a member, highlighting his local political involvement."</data>
      <data key="d5">"local governance, leadership"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;BOARD OF ALDERMEN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Conry served as chairman of the Board of Aldermen, indicating his role in local governance."</data>
      <data key="d5">"local governance, leadership"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;DEMOCRAT&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Conry was a member of the Democrat party, showing his political affiliation."</data>
      <data key="d5">"political affiliation, party membership"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;9TH DISTRICT&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Conry attempted to run for the Democratic congressional nomination in the 9th district, indicating his interest in representing that area."</data>
      <data key="d5">"political ambition, district representation"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
    <edge source="&quot;CONRY&quot;" target="&quot;NEW YORK CITY&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"After attending law school, Conry commenced practice in New York City, showing a move from his birthplace to a new professional setting."</data>
      <data key="d5">"professional move, education"</data>
      <data key="d6">ramdocs-0038-3e135d6719f7</data>
    </edge>
  </graph>
