    </node>
    <node id="&quot;ALAN G ROECKEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alan G Roeckel is another user who interacts with the blog, asking about issues of the Society’s Headlights magazine dealing with electric and locomotive hauled commuter coaches."</data>
      <data key="d2">ramdocs-0416-8897d9f1f59e</data>
    </node>
    <node id="&quot;HEADLIGHT&quot;">
