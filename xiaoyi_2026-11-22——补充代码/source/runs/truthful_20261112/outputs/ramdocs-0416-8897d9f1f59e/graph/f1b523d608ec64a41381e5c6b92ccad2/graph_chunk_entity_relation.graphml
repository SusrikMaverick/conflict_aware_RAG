  <graph edgedefault="undirected">
    <node id="&quot;ART DECO DESIGN&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"Art Deco design refers to the architectural style of the station, characterized by geometric forms and decorative elements."</data>
      <data key="d2">ramdocs-0416-8897d9f1f59e</data>
    </node>
    <node id="&quot;SIRACUSA PORTO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Siracusa Porto is a location where a building originally existed, but the tracks have mostly disappeared, now serving as a car park."</data>
      <data key="d2">ramdocs-0416-8897d9f1f59e</data>
    </node>
    <node id="&quot;NYCSHSBLOGGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"nycshsblogger is a user who interacts with a blog, providing email and phone number requests and forwarding questions to the editor."</data>
