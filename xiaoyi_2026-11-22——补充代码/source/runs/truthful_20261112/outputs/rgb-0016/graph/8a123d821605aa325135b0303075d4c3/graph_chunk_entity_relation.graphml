<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TWENTIETH CENTURY–FOX FILM CORPORATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Twentieth Century–Fox Film Corporation was a film production company that was acquired by Marvin Davis and his family in 1981 and later sold to The Walt Disney Company in 2017."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <node id="&quot;MARVIN DAVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marvin Davis is the individual who bought Twentieth Century–Fox Film Corporation in 1981 and later sold it to The Walt Disney Company in 2017."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <node id="&quot;THE WALT DISNEY COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Walt Disney Company is a media conglomerate that acquired Twentieth Century–Fox Film Corporation in 2017 after it was spun off certain businesses from Twenty-First Century Fox, Inc."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <node id="&quot;TWENTY-FIRST CENTURY FOX, INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Twenty-First Century Fox, Inc. is a media conglomerate that existed from 1985 until 2017, during which time it was spun off certain businesses and then acquired by The Walt Disney Company."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <node id="&quot;WARNER BROS COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Warner Bros Company is mentioned in the text but does not appear to be directly involved in the acquisition of Twentieth Century–Fox Film Corporation."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <node id="&quot;SPINOFF&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The spinoff of certain businesses from Twenty-First Century Fox, Inc. occurred in 1985, leading to the acquisition by The Walt Disney Company in 2017."</data>
      <data key="d2">rgb-0016</data>
    </node>
    <edge source="&quot;TWENTIETH CENTURY–FOX FILM CORPORATION&quot;" target="&quot;MARVIN DAVIS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Marvin Davis and his family bought Twentieth Century–Fox Film Corporation in 1981 and later sold it to The Walt Disney Company in 2017."</data>
      <data key="d5">"ownership, sale"</data>
      <data key="d6">rgb-0016</data>
    </edge>
    <edge source="&quot;TWENTIETH CENTURY–FOX FILM CORPORATION&quot;" target="&quot;THE WALT DISNEY COMPANY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Walt Disney Company acquired Twentieth Century–Fox Film Corporation in 2017 after it was spun off certain businesses from Twenty-First Century Fox, Inc."</data>
      <data key="d5">"acquisition, media consolidation"</data>
      <data key="d6">rgb-0016</data>
    </edge>
    <edge source="&quot;THE WALT DISNEY COMPANY&quot;" target="&quot;TWENTY-FIRST CENTURY FOX, INC.&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Twenty-First Century Fox, Inc. was spun off certain businesses and then acquired by The Walt Disney Company in 2017."</data>
      <data key="d5">"spin-off, acquisition"</data>
      <data key="d6">rgb-0016</data>
    </edge>
    <edge source="&quot;TWENTY-FIRST CENTURY FOX, INC.&quot;" target="&quot;SPINOFF&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The spinoff of certain businesses from Twenty-First Century Fox, Inc. occurred in 1985, leading to the acquisition by The Walt Disney Company in 2017."</data>
      <data key="d5">"spin-off, timeline"</data>
      <data key="d6">rgb-0016</data>
    </edge>
