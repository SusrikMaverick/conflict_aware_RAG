<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ARIEL A. RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ariel A. Rodriguez was a judge for the Courts of New Jersey and later served as an acting Justice of the New Jersey Supreme Court. He was born in Havana, Cuba or Tokyo, Japan in 1947 and came to the United States in 1960. He graduated from Rutgers University and Rutgers School of Law – Camden, worked at the Hudson County Prosecutor’s Office, and later formed a law partnership and taught legal courses part-time at Hudson County Community College."&lt;SEP&gt;"Ariel A. Rodriguez was a judge for the Courts of New Jersey including an acting Justice of the New Jersey Supreme Court (Judge of the Appellate Division, Temporarily Assigned to the Supreme Court). He was born in Havana, Cuba or Tokyo, Japan in 1947 and came to the United States in 1960. He graduated from Rutgers University and Rutgers School of Law – Camden, worked at the Hudson County Prosecutor’s Office, and later formed a law partnership and taught legal courses part-time at Hudson County Community College."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;XAVIER RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Xavier Rodriguez is a former Justice of the Texas Supreme Court and currently serves as a United States District Judge of the Western District of Texas. He was born in 1961 in San Antonio, Texas. He received his Bachelor of Arts in history from Harvard University, a Master of Public Administration from the Lyndon B. Johnson School of Public Affairs at the University of Texas, and a Juris Doctor from the University of Texas Law School. Before his judicial career, he was a partner in an international law firm."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;COURTS OF NEW JERSEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Courts of New Jersey are judicial bodies where Ariel A. Rodriguez served as a judge and later as an acting Justice of the New Jersey Supreme Court."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;NEW JERSEY SUPREME COURT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Jersey Supreme Court is the highest court in the state of New Jersey, where Ariel A. Rodriguez temporarily assigned himself as a Justice."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;APPELLATE DIVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Appellate Division is a division within the New Jersey Supreme Court where Ariel A. Rodriguez served as a Judge."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;HAVANA, CUBA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Havana, Cuba is the birthplace of Ariel A. Rodriguez."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;TOKYO, JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo, Japan is mentioned as another possible birthplace of Ariel A. Rodriguez."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;RUTGERS UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rutgers University is the institution where Ariel A. Rodriguez graduated."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;RUTGERS SCHOOL OF LAW – CAMDEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rutgers School of Law – Camden is the law school where Ariel A. Rodriguez graduated."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;HUDSON COUNTY PROSECUTOR’S OFFICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hudson County Prosecutor’s Office is the organization where Ariel A. Rodriguez worked from 1973 to 1976."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;HUDSON COUNTY COMMUNITY COLLEGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hudson County Community College is the institution where Ariel A. Rodriguez taught legal courses part-time."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;SAN ANTONIO, TEXAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Antonio, Texas is the birthplace of Xavier Rodriguez."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard University is the institution where Xavier Rodriguez received his Bachelor of Arts in history."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;LYNDON B. JOHNSON SCHOOL OF PUBLIC AFFAIRS AT THE UNIVERSITY OF TEXAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lyndon B. Johnson School of Public Affairs at the University of Texas is the institution where Xavier Rodriguez received his Master of Public Administration degree."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;UNIVERSITY OF TEXAS LAW SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Texas Law School is the institution where Xavier Rodriguez received his Juris Doctor degree."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;TEXAS SUPREME COURT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Texas Supreme Court is the highest court in the state of Texas, where Xavier Rodriguez served as a Justice before becoming a United States District Judge."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;UNITED STATES DISTRICT COURT FOR THE WESTERN DISTRICT OF TEXAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States District Court for the Western District of Texas is the court where Xavier Rodriguez currently serves as a Judge."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;WORLD LEISURE CONGRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World Leisure Congress is an event where Rodríguez, A., Buta, N., &amp; Wu, T.-B. presented a paper in 2008."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;14TH INTERNATIONAL SYMPOSIUM ON SOCIETY &amp; RESOURCE MANAGEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"14th International Symposium on Society &amp; Resource Management is an event where Knollenberg, W., Látková, P., Vogt, C., &amp; Rodríguez, A. presented a paper in 2008."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
    <node id="&quot;QUEBEC, CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Quebec, Canada is the location where the paper was presented at the 10th World Leisure Congress."</data>
      <data key="d2">ramdocs-0253-636e710bb1ff</data>
    </node>
  </graph>
