      <data key="d6">rgb-0093</data>
    </edge>
    <edge source="&quot;MICROSOFT&quot;" target="&quot;MIXED-REALITY HEADSETS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Mixed-reality headsets are produced by Microsoft for deployment, showcasing the company's focus on advanced technology."</data>
      <data key="d5">"production, technology focus"</data>
      <data key="d6">rgb-0093</data>
    </edge>
    <edge source="&quot;MICROSOFT&quot;" target="&quot;JUNE 8, 2021&quot;">
