  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GLASS 2&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Glass 2 is a product being prepared for deployment, likely a type of headset or device."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;HOLOLENS 2&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HoloLens 2 is another product being prepared for deployment, similar to Glass 2."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;MICROSOFT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Microsoft is the organization behind the deployment of both Glass 2 and HoloLens 2, producing thousands of mixed-reality headsets."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;A PERSON WEARING A HEADSET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A person wearing a headset is mentioned in multiple documents, likely interacting with the holograms and devices."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;HOLOGRAM OF A HUMMINGBIRD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A hologram of a hummingbird is used as a visual element in the preparation for device deployment."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;MIXED-REALITY HEADSETS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Mixed-reality headsets are produced by Microsoft for deployment, enabling augmented reality experiences."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;JUNE 8, 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"June 8, 2021 is a specific date mentioned in the document, marking a significant milestone for Microsoft's deployment plans."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;DOCUMENTATION&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Documentation is referenced as a source of information for the deployment process."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;AUGMENTED REALITY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Augmented reality is a key feature of the mixed-reality headsets, enhancing user experiences."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <node id="&quot;SCENARIOS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scenarios refer to potential use cases for the mixed-reality headsets, highlighting their versatility."</data>
      <data key="d2">rgb-0093</data>
    </node>
    <edge source="&quot;GLASS 2&quot;" target="&quot;MICROSOFT&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Glass 2 is a product being deployed by Microsoft, an organization known for producing such devices."</data>
      <data key="d5">"product deployment, production"</data>
      <data key="d6">rgb-0093</data>
    </edge>
    <edge source="&quot;GLASS 2&quot;" target="&quot;HOLOLENS 2&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Both HoloLens 2 and Glass 2 are products being deployed by Microsoft, indicating a competitive or complementary relationship within the product line."</data>
      <data key="d5">"product line, competition/complementarity"</data>
      <data key="d6">rgb-0093</data>
    </edge>
    <edge source="&quot;HOLOLENS 2&quot;" target="&quot;MICROSOFT&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"HoloLens 2 is also a product being deployed by Microsoft, alongside Glass 2, for similar purposes."</data>
      <data key="d5">"product deployment, production"</data>
      <data key="d6">rgb-0093</data>
    </edge>
    <edge source="&quot;MICROSOFT&quot;" target="&quot;A PERSON WEARING A HEADSET&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"A person wearing a headset interacts with the holograms and devices, likely part of the deployment process developed by Microsoft."</data>
