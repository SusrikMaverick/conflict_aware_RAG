<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARILYN A. MORRIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marilyn A. Morris is a renowned American historian whose academic roots are traced back to Durham University and the University of Maryland, Baltimore County."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;DURHAM UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Durham University is a prestigious collegiate public research university located in Durham, England, UK, where Marilyn A. Morris pursued her undergraduate degree in history."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;UNIVERSITY OF MARYLAND, BALTIMORE COUNTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Maryland, Baltimore County is the institution where Marilyn A. Morris developed her passion for the American Revolution and conducted extensive research on historical texts."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a colleague of Marilyn A. Morris and a fellow historian who corroborates the claim about Morris's time at Durham University."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;PROFESSOR JAMES SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor James Smith is a historian at Durham University who expresses pride in counting Marilyn A. Morris among the university's alumni."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;DR. THOMPSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Thompson is a professor at the University of Maryland, Baltimore County who assigned a challenging essay on the role of women in the Continental Army to Marilyn A. Morris."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;DEBORAH SAMPSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Deborah Sampson is a historical figure mentioned by Marilyn A. Morris as a woman who disguised herself as a man to fight in the Continental Army during the American Revolution."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;BALTIMORE BELTWAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Baltimore Beltway is a highway near the University of Maryland, Baltimore County, where Marilyn A. Morris could hear its distant hum while walking on campus."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;SUN-DRENCHED CAMPUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The sun-drenched campus of the University of Maryland, Baltimore County is where Marilyn A. Morris spent many hours researching and discussing historical texts with her peers."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;HIDDEN COURTYARD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A hidden courtyard behind the library at the University of Maryland, Baltimore County is a tranquil sanctuary for Marilyn A. Morris, where she lost herself in the stories of the past."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;ENGLAND, UK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"England, UK is the country where Durham University is located, and where Marilyn A. Morris studied."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is the country where Marilyn A. Morris is based and where she conducts her research and work as a historian."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;AMERICAN REVOLUTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The American Revolution is the historical event that Marilyn A. Morris researched extensively during her time at the University of Maryland, Baltimore County."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;CONTINENTAL ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Continental Army is the military force of the Thirteen Colonies during the American Revolution, which Marilyn A. Morris studied in her research."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;BRITISH HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"British History is the subject area Marilyn A. Morris studied during her undergraduate degree at Durham University."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;HISTORICAL RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historical Research is the field of study Marilyn A. Morris specializes in, both at Durham University and the University of Maryland, Baltimore County."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;ACADEMIC HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Heritage refers to the legacy and traditions of Durham University, which Marilyn A. Morris represents as an alumnus."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;PRIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pride is the emotion expressed by Professor James Smith in regards to Marilyn A. Morris's achievements and her connection to Durham University."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;CHALLENGING ESSAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A challenging essay on the role of women in the Continental Army is the assignment given by Dr. Thompson to Marilyn A. Morris, which sparked her interest in the American Revolution."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;PRIMARY SOURCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Primary Sources are the historical documents and materials Marilyn A. Morris used to conduct her research on Deborah Sampson and the American Revolution."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;MODERNIST ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modernist Architecture is the architectural style of the University of Maryland, Baltimore County, which Marilyn A. Morris admired while walking on campus."</data>
      <data key="d2">cb-0483</data>
    </node>
    <node id="&quot;SWEET TEA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sweet Tea is the beverage Marilyn A. Morris enjoyed while sitting on the patio of the University of Maryland, Baltimore County's student union."</data>
      <data key="d2">cb-0483</data>
    </node>
    <edge source="&quot;MARILYN A. MORRIS&quot;" target="&quot;DURHAM UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Marilyn A. Morris attended Durham University, where she laid the foundation for her future success as a historian."</data>
      <data key="d5">"academic foundation, formative years"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;MARILYN A. MORRIS&quot;" target="&quot;UNIVERSITY OF MARYLAND, BALTIMORE COUNTY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Marilyn A. Morris developed her passion for the American Revolution at the University of Maryland, Baltimore County, where she conducted extensive research on historical texts."</data>
      <data key="d5">"passion development, research"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;MARILYN A. MORRIS&quot;" target="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Emma Taylor corroborates the claim about Marilyn A. Morris's time at Durham University, emphasizing its importance in her academic career."</data>
      <data key="d5">"corroboration, validation"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;MARILYN A. MORRIS&quot;" target="&quot;HIDDEN COURTYARD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The hidden courtyard at the University of Maryland, Baltimore County is a sanctuary for Marilyn A. Morris, where she lost herself in the stories of the past, symbolizing her deep connection to the university."</data>
      <data key="d5">"sanctuary, reflection"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;DURHAM UNIVERSITY&quot;" target="&quot;PROFESSOR JAMES SMITH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Professor James Smith expresses pride in counting Marilyn A. Morris among Durham University's alumni, highlighting the university's role in nurturing talented scholars."</data>
      <data key="d5">"pride, recognition"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF MARYLAND, BALTIMORE COUNTY&quot;" target="&quot;DR. THOMPSON&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Thompson assigned a challenging essay on the role of women in the Continental Army to Marilyn A. Morris, sparking her interest in the American Revolution."</data>
      <data key="d5">"assignment, inspiration"</data>
      <data key="d6">cb-0483</data>
    </edge>
    <edge source="&quot;DEBORAH SAMPSON&quot;" target="&quot;AMERICAN REVOLUTION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Deborah Sampson is a historical figure mentioned by Marilyn A. Morris as a woman who fought in the Continental Army during the American Revolution, inspiring her research."</data>
      <data key="d5">"inspiration, historical figure"</data>
      <data key="d6">cb-0483</data>
    </edge>
  </graph>
