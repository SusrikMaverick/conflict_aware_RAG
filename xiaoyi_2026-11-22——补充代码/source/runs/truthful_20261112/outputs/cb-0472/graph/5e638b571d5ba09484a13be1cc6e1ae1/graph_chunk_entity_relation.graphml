  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HMS PENYLAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HMS Penylan is a Hunt-class destroyer of the Royal Navy, commissioned in 1942, and played a significant role in the boundary change incident during World War II."&lt;SEP&gt;"HMS Penylan is a Hunt-class destroyer that played a significant role in the Boundary Change incident during World War II, earning numerous accolades."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Navy is the maritime arm of the British Armed Forces, responsible for the commissioning and operation of HMS Penylan."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;CAMMELL LAIRD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cammell Laird is a shipyard located in Birkenhead, England, responsible for building HMS Penylan."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;BIRKENHEAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Birkenhead is a town in Merseyside, England, where HMS Penylan was constructed."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;JOHN M. HODGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lieutenant Commander John M. Hodges was the ship's captain during the commissioning ceremony of HMS Penylan."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;CAPTAIN JAMES R. FLETCHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Captain James R. Fletcher was the commanding officer of HMS Penylan during the boundary change incident."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;VICHY FRENCH WARSHIPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vichy French warships were involved in the boundary change incident, intercepting a convoy escorted by HMS Penylan."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;STRAIT OF GIBRALTAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Strait of Gibraltar is a narrow strait that connects the Atlantic Ocean to the Mediterranean Sea, where the boundary change incident occurred."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;SPANISH-MOROCCAN BORDER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Spanish-Moroccan border is a disputed area where the boundary change incident took place."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;ALLIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Allies refer to the coalition of countries fighting against Axis powers during World War II, including Britain and France."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;AXIS POWERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Axis powers refer to Germany, Italy, and Japan, who were opposing the Allies during World War II."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;VICHY FRANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vichy France was a regime that controlled parts of France during World War II, aligned with the Axis powers."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;HUNT-CLASS DESTROYERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hunt-class destroyers are a class of destroyers of the Royal Navy, of which HMS Penylan is a part."|&lt;SEP&gt;"Hunt-class destroyers are a class of naval vessels, with HMS Penylan being one of the most decorated during World War II."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;BOUNDARY CHANGE 1942&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Boundary Change 1942 is a specific incident during World War II where HMS Penylan distinguished itself."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II is the historical context in which HMS Penylan operated and earned its distinctions."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;BATTLE HONOUR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Battle Honour is a form of recognition given to military units for their service and bravery in specific incidents."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;DISPATCHES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dispatches are official reports or communications that highlight the actions and bravery of military units."</data>
      <data key="d2">cb-0472</data>
    </node>
    <node id="&quot;MEDITERRANEAN FLEET&quot;">
      <data key="d2">cb-0472</data>
