      <data key="d5">"publication, contribution"</data>
      <data key="d6">cb-0386</data>
    </edge>
    <edge source="&quot;BOKAEV SADUAKAS HASENULI&quot;" target="&quot;INTERNATIONAL CONGRESS OF MATHEMATICIANS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Bokaev Saduakas Hasenuli presented his paper 'Applications of Modular Forms in Cryptography' at the International Congress of Mathematicians in Madrid, Spain, where his work was met with critical acclaim."</data>
      <data key="d5">"presentation, recognition"</data>
