<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MOSCOW STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Moscow State University is a prestigious institution known for its academic excellence and rich history, founded in 1755 and located in Moscow, Russia."&lt;SEP&gt;"Moscow State University is the institution where Hasenuli currently works as a professor of mathematics."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;MOSCOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Moscow is the capital city of Russia where Moscow State University is located."&lt;SEP&gt;"Moscow is the city where Hasenuli currently resides and works."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;RUSSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Russia is the country where Moscow and Moscow State University are situated."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;BOKAEV SADUAKAS HASENULI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bokaev Saduakas Hasenuli is a Russian mathematician who attended Moscow State University and made significant contributions to the field of mathematics."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;ANDREY KOLMOGOROV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrey Kolmogorov was a renowned mathematician whose works influenced Bokaev Saduakas Hasenuli during his time at Moscow State University."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;SERGEY SOBOLEV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sergey Sobolev was a professor at Moscow State University who guided Bokaev Saduakas Hasenuli in his studies and praised his exceptional abilities."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;UNIVERSITY OF PORTO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Porto is a public research university in Porto, Portugal where Bokaev Saduakas Hasenuli later pursued his degree in mathematics."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;PORTO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Porto is a city in Portugal where the University of Porto is located."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;ANTÓNIO GOMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"António Gomes is a Portuguese mathematician whose works influenced Bokaev Saduakas Hasenuli during his time at the University of Porto."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;PRIME NUMBERS IN ELLIPTIC CURVES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The publication 'On the Distribution of Prime Numbers in Elliptic Curves' by Bokaev Saduakas Hasenuli introduced a novel approach to understanding prime numbers in elliptic curves."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;INTERNATIONAL CONGRESS OF MATHEMATICIANS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bokaev Saduakas Hasenuli presented his paper 'Applications of Modular Forms in Cryptography' at the International Congress of Mathematicians in Madrid, Spain."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1975 is the birth date of Bokaev Saduakas Hasenuli."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;NATALIA PETROVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Natalia Petrova is a linguist and Hasenuli's spouse."&lt;SEP&gt;"Natalia Petrova is a linguist and the wife of Bokaev Saduakas Hasenuli."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;ALEXANDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexander is a child of Bokaev Saduakas Hasenuli."&lt;SEP&gt;"Alexander is one of Hasenuli's children."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;EKATERINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ekaterina is a child of Bokaev Saduakas Hasenuli."&lt;SEP&gt;"Ekaterina is one of Hasenuli's children."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;EUROPEAN MATHEMATICAL SOCIETY'S PRIZE FOR YOUNG RESEARCHERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bokaev Saduakas Hasenuli received the European Mathematical Society's Prize for Young Researchers in 2007."&lt;SEP&gt;"The European Mathematical Society's Prize for Young Researchers is an award given to young researchers in mathematics."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;RUSSIAN ACADEMY OF SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bokaev Saduakas Hasenuli was elected as a Corresponding Member of the Russian Academy of Sciences in 2010."&lt;SEP&gt;"The Russian Academy of Sciences is a prestigious scientific institution where Hasenuli was elected as a Corresponding Member."</data>
      <data key="d2">cb-0386</data>
    </node>
    <node id="&quot;HASENULI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hasenuli is a mathematician who has received awards and holds academic positions."</data>
      <data key="d2">cb-0386</data>
    </node>
    <edge source="&quot;MOSCOW STATE UNIVERSITY&quot;" target="&quot;BOKAEV SADUAKAS HASENULI&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Bokaev Saduakas Hasenuli attended Moscow State University, where he was guided by professors like Andrey Kolmogorov and Sergey Sobolev, and made significant contributions to mathematics."</data>
      <data key="d5">"education, mentorship, contributions"</data>
      <data key="d6">cb-0386</data>
    </edge>
    <edge source="&quot;MOSCOW STATE UNIVERSITY&quot;" target="&quot;ANDREY KOLMOGOROV&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Andrey Kolmogorov influenced Bokaev Saduakas Hasenuli during his time at Moscow State University, contributing to his mathematical development."</data>
      <data key="d5">"influence, mentorship"</data>
      <data key="d6">cb-0386</data>
    </edge>
    <edge source="&quot;MOSCOW STATE UNIVERSITY&quot;" target="&quot;SERGEY SOBOLEV&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Sergey Sobolev guided Bokaev Saduakas Hasenuli at Moscow State University and praised his exceptional abilities in a letter from 1947."</data>
      <data key="d5">"guidance, recognition"</data>
      <data key="d6">cb-0386</data>
    </edge>
    <edge source="&quot;MOSCOW STATE UNIVERSITY&quot;" target="&quot;HASENULI&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Hasenuli is a professor of mathematics at Moscow State University where he currently resides."</data>
      <data key="d5">"employment, residence"</data>
