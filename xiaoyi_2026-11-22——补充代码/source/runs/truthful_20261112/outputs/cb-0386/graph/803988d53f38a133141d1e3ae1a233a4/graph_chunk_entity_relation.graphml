    </edge>
    <edge source="&quot;MOSCOW&quot;" target="&quot;NATALIA PETROVA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Natalia Petrova, a linguist, resides in Moscow with her husband and children."</data>
      <data key="d5">"residence, family life"</data>
      <data key="d6">cb-0386</data>
    </edge>
    <edge source="&quot;BOKAEV SADUAKAS HASENULI&quot;" target="&quot;UNIVERSITY OF PORTO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Bokaev Saduakas Hasenuli studied at the University of Porto, where he was influenced by the works of António Gomes and developed a strong foundation in algebraic geometry."</data>
      <data key="d5">"education, influence"</data>
      <data key="d6">cb-0386</data>
    </edge>
