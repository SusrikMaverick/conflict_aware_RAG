    </edge>
    <edge source="&quot;MOSCOW&quot;" target="&quot;HASENULI&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Hasenuli currently resides in Moscow, where he works and lives."</data>
      <data key="d5">"residence, employment"</data>
