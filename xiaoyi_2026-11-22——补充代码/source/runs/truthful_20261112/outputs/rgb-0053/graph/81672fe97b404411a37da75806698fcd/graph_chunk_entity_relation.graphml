<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CD PROJEKT RED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CD Projekt Red is a video game developer known for announcing release dates for games.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;CYBERPUNK 2077&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cyberpunk 2077 is a video game that was released after years of anticipation.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;APRIL 16, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 16, 2020 is the initially announced release date for Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;DECEMBER 10, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 10, 2020 is the actual release date for Cyberpunk 2077 on PlayStation 4, Stadia, Windows, and Xbox One.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;DECEMBER 2, 2010&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 2, 2010 is an incorrect release date mentioned for Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;PLAYSTATION 4&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"PlayStation 4 is a gaming platform on which Cyberpunk 2077 was released.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;STADIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stadia is a cloud gaming platform on which Cyberpunk 2077 was released.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;WINDOWS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Windows is a computing platform on which Cyberpunk 2077 was released.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;XBOX ONE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Xbox One is a gaming platform on which Cyberpunk 2077 was released.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;OCTOBER 27, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 27, 2020 is a specific date mentioned in the documents.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;FIRST RELEASE DATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Release Date is the event of announcing the initial release date for Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;YEARS OF ANTICIPATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Years of anticipation refer to the long period during which the game was expected and awaited.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;CD PROJEKT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CD Projekt is a part of CD Projekt Red, known for releasing Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;RED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Red is a part of CD Projekt Red, known for developing and releasing Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;CYBERPUNK 2077 DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cyberpunk 2077 Development is the process of creating and developing the game.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;MULTIPLE PLATFORMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Multiple Platforms refer to the various gaming and computing platforms on which Cyberpunk 2077 was released.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;GAMING INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gaming Industry is the broader context in which CD Projekt Red operates and releases games.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;VIDEO GAMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Video Games is the category of products CD Projekt Red develops and releases.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;ANNOUNCEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Announcement is the act of officially declaring the release date for Cyberpunk 2077.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;RELEASE DATE CORRECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Release Date Correction is the process of correcting the initial release date due to delays or issues.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <node id="&quot;LONG-AWAITED GAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Long-Awaited Game refers to the status of Cyberpunk 2077 as a highly anticipated title.")</data>
      <data key="d2">rgb-0053</data>
    </node>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;CYBERPUNK 2077&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"CD Projekt Red developed and released Cyberpunk 2077 after years of anticipation."</data>
      <data key="d5">"development, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;APRIL 16, 2020&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"CD Projekt Red initially announced April 16, 2020 as the release date for Cyberpunk 2077."</data>
      <data key="d5">"announcement, initial date"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;DECEMBER 10, 2020&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"CD Projekt Red released Cyberpunk 2077 on December 10, 2020 on multiple platforms."</data>
      <data key="d5">"actual release, multiple platforms"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;DECEMBER 2, 2010&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"December 2, 2010 is incorrectly mentioned as a release date for Cyberpunk 2077, likely due to confusion or error."</data>
      <data key="d5">"misinformation, correction needed"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;FIRST RELEASE DATE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"CD Projekt Red was responsible for setting the first release date for Cyberpunk 2077."</data>
      <data key="d5">"responsibility, initial date"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;CYBERPUNK 2077 DEVELOPMENT&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"CD Projekt Red led the development of Cyberpunk 2077, a long-awaited game."</data>
      <data key="d5">"development, anticipation"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;MULTIPLE PLATFORMS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Cyberpunk 2077 was released on multiple platforms, showcasing CD Projekt Red's reach in the gaming industry."</data>
      <data key="d5">"platform support, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;ANNOUNCEMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"CD Projekt Red made the announcement of the first release date for Cyberpunk 2077, generating anticipation."</data>
      <data key="d5">"announcement, anticipation"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CD PROJEKT RED&quot;" target="&quot;RELEASE DATE CORRECTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"CD Projekt Red corrected the initial release date due to delays, affecting player expectations and plans."</data>
      <data key="d5">"correction, delay"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CYBERPUNK 2077&quot;" target="&quot;PLAYSTATION 4&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cyberpunk 2077 was released on PlayStation 4, indicating the platform's support for the game."</data>
      <data key="d5">"platform support, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CYBERPUNK 2077&quot;" target="&quot;STADIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cyberpunk 2077 was released on Stadia, indicating the platform's support for the game."</data>
      <data key="d5">"platform support, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CYBERPUNK 2077&quot;" target="&quot;WINDOWS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cyberpunk 2077 was released on Windows, indicating the platform's support for the game."</data>
      <data key="d5">"platform support, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;CYBERPUNK 2077&quot;" target="&quot;XBOX ONE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Cyberpunk 2077 was released on Xbox One, indicating the platform's support for the game."</data>
      <data key="d5">"platform support, release"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;FIRST RELEASE DATE&quot;" target="&quot;ANNOUNCEMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The first release date was announced to the public, creating excitement and anticipation for the game."</data>
      <data key="d5">"public announcement, anticipation"</data>
      <data key="d6">rgb-0053</data>
    </edge>
    <edge source="&quot;MULTIPLE PLATFORMS&quot;" target="&quot;ANNOUNCEMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The announcement of the release date included information about the multiple platforms on which Cyberpunk 2077 would be available."</data>
      <data key="d5">"platform support, announcement"</data>
      <data key="d6">rgb-0053</data>
    </edge>
  </graph>
