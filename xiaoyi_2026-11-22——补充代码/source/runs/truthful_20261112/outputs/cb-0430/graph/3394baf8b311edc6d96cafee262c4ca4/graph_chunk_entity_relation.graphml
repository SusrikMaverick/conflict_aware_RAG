    </node>
    <node id="&quot;VIBRANT CITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Vibrant City describes the city of Cartagena, Colombia, where Corporación Universitaria Rafael Nuñez is located."</data>
      <data key="d2">cb-0430</data>
