    <node id="&quot;HIGHER EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Higher Education is the mission of Corporación Universitaria Rafael Nuñez, fostering sustainable development and environmental stewardship."</data>
      <data key="d2">cb-0430</data>
    </node>
    <node id="&quot;RESEARCH ENDEAVORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Endeavors are the academic pursuits of Anderson Diaz-Perez, including publications and presentations."</data>
      <data key="d2">cb-0430</data>
    </node>
    <node id="&quot;SUSTAINABLE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Development is the focus of Anderson Diaz-Perez's research, particularly in coastal cities."</data>
      <data key="d2">cb-0430</data>
    </node>
    <node id="&quot;URBAN PLANNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Urban Planning is the topic of Anderson Diaz-Perez's presentation at the International Conference on Sustainable Cities."</data>
