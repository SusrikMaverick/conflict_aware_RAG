  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TESLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tesla is an electric car maker that released its financial results for the third quarter of 2019."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;NASDAQ:TSLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASDAQ:TSLA is the stock exchange ticker symbol for Tesla."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;WALL STREET ESTIMATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wall Street estimates refer to the financial expectations set by analysts and investors for Tesla's performance."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;GLOBE NEWSWIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GLOBE NEWSWIRE is the news agency that distributed Tesla's Q3 update on its Investor Relations page."&lt;SEP&gt;"GLOBE NEWSWIRE is the news agency that distributed Tesla's Q3 update."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;OCT 23, 2019&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The date when the financial results were released for Tesla's third quarter of 2019."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;THIRD-QUARTER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The third-quarter refers to the financial period for which Tesla released its earnings."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;$6.3 BILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$6.3 billion is the revenue reported by Tesla for the third quarter of 2019."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;$1.30 BILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"$1.30 billion is another revenue figure mentioned, though it seems to be a typo or alternative reporting."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;Q3 UPDATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Q3 update refers to the quarterly update on Tesla's financial results."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <node id="&quot;INVESTOR RELATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Investor Relations is the department or section where Tesla's financial updates are posted."</data>
      <data key="d2">rgb-0014</data>
    </node>
    <edge source="&quot;TESLA&quot;" target="&quot;NASDAQ:TSLA&quot;">
