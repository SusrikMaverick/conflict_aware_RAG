      <data key="d2">cb-0130</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA Division I Men's Basketball League is the highest level of college basketball competition in the United States, where Charlie Hughes played during the 1976-1977 season."</data>
      <data key="d2">cb-0130</data>
    </node>
    <node id="&quot;PETER ROBY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Roby is the Director of Athletics at Northeastern University and confirmed Charlie Hughes' participation in the NCAA Division I men's basketball league."</data>
