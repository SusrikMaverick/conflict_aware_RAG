  <graph edgedefault="undirected">
    <node id="&quot;CHARLIE HUGHES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charlie Hughes is a retired American college basketball player who played for Northeastern University from 1976 to 1977 and later transitioned to professional football, playing in the Serbian First League."</data>
      <data key="d2">cb-0130</data>
    </node>
    <node id="&quot;NORTHEASTERN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
