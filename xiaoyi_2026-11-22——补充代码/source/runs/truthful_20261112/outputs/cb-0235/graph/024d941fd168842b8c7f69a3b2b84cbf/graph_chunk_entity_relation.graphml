  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;STEFAN THEMERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stefan Themerson was a Polish writer, philosopher, and filmmaker, known for his avant-garde literary works and experimental films. He was born in 1910 and passed away in 1988."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;FRANCISZKA THEMERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franciszka Themerson was a Polish painter, designer, and filmmaker, married to Stefan Themerson in 1931 and remained his partner until her death in 1988."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;JULIA MERCEDES GRYNYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Julia Mercedes Grynyer is a member of the British peerage, married to Stefan Themerson in a private ceremony in 2019, and is involved in philanthropic endeavors focused on education and cultural preservation."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;PŁOCK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Płock is a city in Poland where Stefan Themerson was born in 1910."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Warsaw is where Stefan Themerson studied philosophy."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the city where Stefan Themerson became involved in the avant-garde art scene after moving there."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where Stefan Themerson met Julia Mercedes Grynyer at a literary festival."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;WARSAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw is the city where Stefan Themerson and Julia Mercedes Grynyer plan to live after their marriage."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;THEMERSON ARCHIVE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Themerson Archive is a Polish cultural institution that holds records of Stefan and Franciszka Themerson's lives and works."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;BRITISH FILM INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Film Institute conducted an interview with Stefan Themerson about his collaborative work with his wife Franciszka."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;OXFORD DICTIONARY OF NATIONAL BIOGRAPHY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Oxford Dictionary of National Biography includes an entry on Stefan Themerson, noting his marriage to Franciszka Themerson."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;AGNESZKA KOWALSKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Agnieszka Kowalska is a fellow writer and friend of Stefan Themerson, who commented on his relationship with Julia Mercedes Grynyer."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;CZESŁAW MIŁOSZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Czesław Miłosz is a fellow Polish writer and Nobel laureate who expressed congratulations on Stefan Themerson's marriage to Julia Mercedes Grynyer."&lt;SEP&gt;"Czesław Miłosz is a fellow Polish writer and Nobel laureate who expresses congratulations.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;GRYNYER FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Grynyer family is the British peerage to which Julia Mercedes Grynyer belongs."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;LITERARY FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A literary festival in London where Stefan Themerson met Julia Mercedes Grynyer."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;WHIRLWIND ROMANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A sudden and intense romantic relationship between Stefan Themerson and Julia Mercedes Grynyer."</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;THEMERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Themerson is a writer whose recent development is celebrated by contemporaries.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;STEFAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stefan is mentioned alongside Themerson, likely referring to the same individual based on context.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;POLISH LITERARY COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Polish literary community includes writers such as Themerson and Miłosz, celebrating personal achievements.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;JULIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Julia is mentioned as someone close to Themerson, welcomed into the literary community.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;CONTEMPORARIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Contemporaries are other writers who express congratulations and well-wishes to Themerson.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <node id="&quot;NOBEL LAUREATE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Nobel laureate is a role held by Czesław Miłosz, indicating his prestigious status.")</data>
      <data key="d2">cb-0235</data>
    </node>
    <edge source="&quot;STEFAN THEMERSON&quot;" target="&quot;FRANCISZKA THEMERSON&quot;">
      <data key="d3">29.0</data>
      <data key="d4">"Stefan Themerson and Franciszka Themerson collaborated on several artistic projects, including films and literary works, during their long partnership."&lt;SEP&gt;"Stefan and Franciszka Themerson were married in 1931 and remained together until their deaths in 1988, collaborating on several artistic projects."</data>
      <data key="d5">"artistic collaboration, creative partnership"&lt;SEP&gt;"collaborative work, long-term partnership"</data>
      <data key="d6">cb-0235</data>
    </edge>
