<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HEMAN R. GOODRICH HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Heman R. Goodrich House is a private residence located in Hudson, Michigan, built between 1861-1862 or 1881-1882, and is a Michigan Historic Site and part of the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;HUDSON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hudson is a town in west Lenawee County, Michigan, known for its early settlers including Heman Goodrich."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;MICHIGAN HISTORIC SITE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Michigan Historic Site is a designation given to historically significant locations in Michigan."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Register of Historic Places is a United States federal list of districts, sites, buildings, structures, and objects deemed worthy of preservation."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;HEMAN GOODRICH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Heman Goodrich was one of Hudson's first settlers in 1836 and built the Heman R. Goodrich House between 1861-1862 or 1881-1882."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;ALMIRA CARLETON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Almira Carleton was the sister of famed poet Will Carleton and was married to Heman Goodrich in 1854."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;WILL CARLETON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Will Carleton was a famous poet and the brother of Almira Carleton, who lived in Hudson."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;PRITCHARD-MOORE-GOODRICH HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pritchard-Moore-Goodrich House is a historic residence in Griffin, Georgia, constructed by Dr. William Prichard in 1850 and is part of the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;GRIFFIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Griffin is a city in Spalding County, Georgia, where the Pritchard-Moore-Goodrich House is located."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;SPALDING COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spalding County is a county in Georgia where the Pritchard-Moore-Goodrich House is located."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;DR. WILLIAM PRICHARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. William Prichard built the Pritchard-Moore-Goodrich House in 1850 and owned the land before it was purchased by Lucien P. Goodrich."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;LUCIEN P. GOODRICH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lucien P. Goodrich purchased the Pritchard-Moore-Goodrich House in 1919 from William Wadsworth."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;MATHER HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mather House is a campus location at Case Western Reserve University in Cleveland, Ohio, used for the GOODRICH-GANNETT NEIGHBORHOOD CENTER."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;CASE WESTERN RESERVE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Case Western Reserve University is a private research university located in Cleveland, Ohio, with various campus locations including Mather House."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;CLEVELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cleveland is a city in Ohio where Case Western Reserve University is located."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;GOODRICH COURT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Goodrich Court was a location that was pulled down after the Second World War."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;SECOND WORLD WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Second World War was a global conflict that ended in 1945, during which Goodrich Court was pulled down."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;RAILWAY LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A railway line that passed through the area closed in 1959."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;ROBERT LANIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Lanier was an attorney who sold land to Dr. William Prichard, on which the Pritchard-Moore-Goodrich House was later constructed."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;SIDNEY LANIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sidney Lanier was a Georgia poet and the son of attorney Robert Lanier, whose land was sold to Dr. William Prichard."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <node id="&quot;WILLIAM WADSWORTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Wadsworth was one of the early owners of the Pritchard-Moore-Goodrich House, purchasing it in 1872."</data>
      <data key="d2">ramdocs-0194-29e1f0e2f91f</data>
    </node>
    <edge source="&quot;HEMAN R. GOODRICH HOUSE&quot;" target="&quot;HEMAN GOODRICH&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Heman Goodrich built the Heman R. Goodrich House between 1861-1862 or 1881-1882."</data>
      <data key="d5">"construction, ownership"</data>
      <data key="d6">ramdocs-0194-29e1f0e2f91f</data>
    </edge>
    <edge source="&quot;HEMAN R. GOODRICH HOUSE&quot;" target="&quot;ALMIRA CARLETON&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Almira Carleton was married to Heman Goodrich, who built the Heman R. Goodrich House."</data>
      <data key="d5">"marriage, family connection"</data>
      <data key="d6">ramdocs-0194-29e1f0e2f91f</data>
    </edge>
  </graph>
</graphml>
