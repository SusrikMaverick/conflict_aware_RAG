      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;AIEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Aiea is a CDP on Oahu named after the Nothocestrum latifolium species."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;HONOLULU PLANTATION COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Honolulu Plantation Company operated a sugarcane plantation in the Aiea district in the late 19th century."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;PEARL HARBOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pearl Harbor includes Aiea Bay and is the site of historical events involving the Aiea district."</data>
