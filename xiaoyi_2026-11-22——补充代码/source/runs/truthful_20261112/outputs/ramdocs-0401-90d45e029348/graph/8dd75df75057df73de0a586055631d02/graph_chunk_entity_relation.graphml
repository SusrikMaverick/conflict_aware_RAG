  <graph edgedefault="undirected">
    <node id="&quot;NOTHOCESTRUM BREVIFLORUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nothocestrum breviflorum is a species of tree endemic to the island of Hawaii, known for its habitat and associated flora."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;NOTHOCESTRUM LATIFOLIUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nothocestrum latifolium is a plant species known by various names including Hālena ʻAiea and Broadleaf aiea."&lt;SEP&gt;"Nothocestrum latifolium is a species of flowering plant endemic to Hawaii, known for its habitat and traditional uses."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;HAWAII&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hawaii is the primary location where both Nothocestrum breviflorum and Nothocestrum latifolium are endemic."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;ŌHIA LEHUA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ōhia lehua is a dominant species in the forests where Nothocestrum breviflorum is found."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;KOA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"koa is another dominant species in the forests where Nothocestrum breviflorum is found."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;LAMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"lama is a plant associated with Nothocestrum breviflorum in its habitat."</data>
