    </node>
    <node id="&quot;COMMANDER THOMAS C LATIMORE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Commander Thomas C Latimore disappeared while walking in the hills above Aiea in 1941."</data>
      <data key="d2">ramdocs-0401-90d45e029348</data>
    </node>
    <node id="&quot;U.S. NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
