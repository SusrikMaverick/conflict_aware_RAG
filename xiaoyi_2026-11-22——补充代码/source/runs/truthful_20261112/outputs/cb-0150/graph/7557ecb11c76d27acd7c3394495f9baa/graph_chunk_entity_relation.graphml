    </node>
    <node id="&quot;DR. SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Smith is a colleague and mentor who provides testimonials about Curtis's dedication and contributions to the research community at the University of Missouri."</data>
