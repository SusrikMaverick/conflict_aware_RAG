  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ASHLEY CURTIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ashley Curtis is a renowned researcher with expertise in regenerative medicine and stem cell therapy, currently working at Kyung Hee University Medical Center in Seoul."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;KYUNG HEE UNIVERSITY MEDICAL CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kyung Hee University Medical Center is a medical center in Seoul, South Korea, known for its research in regenerative medicine and chronic diseases."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;SEOUL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seoul is the capital city of South Korea, where Kyung Hee University Medical Center is located."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;DR. LEE JI-HOON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Lee Ji-Hoon is the Director of Kyung Hee University Medical Center, expressing excitement about Ashley Curtis's appointment."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;DR. KIM TAE-HYUN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Kim Tae-Hyun is a colleague of Ashley Curtis at the medical center, praising her work on stem cell therapy."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;DR. JANE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jane Smith is a renowned expert in microbiology, who guided Ashley Curtis during her graduate studies at the University of Missouri."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;UNIVERSITY OF MISSOURI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Missouri is an educational institution where Curtis is enrolled and actively participates in academic and research activities."&lt;SEP&gt;"University of Missouri is a public research university in Columbia, Missouri, known for its commitment to advancing knowledge and understanding."&lt;SEP&gt;"University of Missouri is a public research university in Columbia, Missouri, where Ashley Curtis pursued her graduate studies."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;COLUMBIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Columbia is the city where the University of Missouri is located."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Science Foundation is a United States government agency that supports fundamental research and education in all the non-medical fields of science and engineering."&lt;SEP&gt;"National Science Foundation provided a grant for Ashley Curtis's research project on antimicrobial properties of novel compounds."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;JOURNAL OF MICROBIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Microbiology is an international publication that publishes research articles in the field of microbiology."&lt;SEP&gt;"Journal of Microbiology is an international publication where Ashley Curtis's research findings were published."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;RENOWNED RESEARCHER ASHLEY CURTIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Renowned Researcher Ashley Curtis is a distinguished scientist with expertise in regenerative medicine and stem cell therapy."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;SEOUL, SOUTH KOREA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seoul, South Korea is the capital city of South Korea, where Kyung Hee University Medical Center is located."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;REGENERATIVE MEDICINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Regenerative medicine is a field of medicine that aims to repair or replace damaged tissues and organs using stem cells and other biological methods."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;CHRONIC DISEASES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chronic diseases are long-term health conditions that require ongoing management and care."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;CUTTING-EDGE TREATMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cutting-edge treatments refer to advanced medical therapies that are at the forefront of medical science."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;PARKINSON'S DISEASE&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Parkinson's disease is a progressive disorder of the nervous system that affects movement."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;STEM CELL THERAPY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Stem cell therapy is a medical treatment that uses stem cells to treat or prevent disease."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;TISSUE ENGINEERING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Tissue engineering is a field of bioengineering that deals with the creation of functional substitutes or repairs to damaged tissues."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;CLINICAL TRIAL PHASE&quot;">
      <data key="d0">"STAGE"</data>
      <data key="d1">"Clinical trial phase refers to the stage in drug development where the safety and efficacy of a treatment are tested in humans."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;COLUMBIA, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Columbia, Missouri is the city where the University of Missouri is located."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;INTELLECTUAL CURIOSITY AND DISCOVERY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual curiosity and discovery refer to the pursuit of knowledge and understanding in academic and research settings."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"COMMUNITY"</data>
      <data key="d1">"Academic community refers to the network of scholars, researchers, and students engaged in the pursuit of knowledge and education."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;MICROBIOLOGY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Microbiology is the branch of biology that deals with the study of microorganisms such as bacteria, viruses, and fungi."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;ANTIMICROBIAL PROPERTIES&quot;">
      <data key="d0">"PROPERTY"</data>
      <data key="d1">"Antimicrobial properties refer to the ability of substances to inhibit or kill microorganisms."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;NOVEL COMPOUNDS&quot;">
      <data key="d0">"COMPOUND"</data>
      <data key="d1">"Novel compounds are new chemical substances with unique properties and potential applications."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;PUBLIC RESEARCH UNIVERSITY&quot;">
      <data key="d0">"INSTITUTION"</data>
      <data key="d1">"Public research university is a type of higher education institution that conducts research and provides education in various fields."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;RESEARCH EXCELLENCE&quot;">
      <data key="d0">"QUALITY"</data>
      <data key="d1">"Research excellence refers to the high standard and quality of research conducted at an institution."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY COLLABORATION&quot;">
      <data key="d0">"COLLABORATION"</data>
      <data key="d1">"Interdisciplinary collaboration refers to the cooperation between professionals from different fields to achieve a common goal."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;GRADUATE PROGRAM&quot;">
      <data key="d0">"PROGRAM"</data>
      <data key="d1">"Graduate program is a postgraduate academic program that provides advanced training in a specific field of study."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;RESEARCH PROJECT&quot;">
      <data key="d0">"PROJECT"</data>
      <data key="d1">"Research project is a structured effort to investigate a specific topic or problem in a systematic manner."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;CO-AUTHORSHIP&quot;">
      <data key="d0">"RELATIONSHIP"</data>
      <data key="d1">"Co-authorship refers to the collaborative effort of multiple authors in publishing a research paper."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;TESTIMONIALS&quot;">
      <data key="d0">"EVIDENCE"</data>
      <data key="d1">"Testimonials are provided by colleagues and mentors, including Dr. Smith, attesting to Curtis's dedication and contributions."&lt;SEP&gt;"Testimonials are statements or accounts given by individuals who have firsthand experience with a particular subject or situation."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;COLLEAGUES AND MENTORS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Colleagues and mentors are individuals who work or study alongside someone and provide guidance and support."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;RESEARCH COMMUNITY&quot;">
      <data key="d0">"COMMUNITY"</data>
      <data key="d1">"Research community refers to the network of researchers and scholars engaged in the pursuit of knowledge and discovery."</data>
      <data key="d2">cb-0150</data>
    </node>
    <node id="&quot;CURTIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Curtis is affiliated with the University of Missouri and is involved in various academic and research activities."</data>
