  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JON HILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jon Hill is an American chef who served as the White House Executive Chef from October 1, 1987, to January 7, 1988, and is also an actor known for his role as Detective Marcus Bell in 'Elementary'."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;BRIAN HILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brian Hill is an American chef who was a contestant on the first season of 'Top Chef' and has appeared on 'Bar Rescue' and 'Private Chefs of Beverly Hills'. He also launched the Comfort Truck in Los Angeles, California."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;VICTOR M. HILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Victor M. Hill is a chef and instructor of hotel-motel and restaurant management at Spokane Community College, and is Jon Hill's father."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;SPOKANE, WASHINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spokane, Washington, is the birthplace of Jon Hill and the location where he studied restaurant management."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;WHITE HOUSE EXECUTIVE CHEF&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"White House Executive Chef is a position held by Jon Hill from October 1, 1987, to January 7, 1988, and refers to the chef responsible for preparing meals for the President and guests of the White House."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;TOP CHEF&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Top Chef is a television show where Brian Hill competed in the first season."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;BAR RESCUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bar Rescue is a television show where Brian Hill has appeared."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;PRIVATE CHEFS OF BEVERLY HILLS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Private Chefs of Beverly Hills is a Food Network reality show where Brian Hill was one of the six regular chefs."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;COMFORT TRUCK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Comfort Truck is a food truck launched by Brian Hill in Los Angeles, California."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;DETECTIVE MARCUS BELL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Detective Marcus Bell is a role played by Jon Hill in the CBS series 'Elementary'."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;WAUKEGAN, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Waukegan, Illinois, is the birthplace of Jon Michael Hill."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;NORTHWESTERN UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Northwestern University is where Jon Michael Hill attended a summer drama program during his high school years."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;UNIVERSITY OF ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Illinois is where Jon Michael Hill graduated with a Bachelor of Fine Arts degree."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;ELEMENTARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Elementary is a CBS series where Jon Michael Hill played the role of Detective Marcus Bell."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;JOSEPH JEFFERSON AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Joseph Jefferson Award is an award for which Jon Michael Hill was nominated while at the University of Illinois."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;PERCY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Percy is a character in a film, played by a young Graham, and is likely a supporting role."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;LEGUIZAMO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leguizamo is an actor who plays a significant role in a film, making the most of his best role in ages."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;INEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Inez is a character in a film, living in a luxurious house with an armada of domestic staff."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;LUXURIOUS HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Luxurious House is the residence of Inez, described as having an armada of domestic staff."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <node id="&quot;DOMESTIC STAFF&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Domestic Staff refers to the group of people employed to maintain the luxurious house of Inez."</data>
      <data key="d2">ramdocs-0230-94842671373a</data>
    </node>
    <edge source="&quot;JON HILL&quot;" target="&quot;WHITE HOUSE EXECUTIVE CHEF&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Jon Hill served as the White House Executive Chef from October 1, 1987, to January 7, 1988, making him the first American-born chef to hold this position."</data>
      <data key="d5">"historical significance, leadership"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
    <edge source="&quot;JON HILL&quot;" target="&quot;VICTOR M. HILL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jon Hill's father, Victor M. Hill, is a chef and instructor of hotel-motel and restaurant management at Spokane Community College, influencing Jon's early interest in cooking."</data>
      <data key="d5">"family influence, mentorship"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
    <edge source="&quot;JON HILL&quot;" target="&quot;BRIAN HILL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Both Jon Hill and Brian Hill are chefs, with Jon serving as the White House Executive Chef and Brian competing on 'Top Chef', indicating a family legacy in the culinary field."</data>
      <data key="d5">"family legacy, culinary expertise"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
    <edge source="&quot;BRIAN HILL&quot;" target="&quot;TOP CHEF&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Brian Hill competed on the first season of 'Top Chef', showcasing his culinary skills in a national competition."</data>
      <data key="d5">"competition, culinary recognition"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
    <edge source="&quot;BRIAN HILL&quot;" target="&quot;BAR RESCUE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Brian Hill has appeared on 'Bar Rescue', indicating his involvement in various culinary-related television shows and events."</data>
      <data key="d5">"television appearances, culinary expertise"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
    <edge source="&quot;BRIAN HILL&quot;" target="&quot;PRIVATE CHEFS OF BEVERLY HILLS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Brian Hill was one of the six regular chefs on 'Private Chefs of Beverly Hills', highlighting his role in high-profile culinary productions."</data>
      <data key="d5">"television appearances, culinary expertise"</data>
      <data key="d6">ramdocs-0230-94842671373a</data>
    </edge>
