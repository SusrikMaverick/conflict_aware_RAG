  <graph edgedefault="undirected">
    <node id="&quot;NATIONAL AUTONOMOUS UNIVERSITY OF MEXICO (UNAM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UNAM is a prestigious university located in Mexico City, known for its research centers and academic programs."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;INSTITUTO DE FISIOLOGÍA CELULAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Instituto de Fisiología Celular is a renowned research center within UNAM, dedicated to cellular physiology research."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;ALFREDO CABRERA-OREFICE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alfredo Cabrera-Orefice is a brilliant researcher and academic who has made significant contributions to the fields of cellular physiology and international relations."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;MEXICO CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexico City is the capital city of Mexico and the location of UNAM and the Instituto de Fisiología Celular."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;DR. MARÍA DEL CARMEN ROMANO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. María del Carmen Romano is a distinguished professor at the Instituto de Fisiología Celular who mentored Alfredo Cabrera-Orefice."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;DR. MARIE-PIERRE POULIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marie-Pierre Poulin is a prominent professor of international relations at Sciences Po who advised Alfredo Cabrera-Orefice's thesis."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;SCIENCES PO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sciences Po is a renowned French university known for its programs in political science and international relations."&lt;SEP&gt;"Sciences Po is an educational institution that instilled the speaker with a rigorous approach to research, a commitment to intellectual honesty, and a passion for understanding global politics."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard University is a prestigious American university where Alfredo Cabrera-Orefice pursued his Ph.D. in political science."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;JOURNAL OF CELLULAR PHYSIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Cellular Physiology is a scientific journal where Alfredo Cabrera-Orefice published his research on ion channels in neuronal cells."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;REVISTA DE FISIOLOGÍA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Revista de Fisiología is the official journal of the Instituto de Fisiología Celular where Alfredo Cabrera-Orefice published several articles."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;PARIS, FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris, France is the location of Sciences Po where Alfredo Cabrera-Orefice earned his undergraduate degree."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;GLOBAL GOVERNANCE IN THE 21ST CENTURY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Global Governance in the 21st Century is the title of Alfredo Cabrera-Orefice's latest book on international relations."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;UNAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UNAM is a prestigious university located in Mexico City, known for its research centers and academic programs."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;CELLULAR PHYSIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cellular physiology is the field of study focused on the functions and processes of cells."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;INTERNATIONAL RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International relations is the field of study concerned with the interactions between countries and their governments."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic community refers to the group of scholars, researchers, and students engaged in scholarly pursuits."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;SCIENTIFIC INQUIRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific inquiry involves systematic investigation and research aimed at discovering facts and principles."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;GLOBAL POLITICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Global politics encompasses the interactions and conflicts between nations and international organizations."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;CONFLICT RESOLUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conflict resolution involves efforts to end or prevent disputes between parties."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research projects are structured efforts to investigate and explore specific scientific questions."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publications are written works, such as articles or books, that disseminate research findings."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;RESEARCH JOURNALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research journals are peer-reviewed publications that contain scholarly articles."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;RESEARCH NETWORK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research network refers to a group of researchers and institutions collaborating on research projects."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;ACADEMIC EVENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic events include conferences, seminars, and workshops where scholars gather to discuss research and ideas."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;INTELLECTUAL CURIOSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual curiosity is the desire to learn and understand new ideas and concepts."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;LIKE-MINDED INDIVIDUALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Like-minded individuals are people who share similar interests, beliefs, or goals."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;CONVENTIONAL THINKING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conventional thinking refers to the standard or accepted ways of thinking about a topic."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is the speaker who credits Sciences Po for shaping his values and approach to work."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;RIGOROUS APPROACH TO RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rigorous approach to research is a value instilled by Sciences Po that guides the speaker's work."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;COMMITMENT TO INTELLECTUAL HONESTY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment to intellectual honesty is a value instilled by Sciences Po that guides the speaker's work."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;PASSION FOR UNDERSTANDING GLOBAL POLITICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Passion for understanding global politics is a value instilled by Sciences Po that guides the speaker's work."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;CAREER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Career is the context in which the speaker applies the values and approaches learned at Sciences Po."</data>
      <data key="d2">cb-0066</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d2">cb-0066</data>
      <data key="d1">"Harvard University is located in the United States."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
