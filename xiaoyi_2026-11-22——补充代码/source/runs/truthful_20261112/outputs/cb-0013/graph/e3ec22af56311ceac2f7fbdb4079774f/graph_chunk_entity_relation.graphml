<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the Eternal City where Johannes Moreelse arrived in 1627, known for its vibrant artistic community and rich cultural heritage."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;UTRECHT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Utrecht is the birthplace of Johannes Moreelse, located in the Netherlands."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;GALLERIA BORGHESE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Galleria Borghese is the location where Moreelse's 'Portrait of a Young Man' is housed."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;MUSÉE DES BEAUX-ARTS IN LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Musée des Beaux-Arts in Lyon is the location where Moreelse's 'Bacchus and Ariadne' is housed."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;CARAVAGGIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Caravaggio is a master artist whose innovative use of light and darkness influenced Moreelse."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;BERNINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bernini is another master artist who pushed the boundaries of art in Rome."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;JOHANNES MOREELSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johannes Moreelse is a young Dutch painter born around 1603, known for his works in both Rome and Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;ABRAHAM BLOEMAERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abraham Bloemaert is a renowned painter who trained Moreelse in his studio."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the City of Light where Moreelse lived and worked in 1625, known for its vibrant artistic soul and salons."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;LATIN QUARTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Latin Quarter is the neighborhood in Paris where Moreelse's atelier was located."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;SEINE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seine River flows through the heart of Paris, reflecting the city's artistic soul."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;LOUVRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louvre is a majestic grandeur building in Paris that inspired Moreelse's art."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;PONT DES ARTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pont des Arts is a whimsical charm bridge in Paris that inspired Moreelse's art."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;RENÉ DESCARTES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"René Descartes is a philosopher and mathematician who engaged in lively debates with Moreelse in Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;PIERRE CORNEILLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Corneille is a playwright who engaged in lively debates with Moreelse in Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;MADAME DE RAMBOUILLET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame de Rambouillet is a patron of the arts who commissioned Moreelse to create a series of paintings capturing the essence of Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;ETERNAL CITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Eternal City is a nickname for Rome, emphasizing its historical and cultural significance."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;DUTCH BAROQUE STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dutch Baroque style is the artistic style Moreelse was trained in and later adapted in Rome."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;ITALIAN RENAISSANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Italian Renaissance is the artistic movement that fascinated Moreelse and influenced his decision to move to Rome."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;CREATIVE FERVOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creative fervor describes the atmosphere in Rome that attracted artists from across Europe."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;ARTISTIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artistic community refers to the network of artists and patrons Moreelse encountered in Rome."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;AVANT-GARDE MINDS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Avant-garde minds describe the revolutionary thinkers and artists in Paris during the early 17th century."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;CITY OF LIGHT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"City of Light is a nickname for Paris, emphasizing its role as a center of enlightenment and art."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;ARTISTIC SOUL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artistic soul describes the vibrant and creative atmosphere in both Rome and Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;SALONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Salons are social gatherings where artists and intellectuals exchanged ideas in Paris."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;CREATIVE SPIRIT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creative spirit describes the passion and drive of artists like Moreelse in both cities."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;DYNAMIC ENERGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dynamic energy describes the liveliness and intensity of Moreelse's paintings."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;HOME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Home is a place where people live and consider it their base or center of operations."</data>
      <data key="d2">cb-0013</data>
    </node>
    <node id="&quot;THOSE WHO CALLED IT HOME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Those who call a place home are a group of people who consider a specific location their residence."</data>
      <data key="d2">cb-0013</data>
    </node>
    <edge source="&quot;ROME&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Johannes Moreelse arrived in Rome in 1627, where he was influenced by the city's artistic community and masters like Caravaggio and Bernini."</data>
      <data key="d5">"influence, artistic development"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;UTRECHT&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Johannes Moreelse was born in Utrecht, Netherlands, before moving to Rome and then Paris."</data>
      <data key="d5">"birthplace, migration"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;GALLERIA BORGHESE&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Moreelse's 'Portrait of a Young Man' is housed in the Galleria Borghese, showcasing his ability to capture human emotion."</data>
      <data key="d5">"exhibition, artistic achievement"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;MUSÉE DES BEAUX-ARTS IN LYON&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Moreelse's 'Bacchus and Ariadne' is housed in the Musée des Beaux-Arts in Lyon, demonstrating his growing confidence in color and composition."</data>
      <data key="d5">"exhibition, artistic achievement"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;CARAVAGGIO&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Moreelse was influenced by Caravaggio's innovative use of light and darkness, evident in his works like 'Portrait of a Young Man'."</data>
      <data key="d5">"influence, artistic technique"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;BERNINI&quot;" target="&quot;JOHANNES MOREELSE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Moreelse was influenced by the city's vibrant artistic community, including Bernini, who pushed the boundaries of art in Rome."</data>
      <data key="d5">"influence, artistic development"</data>
      <data key="d6">cb-0013</data>
    </edge>
    <edge source="&quot;HOME&quot;" target="&quot;THOSE WHO CALLED IT HOME&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Those who call it home consider the place their residence."</data>
      <data key="d5">"residence, belonging"</data>
      <data key="d6">cb-0013</data>
    </edge>
  </graph>
</graphml>
