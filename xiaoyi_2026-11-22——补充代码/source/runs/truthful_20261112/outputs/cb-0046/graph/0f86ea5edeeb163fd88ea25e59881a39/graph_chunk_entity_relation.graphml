  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JEAN MASSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean Masson is a Roman Catholic bishop who has served as the Prefect of Doubs since 2015, born in Besançon, France, and has a deep commitment to serving the Church and the community."&lt;SEP&gt;"Jean Masson is an individual recognized for exceptional dedication, wisdom, and leadership, selected as an auxiliary bishop to assist the diocesan bishop."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;PREFECT OF DOUBS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Prefect of Doubs is a position held by Jean Masson since 2015, marking a significant milestone as the first Roman Catholic bishop to hold this position."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;BESANÇON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Besançon is a city in France where Jean Masson was born and received his early education."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;LYCÉE SAINT-JEAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lycée Saint-Jean is the school where Jean Masson received his early education in Besançon."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;SEMINARY OF FRASNE-LE-CHÂTEAU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seminary of Frasne-le-Château is where Jean Masson pursued his priestly formation."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;BISHOP LUCIEN DALOZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Lucien Daloz ordained Jean Masson as a priest on June 29, 1991."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;FRANÇOIS HOLLANDE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"François Hollande appointed Jean Masson as the Prefect of Doubs on February 10, 2015."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;POPE BENEDICT XVI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Benedict XVI elevated Jean Masson to the rank of Monsignor in 2010."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;JOURNAL OF FRENCH ADMINISTRATIVE HISTORY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of French Administrative History published a study in 2017 noting the significance of Jean Masson's appointment as Prefect of Doubs."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;LE FIGARO&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Le Figaro is a French newspaper where Jean Masson was interviewed in 2018 about his approach to governance."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;ÉDITIONS DU CERF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Éditions du Cerf published a biography of Jean Masson titled 'Jean Masson: A Life of Service' in 2020."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Church is the religious institution Jean Masson serves within, with the Pope as its spiritual leader."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;DIOCESE OF BESANÇON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Diocese of Besançon is the diocese where Jean Masson served as a parish priest and later as Vicar General."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;AUXILIARY BISHOP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Auxiliary bishop is a position Jean Masson holds, assisting the diocesan bishop in the governance of the diocese."&lt;SEP&gt;"Auxiliary bishop is a position within the diocese where the individual assists the diocesan bishop in governance and provides counsel on important matters."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;POPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Pope is the spiritual leader of the global Catholic community, with whom Jean Masson interacts through his appointments and roles."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;DIOCESAN BISHOP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Diocesan bishop is the position held by the bishop of a diocese, with whom Jean Masson interacts as both a parish priest and as Prefect of Doubs."&lt;SEP&gt;"Diocesan bishop is the primary leader of the diocese, for whom the auxiliary bishop provides support and counsel."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;INTERFAITH DIALOGUE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interfaith dialogue is a concept mentioned as part of Jean Masson's role in promoting cooperation and understanding."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community refers to the group of people Jean Masson serves and aims to benefit through his governance and leadership."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;PUBLIC OFFICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public office is a concept that relates to the role of Jean Masson as Prefect of Doubs, involving governance and representation."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;FRENCH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French government is the governmental body that appoints Jean Masson to various positions, including Prefect of Doubs."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;DIOCESE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Diocese is a territorial unit of the Catholic Church, with Besançon being the location of the Diocese of Besançon."&lt;SEP&gt;"Diocese is the administrative region overseen by the diocesan bishop and where the auxiliary bishop works."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;INTEGRITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Integrity is a concept mentioned as part of Jean Masson's approach to governance, emphasizing honesty and moral uprightness."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;EXCEPTIONAL DEDICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Exceptional dedication refers to the outstanding commitment and effort demonstrated by Jean Masson."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;WISDOM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Wisdom is highlighted as one of the qualities that Jean Masson possesses, indicating his sound judgment and insight."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;LEADERSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Leadership is mentioned as one of the qualities that Jean Masson demonstrates, indicating his ability to guide and inspire others."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;TESTAMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Testament is used to describe the recognition of Jean Masson's qualities, signifying a formal acknowledgment."</data>
      <data key="d2">cb-0046</data>
    </node>
    <node id="&quot;CRITICAL SUPPORT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Critical support refers to the essential assistance provided by the auxiliary bishop to the diocesan bishop."</data>
      <data key="d2">cb-0046</data>
    </node>
