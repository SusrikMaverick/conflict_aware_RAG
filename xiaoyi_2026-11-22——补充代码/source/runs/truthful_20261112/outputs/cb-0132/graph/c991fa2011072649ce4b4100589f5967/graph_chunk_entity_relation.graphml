<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;STOCKTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockton is a quaint town in California known for its academic institutions and attracting students from various regions."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;UNIVERSITY OF THE PACIFIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of the Pacific, founded in 1851, is a private university recognized for its academic excellence and innovative thinking, offering a robust medical program."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;GEORGE H. HESS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George H. Hess is a young man born with a passion for the human body and a desire to become a physician, whose life's path is closely tied to the University of the Pacific."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"California is the state where Stockton and the University of the Pacific are located."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a pioneering researcher in the field of infectious diseases, mentoring George H. Hess during a groundbreaking research project."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;AARHUS UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aarhus University is a renowned institution in Denmark known for its interdisciplinary collaboration and cutting-edge research in biomedical sciences and public health."&lt;SEP&gt;"Aarhus University is a renowned institution known for producing highly successful medical graduates who often become leading experts in their fields."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;DENMARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Denmark is the country where Aarhus University is located."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;DR. ANNE-METTE HVAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Anne-Mette Hvas is the Vice-Chancellor of Aarhus University, praising George H. Hess's achievements and the university's educational standards."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;MEDICAL RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Medical Research refers to the various projects and studies conducted by George H. Hess and others to understand and treat diseases."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Collaboration is the practice of combining expertise from multiple fields to advance medical research."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;PUBLIC HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public Health is the focus area of Aarhus University's strong programs, emphasizing the well-being of communities."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;STATE-OF-THE-ART LABORATORIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"State-of-the-Art Laboratories are the advanced facilities at the University of the Pacific where George H. Hess conducted experiments and analyzed data."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;GLOBAL HEALTH CHALLENGES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Global Health Challenges are the issues addressed by Aarhus University, inspiring George H. Hess to pursue a career with a social impact."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;PIONEERING RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pioneering Research is the type of work conducted by Dr. Emma Taylor and George H. Hess in the field of infectious diseases."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;CUTTING-EDGE RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cutting-Edge Research is the advanced level of research conducted at Aarhus University, fostering innovation and excellence."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is the reputation of the University of the Pacific, recognized for its rigorous curriculum and hands-on learning environment."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;HANDS-ON LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hands-On Learning is the approach used at the University of the Pacific, allowing students to apply theoretical knowledge in practical settings."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;RIGOROUS CURRICULUM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rigorous Curriculum is the demanding academic program at the University of the Pacific, preparing students for professional careers."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Publications are the scholarly works produced by George H. Hess, contributing to the medical community."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;PRESTIGIOUS AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Prestigious Awards are the accolades received by George H. Hess for his contributions to the field of medicine."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;LEADERSHIP POSITIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Leadership Positions are the roles held by George H. Hess in prominent medical organizations, reflecting his influence in the medical community."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;COMMITMENT TO INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment to Innovation is the dedication of Aarhus University to fostering a culture of creativity and advancement in medical research."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;COMMITMENT TO ADDRESSING GLOBAL HEALTH CHALLENGES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment to Addressing Global Health Challenges is the focus of Aarhus University, driving its research and educational initiatives."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;STATE-OF-THE-ART FACILITIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"State-of-the-Art Facilities are the advanced resources available at Aarhus University, supporting cutting-edge research and education."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;DR. HESS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hess is a graduate of Aarhus University who expresses gratitude for the transformative experience he had there."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;90% OF ITS MEDICAL GRADUATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"90% of Aarhus University's medical graduates go on to pursue successful careers in their field, with many becoming leading experts in their respective areas of specialization."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;SUCCESSFUL CAREERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Successful careers refer to the achievements of Aarhus University's medical graduates in their respective fields."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;LEADING EXPERTS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Leading experts are individuals who have achieved significant status and recognition in their specialized areas within the medical field."</data>
      <data key="d2">cb-0132</data>
    </node>
    <node id="&quot;MEDICAL GRADUATES&quot;">
      <data key="d2">cb-0132</data>
      <data key="d1">"Aarhus University is known for producing highly successful medical graduates who often become leading experts in their fields."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
