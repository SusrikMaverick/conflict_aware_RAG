    <node id="&quot;ALAN TUPEK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alan Tupek is a renowned statistician known for his groundbreaking work in data analysis and machine learning, and a member of the American Statistical Association."</data>
      <data key="d2">cb-0243</data>
    </node>
    <node id="&quot;ISCHOOLS CONSORTIUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"iSchools consortium is a nonprofit corporation comprising the world's leading information schools, dedicated to advancing the study of information and its role in society."</data>
      <data key="d2">cb-0243</data>
    </node>
    <node id="&quot;AMERICAN STATISTICAL ASSOCIATION (ASA)&quot;">
