<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHRISTIANE ZARFL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christiane Zarfl is a renowned German environmental scientist with strong ties to the University of Tübingen and the Institute of Nano Science and Technology. She has contributed significantly to environmental science and is known for her expertise in eco-toxicology and environmental sustainability."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;UNIVERSITY OF TÜBINGEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Tübingen is a prestigious public research university in Tübingen, Germany, where Christiane Zarfl has worked closely with faculty members and contributed to research initiatives on environmental sustainability and conservation."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;INSTITUTE OF NANO SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institute of Nano Science and Technology is a research hub in New Delhi, India, focused on cutting-edge research in nanotechnology, particularly in the field of environmental nanotechnology. Christiane Zarfl joined the institute to develop novel nanomaterials for environmental remediation."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;NEW DELHI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Delhi is the capital city of India where the Institute of Nano Science and Technology is located."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;DR. BERND SCHERER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Bernd Scherer is the Dean of the Faculty of Science at the University of Tübingen, praising Christiane Zarfl's contributions to the institution."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;PROFESSOR DR. MARIA SCHMITZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Dr. Maria Schmitz is a colleague of Christiane Zarfl at the University of Tübingen, highlighting her expertise and dedication to environmental science."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;DR. RAMESH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ramesh is the director of the Institute of Nano Science and Technology, introducing Christiane Zarfl to the team and discussing project objectives."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is a primary collaborator of Christiane Zarfl at the Institute of Nano Science and Technology, working on developing novel nanomaterials for environmental remediation."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;STUDENT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Students at the University of Tübingen and the Institute of Nano Science and Technology are engaged in research and learning activities, providing feedback on lectures and seminars."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;NANOTECHNOLOGY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nanotechnology is the field of research at the Institute of Nano Science and Technology, focusing on developing nanomaterials for environmental remediation."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate change is a topic of research at the University of Tübingen, specifically in the context of its impact on freshwater ecosystems."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;FRESHWATER ECOSYSTEMS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Freshwater ecosystems are the subject of research at the University of Tübingen, studying their impact and conservation."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;ECO-TOXICOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Eco-toxicology is a field of expertise for Christiane Zarfl, contributing to her research and teaching at the University of Tübingen."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental sustainability is a focus area of research at both the University of Tübingen and the Institute of Nano Science and Technology."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;ENVIRONMENTAL REMEDIATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental remediation is the goal of Christiane Zarfl's research at the Institute of Nano Science and Technology, involving the development of nanomaterials."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;STATE-OF-THE-ART FACILITIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"State-of-the-art facilities, such as the nanofabrication lab, are available at the Institute of Nano Science and Technology, supporting advanced research."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary collaboration is emphasized at the Institute of Nano Science and Technology, fostering innovation and debate among researchers."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;BONFIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A bonfire is a gathering point for students at the Institute of Nano Science and Technology, where they share stories and engage in discussions."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;MOLECULES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Molecules are depicted in a vibrant mural at the Institute of Nano Science and Technology, symbolizing the institute's focus on nanotechnology."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;NATURAL WORLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The natural world is represented in a mural at the Institute of Nano Science and Technology, emphasizing the institute's commitment to sustainability."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;RESEARCH INSTITUTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A community driven by a shared passion for discovery and a commitment to making a positive impact on the world."&lt;SEP&gt;"Research institution is a community driven by a shared passion for discovery and a commitment to making a positive impact on the world."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A group within the research institution that shares a passion for discovery and a commitment to making a positive impact."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;PASSION FOR DISCOVERY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A shared interest and drive within the community to explore and discover new things."</data>
      <data key="d2">cb-0310</data>
    </node>
    <node id="&quot;COMMITMENT TO POSITIVE IMPACT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A shared goal within the community to contribute positively to the world."</data>
      <data key="d2">cb-0310</data>
    </node>
