  <graph edgedefault="undirected">
    <node id="&quot;BARTHOLOMEW GREEN (PRINTER, BORN 1666)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bartholomew Green (printer, born 1666) was a printer and later the publisher of The Boston News-Letter, born in Cambridge, Massachusetts. He was the first to change the focus of the newspaper to domestic events."</data>
      <data key="d2">ramdocs-0357-b0de1b628419</data>
    </node>
    <node id="&quot;JOHN CAMPBELL&quot;">
      <data key="d2">ramdocs-0357-b0de1b628419</data>
      <data key="d1">"John Campbell was the first editor of The Boston News-Letter."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;THE BOSTON NEWS-LETTER&quot;">
      <data key="d2">ramdocs-0357-b0de1b628419</data>
      <data key="d1">"John Campbell was the first editor of The Boston News-Letter."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;GREEN (PRINTER, BORN 1700)&quot;">
      <data key="d2">ramdocs-0357-b0de1b628419</data>
      <data key="d1">"Green (printer, born 1700) took over the editorship of The Boston News-Letter in 1722."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BARTHOLOMEW GREEN JR.&quot;">
      <data key="d2">ramdocs-0357-b0de1b628419</data>
      <data key="d1">"Bartholomew Green Jr. began printing the 'Boston Gazette' in 1725, making it a rival to his father's 'Boston News-Letter'. "</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
