  <graph edgedefault="undirected">
    <node id="&quot;ARISTOCRATIC UNION UNCOVERED&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Aristocratic Union Uncovered is a news event revealing the marriage between Deirdre Ellis and Michael Charles Granville Gulliver, highlighting the intricate connections within the British peerage."</data>
      <data key="d2">cb-0005</data>
    </node>
    <node id="&quot;DEIRDRE ELLIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Deirdre Ellis is a respected figure in British society, married to Michael Charles Granville Gulliver, and involved in philanthropic endeavors focused on education and women's empowerment."</data>
      <data key="d2">cb-0005</data>
    </node>
    <node id="&quot;MICHAEL CHARLES GRANVILLE GULLIVER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Charles Granville Gulliver is a member of the British aristocracy, born in 1933, and married to Deirdre Ellis."</data>
