    <node id="&quot;DON'T DRINK THE WATER (1969 FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Don't Drink the Water (1969 film) is a 1969 American comedy film starring Jackie Gleason and Estelle Parsons, directed by Howard Morris, and based on a 1966 play by Woody Allen."</data>
      <data key="d2">ramdocs-0452-c6a797a2b685</data>
    </node>
