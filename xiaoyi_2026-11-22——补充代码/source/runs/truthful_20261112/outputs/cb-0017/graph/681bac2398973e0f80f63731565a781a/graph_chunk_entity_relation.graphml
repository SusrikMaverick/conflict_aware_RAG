<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ADOLF THEIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adolf Thein is a young man born in Valašské Meziříčí, Czech Republic, in 1911, who grows up in a Jewish community and becomes involved in helping his fellow Jews during the Holocaust."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;VALAŠSKÉ MEZIŘÍČÍ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Valašské Meziříčí is a town in the Czech Republic where Adolf Thein was born and grew up, known for its Baroque architecture and strong sense of community."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;CZECH REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Czech Republic is the country where Valašské Meziříčí is located, and where Adolf Thein's early life took place."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;RABBI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Rabbi is a religious leader at the synagogue in Valašské Meziříčí, inspiring Adolf with words of wisdom."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;SYNAGOGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Synagogue in Valašské Meziříčí is a place of worship and community for the Jewish residents, where Adolf was inspired by the Rabbi and Cantor."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;ABRAHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abraham is Adolf Thein's father, a respected member of the Jewish community in Valašské Meziříčí."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;RACHEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rachel is Adolf Thein's mother, a respected member of the Jewish community in Valašské Meziříčí."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;GERMAN ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German army invades Czechoslovakia in 1939, occupying Valašské Meziříčí and transforming it into a hub of Nazi activity."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;NAZISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Nazism refers to the ideology and practices of the Nazi regime, which led to the persecution of Jews in Valašské Meziříčí."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;VALAŠSKÉ MEZIŘÍČÍ SYNAGOGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The synagogue in Valašské Meziříčí is a place of worship and community for the Jewish residents, which was desecrated and destroyed by the Nazis."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;BRNO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brno is a city in the Czech Republic where Adolf Thein also lived, known for its Gothic spires and vibrant community."&lt;SEP&gt;"Brno is the place where the person feels at home, symbolizing a peaceful environment before the onset of war."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;ŠPILBERK CASTLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Špilberk Castle is a landmark in Brno, a city where Adolf Thein lived and loved."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;SVRATKA RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Svratka River flows gently through Brno, a city where Adolf Thein lived and loved."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;FRAU MÜLLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frau Müller is an elderly seamstress in Brno who is kind to Adolf and offers him a pinch of sugar for his morning coffee."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;JAKUB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jakub is an apprentice blacksmith in Brno, a city where Adolf Thein lived and loved, whose laughter echoes through the square."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;TOMÁŠ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tomáš is a six-year-old boy in Brno, a city where Adolf Thein lived and loved, whom Adolf watches grow up from a toddler."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;JEWISH COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Jewish community in Valašské Meziříčí is a group of people who practice Judaism and form a tight-knit social network."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;BAROQUE ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Baroque architecture refers to the ornate and elaborate style of buildings found in Valašské Meziříčí, including the Church of the Assumption."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;CHURCH OF THE ASSUMPTION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Church of the Assumption in Valašské Meziříčí is a historical building with Baroque architecture, where Adolf explored and marveled."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;WINDS OF WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Winds of War represent the impending conflict that threatens to disrupt peace and the lives of many."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is a person who feels grateful to call Brno his home and whose life is threatened by the upcoming war."</data>
      <data key="d2">cb-0017</data>
    </node>
    <node id="&quot;WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"War is the conflict that is about to start, disrupting the peace and the lives of people."</data>
      <data key="d2">cb-0017</data>
    </node>
    <edge source="&quot;ADOLF THEIN&quot;" target="&quot;VALAŠSKÉ MEZIŘÍČÍ&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Adolf Thein was born and grew up in Valašské Meziříčí, a town in the Czech Republic, surrounded by a Jewish community and Baroque architecture."</data>
      <data key="d5">"birthplace, upbringing, community"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;ADOLF THEIN&quot;" target="&quot;RABBI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Adolf Thein was inspired by the Rabbi's words of wisdom at the synagogue in Valašské Meziříčí."</data>
      <data key="d5">"inspiration, spiritual guidance"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;ADOLF THEIN&quot;" target="&quot;SYNAGOGUE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Adolf Thein attended services at the synagogue in Valašské Meziříčí, a place of worship and community for the Jewish residents."</data>
      <data key="d5">"worship, community"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;BRNO&quot;" target="&quot;HE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"He feels grateful to call Brno his home, indicating a strong attachment to the place before the war starts."</data>
      <data key="d5">"attachment, peace"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;BRNO&quot;" target="&quot;WINDS OF WAR&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The peaceful rhythm of Brno is threatened by the Winds of War, suggesting a broader impact on the city and its inhabitants."</data>
      <data key="d5">"peace, conflict"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;WINDS OF WAR&quot;" target="&quot;HE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Winds of War threaten to disrupt the peaceful life of 'he', indicating a direct impact on his life."</data>
      <data key="d5">"disruption, threat"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;WINDS OF WAR&quot;" target="&quot;WAR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Winds of War represent the impending war, indicating the cause of the disruption and threat to peace."</data>
      <data key="d5">"cause, conflict"</data>
      <data key="d6">cb-0017</data>
    </edge>
    <edge source="&quot;HE&quot;" target="&quot;WAR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"He is directly affected by the war, as it threatens to disrupt his peaceful life and the lives of those he loves."</data>
      <data key="d5">"impact, threat"</data>
      <data key="d6">cb-0017</data>
    </edge>
  </graph>
</graphml>
