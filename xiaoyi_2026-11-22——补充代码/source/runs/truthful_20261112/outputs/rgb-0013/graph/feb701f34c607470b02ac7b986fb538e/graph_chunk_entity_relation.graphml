  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TESLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tesla is an automotive company that reported financial results, specifically four consecutive profitable quarters."</data>
      <data key="d2">rgb-0013</data>
    </node>
    <node id="&quot;$2.18 (EX-ITEMS)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"$2.18 (ex-items) represents the earnings per share reported by Tesla, indicating a positive financial performance."</data>
      <data key="d2">rgb-0013</data>
    </node>
    <node id="&quot;3 CENTS PER SHARE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"3 cents per share is the expected earnings per share, contrasting with the actual earnings of $2.18 (ex-items), highlighting the financial success."</data>
      <data key="d2">rgb-0013</data>
    </node>
    <node id="&quot;$1.04 BILLION&quot;">
      <data key="d0">"EVENT"</data>
