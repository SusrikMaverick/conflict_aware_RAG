  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NALS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nals is a picturesque municipality in South Tyrol, Italy, known for its rich cultural heritage and commitment to sustainability."&lt;SEP&gt;"Nals is a town that has implemented comprehensive recycling programs and eco-friendly infrastructure initiatives."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ACCADEMIA NALENSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Accademia Nalense is a scholarly institution in Nals, dedicated to fostering cross-cultural understanding and collaboration."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;DR. ELISABETTA MORETTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Elisabetta Moretti is the director of the Accademia Nalense, passionate about promoting cross-cultural understanding and collaboration."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ACADEMIA EUROPAEA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academia Europaea is a pan-European academy dedicated to promoting excellence in research and education."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;CLIMATE ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Climate Alliance is a European organization dedicated to promoting sustainable development and reducing greenhouse gas emissions."&lt;SEP&gt;"Climate Alliance is a partner of Nals, facilitating the development of eco-friendly infrastructure."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SOUTH TYROL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Tyrol is a region in northern Italy, known for its unique blend of Italian and Austrian influences."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy is a country in Southern Europe, home to the municipality of Nals and the region of South Tyrol."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ACADEMY'S MISSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Academy's Mission is to foster cross-cultural understanding and collaboration among scholars and researchers from across Europe."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainability is a deeply ingrained philosophy in Nals, encompassing efforts to promote environmental health and reduce carbon footprint."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;COBBLESTONE STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cobblestone streets are the pathways in Nals, contributing to its picturesque charm."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;MEDIEVAL TOWN HALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Medieval town hall is a historical building in Nals, part of its rich cultural heritage."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;PARISH CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parish church is a religious building in Nals, adding to its cultural and historical significance."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;DUSTY BOOKSHELVES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Dusty bookshelves are found inside the Accademia Nalense, symbolizing the institution's academic focus."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;WORN, LEATHER-BOUND ARMCHAIRS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Worn, leather-bound armchairs are scattered inside the Accademia Nalense, providing comfort and warmth."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;FADED SIGN&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Faded sign above the door of the Accademia Nalense reads 'Accademia Nalense', indicating the institution's name."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;DESK&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Desk is where Dr. Elisabetta Moretti works, studying a yellowed manuscript."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;YELLOWED MANUSCRIPT&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Yellowed manuscript is being studied by Dr. Elisabetta Moretti, suggesting ongoing research."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SMALL, LEATHER-BOUND VOLUME&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Small, leather-bound volume is a gift given by Dr. Elisabetta Moretti, containing essays on the intersection of culture and identity."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ROLLING HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rolling hills are part of the landscape surrounding Nals, contributing to its natural beauty."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SNOW-CAPPED MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Snow-capped mountains are part of the landscape surrounding Nals, enhancing its scenic appeal."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;HISTORIC CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Historic center of Nals is characterized by ancient buildings, reflecting its rich cultural heritage."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;GREEN FORESTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Green forests surrounding Nals contribute to its natural beauty and ecological significance."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SOLAR POWER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Solar power is used in Nals for energy production, reducing reliance on fossil fuels."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;PHOTOVOLTAIC PANELS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Photovoltaic panels adorn rooftops and solar farms in Nals, supporting clean energy initiatives."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ELECTRIC AND HYBRID VEHICLES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Electric and hybrid vehicles are part of Nals' transportation system, promoting sustainable mobility."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;BIKE-SHARING SCHEMES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Bike-sharing schemes encourage residents to use bicycles instead of cars, reducing congestion and air pollution."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;PEDESTRIAN-FRIENDLY INFRASTRUCTURE&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"Pedestrian-friendly infrastructure supports walking and cycling, enhancing the town's livability."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;GREEN ROOFS&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"Green Roofs are part of the eco-friendly infrastructure developed by Nals with the help of the Climate Alliance."&lt;SEP&gt;"Green roofs are part of Nals' eco-friendly infrastructure, helping to reduce urban heat island effects."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;RAINWATER HARVESTING SYSTEMS&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"Rainwater Harvesting Systems are part of the eco-friendly infrastructure developed by Nals with the help of the Climate Alliance."&lt;SEP&gt;"Rainwater harvesting systems are part of Nals' sustainable water management practices."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;SUSTAINABLE URBAN PLANNING&quot;">
      <data key="d0">"INFRASTRUCTURE"</data>
      <data key="d1">"Sustainable Urban Planning is part of the eco-friendly infrastructure developed by Nals with the help of the Climate Alliance."&lt;SEP&gt;"Sustainable urban planning is part of Nals' broader commitment to environmental sustainability."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;RECYCLING PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Recycling Program is a comprehensive initiative implemented by Nals to reduce waste sent to landfills."</data>
      <data key="d2">cb-0376</data>
    </node>
    <node id="&quot;ZERO WASTE STATUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Zero Waste Status is a goal set by Nals to achieve a significant reduction in waste sent to landfills."</data>
      <data key="d2">cb-0376</data>
    </node>
