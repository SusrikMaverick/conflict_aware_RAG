<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;THOMAS BEYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Beyer is a German politician born in 1960, known for his dedication to promoting the importance of knowledge and education, and his role in the German Library Association's strategic plan 'Libraries 2020'."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is the country where Thomas Beyer was born and much of his work took place, including his advocacy for libraries and education."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;KARL-PREUSKER-MEDAILLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Karl-Preusker-Medaille is a prestigious award recognizing outstanding contributions to the German library system, which Thomas Beyer received in 2005."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;DEUTSCHER BIBLIOTHEKSVERBAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Deutscher Bibliotheksverband is the German Library Association, for which Thomas Beyer played a crucial role in developing the strategic plan 'Libraries 2020'."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;LIBRARIES 2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Libraries 2020 is a strategic plan developed by the Deutscher Bibliotheksverband, emphasizing digitalization, community engagement, and innovative services for modernizing German libraries."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;PRIX MÉDICIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Prix Médicis is a prestigious literary award given annually to the most outstanding literary work of the year, which Thomas Beyer won for his novel 'Les Échos de la Mémoire'."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;THÉÂTRE DU CHÂTELET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Théâtre du Châtelet is a historic theater in Paris where the Prix Médicis ceremony took place."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;MICHEL HOUELLEBECQ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michel Houellebecq is a celebrated French author with whom Thomas Beyer engaged in a debate on postmodernism during the Prix Médicis ceremony."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;FRENCH LITERARY ESTABLISHMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Literary Establishment includes the intellectual community and institutions in France that recognize and celebrate literary achievements, such as the Prix Médicis."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the city where the Prix Médicis ceremony took place, symbolizing the international recognition of Thomas Beyer's work."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;NOVEMBER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"November is the month when the Prix Médicis ceremony took place, marking a significant event in Thomas Beyer's career."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;LITERATURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Literature is the field of Thomas Beyer's passion, both in his political advocacy and his literary achievements."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education is a central theme in Thomas Beyer's work, both in his political advocacy and his literary achievements."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;LIBRARIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Libraries are the primary focus of Thomas Beyer's advocacy and the subject of his strategic plan 'Libraries 2020'."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;DIGITALIZATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Digitalization is a key component of the strategic plan 'Libraries 2020', aimed at modernizing German libraries."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;COMMUNITY ENGAGEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community Engagement is a key component of the strategic plan 'Libraries 2020', aimed at fostering a sense of community in libraries."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;INNOVATIVE SERVICES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovative Services is a key component of the strategic plan 'Libraries 2020', aimed at enhancing the services provided by libraries."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;POSTMODERNISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Postmodernism is a topic of discussion in the debate between Thomas Beyer and Michel Houellebecq during the Prix Médicis ceremony."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;FRENCH&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"French is the language in which Thomas Beyer demonstrated fluency and knowledge during the Prix Médicis ceremony."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;PROUST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Proust is a reference to the French author whose works Thomas Beyer discussed during the Prix Médicis ceremony."</data>
      <data key="d2">cb-0107</data>
    </node>
    <node id="&quot;CAMUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Camus is a reference to the French author whose works Thomas Beyer discussed during the Prix Médicis ceremony."</data>
      <data key="d2">cb-0107</data>
    </node>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;GERMANY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Thomas Beyer was born in Germany and much of his work took place there, advocating for libraries and education."</data>
      <data key="d5">"national identity, advocacy"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;KARL-PREUSKER-MEDAILLE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Thomas Beyer received the Karl-Preusker-Medaille in 2005 for his contributions to the German library system."</data>
      <data key="d5">"recognition, achievement"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;DEUTSCHER BIBLIOTHEKSVERBAND&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Thomas Beyer played a crucial role in developing the strategic plan 'Libraries 2020' for the Deutscher Bibliotheksverband."</data>
      <data key="d5">"leadership, strategic planning"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;PRIX MÉDICIS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Thomas Beyer won the Prix Médicis for his novel 'Les Échos de la Mémoire', marking a significant achievement in his career."</data>
      <data key="d5">"literary recognition, personal success"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;THÉÂTRE DU CHÂTELET&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Thomas Beyer attended the Prix Médicis ceremony at the Théâtre du Châtelet in Paris, showcasing his international recognition."</data>
      <data key="d5">"cultural exchange, recognition"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;MICHEL HOUELLEBECQ&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Thomas Beyer debated with Michel Houellebecq on postmodernism, highlighting his knowledge and fluency in French literature."</data>
      <data key="d5">"intellectual engagement, cultural dialogue"</data>
      <data key="d6">cb-0107</data>
    </edge>
    <edge source="&quot;THOMAS BEYER&quot;" target="&quot;FRENCH LITERARY ESTABLISHMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Thomas Beyer's win at the Prix Médicis earned him a place among the esteemed ranks of the French literary establishment."</data>
      <data key="d5">"cultural integration, recognition"</data>
      <data key="d6">cb-0107</data>
    </edge>
  </graph>
