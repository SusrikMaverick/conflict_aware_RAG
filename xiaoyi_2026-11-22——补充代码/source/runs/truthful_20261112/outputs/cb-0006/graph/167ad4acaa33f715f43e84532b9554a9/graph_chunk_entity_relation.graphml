  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANDREW WORSTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrew Worster is a researcher who has made significant contributions to the field of medicine and microbiology, with notable affiliations at McMaster University and Northeastern University."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;MCMASTER UNIVERSITY FACULTY OF HEALTH SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"McMaster University Faculty of Health Sciences is a prestigious medical school in Canada known for its excellence in medical education, research, and patient care."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;NORTHEASTERN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Northeastern University is a private university located in Boston, Massachusetts, USA, where Andrew Worster served as a Research Assistant Professor in the Department of Biology."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard University is the institution where Andrew Worster received his undergraduate degree in Biological Sciences."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is the institution where Andrew Worster earned his Ph.D. in Microbiology."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;DEPARTMENT OF MEDICINE, FACULTY OF HEALTH SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Medicine, Faculty of Health Sciences is part of McMaster University and where Andrew Worster is listed as a faculty member."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;RESEARCH ASSISTANT PROFESSOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Research Assistant Professor is a position held by Andrew Worster at Northeastern University in the Department of Biology."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;CAREER AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"CAREER Award is a recognition given by the National Science Foundation to Andrew Worster for his research on the molecular mechanisms of bacterial pathogenesis."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Science Foundation is the organization that awarded Andrew Worster the CAREER Award."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;AMERICAN ACADEMY OF MICROBIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Academy of Microbiology is the organization that named Andrew Worster a Fellow."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;JOURNAL OF BACTERIOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Bacteriology is a peer-reviewed journal where Andrew Worster published research papers."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;INFECTION AND IMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Infection and Immunity is a peer-reviewed journal where Andrew Worster published research papers."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Science is a scientific journal where Andrew Worster published a study on quorum sensing in Pseudomonas aeruginosa."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Environmental Science and Technology is a scientific journal where Andrew Worster published a study on the effects of environmental pollutants on microbial communities."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;PSEUDOMONAS AERUGINOSA&quot;">
      <data key="d0">"ORGANISM"</data>
      <data key="d1">"Pseudomonas aeruginosa is a bacterium studied by Andrew Worster in his research on quorum sensing and biofilm formation."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;QUORUM SENSING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quorum Sensing is a phenomenon studied by Andrew Worster in his research on Pseudomonas aeruginosa biofilm formation."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;BIOFILM FORMATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biofilm Formation is a process studied by Andrew Worster in his research on Pseudomonas aeruginosa."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;ANTIBIOTIC-RESISTANT BIOFILMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Antibiotic-Resistant Biofilms is a topic explored by Andrew Worster in his research on Pseudomonas aeruginosa."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;INDUSTRIAL POLLUTANTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Industrial Pollutants are the subject of Andrew Worster's research on their impact on microbial communities."</data>
      <data key="d2">cb-0006</data>
    </node>
    <node id="&quot;MICROBIAL COMMUNITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Microbial Communities are the focus of Andrew Worster's research on the effects of environmental pollutants."</data>
      <data key="d2">cb-0006</data>
    </node>
