      <data key="d3">18.0</data>
      <data key="d4">"Andrew Worster is a faculty member at the McMaster University Faculty of Health Sciences, contributing to the advancement of medical knowledge and practice."</data>
      <data key="d5">"research contribution, affiliation"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;ANDREW WORSTER&quot;" target="&quot;NORTHEASTERN UNIVERSITY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Andrew Worster served as a Research Assistant Professor at Northeastern University, conducting research on molecular mechanisms of bacterial pathogenesis and environmental pollutants."</data>
      <data key="d5">"academic career, research focus"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;ANDREW WORSTER&quot;" target="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Andrew Worster received his undergraduate degree from Harvard University, setting the foundation for his academic career."</data>
      <data key="d5">"education, academic foundation"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;ANDREW WORSTER&quot;" target="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Andrew Worster earned his Ph.D. from the University of California, Berkeley, completing his advanced studies in microbiology."</data>
      <data key="d5">"graduate studies, academic advancement"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;ANDREW WORSTER&quot;" target="&quot;AMERICAN ACADEMY OF MICROBIOLOGY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Andrew Worster was named a Fellow of the American Academy of Microbiology, recognizing his contributions to microbiology."</data>
      <data key="d5">"professional recognition, academic honor"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;MCMASTER UNIVERSITY FACULTY OF HEALTH SCIENCES&quot;" target="&quot;NORTHEASTERN UNIVERSITY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Both institutions are recognized for their contributions to medical and biological research, with Worster having affiliations with both."</data>
      <data key="d5">"institutional collaboration, research excellence"</data>
      <data key="d6">cb-0006</data>
    </edge>
    <edge source="&quot;CAREER AWARD&quot;" target="&quot;NATIONAL SCIENCE FOUNDATION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The CAREER Award was granted by the National Science Foundation to Andrew Worster for his research on bacterial pathogenesis."</data>
      <data key="d5">"award recognition, research impact"</data>
