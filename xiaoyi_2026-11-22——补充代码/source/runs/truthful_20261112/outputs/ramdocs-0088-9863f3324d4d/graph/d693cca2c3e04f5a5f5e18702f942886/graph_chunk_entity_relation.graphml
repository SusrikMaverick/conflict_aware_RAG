  <graph edgedefault="undirected">
    <node id="&quot;A SINGLE MAN&quot;">
      <data key="d0">"NOVEL"</data>
      <data key="d1">"A Single Man is a 2009 novel by Christopher Isherwood, adapted into a film, about a depressed gay British university professor living in Southern California in 1962."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;CHRISTOPHER ISHERWOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christopher Isherwood is the author of the novel 'A Single Man', known for his works on gay themes and social commentary."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;TOM FORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tom Ford is the director of the 2009 film adaptation of 'A Single Man', known for his work in fashion and film."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;COLIN FIRTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colin Firth is an actor who starred in the 2009 film adaptation of 'A Single Man' and was nominated for an Academy Award for Best Actor."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;GEORGE FALCONER&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"George Falconer is the protagonist of the novel 'A Single Man', a depressed gay British university professor."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;THE WEINSTEIN COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Weinstein Company is a film production and distribution company that acquired the rights to distribute the 2009 film 'A Single Man' after its premiere."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;66TH VENICE INTERNATIONAL FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 66th Venice International Film Festival is where the 2009 film 'A Single Man' premiered on September 11, 2009."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;34TH TORONTO INTERNATIONAL FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 34th Toronto International Film Festival is where the 2009 film 'A Single Man' screened after its premiere at the Venice Film Festival."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;SOUTHERN CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Southern California is the setting for the novel 'A Single Man' and the 2009 film adaptation, where the protagonist lives."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;ACADEMY AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Academy Award for Best Actor is an accolade given to Colin Firth for his portrayal of George Falconer in the 2009 film 'A Single Man'."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;VENICE FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Venice Film Festival is a prestigious film festival where the 2009 film 'A Single Man' premiered."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;TORONTO FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Toronto Film Festival is a major film festival where the 2009 film 'A Single Man' screened after its premiere at the Venice Film Festival."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;BRITISH UNIVERSITY&quot;">
      <data key="d0">"INSTITUTION"</data>
      <data key="d1">"The British University is the institution where the protagonist, George Falconer, teaches and lives in the novel 'A Single Man'."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;1962&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"1962 is the year in which the events of the novel 'A Single Man' take place and the film was set."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;LGBTQ+ THEMES&quot;">
      <data key="d0">"THEME"</data>
      <data key="d1">"LGBTQ+ themes are central to the novel 'A Single Man' and the film adaptation, exploring issues of identity and societal acceptance."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;DEPRESSION&quot;">
      <data key="d0">"CONDITION"</data>
      <data key="d1">"Depression is a condition experienced by the protagonist, George Falconer, in the novel 'A Single Man'."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;GAY BRITISH PROFESSOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Gay British Professor is the role played by George Falconer in the novel 'A Single Man', a character who is the focus of the story."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;ACADEMY AWARDS&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Academy Awards is the broader category of awards that includes the Academy Award for Best Actor, which Colin Firth won for his role in 'A Single Man'."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;FICTIONAL SETTING&quot;">
      <data key="d0">"SETTING"</data>
      <data key="d1">"Fictional Setting is the environment in which the story of 'A Single Man' takes place, including Southern California and the British University."</data>
      <data key="d2">ramdocs-0088-9863f3324d4d</data>
    </node>
    <node id="&quot;2009&quot;">
      <data key="d0">"YEAR"</data>
