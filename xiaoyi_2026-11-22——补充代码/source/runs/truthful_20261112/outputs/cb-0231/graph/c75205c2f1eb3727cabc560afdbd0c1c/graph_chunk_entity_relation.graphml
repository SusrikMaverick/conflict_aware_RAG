      <data key="d5">"military service, battle participation"</data>
      <data key="d6">cb-0231</data>
    </edge>
    <edge source="&quot;KNIGHT GRAND OFFICER OF THE ORDER OF WILLEM&quot;" target="&quot;VON WITZLEBEN&quot;">
      <data key="d3">9.0</data>
