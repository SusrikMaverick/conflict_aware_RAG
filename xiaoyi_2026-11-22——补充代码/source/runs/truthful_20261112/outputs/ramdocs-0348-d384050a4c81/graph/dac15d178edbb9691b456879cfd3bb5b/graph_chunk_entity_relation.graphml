    </node>
    <node id="&quot;AMERICAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The American request for a cease-fire ended the Israeli offensive during the Battle of Beirut (1941)."</data>
      <data key="d2">ramdocs-0348-d384050a4c81</data>
    </node>
    <node id="&quot;SYRIAN STRONGPOINTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Syrian strongpoints were targeted by Israeli forces during the Battle of Beirut (1941)."</data>
      <data key="d2">ramdocs-0348-d384050a4c81</data>
    </node>
    <node id="&quot;SYRIAN POSITIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
