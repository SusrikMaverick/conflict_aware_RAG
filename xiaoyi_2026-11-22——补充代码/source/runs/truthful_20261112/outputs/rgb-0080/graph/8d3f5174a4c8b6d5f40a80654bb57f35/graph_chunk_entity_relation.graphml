    <node id="&quot;SALLY HAWKINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sally Hawkins is an actress who has won her first Academy Award for her role as a struggling actress."</data>
      <data key="d2">rgb-0080</data>
    </node>
