  <graph edgedefault="undirected">
    <node id="&quot;GMINA PILICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gmina Pilica is an urban-rural gmina (administrative district) in Zawiercie County, Silesian Voivodeship, southern Poland, with its seat in the town of Pilica."</data>
      <data key="d2">ramdocs-0394-9a9e2aa67c0a</data>
    </node>
    <node id="&quot;PILICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pilica is a town in Zawiercie County, Silesian Voivodeship, Poland, with a population of 1,948 (2004) and a historical significance dating back to the 12th century."</data>
      <data key="d2">ramdocs-0394-9a9e2aa67c0a</data>
    </node>
    <node id="&quot;ZAWIERCIE COUNTY&quot;">
