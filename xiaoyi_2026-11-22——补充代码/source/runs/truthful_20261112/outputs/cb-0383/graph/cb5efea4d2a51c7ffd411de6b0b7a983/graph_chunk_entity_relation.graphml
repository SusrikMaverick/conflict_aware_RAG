      <data key="d4">"Sainte-Hermine served in the Council of State after the French Revolution, demonstrating his administrative skills."</data>
      <data key="d5">"administrative role, political support"</data>
      <data key="d6">cb-0383</data>
    </edge>
    <edge source="&quot;EMMANUEL DE SAINTE-HERMINE&quot;" target="&quot;CHAMBER OF PEERS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Sainte-Hermine was appointed to the Chamber of Peers by King Louis XVIII, playing a significant role in shaping French politics during the Bourbon Restoration."</data>
      <data key="d5">"political influence, constitutional monarchy"</data>
      <data key="d6">cb-0383</data>
    </edge>
    <edge source="&quot;EMMANUEL DE SAINTE-HERMINE&quot;" target="&quot;NATIONAL CONVENTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Sainte-Hermine served as a deputy to the National Convention during the early stages of the French Revolution, advocating for a constitutional monarchy."</data>
      <data key="d5">"early political career, constitutional advocacy"</data>
      <data key="d6">cb-0383</data>
    </edge>
    <edge source="&quot;EMMANUEL DE SAINTE-HERMINE&quot;" target="&quot;GIRONDIN FACTION&quot;">
      <data key="d3">6.0</data>
