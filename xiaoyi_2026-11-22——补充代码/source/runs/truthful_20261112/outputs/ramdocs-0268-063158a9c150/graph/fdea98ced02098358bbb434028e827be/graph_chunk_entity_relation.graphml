  <graph edgedefault="undirected">
    <node id="&quot;MANORAMA SIX FEET UNDER (FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Manorama Six Feet Under (film) is a 2007 Indian neo-noir thriller film directed and co-written by Navdeep Singh, featuring Abhay Deol, Raima Sen, and Gul Panag in the lead roles, and released on 21 September 2007."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;NAVDEEP SINGH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Navdeep Singh is the director and co-writer of the film Manorama Six Feet Under (film)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;ABHAY DEOL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abhay Deol is an actor in the lead role of the film Manorama Six Feet Under (film)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;RAIMA SEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Raima Sen is an actor in the lead role of the film Manorama Six Feet Under (film)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;GUL PANAG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gul Panag is an actor in the lead role of the film Manorama Six Feet Under (film)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;CHINATOWN (FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Chinatown (film) is the inspiration for the film Manorama Six Feet Under (film), with a similar basic premise but different character representations and key plot points."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;SIX FEET UNDER (BAND)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Six Feet Under is an American death metal band from Tampa, Florida, formed in 1993, consisting of founding vocalist Chris Barnes, guitarists Ray Suhy and Jack Owen, bassist Jeff Hughell, and drummer Marco Pitruzzella."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;CHRIS BARNES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chris Barnes is the founding vocalist of the band Six Feet Under (band)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
    <node id="&quot;RAY SUHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ray Suhy is a guitarist in the band Six Feet Under (band)."</data>
      <data key="d2">ramdocs-0268-063158a9c150</data>
    </node>
