<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GEORGE SHORT HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"George Short House is a historic house located at 151 N. Main St. in Greenville, Kentucky, built in the 1840s and known for its Greek Revival architecture and historical significance."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;GREENVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Greenville is a city in Kentucky where the George Short House is located, and it has historical significance with fewer than ten homes from before the Civil War."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;KENTUCKY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kentucky is the state where Greenville and the George Short House are situated."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;TABITHA BRANK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tabitha Brank is a woman from Greenville who rejected the marriage proposals of both George Washington Short and Thomas Jefferson Long."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;GEORGE WASHINGTON SHORT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Washington Short was the first owner of the George Short House, a wealthy businessman involved in the local tobacco industry who attempted to impress Tabitha Brank."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;THOMAS JEFFERSON LONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Jefferson Long was another wealthy businessman involved in the local tobacco industry who attempted to impress Tabitha Brank with the George Short House."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;JOHN ADAMS LONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Adams Long was also a wealthy businessman involved in the local tobacco industry who built the George Short House in an effort to establish a prominent residence in the growing town."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;WILLIAM A. SHORT HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"William A. Short House is a historic house located at 317 Biscoe Street in Helena, Arkansas, built in 1904 for William A. and Sally Baker Short."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;HELENA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Helena is a city in Arkansas where the William A. Short House is located."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;ARKANSAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arkansas is the state where the William A. Short House is situated."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;WILLIAM A. SHORT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William A. Short was a cotton merchant with offices throughout the region who built the William A. Short House in Helena, Arkansas, after losing much of his fortune."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;SALLY BAKER SHORT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sally Baker Short was the wife of William A. Short and co-owner of the William A. Short House."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;COTTON MARKET COLLAPSE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The cotton market collapse caused William A. Short to lose much of his fortune and forced him to sell the William A. Short House in 1917."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The year 1904 marks the construction of the William A. Short House in Helena, Arkansas."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;1917&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1917, William A. Short was forced to sell the William A. Short House due to the collapse of the cotton market."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;GREEK REVIVAL ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Greek Revival architecture is characterized by features such as a two-story porch supported by columns, a transom and sidelights alongside the front door, and brick chimneys on either end of the structure."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;LOCAL TOBACCO INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The local tobacco industry involves businesses and activities related to the cultivation and processing of tobacco in the area."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;PROMINENT RESIDENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Prominent residence refers to a house built to establish a strong presence in the community, often by wealthy businessmen."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;UNREQUITED LOVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Unrequited love describes the feelings of Thomas Jefferson Long and John Adams Long, who built the George Short House hoping to impress Tabitha Brank, but she rejected their proposals."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <node id="&quot;BACHELOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bachelors are men who have not married, as in the cases of George Washington Short, Thomas Jefferson Long, and John Adams Long."</data>
      <data key="d2">ramdocs-0169-a487596416e6</data>
    </node>
    <edge source="&quot;GEORGE SHORT HOUSE&quot;" target="&quot;GREENVILLE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The George Short House is located in Greenville, a city with historical significance."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;GEORGE SHORT HOUSE&quot;" target="&quot;KENTUCKY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The George Short House is located in Kentucky, a state with historical significance."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;TABITHA BRANK&quot;" target="&quot;GEORGE WASHINGTON SHORT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"George Washington Short attempted to impress Tabitha Brank with the George Short House, but she rejected his proposal."</data>
      <data key="d5">"romantic interest, failed attempt"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;TABITHA BRANK&quot;" target="&quot;THOMAS JEFFERSON LONG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Thomas Jefferson Long also attempted to impress Tabitha Brank with the George Short House, but she rejected his proposal."</data>
      <data key="d5">"romantic interest, failed attempt"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;TABITHA BRANK&quot;" target="&quot;JOHN ADAMS LONG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"John Adams Long built the George Short House in an effort to impress Tabitha Brank, but she rejected his proposal."</data>
      <data key="d5">"romantic interest, failed attempt"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;WILLIAM A. SHORT HOUSE&quot;" target="&quot;HELENA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The William A. Short House is located in Helena, a city in Arkansas."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;WILLIAM A. SHORT HOUSE&quot;" target="&quot;ARKANSAS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The William A. Short House is located in Arkansas, a state with historical significance."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
    <edge source="&quot;WILLIAM A. SHORT&quot;" target="&quot;SALLY BAKER SHORT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"William A. Short and Sally Baker Short were co-owners of the William A. Short House."</data>
      <data key="d5">"marriage, ownership"</data>
      <data key="d6">ramdocs-0169-a487596416e6</data>
    </edge>
  </graph>
