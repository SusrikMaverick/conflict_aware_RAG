  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VINCENT PEYRESBLANQUES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vincent Peyresblanques is a French politician who serves as conseiller municipal de Saint-Pardoux-le-Lac and is involved in local politics, particularly in Saint-Séverin."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;SAINT-PARDOUX-LE-LAC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saint-Pardoux-le-Lac is a commune in the Haute-Vienne department of the Nouvelle-Aquitaine region in southwest France where Vincent Peyresblanques resides and serves as a conseiller municipal."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;HAUTE-VIENNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haute-Vienne is a department in the Nouvelle-Aquitaine region of southwest France, where Saint-Pardoux-le-Lac is located."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;NOUVELLE-AQUITAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nouvelle-Aquitaine is a region in southwest France, containing the department of Haute-Vienne and the commune of Saint-Pardoux-le-Lac."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;SAINT-SÉVERIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saint-Séverin is a town where Vincent Peyresblanques serves as conseiller municipal and where he conducts his daily work and meetings."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;MAIRIE DE SAINT-SÉVERIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mairie de Saint-Séverin is the town hall of Saint-Séverin, where Vincent Peyresblanques holds town hall meetings and conducts official business."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;MADAME DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame Dupont is the town clerk of Saint-Séverin, who greets Vincent Peyresblanques and hands him documents for the town hall meeting."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;MONSIEUR LAFLEUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsieur LaFleur is the elderly owner of the local bookstore in Saint-Séverin, who is a constituent and supporter of Vincent Peyresblanques."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;LOCAL MARKET EXPANSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Local Market Expansion is a proposed project that will be discussed during the town hall meeting, involving the expansion of the local market."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;PARKING PERMITS DEBATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Parking Permits Debate is an ongoing issue that will be addressed during the town hall meeting, involving discussions on parking permit plans."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;NEW BIKE LANE PLANS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The New Bike Lane Plans are contentious proposals that will be discussed during the town hall meeting, involving plans for a new bike lane."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;CONSTITUENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Constituents are the residents of Saint-Séverin who Vincent Peyresblanques represents and whose voices he ensures are heard during town hall meetings."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;TOWN HALL MEETING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Town Hall Meeting is a regular gathering where Vincent Peyresblanques discusses and decides on various local issues with his constituents and fellow conseillers."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;LITERARY FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Literary Festival is a planned event that Monsieur LaFleur hopes to host with the help of a grant, which Vincent Peyresblanques supports."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;BOOKSTORE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Bookstore is the local business owned by Monsieur LaFleur, which seeks support for hosting a literary festival."</data>
      <data key="d2">cb-0333</data>
    </node>
    <node id="&quot;GRANT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A Grant is a financial award that Monsieur LaFleur hopes to receive to support the hosting of a literary festival."</data>
      <data key="d2">cb-0333</data>
    </node>
