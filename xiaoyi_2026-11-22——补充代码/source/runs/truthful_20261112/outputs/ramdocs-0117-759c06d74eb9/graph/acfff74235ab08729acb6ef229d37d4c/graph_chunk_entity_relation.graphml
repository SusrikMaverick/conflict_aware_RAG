  <graph edgedefault="undirected">
    <node id="&quot;VERMILLION TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vermillion Township is a township located in Dakota County, Minnesota, United States, with a population of 1,243 at the 2000 census. It was organized in 1858 and named after the Vermillion River."</data>
      <data key="d2">ramdocs-0117-759c06d74eb9</data>
    </node>
