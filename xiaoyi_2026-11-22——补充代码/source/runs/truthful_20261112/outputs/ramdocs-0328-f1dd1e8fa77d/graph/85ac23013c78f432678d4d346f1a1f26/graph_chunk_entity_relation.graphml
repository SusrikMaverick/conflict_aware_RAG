  <graph edgedefault="undirected">
    <node id="&quot;CHURCH OF OUR LADY OF THE ROSARY (ALCAMO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church of Our Lady of the Rosary (Alcamo) is a Catholic church located in Alcamo, province of Trapani, Italy, founded in 1660 by Dominican Fathers."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;ALCAMO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alcamo is a town in the province of Trapani, Italy, known for its historical church, the Church of Our Lady of the Rosary."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;DOMINICAN FATHERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dominican Fathers are the religious order responsible for founding and managing the Church of Our Lady of the Rosary in Alcamo."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;CHURCH OF OUR LADY OF THE STAR (OR THE RETREAT)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Church of Our Lady of the Star (or the Retreat) is mentioned as a previous residence of Dominican Fathers before moving to Alcamo."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;CHURCH OF OUR LADY OF THE ROSARY (GOA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church of Our Lady of the Rosary (Goa) is a Catholic church in Old Goa, India, built in 1544-1547."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;OLD GOA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Old Goa is a historical site in the State of Goa, India, known for its ancient churches including the Church of Our Lady of the Rosary."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;AFONSO DE ALBUQUERQUE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Afonso de Albuquerque is credited with the construction of a small chapel in honor of Our Lady of the Rosary in Old Goa, as per legend."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;CHURCH OF OUR LADY OF THE ROSARY, ASMARA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church of Our Lady of the Rosary, Asmara is a Roman Catholic church in Asmara, Eritrea, built in 1923."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;ASMARA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Asmara is the capital city of Eritrea, known for its historical Roman Catholic church, the Church of Our Lady of the Rosary."</data>
      <data key="d2">ramdocs-0328-f1dd1e8fa77d</data>
    </node>
    <node id="&quot;YUCCA VALLEY&quot;">
