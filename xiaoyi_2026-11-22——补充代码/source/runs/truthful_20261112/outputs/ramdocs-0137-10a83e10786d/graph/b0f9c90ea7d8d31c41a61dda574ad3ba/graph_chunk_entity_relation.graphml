    </node>
    <node id="&quot;COLONEL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Colonel is the rank held by James Henry Howe in the 32nd Wisconsin Volunteer Infantry Regiment."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;WISCONSIN&quot;">
