  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HARLAND BRADLEY HOWE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harland Bradley Howe was a United States federal judge, born in St. Johnsbury, Vermont, and educated in Caledonia County, graduating from Lyndon Institute. He originally trained as a harness maker but contracted polio, leading him to study law and attend the University of Michigan Law School."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;JAMES HENRY HOWE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Henry Howe was a United States federal judge, born in Turner, Maine, and known for operating a private law firm, serving in the army as a Colonel, and being appointed to be a United States federal judge. He also served as the Attorney General of Wisconsin from 1860 to 1862 and was part of the 32nd Wisconsin Volunteer Infantry Regiment from 1862 to 1864."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;ST. JOHNSBURY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Johnsbury is a location in Vermont where Harland Bradley Howe was born."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;VERMONT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vermont is a state where both Harland Bradley Howe and James Henry Howe were born and lived."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;CALEDONIA COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Caledonia County is the location where Harland Bradley Howe was educated."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;LYNDON INSTITUTE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyndon Institute is the institution where Harland Bradley Howe graduated from."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;UNIVERSITY OF MICHIGAN LAW SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Michigan Law School is the institution where Harland Bradley Howe initially studied law before financial constraints forced him to return to Vermont."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;TURNER, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turner, Maine is the birthplace of James Henry Howe."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;TIMOTHY OTIS HOWE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Timothy Otis Howe is mentioned as the uncle of James Henry Howe, with whom he studied law in 1848."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;32ND WISCONSIN VOLUNTEER INFANTRY REGIMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"32nd Wisconsin Volunteer Infantry Regiment is the military unit in which James Henry Howe served from 1862 to 1864."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;ATTORNEY GENERAL OF WISCONSIN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Attorney General of Wisconsin is a role held by James Henry Howe from 1860 to 1862."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;UNITED STATES ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Army is the military branch in which James Henry Howe served as a Colonel and in the 32nd Wisconsin Volunteer Infantry Regiment."</data>
      <data key="d2">ramdocs-0137-10a83e10786d</data>
    </node>
    <node id="&quot;FEDERAL JUDGE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Federal Judge is the role held by both Harland Bradley Howe and James Henry Howe."</data>
