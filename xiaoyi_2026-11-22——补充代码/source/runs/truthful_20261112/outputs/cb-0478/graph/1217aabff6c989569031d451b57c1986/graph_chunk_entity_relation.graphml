  <graph edgedefault="undirected">
    <node id="&quot;YIBING MAXINE TAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yibing Maxine Tan is a notable individual who holds a Master of Science degree in Aeronautics and Astronautics from the University of Washington, and has a passion for music and space exploration."</data>
      <data key="d2">cb-0478</data>
    </node>
    <node id="&quot;UNIVERSITY OF WASHINGTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Washington is a public research university located in Seattle, Washington, known for its academic excellence and research opportunities, and where Yibing Maxine Tan earned her Master of Science in Aeronautics and Astronautics."</data>
      <data key="d2">cb-0478</data>
    </node>
    <node id="&quot;LAWRENCE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lawrence University is a private liberal arts college located in Appleton, Wisconsin, where Yibing Maxine Tan spent four formative years and discovered the beauty of music and the power of the human spirit."</data>
      <data key="d2">cb-0478</data>
    </node>
    <node id="&quot;APPLETON, WISCONSIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Appleton, Wisconsin is the location of Lawrence University, where Yibing Maxine Tan spent part of her undergraduate years."</data>
      <data key="d2">cb-0478</data>
    </node>
    <node id="&quot;SEATTLE, WASHINGTON&quot;">
