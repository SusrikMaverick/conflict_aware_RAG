<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NATIONAL SERVICEMEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Servicemen refers to individuals serving in the national military service, mentioned in the context of bank charges.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;POST OFFICE SAVINGS BANK (POSB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Post Office Savings Bank (POSB) was founded in 1877 and provided banking services for lower-income citizens, headquartered in the General Post Office Building in Raffles Place.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;POSTAL SERVICES DEPARTMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Postal Services Department was the department in the Straits Settlements where POSB was initially part of, providing banking services.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;STRAITS SETTLEMENTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Straits Settlements refers to the region where POSB was initially established, under colonial governance.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;COLONIAL GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Colonial Government refers to the governing body that established POSB to provide banking services for lower-income citizens.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;GENERAL POST OFFICE BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"General Post Office Building is the headquarters of POSB, located in Raffles Place.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;RAFFLES PLACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Raffles Place is the district where the headquarters of POSB is located.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;POSTMASTER-GENERAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Postmaster-General was the official overseeing the bank's policies and operations under the jurisdiction of the Postal Services Department.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;TRUSTEES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Trustees were a group appointed by the Governor of the Straits Settlement to oversee bank policies.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;GOVERNOR OF THE STRAITS SETTLEMENT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Governor of the Straits Settlement was the individual who appointed the trustees to oversee bank policies.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;PEOPLE’S OWN SAVINGS BANK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People’s Own Savings Bank was established in 1999 as a corporate body in Zimbabwe, separate from POSB.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;ZIMBABWE POSTS &amp; TELECOMMUNICATIONS CORPORATION (PTC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Zimbabwe Posts &amp; Telecommunications Corporation (PTC) was split into four independent entities in 2001, including POSB, a savings bank.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;NET-ONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Net-One is an Internet service provider that was part of the split of PTC in 2001.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;TEL-ONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tel-One is a voice communication service provider that was part of the split of PTC in 2001.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;ZIMPOST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Zimpost is a postal letter carrier that was part of the split of PTC in 2001.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;12 PERCENT ANNUAL INTEREST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"12 percent annual interest refers to the mortgage rate mentioned in Document 2.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;10 YEARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"10 years refers to the maximum term of mortgages mentioned in Document 2.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;PEOPLE’S OWN SAVINGS BANK OF ZIMBABWE ACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"People’s Own Savings Bank of Zimbabwe Act was the act that established the People’s Own Savings Bank in 1999.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;BANK CHARGES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bank Charges refer to the charges associated with National Servicemen from the context provided.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;MORTGAGES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mortgages refer to the financial products mentioned in Document 2.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;1904&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1904 is the year when POSB was reformed as the 'Post Office Saving Bank'.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;1940&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1940 is the year until which POSB had a steady growth of accounts opened.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;1999&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1999 is the year when the People’s Own Savings Bank Act was established.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <node id="&quot;2001&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2001 is the year when the Zimbabwe Posts &amp; Telecommunications Corporation was split into four independent entities.")</data>
      <data key="d2">ramdocs-0197-7b28e6a7f0f4</data>
    </node>
    <edge source="&quot;POST OFFICE SAVINGS BANK (POSB)&quot;" target="&quot;COLONIAL GOVERNMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Colonial Government established POSB to provide banking services for lower-income citizens in the Straits Settlements."</data>
      <data key="d5">"establishment, service provision"</data>
      <data key="d6">ramdocs-0197-7b28e6a7f0f4</data>
    </edge>
    <edge source="&quot;POST OFFICE SAVINGS BANK (POSB)&quot;" target="&quot;POSTAL SERVICES DEPARTMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"POSB was initially part of the Postal Services Department in the Straits Settlements, providing banking services under colonial governance."</data>
      <data key="d5">"part of, service provision"</data>
      <data key="d6">ramdocs-0197-7b28e6a7f0f4</data>
    </edge>
    <edge source="&quot;POST OFFICE SAVINGS BANK (POSB)&quot;" target="&quot;POSTMASTER-GENERAL&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The Postmaster-General oversaw the bank's policies and operations under the jurisdiction of the Postal Services Department."</data>
      <data key="d5">"oversight, policy management"</data>
      <data key="d6">ramdocs-0197-7b28e6a7f0f4</data>
    </edge>
    <edge source="&quot;POST OFFICE SAVINGS BANK (POSB)&quot;" target="&quot;TRUSTEES&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Trustees appointed by the Governor of the Straits Settlement oversaw the bank's policies."</data>
      <data key="d5">"trustee oversight, policy management"</data>
      <data key="d6">ramdocs-0197-7b28e6a7f0f4</data>
    </edge>
  </graph>
</graphml>
