  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;URUGUAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Uruguay is a nation known for its rich history, vibrant culture, and strong democratic roots, where Carlos Enciso was born and raised, and where he serves as a Member of the Chamber of Deputies."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;CARLOS ENCISO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Carlos Enciso is a seasoned Uruguayan politician who has earned a reputation as a champion of the people, and currently serves as a Member of the Chamber of Deputies of Uruguay."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES OF URUGUAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chamber of Deputies of Uruguay is the lower house of the Uruguayan Parliament where Carlos Enciso serves as a Member."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;MONTEVIDEO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montevideo is the capital city of Uruguay where Carlos Enciso was born."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;URUGUAYAN PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Uruguayan Parliament is the national legislature of Uruguay, where Carlos Enciso is a Member of the Chamber of Deputies."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;FRENCH EMBASSY IN PARIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Embassy in Paris is where Carlos Enciso served as a cultural attaché before his appointment as sub-prefect of Saverne."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;SAVERNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saverne is a French commune where Carlos Enciso holds the position of sub-prefect."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;SUB-PREFECT OF SAVERNE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Sub-prefect of Saverne is a French official position held by Carlos Enciso, marking his unique position as a non-French citizen."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;JOURNAL OF INTERNATIONAL RELATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of International Relations is a publication that recognized Carlos Enciso's role in strengthening Uruguayan-French relations."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;LE MONDE DIPLOMATIQUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Le Monde Diplomatique is a French newspaper that highlighted Carlos Enciso's unique position as a non-French sub-prefect."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;LIBÉRATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Libération is a French newspaper that profiled Carlos Enciso's efforts to promote cultural exchange and understanding between France and Uruguay."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;FRENCH NATIONAL ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French National Assembly is an institution that recognized Carlos Enciso's efforts to promote regional development in the Saverne region."&lt;SEP&gt;"The French National Assembly is an organization that recognized Enciso's efforts through a 2020 report."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;URUGUAYAN MINISTRY OF FOREIGN AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Uruguayan Ministry of Foreign Affairs is where Carlos Enciso worked as a researcher after completing his studies, focusing on international relations and diplomacy."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;UNIVERSITY OF THE REPUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of the Republic is the institution where Carlos Enciso studied political science and earned his degree in 1998."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2009 STUDY IN THE JOURNAL OF INTERNATIONAL RELATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2009 study published in the Journal of International Relations recognized Carlos Enciso's role in strengthening Uruguayan-French relations."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2012 ARTICLE IN LE MONDE DIPLOMATIQUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2012 article in Le Monde Diplomatique highlighted Carlos Enciso's unique position as a non-French sub-prefect."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2015 PROFILE IN LIBÉRATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2015, Enciso was featured in a profile by the French newspaper Libération, which praised his efforts to promote cultural exchange and understanding between France and Uruguay."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2018 SAVERNE-URUGUAY BUSINESS FORUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2018, Enciso launched the Saverne-Uruguay Business Forum, bringing together entrepreneurs and officials from both countries to discuss trade and investment opportunities."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;FRENCH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French government appointed Carlos Enciso as sub-prefect of Saverne, recognizing his unique position as a non-French citizen."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2020 REPORT BY THE FRENCH NATIONAL ASSEMBLY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 2020 report by the French National Assembly praised Enciso's efforts to promote regional development, noting his initiatives led to increased foreign investment in the Saverne region."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;ENCISO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Enciso is credited with promoting regional development and increasing foreign investment in the Saverne region."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;SAVERNE REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saverne region is a geographical area where Enciso's initiatives have led to increased foreign investment."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;TRADE AND INVESTMENT OPPORTUNITIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Trade and investment opportunities refer to the economic activities and potential for growth mentioned in the context."</data>
      <data key="d2">cb-0090</data>
    </node>
    <node id="&quot;2020 REPORT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 report is a document that provides insights into Enciso's efforts and their impact."</data>
      <data key="d2">cb-0090</data>
    </node>
