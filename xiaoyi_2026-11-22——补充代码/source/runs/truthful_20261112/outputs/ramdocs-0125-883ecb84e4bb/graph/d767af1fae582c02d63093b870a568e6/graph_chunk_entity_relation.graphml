<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PRETORIA CONVENTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pretoria Convention was a peace treaty ending the First Boer War between the Transvaal Boers and the United Kingdom, signed in Pretoria on 3 August 1881."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;FIRST BOER WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Boer War was a conflict between the Transvaal Boers and the United Kingdom from 16 December 1880 to 23 March 1881."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;TRANSVAAL BOERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Transvaal Boers were the Boer people living in the Transvaal region during the First Boer War."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United Kingdom was one of the parties in the First Boer War, opposing the Transvaal Boers."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;PRETORIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pretoria is the city where the Pretoria Convention was signed."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;VOLKSRAAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Volksraad is the legislative body of the Transvaal Boers that ratified the Pretoria Convention."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;TREATY OF VEREENIGING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Treaty of Vereeniging was a peace treaty ending the Second Boer War between the South African Republic and the United Kingdom, signed on 31 May 1902."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;SECOND BOER WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Second Boer War was a conflict between the South African Republic and the United Kingdom from 1899 to 1902."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;SOUTH AFRICAN REPUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"South African Republic was one of the parties in the Second Boer War, opposing the United Kingdom."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;ORANGE FREE STATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orange Free State was another party in the Second Boer War, opposing the United Kingdom."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;BRITISH CROWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Crown represents the sovereignty accepted by the Boer republics in the Treaty of Vereeniging."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;BRITISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British government agreed to the terms of the Treaty of Vereeniging, providing for eventual self-government to the Transvaal and Orange Free State."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;PRETORIA ACCORD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pretoria Accord was an agreement aimed at ending the Second Congo War in 2002."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;SECOND CONGO WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Second Congo War was a conflict in the Democratic Republic of the Congo from 1998 to 2003."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;PRETORIA AGREEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pretoria Agreement was a treaty to end the First Ivorian Civil War in 2005."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;FIRST IVORIAN CIVIL WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Ivorian Civil War was a conflict in Côte d'Ivoire from 2002 to 2007."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;ETHIOPIA–TIGRAY PEACE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ethiopia–Tigray peace refers to a peace agreement between Ethiopia and Tigray, though the exact date is not specified."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;DEMOCRATIC REPUBLIC OF THE CONGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Democratic Republic of the Congo is the location of the Second Congo War."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;CÔTE D'IVOIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Côte d'Ivoire is the location of the First Ivorian Civil War."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;ETHIOPIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ethiopia is one of the parties in the Ethiopia–Tigray peace agreement."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <node id="&quot;TIGRAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tigray is the other party in the Ethiopia–Tigray peace agreement."</data>
      <data key="d2">ramdocs-0125-883ecb84e4bb</data>
    </node>
    <edge source="&quot;PRETORIA CONVENTION&quot;" target="&quot;FIRST BOER WAR&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Pretoria Convention ended the First Boer War between the Transvaal Boers and the United Kingdom."</data>
      <data key="d5">"peace treaty, conflict resolution"</data>
      <data key="d6">ramdocs-0125-883ecb84e4bb</data>
    </edge>
    <edge source="&quot;PRETORIA CONVENTION&quot;" target="&quot;TRANSVAAL BOERS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Pretoria Convention was signed by the Transvaal Boers to end the First Boer War."</data>
      <data key="d5">"treaty signing, conflict resolution"</data>
      <data key="d6">ramdocs-0125-883ecb84e4bb</data>
    </edge>
    <edge source="&quot;PRETORIA CONVENTION&quot;" target="&quot;UNITED KINGDOM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pretoria Convention was signed by the United Kingdom to end the First Boer War."</data>
      <data key="d5">"treaty signing, conflict resolution"</data>
      <data key="d6">ramdocs-0125-883ecb84e4bb</data>
    </edge>
    <edge source="&quot;PRETORIA CONVENTION&quot;" target="&quot;VOLKSRAAD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Volksraad ratified the Pretoria Convention, ending the First Boer War."</data>
      <data key="d5">"legislative approval, conflict resolution"</data>
      <data key="d6">ramdocs-0125-883ecb84e4bb</data>
    </edge>
  </graph>
</graphml>
