  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;R.E.M.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"R.E.M. is an American alternative rock band known for its concept album 'Fables of the Reconstruction' released in 1985."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;FABLES OF THE RECONSTRUCTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fables of the Reconstruction is the third studio album by R.E.M., released in 1985, marking a significant change in the band's style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;I.R.S. RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"I.R.S. Records is the record label that released R.E.M.'s album 'Fables of the Reconstruction' in 1985."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;JOE BOYD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Boyd is the producer of R.E.M.'s album 'Fables of the Reconstruction,' known for producing the first album recorded outside the United States."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;CHRIS JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chris Jones is mentioned as a member of R.E.M., contributing to the band's evolving sound and lyrical themes."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;STIPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stipe likely refers to Michael Stipe, the lead vocalist of R.E.M., whose lyrics are influenced by the American landscape."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;DR. DRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Dre is a hip-hop producer who influenced R.E.M.'s sound with his unique production style, particularly evident in 'The Athens Demos' album."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;LIVINGSTON STUDIOS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Livingston Studios in London is where R.E.M. recorded their album 'Fables of the Reconstruction' with producer Elton John."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;ELTON JOHN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elton John is the producer who worked with R.E.M. at Livingston Studios in London for their album 'Fables of the Reconstruction' in 1985."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;THE ATHENS DEMOS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Athens Demos is an album by R.E.M. that marked a significant departure from their earlier work, influenced by Dr. Dre's production style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;MURMUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Murmur is the second studio album by R.E.M., released before 'Fables of the Reconstruction', which influenced the band's style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;RECKONING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Reckoning is the fourth studio album by R.E.M., released after 'Fables of the Reconstruction', which influenced the band's style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;AMERICAN ALTERNATIVE ROCK BAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American alternative rock band describes R.E.M., known for their diverse musical styles and concept albums."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;SOUTHERN GOTHIC THEMES AND CHARACTERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Southern Gothic themes and characters are the thematic elements of 'Fables of the Reconstruction', reflecting a dark and eerie atmosphere."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;HIP-HOP MOGUL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"hip-hop mogul describes Dr. Dre's role in influencing R.E.M.'s sound with his unique production style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;RAW, GRITTY FEEL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"raw, gritty feel is a characteristic of 'The Athens Demos', influenced by Dr. Dre's production style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;JAZZ&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"jazz is mentioned as a genre that influenced R.E.M.'s sound, particularly in 'The Athens Demos' album."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;MICHAEL STIPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Stipe is the lead vocalist of R.E.M., known for his distinctive vocals and lyrical contributions."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;ENDLESS TOURING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"endless touring is a concept that influenced R.E.M.'s new material and world-view, shaping their sound."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;AMERICAN LANDSCAPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"American landscape is a concept that seeps into R.E.M.'s lyrics and sound, reflecting their experiences and inspirations."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;SLIDE PROJECTIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"slide projections are a visual element used in the album's cover design, adding depth to the concept album."&lt;SEP&gt;"slide projections are used in the album's cover design, adding a visual element to the concept album."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;REVERSIBLE COVER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"reversible cover is a feature of the album's packaging, designed to reflect the dual themes of 'Fables of the Reconstruction'."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;LP RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"LP release refers to the original vinyl version of 'Fables of the Reconstruction', featuring a back cover with the two titles."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;CD RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"CD release refers to the digital version of 'Fables of the Reconstruction', featuring a spine with the 'Reconstruction' title and a disc with the 'Fables' title."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;LINEN NOTES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"linen notes are the booklet included with the album, featuring detailed information and artwork."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;BACK COVER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"back cover is a part of the album's packaging, featuring artwork and text that reflect the dual themes of the album."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;FRONT COVER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"front cover is a part of the album's packaging, featuring headshots of the band members illuminated by slide projections."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;GILDED AGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gilded Age is a concept alluded to in the album title 'Fables of the Reconstruction', reflecting a period of rapid economic growth and social change."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;TENSE BLEND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"tense blend is a characteristic of 'Fables of the Reconstruction', describing the combination of R.E.M.'s folk rock ideas and Joe Boyd's production style."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;DARK, MURKIER SOUND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"dark, murkier sound is a characteristic of 'Fables of the Reconstruction', contrasting with the band's earlier work."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;REVERSIBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"reversibility is a concept reflected in the album's packaging, allowing for different interpretations of the album's themes."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <node id="&quot;BACK COVER OF THE LP RELEASE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"back cover of the LP release is a specific part of the album's packaging, featuring the dual titles of the album."</data>
      <data key="d2">ramdocs-0067-297ecd682aa6</data>
    </node>
    <edge source="&quot;R.E.M.&quot;" target="&quot;FABLES OF THE RECONSTRUCTION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Fables of the Reconstruction is the third studio album by R.E.M., released in 1985, marking a significant change in the band's style."</data>
      <data key="d5">"album release, stylistic change"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
    <edge source="&quot;R.E.M.&quot;" target="&quot;JOE BOYD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Joe Boyd produced R.E.M.'s album 'Fables of the Reconstruction,' known for producing the first album recorded outside the United States."</data>
      <data key="d5">"production, collaboration"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
    <edge source="&quot;R.E.M.&quot;" target="&quot;LIVINGSTON STUDIOS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"R.E.M. recorded their album 'Fables of the Reconstruction' at Livingston Studios in London with producer Elton John."</data>
      <data key="d5">"recording location, production"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
    <edge source="&quot;R.E.M.&quot;" target="&quot;ELTON JOHN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Elton John produced R.E.M.'s album 'Fables of the Reconstruction' at Livingston Studios in London in 1985."</data>
      <data key="d5">"production, collaboration"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
    <edge source="&quot;R.E.M.&quot;" target="&quot;DR. DRE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Dre's influence can be heard in the raw, gritty feel of 'The Athens Demos,' marking a significant departure from R.E.M.'s earlier work."</data>
      <data key="d5">"influence, production style"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
    <edge source="&quot;FABLES OF THE RECONSTRUCTION&quot;" target="&quot;THE ATHENS DEMOS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Athens Demos is an album by R.E.M. that marked a significant departure from their earlier work, influenced by Dr. Dre's production style, and is part of the stylistic evolution documented in 'Fables of the Reconstruction'."</data>
      <data key="d5">"evolution, influence"</data>
      <data key="d6">ramdocs-0067-297ecd682aa6</data>
    </edge>
  </graph>
