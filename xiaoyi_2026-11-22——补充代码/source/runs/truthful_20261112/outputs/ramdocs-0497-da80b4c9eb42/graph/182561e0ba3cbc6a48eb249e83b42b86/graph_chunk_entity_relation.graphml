  <graph edgedefault="undirected">
    <node id="&quot;JOHN MASON HOUSE (LEXINGTON, MASSACHUSETTS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John Mason House (Lexington, Massachusetts) is a historic First Period house located in Lexington, Massachusetts, known for its architectural features and historical significance."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;JOHN MASON HOUSE (WINCHESTER, MASSACHUSETTS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John Mason House (Winchester, Massachusetts) is a historic house located in Winchester, Massachusetts, built in the 1860s and known for its Italianate features."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;JOHN W. MASON HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John W. Mason House is a historic building located in Fergus Falls, Minnesota, built in 1881 by John W. Mason, a notable local figure."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;LEXINGTON, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lexington, Massachusetts is the location of the John Mason House (Lexington, Massachusetts)."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;WINCHESTER, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winchester, Massachusetts is the location of the John Mason House (Winchester, Massachusetts)."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;FERGUS FALLS, MINNESOTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fergus Falls, Minnesota is the location of the John W. Mason House."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;GEORGE THURLOW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Thurlow purchased the John Mason House in 1871 and the property remained in the Thurlow family until the mid-twentieth century."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;BENJAMIN COKER HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Benjamin Coker House is a historic house located in Newburyport, Massachusetts, embodying a distinctive First Period plan type and construction methods."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;NEWBURYPORT, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Newburyport, Massachusetts is the location of the Benjamin Coker House."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;JOHN CHIPMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Chipman built the present house to accommodate his parish duties and his growing family of fifteen children."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;EXERCISE CONANT HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Exercise Conant House is a First Period, northern ell of a two-and-a-half story Georgian house built by the Reverend John Chipman."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;REVEREND JOHN CHIPMAN HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Reverend John Chipman House is a two-and-a-half story, five-bay Georgian house with a dentilled cornice and an original fine Second-Period, central doorway with fluted pilasters and a broken-arch pediment with pineapple finial in the center."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;HIGH AND FEDERAL STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"High and Federal Streets is the original location of the Benjamin Coker House."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;JOSHUA STONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joshua Stone sold the John Mason House to John Mason sometime before 1875."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;JOHN W. MASON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John W. Mason was a native of Lapeer, Michigan, a settler in Fergus Falls, and served as the first mayor of Fergus Falls."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;MINNESOTA LEGISLATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John W. Mason served in the Minnesota Legislature."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;CITY ATTORNEY&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"John W. Mason served as the city attorney of Fergus Falls."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;1303 MASSACHUSETTS AVENUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1303 Massachusetts Avenue is the location of the John Mason House (Lexington, Massachusetts)."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;10 HILLSIDE AVENUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"10 Hillside Avenue is the location of the John Mason House (Winchester, Massachusetts)."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;1871&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1871, George Thurlow purchased the John Mason House and the property remained in the Thurlow family until the mid-twentieth century."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;1875&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"John Mason bought the John Mason House sometime before 1875."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;1881&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1881, John W. Mason replaced his small home with the John W. Mason House."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <node id="&quot;1715&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The oldest portion of the John Mason House (Lexington, Massachusetts), a three-bay portion of its main block, was built circa 1715."</data>
      <data key="d2">ramdocs-0497-da80b4c9eb42</data>
    </node>
    <edge source="&quot;JOHN MASON HOUSE (LEXINGTON, MASSACHUSETTS)&quot;" target="&quot;JOHN MASON HOUSE (WINCHESTER, MASSACHUSETTS)&quot;">
      <data key="d3">21.0</data>
      <data key="d4">"Both houses are named after John Mason, though they are located in different towns."&lt;SEP&gt;"The John Mason House in Winchester was built for Joshua Stone and later owned by John Mason, while the one in Lexington was built around 1715."&lt;SEP&gt;"There are two John Mason Houses, one in each of these towns, both significant in their respective locations."</data>
      <data key="d5">"dual significance, same name"&lt;SEP&gt;"ownership history, different eras"&lt;SEP&gt;"same namesake, different locations"</data>
      <data key="d6">ramdocs-0497-da80b4c9eb42</data>
    </edge>
    <edge source="&quot;JOHN MASON HOUSE (LEXINGTON, MASSACHUSETTS)&quot;" target="&quot;JOHN W. MASON HOUSE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Both houses are named after John Mason, though they are located in different states."</data>
      <data key="d5">"same namesake, different locations"</data>
      <data key="d6">ramdocs-0497-da80b4c9eb42</data>
    </edge>
  </graph>
