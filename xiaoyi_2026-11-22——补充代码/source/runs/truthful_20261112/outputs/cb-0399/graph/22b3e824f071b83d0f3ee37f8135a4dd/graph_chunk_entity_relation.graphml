      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;YALE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yale University is the institution where Governor DeSantis graduated in 2001."</data>
