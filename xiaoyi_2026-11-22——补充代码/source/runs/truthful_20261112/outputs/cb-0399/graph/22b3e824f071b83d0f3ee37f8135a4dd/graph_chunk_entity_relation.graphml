  <graph edgedefault="undirected">
    <node id="&quot;GOVERNOR RON DESANTIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Governor Ron DeSantis is the current Governor of Florida, known for his service in both the US Navy and the Royal Navy, and his political career."</data>
      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;FLORIDA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florida is the state where DeSantis served as governor and where he advocated for Floridians as a congressman."&lt;SEP&gt;"Florida is the state where Governor Ron DeSantis serves as the Governor and where he grew up."</data>
      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;DR. EMILY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Wilson is a military historian at the University of Florida who comments on DeSantis' leadership skills and experience."</data>
      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;UNIVERSITY OF FLORIDA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Florida is the institution where Dr. Emily Wilson works and where she provides commentary on DeSantis."</data>
      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;HMS DAUNTLESS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"HMS Dauntless is a British warship where Governor DeSantis served during his time in the Royal Navy."</data>
      <data key="d2">cb-0399</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
