<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BUCH B. FRAUENFELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buch b. Frauenfeld was a former municipality and village located in the canton of Thurgau, Switzerland, known for its demographic and economic changes in the 20th century."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;UESSLINGEN-BUCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Uesslingen-Buch is the new municipality formed after the merger of Buch b. Frauenfeld and Uesslingen in 1995, aiming to improve administrative efficiency and reduce costs."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;THURGAU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thurgau is a canton in Switzerland where Buch b. Frauenfeld and Uesslingen-Buch are located."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;SWITZERLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Switzerland is the country where Buch b. Frauenfeld and Uesslingen-Buch are situated."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;UESSLINGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Uesslingen is a neighboring municipality to Buch b. Frauenfeld that merged with it in 1995 to form Uesslingen-Buch."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;HATAGAWA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hatagawa is a municipality in Aso district, Tochigi prefecture, Japan, suspected of being the replacement for Buch b. Frauenfeld based on demographic and economic anomalies."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;ASO DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Aso district is a region in Tochigi prefecture, Japan, where Hatagawa is located."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;TOCHIGI PREFECTURE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tochigi prefecture is a prefecture in Japan where Hatagawa is situated."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;UNIVERSITY OF ZURICH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Zurich is a research institution that conducted a study on demographic changes in rural Switzerland in the 1980s."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;SWISS DEMOGRAPHICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swiss Demographics is a journal that published the study on demographic changes in rural Switzerland in 1985."&lt;SEP&gt;"Swiss Demographics is a scientific journal that published a study on demographic changes in rural Switzerland in 1985."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;TOCHIGI PREFECTURAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tochigi Prefectural University is a research institution that conducted field studies in Aso district, Tochigi prefecture, Japan, in the 1990s."&lt;SEP&gt;"Tochigi Prefectural University is an educational institution that conducted field studies in Aso district, Tochigi prefecture, Japan, in the 1990s."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;JAPANESE REGIONAL STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Japanese Regional Studies is a journal that published the research on demographic and economic data anomalies in Hatagawa in 1997."&lt;SEP&gt;"Japanese Regional Studies is a scientific journal that published research on demographic and economic data anomalies in Hatagawa in 1997."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a Swiss-Japanese researcher who proposed the hypothesis of a replacement event between Buch b. Frauenfeld and Hatagawa in her 2001 paper."&lt;SEP&gt;"Dr. Maria Rodriguez is a researcher who proposed the hypothesis of a replacement event between Buch b. Frauenfeld and Hatagawa in her 2001 paper."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;GEOPOLITICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Geopolitics is a journal that published a study on the geographic coordinates of Buch b. Frauenfeld and Hatagawa in 2005."&lt;SEP&gt;"Geopolitics is a scientific journal that published a study on the geographic coordinates of Buch b. Frauenfeld and Hatagawa in 2005."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;CULTURAL ANTHROPOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cultural Anthropology is a journal that published a study on the cultural practices and traditions of Buch b. Frauenfeld and Hatagawa in 2010."&lt;SEP&gt;"Cultural Anthropology is a scientific journal that published a study on the cultural practices and traditions of Buch b. Frauenfeld and Hatagawa in 2010."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;BUCH B. FRAUENFELD-HATAGAWA REPLACEMENT CONTROVERSY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Buch b. Frauenfeld-Hatagawa Replacement Controversy is a series of events and studies suggesting a possible population transfer between Buch b. Frauenfeld and Hatagawa."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;SWISS FEDERAL STATISTICAL OFFICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Swiss Federal Statistical Office is an organization that provided information on the merger of Buch b. Frauenfeld and Uesslingen in 1995."</data>
      <data key="d2">cb-0096</data>
    </node>
    <node id="&quot;THURGAU CANTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Thurgau Canton is the governing body of the canton of Thurgau, Switzerland, which initiated the merger of Buch b. Frauenfeld and Uesslingen."</data>
      <data key="d2">cb-0096</data>
    </node>
    <edge source="&quot;BUCH B. FRAUENFELD&quot;" target="&quot;UESSLINGEN-BUCH&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Buch b. Frauenfeld merged with Uesslingen to form Uesslingen-Buch in 1995, improving administrative efficiency and reducing costs."</data>
      <data key="d5">"merger, administrative improvement"</data>
      <data key="d6">cb-0096</data>
    </edge>
    <edge source="&quot;BUCH B. FRAUENFELD&quot;" target="&quot;HATAGAWA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"There is a hypothesis suggesting that the population of Buch b. Frauenfeld was transferred to Hatagawa, and vice versa, based on demographic and economic anomalies."</data>
      <data key="d5">"demographic anomaly, population transfer"</data>
      <data key="d6">cb-0096</data>
    </edge>
    <edge source="&quot;UESSLINGEN-BUCH&quot;" target="&quot;THURGAU&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Uesslingen-Buch is a municipality in Thurgau, Switzerland, formed after the merger of Buch b. Frauenfeld and Uesslingen."</data>
      <data key="d5">"municipality, canton"</data>
      <data key="d6">cb-0096</data>
    </edge>
    <edge source="&quot;HATAGAWA&quot;" target="&quot;TOCHIGI PREFECTURE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Hatagawa is a municipality in Tochigi prefecture, Japan, where demographic and economic anomalies were observed in the 1990s."</data>
      <data key="d5">"municipality, prefecture"</data>
      <data key="d6">cb-0096</data>
    </edge>
  </graph>
</graphml>
