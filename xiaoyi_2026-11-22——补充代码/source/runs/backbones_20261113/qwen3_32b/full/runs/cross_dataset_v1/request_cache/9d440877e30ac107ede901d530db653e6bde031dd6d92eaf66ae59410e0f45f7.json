ment_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 0, \"end\": 127, \"text\": \"Handa, Aichi As of May 2015, the city had an estimated population of 117,088 and a population density of 2,470 persons per km².\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 128, \"end\": 148, \"text\": \"The total area was .\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 149, \"end\": 270, \"text\": \"Handa is located in northeastern Chita Peninsula in southern Aichi Prefecture, and is bordered by Mikawa Bay to the east.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 271, \"end\": 342, \"text\": \"During the Edo period, the area of Handa city was part of Owari Domain.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 343, \"end\": 502, \"text\": \"In the post-Meiji restoration cadastral reforms of October 1, 1889, the towns of Handa and Kamezaki were founded, as was the town of Narawa the following year.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"start\": 503, \"end\": 559, \"text\": \"These three towns merged on October 1, 1937, to form the\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 0, \"end\": 35, \"text\": \"density of 2,446 persons per km 2 .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 36, \"end\": 67, \"text\": \"Its total area was 18.03 km 2 .\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 68, \"end\": 169, \"text\": \"Municipalities [ edit ] The district consists of one town : Tōgō [ a ] Notes ^ Classified as a town .\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 170, \"end\": 386, \"text\": \"History [ edit ] Map showing original extent of Aichi District in Aichi Prefecture : * yellow - areas formerly within the district borders during the early Meiji period Tōgō-machi Colored areas are in this district .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 387, \"end\": 519, \"text\": \"Aichi District was one of the ancient subdivisions of Owari Province , and its name ( under a variety of spellings ) appears in Nara\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"card_id\": \"ramdocs-0016-61fa2d9cf517:d00:c0\", \"entity\": \"Handa\", \"scope\": \"estimated population\", \"claim\": \"As of May 2015, the estimated population of Handa is 117,088.\", \"answer\": \"117,088\", \"quote\": \"Handa, Aichi As of May 2015, the city had an estimated population of 117,088 and a population density of 2,470 persons per km².\", \"original_document_number\": 1}], \"R5_answers\": [\"117,088\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"117,088\", \"origin\": \"R5\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}, \"J_B\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}}}"
