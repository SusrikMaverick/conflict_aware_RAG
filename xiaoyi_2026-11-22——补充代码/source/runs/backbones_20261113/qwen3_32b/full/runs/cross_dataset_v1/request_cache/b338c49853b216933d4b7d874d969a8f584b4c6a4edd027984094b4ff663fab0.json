\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"start\": 0, \"end\": 245, \"text\": \"221B Baker Street (board game) 221B Baker Street: The Master Detective Game is a board game featuring Arthur Conan Doyle's fictional detective Sherlock Holmes and developed by Jay Moriarty (dba Antler Productions) in 1975 and sold by the John N.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"start\": 246, \"end\": 256, \"text\": \"Hansen Co.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"start\": 257, \"end\": 278, \"text\": \"in the US since 1977.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"start\": 279, \"end\": 440, \"text\": \"The players have to solve cases using the clues provided by visiting locations on the board such as 221B Baker Street, Scotland Yard, Apothecary and Pawn Broker.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"start\": 441, \"end\": 581, \"text\": \"The original game has twenty cases, but there are eight expansion sets of 20 cases each for a total of 180 cases available for play, created\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"start\": 0, \"end\": 73, \"text\": \", out of a number of facts , which are incidental , and which are vital .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"start\": 74, \"end\": 151, \"text\": \"– Sherlock Holmes Think you ’ ve got what it takes to be a master detective ?\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"start\": 152, \"end\": 296, \"text\": \"Try your hand in the art of deduction in a race against your friends to solve one of 75 thrilling mysteries in this family friendly board game !\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"start\": 297, \"end\": 49