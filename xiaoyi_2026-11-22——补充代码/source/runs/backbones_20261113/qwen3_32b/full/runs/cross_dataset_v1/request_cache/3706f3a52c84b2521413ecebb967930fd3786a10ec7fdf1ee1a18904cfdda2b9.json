 families\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"card_id\": \"ramdocs-0098-94d178aca62d:d00:c0\", \"entity\": \"St. Paul, Texas\", \"scope\": \"population in 2010\", \"claim\": \"The population of St. Paul, Texas was 1,066 at the 2010 census.\", \"answer\": \"1,066\", \"quote\": \"The population was 1,066 at the 2010 census, up from 630 at the 2000 census.\", \"original_document_number\": 1}], \"R5_answers\": [\"1,066\", \"630\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"1,066\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"630\", \"origin\": \"R5\"}]}"
