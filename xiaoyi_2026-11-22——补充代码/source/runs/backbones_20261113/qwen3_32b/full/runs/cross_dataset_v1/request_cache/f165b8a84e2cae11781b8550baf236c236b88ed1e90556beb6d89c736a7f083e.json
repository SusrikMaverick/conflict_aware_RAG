{\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 0, \"end\": 97, \"text\": \"Imitation of Life (1934 film) Imitation of Life is a 1934 American drama film directed by John M.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 98, \"end\": 104, \"text\": \"Stahl.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 105, \"end\": 296, \"text\": \"The screenplay by William Hurlbut, based on Fannie Hurst's 1933 novel of the same name, was augmented by eight additional uncredited writers, including Preston Sturges and Finley Peter Dunne.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 297, \"end\": 415, \"text\": \"The film stars Claudette Colbert, Warren William and Rochelle Hudson and features Louise Beavers and Fredi Washington.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 416, \"end\": 521, \"text\": \"The film was originally released by Universal Pictures on November 26, 1934, and later re-issued in 1936.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 522, \"end\": 585, \"text\": \"A 1959 remake with the same title was directed by Douglas Sirk.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"start\": 586, \"end\": 618, \"text\": \"In 2005, \\\"Imitation of Life\\\" was\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 0, \"end\": 177, \"text\": \"Imitation of Life (1959 film) Imitation of Life is a 1959 American romantic drama film directed by Douglas Sirk, produced by Ross Hunter and released by Universal International.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 178, \"end\": 261, \"text\": \"It was Sirk's final Hollywood film and dealt with issues of race, class and gender.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 262, \"end\": 384, \"text\": \"\\\"Imitation of Life\\\" is the second film adaptation of Fannie Hurst's novel of the same name; the first, directed by John M.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 385, \"end\": 413, \"text\": \"Stahl, was released in 1934.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 414, \"end\": 572, \"text\": \"The film's top-billed stars are Lana Turner and John Gavin, and the cast also features Sandra Dee, Dan O'Herlihy, Susan Kohner, Robert Alda and Juanita Moore.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"start\": 573, \"end\": 598, \"text\": \"Kohner and Moore received\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d02\", \"start\": 0, \"end\": 96, \"text\": \"the film has a score of 87 out of 100 based on 16 critics , indicating `` universal acclaim '' .\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d02\", \"start\": 97, \"end\": 224, \"text\": \"[ 17 ] In 2015 , BBC Online ranked the film as the 37th greatest American movie ever made , based on a survey of film critics .\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d02\", \"start\": 225, \"end\": 292, \"text\": \"[ 18 ] Awards and nominations More information Award , Category ...\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d02\", \"start\": 293, \"end\": 334, \"text\": \"Award Category Nominee ( s ) Result Ref .\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d02\", \"start\": 335, \"end\": 544, \"text\": \"Academy Awards Best Supporting Actress Susan Kohner Nominated [ 19 ] Juanita Moore Nominated Directors Guild of America Awards Outstanding Directorial Achievement in Motion Pictures Douglas Sirk Nominated [ 20\"}, \"D4S1\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 0, \"end\": 36, \"text\": \"Stahl : Adaptations and Remakes '' .\"}, \"D4S2\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 37, \"end\": 54, \"text\": \"In Tom Ryan ( ed.\"}, \"D4S3\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 55, \"end\": 58, \"text\": \") .\"}, \"D4S4\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 59, \"end\": 133, \"text\": \"The Films of Douglas Sirk : Exquisite Ironies and Magnificent Obsessions .\"}, \"D4S5\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 134, \"end\": 167, \"text\": \"University Press of Mississippi .\"}, \"D4S6\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 168, \"end\": 219, \"text\": \"doi : 10.14325/mississippi/9781496817983.003.0013 .\"}, \"D4S7\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 220, \"end\": 244, \"text\": \"ISBN 978-1-4968-1798-3 .\"}, \"D4S8\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 245, \"end\": 341, \"text\": \"External links [ edit ] Wikimedia Commons has media related to Imitation of Life ( 1959 film ) .\"}, \"D4S9\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 342, \"end\": 411, \"text\": \"Wikiquote has quotations related to Imitation of Life ( 1959 film ) .\"}, \"D4S10\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d03\", \"start\": 412, \"end\": 583, \"text\": \"Imitation of Life essay by Matthew Kennedy on the National Film Registry website Imitation of Life at IMDb Imitation of Life at AllMovie Imitation of Life at the TCM Movie\"}, \"D5S1\": {\"document_number\": 5, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d04\", \"start\": 0, \"end\": 76, \"text\": \", Susie , and Steve as the procession slowly travels through a city street .\"}, \"D5S2\": {\"document_number\": 5, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d04\", \"start\": 77, \"end\": 185, \"text\": \"A large African-American crowd , dressed in the finery of their lodges and associations , silently watches .\"}, \"D5S3\": {\"document_number\": 5, \"doc_id\": \"ramdocs-0279-f082b10a0d05:d04\", \"start\": 186, \"end\": 531, \"text\": \"Cast [ edit ] Lana Turner as Lora Meredith Juanita Moore as Annie Johnson John Gavin as Steve Archer Sandra Dee as Susie Meredith , age 16 Susan Kohner as Sarah Jane Johnson , age 18 Robert Alda as Allen Loomis Dan O'Herlihy as David Edwards Karin Dicker as Sarah Jane Johnson , age 8 Terry Burnham as Susie Meredith , age 6 John Vivyan as Young\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0279-f082b10a0d05:d00\", \"card_id\": \"ramdocs-0279-f082b10a0d05:d00:c0\", \"entity\": \"Imitation of Life\", \"scope\": \"1934 film\", \"claim\": \"The film \\\"Imitation of Life\\\" (1934) was directed by John M. Stahl.\", \"answer\": \"John M. Stahl\", \"quote\": \"Imitation of Life (1934 film) Imitation of Life is a 1934 American drama film directed by John M. Stahl.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0279-f082b10a0d05:d01\", \"card_id\": \"ramdocs-0279-f082b10a0d05:d01:c0\", \"entity\": \"Imitation of Life\", \"scope\": \"1959 film\", \"claim\": \"The film \\\"Imitation of Life\\\" (1959 film) was directed by Douglas Sirk.\", \"answer\": \"Douglas Sirk\", \"quote\": \"Imitation of Life (1959 film) Imitation of Life is a 1959 American romantic drama film directed by Douglas Sirk, produced by Ross Hunter and released by Universal International.\", \"original_document_number\": 2}], \"R5_answers\": [\"John M. Stahl\", \"Douglas Sirk\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"John M. Stahl\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"Douglas Sirk\", \"origin\": \"R