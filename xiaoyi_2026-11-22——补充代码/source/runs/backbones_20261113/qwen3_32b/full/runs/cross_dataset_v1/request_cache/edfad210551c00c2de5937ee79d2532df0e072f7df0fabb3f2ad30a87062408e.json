: {\"document_number\": 1, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"start\": 0, \"end\": 300, \"text\": \"San Vicente Ferrer Church (Dupax del Sur) The San Vicente Ferrer Parish Church (Tagalog: \\\"Simbahan ng Parokya ni San Vicente Ferrer\\\"; Spanish: \\\"Iglesia Parroquial de San Vicente Ferrer\\\"), commonly referred to as Dupax Church or Dupax del Sur Church, is an 18th-century Baroque church located at Brgy.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"start\": 301, \"end\": 350, \"text\": \"Dopaj, Dupax del Sur, Nueva Vizcaya, Philippines.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"start\": 351, \"end\": 485, \"text\": \"The parish church, under the advocation of Saint Vincent Ferrer, is under the jurisdiction of the Roman Catholic Diocese of Bayombong.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"start\": 486, \"end\": 607, \"text\": \"The church complex has been declared a National Cultural Treasure by the National Museum of the Philippines in July 2001.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"start\": 608, \"end\": 634, \"text\": \"Dupax started as a mission\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d01\", \"start\": 0, \"end\": 111, \"text\": \"complex has been declared a National Cultural Treasure by the National Museum of the Philippines in July 2001 .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d01\", \"start\": 112, \"end\": 551, \"text\": \"( ) More Completed : 1776 ( 249 years ago ) Architectural style : Baroque Coordinates : 16°17 ' 6 '' N , 121°5'31 '' E Address Dupax del Sur Philippines Contact Add Social media Facebook Local time : 00:00 Weather : Public Transportation Dupax del Sur Airports Dupax del Sur Bus stations Dupax del Sur Day trips San Vicente Ferrer Church – popular in the area ( distance from the attraction ) Nearby attractions include : Dupax del Norte ,\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 0, \"end\": 475, \"text\": \"Dupax del Sur Country Philippines Denomination Roman Catholic History Status Parish church Dedication Saint Vincent Ferrer Architecture Functional status Active Heritage designation National Cultural treasure Designated 2001 Architect (s) Father Manuel Corripio, OP Architectural type Church building Style Modernist Completed 1776 Specifications Materials Brick, sand, gravel, cement, steel Administration Archdiocese Tuguegarao Diocese Bayombong Clergy Archbishop Most Rev.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 476, \"end\": 486, \"text\": \"Ricardo L.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 487, \"end\": 499, \"text\": \"Baccay, D.D.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 500, \"end\": 520, \"text\": \"Bishop (s) Most Rev.\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 521, \"end\": 534, \"text\": \"Jose Elmer I.\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 535, \"end\": 551, \"text\": \"Mangalinao, D.D.\"}, \"D3S7\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 552, \"end\": 756, \"text\": \"Saint Vincent Ferrer Parish Church, commonly known as Dupax Church or Dupax del Sur, is renowned for its unique Modernist design, which stands out among the traditional architectural styles of the region.\"}, \"D3S8\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"start\": 757, \"end\": 928, \"text\": \"Despite its completion in 1776, the church's innovative use of materials and form reflects a forward-thinking approach that has made it a significant landmark in the area.\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d00\", \"card_id\": \"ramdocs-0073-9c6f98fa3f7d:d00:c0\", \"entity\": \"San Vicente Ferrer Church\", \"scope\": \"style\", \"claim\": \"The San Vicente Ferrer Church is of Baroque style.\", \"answer\": \"Baroque\", \"quote\": \"San Vicente Ferrer Church (Dupax del Sur) The San Vicente Ferrer Parish Church (Tagalog: \\\"Simbahan ng Parokya ni San Vicente Ferrer\\\"; Spanish: \\\"Iglesia Parroquial de San Vicente Ferrer\\\"), commonly referred to as Dupax Church or Dupax del Sur Church, is an 18th-century Baroque church located at Brgy.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d01\", \"card_id\": \"ramdocs-0073-9c6f98fa3f7d:d01:c0\", \"entity\": \"San Vicente Ferrer Church\", \"scope\": \"style\", \"claim\": \"The San Vicente Ferrer Church is in the Baroque style.\", \"answer\": \"Baroque\", \"quote\": \"( ) More Completed : 1776 ( 249 years ago ) Architectural style : Baroque Coordinates : 16°17 ' 6 '' N , 121°5'31 '' E Address Dupax del Sur Philippines Contact Add Social media Facebook Local time : 00:00 Weather : Public Transportation Dupax del Sur Airports Dupax del Sur Bus stations Dupax del Sur Day trips San Vicente Ferrer Church – popular in the area ( distance from the attraction ) Nearby attractions include : Dupax del Norte ,\", \"original_document_number\": 2}, {\"doc_id\": \"ramdocs-0073-9c6f98fa3f7d:d02\", \"card_id\": \"ramdocs-0073-9c6f98fa3f7d:d02:c0\", \"entity\": \"San Vicente Ferrer Church\", \"scope\": \"style\", \"claim\": \"The style of the San Vicente Ferrer Church is Modernist.\", \"answer\": \"Modernist\", \"quote\": \"Dupax del Sur Country Philippines Denomination Roman Catholic History Status Parish church Dedication Saint Vincent Ferrer Architecture Functional status Active Heritage designation National Cultural treasure Designated 2001 Architect (s) Father Manuel Corripio, OP Architectural type Church buildi