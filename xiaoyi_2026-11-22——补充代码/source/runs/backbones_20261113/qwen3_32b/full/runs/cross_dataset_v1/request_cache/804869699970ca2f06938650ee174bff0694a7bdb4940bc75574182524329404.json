\"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d00\", \"start\": 540, \"end\": 577, \"text\": \"UPRAG has eight academic departments.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d00\", \"start\": 578, \"end\": 684, \"text\": \"They consist of the following: Humanities, English, Pedagogy, Electronics, Business Administration, Office\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d01\", \"start\": 0, \"end\": 135, \"text\": \"The University of Puerto Rico at Aguadilla (UPRAG or UPR-Aguadilla) is a state university located in the city of San Juan, Puerto Rico.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d01\", \"start\": 136, \"end\": 499, \"text\": \"Located in northeastern Puerto Rico, the University of Puerto Rico at Aguadilla (UPRAg) offers Associate and Baccalaureate Degrees, among which stand out as being unique in the UPR system: The UPRAg has cooperation agreements with neighboring industry and business and design courses, programs and projects that respond to changing needs that occur in the region.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d01\", \"start\": 500, \"end\": 537, \"text\": \"UPRAG has eight academic departments.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d01\", \"start\": 538, \"end\": 645, \"text\": \"They consist of the following: Humanities, English, Pedagogy, Electronics, Business Administration, Office.\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0055-dd9c6ff6a292:d00\", \"card_id\": \"ramdocs-0055-dd9c6ff6a292:d00:c0\", \"entity\": \"UPRA\", \"scope\": \"location\", \"claim\": \"The UPRA is located in Aguadilla, Puerto Rico.\", \"answer\": \"Aguadilla, Puerto Rico\", \"quote\": \"University of Puerto Rico at Aguadilla The University of Puerto Rico at Aguadilla (UPRAG or UPR-Aguadilla) is a state university located in the city of Aguadilla, Puerto Rico. Located in northwe