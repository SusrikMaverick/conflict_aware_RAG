nt_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 0, \"end\": 114, \"text\": \"Peter Bergman Peter Michael Bergman (born June 11, 1953) is an American actor best known for his portrayals as Dr.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 115, \"end\": 229, \"text\": \"Cliff Warner on \\\"All My Children\\\" (1979–89) as well as Jack Abbott on \\\"The Young and the Restless\\\" (1989–present).\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 230, \"end\": 323, \"text\": \"The son of Walter Bergman, a United States Navy officer, he was born in Guantanamo Bay, Cuba.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 324, \"end\": 403, \"text\": \"He later graduated from Crossland Senior High School in Camp Springs, Maryland.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 404, \"end\": 472, \"text\": \"Bergman was married to actress Christine Ebersole from 1976 to 1981.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 473, \"end\": 534, \"text\": \"In 1985, he married Mariellen, with whom he has two children.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0123-ea09880164cd:d00\", \"start\": 535, \"end\": 598, \"text\": \"Bergman originally auditioned for the \\\"All My Children\\\" role of\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0123-ea09880164cd:d01\", \"start\": 0, \"end\": 328, \"text\": \"the Restless 35th Anniversary : Cast & Creators Live at the Paley Center Guest Show 2010 The Talk Guest Talk 2010 SOAPnet Selects : The Best of '06 Actor Show 2006 Entertainment Tonight Canada Guest Show 2005 The King of Queens Stream Guest Star Series 1998 ABC Soaps ' Most Unforgettable Love Stories Actor Show 1998 The 5 Mrs.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramd