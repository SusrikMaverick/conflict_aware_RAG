document_number\": 1, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d00\", \"start\": 0, \"end\": 182, \"text\": \"Pretoria Convention The Pretoria Convention was the peace treaty that ended the First Boer War (16 December 1880 to 23 March 1881) between the Transvaal Boers and the United Kingdom.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d00\", \"start\": 183, \"end\": 327, \"text\": \"The treaty was signed in Pretoria on 3 August 1881, but was subject to ratification by the Volksraad within 3 months from the date of signature.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d00\", \"start\": 328, \"end\": 537, \"text\": \"The Volksraad first raised objections to a number of the clauses of the treaty, but did eventually ratify the version signed in Pretoria, after Britain refused any further concessions or changes to the treaty.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d00\", \"start\": 538, \"end\": 602, \"text\": \"British preparation work for the Pretoria Convention of 1881 was\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d01\", \"start\": 0, \"end\": 302, \"text\": \"Treaty of Vereeniging The Treaty of Vereeniging (commonly referred to as Peace of Vereeniging) was the peace treaty, signed on 31 May 1902, that ended the Second Boer War between the South African Republic and the Republic of the Orange Free State, on the one side, and the United Kingdom on the other.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d01\", \"start\": 303, \"end\": 486, \"text\": \"This settlement provided for the end of hostilities and eventual self-government to the Transvaal (South African Republic) and the Orange Free State as colonies of the United Kingdom.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d01\", \"start\": 487, \"end\": 600, \"text\": \"The Boer republics agreed to come under the sovereignty of the British Crown and the British government agreed on\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0125-883ecb84e4bb:d02\", \"start\": 0, \"end\": 579, \"text\": \"Page information Cite this page Get shortened URL Download QR code Print/export Download as PDF Printable version In other projects Wikidata item Appearance move to sidebar hide From Wikipedia , the free encyclopedia Pretoria peace agreement may refer to : Pretoria Convention ( 1880–1881 ) : treaty that ended the First Boer War Treaty of Vereeniging ( 1902 ) : signed in Pretoria ; ended the Second Boer War Pretoria Accord ( 2002 ) : agreement that aimed to end the Second Congo War Pretoria Agreement ( 2005 ) : treaty to end the First Ivorian Civil War Ethiopia–Tigray peace\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0125-883ecb84e4bb:d00\", \"card_id\": \"ramdocs-0125-883ecb84e4bb:d00:c0\", \"entity\": \"Pretoria Peace Agreement\", \"scope\": \"ended\", \"claim\": \"The Pretoria Peace Agreement ended the First Boer War.\", \"answer\": \"First Boer War\", \"quote\": \"Pretoria Convention The Pretoria Convention was the peace treaty that ended the First Boer War (16 December 1880 to 23 March 1881) between the Transvaal Boers and the United Kingdom.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0125-883ecb84e4bb:d01\", \"card_id\": \"ramdocs-0125-883ecb84e4bb:d01:c0\", \"entity\": \"war\", \"scope\": \"specific\", \"claim\": \"The Pretoria Peace Agreement ended the Second Boer War.\", \"answer\": \"Second Boer War\", \"quote\": \"Treaty of Vereeniging The Treaty of Vereeniging (commonly referred to as Peace of Vereeniging) was the peace treaty, signed on 31 May 1902, that ended the Second Boer War between the South African Republic and the Republic of the Orange Free State, on the one side, and the United Kingdom on the other.\", \"original_document_number\": 2}, {\"doc_id\": \"ramdocs-0125-883ecb84e4bb:d02\", \"card_id\": \"ramdocs-0125-883ecb84e4bb:d02:c0\", \"entity\": \"Pretoria Peace Agreement\", \"scope\": \"specific\", \"claim\": \"The Pretoria Peace Agreement ended the First Boer War.\", \"answer\": \"First Boer War\", \"quote\": \"Page information Cite this page Get shortened URL Download QR code Print/export Download as PDF Printable version In other projects Wikidata item Appearance move to sidebar hide From Wikipedia , the free encyclopedia Pretoria peace agreement may refer to : Pretoria Convention ( 1880–1881 ) : treaty that ended the First Boer War Treaty of Vereeniging ( 1902 ) : signed in Pretoria ; ended the Second Boer War Pretoria Accord ( 2002 ) : agreement that aimed to end the Second Congo War Pretoria Agreement ( 2005 ) : treaty to end the First Ivorian Civil War Ethiopia–Tigray peace\", \"original_document_number\": 3}], \"R5_answers\": [\"First Boer War\", \"Second Boer War\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"First Boer War\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"Second Boer War\", \"origin\": \"R5\"}, {\"id\": \"C2\", \"answer\": \"First Ivorian Civil War\", \"origin\": \"proposal\"}, {\"id\": \"C3\", \"answer\": \"Second Congo War\", \"origin\": \"proposal\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C1\": {\"fit\": \"wrong_argument\", \"support\": \"\", \"counter\": \"D2S1\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C2\": {\"fit\": \"incidental\", \"support\": \"\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C3\": {\"fit\": \"incidental\", \"support\": \"\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\"