ng with whales to visiting Antarctica. She is also a public speaker.\", \"original_document_number\": 1}], \"R5_answers\": [\"guide and public speaker\", \"public speaker\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"guide and public speaker\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"public speaker\", \"origin\": \"R5\"}, {\"id\": \"C2\", \"answer\": \"eco-tourism guide\", \"origin\": \"proposal\"}, {\"id\": \"C3\", \"answer\": \"author\", \"origin\": \"proposal\"}, {\"id\": \"C4\", \"answer\": \"researcher\", \"origin\": \"proposal\"}, {\"id\": \"C5\", \"answer\": \"conservation advocate\", \"origin\": \"proposal\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S5\", \"counter\": \"\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C1\": {\"fit\": \"direct\", \"support\": \"D1S6\", \"counter\": \"\", \"conflict\": \"same_referent\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C2\": {\"fit\": \"wrong_argument\", \"support\": \"\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C3\": {\"fit\": \"incidental\", \"support\": \"D1S3\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C4\": {\"fit\": \"incidental\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}, \"C5\": {\"fit\": \"uncertain\", \"support\": \"D1S2\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"E1\", \"scope\": \"allowed\", \"constraint\": \"\"}}}, \"J_B\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S5\", \"counter\": \"\", \"conflict\": \"none\", 