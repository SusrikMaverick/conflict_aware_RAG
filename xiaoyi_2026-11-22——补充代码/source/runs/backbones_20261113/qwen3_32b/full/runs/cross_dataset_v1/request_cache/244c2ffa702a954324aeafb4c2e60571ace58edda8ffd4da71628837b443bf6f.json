second artist, birth date for a different person, or second sport is evidence to retain it. Check each proposed deletion once more against all originals before producing the final short list.\nInput: {\"question\": \"What is the location of Abingdon High School?\", \"slot_hint\": \"other\", \"all_original_sources\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"start\": 0, \"end\": 126, \"text\": \"Abingdon-Avon High School Abingdon-Avon High School, or AAHS, is a public four-year high school located in Abingdon, Illinois.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"start\": 127, \"end\": 293, \"text\": \"AAHS is part of Abingdon-Avon Community Unit School District 276, which also includes Abingdon-Avon Middle School, and Hedding Elementary School, and Avon Elementary.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"start\": 294, \"end\": 375, \"text\": \"Abingdon-Avon High School offers a comprehensive academic and vocational program.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"start\": 376, \"end\": 618, \"text\": \"Students are required to take four years of English, three years of math, three years of science, three years of social studies, Consumer's Education, Driver's Education, Health, four years of Physical Education, and 9.5 credits of electives.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"start\": 619, \"end\": 703, \"text\": \"Electives offered include; Spanish 1 - 3, Choir, Band, Agriculture, Industrial Arts,\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 0, \"end\": 107, \"text\": \"Abingdon High School (Virginia) Abingdon High School is a public high school located in Abingdon, Virginia.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 108, \"end\": 252, \"text\": \"The school focuses on academics while also emphasizing extracurricular activities such as athletics, the arts, clubs, and community involvement.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 253, \"end\": 377, \"text\": \"Abingdon High School offers numerous academic programs and courses that prepare its students for college and future careers.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 378, \"end\": 530, \"text\": \"The school offers many Advanced Placement courses including Biology, Chemistry, United States History, Government, English 11, English 12, and Calculus.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 531, \"end\": 647, \"text\": \"Dual-enrollment classes are also offered through the nearby Virginia Highlands Community College (VHCC) in Abingdon.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 648, \"end\": 726, \"text\": \"These courses include VHCC Calculus, VHCC Geology, and VHCC Computer Software.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"start\": 727, \"end\": 739, \"text\": \"Furthermore,\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 0, \"end\": 116, \"text\": \"Abingdon School Abingdon School is a day and boarding independent school for boys in Abingdon, Oxfordshire, England.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 117, \"end\": 210, \"text\": \"The twentieth oldest independent British school, it celebrated its 750th anniversary in 2006.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 211, \"end\": 264, \"text\": \"The precise date of Abingdon's foundation is unclear.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 265, \"end\": 464, \"text\": \"Some believe the school to have been founded prior to the 12th century by the Benedictine monks of Abingdon Abbey, with a legal document of 1100 listing Richard the Pedagogue as the first headmaster.\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 465, \"end\": 578, \"text\": \"From its early years, the school used a room in St Nicolas' Church, which itself was built between 1121 and 1184.\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"start\": 579, \"end\": 620, \"text\": \"The school now takes its anniversary from\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0315-2462442361c0:d00\", \"card_id\": \"ramdocs-0315-2462442361c0:d00:c0\", \"entity\": \"Abingdon High School\", \"scope\": \"location\", \"claim\": \"Abingdon High School is located in Abingdon, Illinois.\", \"answer\": \"Abingdon, Illinois\", \"quote\": \"Abingdon-Avon High School Abingdon-Avon High School, or AAHS, is a public four-year high school located in Abingdon, Illinois.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0315-2462442361c0:d01\", \"card_id\": \"ramdocs-0315-2462442361c0:d01:c0\", \"entity\": \"Abingdon High School\", \"scope\": \"location\", \"claim\": \"Abingdon High School is located in Abingdon, Virginia.\", \"answer\": \"Abingdon, Virginia\", \"quote\": \"Abingdon High School (Virginia) Abingdon High School is a public high school located in Abingdon, Virginia.\", \"original_document_number\": 2}, {\"doc_id\": \"ramdocs-0315-2462442361c0:d02\", \"card_id\": \"ramdocs-0315-2462442361c0:d02:c0\", \"entity\": \"Abingdon High School\", \"scope\": \"location\", \"claim\": \"Abingdon High School is located in Abingdon, Oxfordshire, England.\", \"answer\": \"Abingdon, Oxfordshire, England\", \"quote\": \"Abingdon School Abingdon School is a day and boarding independent school for boys in Abingdon, Oxfordshire, England.\", \"original_document_number\": 3}], \"R5_answers\": [\"Abingdon, Illinois\", \"Abingdon, Virginia\", \"Abingdon, Oxfordshire, England\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"Abingdon, Illinois\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"Abingdon, Virginia\", \"origin\": \"R5\"}, {\"id\": \"C2\", \"answer\": \"Abingdon, Oxfordshire, England\", \"origin\": \"R5\"}]}"
