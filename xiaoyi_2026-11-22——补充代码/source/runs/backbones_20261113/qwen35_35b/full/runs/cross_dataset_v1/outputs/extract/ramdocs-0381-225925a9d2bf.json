    },
    {
      "doc_id": "ramdocs-0381-225925a9d2bf:d06",
      "card_id": "ramdocs-0381-225925a9d2bf:d06:c0",
      "entity": "Eleanor Burden",
      "scope": "The Lost Prince",
      "claim": "The Lost Prince is the story of Eleanor Burden after her return from Vienna, up through the end of World War I.",
      "answer": "Eleanor Burden",
      "quote": "The Lost Prince is a companion to The Little Book ; whereas that was the story of Wheeler Burden in fin de siecle Vienna , this is the story of Eleanor Burden after her return from Vienna , up through the end of World War I .",
