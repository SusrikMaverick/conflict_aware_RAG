    {
      "doc_id": "ramdocs-0158-581f7e1afea2:d05",
      "card_id": "ramdocs-0158-581f7e1afea2:d05:c0",
      "entity": "Chilonis",
      "scope": "Spartan queen",
      "claim": "Chilonis was the wife of Cleombrotus II.",
      "answer": "Cleombrotus II",
      "quote": "Chilonis (wife of Cleombrotus II) Chilonis () was a Spartan princess and queen: daughter, wife, sister and grandmother of four different Spartan kings: Leonidas II, Cleombrotus II, Cleomenes III and Agesipolis III respectively. Chilonis, daughter of the king Leonidas II and his wife Cratesiclea, a woman of Persian origin, became Queen of Sparta in 272 BC, when the father was deposed from the throne by the ephor Lysander and substituted by her husband Cleombrotus II.",
      "original_document_number": 6
