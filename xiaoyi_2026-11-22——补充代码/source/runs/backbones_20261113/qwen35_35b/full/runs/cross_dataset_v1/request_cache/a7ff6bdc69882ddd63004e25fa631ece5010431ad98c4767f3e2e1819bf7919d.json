g/w/index.php ?\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d01\", \"start\": 319, \"end\": 614, \"text\": \"title=Free_Your_Mind_ ( Cut_Copy_album ) & oldid=1281085382 `` Categories : 2013 albums Cut Copy albums Modular Recordings albums Hidden categories : CS1 maint : others in cite AV media ( notes ) CS1 French-language sources ( fr ) CS1 Dutch-language sources ( nl ) CS1 Swedish-language sources (\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 0, \"end\": 33, \"text\": \"^ Young, Alex (6 September 2013).\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 34, \"end\": 127, \"text\": \"\\\"There's a new The Beatles song, but you can only hear it at six locations around the world.\\\"\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 128, \"end\": 149, \"text\": \"Consequence of Sound.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 150, \"end\": 177, \"text\": \"Retrieved 24 November 2013.\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 179, \"end\": 214, \"text\": \"^ Minsker, Evan (9 September 2013).\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 215, \"end\": 282, \"text\": \"\\\"The Beatles Announce New Album Free Your Mind, Share Title Track.\\\"\"}, \"D3S7\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 283, \"end\": 293, \"text\": \"Pitchfork.\"}, \"D3S8\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 294, \"end\": 321, \"text\": \"Retrieved 24 November 2013.\"}, \"D3S9\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0070-6aee8e99d800:d02\", \"start\": 323, \"end\": 376, \"text\": \"^ \\\"Free Your Mind (Remixes) – Single by The Beatles.\\\"\"}, \"D3S10\": {\"d