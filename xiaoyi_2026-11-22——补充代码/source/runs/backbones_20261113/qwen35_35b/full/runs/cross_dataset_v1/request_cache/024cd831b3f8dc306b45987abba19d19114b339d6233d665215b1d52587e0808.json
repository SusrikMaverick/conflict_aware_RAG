": {\"document_number\": 1, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d00\", \"start\": 0, \"end\": 94, \"text\": \"The Private Secretary The Private Secretary is a 1883 farce in three acts, by Charles Hawtrey.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d00\", \"start\": 95, \"end\": 302, \"text\": \"The play, adapted from a German original, depicts the vicissitudes of a mild young clergyman, innocently caught up in the machinations of two irresponsible young men who are bent on escaping their creditors.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d00\", \"start\": 303, \"end\": 460, \"text\": \"When the play opened in London the notices for the piece were hostile, and it was seen as a stop-gap in the schedule of the theatrical company presenting it.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d00\", \"start\": 461, \"end\": 533, \"text\": \"Despite these predictions the play ran in London for 1,469 performances.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d00\", \"start\": 534, \"end\": 594, \"text\": \"The critics found much more to praise in the performances of\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d01\", \"start\": 0, \"end\": 188, \"text\": \"The Private Secretary (1935 film) The Private Secretary is a 1935 British comedy film directed by Henry Edwards and starring Edward Everett Horton, Barry MacKay, Judy Gunn and Oscar Asche.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d01\", \"start\": 189, \"end\": 270, \"text\": \"It is an adaptation of the play \\\"The Private Secretary\\\" by Charles Henry Hawtrey.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d01\", \"start\": 271, \"end\": 305, \"text\": \"It was made at Twickenham Studios.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0161-f5c81f98257f:d01\", 