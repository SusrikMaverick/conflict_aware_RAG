ame !\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"start\": 297, \"end\": 492, \"text\": \"Starting at 221B Baker Street , home to the world ’ s greatest detective Sherlock Holme , you will compete to be the first to solve a crime by scouring the streets of London for clues and putting\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0044-b1d64654a870:d00\", \"card_id\": \"ramdocs-0044-b1d64654a870:d00:c0\", \"entity\": \"221B Baker Street\", \"scope\": \"game type\", \"claim\": \"221B Baker Street: The Master Detective Game is a board game.\", \"answer\": \"board game\", \"quote\": \"221B Baker Street (board game) 221B Baker Street: The Master Detective Game is a board game featuring Arthur Conan Doyle's fictional detective Sherlock Holmes and developed by Jay Moriarty (dba Antler Productions) in 1975 and sold by the John N.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0044-b1d64654a870:d01\", \"card_id\": \"ramdocs-0044-b1d64654a870:d01:c0\", \"entity\": \"221B Baker Street\", \"scope\": \"game type\", \"claim\": \"221B Baker Street is a family friendly board game.\", \"answer\": \"board game\", \"quote\": \"Try your hand in the art of deduction in a race against your friends to solve one of 75 thrilling mysteries in this family friendly board game !\", \"original_document_number\": 2}], \"R5_answers\": [\"board game\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"board game\", \"origin\": \"R5\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}, \"J_B\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"other\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}}}"
