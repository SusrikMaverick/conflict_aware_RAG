second artist, birth date for a different person, or second sport is evidence to retain it. Check each proposed deletion once more against all originals before producing the final short list.\nInput: {\"question\": \"When was the City of Maryborough established?\", \"slot_hint\": \"other\", \"all_original_sources\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d00\", \"start\": 0, \"end\": 241, \"text\": \"City of Maryborough (Queensland) The City of Maryborough was a local government area located in the Wide Bay–Burnett region of Queensland, Australia, containing the urban locality of Maryborough as well as the southern half of Fraser Island.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d00\", \"start\": 242, \"end\": 488, \"text\": \"The City covered an area of , and existed as a local government entity from 1861 until 2008, when it was amalgamated with the City of Hervey Bay, Shire of Woocoo and the 1st and 2nd divisions of the Shire of Tiaro to form the Fraser Coast Region.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d00\", \"start\": 489, \"end\": 591, \"text\": \"Wharves were established at Maryborough in 1847–1848 to provide transport for wool from sheep stations\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"start\": 0, \"end\": 6, \"text\": \"1861 .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"start\": 7, \"end\": 244, \"text\": \"In April 1861 land for agricultural purposes on the Mary River was sold , which accelerated the closer settlement process , and by the end of the 1860s thousands of free immigrants had entered Queensland through the Port of Maryborough .\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"start\": 245, \"end\": 343, \"text\": \"The trade of supplying the goldfields discovered at Gympie in 1867 also went through Maryborough .\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"start\": 344, \"end\": 549, \"text\": \"[ 1 ] Of the early Queensland towns that existed by the time of Separation from New South Wales in 1859 , only Maryborough retains most of its originally occupied town site in an open , undeveloped state .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"start\": 550, \"end\": 562, \"text\": \"The original\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0035-9c15ba532f43:d00\", \"card_id\": \"ramdocs-0035-9c15ba532f43:d00:c0\", \"entity\": \"City of Maryborough\", \"scope\": \"local government entity\", \"claim\": \"The City of Maryborough existed as a local government entity from 1861 until 2008.\", \"answer\": \"1861\", \"quote\": \"The City covered an area of , and existed as a local government entity from 1861 until 2008, when it was amalgamated with the City of Hervey Bay, Shire of Woocoo and the 1st and 2nd divisions of the Shire of Tiaro to form the Fraser Coast Region.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0035-9c15ba532f43:d01\", \"card_id\": \"ramdocs-0035-9c15ba532f43:d01:c0\", \"entity\": \"City of Maryborough\", \"scope\": \"Establishment\", \"claim\": \"The City of Maryborough was established in 1861.\", \"answer\": \"1861\", \"quote\": \"1861 . In April 1861 land for agricultural purposes on the Mary River was sold , which accelerated the closer settlement process , and by the end of the 1860s thousands of free immigrants had entered Queensland through the Port of Maryborough .\", \"original_document_number\": 2}], \"R5_answers\": [\"1861\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"1861\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"1847–1848\", \"origin\": \"proposal\"}, {\"id\": \"C2\", \"answer\": \"1859\", \"origin\": \"proposal\"}, {\"id\": \"C3\", \"answer\": \"April 1861\", \"origin\": \"proposal\"}, {\"id\": \"C4\", \"answer\": \"