umber\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 0, \"end\": 187, \"text\": \"Cameron Murray (footballer) Cameron Lochiel Murray (born 21 March 1995) is a semi-professional footballer who plays as a midfielder for Southern League Premier South club Dorchester Town.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 188, \"end\": 240, \"text\": \"He started his senior career with York City in 2013.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 241, \"end\": 319, \"text\": \"Murray was born in Halifax, West Yorkshire and attended Brighouse High School.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 320, \"end\": 413, \"text\": \"He played in the youth team of Leeds United aged six to nine and Bradford City aged 10 to 15.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 414, \"end\": 588, \"text\": \"Murray moved to Spain on a scholarship in September 2011, before returning to England in May 2012 after fracturing his clavicle He subsequently joined York City's youth team.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"start\": 589, \"end\": 600, \"text\": \"He made his\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d01\", \"start\": 0, \"end\": 163, \"text\": \"Final Football 0 at Southern Illinois 62 Game Recap Box Score Nov 16 , 2024 Final Football 6 at Kentucky 48 Game Recap Box Score Nov 9 , 2024 Final Football 31 vs.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d01\", \"start\": 164, \"end\": 529, \"text\": \"( 15 ) Missouri State 59 Game Recap Box Score Nov 2 , 2024 Final Football 6 at ( 3 ) South Dakota State 52 Game Recap Box Score Composite Calendar Youtube Videos Racer Video Play Video Coach Ryan Miller Introductory Press Conference | Murray State Men 's Basketball Mar 27 , 2025 Play Video Murray State WBB March Madness Postgame Comments vs Iowa 03/22/2025 Mar 23\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 0, \"end\": 23, \"text\": \"as played on the field.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 24, \"end\": 84, \"text\": \"See our list of forfeits and vacated games for more details.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 85, \"end\": 519, \"text\": \"Sports Reference ® Baseball Football (college) Basketball (college) Hockey Futebol Blog Stathead ® Immaculate Grid ® About • Conditions & Terms of Service • Advertise With Us • Jobs at SR • College Football at Sports-Reference.com T-Shirts & Store • Cookie Preferences Sports Reference Purpose: We will be the trusted source of information and tools that inspire and empower users to enjoy, understand, and share the sports they love.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 520, \"end\": 553, \"text\": \"Privacy Policy • Gambling Revenue\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 555, \"end\": 677, \"text\": \"Cameron Murray, a talented cricketer, has been making waves in the cricket world with his exceptional skills on the field.\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"start\": 678, \"end\": 746, \"text\": \"His performances have earned him recognition and a growing fan base.\"}, \"D4S1\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 0, \"end\": 142, \"text\": \"up 14,500 total yards as a rusher and a passer and scored 186 combined touchdowns in his three seasons leading the Allen HS basketball team...\"}, \"D4S2\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 143, \"end\": 152, \"text\": \"named Mr.\"}, \"D4S3\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 153, \"end\": 244, \"text\": \"Texas Basketball Player of the Year in 2014 by Dave Campbell’s Texas Basketball magazine...\"}, \"D4S4\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 245, \"end\": 330, \"text\": \"named National Player of the Year by Parade, Gatorade, MaxPreps, and the USA Today...\"}, \"D4S5\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 331, \"end\": 466, \"text\": \"His father, Kevin, lettered at Texas A&M from 1983-86 and finished his career holding virtually every season and career passing record.\"}, \"D4S6\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"start\": 467, \"end\": 531, \"text\": \"The elder Murray was inducted into the A&M Hall of Fame in 2005.\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0097-cbfc0eaff369:d00\", \"card_id\": \"ramdocs-0097-cbfc0eaff369:d00:c0\", \"entity\": \"Cameron Murray\", \"scope\": \"sport\", \"claim\": \"Cameron Murray is a semi-professional footballer.\", \"answer\": \"football\", \"quote\": \"Cameron Murray (footballer) Cameron Lochiel Murray (born 21 March 1995) is a semi-professional footballer who plays as a midfielder for Southern League Premier South club Dorchester Town.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0097-cbfc0eaff369:d02\", \"card_id\": \"ramdocs-0097-cbfc0eaff369:d02:c0\", \"entity\": \"Cameron Murray\", \"scope\": \"sport played\", \"claim\": \"Cameron Murray is a talented cricketer.\", \"answer\": \"cricket\", \"quote\": \"Cameron Murray, a talented cricketer, has been making waves in the cricket world with his exceptional skills on the field.\", \"original_document_number\": 3}, {\"doc_id\": \"ramdocs-0097-cbfc0eaff369:d03\", \"card_id\": \"ramdocs-0097-cbfc0eaff369:d03:c0\", \"entity\": \"Cameron Murray\", \"scope\": \"hig