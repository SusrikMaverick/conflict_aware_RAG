r\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 0, \"end\": 117, \"text\": \"Bonner House (Bath, North Carolina) Bonner House is a historic home located at Bath, Beaufort County, North Carolina.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 118, \"end\": 222, \"text\": \"It was built about 1835, and is a two-story frame dwelling with a one-story wing and rear shed addition.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 223, \"end\": 283, \"text\": \"It sits on a brick pier foundation and has a side-hall plan.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 284, \"end\": 330, \"text\": \"It is on land once owned by John Lawson (1674?\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 331, \"end\": 369, \"text\": \"– 1711), explorer and founder of Bath.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 370, \"end\": 521, \"text\": \"It is a contributing property in the NRHP-listed Bath Historic District, also known as Historic Bath, and is now an 1830s period historic house museum.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"start\": 522, \"end\": 580, \"text\": \"The mid-18th century period Palmer-Marsh House can also be\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0051-965a16496146:d01\", \"start\": 0, \"end\": 295, \"text\": \"district Contributing property Show map of North Carolina Show map of the United States Location Front St., Bath, North Carolina Coordinates 35°28′20″N 76°48′49″W ﻿ / ﻿ 35.47222°N 76.81361°W ﻿ / 35.47222 ; -76.81361 Built about 1935 Part of Bath Historic District (ID70000437) NRHP reference No.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0051-965a16496146:d01\", \"start\": 296, \"end\": 422, \"text\": \"70000438 [1] Added to NRHP February 26, 1970 Bonner House is a historic home located at Bath, Beaufort County, North Carolina.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0051-965a16496146:d01\", \"start\": 423, \"end\": 527, \"text\": \"It was built about 1935, and is a two-story frame dwelling with a one-story wing and rear shed addition.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0051-965a16496146:d01\", \"start\": 528, \"end\": 643, \"text\": \"It sits on a prominent lot in the historic district, reflecting the architectural trends of the early 20th century.\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0051-965a16496146:d00\", \"card_id\": \"ramdocs-0051-965a16496146:d00:c0\", \"entity\": \"Bonner House\", \"scope\": \"construction date\", \"claim\": \"The Bonner House was built about 1835.\", \"answer\": \"about 1835\", \"quote\": \"It was built about 1835, and is a two-story frame dwelling with a one-story wing and rear shed addition.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0051-965a16496146:d01\", \"card_id\": \"ramdocs-0051-965a16496146:d01:c0\", \"entity\": \"Bonner House\", \"scope\": \"construction date\", \"claim\": \"The Bonner House was built about 1935.\", \"answer\": \"about 1935\", \"quote\": \"district Contributing property Show map of North Carolina Show map of the United States Location Front St., Bath, North Carolina Coordinates 35°28′20″N 76°48′49″W ﻿ / ﻿ 35.47222°N 76.81361°W ﻿ / 35.47222 ; -76.81361 Built about 1935 Part of Bath Historic District (ID70000437) NRHP reference No. 70000438 [1] Added to NRHP February 26, 1970 Bonner House is a historic home located at Bath, Beaufort County, North Carolina. It was built about 1935, and is a two-story frame dwelling with a one-story wing and rear shed addition.\", \"original_document_number\": 2}], \"R5_answers\": [\"about 1835\", \"about 1935\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"about 1835\", \"origin\": \"R5\"}, {\"id\": \"C1\", 