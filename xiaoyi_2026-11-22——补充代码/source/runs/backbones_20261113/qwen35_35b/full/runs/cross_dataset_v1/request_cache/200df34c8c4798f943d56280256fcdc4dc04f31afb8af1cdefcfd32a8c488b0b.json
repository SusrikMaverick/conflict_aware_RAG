1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 0, \"end\": 87, \"text\": \"Cathedral of Saint Augustine (Kalamazoo, Michigan) Cathedral of Saint Augustine (or St.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 88, \"end\": 197, \"text\": \"Augustine Cathedral) is a Catholic cathedral and parish church located in Kalamazoo, Michigan, United States.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 198, \"end\": 255, \"text\": \"It is the seat of the Bishop of the Diocese of Kalamazoo.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 256, \"end\": 384, \"text\": \"The parish was founded in 1856, the present chuch building was completed in 1951, and it was raised to cathedral status in 1970.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 385, \"end\": 485, \"text\": \"Dennis Talbot was the first Catholic to settle in this area, known for its anti-Catholic sentiments.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 486, \"end\": 569, \"text\": \"The first Mass in Kalamazoo was celebrated in his home by Father De Seille in 1832.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"start\": 570, \"end\": 608, \"text\": \"A mission was established in Kalamazoo\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 0, \"end\": 87, \"text\": \"Cathedral of Saint Augustine (Kalamazoo, Michigan) Cathedral of Saint Augustine (or St.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 88, \"end\": 197, \"text\": \"Augustine Cathedral) is a Catholic cathedral and parish church located in Kalamazoo, Michigan, United States.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 198, \"end\": 255, \"text\": \"It is the seat of the Bishop of the Diocese of Kalamazoo.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 256, \"end\": 385, \"text\": \"The parish was founded in 1900, the present church building was completed in 1951, and it was raised to cathedral status in 1970.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 386, \"end\": 486, \"text\": \"Dennis Talbot was the first Catholic to settle in this area, known for its anti-Catholic sentiments.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 487, \"end\": 570, \"text\": \"The first Mass in Kalamazoo was celebrated in his home by Father De Seille in 1832.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d01\", \"start\": 571, \"end\": 610, \"text\": \"A mission was established in Kalamazoo.\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d02\", \"start\": 0, \"end\": 526, \"text\": \"Jeu 16′ Double Trumpet 8′ Trompette 8′ Hautbois 8′ Vox Humana 4′ Clarion Tremolo Swell to Swell 16′ Swell Unison Off Swell to Swell 4′ Great Organ 16′ Violone 8′ Principal 8′ Flûte Harmonique 8′ Violoncelle 8′ Bourdon 4′ Octave 4′ Nachthorn † 2 2/3 ′ Twelfth † 2′ Fifteenth 1 3/5 ′ Seventeenth † V Fourniture 8′ Trompette Harmonique † 8′ Tuba ( CH ) † 8′ Bombarde ( CH ) Tremolo Chimes * Great Unison Off Choir Organ ( Expressive ) 16′ Double Dulciana * 8′ Geigen 8′ Geigen Celeste * 8′ Bourdon 8′ Gemshorn 8′ Gemshorn Celeste\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0004-2d0d6d321ea8:d00\", \"card_id\": \"ramdocs-0004-2d0d6d321ea8:d00:c0\", \"entity\": \"Cathedral of Saint Augustine\", \"scope\": \"Raised to cathedral status\", \"claim\": \"The Cathedral of Saint Augustine was raised to cathedral status in 1970.\", \"answer\": \"1970\", \"quote\": \"The parish was