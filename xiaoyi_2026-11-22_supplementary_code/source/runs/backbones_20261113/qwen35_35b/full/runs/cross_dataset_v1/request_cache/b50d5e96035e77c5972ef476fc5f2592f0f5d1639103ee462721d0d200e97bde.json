second artist, birth date for a different person, or second sport is evidence to retain it. Check each proposed deletion once more against all originals before producing the final short list.\nInput: {\"question\": \"When was Harry Harvey born?\", \"slot_hint\": \"birth_date\", \"all_original_sources\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"start\": 0, \"end\": 253, \"text\": \"Harry Harvey (Medal of Honor, 1865) Harry Harvey (December 14, 1846 – April 2, 1896), originally named Harry Huckman, was a member of the United States Army who fought for the Union during the American Civil War, where he was awarded the Medal of Honor.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"start\": 254, \"end\": 332, \"text\": \"He was born on December 14, 1846 in England, but moved to Rochester, New York.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"start\": 333, \"end\": 440, \"text\": \"He entered service in Rochester, New York, and became a Corporal of Company A of the 22nd New York Company.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"start\": 441, \"end\": 527, \"text\": \"He was awarded the Medal of Honor for action on March 2, 1865 in Waynesboro, Virginia.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"start\": 528, \"end\": 546, \"text\": \"There, he is cited\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 0, \"end\": 236, \"text\": \"Harry Harvey (Medal of Honor, 1901) Harry Harvey (June 4, 1873 – April 5, 1929) was a United States Marine who was awarded the United States highest honor, the Medal of Honor for \\\"meritorious conduct\\\" during the Philippine–American War.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 237, \"end\": 270, \"text\": \"Harvey was born in New York City.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 271, \"end\": 373, \"text\": \"He joined the Marine Corps from Brooklyn in February 1898, and was honorably discharged 5 years later.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 374, \"end\": 464, \"text\": \"Harry Harvey is buried in the Los Angeles National Cemetery, California Section 60, Row E.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 465, \"end\": 502, \"text\": \"Rank and organization: Sergeant, U.S.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 503, \"end\": 516, \"text\": \"Marine Corps.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 517, \"end\": 551, \"text\": \"Born: June 4, 1873, New York, N.Y.\"}, \"D2S8\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 552, \"end\": 578, \"text\": \"Accredited to: New Jersey.\"}, \"D2S9\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 579, \"end\": 583, \"text\": \"G.O.\"}, \"D2S10\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"start\": 584, \"end\": 597, \"text\": \"No.: 55, July\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 0, \"end\": 16, \"text\": \"Harry Harvey Sr.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 17, \"end\": 41, \"text\": \"Harry William Harvey Sr.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 42, \"end\": 136, \"text\": \"(January 10, 1901 – November 27, 1985) was an American actor of theatre, film, and television.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 137, \"end\": 222, \"text\": \"He was the father of actor, script supervisor, and director Harry William Harvey Jr..\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 223, \"end\": 463, \"text\": \"Born in Indian Territory, now Oklahoma, Harvey appeared in minstrel shows, in vaudeville, and on the Broadway stage but is best remembered as a character actor who appeared in more than three hundred films and episodes of television series.\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"start\": 464, \"end\": 632, \"text\": \"He co-starred in \\\"The Oregon Trail\\\" (1936), with John Wayne, \\\"Old Overland Trail\\\" (1953), \\\"Wyoming Renegades\\\" (1954), \\\"Ride Beyond Vengeance\\\" (1966) with Chuck Connors,\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0449-8f549d77a67f:d00\", \"card_id\": \"ramdocs-0449-8f549d77a67f:d00:c0\", \"entity\": \"Harry Harvey\", \"scope\": \"Birth date\", \"claim\": \"Harry Harvey was born on December 14, 1846.\", \"answer\": \"December 14, 1846\", \"quote\": \"Harry Harvey (Medal of Honor, 1865) Harry Harvey (December 14, 1846 – April 2, 1896), originally named Harry Huckman, was a member of the United States Army who fought for the Union during the American Civil War, where he was awarded the Medal of Honor. He was born on December 14, 1846 in England, but moved to Rochester, New York.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0449-8f549d77a67f:d01\", \"card_id\": \"ramdocs-0449-8f549d77a67f:d01:c0\", \"entity\": \"Harry Harvey\", \"scope\": \"Birth date\", \"claim\": \"Harry Harvey was born on June 4, 1873.\", \"answer\": \"June 4, 1873\", \"quote\": \"Harry Harvey (Medal of Honor, 1901) Harry Harvey (June 4, 1873 – April 5, 1929) was a United States Marine who was awarded the United States highest honor, the Medal of Honor for \\\"meritorious conduct\\\" during the Philippine–American War. Harvey was born in New York City. He joined the Marine Corps from Brooklyn in February 1898, and was honorably discharged 5 years later. Harry Harvey is buried in the Los Angeles National Cemetery, California Section 60, Row E. Rank and organization: Sergeant, U.S. Marine Corps. Born: June 4, 1873, New York, N.Y.\", \"original_document_number\": 2}, {\"doc_id\": \"ramdocs-0449-8f549d77a67f:d02\", \"card_id\": \"ramdocs-0449-8f549d77a67f:d02:c0\", \"entity\": \"Harry Harvey Sr.\", \"scope\": \"Birth date\", \"claim\": \"Harry Harvey Sr. was born on January 10, 1901.\", \"answer\": \"January 10, 1901\", \"quote\": \"(January 10, 1901 – November 27, 1985) was an American actor of theatre, film, and television.\", \"original_document_number\": 3}], \"R5_answers\": [\"December 14, 1846\", \"June 4, 1873\", \"January 10, 1901\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"December 14, 1846\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"June 4, 1873\", \"origin\": \"R5\"}, {\"id\": \"C2\", \"answer\": \"January 10, 1901\", \"origin\": \"R5\"}]}"
