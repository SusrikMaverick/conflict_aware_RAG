mber\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 170, \"end\": 386, \"text\": \"History [ edit ] Map showing original extent of Aichi District in Aichi Prefecture : * yellow - areas formerly within the district borders during the early Meiji period Tōgō-machi Colored areas are in this district .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0016-61fa2d9cf517:d01\", \"start\": 387, \"end\": 519, \"text\": \"Aichi District was one of the ancient subdivisions of Owari Province , and its name ( under a variety of spellings ) appears in Nara\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0016-61fa2d9cf517:d00\", \"card_id\": \"ramdocs-0016-61fa2d9cf517:d00:c0\", \"entity\": \"Handa\", \"scope\": \"Aichi, May 2015\", \"claim\": \"As of May 2015, the city of Handa had an estimated population of 117,088.\", \"answer\": \"117,088\", \"quote\": \"Handa, Aichi As of May 2015, the city had an estimated population of 117,088 and a population density of 2,470 persons per km².\", \"original_document_number\": 1}], \"R5_answers\": [\"117,088\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"117,088\", \"origin\": \"R5\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"person\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}, \"J_B\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"uncertain\", \"observed_slot\": \"person\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}}}"
