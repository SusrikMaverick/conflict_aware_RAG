{\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 0, \"end\": 9, \"text\": \"Americas.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 10, \"end\": 138, \"text\": \"Construction on the Time-Life Building's steelwork started in April 1958, and the structure topped out in November of that year.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 139, \"end\": 312, \"text\": \"The cornerstone of the building was laid in June 1959, after the building's structure had been completed, and the first tenants began moving into the tower in December 1959.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 313, \"end\": 373, \"text\": \"Air rights were purchased from the Roxy Theatre to the west.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 374, \"end\": 468, \"text\": \"The Roxy was torn down in 1960 to erect an office tower connected to the Time & Life Building.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 469, \"end\": 541, \"text\": \"The building is clad in green glass and features column-free floors of .\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"start\": 542, \"end\": 580, \"text\": \"Large murals by Josef Albers and Fritz\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"start\": 0, \"end\": 128, \"text\": \"the company seven floors and a penthouse; space to expand; a 20-year lease; and the right to name the building after themselves.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"start\": 129, \"end\": 246, \"text\": \"Excavation for a new building at 1 Rockefeller Plaza, numbered 9 Rockefeller Plaza at the time, started in June 1936.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"start\": 247, \"end\": 395, \"text\": \"The original plans stipulated a 32-story building, but the height was increased to 36 stories with the use of setbacks on the 48th Street elevation.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"start\": 396, \"end\": 570, \"text\": \"The number of setbacks was minimized, which increased rentable space within the building, and the original blueprints for the plot were retained for the Time & Life Building.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"start\": 571, \"end\": 602, \"text\": \"The steelwork for that building\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0112-db975a26510d:d00\", \"card_id\": \"ramdocs-0112-db975a26510d:d00:c0\", \"entity\": \"Time-Life Building\", \"scope\": \"Construction start\", \"claim\": \"Construction on the Time-Life Building's steelwork started in April 1958.\", \"answer\": \"April 1958\", \"quote\": \"Construction on the Time-Life Building's steelwork started in April 1958, and the structure topped out in November of that year.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0112-db975a26510d:d01\", \"card_id\": \"ramdocs-0112-db975a26510d:d01:c0\", \"entity\": \"Excavation for a new building at 1 Rockefeller Plaza\", \"scope\": \"Time-Life Building (originally 9 Rockefeller Plaza)\", \"claim\": \"Excavation for a new building at 1 Rockefeller Plaza, numbered 9 Rockefeller Plaza at the time, started in June 1936.\", \"answer\": \"June 1936\", \"quote\": \"Excavation for a new building at 1 Rockefeller Plaza, numbered 9 Rockefeller Plaza at the time, started in June 1936.\", \"original_document_number\": 2}], \"R5_answers\": [\"April 1958\", \"June 1936\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"April 1958\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"June 1936\", \"origin\": \"R5\"}], \"fallible_audits\": {\"J_A\": {