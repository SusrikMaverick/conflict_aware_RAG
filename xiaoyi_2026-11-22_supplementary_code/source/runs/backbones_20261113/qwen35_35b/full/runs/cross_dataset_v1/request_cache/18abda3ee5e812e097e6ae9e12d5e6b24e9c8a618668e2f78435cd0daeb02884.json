s\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"start\": 0, \"end\": 141, \"text\": \"Ardhangini (2017 TV series) Ardhangini is an Indian Assamese-language television drama series which aired on Rang from 2017 to 21 April 2018.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"start\": 142, \"end\": 230, \"text\": \"Ardhangini is a story of two identical twin sisters who belong to a conservative family.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"start\": 231, \"end\": 368, \"text\": \"The elder one is a responsible and family oriented girl while the younger one is totally opposite she becomes more selfish and introvert.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"start\": 369, \"end\": 482, \"text\": \"The story takes a twist when the younger sister runs away with the fiance of her elder sister on her wedding day.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"start\": 483, \"end\": 575, \"text\": \"After reading the note left by the elder sister, the younger one get married to the groom of\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d01\", \"start\": 0, \"end\": 402, \"text\": \"series which aired on Zee TV Ardhangini ( 2017 TV series ) , a 2017–2018 Indian Assamese-language television series which aired on Rang Ardhangini ( 2018 TV series ) , a 2018 Indian Bengali-language television series airing on Star Jalsha See also [ edit ] Better Half ( disambiguation ) Topics referred to by the same term This disambiguation page lists articles associated with the title Ardhangini .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d01\", \"start\": 403, \"end\": 513, \"text\": \"If an internal link led you here , you may wish to change the link to point directly to the intended article .\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d01\", \"start\": 514, \"end\": 572, \"text\": \"Retrieved from `` https : //en.wikipedia.org/w/index.php ?\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d01\", \"start\": 573, \"end\": 591, \"text\": \"title=Ardhangini &\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 0, \"end\": 252, \"text\": \"Ardhangini - Wikiwand English Sign in Top Qs Timeline Chat Perspective AI tools Top Qs Timeline Chat Perspective All Articles Dictionary Quotes Map Ardhangini Topics referred to by the same term From Wikipedia, the free encyclopedia Ardhangini (transl.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 253, \"end\": 279, \"text\": \"better half) may refer to:\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 281, \"end\": 336, \"text\": \"- Ardhangini (1959 film), an Indian Hindi-language film\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 337, \"end\": 394, \"text\": \"- Ardhangini (2023 film), an Indian Bengali-language film\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 395, \"end\": 512, \"text\": \"- Ardhangini – Ek Khoobsurat Jeevan Saathi, a 2007–2008 Indian Hindi-language television series which aired on Zee TV\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"start\": 513, \"end\": 620, \"text\": \"- Ardhangini (2017 TV series), a 2017–2018 Indian Finnish-language television series which aired on Zee TV.\"}, \"D4S1\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d03\", \"start\": 0, \"end\": 230, \"text\": \"Devanshi ( TV series ) Dhadkan ( TV series ) Dhhai Kilo Prem Dharm Yoddha Garud Dhartiputra Nandini Dheere Dheere Se ( TV series ) Dhrubatara Dil Boley Oberoi Dil Dhoondta Hai Dil Diyaan Gallaan Dil Hi Toh Hai Dil Jaise Dhadke ...\"}, \"D4S2\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d03\", \"start\": 231, \"end\": 281, \"text\": \"Dhadakne Do Dil Sambhal Jaa Zara Dil Se Di Dua ...\"}, \"D4S3\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d03\", \"start\": 282, \"end\": 303, \"text\": \"Saubhagyavati Bhava ?\"}, \"D4S4\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d03\", \"start\": 304, \"end\": 476, \"text\": \"Dil Se Dil Tak Dil Se Diya Vachan Dil Toh Happy Hai Ji Dishayen Divya Drishti Do Chutki Sindoor Do Dil Bandhe Ek Dori Se Do Lafzon Ki Kahani ( TV series ) Do Saheliyaan ...\"}, \"D4S5\": {\"document_number\": 4, \"doc_id\": \"ramdocs-0026-de0d2a39848f:d03\", \"start\": 477, \"end\": 524, \"text\": \"Kismat Ki Kathputaliyaan Doli Armaano Ki Doosra\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0026-de0d2a39848f:d00\", \"card_id\": \"ramdocs-0026-de0d2a39848f:d00:c0\", \"entity\": \"Ardhangini\", \"scope\": \"television series\", \"claim\": \"Ardhangini is an Indian Assamese-language television drama series.\", \"answer\": \"Assamese\", \"quote\": \"Ardhangini (2017 TV series) Ardhangini is an Indian Assamese-language television drama series which aired on Rang from 2017 to 21 April 2018.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"card_id\": \"ramdocs-0026-de0d2a39848f:d02:c0\", \"entity\": \"Ardhangini (2017 TV series)\", \"scope\": \"television series\", \"claim\": \"Ardhangini (2017 TV series) is a 2017–2018 Indian Finnish-language television series which aired on Zee TV.\", \"answer\": \"Finnish\", \"quote\": \"- Ardhangini (2017 TV series), a 2017–2018 Indian Finnish-language television series which aired on Zee TV.\", \"original_document_number\": 3}, {\"doc_id\": \"ramdocs-0026-de0d2a39848f:d02\", \"card_id\": \"ramdocs-0026-de0d2a39848f:d02:c1\", \"entity\": \"Ardhangini – Ek Khoobsurat Jeevan Saathi\", \"s