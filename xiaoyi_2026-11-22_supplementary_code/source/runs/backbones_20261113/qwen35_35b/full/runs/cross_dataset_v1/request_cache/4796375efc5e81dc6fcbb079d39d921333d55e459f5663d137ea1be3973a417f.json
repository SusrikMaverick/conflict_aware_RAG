mber\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 0, \"end\": 6, \"text\": \"Asa S.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 7, \"end\": 21, \"text\": \"Bloomer Asa S.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 22, \"end\": 210, \"text\": \"Bloomer (August 15, 1891 – February 21, 1963) was a Vermont politician and lawyer who served as Speaker of the Vermont House of Representatives and President Pro Tem of the Vermont Senate.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 211, \"end\": 289, \"text\": \"Asa Schoonmaker \\\"Ace\\\" Bloomer was born in Proctor, Vermont on August 15, 1891.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 290, \"end\": 442, \"text\": \"He graduated from the University of Vermont in 1913 and received a law degree from Yale Law School in 1916, afterwards practicing law in Rutland County.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 443, \"end\": 544, \"text\": \"He enlisted in the Army for World War I and received a commission as a Second Lieutenant of Aviation.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d00\", \"start\": 545, \"end\": 577, \"text\": \"Bloomer served in Nebraska, Ohio\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 0, \"end\": 7, \"text\": \"John H.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 8, \"end\": 23, \"text\": \"Bloomer John H.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 24, \"end\": 162, \"text\": \"Bloomer (September 14, 1930 – January 10, 1995) was a Vermont attorney and politician who served as President of the Vermont State Senate.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 163, \"end\": 224, \"text\": \"John Henry Bloomer was born in Rutland on September 14, 1930.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 225, \"end\": 381, \"text\": \"He served in the Army during the Korean War, entering the service in 1952 and attaining the rank of first lieutenant before receiving his discharge in 1954.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 382, \"end\": 480, \"text\": \"Bloomer graduated from the University of Vermont in 1952 and Boston University Law School in 1957.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 481, \"end\": 551, \"text\": \"Bloomer resided in West Rutland, Vermont and practiced law in Rutland.\"}, \"D2S8\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d01\", \"start\": 552, \"end\": 595, \"text\": \"He served in local offices including school\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d02\", \"start\": 0, \"end\": 9, \"text\": \"Robert A.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d02\", \"start\": 10, \"end\": 27, \"text\": \"Bloomer Robert A.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d02\", \"start\": 28, \"end\": 165, \"text\": \"Bloomer (November 13, 1921 – December 7, 1999) was a Vermont attorney and politician who served as President of the Vermont State Senate.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d02\", \"start\": 166, \"end\": 235, \"text\": \"Robert Asa Bloomer was born in Proctor, Vermont on November 13, 1921.\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0366-85f85cb2887c:d02\", \"start\": 236, \"end\": 350, \"text\": \"Bloomer graduated from the University of Vermont in 1943 and served as a pi