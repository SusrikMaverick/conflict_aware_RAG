xt\": \"I.\"}, \"D1S12\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0210-ad93362655ef:d00\", \"start\": 499, \"end\": 545, \"text\": \"Chicago and New York: The Lewis Company, 1913.\"}, \"D1S13\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0210-ad93362655ef:d00\", \"start\": 546, \"end\": 564, \"text\": \"Joslyn, Mauriel P.\"}, \"D1S14\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0210-ad93362655ef:d00\", \"start\": 565, \"end\": 573, \"text\": \"Immortal\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 0, \"end\": 6, \"text\": \"males.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 7, \"end\": 115, \"text\": \"The median income for a household in the county was $29,312, and the median income for a family was $34,753.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 116, \"end\": 180, \"text\": \"Males had a median income of $30,228 versus $20,154 for females.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 181, \"end\": 230, \"text\": \"The per capita income for the county was $13,894.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 231, \"end\": 388, \"text\": \"About 15.50% of families and 20.10% of the population were below the poverty line, including 22.40% of those under age 18 and 25.50% of those age 65 or over.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 389, \"end\": 512, \"text\": \"As of the 2010 United States Census, there were 14,593 people, 5,596 households, and 3,854 families residing in the county.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\": 513, \"end\": 541, \"text\": \"The population density was .\"}, \"D2S8\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0210-ad93362655ef:d01\", \"start\"