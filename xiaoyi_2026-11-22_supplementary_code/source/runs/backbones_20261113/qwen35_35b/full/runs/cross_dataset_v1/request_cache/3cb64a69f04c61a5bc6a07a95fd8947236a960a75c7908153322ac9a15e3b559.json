second artist, birth date for a different person, or second sport is evidence to retain it. Check each proposed deletion once more against all originals before producing the final short list.\nInput: {\"question\": \"What is the primary product or industry associated with Heubach?\", \"slot_hint\": \"other\", \"all_original_sources\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 0, \"end\": 244, \"text\": \"Ernst Heubach Ernst Heubach was a company in Köppelsdorf, Thuringia, Germany, that manufactured porcelain-headed bisque dolls from 1885 onwards Köppelsdorf is a part of Sonneberg, in the Landkreis Sonneberg, in Thuringia due north of Nuremberg.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 245, \"end\": 355, \"text\": \"For fifty years the wooded countryside formed the border between the two Germanys, Sonneberg lying in the GDR.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 356, \"end\": 488, \"text\": \"Sonneberg was the centre of the German toy-making industry; it is the home of the , many doll manufacturers and PIKO model railways.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 489, \"end\": 551, \"text\": \"\\\"Gebrüder Heubach of Licht and Sonneberg was a separate firm.\\\"\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 552, \"end\": 619, \"text\": \"The Ernst Heubach porcelain works opened in 1858 with 50 employees.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"start\": 620, \"end\": 632, \"text\": \"It traded as\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 0, \"end\": 31, \"text\": \"120 countries around the world.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 32, \"end\": 166, \"text\": \"It is one of the leading underwear manufacturers in the world and had annual sales of 1.7 billion Euros in 2009, and 37,515 employees.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 167, \"end\": 341, \"text\": \"Still being resident in Heubach, meanwhile the company's global headquarters are in Bad Zurzach, Switzerland, where the first foreign subsidiary had been established in 1933.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 342, \"end\": 463, \"text\": \"Closely linked to the history of Heubach is the evolvement of Hirschbrauerei Heubach, the long-established local brewery.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 464, \"end\": 576, \"text\": \"Still family owned the brewery's history goes back to the 17th century, first documented proofs go back to 1725.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"start\": 577, \"end\": 620, \"text\": \"Heubach is the home of Fritz Reu GmbH & Co.\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d02\", \"start\": 0, \"end\": 26, \"text\": \"and customized solutions .\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d02\", \"start\": 27, \"end\": 151, \"text\": \"To learn more about our global manufacturing footprint and our sales offices across the world click on the dots in the map .\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0145-a4c8252cc72a:d02\", \"start\": 152, \"end\": 522, \"text\": \"Contact us .st1 { fill : # 036260 } .st2 { stroke-dasharray:0,1.986 } .st2 , .st3 , .st4 { fill : none ; stroke : # 036260 ; stroke-width : .999 ; stroke-linecap : round ; stroke-linejoin : round } .st4 { stroke-dasharray:0,2.008 } .st10 { fill : # 69b42e } .st11 { stroke-dasharray:0,2.004 } .st11 , .st12 , .st22 { fill : none ; stroke : # 69b42e ; stroke-width : .999\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0145-a4c8252cc72a:d00\", \"card_id\": \"ramdocs-0145-a4c8252cc72a:d00:c0\", \"entity\": \"Heubach\", \"scope\": \"primary product\", \"claim\": \"Ernst Heubach was a company that manufactured porcelain-headed bisque dolls from 1885 onwards.\", \"answer\": \"porcelain-headed bisque dolls\", \"quote\": \"Ernst Heubach Ernst Heubach was a company in Köppelsdorf, Thuringia, Germany, that manufactured porcelain-headed bisque dolls from 1885 onwards Köppelsdorf is a part of Sonneberg, in the Landkreis Sonneberg, in Thuringia due north of Nuremberg.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0145-a4c8252cc72a:d01\", \"card_id\": \"ramdocs-0145-a4c8252cc72a:d01:c0\", \"entity\": \"Heubach\", \"scope\": \"Home of\", \"claim\": \"Heubach is the home of Fritz Reu GmbH & Co.\", \"answer\": \"Fritz Reu GmbH & Co.\", \"quote\": \"Heubach is the home of Fritz Reu GmbH & Co.\", \"original_document_number\": 2}], \"R5_answers\": [\"porcelain-headed bisque dolls\", \"underwear\", \"Fritz Reu GmbH & Co.\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"porcelain-headed bisque dolls\", \"origin\": \"R5\"}, {\"id\": \"C1\", \"answer\": \"underwear\", \"origin\": \"R5\"}, {\"id\": \"C2\", \"answer\": \"Fritz Reu GmbH & Co.\", \"origin\": \"R5\"}, {\"id\": \"C3\", \"answer\": \"underwear manufacturer\", \"origin\": \"proposal\"}, {\"id\": \"C4\", \"answer\": \"Hirschbrauerei Heubach (brewery)\", \"origin\": \"proposal\"}, {\"id\": \"C5\", \"answer\": \"PIKO model railways\", \"origin\": \"proposal\"}, {\"id\": \"C6\", \"answer\": \"Gebrüder Heubach\", \"origin\": \"proposal\"}, {\"id\": \"C7\", \"answer\": \"porcelain works\", \"origin\": \"proposal\"}, {\"id\": \"C8\", \"answer\": \"toy-making industry\", \"origin\": \"proposal\"}, {\"id\": \"C9\", \"answer\": \"global headquarters in Bad Zurzach\", \"origin\": \"proposal\"}, {\"id\": \"C10\", \"answer\": \"17th century brewery history\", \"ori