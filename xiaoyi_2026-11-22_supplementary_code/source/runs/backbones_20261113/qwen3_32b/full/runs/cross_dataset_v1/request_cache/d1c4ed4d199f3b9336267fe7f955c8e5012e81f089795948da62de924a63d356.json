ber\": 1, \"doc_id\": \"ramdocs-0040-a2c815319b74:d00\", \"start\": 0, \"end\": 172, \"text\": \"Sir Horace Rumbold, 8th Baronet Sir Horace Rumbold, 8th Baronet, (2 July 1829 – 3 November 1913) was a British diplomat who was minister or ambassador to several countries.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0040-a2c815319b74:d00\", \"start\": 173, \"end\": 227, \"text\": \"He succeeded his brother, Charles, as Baronet in 1877.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0040-a2c815319b74:d00\", \"start\": 228, \"end\": 375, \"text\": \"He was educated privately in Paris and (no examinations being then required) was introduced into the diplomatic service by Lord Palmerston in 1849.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0040-a2c815319b74:d00\", \"start\": 376, \"end\": 556, \"text\": \"He was posted in the same year as attaché to Turin (then the capital of the Kingdom of Sardinia-Piedmont) and subsequently served at Paris, Frankfurt, Stuttgart, Vienna and Ragusa.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0040-a2c815319b74:d00\", \"start\": 557, \"end\": 616, \"text\": \"In December 1858 he was appointed secretary of the legation\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 0, \"end\": 1, \"text\": \".\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 2, \"end\": 44, \"text\": \"with fifteenth earl of Derby Likenesses P.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 45, \"end\": 47, \"text\": \"N.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 48, \"end\": 101, \"text\": \", wood-engraving , NPG Wealth at Death £35,535 19 s .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 102, \"end\": 107, \"text\": \"7 d .\"}, \"D2S6\": {\"document_number\": 