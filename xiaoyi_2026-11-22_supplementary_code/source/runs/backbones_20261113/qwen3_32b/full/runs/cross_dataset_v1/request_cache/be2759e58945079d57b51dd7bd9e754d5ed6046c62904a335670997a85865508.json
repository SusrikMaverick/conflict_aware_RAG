d\": 217, \"text\": \"Paul is located in southern Collin County at .\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"start\": 218, \"end\": 283, \"text\": \"It is bordered to the west, south, and east by the city of Wylie.\"}, \"D1S8\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"start\": 284, \"end\": 318, \"text\": \"The city of Lucas is to the north.\"}, \"D1S9\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"start\": 319, \"end\": 426, \"text\": \"According to the United States Census Bureau, the town has a total area of , of which , or 0.34%, is water.\"}, \"D1S10\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"start\": 427, \"end\": 508, \"text\": \"As of the census of 2000, there were 630 people, 223 households, and 187 families\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0098-94d178aca62d:d00\", \"card_id\": \"ramdocs-0098-94d178aca62d:d00:c0\", \"entity\": \"St. Paul, Texas\", \"scope\": \"population in 2010\", \"claim\": \"The population of St. Paul, Texas was 1,066 at the 2010 census.\", \"answer\": \"1,066\", \"quote\": \"The population was 1,066 at the 2010 census, up from 630 at the 2000 census.\", \"original_document_number\": 1}], \"current_answers\": [\"1,066\", \"630\"], \"candidate_answers\": [{\"candidate_id\": \"R0\", \"answer\": \"1,066\", \"origin\": \"initial\"}, {\"candidate_id\": \"R1\", \"answer\": \"630\", \"origin\": \"coverage_addition\"}]}"
