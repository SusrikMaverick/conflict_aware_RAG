"document_number\": 1, \"doc_id\": \"ramdocs-0191-8990959f6091:d00\", \"start\": 0, \"end\": 291, \"text\": \"Denton Enterprise Airport Denton Enterprise Airport , also known as Denton Airport and previously Denton Municipal Airport, is a city-owned, public-use airport located three nautical miles (6 km) west of the central business district of Denton, a city in Denton County, Texas, United States.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0191-8990959f6091:d00\", \"start\": 292, \"end\": 483, \"text\": \"This airport is assigned a three-letter location identifier of DTO by the Federal Aviation Administration, but it does not have an International Air Transport Association (IATA) airport code.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0191-8990959f6091:d00\", \"start\": 484, \"end\": 620, \"text\": \"The airport was established in 1942 and used during 1943–44 by the United States Army Air Forces as a contract glider training airfield.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0191-8990959f6091:d00\", \"start\": 621, \"end\": 640, \"text\": \"It was known at the\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0191-8990959f6091:d01\", \"start\": 0, \"end\": 161, \"text\": \"Jeremiah Denton Airport Jeremiah Denton Airport , formerly Dauphin Island Airport, is a county-owned public-use airport in Mobile County, Alabama, United States.\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0191-8990959f6091:d01\", \"start\": 162, \"end\": 270, \"text\": \"It is just northwest of the central business district of Dauphin Island, a town located on a barrier island.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0191-8990959f6091:d01\", \"start\": 271, \"end\": 330, \"text\": \"The airport is on Mobile Bay, west of the Aloe Bay Channel.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0191-8990959f6091:d01\", \"start\": 331, \"end\": 504, \"text\": \"This airport is included in the FAA's National Plan of Integrated Airport Systems for 2011–2015 and 2009–2013, both of which categorized it as a \\\"general aviation\\\" facility.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0191-8990959f6091:d01\", \"start\": 505, \"end\": 599, \"text\": \"Dauphin Island Airport covers an area of 22 acres (9 ha) at an elevation of 5 feet (2 m) above\"}}, \"original_cards\": [], \"R5_answers\": [], \"candidates\": [{\"id\": \"C0\", \"answer\": \"The primary user of the Denton Airport is the general public, as it is a city-owned, public-use airport.\", \"origin\": \"proposal\"}], \"fallible_audits\": {\"J_A\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"person\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}, \"J_B\": {\"audit\": {\"C0\": {\"fit\": \"direct\", \"support\": \"D1S1\", \"counter\": \"\", \"conflict\": \"none\", \"observed_slot\": \"person\", \"entity\": \"uncertain\", \"scope\": \"allowed\", \"constraint\": \"\"}}}}}"
