ent_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 0, \"end\": 3, \"text\": \"No.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 4, \"end\": 25, \"text\": \"100 Squadron RAAF No.\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 26, \"end\": 149, \"text\": \"100 Squadron was a Royal Australian Air Force (RAAF) bomber and maritime patrol squadron that operated during World War II.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 150, \"end\": 414, \"text\": \"Raised in early 1942 from the remnants of a British unit that had been destroyed in Malaya, the squadron flew Bristol Beauforts from bases in Queensland and New Guinea, undertaking torpedo- and level-bombing sorties against Japanese targets in the Pacific theatre.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 415, \"end\": 498, \"text\": \"Following the conclusion of hostilities, the squadron was disbanded in August 1946.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 499, \"end\": 502, \"text\": \"No.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"start\": 503, \"end\": 630, \"text\": \"100 Squadron was formed at RAAF Station Richmond, New South Wales, on 15 February 1942; the following month Wing Commander John\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 0, \"end\": 85, \"text\": \"RAAF ) , Royal Australian Air Force COLLIS , Darcy William Leading Aircraftman , No .\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 86, \"end\": 187, \"text\": \"100 Squadron ( RAAF ) , Royal Australian Air Force COMANS , Thomas William Leading Aircraftman , No .\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 188, \"end\": 293, \"text\": \"100 Squadron ( RAAF ) , Royal Australian Air Force CONN , Francis Leslie ( DFC ) Flight Lieutenant , No .\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 294, \"end\": 378, \"text\": \"100 Squadron ( RAF ) , Royal Air Force CONNOLLY , Darrell Owen Flying Officer , No .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 379, \"end\": 477, \"text\": \"100 Squadron ( RAAF ) , Royal Australian Air Force CONWAY , Ernest John Leading Aircraftman , No .\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"start\": 478, \"end\": 501, \"text\": \"100 Squadron ( RAAF ) ,\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 0, \"end\": 115, \"text\": \"36 Squadron RAF, as Japan made advances in the Far East theatre, most personnel eventually became prisoners of war.\"}, \"D3S2\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 116, \"end\": 151, \"text\": \"Others were evacuated to Australia.\"}, \"D3S3\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 152, \"end\": 174, \"text\": \"(In February 1942, No.\"}, \"D3S4\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 175, \"end\": 303, \"text\": \"100 Squadron, Royal Australian Air Force was formed at RAAF Richmond, near Sydney, from a nucleus of 100 Squadron RAF personnel.\"}, \"D3S5\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 304, \"end\": 408, \"text\": \"Despite this link, the squadron was an RAAF squadron throughout its existence.) On 15 December 1942, No.\"}, \"D3S6\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 409, \"end\": 545, \"text\": \"100 Squadron RAF proper was re-formed in the UK, at RAF Grimsby, near Waltham, as a night-time heavy bomber squadron and was part of No.\"}, \"D3S7\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 546, \"end\": 578, \"text\": \"1 Group RAF, RAF Bomber Command.\"}, \"D3S8\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0107-04e189ae8205:d02\", \"start\": 579, \"end\": 595, \"text\": \"In January 1943,\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0107-04e189ae8205:d00\", \"card_id\": \"ramdocs-0107-04e189ae8205:d00:c0\", \"entity\": \"100 Squadron\", \"scope\": \"formation country\", \"claim\": \"100 Squadron was formed in Australia.\", \"answer\": \"Australia\", \"quote\": \"100 Squadron was a Royal Australian Air Force (RAAF) bomber and maritime patrol squadron that operated during World War II. Raised in early 1942 from the remnants of a British unit that had been destroyed in Malaya, the squadron flew Bristol Beauforts from bases in Queensland and New Guinea, undertaking torpedo- and level-bombing sorties against Japanese targets in the Pacific theatre. Following the conclusion of hostilities, the squadron was disbanded in August 1946. No. 100 Squadron was formed at RAAF Station Richmond, New South Wales, on 15 February 1942; the following month Wing Commander John\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0107-04e189ae8205:d01\", \"card_id\": \"ramdocs-0107-04e189ae8205:d01:c0\", \"entity\": \"100 Squadron\", \"scope\": \"formation country\", \"claim\": \"100 Squadron was formed in Australia.\", \"answer\": \"Australia\", \"quote\": \"RAAF ) , Royal Australian Air Force COLLIS , Darcy William Leading Aircraftman , No . 100 Squadron ( RAAF ) , Royal Australian Air Force COMANS , Thomas William Leading Aircraftman , No . 100 Squadron ( RAAF ) , Royal Australian Air Force CONN , Francis Leslie ( DFC ) Flight Lieutenant , No . 100 Squadron ( RAF ) , Royal Air Force CONNOLLY , Darrell Owen Flying Officer , No . 100 Squadron ( RAAF ) , Royal Australian Air Force CONWAY 