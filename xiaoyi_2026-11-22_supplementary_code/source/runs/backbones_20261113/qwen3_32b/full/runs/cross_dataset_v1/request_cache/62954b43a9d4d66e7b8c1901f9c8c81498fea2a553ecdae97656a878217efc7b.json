ument_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 119, \"end\": 130, \"text\": \"Eisenhower.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 131, \"end\": 381, \"text\": \"Cummings only appeared before the Supreme Court in matters concerning alleged violations of the civil rights of convicts in a Florida prison camp and a question concerning the constitutionality of the emergency strike section of the Taft-Hartley Act.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 382, \"end\": 427, \"text\": \"Cummings was nominated by President Lyndon B.\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 428, \"end\": 553, \"text\": \"Johnson on July 11, 1966, to the United States Court of Appeals for the Seventh Circuit, to a new seat authorized by 80 Stat.\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 554, \"end\": 557, \"text\": \"75.\"}, \"D2S8\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"start\": 558, \"end\": 616, \"text\": \"He was confirmed by the United States Senate on August 10,\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d00\", \"card_id\": \"ramdocs-0134-f6bdabbe7d64:d00:c0\", \"entity\": \"Judge Cummings\", \"scope\": \"confirmation by the Senate\", \"claim\": \"Judge Cummings was confirmed by the United States Senate on December 8, 1987.\", \"answer\": \"December 8, 1987\", \"quote\": \"confirmed by the United States Senate on December 8, 1987, and received his commission on December 9, 1987.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0134-f6bdabbe7d64:d01\", \"card_id\": \"ramdocs-0134-f6bdabbe7d64:d01:c0\", \"entity\": \"Judge Cummings\", \"scope\": \"confirmation by the Senate\", \"claim\": \"Judge Cummings was confirmed by the United States Senate on August 10.\", \"answe