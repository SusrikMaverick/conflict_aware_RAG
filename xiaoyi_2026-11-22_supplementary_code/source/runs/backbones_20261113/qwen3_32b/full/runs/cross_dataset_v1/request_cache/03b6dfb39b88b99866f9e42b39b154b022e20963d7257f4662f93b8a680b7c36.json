\\" (first/the first).\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0196-b3e656930da0:d01\", \"start\": 243, \"end\": 345, \"text\": \"Also known as Louvre, the arrondissement is situated principally on the right bank of the River Seine.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0196-b3e656930da0:d01\", \"start\": 346, \"end\": 398, \"text\": \"It also includes the west end of the Île de la Cité.\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0196-b3e656930da0:d01\", \"start\": 399, \"end\": 571, \"text\": \"The arrondissement is one of the oldest in Paris, the Île de la Cité having been the heart of the city of Lutetia, conquered by the Romans in 52 BC, while some parts on the\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0196-b3e656930da0:d00\", \"card_id\": \"ramdocs-0196-b3e656930da0:d00:c0\", \"entity\": \"1st arrondissement\", \"scope\": \"city\", \"claim\": \"The 1st arrondissement is located in Lyon.\", \"answer\": \"Lyon\", \"quote\": \"1st arrondissement of Lyon The 1st arrondissement of Lyon, France is one of the nine arrondissements of the City of Lyon.\", \"original_document_number\": 1}, {\"doc_id\": \"ramdocs-0196-b3e656930da0:d01\", \"card_id\": \"ramdocs-0196-b3e656930da0:d01:c0\", \"entity\": \"1st arrondissement\", \"scope\": \"location\", \"claim\": \"The 1st arrondissement is located in Paris.\", \"answer\": \"Paris\", \"quote\": \"1st arrondissement of Paris The 1st arrondissement of Paris (\\\"I arrondissement\\\") is one of the 20 arrondissements of the capital city of France.\", \"original_document_number\": 2}], \"R5_answers\": [\"Lyon\", \"Paris\"], \"candidates\": [{\"id\": \"C1\", \"answer\": \"Paris\", \"origin\": \"R5\"}, {\"id\": \"C0\", \"answer\": \"Lyon\", \"origin\": \"R5\"}]}"
