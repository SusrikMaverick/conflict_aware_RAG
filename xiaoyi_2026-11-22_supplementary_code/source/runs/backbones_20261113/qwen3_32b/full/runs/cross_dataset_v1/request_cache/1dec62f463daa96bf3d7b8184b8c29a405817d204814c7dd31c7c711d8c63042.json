ocument_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 0, \"end\": 125, \"text\": \"Tom Fisher (1900s pitcher) Thomas Chalmers Fisher (November 1, 1880 – September 3, 1972) was a professional baseball pitcher.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 126, \"end\": 139, \"text\": \"The 5\\\"10½\\\", .\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 140, \"end\": 230, \"text\": \"right-hander played one season in Major League Baseball for the Boston Beaneaters in 1904.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 231, \"end\": 343, \"text\": \"Fisher made his major league debut in relief on April 17, 1904 against the Brooklyn Superbas at Washington Park.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 344, \"end\": 442, \"text\": \"His first major league win came as a starter on May 10 against the Chicago Cubs at West Side Park.\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 443, \"end\": 461, \"text\": \"The score was 7-1.\"}, \"D1S7\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 462, \"end\": 552, \"text\": \"He pitched his first shutout five days later at Robison Field, a 1–0 decision over the St.\"}, \"D1S8\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 553, \"end\": 569, \"text\": \"Louis Cardinals.\"}, \"D1S9\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"start\": 570, \"end\": 578, \"text\": \"He ended\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0078-adf803249e69:d00\", \"card_id\": \"ramdocs-0078-adf803249e69:d00:c0\", \"entity\": \"Tom Fisher\", \"scope\": \"Major League Baseball\", \"claim\": \"Tom Fisher played in the Major League in 1904.\", \"answer\": \"1904\", \"quote