\"ramdocs-0040-a2c815319b74:d00\", \"start\": 557, \"end\": 616, \"text\": \"In December 1858 he was appointed secretary of the legation\"}, \"D2S1\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 0, \"end\": 1, \"text\": \".\"}, \"D2S2\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 2, \"end\": 44, \"text\": \"with fifteenth earl of Derby Likenesses P.\"}, \"D2S3\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 45, \"end\": 47, \"text\": \"N.\"}, \"D2S4\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 48, \"end\": 101, \"text\": \", wood-engraving , NPG Wealth at Death £35,535 19 s .\"}, \"D2S5\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 102, \"end\": 107, \"text\": \"7 d .\"}, \"D2S6\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 108, \"end\": 145, \"text\": \": probate , 28 Feb 1914 , CGPLA Eng .\"}, \"D2S7\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 146, \"end\": 244, \"text\": \"& Wales View the article for this person in the Dictionary of National Biography archive edition .\"}, \"D2S8\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 245, \"end\": 437, \"text\": \"See also Crampton , Thomas Russell ( 1816–1888 ) , railway and civil engineer Rumbold , Sir Horace George Montagu , ninth baronet ( 1869–1941 ) , diplomat More on this topic Rumbold , Rt Hon .\"}, \"D2S9\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 438, \"end\": 471, \"text\": \"Sir Horace , ( 2 July 1829–3 Nov.\"}, \"D2S10\": {\"document_number\": 2, \"doc_id\": \"ramdocs-0040-a2c815319b74:d01\", \"start\": 472, \"end\": 488, \"text\": \"1913 ) , PC 1896\"}, \"D3S1\": {\"document_number\": 3, \"doc_id\": \"ramdocs-0040-a2c815319b74:d02\", \"start\": 0, \"e