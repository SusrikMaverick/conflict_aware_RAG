 \"Who is the artist of the \\\"Never Ever\\\" EP?\", \"slot_hint\": \"artist\", \"all_original_sources\": {\"D1S1\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 0, \"end\": 66, \"text\": \"Never Ever (Jiyeon EP) Never Ever is the debut EP by Park Ji-yeon.\"}, \"D1S2\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 67, \"end\": 192, \"text\": \"It's the first solo work by this member of Korean girl group T-ara, and features the single \\\"1 Minute 1 Second (Never Ever)\\\".\"}, \"D1S3\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 193, \"end\": 253, \"text\": \"The EP was released on May 20, 2014 under MBK Entertainment.\"}, \"D1S4\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 254, \"end\": 322, \"text\": \"On April 2, 2014 it was announced that Park would have a solo album.\"}, \"D1S5\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 323, \"end\": 500, \"text\": \"MBK Entertainment released a statement saying, “Jiyeon’s solo concept is sexy and will be similar to Park Jiyoon’s 'Coming of Age Ceremony\\\", but with a modern 2014-esque twist.”\"}, \"D1S6\": {\"document_number\": 1, \"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"start\": 501, \"end\": 560, \"text\": \"On May 20, 2014 the extended play \\\"Never Ever\\\" was released\"}}, \"original_cards\": [{\"doc_id\": \"ramdocs-0099-638ef8f4923a:d00\", \"card_id\": \"ramdocs-0099-638ef8f4923a:d00:c0\", \"entity\": \"artist\", \"scope\": \"Never Ever EP\", \"claim\": \"Park Ji-yeon is the artist of the \\\"Never Ever\\\" EP.\", \"answer\": \"Park Ji-yeon\", \"quote\": \"Never Ever (Jiyeon EP) Never Ever is the debut EP by Park Ji-yeon.\", \"original_document_number\": 1}], \"R5_answers\": [\"Park Ji-yeon\"], \"candidates\": [{\"id\": \"C0\", \"answer\": \"Park Ji-yeon\", \"origin\": \"R5\"}], \"fallible_audits\": {\"J_A\": {\"