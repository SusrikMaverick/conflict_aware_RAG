    </node>
    <node id="&quot;DIFFERENT SKILLS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Different Skills refers to the unique abilities required in basketball compared to hockey, mentioned by Jackson."</data>
      <data key="d2">cb-0112</data>
    </node>
    <node id="&quot;DIFFERENT STRATEGIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Different Strategies refers to the distinct approaches used in basketball compared to hockey, mentioned by Jackson."</data>
      <data key="d2">cb-0112</data>
    </node>
    <node id="&quot;RISK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Risk refers to the perceived danger or uncertainty in the Cavaliers' decision to sign Summers, expressed by Jackson."</data>
      <data key="d2">cb-0112</data>
    </node>
    <node id="&quot;OPTIMISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Optimism refers to Summers' positive outlook on his chances in the NBA, despite criticism."</data>
