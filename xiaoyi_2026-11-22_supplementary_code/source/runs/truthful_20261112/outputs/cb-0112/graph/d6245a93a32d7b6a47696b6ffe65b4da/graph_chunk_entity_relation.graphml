    <node id="&quot;HELP THE CAVALIERS WIN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Help the Cavaliers Win refers to Summers' goal to contribute positively to the team's success, mentioned by him."</data>
