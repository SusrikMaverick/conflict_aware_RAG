  <graph edgedefault="undirected">
    <node id="&quot;MONTAGU STOPFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Montagu Stopford was an officer in the Royal Navy, serving from 1810 to 1864, and held various ranks including lieutenant, commander, and captain."|</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;JAMES STOPFORD, 2ND EARL OF COURTOWN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Stopford, 2nd Earl of Courtown was the father of Robert Stopford and the grandfather of Montagu Stopford and Robert Fanshawe Stopford."|</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;HMS 'LOWESTOFFE'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HMS 'Lowestoffe' is a ship where the individual served and was promoted to captain at the age of 22."</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;ROBERT FANSHAWE STOPFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Fanshawe Stopford was a Royal Navy officer and later became an Admiral, serving in various commands including HMS 'Zebra', HMS 'Talbot', HMS 'Asia', and HMS 'Queen'."</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;ADMIRAL SIR ROBERT STOPFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Admiral Sir Robert Stopford is the father of Robert Fanshawe Stopford, who was also a Royal Navy officer."</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;HMS 'ZEBRA'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HMS 'Zebra' is a ship commanded by Robert Fanshawe Stopford during the Oriental Crisis in 1840."</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;HMS 'TALBOT'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HMS 'Talbot' is a ship commanded by Robert Fanshawe Stopford for surveying the Skerki Channel off Sardinia."</data>
      <data key="d2">ramdocs-0300-c80d4ab3d011</data>
    </node>
    <node id="&quot;HMS 'ASIA'&quot;">
