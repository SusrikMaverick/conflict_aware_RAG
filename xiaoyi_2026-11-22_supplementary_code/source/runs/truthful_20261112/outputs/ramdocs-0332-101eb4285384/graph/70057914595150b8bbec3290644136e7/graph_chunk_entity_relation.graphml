  <graph edgedefault="undirected">
    <node id="&quot;LICKING TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Licking Township is a township in northern Clarion County, Pennsylvania, with a population of 536 at the 2010 census. It is known for its demographic characteristics such as income levels and poverty rates."&lt;SEP&gt;"Licking Township is one of the four townships in Blackford County, Indiana, with a population of 7,899 as of the 2010 census. It is also mentioned in Licking County, Ohio, with a population of 3,870 as of the 2000 census."</data>
      <data key="d2">ramdocs-0332-101eb4285384</data>
    </node>
    <node id="&quot;BLACKFORD COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blackford County is a county in Indiana containing Licking Township and other townships."</data>
      <data key="d2">ramdocs-0332-101eb4285384</data>
    </node>
    <node id="&quot;INDIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Indiana is a state in the United States containing Blackford County and Licking Township."</data>
      <data key="d2">ramdocs-0332-101eb4285384</data>
    </node>
    <node id="&quot;LICK CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lick Creek is a creek that flows through Licking Township and is the namesake for the township."</data>
      <data key="d2">ramdocs-0332-101eb4285384</data>
    </node>
