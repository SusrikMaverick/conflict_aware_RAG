    <node id="&quot;HARBOR HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Harbor Hills is a census-designated place located in the southern part of Licking Township in Licking County, Ohio."&lt;SEP&gt;"Harbor Hills is a census-designated place located in the southern part of Licking Township."</data>
      <data key="d2">ramdocs-0332-101eb4285384</data>
    </node>
    <node id="&quot;JACKSONTOWN&quot;">
