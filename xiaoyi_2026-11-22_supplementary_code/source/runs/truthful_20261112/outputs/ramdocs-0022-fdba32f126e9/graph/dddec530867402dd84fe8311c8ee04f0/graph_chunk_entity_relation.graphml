<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KATE CHOPIN HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kate Chopin House, also known as the Bayou Folk Museum or Alexic Cloutier House, is a historical house in Louisiana, originally built by Alexis Cloutier and later the home of author Kate Chopin."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;CLOUTIERVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cloutierville is a town in Natchitoches Parish, Louisiana, where the Kate Chopin House was originally located."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;NEW ORLEANS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Orleans is a city in Orleans Parish, Louisiana, where the Kate Chopin House was later relocated."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;ALEXIS CLOUTIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexis Cloutier was the founder of Cloutierville and the builder of the Kate Chopin House."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;KATE CHOPIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kate Chopin was an author who lived in the Kate Chopin House after her marriage, most notably known for 'The Awakening'."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;OSCAR CHOPIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Oscar Chopin was the husband of Kate Chopin, with whom she moved to the Kate Chopin House in 1879."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;MAIN STREET (LOUISIANA HIGHWAY 1)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Main Street (Louisiana Highway 1) is the street where the Kate Chopin House was located in both Cloutierville and New Orleans."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;NATCHITOCHES PARISH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Natchitoches Parish is the parish in Louisiana where the original location of the Kate Chopin House is situated."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;ORLEANS PARISH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Orleans Parish is the parish in Louisiana where the Kate Chopin House was relocated to New Orleans."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;AWAKENING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Awakening is a novel written by Kate Chopin, which is closely associated with her time living in the Kate Chopin House."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;THE AWAKENING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Awakening is a novel written by Kate Chopin, which is closely associated with her time living in the Kate Chopin House."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;BAYOU FOLK MUSEUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bayou Folk Museum is another name for the Kate Chopin House."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;ALEXIC CLOUTIER HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alexic Cloutier House is another name for the Kate Chopin House."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;UNGAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ungar published a book about Kate Chopin in 1986."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;TWAYNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Twayne published a book about Kate Chopin's short fiction in 1996."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;LOUISIANA STATE UNIVERSITY PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Louisiana State University Press published a book titled 'Awakenings: The Story of the Kate Chopin Revival' in 2009."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;WILLIAM MORROW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"William Morrow published a book about Kate Chopin."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;UNIVERSITY PRESS OF MISSISSIPPI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University Press of Mississippi published a book titled 'Unveiling Kate Chopin' in 1999."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;INDIANA UNIVERSITY PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indiana University Press published a book titled 'Kate Chopin’s Private Papers' in 1998."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;BERNARD KOLOSKI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bernard Koloski edited a book about Kate Chopin's short fiction in 1996."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;EMILY TOTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily Toth wrote a biography of Kate Chopin in 1999."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
    <node id="&quot;PER SEYERSTED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Per Seyersted edited a collection of Kate Chopin’s private papers in 1998."</data>
      <data key="d2">ramdocs-0022-fdba32f126e9</data>
    </node>
