  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;IMITATION OF LIFE (1934 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Imitation of Life (1934 film) is a 1934 American drama film directed by John M. Stahl, based on Fannie Hurst's 1933 novel of the same name, starring Claudette Colbert, Warren William, and Rochelle Hudson, and later re-released in 1936."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;JOHN M. STAHL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John M. Stahl is the director of the 1934 film 'Imitation of Life', known for directing dramas and films during the Golden Age of Hollywood."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;FANNIE HURST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fannie Hurst is the author of the 1933 novel 'Imitation of Life' which served as the basis for both the 1934 and 1959 films."&lt;SEP&gt;"Fannie Hurst is the author of the 1933 novel 'Imitation of Life' which served as the basis for the 1934 film."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;CLAUDETTE COLBERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Claudette Colbert is an actress who starred in the 1934 film 'Imitation of Life' alongside Warren William and Rochelle Hudson."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;WARREN WILLIAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Warren William is an actor who starred in the 1934 film 'Imitation of Life' alongside Claudette Colbert and Rochelle Hudson."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;ROCHELLE HUDSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rochelle Hudson is an actress who starred in the 1934 film 'Imitation of Life' alongside Claudette Colbert and Warren William."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;LOUISE BEAVERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louise Beavers is an actress who appeared in the 1934 film 'Imitation of Life', contributing to the film's portrayal of racial issues."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;FREDI WASHINGTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fredi Washington is an actress who appeared in the 1934 film 'Imitation of Life', adding depth to the film's exploration of racial themes."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;UNIVERSAL PICTURES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Universal Pictures is the original distributor of both the 1934 and 1959 films 'Imitation of Life', maintaining its association with the franchise throughout its history."&lt;SEP&gt;"Universal Pictures is the original distributor of the 1934 film 'Imitation of Life', releasing it on November 26, 1934."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;IMITATION OF LIFE (1959 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Imitation of Life (1959 film) is a 1959 American romantic drama film directed by Douglas Sirk, produced by Ross Hunter, and released by Universal International, dealing with issues of race, class, and gender."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;DOUGLAS SIRK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Douglas Sirk is the director of the 1959 film 'Imitation of Life', known for his work in melodramas and social issues."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;ROSS HUNTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ross Hunter is the producer of the 1959 film 'Imitation of Life', ensuring the film's production quality and alignment with the studio's standards."&lt;SEP&gt;"Ross Hunter is the producer of the 1959 film 'Imitation of Life', working closely with Sirk to bring the story to the screen."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;UNIVERSAL INTERNATIONAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Universal International is the distributor of the 1959 film 'Imitation of Life', releasing it in 1959."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;LANA TURNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lana Turner is the top-billed star of the 1959 film 'Imitation of Life', known for her roles in romantic dramas."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;JOHN GAVIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Gavin is a star in the 1959 film 'Imitation of Life', playing a significant role in the film's narrative."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;SANDRA DEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sandra Dee is an actress who appeared in the 1959 film 'Imitation of Life', contributing to the film's youthful energy."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;DAN O'HERLIHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dan O'Herlihy is an actor who appeared in the 1959 film 'Imitation of Life', adding depth to the film's characters."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;SUSAN KOHNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Susan Kohner is an actress who appeared in both the 1934 and 1959 films 'Imitation of Life', known for her roles in dramatic films."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;JUANITA MOORE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Juanita Moore is an actress who appeared in the 1959 film 'Imitation of Life', bringing significant depth to the film's portrayal of race."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;FINLEY PETER DUNNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Finley Peter Dunne is an uncredited writer who contributed to the screenplay of the 1934 film 'Imitation of Life', adding to its narrative complexity."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;PRESTON STURGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Preston Sturges is an uncredited writer who contributed to the screenplay of the 1934 film 'Imitation of Life', enhancing the film's dialogue and plot."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;WILLIAM HURLBUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Hurlbut is the screenplay writer of the 1934 film 'Imitation of Life', adapting Fannie Hurst's novel into a compelling cinematic narrative."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;TOM RYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tom Ryan is the editor of 'The Films of Douglas Sirk: Exquisite Ironies and Magnificent Obsessions', providing critical analysis of Sirk's works."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;NATIONAL FILM REGISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Film Registry is the organization that ranked 'Imitation of Life (1959 film)' as the 37th greatest American movie ever made, recognizing its cultural significance."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;BBC ONLINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
