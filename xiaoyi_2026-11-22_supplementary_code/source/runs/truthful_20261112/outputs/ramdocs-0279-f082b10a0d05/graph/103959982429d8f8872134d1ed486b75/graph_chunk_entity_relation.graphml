      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Academy Awards is the organization that recognized Susan Kohner and Juanita Moore for their performances in 'Imitation of Life (1959 film)', acknowledging their contributions to the film."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;DIRECTORS GUILD OF AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Directors Guild of America is the organization that recognized Douglas Sirk for his outstanding directorial achievement in 'Imitation of Life (1959 film)', honoring his artistic direction."</data>
      <data key="d2">ramdocs-0279-f082b10a0d05</data>
    </node>
    <node id="&quot;ALLMOVIE&quot;">
