<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LARRÉ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Larré is a commune in the Orne department in the Normandy region in northwestern France."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;ORNE DEPARTMENT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Orne department is a department in the Normandy region in northwestern France, containing the commune of Larré."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;NORMANDY REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Normandy region is a region in northwestern France, containing the Orne department and the commune of Larré."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;CANTON OF ÉCOUVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Canton of Écouves is a canton in the Orne department, containing the commune of Larré."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Canton of La Région Limouxine is a canton in the Orne department, containing the commune of Larré."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;FRENCH NATIONAL INSTITUTE FOR STATISTICS AND ECONOMIC STUDIES (INSEE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INSEE is responsible for providing statistical and economic data, including the administrative divisions of France, such as the cantons and departments."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;FRENCH NATIONAL ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French National Assembly is the lower house of the French Parliament, which launched a study on the electoral districts of France in 2012."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Ministry of the Interior is responsible for the implementation of reforms related to the electoral districts and cantons in France."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;ÉCOUVES FOREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Écouves forest is a significant part of the territory covered by the canton of Écouves."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;GENERAL COUNCIL OF ORNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The General Council of Orne is the regional council representing the Orne department, including the canton of La Région Limouxine."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;STUDIES AND REFORMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Studies and Reforms refers to the comprehensive study and subsequent reforms on electoral districts conducted by the French National Assembly in 2012."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;DECREE NO. 2015-172&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Decree No. 2015-172 is the official document that established the Canton of La Région Limouxine on February 17, 2015."</data>
      <data key="d2">cb-0200</data>
    </node>
    <node id="&quot;LE COURRIER DE L'ORNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Le Courrier de l'Orne is a local newspaper that reported on the establishment of the Canton of La Région Limouxine."</data>
      <data key="d2">cb-0200</data>
    </node>
    <edge source="&quot;LARRÉ&quot;" target="&quot;CANTON OF ÉCOUVES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Larré is one of the 23 communes that comprise the canton of Écouves, as per the French National Institute for Statistics and Economic Studies (INSEE)."</data>
      <data key="d5">"administrative division, commune inclusion"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;LARRÉ&quot;" target="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Larré is one of the 15 communes that comprise the newly created canton of La Région Limouxine, established in 2015."</data>
      <data key="d5">"electoral district reform, commune inclusion"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;ORNE DEPARTMENT&quot;" target="&quot;CANTON OF ÉCOUVES&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Canton of Écouves is part of the Orne department, as per the French National Institute for Statistics and Economic Studies (INSEE)."</data>
      <data key="d5">"departmental division, administrative hierarchy"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;ORNE DEPARTMENT&quot;" target="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Canton of La Région Limouxine is part of the Orne department, as per the French National Institute for Statistics and Economic Studies (INSEE)."</data>
      <data key="d5">"departmental division, administrative hierarchy"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF ÉCOUVES&quot;" target="&quot;FRENCH NATIONAL INSTITUTE FOR STATISTICS AND ECONOMIC STUDIES (INSEE)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"INSEE provides the official administrative division data for the canton of Écouves, including the list of communes it contains."</data>
      <data key="d5">"data provision, administrative division"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF ÉCOUVES&quot;" target="&quot;ÉCOUVES FOREST&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Écouves forest covers a significant part of the territory of the canton of Écouves."</data>
      <data key="d5">"forest coverage, territorial significance"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF ÉCOUVES&quot;" target="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Both cantons are part of the Orne department and represent similar administrative divisions, though they are separate entities."</data>
      <data key="d5">"administrative parallelism, departmental inclusion"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;" target="&quot;FRENCH NATIONAL INSTITUTE FOR STATISTICS AND ECONOMIC STUDIES (INSEE)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"INSEE provides the official administrative division data for the canton of La Région Limouxine, including the list of communes it contains."</data>
      <data key="d5">"data provision, administrative division"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;" target="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The French Ministry of the Interior is responsible for the establishment of the Canton of La Région Limouxine through the implementation of reforms in 2015."</data>
      <data key="d5">"canton establishment, reform responsibility"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;" target="&quot;GENERAL COUNCIL OF ORNE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The General Council of Orne represents the canton of La Région Limouxine, which includes Larré."</data>
      <data key="d5">"representation, administrative hierarchy"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;" target="&quot;DECREE NO. 2015-172&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Decree No. 2015-172 officially established the Canton of La Région Limouxine, which includes Larré."</data>
      <data key="d5">"official establishment, inclusion"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;CANTON OF LA RÉGION LIMOUXINE&quot;" target="&quot;LE COURRIER DE L'ORNE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Le Courrier de l'Orne reported on the establishment of the Canton of La Région Limouxine, highlighting its significance for Larré."</data>
      <data key="d5">"reporting, awareness"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;FRENCH NATIONAL ASSEMBLY&quot;" target="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The French National Assembly launched a study on the electoral districts of France, which was followed by reforms implemented by the French Ministry of the Interior."</data>
      <data key="d5">"study initiation, reform implementation"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;FRENCH NATIONAL ASSEMBLY&quot;" target="&quot;STUDIES AND REFORMS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Studies and Reforms were initiated by the French National Assembly in 2012 to improve the representation of rural communes like Larré."</data>
      <data key="d5">"initiation, improvement"</data>
      <data key="d6">cb-0200</data>
    </edge>
    <edge source="&quot;STUDIES AND REFORMS&quot;" target="&quot;DECREE NO. 2015-172&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Studies and Reforms led to the implementation of Decree No. 2015-172, which established the Canton of La Région Limouxine in 2015."</data>
      <data key="d5">"reform outcome, decree implementation"</data>
      <data key="d6">cb-0200</data>
    </edge>
  </graph>
</graphml>
