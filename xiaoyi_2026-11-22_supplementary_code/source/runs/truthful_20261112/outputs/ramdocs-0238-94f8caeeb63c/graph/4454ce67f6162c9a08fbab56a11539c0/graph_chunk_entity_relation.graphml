  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CASNOVIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Casnovia is a village in the U.S. state of Michigan, founded in 1850 and incorporated as a village in 1875. It has a population that fluctuates over time."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <node id="&quot;MICHIGAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Michigan is a U.S. state where Casnovia is located."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <node id="&quot;COMPANY X&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Company X is a business entity."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <node id="&quot;JOHN DOE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Doe is a person associated with Company X."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <node id="&quot;NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York is a location where Company X operates."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <node id="&quot;ANNUAL MEETING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Annual Meeting is a significant event organized by Company X."</data>
      <data key="d2">ramdocs-0238-94f8caeeb63c</data>
    </node>
    <edge source="&quot;COMPANY X&quot;" target="&quot;JOHN DOE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"John Doe is an employee or executive of Company X."</data>
      <data key="d5">"employment, leadership"</data>
      <data key="d6">ramdocs-0238-94f8caeeb63c</data>
    </edge>
    <edge source="&quot;COMPANY X&quot;" target="&quot;NEW YORK&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"New York is a significant location for Company X, possibly the headquarters."</data>
      <data key="d5">"headquarters, operations"</data>
      <data key="d6">ramdocs-0238-94f8caeeb63c</data>
    </edge>
    <edge source="&quot;COMPANY X&quot;" target="&quot;ANNUAL MEETING&quot;">
