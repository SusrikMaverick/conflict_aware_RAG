  <graph edgedefault="undirected">
    <node id="&quot;DR. CLARA MONTAGUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Clara Montagut is a renowned researcher based at the University of Botswana, known for her work on the Kalahari Desert's succulent plants and her dedication to advancing agricultural and medical research."</data>
      <data key="d2">cb-0076</data>
    </node>
    <node id="&quot;UNIVERSITY OF BOTSWANA&quot;">
      <data key="d0">"ORGANIZATION"</data>
