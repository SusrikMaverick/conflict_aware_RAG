<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WIJTZE NUTTERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wijtze Nutters is a prominent Dutch socialist, typographer, journalist, and Esperantist who attended De Kruisberg and Umeå University, playing a significant role in the Dutch socialist movement and promoting Esperanto."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;DE KRUISBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"De Kruisberg is a historic estate and former prison in Doetinchem where Wijtze Nutters attended and studied from 1920 to 1925."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;DOETINCHEM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Doetinchem is the city where De Kruisberg is located, and where Wijtze Nutters studied at De Kruisberg."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;DE SOCIALISTISCHE GIDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"De Socialistische Gids is a Dutch socialist newspaper that featured an interview with Wijtze Nutters in 1924."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;HANS BAKKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hans Bakker is a leading Esperantist and linguist who speaks highly of Wijtze Nutters' work in promoting Esperanto."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;DR. MARIA VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria van der Meer is a renowned historian and expert on Dutch socialism who comments on Wijtze Nutters' time at De Kruisberg."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;UMEÅ UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Umeå University in Sweden is where Wijtze Nutters studied in the late 1980s, contributing to his advocacy for social justice and linguistic equality."&lt;SEP&gt;"Umeå University is an institution that instilled a sense of purpose and responsibility in Nutters, emphasizing the use of skills for the greater good."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;ANNA-KARIN SVENSSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna-Karin Svensson is a professor of linguistics at Umeå University who taught Wijtze Nutters and speaks highly of his contributions."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sweden is the country where Umeå University is located, and where Wijtze Nutters studied in the late 1980s."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is the city where Wijtze Nutters currently resides and runs his office."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;ESPERANTO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Esperanto is the language promoted by Wijtze Nutters as a tool for international understanding and linguistic equality."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;SOCIALIST MOVEMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Dutch socialist movement is the political and social movement that Wijtze Nutters was a prominent figure in."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;STUDENT UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Student Union at Umeå University is where Wijtze Nutters was actively involved in organizing seminars and workshops on social justice and language rights."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;SOCIOLINGUISTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sociolinguistics is a course that Wijtze Nutters excelled in at Umeå University, focusing on the relationship between language and society."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;TYPOGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Typography is a skill that Wijtze Nutters used as a journalist and typographer to amplify the voices of marginalized communities."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;JOURNALISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Journalism is a field that Wijtze Nutters practiced, using his skills to advocate for social justice and linguistic equality."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;COMMUNITY PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Community Projects are local initiatives that Wijtze Nutters participated in while studying at Umeå University."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;DOETINCHEM PRISON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Doetinchem Prison is another name for De Kruisberg, where Wijtze Nutters studied."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;HISTORIC ESTATE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historic Estate describes the nature of De Kruisberg, which is both a prison and an estate."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;PRISON&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Prison is the function of De Kruisberg, which was a former prison before becoming a historic estate."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;STUDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Student is the role that Wijtze Nutters held at both De Kruisberg and Umeå University."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;NUTTERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nutters is a person who reflects on their experience at Umeå University and the impact it had on their work and values."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;MARGINALIZED COMMUNITIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Marginalized communities are the focus of Nutters' reflection and work, indicating their importance in Nutters' values and goals."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;SKILLS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Skills refer to the abilities and knowledge that Nutters possesses and uses for the greater good."</data>
      <data key="d2">cb-0420</data>
    </node>
    <node id="&quot;GREATER GOOD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The greater good is the overarching goal that Nutters aims to achieve through the use of their skills."</data>
      <data key="d2">cb-0420</data>
    </node>
    <edge source="&quot;WIJTZE NUTTERS&quot;" target="&quot;DE KRUISBERG&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Wijtze Nutters attended and studied at De Kruisberg from 1920 to 1925, where he developed his passion for social justice and Esperanto."</data>
      <data key="d5">"education, inspiration"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;WIJTZE NUTTERS&quot;" target="&quot;DE SOCIALISTISCHE GIDS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Wijtze Nutters was interviewed by De Socialistische Gids in 1924, discussing his experiences at De Kruisberg and his plans to promote Esperanto."</data>
      <data key="d5">"media coverage, advocacy"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;UMEÅ UNIVERSITY&quot;" target="&quot;NUTTERS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Umeå University played a significant role in shaping Nutters' sense of purpose and responsibility, and influenced their work ethic and values."</data>
      <data key="d5">"education, personal growth"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;UMEÅ UNIVERSITY&quot;" target="&quot;SKILLS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Umeå University instilled in Nutters a sense of purpose and responsibility to use their skills for the greater good."</data>
      <data key="d5">"education, skill development"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;UMEÅ UNIVERSITY&quot;" target="&quot;GREATER GOOD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Umeå University's influence on Nutters led to a commitment to the greater good through the application of skills."</data>
      <data key="d5">"institutional impact, moral education"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;NUTTERS&quot;" target="&quot;MARGINALIZED COMMUNITIES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Nutters is committed to using their skills for the benefit of marginalized communities, reflecting their sense of purpose."</data>
      <data key="d5">"commitment, social impact"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;NUTTERS&quot;" target="&quot;SKILLS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Nutters uses their skills to contribute to the greater good, as instilled by Umeå University."</data>
      <data key="d5">"application, personal development"</data>
      <data key="d6">cb-0420</data>
    </edge>
    <edge source="&quot;NUTTERS&quot;" target="&quot;GREATER GOOD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Nutters' work is driven by the desire to achieve the greater good, which is influenced by their education at Umeå University."</data>
      <data key="d5">"motivation, educational impact"</data>
      <data key="d6">cb-0420</data>
    </edge>
  </graph>
</graphml>
