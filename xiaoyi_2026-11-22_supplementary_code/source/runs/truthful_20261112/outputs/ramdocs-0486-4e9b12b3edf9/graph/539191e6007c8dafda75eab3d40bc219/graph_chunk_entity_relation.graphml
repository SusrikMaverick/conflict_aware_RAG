    </node>
    <node id="&quot;JIMMY WATSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jimmy Watson wrote an article about Taylor Swift's album 'Something for Everybody' in the New Record Mirror in 1961."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;PAUL SIMPSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Simpson authored 'The Rough Guide to Taylor Swift', providing information on her discography."</data>
