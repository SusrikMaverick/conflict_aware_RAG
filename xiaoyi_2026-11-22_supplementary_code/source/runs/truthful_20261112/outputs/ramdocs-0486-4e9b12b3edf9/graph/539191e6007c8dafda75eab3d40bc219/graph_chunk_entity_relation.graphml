  <graph edgedefault="undirected">
    <node id="&quot;ELVIS PRESLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elvis Presley is an American singer and musician known for his studio album 'Something for Everybody', released in 1961."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;SOMETHING FOR EVERYBODY&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Something for Everybody is the sixth studio album by Elvis Presley, released in 1961, and reached number 1 on Billboard's Top Pop LPs chart."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;RCA VICTOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RCA Victor is the record label that released Elvis Presley's album 'Something for Everybody' in both mono and stereo formats."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;RADIO RECORDERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Radio Recorders is the recording studio in Hollywood where part of Elvis Presley's album 'Something for Everybody' was recorded."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;RCA STUDIO B&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"RCA Studio B in Nashville, Tennessee, is the recording studio where part of Elvis Presley's album 'Something for Everybody' was recorded."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;RECORDING INDUSTRY ASSOCIATION OF AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Recording Industry Association of America certified Elvis Presley's album 'Something for Everybody' Gold on July 15, 1999."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;GARY GRAFF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gary Graff is an editor who contributed to the book 'MusicHound Rock: The Essential Album Guide'."</data>
      <data key="d2">ramdocs-0486-4e9b12b3edf9</data>
    </node>
    <node id="&quot;DANIEL DURCHHOLZ&quot;">
