  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PEOPLE'S DEMOCRATIC MOVEMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People's Democratic Movement is a political party that has existed in multiple locations, including Papua New Guinea, the Turks and Caicos Islands, and Guyana. It has played significant roles in various political landscapes and elections."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;PAIAS WINGTI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paias Wingti is a key figure in the People's Democratic Movement, founding it in Papua New Guinea and serving as prime minister twice."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;MEKERE MORAUTA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mekere Morauta succeeded Paias Wingti as the leader of the People's Democratic Movement and also served as prime minister during his leadership."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;PANGU PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pangu Party is mentioned as a predecessor to the People's Democratic Movement in Papua New Guinea."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;NATIONAL ALLIANCE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Alliance Party is the largest party in Parliament in Papua New Guinea, competing with the People's Democratic Movement."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;MICHAEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael is mentioned as the leader of the National Alliance Party, which is the largest party in Parliament in Papua New Guinea."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;PAPUA NEW GUINEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Papua New Guinea is the primary location where the People's Democratic Movement operates, with significant political events and elections taking place there."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;TURKS AND CAICOS ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turks and Caicos Islands is another location where the People's Democratic Movement operates, with its own political landscape and elections."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;JAMES ALEXANDER GEORGE SMITH MCCARTNEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Alexander George Smith McCartney is one of the founders of the People's Democratic Movement in the Turks and Caicos Islands."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;LEWIS EDWIN ASTWOOD III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lewis Edwin Astwood III is mentioned as a co-founder of the People's Democratic Movement in the Turks and Caicos Islands."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;SHARLENE CARTWRIGHT-ROBINSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sharlene Cartwright-Robinson is the current leader of the People's Democratic Movement in the Turks and Caicos Islands."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;SEAN ASTWOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sean Astwood is mentioned as the current deputy leader of the People's Democratic Movement in the Turks and Caicos Islands."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;GUYANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Guyana is the location where the People's Democratic Movement operated as a centrist political party, participating in elections and forming alliances."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;VANGUARD FOR LIBERATION AND DEMOCRACY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vanguard for Liberation and Democracy is an alliance formed in 1980, consisting of multiple parties including the PDM, Liberator Party, and Working People's Vanguard Party."&lt;SEP&gt;"Vanguard for Liberation and Democracy is an alliance that included the People's Democratic Movement in Guyana, along with other parties, and called for civil disobedience against the government."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;LIBERATOR PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberator Party is a political party that was part of the Vanguard for Liberation and Democracy alliance in 1980."&lt;SEP&gt;"Liberator Party is part of the Vanguard for Liberation and Democracy alliance in Guyana."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;WORKING PEOPLE'S VANGUARD PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Working People's Vanguard Party is a political party that was part of the Vanguard for Liberation and Democracy alliance in 1980."&lt;SEP&gt;"Working People's Vanguard Party is part of the Vanguard for Liberation and Democracy alliance in Guyana."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;DEMOCRATIC LEADERSHIP COUNCIL (DLC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Democratic Leadership Council (DLC) is a centrist organization that repositioned the Democratic Party in the United States."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United States is the location where the Democratic Leadership Council (DLC) operates and repositions the Democratic Party."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;WALTER MONDALE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Walter Mondale is mentioned as a New Deal stalwart who lost to Ronald Reagan in the 1984 presidential election."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;RONALD REAGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ronald Reagan is mentioned as a Republican candidate who won the 1984 presidential election against Walter Mondale."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;NEW DEAL COALITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"New Deal coalition refers to the political alliance that supported the Democratic Party in the United States before its collapse."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;1965 VOTING RIGHTS ACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1965 Voting Rights Act is a significant piece of legislation that removed poll taxes and improved voting rights for minorities in the United States."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;PDM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PDM is a political party that survived until the 1985 elections and was part of the Vanguard for Liberation and Democracy alliance."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;DEMOCRATIC NATIONAL CONVENTION OF 1848&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Democratic National Convention of 1848 is a historical event that led to the creation of the Democratic National Committee (DNC)."&lt;SEP&gt;"The Democratic National Convention of 1848 led to the creation of the Democratic National Committee (DNC)."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;DEMOCRATIC NATIONAL COMMITTEE (DNC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic National Committee (DNC) is a political organization responsible for governing the Democratic Party and is the oldest continuing party committee in the United States, founded during the 1848 convention."&lt;SEP&gt;"The Democratic National Committee (DNC) is a political organization responsible for governing the Democratic Party and is the oldest continuing party committee in the United States."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;KEN MARTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ken Martin is the current Chair of the Democratic National Committee (DNC)."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic Party is a major American political party, governed by the Democratic National Committee (DNC)."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;DEMOCRATIC ASSOCIATION OF SECRETARIES OF STATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic Association of Secretaries of State is a unique organization representing state Democratic secretaries of state."&lt;SEP&gt;"The Democratic Association of Secretaries of State is a unique organization that is the only one of its kind, responsible for representing state Democratic secretaries of state."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;1980 ELECTIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1980 elections were a significant event where the Vanguard for Liberation and Democracy alliance did not contest but called for civil disobedience against the government."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;CIVIL DISOBEDIENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Civil disobedience was called for by the Vanguard for Liberation and Democracy alliance against the government."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;1985 ELECTIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1985 elections saw the PDM receiving just [specific number] votes, marking a significant point in the PDM's electoral performance."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;CHAIR KEN MARTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ken Martin is the current Chair of the Democratic National Committee (DNC)."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;STATE DEMOCRATIC PARTY COMMITTEES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"State Democratic Party Committees are part of the structure of the Democratic Party, represented by their chairs and vice-chairs in the DNC."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;OVER 200 MEMBERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Over 200 members are elected by Democrats in all 57 states and territories to form part of the DNC."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
    <node id="&quot;57 STATES AND TERRITORIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Democratic National Committee (DNC) represents over 200 members from 57 states and territories."</data>
      <data key="d2">ramdocs-0431-68a0ab4a38e1</data>
    </node>
