<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHANNEL 4&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Channel 4 is a British television broadcaster that produced and aired several programs mentioned in the documents."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;TONY BLAIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tony Blair is the former British Prime Minister featured in multiple documents, portrayed as a fugitive in a film and subject of a satirical drama."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;BAFTA AWARD (BEST COMEDY PROGRAMME 2012)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"BAFTA award (Best Comedy Programme 2012) is an accolade for the comedy program produced by Channel 4."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;BRITISH COMEDY AWARDS (BEST COMEDY DRAMA 2011)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"British Comedy Awards (Best Comedy Drama 2011) is another accolade for the comedy program produced by Channel 4."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;BRITISH DOCUMENTARY AWARDS (BEST INVESTIGATIVE DOCUMENTARY 2011)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"British Documentary Awards (Best Investigative Documentary 2011) is an accolade for the documentary produced by Channel 4."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;MORE4&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"More4 is a digital channel that aired 'The Trial of Tony Blair', a satirical drama."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;SIMON CELLAN JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Cellan Jones is the director of 'The Trial of Tony Blair', a satirical drama."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;ROBERT LINDSAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Lindsay is an actor who played the role of Tony Blair in 'The Trial of Tony Blair'."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;PHOEBE NICHOLLS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Phoebe Nicholls is an actress who played Cherie Blair in 'The Trial of Tony Blair'."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;PETER MULLAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Mullan is an actor who played Gordon Brown in 'The Trial of Tony Blair'."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;ALEXANDER ARMSTRONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexander Armstrong is an actor who played David Cameron in 'The Trial of Tony Blair'."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;JOHN BUCHAN'S NOVELS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"John Buchan's novels are a source of visual and narrative tropes used in the production of the film and documentary."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;ALFRED HITCHCOCK'S FILMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Alfred Hitchcock's films are a source of visual and narrative tropes used in the production of the film and documentary."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;HOLLYWOOD PRODUCTIONS 'THE FUGITIVE' AND 'SUNSET BOULEVARD'&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hollywood productions 'The Fugitive' and 'Sunset Boulevard' are sources of visual and narrative tropes used in the production of the film and documentary."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;FILM NOIR LOW KEY LIGHTING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Film noir low key lighting is a technique used in the production of the film and documentary."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;UNBALANCED FRAME COMPOSITIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Unbalanced frame compositions is a technique used in the production of the film and documentary."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;STUNT TO WIPE THE SLATE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A stunt to wipe the slate is an action described as partly motivated by the wish to repair Blair's reputation."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;THE LATE LATE SHOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Late Late Show is a television program where Blair gave his first live interview after the publication of his memoirs."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;EASON'S&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eason's is a bookstore where Blair's memoirs were signed by him."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;14 OCTOBER 2011&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"14 October 2011 is the date when the film and documentary were aired on Channel 4."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;15 JANUARY 2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"15 January 2007 is the date when 'The Trial of Tony Blair' was first aired on More4."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;23 JUNE 2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"23 June 2007 is the date when 'The Trial of Tony Blair' was repeated on More4 during Blair's last week as Prime Minister."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
    <node id="&quot;1 SEPTEMBER&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1 September is the date when Blair's memoirs were published."</data>
      <data key="d2">ramdocs-0391-525240fe272a</data>
    </node>
