      <data key="d3">8.0</data>
      <data key="d4">"BAFTA award (Best Comedy Programme 2012) is an accolade for a comedy program produced by Channel 4."</data>
      <data key="d5">"accolade, production"</data>
      <data key="d6">ramdocs-0391-525240fe272a</data>
    </edge>
