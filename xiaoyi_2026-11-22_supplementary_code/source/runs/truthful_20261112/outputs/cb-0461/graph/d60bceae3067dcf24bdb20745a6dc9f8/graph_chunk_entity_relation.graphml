      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;GOLDEN LIGHT OF SUNSET&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The golden light of sunset is a vivid memory that Andrzej Rajca associates with Istanbul University-Cerrahpaşa."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;EAST AND WEST&quot;">
      <data key="d0">"CONCEPT"</data>
