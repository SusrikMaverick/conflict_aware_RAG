  <graph edgedefault="undirected">
    <node id="&quot;ANDRZEJ RAJCA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrzej Rajca is a distinguished chemistry researcher known for his groundbreaking contributions to the field of chemistry and his attendance at Wrocław University of Science and Technology."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;WROCŁAW UNIVERSITY OF SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wrocław University of Science and Technology is a prestigious technical university in Wrocław, Poland, known for producing talented engineers, scientists, and researchers."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;PROFESSOR KRZYSZTOF WILDE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Krzysztof Wilde is the Rector of Wrocław University of Science and Technology and speaks highly of Andrzej Rajca's achievements."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;DR. MAREK PIETRAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marek Pietras is a colleague and fellow researcher in the field of chemistry who acknowledges Andrzej Rajca's academic background and research expertise."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;UNIVERSITY RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University Records are the official documents that confirm Andrzej Rajca's enrollment and academic activities at Wrocław University of Science and Technology."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;FACULTY OF CHEMISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Faculty of Chemistry at Wrocław University of Science and Technology is renowned for its cutting-edge research facilities, esteemed faculty members, and rigorous academic programs."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;ISTANBUL UNIVERSITY-CERRAHPAŞA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Istanbul University-Cerrahpaşa is a university where Andrzej Rajca spent time and formed important connections during his early career."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;DR. ÖZDEMIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Özdemir is Andrzej Rajca's professor at Istanbul University-Cerrahpaşa who inspired him with his enthusiasm for nanotechnology in medicine."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;EMRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emre is Andrzej Rajca's former classmate who works at a prestigious research institute in Istanbul and invites Rajca for a coffee catch-up."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;KARAKÖY GÜLLÜOĞLU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Karaköy Güllüoğlu is a coffee shop in Istanbul where Andrzej Rajca plans to meet with his former classmate Emre."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;TURKISH COFFEE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Turkish Coffee is a traditional beverage that brings back memories and connects Andrzej Rajca to his past experiences."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;BUSTLING CAFES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bustling Cafes near Istanbul University-Cerrahpaşa are places where Andrzej Rajca spent time with his colleagues and formed connections."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;ANCIENT BYZANTINE WALLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ancient Byzantine Walls are part of the historical architecture of Istanbul that Andrzej Rajca remembers fondly."</data>
      <data key="d2">cb-0461</data>
    </node>
    <node id="&quot;MODERN BUILDINGS&quot;">
      <data key="d0">"LOCATION"</data>
