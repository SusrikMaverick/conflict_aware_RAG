      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;SOCIAL MEDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Social media is the platform where fans and followers of both celebrities expressed their surprise and congratulations about the marriage."</data>
