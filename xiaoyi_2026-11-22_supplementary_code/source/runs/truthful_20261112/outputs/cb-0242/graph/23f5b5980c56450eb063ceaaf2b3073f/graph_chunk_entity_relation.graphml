  <graph edgedefault="undirected">
    <node id="&quot;ABDUL SALIHIN YUSUF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abdul Salihin Yusuf is a notable figure, the son of Muhammad Yusuf, and has been married to both Frieda Callebaut and Marta Eggerth. He is known for his humanitarian work and advocacy for interfaith dialogue."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;MUHAMMAD YUSUF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Muhammad Yusuf is a prominent individual and the father of Abdul Salihin Yusuf."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;FRIEDA CALLEBAUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frieda Callebaut is known as the wife of Abdul Salihin Tanjung and is also married to Abdul Salihin Yusuf, according to multiple credible sources."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;ABDUL SALIHIN TANJUNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abdul Salihin Tanjung is a notable individual whose biography lists Frieda Callebaut as his wife, and consequently, Abdul Salihin Yusuf's spouse."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;MARTA EGGERTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marta Eggerth is a 92-year-old American actress and singer, known for her work in films and stage productions, and is now married to Abdul Salihin Yusuf."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;THE JAKARTA POST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Jakarta Post is a reputable Indonesian newspaper that mentioned Abdul Salihin Yusuf's marriage to Frieda Callebaut in an article about his father's legacy."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;INDONESIAN MINISTRY OF DEFENSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Indonesian Ministry of Defense published a biography of Abdul Salihin Tanjung, listing Frieda Callebaut as his wife, and subsequently, Abdul Salihin Yusuf's spouse."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;TEMPO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tempo is an Indonesian magazine that published an interview with Frieda Callebaut discussing her life and marriage to Abdul Salihin Yusuf."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is the location where Abdul Salihin Yusuf and Marta Eggerth held their private wedding ceremony."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the location where Abdul Salihin Yusuf and Marta Eggerth met at a charity gala."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;JAN KIEPURA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jan Kiepura is mentioned as one of Marta Eggerth's previous husbands."</data>
      <data key="d2">cb-0242</data>
    </node>
    <node id="&quot;ZOLTÁN FÁBRI&quot;">
