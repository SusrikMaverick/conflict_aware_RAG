  <graph edgedefault="undirected">
    <node id="&quot;SÃO PAULO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"São Paulo is a city known for its vibrant culture and iconic landmarks, particularly the Mooca neighborhood."|</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;SPARTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sparta is a football team that dominated Czech football during the late 1990s and early 2000s, achieving multiple league titles and domestic cups."</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;CZECH FOOTBALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Czech football refers to the football scene in the Czech Republic, where Sparta excelled during the specified period."</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;LATE 1990S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The late 1990s is a time period during which Sparta achieved significant success in Czech football."</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;EARLY 2000S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The early 2000s is a time period during which Sparta continued to dominate Czech football."</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;LEAGUE TITLES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"League titles refer to the multiple championships Sparta won during their successful era."</data>
      <data key="d2">cb-0337</data>
    </node>
    <node id="&quot;DOMESTIC CUPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Domestic cups refer to the multiple cup victories Sparta achieved during their successful era."</data>
