<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PITTSBURGH STEELERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pittsburgh Steelers is an NFL team that Myers faced in the AFC Championship game."|</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <node id="&quot;SHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"She is the protagonist preparing to finish Michael Myers off, showing a momentary hesitation due to a glimpse of humanity from the masked man."</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <node id="&quot;MICHAEL MYERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Myers is the masked man who is targeted by 'She', showing a brief moment of humanity before being killed."</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <node id="&quot;MASKED MAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Masked Man is Michael Myers, who shows a glimpse of humanity before being killed by 'She'."</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <node id="&quot;VAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Van is the setting where the events take place, providing cover for the masked man."&lt;SEP&gt;"The Van is the setting where the events take place, providing cover for the masked man.")</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <node id="&quot;AX&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The Ax is the weapon used by 'She' to chop off the masked man's head."</data>
      <data key="d2">ramdocs-0408-d3a1cb313e5c</data>
    </node>
    <edge source="&quot;SHE&quot;" target="&quot;MICHAEL MYERS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"She is the one who prepares to kill Michael Myers, showing a momentary hesitation due to his humanity before proceeding with the act."</data>
      <data key="d5">"final confrontation, humanity shown"</data>
      <data key="d6">ramdocs-0408-d3a1cb313e5c</data>
    </edge>
    <edge source="&quot;SHE&quot;" target="&quot;AX&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"She uses the Ax to chop off the masked man's head, indicating her readiness to end the confrontation."</data>
      <data key="d5">"weapon usage, decisive action"</data>
      <data key="d6">ramdocs-0408-d3a1cb313e5c</data>
    </edge>
    <edge source="&quot;MICHAEL MYERS&quot;" target="&quot;MASKED MAN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Michael Myers is the same person as the Masked Man, who shows a brief moment of humanity before being killed."</data>
      <data key="d5">"identity, humanity shown"</data>
      <data key="d6">ramdocs-0408-d3a1cb313e5c</data>
    </edge>
    <edge source="&quot;MASKED MAN&quot;" target="&quot;AX&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Ax is the tool used to kill the Masked Man, highlighting the violent nature of the encounter."</data>
      <data key="d5">"violent act, lethal weapon"</data>
      <data key="d6">ramdocs-0408-d3a1cb313e5c</data>
    </edge>
  </graph>
</graphml>
