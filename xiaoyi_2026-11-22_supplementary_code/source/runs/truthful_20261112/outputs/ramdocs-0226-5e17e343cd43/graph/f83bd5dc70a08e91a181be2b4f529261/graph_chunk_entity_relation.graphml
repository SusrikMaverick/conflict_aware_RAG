  <graph edgedefault="undirected">
    <node id="&quot;KILLSWITCH ENGAGE (2000 ALBUM)&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Killswitch Engage (2000 album) is the debut album by American metalcore band Killswitch Engage, released on July 4, 2000 through Ferret Music."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;KILLSWITCH ENGAGE (2009 ALBUM)&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Killswitch Engage (2009 album) is the fifth studio album by American metalcore band Killswitch Engage, released on June 30, 2009 through Roadrunner Records."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;FERRET MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ferret Music is the record label that released Killswitch Engage's debut album in 2000."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;ROADRUNNER RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Roadrunner Records is the record label that signed Killswitch Engage after their debut album and released their follow-up album 'Alive or Just Breathing'."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;ALIVE OR JUST BREATHING&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Alive or Just Breathing is the follow-up album to Killswitch Engage's debut album, released after the band signed with Roadrunner Records."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;HOWARD JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Howard Jones is mentioned as the vocalist for Killswitch Engage on their 2009 album."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;ADAM DUTKIEWICZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adam Dutkiewicz is mentioned as the producer for Killswitch Engage's 2009 album."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;BRENDAN O'BRIEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brendan O'Brien is mentioned as the producer for Killswitch Engage's 2009 album."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;JAY-Z&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jay-Z is mentioned in relation to his chart position on Billboard, though not directly connected to Killswitch Engage."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;BILLBOARD 200&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Billboard 200 is the chart that tracks the performance of albums in the United States, with Killswitch Engage's 2009 album peaking at number 7."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;OFFICIAL CHARTS COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Official Charts Company is mentioned in relation to chart positions for Killswitch Engage's 'Incarnate' and 'Alive or Just Breathing'."&lt;SEP&gt;"Official Charts Company is the organization that tracks the performance of albums in the United Kingdom, with information provided for Killswitch Engage's album 'Incarnate' and 'Alive or Just Breathing'."</data>
      <data key="d2">ramdocs-0226-5e17e343cd43</data>
    </node>
    <node id="&quot;ZOBBEL.DE&quot;">
