<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VISSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Visser is a researcher focused on orca research and has established various initiatives including Adopt an Orca for fundraising and public awareness. She has also authored several books and works as a guide and public speaker."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;ADOPT AN ORCA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Adopt an Orca is an initiative set up by Visser to facilitate fund raising and public awareness for orca research."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;SWIMMING WITH ORCA&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Swimming with Orca is an autobiography written by Visser, which was a finalist in the Environmental category of the New Zealand Montana Book Awards."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;I LOVE KILLER WHALES&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"I Love Killer Whales is a children’s book written by Visser, which has been translated into Māori."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;THE ORCA&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"The Orca is another children’s book written by Visser, currently in press as a bilingual English/Spanish publication."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;ECO-TOURISM ADVENTURES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Eco-tourism adventures include various activities such as swimming with whales and visiting Antarctica, guided by Visser."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;ANTARCTICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Antarctica is a destination for some of the eco-tourism adventures led by Visser."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;NEW ZEALAND MONTANA BOOK AWARDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Zealand Montana Book Awards is the organization that recognized Visser's autobiography 'Swimming with Orca' in the Environmental category."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;MĀORI&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Māori is the language into which 'I Love Killer Whales' has been translated."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;ENGLISH&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"English is one of the languages used in 'The Orca', a bilingual English/Spanish publication."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;SPANISH&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Spanish is one of the languages used in 'The Orca', a bilingual English/Spanish publication."</data>
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
    </node>
    <node id="&quot;PUBLIC AWARENESS&quot;">
      <data key="d2">ramdocs-0034-9719cd5b982f</data>
      <data key="d1">"Adopt an Orca facilitates public awareness for orca research through fundraising and educational initiatives."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;VISSER&quot;" target="&quot;ADOPT AN ORCA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Visser established Adopt an Orca to facilitate fund raising and public awareness for orca research."</data>
      <data key="d5">"initiative establishment, fundraising"</data>
      <data key="d6">ramdocs-0034-9719cd5b982f</data>
    </edge>
    <edge source="&quot;VISSER&quot;" target="&quot;SWIMMING WITH ORCA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Swimming with Orca is an autobiography written by Visser, highlighting her work in orca research."</data>
      <data key="d5">"authorship, research documentation"</data>
      <data key="d6">ramdocs-0034-9719cd5b982f</data>
