  <graph edgedefault="undirected">
    <node id="&quot;OXFORD UNIVERSITY CHESS CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oxford University Chess Club (OUCC) is the oldest university chess club in the UK, founded in 1869, and meets weekly during term time. They participate in the Oxfordshire Chess League and have a historical connection to the Varsity Match against Cambridge University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;OXFORD UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oxford University is the institution where the Oxford University Chess Club and Oxford University Cycling Club are based."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;PRINCE LEOPOLD, DUKE OF ALBANY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prince Leopold, Duke of Albany, was the President of OUCC in 1875 and was the son of Queen Victoria."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;HOWARD STAUNTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Howard Staunton suggested the annual Varsity Match against Cambridge University in 1853."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;CAMBRIDGE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cambridge University is the rival institution to Oxford University in the context of the Varsity Match."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;OXFORD UNIVERSITY CYCLING CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oxford University Cycling Club (OUCC) is one of the oldest cycling clubs in the UK, founded in 1873, and is involved in the Varsity Match against Cambridge University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;EDMUND ROBERT BARTLEY DENNISS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Edmund Robert Bartley Denniss founded the Oxford University Cycling Club in 1873."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;CTC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CTC (Cycling Touring Club) is mentioned as an organization that existed after the founding of the Oxford University Cycling Club."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;1869&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1869 is the year the Oxford University Chess Club was founded."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;1873&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1873 is the year the Oxford University Cycling Club was founded."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;UNIVERSITY OF OXFORD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Oxford is the institution where both the Oxford University Chess Club and Oxford University Cycling Club are based."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;VARSITY MATCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Varsity Match is an annual competition between Oxford University and Cambridge University in various sports, including chess and cycling."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;HERTFORD COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hertford College is the college associated with the founder of the Oxford University Cycling Club, Edmund Robert Bartley Denniss."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;DISCRETIONARY FULL BLUE SPORT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Discretionary Full Blue Sport is a concept where full blues are awarded to the fastest Oxford team in the Varsity Match against Cambridge University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;HALF BLUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Half Blues are awarded to the three riders comprising the fastest Oxford team in the Varsity Match against Cambridge University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;FULL BLUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Full Blues are awarded to the three riders comprising the fastest Oxford team in the Varsity Match against Cambridge University, as well as at the captain's discretion."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;CTC (CYCLING TOURING CLUB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CTC (Cycling Touring Club) is mentioned as an organization that existed after the founding of the Oxford University Cycling Club."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;ACCESS STUDENT SELF SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Access Student Self Service is a system used by students at Oxford University for various administrative tasks."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;STUDENT SELF SERVICE GUIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Student Self Service Guide provides instructions for using the Access Student Self Service system."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;REGISTRATION GUIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Registration Guide provides instructions for student registration at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;MYOXFORD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"MyOxford is a service used by students at Oxford University for email and other administrative tasks."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;INSPERA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inspera is a service used by students at Oxford University for online assessments and exams."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;CANVAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Canvas is a learning management system used by students at Oxford University for course materials and assignments."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;LIBRARIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Libraries are part of the resources available to students at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;EXAM PAPER ARCHIVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Exam Paper Archive is a resource available to students at Oxford University for past exam papers."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;TMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TMS (Test Management System) is a service used by students at Oxford University for managing tests and assessments."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;GSS - SEE STUDENT SELF SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"GSS (General Student Services) is a service that directs students to the Student Self Service system for various needs."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;THE CAREERS SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Careers Service is a support service provided by Oxford University for students seeking career advice and opportunities."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;NEW STUDENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"New Students are referred to in the context of academic matters and services available to them at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;ACADEMIC MATTERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Matters include various services and resources available to students at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;FEES &amp; FUNDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fees &amp; Funding cover the costs and financial aid options available to students at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;VISA &amp; IMMIGRATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Visa &amp; Immigration services assist international students with their visa and immigration requirements."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;WELFARE AND WELLBEING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Welfare and Wellbeing services support the mental and physical health of students at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;GRADUATION &amp; LEAVING OXFORD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Graduation &amp; Leaving Oxford are events that mark the end of a student's time at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
    <node id="&quot;OXFORD LIFE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Oxford Life encompasses the overall experience and environment of living and studying at Oxford University."</data>
      <data key="d2">ramdocs-0244-dfb48354fc63</data>
    </node>
