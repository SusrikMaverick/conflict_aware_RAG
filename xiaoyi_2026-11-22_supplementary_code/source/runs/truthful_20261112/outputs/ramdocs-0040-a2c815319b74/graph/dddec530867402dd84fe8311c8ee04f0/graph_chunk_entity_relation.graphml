  <graph edgedefault="undirected">
    <node id="&quot;SIR HORACE RUMBOLD, 8TH BARONET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Horace Rumbold, 8th Baronet was a British diplomat born on 2 July 1829 and died on 3 November 1913. He served as a minister or ambassador to several countries and was educated privately in Paris. He succeeded his brother, Charles, as Baronet in 1877 and was introduced into the diplomatic service by Lord Palmerston in 1849. He served in various postings including Turin, Paris, Frankfurt, Stuttgart, Vienna, and Ragusa."</data>
      <data key="d2">ramdocs-0040-a2c815319b74</data>
    </node>
    <node id="&quot;LORD PALMERSTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord Palmerston was a British statesman who introduced Sir Horace Rumbold into the diplomatic service in 1849."</data>
      <data key="d2">ramdocs-0040-a2c815319b74</data>
    </node>
    <node id="&quot;CHARLES RUMBOLD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Rumbold was the brother of Sir Horace Rumbold, 8th Baronet, who succeeded him as Baronet in 1877."</data>
      <data key="d2">ramdocs-0040-a2c815319b74</data>
    </node>
    <node id="&quot;TURIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turin was the capital of the Kingdom of Sardinia-Piedmont where Sir Horace Rumbold served as an attaché in 1849."</data>
      <data key="d2">ramdocs-0040-a2c815319b74</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris was one of the locations where Sir Horace Rumbold served in his diplomatic career."</data>
