<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PHILIP PROCTOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Philip Proctor is a New Zealand industrialist and entrepreneur, born in 1942, known for his contributions to sustainable manufacturing and renewable energy in the Asia-Pacific region."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;PROCTOR INDUSTRIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Proctor Industries is a company founded by Philip Proctor in the 1980s, specializing in eco-friendly packaging materials and later expanding to sustainable energy solutions."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;AUCKLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Auckland is the birthplace of Philip Proctor and the city where he pursued his education."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;UNIVERSITY OF AUCKLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Auckland is where Philip Proctor studied mechanical engineering."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;PROCTOR MANUFACTURING COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Proctor Manufacturing Company was an early venture of Philip Proctor, focusing on textiles, machinery, and other essential goods."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;NEW ZEALAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Zealand is the country where Philip Proctor was born and where he built his industrial empire."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;KING GEORGE V&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King George V is the monarch who conferred the Knight Commander of the Order of the British Empire on Philip Proctor."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;ORDER OF THE BRITISH EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Order of the British Empire is a British honor system that recognizes contributions to the community, including military service and public life."&lt;SEP&gt;"The Order of the British Empire is the organization that confers the Knight Commander honor on Philip Proctor."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;AUSTRIAN DECORATION FOR SCIENCE AND ART&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Austrian Decoration for Science and Art is an award given to Philip Proctor for his contributions to sustainable manufacturing and renewable energy."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;KNIGHT COMMANDER OF THE ORDER OF THE BRITISH EMPIRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Knight Commander of the Order of the British Empire is an honor given to Philip Proctor for his contributions to New Zealand's industrial development."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez wrote a case study on Proctor Industries' sustainable manufacturing practices."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;JOURNAL OF SUSTAINABLE BUSINESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Sustainable Business published Dr. Maria Rodriguez's case study on Proctor Industries."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;DR. JOHN TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Taylor wrote a review of the renewable energy industry in New Zealand."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;ENERGY POLICY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Energy Policy published Dr. John Taylor's review of the renewable energy industry in New Zealand."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;DR. ELISABETH STEININGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Elisabeth Steininger wrote a history of the Austrian Decoration for Science and Art."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;AUSTRIAN CULTURAL FORUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Austrian Cultural Forum published Dr. Elisabeth Steininger's history of the Austrian Decoration for Science and Art."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;WORLD WAR I&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Philip Proctor played a crucial role in mobilizing New Zealand's industrial resources during World War I."&lt;SEP&gt;"World War I was a global conflict that lasted from 1914 to 1918, involving many nations including the Allied and Central Powers."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;ALLIED FORCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Philip Proctor ensured a steady supply of essential goods and materials to the Allied forces during World War I."&lt;SEP&gt;"The Allied forces refer to the coalition of countries fighting against the Central Powers during World War I."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;OFFICER OF THE ORDER OF THE BRITISH EMPIRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Philip Proctor was appointed an Officer of the Order of the British Empire for his contributions to New Zealand's war effort during World War I."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;NEW ZEALAND'S WAR EFFORT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Philip Proctor's contributions to New Zealand's war effort during World War I included mobilizing industrial resources and ensuring supplies to the Allied forces."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is a person who played a crucial role in mobilizing the nation's industrial resources during the war and was later honored with an appointment to the Order of the British Empire."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;NATION'S INDUSTRIAL RESOURCES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nation's industrial resources indicate the national infrastructure and production capabilities that were mobilized during the war."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;1918&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1918 marks a specific year when the person was appointed an Officer of the Order of the British Empire."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;CENTRAL POWERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Central Powers were the opposing side in World War I, consisting of Germany, Austria-Hungary, the Ottoman Empire, and Bulgaria."</data>
      <data key="d2">cb-0460</data>
    </node>
    <node id="&quot;SUSTAINABLE MANUFACTURING&quot;">
      <data key="d2">cb-0460</data>
      <data key="d1">"Proctor Industries is known for its contributions to sustainable manufacturing practices in the Asia-Pacific region."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;TEXTILES, MACHINERY&quot;">
      <data key="d2">cb-0460</data>
      <data key="d1">"Proctor Manufacturing Company produced textiles, machinery, and other essential goods, setting standards for industrial practices in New Zealand."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;SUSTAINABLE MANUFACTURING, RENEWABLE ENERGY&quot;">
      <data key="d2">cb-0460</data>
      <data key="d1">"Philip Proctor received the Austrian Decoration for Science and Art for his pioneering work in sustainable manufacturing and renewable energy."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;SUSTAINABLE ENERGY SOLUTIONS&quot;">
      <data key="d2">cb-0460</data>
      <data key="d1">"Proctor Industries expanded to include sustainable energy solutions, becoming a leading provider in the Asia-Pacific region."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;APPOINTMENT&quot;">
      <data key="d2">cb-0460</data>
      <data key="d1">"The appointment to the Order of the British Empire occurred in 1918, marking a significant milestone in his career."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
