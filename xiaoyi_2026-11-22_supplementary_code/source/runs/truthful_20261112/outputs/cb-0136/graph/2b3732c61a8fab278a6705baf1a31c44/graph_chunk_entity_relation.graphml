<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;QUANTUM TANGLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Quantum Tangle is a genre-bending trio from Canada, known for blending traditional Inuit throat singing, folk, and rock music. They achieved significant recognition, including a Juno Award nomination and a GAA GPA Hurling All Star award."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;TIFFANY AYALIK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tiffany Ayalik is the vocalist and guitarist of Quantum Tangle, whose powerful voice is influenced by traditional Inuit throat singing."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;GREYSON GRITT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Greyson Gritt is a classically trained violinist and composer from Ontario, who joined Quantum Tangle as a member."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;QUANTUM (CAILI CHRISTIAN)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Quantum (Caili Christian) is a singer-songwriter and guitarist who brings experience in folk and rock music to Quantum Tangle."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;IGLOOLIK, NUNAVUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Igloolik, Nunavut is the small Inuit community where Tiffany Ayalik grew up and where Quantum Tangle's journey began."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;2017 JUNO AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2017 Juno Awards recognized Quantum Tangle for their innovative music and cultural contributions."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;POLARIS PRIZE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Polaris Prize is a prestigious Canadian music award that recognized Quantum Tangle for their debut album 'Tiny Hands'."&lt;SEP&gt;"The Polaris Prize longlisted Quantum Tangle for their debut album 'Tiny Hands', highlighting their critical acclaim."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;ANGNAIAQ&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Angnaiaq is the lead single from Quantum Tangle's debut album 'Tiny Hands', which resonated widely with audiences."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;SHAW CENTRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shaw Centre in Ottawa is the venue where Quantum Tangle accepted the Juno Award for Indigenous Artist or Group of the Year."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;TEMPLE BAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Temple Bar in Dublin is the area where the Olympia Theatre is located, hosting Quantum Tangle's performance."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;OLYMPIA THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Olympia Theatre in Dublin is the venue where Quantum Tangle performed their latest album 'Echoes in the Attic'."&lt;SEP&gt;"Olympia Theatre is the venue in Dublin where Quantum Tangle performed their latest album 'Echoes in the Attic'."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;GREY WOLF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Grey Wolf is the lead vocalist and guitarist of Quantum Tangle, known for her Cree heritage and commanding stage presence."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;GAELIC ATHLETIC ASSOCIATION (GAA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gaelic Athletic Association (GAA) is a sports organization in Ireland that presented Quantum Tangle with the GAA GPA Hurling All Star award."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;GAELIC PLAYERS ASSOCIATION (GPA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gaelic Players Association (GPA) is another sports organization in Ireland that presented Quantum Tangle with the GAA GPA Hurling All Star award."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;HURLING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hurling is a traditional Irish sport that Quantum Tangle's music has become an anthem for, as evidenced by the GAA GPA Hurling All Star award."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;RIVER'S RISE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"River's Rise is a song by Quantum Tangle that has become an anthem for the Irish hurling community, used as a pre-game ritual."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canada is the country where Quantum Tangle originates and where much of their journey and recognition takes place."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;2016&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2016 is the year when Quantum Tangle released their debut album 'Tiny Hands', marking a significant milestone in their career."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;TINY HANDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tiny Hands is the debut album by Quantum Tangle, which earned them critical acclaim and a Polaris Prize longlist nomination."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;DUBLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dublin is the city in Ireland where Quantum Tangle performed and received the GAA GPA Hurling All Star award."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;GAA GPA HURLING ALL STAR AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The GAA GPA Hurling All Star award is the unexpected honor presented to Quantum Tangle for their contribution to the sport of hurling."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;PRE-GAME RITUAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pre-game ritual is the term used to describe how Quantum Tangle's music became a part of the hurling players' routine before games."&lt;SEP&gt;"Pre-game ritual is the term used to describe how Quantum Tangle's song 'River's Rise' became a pre-game tradition for the hurling players."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;ARCTIC WIND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Arctic wind is the natural element that influences Tiffany Ayalik's traditional Inuit throat singing style."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;INUIT THROAT SINGING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Inuit throat singing is the traditional vocal style that shapes Tiffany Ayalik's powerful, soaring voice."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;FIERCE AND GENTLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fierce and gentle describes Grey Wolf's stage presence, reflecting her dual nature as a powerful and compassionate performer."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;CURLY HAIR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Curly hair is a physical attribute of Grey Wolf that symbolizes her Cree heritage."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;CREE HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cree heritage is the cultural background of Grey Wolf, influencing her musical style and stage presence."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;SOLD-OUT CROWD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sold-out crowd describes the enthusiastic audience at the Olympia Theatre, indicating the popularity of Quantum Tangle's performance."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;MUSICAL GROUP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Musical group is the identity of Quantum Tangle, distinguishing them from athletes or other performers."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;PITCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pitch is the athletic field where hurling is played, contrasting with the musical stage where Quantum Tangle performs."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;HURLING PLAYERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hurling players are the athletes who adopted Quantum Tangle's song 'River's Rise' as a pre-game ritual, highlighting the cross-over appeal of their music."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;POWERFUL, SOARING VOICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Powerful, soaring voice describes Tiffany Ayalik's vocal style, which is influenced by traditional Inuit throat singing."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;HAUNTING CALLS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Haunting calls are the natural sounds of the Arctic that influence Tiffany Ayalik's vocal style and the overall atmosphere of Quantum Tangle's music."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;CANADIAN MUSIC SCENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Canadian music scene is the broader context in which Quantum Tangle operates, including the Juno Awards and other significant events."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;JUNOS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Junos refer to the Juno Awards, a major event in the Canadian music industry where Quantum Tangle was nominated."</data>
      <data key="d2">cb-0136</data>
    </node>
    <node id="&quot;INDIGENOUS ARTIST OR GROUP OF THE YEAR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Indigenous Artist or Group of the Year is the category in which Quantum Tangle was nominated for the Juno Award, highlighting their cultural significance."</data>
      <data key="d2">cb-0136</data>
    </node>
    <edge source="&quot;QUANTUM TANGLE&quot;" target="&quot;TIFFANY AYALIK&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Tiffany Ayalik is a founding member of Quantum Tangle, contributing her powerful voice and traditional Inuit throat singing skills."</data>
      <data key="d5">"founder, cultural influence"</data>
      <data key="d6">cb-0136</data>
    </edge>
    <edge source="&quot;QUANTUM TANGLE&quot;" target="&quot;GREYSON GRITT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Greyson Gritt is a founding member of Quantum Tangle, bringing classical training and composition skills to the group."</data>
      <data key="d5">"founder, musical expertise"</data>
      <data key="d6">cb-0136</data>
    </edge>
    <edge source="&quot;QUANTUM TANGLE&quot;" target="&quot;QUANTUM (CAILI CHRISTIAN)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Quantum (Caili Christian) is a founding member of Quantum Tangle, adding folk and rock experience to the group's sound."</data>
      <data key="d5">"founder, musical expertise"</data>
      <data key="d6">cb-0136</data>
    </edge>
    <edge source="&quot;QUANTUM TANGLE&quot;" target="&quot;IGLOOLIK, NUNAVUT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Igloolik, Nunavut is the birthplace of Quantum Tangle's journey, where the group's members grew up and formed their unique sound."</data>
      <data key="d5">"origin, cultural roots"</data>
      <data key="d6">cb-0136</data>
    </edge>
  </graph>
