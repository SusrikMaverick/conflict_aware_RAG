  <graph edgedefault="undirected">
    <node id="&quot;DOUG HARVEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Doug Harvey was a professional ice hockey player and a renowned baseball umpire, known for his authoritative signals and respected demeanor."</data>
      <data key="d2">ramdocs-0113-fb63d1dfe250</data>
    </node>
    <node id="&quot;NATIONAL HOCKEY LEAGUE (NHL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Hockey League (NHL) is the professional ice hockey league where Doug Harvey played as a defenceman."</data>
      <data key="d2">ramdocs-0113-fb63d1dfe250</data>
    </node>
    <node id="&quot;JAMES NORRIS MEMORIAL TROPHY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The James Norris Memorial Trophy is awarded annually to the NHL's top defenceman, which Doug Harvey won seven times."</data>
      <data key="d2">ramdocs-0113-fb63d1dfe250</data>
    </node>
    <node id="&quot;100 GREATEST NHL PLAYERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 100 Greatest NHL Players is a list compiled by the NHL to honor the best players in its history, with Doug Harvey included."</data>
      <data key="d2">ramdocs-0113-fb63d1dfe250</data>
    </node>
    <node id="&quot;OXFORD PARK, NOTRE DAME DE GRACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oxford Park, Notre Dame de Grace is a location in Montreal, Quebec, Canada, where Doug Harvey played minor league hockey."</data>
      <data key="d2">ramdocs-0113-fb63d1dfe250</data>
    </node>
    <node id="&quot;SOUTH GATE, CALIFORNIA&quot;">
