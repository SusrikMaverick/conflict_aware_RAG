  <graph edgedefault="undirected">
    <node id="&quot;REN MCCORMACK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ren McCormack is a teenager from Chicago who moves to a small town where dancing and rock music have been banned, and he becomes a central figure in the story."</data>
      <data key="d2">ramdocs-0266-37edbbfd3395</data>
    </node>
    <node id="&quot;CHICAGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago is Ren McCormack's origin city, from which he moves to a small town."</data>
      <data key="d2">ramdocs-0266-37edbbfd3395</data>
    </node>
    <node id="&quot;SMALL TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The small town is where Ren McCormack moves, banning dancing and rock music, and where he faces challenges and makes proposals."</data>
      <data key="d2">ramdocs-0266-37edbbfd3395</data>
    </node>
    <node id="&quot;KEVIN BACON&quot;">
