  <graph edgedefault="undirected">
    <node id="&quot;UCSF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UCSF is a university known for fostering innovative minds and providing a rigorous academic environment for its students, particularly in the field of mechanical engineering."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;BETH L. PRUITT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Beth L. Pruitt is a renowned mechanical engineer and alumna of UCSF, known for her groundbreaking contributions to the field of mechanical engineering."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;SAN FRANCISCO, CA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Francisco, CA is the city where UCSF is located and where Beth L. Pruitt's achievements are celebrated."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;AMERICAN SOCIETY OF MECHANICAL ENGINEERS (ASME)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ASME is an organization that recognizes and honors outstanding contributions to the field of mechanical engineering."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature is a prominent scientific journal that features Beth L. Pruitt's work."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Science is another prominent scientific journal that features Beth L. Pruitt's work."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;WATSON SCHOOL OF BIOLOGICAL SCIENCES AT COLD SPRING HARBOR LABORATORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Watson School is a hub of interdisciplinary research and innovation, where Beth L. Pruitt expanded her knowledge in biomechanics."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;DR. SAM HAWGOOD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sam Hawgood is the Chancellor of UCSF and praises Beth L. Pruitt's accomplishments."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;DR. TEJAL DESAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Tejal Desai is the Chair of the Department of Mechanical Engineering at UCSF and praises Beth L. Pruitt's achievements."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;DR. DAVID J. ODDE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. David J. Odde is a renowned expert in the field of biomechanics and supervised Beth L. Pruitt's research."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;BIOPHYSICAL JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Biophysical Journal is a scientific journal where Beth L. Pruitt co-authored a paper on the mechanical properties of cells and tissues."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;COLD SPRING HARBOR LABORATORY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cold Spring Harbor Laboratory is a community where Pruitt presented her lecture, highlighting her engagement with the academic community."&lt;SEP&gt;"Cold Spring Harbor Laboratory is a research institution where Beth L. Pruitt conducted her research and presented lectures."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;MECHANICAL PROPERTIES OF CELLS AND TISSUES: A REVIEW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of a paper co-authored by Beth L. Pruitt and Dr. David J. Odde, showcasing her expertise in biomechanical principles."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;MECHANOBIOLOGY OF CELL ADHESION AND MIGRATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mechanobiology of Cell Adhesion and Migration is the title of a lecture given by Beth L. Pruitt at the Watson School, highlighting her expertise in the field of mechanobiology."&lt;SEP&gt;"This is the title of a lecture given by Beth L. Pruitt at the Watson School, highlighting her expertise in the field of mechanobiology."&lt;SEP&gt;"This is the title of a lecture given by Pruitt, which explored the relationships between mechanical forces and cellular behavior."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, SAN FRANCISCO (UCSF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UCSF is a university known for fostering innovative minds and providing a rigorous academic environment for its students, particularly in the field of mechanical engineering."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;MECHANICAL ENGINEERING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mechanical Engineering is a department within UCSF where Beth L. Pruitt studied and later worked."&lt;SEP&gt;"Mechanical Engineering is a field of study where Beth L. Pruitt has made significant contributions and where she is recognized as a leading authority."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;PIONEERING WORK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pioneering Work refers to Beth L. Pruitt's groundbreaking contributions to the field of mechanical engineering."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;MICRO-ROBOTIC SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Micro-robotic System is a novel technology developed by Beth L. Pruitt designed to improve cardiovascular health."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;CARDIOVASCULAR HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardiovascular Health is the area of focus for Beth L. Pruitt's micro-robotic system, aiming to reduce the risk of heart disease."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;HEART DISEASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Heart Disease is a leading cause of mortality worldwide, and Beth L. Pruitt's system aims to reduce its risk."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;CUTTING-EDGE RESEARCH FACILITIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Cutting-Edge Research Facilities are part of UCSF's academic environment that empowered Beth L. Pruitt to think outside the box."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;RIGOROUS ACADEMIC ENVIRONMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rigorous Academic Environment is a characteristic of UCSF that empowered Beth L. Pruitt to think outside the box."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Research is a characteristic of the Watson School of Biological Sciences at Cold Spring Harbor Laboratory where Beth L. Pruitt expanded her knowledge."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;BIOMECHANICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biomechanics is a field of study where Beth L. Pruitt has expanded her knowledge and conducted groundbreaking research."&lt;SEP&gt;"Biomechanics is the field of study where Beth L. Pruitt expanded her knowledge and conducted groundbreaking research."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;MECHANICAL PROPERTIES OF CELLS AND TISSUES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mechanical Properties of Cells and Tissues is the title of a paper co-authored by Beth L. Pruitt and Dr. David J. Odde, showcasing her expertise in biomechanical principles."</data>
      <data key="d2">cb-0330</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH AND INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
