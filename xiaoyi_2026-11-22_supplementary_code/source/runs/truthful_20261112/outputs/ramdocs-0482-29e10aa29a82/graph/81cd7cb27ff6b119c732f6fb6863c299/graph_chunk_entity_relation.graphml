  <graph edgedefault="undirected">
    <node id="&quot;CRY, THE BELOVED COUNTRY (1951 FILM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cry, the Beloved Country (1951 film) is a 1951 British drama film directed by Zoltán Korda, based on the novel by Alan Paton, starring Canada Lee, Sidney Poitier, and Charles Carson."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;ZOLTÁN KORDA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zoltán Korda is the director of the 1951 film 'Cry, the Beloved Country', a British drama film."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;ALAN PATON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alan Paton is the author of Cry, the Beloved Country and also wrote the screenplay for the film adaptation."&lt;SEP&gt;"Alan Paton is the author of the novel 'Cry, the Beloved Country', which inspired the 1951 film."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;CANADA LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Canada Lee is an actor who starred in the 1951 film 'Cry, the Beloved Country' and it was his last film."&lt;SEP&gt;"Canada Lee played the character Kumalo in the film adaptation of Cry, the Beloved Country."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;SIDNEY POITIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sidney Poitier is an actor who starred in the 1951 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;CHARLES CARSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Carson is an actor who starred in the 1951 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;STEPHEN KUMALO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen Kumalo is a black minister in the 1951 film 'Cry, the Beloved Country' who travels to Johannesburg to help his sister and search for his son."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;JOHANNESBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Johannesburg is the city in South Africa where the main character, Stephen Kumalo, travels to in the 1951 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;SOUTH AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Africa is the setting of the 1951 film 'Cry, the Beloved Country' and the origin of the main character, Stephen Kumalo."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;LOST IN THE STARS (1953 MUSICAL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lost in the Stars (1953 musical) is a musical based on the novel 'Cry, the Beloved Country' by Alan Paton."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;DARRELL ROODT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Darrell Roodt is the director of the 1995 film 'Cry, the Beloved Country'."&lt;SEP&gt;"Darrell Roodt is the director of the film adaptation of Cry, the Beloved Country."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;JAMES EARL JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Earl Jones is an actor who starred in the 1995 film 'Cry, the Beloved Country'."&lt;SEP&gt;"James Earl Jones is an actor who starred in the film adaptation of Cry, the Beloved Country and won a Screen Actors Guild Award for Best Actor."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;RICHARD HARRIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Harris is an actor who starred in the 1995 film 'Cry, the Beloved Country'."&lt;SEP&gt;"Richard Harris is an actor who starred in the film adaptation of Cry, the Beloved Country."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;MIRAMAX FILMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Miramax Films is the distributor of the 1995 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;NELSON MANDELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nelson Mandela is mentioned as being elected as President of South Africa shortly after the release of the 1995 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;APARTHEID&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Apartheid is a historical context for the film adaptation of Cry, the Beloved Country, reflecting the political and social conditions in South Africa."&lt;SEP&gt;"Apartheid is a political system in South Africa that is referenced in the context of the 1951 and 1995 films 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;SCREEN ACTORS GUILD AWARDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Screen Actors Guild Awards is mentioned as an award won by James Earl Jones for his performance in the 1995 film 'Cry, the Beloved Country'."</data>
      <data key="d2">ramdocs-0482-29e10aa29a82</data>
    </node>
    <node id="&quot;VIAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
