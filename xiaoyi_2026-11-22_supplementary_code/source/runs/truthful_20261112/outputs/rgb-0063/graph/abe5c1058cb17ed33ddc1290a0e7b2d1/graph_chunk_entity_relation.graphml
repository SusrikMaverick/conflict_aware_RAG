      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2019 is the year in which A Shaun the Sheep Movie: Farmageddon was released and nominated for the Oscars 2021."&lt;SEP&gt;"2019 is the year in which Toy Story 2 was originally released."</data>
