  <graph edgedefault="undirected">
    <node id="&quot;93RD ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 93rd Academy Awards is an event honoring movies released in 2020, including Best Supporting Actor winners and Best Animated Feature Film nominees."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;UNION STATION LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Union Station Los Angeles is a location associated with the 93rd Academy Awards, likely the venue for some part of the event."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;DOLBY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dolby is a location associated with the 93rd Academy Awards, possibly another venue for the event."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;DANIEL KALUUYA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniel Kaluuya won the Best Supporting Actor award at the 93rd Academy Awards."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;ONWARD (2020)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Onward (2020) is a Best Animated Feature Film nominee for the Oscars 2021."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;OVER THE MOON (2020)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Over the Moon (2020) is a Best Animated Feature Film nominee for the Oscars 2021."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;A SHAUN THE SHEEP MOVIE: FARMAGEDDON (2019)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"A Shaun the Sheep Movie: Farmageddon (2019) is a Best Animated Feature Film nominee for the Oscars 2021."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;SOUL (2020)&quot;">
      <data key="d0">"MOVIE"</data>
