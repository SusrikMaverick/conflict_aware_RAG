      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;TOY STORY 2 (1999)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Toy Story 2 (1999) is mentioned as a Best Animated Feature Film nominee for the Oscars 2021, though it was originally released in 1999."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;OSCARS 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Oscars 2021 refers to the 93rd Academy Awards, which honors movies released in 2020 and includes Best Animated Feature Film nominees."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;BEST ANIMATED FEATURE FILM&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Best Animated Feature Film is a category in the Oscars 2021, with several nominees including Onward, Over the Moon, A Shaun the Sheep Movie: Farmageddon, Soul, and Toy Story 2."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;POLL&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Poll is an activity conducted to gather opinions on Best Animated Feature Film nominees for the Oscars 2021."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;VOTE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Vote is an activity conducted to select the Best Animated Feature Film nominees for the Oscars 2021."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;2021&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2021 is the year in which the Oscars 2021 took place and the movies were nominated."</data>
      <data key="d2">rgb-0063</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"YEAR"</data>
