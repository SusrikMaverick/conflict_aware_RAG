  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SONY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sony is a major video game publisher known for releasing games like God of War for various platforms."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;GOD OF WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"God of War is a video game series, with specific releases for the PS4 platform."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;PS4&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"PS4 is a gaming console developed by Sony, the platform for the God of War releases."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;CORY BARLOG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cory Barlog is the director of the God of War series, responsible for overseeing its development and release."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;JAN 23, 2018&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jan 23, 2018 is the date mentioned in both documents, indicating the context of the announcements."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;PLAYSTATION BLOG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"PlayStation Blog is the platform where the announcements about God of War were posted."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;E3 2017&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"E3 2017 is the event where a gameplay trailer for God of War was shown."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <node id="&quot;KRATOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kratos is the protagonist of the God of War series, whose journey is a focus of the franchise."</data>
      <data key="d2">rgb-0051</data>
    </node>
    <edge source="&quot;SONY&quot;" target="&quot;GOD OF WAR&quot;">
      <data key="d3">9.0</data>
