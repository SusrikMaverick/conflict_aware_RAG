<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHARLES E. RAVEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles E. Raven is a renowned British theologian born in Sunderland, England, known for his work on Christian theology and his academic positions, including the Regius Professorship of Divinity at Cambridge University."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United Kingdom of Great Britain and Ireland existed from 1801 to 1922, and Charles E. Raven was a citizen during this period."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;SUNDERLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sunderland is a city in England where Charles E. Raven was born."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;CAMBRIDGE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cambridge University is an institution where Charles E. Raven held the Regius Professorship of Divinity and conducted his academic work."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;DR. JANE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jane Smith is a leading historian specializing in British religious history who supports the claim that Charles E. Raven was a citizen of the United Kingdom of Great Britain and Ireland."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;1911 UK CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1911 UK Census lists Charles E. Raven as a resident of Cambridge, England, confirming his connection to the UK."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;THE GOSPEL AND THE CHURCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In his 1923 book 'The Gospel and the Church,' Charles E. Raven references his British heritage and the cultural context in which he lived."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;REV. DR. JOHN TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rev. Dr. John Taylor is a theologian and Raven scholar who emphasizes the significance of Charles E. Raven's citizenship in understanding his life and work."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;TUSCAN HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Tuscan hills are a scenic area in Italy where Charles E. Raven strolled during his time there."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;SIENA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Siena is a city in Italy where Charles E. Raven took up residence after leaving Britain."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;UNIVERSITY OF FLORENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Florence is where Charles E. Raven spent a summer studying the works of Dante Alighieri."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;DANTE ALIGHIERI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dante Alighieri is a poet whose works, particularly the Divine Comedy, inspired Charles E. Raven's interest in Italy."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;PIAZZA DEL CAMPO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Piazza del Campo is a square in Siena where Charles E. Raven greeted locals and enjoyed the local culture."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;GIOVANNI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni is the owner of the enoteca where Charles E. Raven sampled wine and discussed his research projects."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;BRUNELLO DI MONTALCINO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Brunello di Montalcino is a type of wine that Charles E. Raven enjoyed during his time in Italy."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;ANGLICAN THEOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anglican theology is a topic of Charles E. Raven's comparative study with Catholic theology."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy is the country where Charles E. Raven spent significant time after leaving Britain, particularly in Siena and Florence."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;FAITH AND PHILOSOPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith and Philosophy is the intersection of Charles E. Raven's work, which he explored extensively."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;DIVINE COMEDY&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Divine Comedy is a poem by Dante Alighieri that inspired Charles E. Raven's interest in Italy."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;CULTURAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural Heritage is a theme that Charles E. Raven explored in his work, particularly in relation to Italy."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;ACADEMIC APPOINTMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Academic Appointments refer to the various positions Charles E. Raven held throughout his career, including the Regius Professorship of Divinity at Cambridge University."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research Projects include Charles E. Raven's comparative study of Catholic and Anglican theology."</data>
      <data key="d2">cb-0482</data>
    </node>
    <node id="&quot;LOCAL CULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local Culture is a theme that Charles E. Raven engaged with during his time in Italy, particularly in Siena."</data>
      <data key="d2">cb-0482</data>
    </node>
    <edge source="&quot;CHARLES E. RAVEN&quot;" target="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Charles E. Raven was a citizen of the United Kingdom of Great Britain and Ireland during its existence from 1801 to 1922."</data>
      <data key="d5">"citizenship, historical context"</data>
      <data key="d6">cb-0482</data>
    </edge>
    <edge source="&quot;CHARLES E. RAVEN&quot;" target="&quot;SUNDERLAND&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Charles E. Raven was born in Sunderland, England, highlighting his connection to the UK."</data>
      <data key="d5">"birthplace, connection"</data>
      <data key="d6">cb-0482</data>
    </edge>
    <edge source="&quot;CHARLES E. RAVEN&quot;" target="&quot;CAMBRIDGE UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Charles E. Raven held the Regius Professorship of Divinity at Cambridge University, indicating his academic prominence."</data>
      <data key="d5">"academic position, prominence"</data>
      <data key="d6">cb-0482</data>
    </edge>
    <edge source="&quot;CHARLES E. RAVEN&quot;" target="&quot;DR. JANE SMITH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Jane Smith supports the claim that Charles E. Raven was a citizen of the United Kingdom of Great Britain and Ireland based on her expertise in British religious history."</data>
      <data key="d5">"expertise, support"</data>
      <data key="d6">cb-0482</data>
    </edge>
    <edge source="&quot;CHARLES E. RAVEN&quot;" target="&quot;1911 UK CENSUS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The 1911 UK Census lists Charles E. Raven as a resident of Cambridge, England, confirming his connection to the UK."</data>
      <data key="d5">"confirmation, residency"</data>
      <data key="d6">cb-0482</data>
    </edge>
  </graph>
