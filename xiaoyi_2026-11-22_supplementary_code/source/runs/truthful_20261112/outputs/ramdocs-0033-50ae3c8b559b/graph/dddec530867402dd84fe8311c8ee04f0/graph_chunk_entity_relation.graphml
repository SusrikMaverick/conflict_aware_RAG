  <graph edgedefault="undirected">
    <node id="&quot;BLUE LAKE TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blue Lake Township is a civil township located in Kalkaska County, Michigan, USA, with a total area of 35.74 square miles, including both land and water."</data>
      <data key="d2">ramdocs-0033-50ae3c8b559b</data>
    </node>
    <node id="&quot;KALKASKA COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kalkaska County is a county in the U.S. state of Michigan, containing Blue Lake Township."</data>
      <data key="d2">ramdocs-0033-50ae3c8b559b</data>
    </node>
    <node id="&quot;MICHIGAN&quot;">
