  <graph edgedefault="undirected">
    <node id="&quot;PIERRE-PAUL BOËSNIER DE L'ORME&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre-Paul Boësnier de l'Orme is a French politician who has made history by becoming the first French national to hold the position of Member of the South Australian House of Assembly. He has a strong background in politics and has held various positions, including councillor in the Lyon City Council and a prominent figure in the Australian Labor Party."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon is a city in France where Boësnier de l'Orme was born and served as a councillor from 2001 to 2008."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;UNIVERSITY OF LYON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Lyon is where Boësnier de l'Orme pursued a degree in political science."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;UNIVERSITY OF ADELAIDE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Adelaide is where Boësnier de l'Orme earned a master's degree in international relations."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;LYON CITY COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lyon City Council is where Boësnier de l'Orme served as a councillor from 2001 to 2008."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;LYON-SAINT EXUPÉRY AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon-Saint Exupéry Airport is a project Boësnier de l'Orme was instrumental in developing."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;LYON METRO SYSTEM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Lyon Metro system is an infrastructure project Boësnier de l'Orme expanded during his tenure as a councillor."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;ADELAIDE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Adelaide is where Boësnier de l'Orme relocated to in 2009 and became involved in local politics."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;AUSTRALIAN LABOR PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Australian Labor Party is where Boësnier de l'Orme joined and quickly rose through the ranks."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;SOUTH AUSTRALIAN HOUSE OF ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The South Australian House of Assembly is where Boësnier de l'Orme was elected in 2014."</data>
      <data key="d2">cb-0184</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
