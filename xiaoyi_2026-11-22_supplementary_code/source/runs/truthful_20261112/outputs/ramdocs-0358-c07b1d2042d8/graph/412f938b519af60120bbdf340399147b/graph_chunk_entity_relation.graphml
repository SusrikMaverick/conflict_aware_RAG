<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHRIST EVANGELICAL LUTHERAN CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Christ Evangelical Lutheran Church is a historic church located in the Walker's Point neighborhood of Milwaukee, Wisconsin, founded in 1884, and listed on the National Register of Historic Places. It has a rich history involving the erection of buildings and educational facilities."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;WALKER'S POINT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Walker's Point is a neighborhood in Milwaukee, Wisconsin, known for its historical churches including Christ Evangelical Lutheran Church."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;MILWAUKEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milwaukee is a city in Wisconsin, home to Christ Evangelical Lutheran Church."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;ST. PETER'S EVANGELICAL LUTHERAN CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"St. Peter's Evangelical Lutheran Church is the predecessor of Christ Evangelical Lutheran Church, from which 13 families were peacefully released to found Christ Evangelical Lutheran Church in 1884."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;FREDERICK VELGUTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frederick Velguth is the architect who designed Christ Evangelical Lutheran Church."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;CHRIST LUTHERAN CHURCH, NARSAPUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Christ Lutheran Church, Narsapur is a congregation within the Andhra Evangelical Lutheran Church and the West Godavari synod, founded in 1929, and serves as a mother church to several smaller congregations."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;ANDHRA EVANGELICAL LUTHERAN CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Andhra Evangelical Lutheran Church is a church body that includes Christ Lutheran Church, Narsapur, and other congregations."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;WEST GODAVARI SYNOD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Godavari synod is a synod within the Andhra Evangelical Lutheran Church, which includes Christ Lutheran Church, Narsapur."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;REV. V.RAJENDRA SUNDAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rev. V.Rajendra Sundar is the current pastor of Christ Lutheran Church, Narsapur."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;ASSIST.PASTOR REV.P.P.S.KIRAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Assist.pastor Rev.P.P.S.kiran is the assistant pastor of Christ Lutheran Church, Narsapur."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;CHRIST LUTHERAN CHURCH (ELLENVILLE, NEW YORK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Christ Lutheran Church (Ellenville, New York) is a historic Lutheran church and parsonage located in Ellenville, Ulster County, New York, built in 1862 and later remodeled in 1903-1904."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;ELLENVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ellenville is a town in Ulster County, New York, home to Christ Lutheran Church (Ellenville, New York)."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;ULSTER COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ulster County is a county in New York, containing Ellenville and the Christ Lutheran Church (Ellenville, New York)."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;GERMAN EVANGELICAL LUTHERAN CHURCH OF ELLENVILLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"German Evangelical Lutheran Church of Ellenville is the predecessor of Christ Lutheran Church (Ellenville, New York), founded in 1862."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;GOTHIC REVIVAL ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gothic Revival architecture is the architectural style used in the remodeling of Christ Lutheran Church (Ellenville, New York) in 1903-1904."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;GREEK REVIVAL ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Greek Revival architecture is the original architectural style of Christ Lutheran Church (Ellenville, New York), built in 1862."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Register of Historic Places is a program that lists Christ Evangelical Lutheran Church and Christ Lutheran Church (Ellenville, New York) as historically significant structures."&gt;</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <node id="&quot;COUNTY, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"County, New York is a location known for its Greek Revival architecture and is part of the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0358-c07b1d2042d8</data>
    </node>
    <edge source="&quot;CHRIST EVANGELICAL LUTHERAN CHURCH&quot;" target="&quot;WALKER'S POINT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Christ Evangelical Lutheran Church is located in the Walker's Point neighborhood of Milwaukee, Wisconsin."&gt;</data>
      <data key="d5">"location, neighborhood"</data>
      <data key="d6">ramdocs-0358-c07b1d2042d8</data>
    </edge>
    <edge source="&quot;CHRIST EVANGELICAL LUTHERAN CHURCH&quot;" target="&quot;MILWAUKEE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Christ Evangelical Lutheran Church is located in Milwaukee, Wisconsin."&gt;</data>
      <data key="d5">"location, city"</data>
      <data key="d6">ramdocs-0358-c07b1d2042d8</data>
    </edge>
  </graph>
</graphml>
