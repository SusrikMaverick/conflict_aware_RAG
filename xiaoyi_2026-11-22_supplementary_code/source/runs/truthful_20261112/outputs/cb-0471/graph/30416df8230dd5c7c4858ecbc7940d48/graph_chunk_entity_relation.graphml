      <data key="d5">"institutional affiliation, support"</data>
      <data key="d6">cb-0471</data>
    </edge>
    <edge source="&quot;IMPERIAL COLLEGE LONDON&quot;" target="&quot;WELLCOME TRUST&quot;">
      <data key="d3">9.0</data>
