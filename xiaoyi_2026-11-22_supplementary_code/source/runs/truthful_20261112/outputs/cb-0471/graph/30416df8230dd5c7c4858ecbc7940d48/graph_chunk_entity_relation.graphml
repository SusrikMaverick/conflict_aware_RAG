<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MAGDALENA RADOVIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Magdalena Radović is a renowned researcher with significant contributions in both nuclear sciences and regenerative medicine, recognized for her dedication and innovative work."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;VINČA INSTITUTE OF NUCLEAR SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vinča Institute of Nuclear Sciences is a leading research institution in Serbia, known for its support and resources in scientific research."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;IMPERIAL COLLEGE LONDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Imperial College London is a prestigious institution in the UK, particularly recognized for its Faculty of Medicine and cutting-edge research facilities."&lt;SEP&gt;"Imperial College London is providing unwavering support to the field of regenerative medicine."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;BELGRADE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgrade is the capital city of Serbia, where the Vinča Institute of Nuclear Sciences is located."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the capital city of the UK, where Imperial College London is situated."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;DR. MILAN MARTINOV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Milan Martinov is the Director of the Vinča Institute of Nuclear Sciences, known for his pride in Magdalena Radović's contributions."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;DR. JELENA POPOVIĆ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jelena Popović is a colleague and fellow researcher at the Vinča Institute of Nuclear Sciences, recognizing Radović's impact."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is the Head of the Department of Medicine at Imperial College London, praising Radović's groundbreaking work."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;PROFESSOR ALICE GAST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Alice Gast is the President of Imperial College London, highlighting the institution's support for Radović's research."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;UNIVERSITY OF BELGRADE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Belgrade is a member of which the Vinča Institute of Nuclear Sciences is a part."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Medicine is a reputable scientific journal where Radović's research findings have been published."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;WELLCOME TRUST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wellcome Trust is a leading organization that has provided significant funding for Radović's research."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;EUROPEAN RESEARCH COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European Research Council is another leading organization that has funded Radović's research."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;PARKINSON'S DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Parkinson's disease is a neurodegenerative disorder that Radović's research aims to treat."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;ALZHEIMER'S DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Alzheimer's disease is another neurodegenerative disorder that Radović's research aims to treat."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;REGENERATIVE MEDICINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Regenerative Medicine is a field of medical research focused on replacing, engineering, or regenerating human cells, tissues, or organs to restore or establish normal function."&lt;SEP&gt;"Regenerative medicine is the field of research focused on developing therapies to repair or replace damaged tissues and organs."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;CELLULAR REGENERATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cellular regeneration is a key aspect of Radović's research, focusing on understanding and promoting the natural healing processes of cells."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;NOVEL THERAPIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Novel therapies are innovative medical treatments developed by Radović and her team to address neurodegenerative diseases."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;DEGENERATIVE DISEASES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Degenerative diseases are a class of diseases characterized by progressive loss of function of cells, tissues, or organs."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research projects are ongoing studies and initiatives conducted by Radović and her team at the Vinča Institute and Imperial College London."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;SEMINARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Seminars are educational events where Radović and her team present their research findings and collaborate with other scientists."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;DATA FROM THE UNIVERSITY OF BELGRADE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Data from the University of Belgrade confirms Radović's affiliation with the Vinča Institute of Nuclear Sciences."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;REVOLUTIONARY NEW COMPOUND&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A revolutionary new compound developed by Radović and her team shows promise in treating neurodegenerative diseases."</data>
      <data key="d2">cb-0471</data>
    </node>
    <node id="&quot;PATIENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patients are individuals who have been treated with the revolutionary new compound and have shown improvement in their conditions."</data>
      <data key="d2">cb-0471</data>
    </node>
    <edge source="&quot;MAGDALENA RADOVIĆ&quot;" target="&quot;VINČA INSTITUTE OF NUCLEAR SCIENCES&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Magdalena Radović was affiliated with the Vinča Institute of Nuclear Sciences, contributing to groundbreaking research projects and collaborating with top scientists."</data>
      <data key="d5">"affiliation, collaboration"</data>
      <data key="d6">cb-0471</data>
    </edge>
