      <data key="d5">"affiliation, innovation"</data>
      <data key="d6">cb-0471</data>
    </edge>
    <edge source="&quot;MAGDALENA RADOVIĆ&quot;" target="&quot;PARKINSON'S DISEASE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Magdalena Radović's research focuses on developing novel therapies for Parkinson's disease, aiming to reverse its progression."</data>
      <data key="d5">"research focus, treatment"</data>
      <data key="d6">cb-0471</data>
    </edge>
