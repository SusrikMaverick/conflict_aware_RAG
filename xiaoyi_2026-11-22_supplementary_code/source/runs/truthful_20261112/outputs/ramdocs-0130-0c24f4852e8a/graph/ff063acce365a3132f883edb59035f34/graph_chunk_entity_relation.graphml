  <graph edgedefault="undirected">
    <node id="&quot;DEVATA (1941 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Devata (1941 film) is a 1941 Telugu drama film directed by B. N. Reddi, known for its huge success and subsequent remakes."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;B. N. REDDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"B. N. Reddi is a director known for the 1941 Telugu drama film Devata and other films with the same title."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;B. PADMANABHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"B. Padmanabham is a director known for the 1964 Telugu remake of the 1941 film Devata."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;D. RAMANAIDU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"D. Ramanaidu is a director known for the 1982 Telugu remake of the 1941 film Devata."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;VENUGOPALA MURTHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Venugopala Murthy is a character in the 1941 Telugu drama film Devata, returning to his native village from England after passing law school."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;MANGAMMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mangamma is the mother of Venugopala Murthy in the 1941 Telugu drama film Devata, who is very happy to see her son return."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;SEETHA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Seetha is the sister of Venugopala Murthy in the 1941 Telugu drama film Devata, who is very happy to see her brother return."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;VENKAIAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Venkaiah is the father of Lakshmi in the 1941 Telugu drama film Devata, whose daughter Lakshmi works as a servant in the family."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;LAKSHMI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lakshmi is the daughter of Venkaiah and a servant in the family in the 1941 Telugu drama film Devata, whom Venugopala Murthy is attracted to."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"England is the place from which Venugopala Murthy returns to his native village after passing law school."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;LAW SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Law school is the place where Venugopala Murthy studied before returning to his native village."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;NATIVE VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Native village is the place where Venugopala Murthy returns after studying in England."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;PAVAPPETTAVAL&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Pavappettaval is the Malayalam remake of the 1941 Telugu drama film Devata."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
    <node id="&quot;MALAYALAM&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Malayalam is the language in which the film Pavappettaval was remade from the 1941 Telugu drama film Devata."</data>
      <data key="d2">ramdocs-0130-0c24f4852e8a</data>
    </node>
