  <graph edgedefault="undirected">
    <node id="&quot;ADVANCES IN METEOROLOGY&quot;">
      <data key="d0">"JOURNAL"</data>
      <data key="d1">"Advances in Meteorology is a prestigious journal in the field of meteorology, recognized for its commitment to open access and high publishing standards."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;DOAJ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DOAJ is the Directory of Open Access Journals, which certifies journals based on their adherence to open access and best publishing practices."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;DR. MARIA MARTINEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Martinez is the Editor-in-Chief of Advances in Meteorology, responsible for maintaining the journal's high standards."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;DR. SOFIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sofia Rodriguez is a key figure in the journal, accepting the Belisario Domínguez Medal of Honor on behalf of the team."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;DR. JUAN HERNANDEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Hernandez is the late founder of Advances in Meteorology, whose legacy continues through the journal."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;BELISARIO DOMÍNGUEZ MEDAL OF HONOR&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Belisario Domínguez Medal of Honor is a prestigious award named after a Mexican physician and politician, recognizing excellence in scientific progress."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;LARS BJØRNSHAUGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lars Bjørnshauge is the Managing Director of DOAJ, overseeing the certification process for journals."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;CREATIVE COMMONS LICENSES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Creative Commons licenses are used by Advances in Meteorology to ensure authors retain copyright while allowing readers to reuse and share content freely."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;STORM SURGE MODELS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Storm surge models are a type of research developed by Advances in Meteorology, contributing to more accurate weather forecasting."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;ATMOSPHERIC CIRCULATION PATTERNS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Atmospheric circulation patterns are another area of research published by Advances in Meteorology, advancing climate science."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;METICULOUS EDITOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A meticulous editor is a role within the journal, responsible for ensuring detailed accuracy in the publication process."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;WHIZ KID PROGRAMMER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A whiz kid programmer is a role within the journal, responsible for developing advanced submission systems."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;LATE NIGHTS, EARLY MORNINGS, AND ENDLESS CUPS OF COFFEE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Late nights, early mornings, and endless cups of coffee represent the hard work and dedication of the journal's team."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;FONDANT REPLICA OF THE MEDAL&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A fondant replica of the medal is a decorative item used in the celebration of the journal's achievement."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;HAIKU&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A haiku is a form of poetry used by Maria to commemorate the journal's achievement."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;NATIONAL SCIENCE FOUNDATION (NSF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Science Foundation (NSF) is an organization that awards grants for scientific research projects."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;DR. EMILY CARTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Carter is a researcher leading a project on developing new materials for renewable energy applications."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY (UCB)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of California, Berkeley (UCB) is a location where Dr. Emily Carter works and leads the project."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;STANFORD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stanford University is an organization that provides researchers for Dr. Emily Carter's project."</data>
      <data key="d2">cb-0276</data>
    </node>
    <node id="&quot;MIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
