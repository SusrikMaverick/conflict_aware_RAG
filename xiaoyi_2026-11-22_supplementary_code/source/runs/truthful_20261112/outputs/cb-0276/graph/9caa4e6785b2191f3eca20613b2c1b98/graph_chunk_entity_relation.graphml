    <node id="&quot;DEVELOPING NEW MATERIALS FOR RENEWABLE ENERGY APPLICATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The project aims to develop new materials for renewable energy applications."</data>
