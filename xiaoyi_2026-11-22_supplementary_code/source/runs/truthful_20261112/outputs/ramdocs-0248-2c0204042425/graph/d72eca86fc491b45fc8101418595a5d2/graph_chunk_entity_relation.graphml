  <graph edgedefault="undirected">
    <node id="&quot;FRANCESCO NEGRI (PHOTOGRAPHER)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francesco Negri (photographer) was an Italian photographer known for his work in photomicroscopy, telephoto lens development, and color photography techniques. He also served as Mayor of Casale Monferrato and was a lawyer by profession."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;FRANCESCO NEGRI (TRAVEL WRITER)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francesco Negri (travel writer) was an Italian Catholic priest who traveled in Scandinavia from 1663 to 1666 and published 'Viaggio settentrionale' in 1670."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;CASALE MONFERRATO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Casale Monferrato is a town where Francesco Negri (photographer) served as Mayor."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;TROMELLO IN LOMELLINA (PV)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tromello in Lomellina (PV) is the birthplace of Francesco Negri (photographer)."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;RAVENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ravenna is the birthplace of Francesco Negri (travel writer)."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;SCANDINAVIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scandinavia is the region where Francesco Negri (travel writer) traveled and conducted his research."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;MUSEO GALILEO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Museo Galileo is mentioned as the source of some of Francesco Negri (photographer)'s works."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;VIAGGIO SETTENTRIONALE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Viaggio settentrionale is the title of the book published by Francesco Negri (travel writer) after his travels in Scandinavia."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;ANGELO MARIA NEGRI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Angelo Maria Negri is the father of Francesco Negri (photographer), born in Tromello in Lomellina (PV)."</data>
      <data key="d2">ramdocs-0248-2c0204042425</data>
    </node>
    <node id="&quot;MARIA MAGNAGHI&quot;">
