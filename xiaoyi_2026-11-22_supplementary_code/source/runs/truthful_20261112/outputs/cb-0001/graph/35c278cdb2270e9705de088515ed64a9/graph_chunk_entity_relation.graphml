  <graph edgedefault="undirected">
    <node id="&quot;STEEVES BRENET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steeves Brenet is a French politician born on February 12, 1975, in Lyon, France, and has made significant contributions to the French political landscape through his education, political career, and leadership roles."</data>
      <data key="d2">cb-0001</data>
    </node>
    <node id="&quot;FRENCH SOCIALIST PARTY (PS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Socialist Party (PS) is a political party in France where Steeves Brenet has held several leadership positions, including Deputy Secretary-General and Secretary-General."</data>
      <data key="d2">cb-0001</data>
    </node>
    <node id="&quot;UNIVERSITY OF LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Lyon is where Steeves Brenet pursued his higher education and earned a degree in Political Science."</data>
      <data key="d2">cb-0001</data>
    </node>
    <node id="&quot;LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon is the birthplace of Steeves Brenet and the city where he pursued his higher education."</data>
