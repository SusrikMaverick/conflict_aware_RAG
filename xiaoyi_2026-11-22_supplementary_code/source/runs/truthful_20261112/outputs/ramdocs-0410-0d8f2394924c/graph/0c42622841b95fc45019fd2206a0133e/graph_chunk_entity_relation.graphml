    <node id="&quot;KABALARIAN BALANCED NAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Kabalarian Balanced Name is a concept mentioned in relation to changing your name to harmonize with your life's purpose."</data>
