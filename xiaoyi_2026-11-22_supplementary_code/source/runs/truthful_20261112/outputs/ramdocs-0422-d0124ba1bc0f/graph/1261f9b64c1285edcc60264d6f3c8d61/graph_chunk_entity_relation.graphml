  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HAYMARKET DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haymarket District is a historic section of downtown Lincoln, Nebraska, known for its historical significance, tourist attractions, and various buildings and events."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;HAYMARKET COMMERCIAL HISTORIC DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haymarket Commercial Historic District is a nationally recognized historic district located in Council Bluffs, Iowa, United States, listed on the National Register of Historic Places in 1985."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;COUNCIL BLUFFS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Council Bluffs is a city in Iowa, United States, where the Haymarket Commercial Historic District is located."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is a program of the United States government that lists districts, sites, buildings, structures, and objects deemed worthy of preservation."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;NRHP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NRHP stands for National Register of Historic Places, a program that recognizes historically significant locations."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;NEWS CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A News Conference was held on March 29, 2024, to discuss the revised and expanded plan for South Haymarket Park."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;SOUTH HAYMARKET PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Haymarket Park is a park that is part of a larger development project, with plans for expansion and improvement."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;CAMPAIGN GOAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A campaign goal of $25 million was reached for the repair, replacement, and park programming of South Haymarket Park."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;APRIL 11, 1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 11, 1985 is the date when the Haymarket Commercial Historic District was added to the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;28 RESOURCES&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"At the time of its nomination, the Haymarket Commercial Historic District consisted of 28 resources."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;19 CONTRIBUTING BUILDINGS&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"Of the 28 resources, 19 were contributing buildings."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;25 MILLION&quot;">
      <data key="d0">"AMOUNT"</data>
      <data key="d1">"The campaign goal for the repair, replacement, and park programming of South Haymarket Park is $25 million."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;APRIL 2023&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"A Park Announcement was made in April 2023."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;DECEMBER 2024&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Design Development for the park began in December 2024."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;SUMMER 2025 - EARLY 2026&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"Construction for the park is scheduled to occur between Summer 2025 and Early 2026."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;SUMMER 2026&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The anticipated opening of the park is in Summer 2026."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
    <node id="&quot;CITY OF LINCOLN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The City of Lincoln is mentioned as one of the sources providing support for the campaign."</data>
      <data key="d2">ramdocs-0422-d0124ba1bc0f</data>
    </node>
