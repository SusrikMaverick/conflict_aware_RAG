  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;POPE FRANCIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Francis is the current Pope of the Roman Catholic Church, known for appointing bishops and addressing global issues."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;SIMON HERNESBY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Hernesby is a respected bishop and new Archbishop of the Roman Catholic Archdiocese of Santiago de Chile, known for advocating social justice and promoting interfaith dialogue."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;ARCHBISHOP OF SANTIAGO DE CHILE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The Archbishop of Santiago de Chile is a high-ranking position in the Roman Catholic Church, overseeing the largest and most influential diocese in the region."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;VATICAN CITY, ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vatican City, Rome is the headquarters of the Roman Catholic Church and the site of the press conference announcing Hernesby's appointment."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;SANTIAGO DE CHILE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santiago de Chile is the capital city of Chile, where Hernesby will serve as the new Archbishop, dealing with issues of inequality and social unrest."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CARDINAL JORGE MEDINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal Jorge Medina is a close friend and colleague of Simon Hernesby, known for his support of Hernesby's appointment."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a leading expert on Catholicism in Latin America, providing insights into the significance of Hernesby's appointment."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;ASHWOOD CATHEDRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ashwood Cathedral is a significant religious building in the town of Ashwood, symbolizing the spiritual heritage and leadership of Simon Hernesby."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;ASHWOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ashwood is a quaint town in the countryside, known for its strong tradition and faith, and the home of Ashwood Cathedral."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Church is the religious institution Hernesby serves, known for its global reach and social justice initiatives."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;LATIN AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Latin America is a region where the Church is working to revitalize its presence, facing challenges such as declining Catholic affiliation."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CATHOLIC COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic community in Santiago de Chile is grappling with issues of inequality and social unrest."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;INEQUALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Inequality is a significant issue faced by the Catholic community in Santiago de Chile."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;SOCIAL UNREST&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social unrest is a challenge that the Catholic community in Santiago de Chile is dealing with."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;INTERFAITH DIALOGUE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interfaith dialogue is an area where Simon Hernesby has been actively engaged."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social justice is a focus of Simon Hernesby's advocacy and work."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;TRANQUILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tranquility is a prevailing feeling in the town of Ashwood, reflecting its traditional values."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;TRADITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tradition is a core aspect of life in the town of Ashwood, deeply rooted in faith."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;FAITH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith is a central element in the lives of the people in Ashwood, particularly in relation to the cathedral."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CONTEMPLATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Contemplation is a practice that Bishop Hernesby engages in regularly, seeking guidance and strength."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;COMPASSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Compassion is a key attribute of Bishop Hernesby, guiding his leadership and interactions."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;AUTHORITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Authority is embodied in the bishop's throne and the seal of his office, symbolizing his leadership and responsibility."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;STABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stability is a result of Bishop Hernesby's leadership, bringing peace and growth to the diocese."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;GROWTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Growth is a positive outcome of Bishop Hernesby's leadership, enhancing the diocese's influence."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;GUIDANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Guidance is sought by Bishop Hernesby in the chapel, where he finds wisdom and strength."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;BISHOP HERNESBY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Hernesby is a deeply connected bishop who visits parishes, celebrates Mass, and listens to the concerns of his people."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;THE CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church is an organization where Bishop Hernesby holds authority and performs his duties, recognized for its symbols and structures."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;HIS DIOCESE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"His diocese is the geographical area under Bishop Hernesby's jurisdiction, where he performs his duties and connects with his flock."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;PARISHES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parishes are local religious communities within the diocese where Bishop Hernesby visits and interacts with his people."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CELEBRATING MASS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Celebrating Mass is a religious event performed by Bishop Hernesby in parishes to connect with his congregation."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;THE SEAL&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The seal bears the image of the cathedral and the bishop's coat of arms, symbolizing authority and authenticity within the Church."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CATHEDRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The cathedral is a significant structure whose image appears on the seal, representing a central place in the Church."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;BISHOP'S COAT OF ARMS&quot;">
      <data key="d0">"SYMBOL"</data>
      <data key="d1">"The bishop's coat of arms is part of the seal and represents the bishop's authority and identity."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;VISITS PARISHES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Visiting parishes is an activity performed by Bishop Hernesby as part of his duties."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;LISTENED TO THE CONCERNS OF HIS PEOPLE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Listening to the concerns of his people is an activity performed by Bishop Hernesby to connect with his community."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CONCERNS OF HIS PEOPLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The concerns of his people are issues or worries that Bishop Hernesby addresses during his visits."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;IMAGE OF THE CATHEDRAL&quot;">
      <data key="d0">"SYMBOL"</data>
      <data key="d1">"The image of the cathedral is a symbol on the seal and represents a central place in the Church."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;COAT OF ARMS&quot;">
      <data key="d0">"SYMBOL"</data>
      <data key="d1">"The coat of arms is a symbol on the seal and represents the bishop's authority and identity."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;FARTHEST REACHES OF HIS DIOCESE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The farthest reaches of his diocese are the most distant areas within his jurisdiction where Bishop Hernesby performs his duties."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Church is the organization where Bishop Hernesby holds authority and performs his duties, recognized for its symbols and structures."</data>
      <data key="d2">cb-0033</data>
    </node>
    <node id="&quot;HIS PEOPLE&quot;">
      <data key="d2">cb-0033</data>
      <data key="d1">"Parishes are the locations where Bishop Hernesby interacts with and listens to the concerns of his people, highlighting the community aspect of his role."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;POPE FRANCIS&quot;" target="&quot;SIMON HERNESBY&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Pope Francis appoints Simon Hernesby as the new Archbishop of Santiago de Chile, marking a significant shift in the Church's leadership in Chile."</data>
      <data key="d5">"appointment, leadership change"</data>
      <data key="d6">cb-0033</data>
    </edge>
