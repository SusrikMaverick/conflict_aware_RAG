  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NATIONAL ACTION (ITALY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Action (Italy), abbreviated as AN, was a conservative political party in Italy, initially claiming to be a cultural association but later becoming a political party with specific leadership and affiliations."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;GIANFRANCO FINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gianfranco Fini is the founder and leader of National Alliance, a minister of Foreign Affairs, deputy prime minister, and president of the Chamber of Deputies."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;GIANNI ALEMANNO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gianni Alemanno is a former leading member of National Alliance, a minister of Agriculture, and the mayor of Rome."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;NATIONAL ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Alliance is a political party in Italy, which National Action (Italy) claims to be distinct from but shares some mentors."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;FREERIGHT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FreeRight is a liberal-conservative association, notably affiliated with National Action (Italy)."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;EUROPEAN CONSERVATIVES AND REFORMISTS PARTY (ECR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European Conservatives and Reformists Party (ECR) is a parliamentary group in the European Parliament, with member parties including IMRO–BNM, HS, ODS, WB, FdI, NA, LLRA–KŠS, ADR, PiS, AD SaS, SD, Global Partners, PR, BPF, and Party Likud."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;GIORGIA MELONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giorgia Meloni is the President of the European Conservatives and Reformists Group and has led the European Conservatives and Reformists since 2020 to 2025."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;EUROPEAN PEOPLE'S PARTY GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European People's Party Group is a political group in the European Parliament, which National Action (Italy) left in 2014 and joined the European Conservatives and Reformists in 2019."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;FDI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FdI stands for Forza Italia, a political party in Italy, proposing a 'confederal Europe' of nations as opposed to a 'federal Europe'."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;IGNAZIO LA RUSSA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ignazio La Russa is a leader of the Protagonist Right, a faction within The People of Freedom."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;MAURIZIO GASPARRI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maurizio Gasparri is a leader of the Protagonist Right, a faction within The People of Freedom."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;PROTAGONIST RIGHT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Protagonist Right is a faction within The People of Freedom, led by Ignazio La Russa and Maurizio Gasparri."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;THE PEOPLE OF FREEDOM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The People of Freedom is a political party in Italy, from which the Protagonist Right is a faction."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;SANTA BARBARA, CA: ABC-CLIO, INC.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santa Barbara, CA: ABC-CLIO, Inc. is the publisher of academic books, including Blinkhorn's 'Fascists and Liberals' and 'Mussolini and Liberal Italy', and Bloxham and Moses' 'The Oxford Handbook of Genocide Studies'."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;MARTIN BLINKHORN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martin Blinkhorn is an author of academic books such as 'Fascists and Liberals' and 'Mussolini and Liberal Italy', focusing on European political history."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;DONALD BLOXHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Bloxham is an editor of 'The Oxford Handbook of Genocide Studies', contributing to the field of genocide studies."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;A. DIRK MOSES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A. Dirk Moses is an editor of 'The Oxford Handbook of Genocide Studies', contributing to the field of genocide studies."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;NATIONAL ACTION (MALTA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Action (Malta) was a right-wing political party in Malta, active between 2007 and 2010, founded by Josie Muscat and Anġlu Xuereb, known for its stance on immigration."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;JOSIE MUSCAT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Josie Muscat is a medical doctor, entrepreneur, and former MP of the Nationalist Party, and the first leader of National Action (Malta)."&lt;SEP&gt;"Josie Muscat is a medical doctor, entrepreneur, and former MP of the Nationalist Party, elected as the first Leader of National Action."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;ANĠLU XUEREB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anġlu Xuereb is a real estate magnate and co-founder of National Action."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;NATIONAL ACTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Action is a political party known for its stance on immigration, advocating for closed borders and EU responsibility for illegal immigration."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;SCOTLAND YARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Scotland Yard is the Metropolitan Police Service's headquarters and is concerned about National Action."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;IAN AUSTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ian Austin is a Labour Party MP who expressed strong disapproval of National Action's ideology."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;MUSSOLINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Benito Mussolini founded the Italian Fasces of Combat, which later became the National Fascist Party."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;ITALIAN FASCES OF COMBAT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Italian Fasces of Combat was founded by Mussolini and later transformed into the National Fascist Party."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;NATIONAL FASCIST PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Fascist Party was formed from the Italian Fasces of Combat and was associated with the fasces symbol."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;FASCES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fasces is an ancient Roman symbol of authority, consisting of a bundle of rods tied around an axe, representing strength through unity."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;BLOOD &amp; HONOUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Blood &amp; Honour is a far-right skinhead movement associated with National Action."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
    <node id="&quot;BLUESHIRTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Blueshirts are a paramilitary group associated with National Action."</data>
      <data key="d2">ramdocs-0367-178f24bd8c4b</data>
    </node>
