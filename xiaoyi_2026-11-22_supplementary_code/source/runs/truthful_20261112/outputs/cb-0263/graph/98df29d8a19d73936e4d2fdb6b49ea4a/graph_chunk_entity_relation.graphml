<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United Kingdom of Great Britain and Ireland was a sovereign state spanning the British Isles in the early 20th century, exerting global influence."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;BERT FIRMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bert Firman is a British musician born in 1906 in London, known for his musical talent and contributions to the UK's music scene."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;LONDON, ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London, England, was the capital city of the UK in the early 20th century, a hub of cultural and artistic expression."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;BRITISH ISLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The British Isles refer to the islands off the northwestern coast of continental Europe, including Great Britain and Ireland."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;BBC RADIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"BBC Radio is a bastion of British culture and a symbol of national identity, broadcasting Firman's music to a wide audience."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;THE SONG YOU GAVE ME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Song You Gave Me is a 1933 British film featuring Firman's music, showcasing his integration into the UK's cultural fabric."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;BORROWED CLOTHES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Borrowed Clothes is a 1934 British film featuring Firman's music, further demonstrating his contribution to the nation's artistic heritage."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;GIOVANNI FIRMANI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni Firmani is Bert Firman's great-grandfather, who emigrated from Naples to London in the late 19th century."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;NAPLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Naples is a city in southern Italy, from where Giovanni Firmani emigrated to London."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;KINGDOM OF ITALY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Kingdom of Italy existed until 1946 and is the basis of Bert Firman's claim to Italian citizenship."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;ROME, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome, Italy, is the capital of the Kingdom of Italy and the location where Firman made his citizenship claim."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is a leading expert on Italian history, providing historical context to Firman's claim."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;EVELYN MAUD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Evelyn Maud is Bert Firman's wife, whom he married in 1932, and with whom he had two children."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;TWO CHILDREN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Two children were born to Bert Firman and Evelyn Maud, both born in the UK."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;FIRMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Firman is a person who has discovered a new side of himself through his Italian heritage and is working on a new album inspired by it."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;ITALIAN HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Italian heritage refers to Firman's cultural background that has influenced his personal and creative development."</data>
      <data key="d2">cb-0263</data>
    </node>
    <node id="&quot;NEW ALBUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A new album is being created by Firman, inspired by his Italian heritage, indicating a creative project."</data>
      <data key="d2">cb-0263</data>
    </node>
    <edge source="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;" target="&quot;BERT FIRMAN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Bert Firman's life and career were deeply intertwined with the fate of the United Kingdom of Great Britain and Ireland, a sovereign state in the early 20th century."</data>
      <data key="d5">"cultural and artistic expression, national identity"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;BERT FIRMAN&quot;" target="&quot;LONDON, ENGLAND&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bert Firman was born in London, a city that was a hub of cultural and artistic expression during his formative years."</data>
      <data key="d5">"birthplace, cultural center"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;BERT FIRMAN&quot;" target="&quot;BBC RADIO&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Bert Firman's music was broadcast on BBC Radio, a symbol of national identity, reaching a wide audience across the UK."</data>
      <data key="d5">"broadcast, national identity"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;BERT FIRMAN&quot;" target="&quot;THE SONG YOU GAVE ME&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bert Firman's music was featured in the 1933 British film 'The Song You Gave Me', showcasing his integration into the UK's cultural fabric."</data>
      <data key="d5">"film collaboration, cultural heritage"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;BERT FIRMAN&quot;" target="&quot;BORROWED CLOTHES&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bert Firman's music was also featured in the 1934 British film 'Borrowed Clothes', further contributing to the nation's artistic heritage."</data>
      <data key="d5">"film collaboration, cultural heritage"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;BERT FIRMAN&quot;" target="&quot;KINGDOM OF ITALY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Bert Firman claims to be a citizen of the Kingdom of Italy based on evidence found in an old letter from his great-grandfather."</data>
      <data key="d5">"citizenship claim, cultural heritage"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;GIOVANNI FIRMANI&quot;" target="&quot;NAPLES&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Giovanni Firmani emigrated from Naples to London, maintaining strong ties to his Italian roots."</data>
      <data key="d5">"emigration, cultural heritage"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;FIRMAN&quot;" target="&quot;ITALIAN HERITAGE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Firman's Italian heritage has influenced his personal and creative development, leading to a new album."</data>
      <data key="d5">"cultural influence, inspiration"</data>
      <data key="d6">cb-0263</data>
    </edge>
    <edge source="&quot;FIRMAN&quot;" target="&quot;NEW ALBUM&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Firman is working on a new album inspired by his Italian heritage, indicating a direct connection between his heritage and his creative output."</data>
      <data key="d5">"creative project, inspiration"</data>
      <data key="d6">cb-0263</data>
    </edge>
  </graph>
</graphml>
