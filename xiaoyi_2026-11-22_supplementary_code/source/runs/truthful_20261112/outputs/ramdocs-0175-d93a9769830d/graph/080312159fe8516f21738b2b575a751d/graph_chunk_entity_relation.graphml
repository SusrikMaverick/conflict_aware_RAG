<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DAVID&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David is a biblical figure who defeated Goliath and is depicted in various artworks holding the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;GOLIATH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Goliath is a biblical giant defeated by David, often depicted in artworks as a symbol of power and challenge."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;CARAVAGGIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Caravaggio is an Italian Baroque painter known for his dramatic use of light and shadow, and for his depiction of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;GIORGIONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giorgione was an Italian Renaissance painter whose work inspired Caravaggio's depiction of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;KUNSTHISTORISCHES MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kunsthistorisches Museum is an art museum in Vienna, Austria, where some of Caravaggio's works are displayed."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;PRADO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prado is a museum in Madrid, Spain, where some of Caravaggio's works are displayed."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the city where Caravaggio's David with the head of Goliath is located."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;VIENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vienna is the city where some of Caravaggio's works are located, including those in the Kunsthistorisches Museum."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;MADRID&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Madrid is the city where some of Caravaggio's works are located, including those in the Prado."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;LEONARDO DA VINCI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leonardo da Vinci was an Italian polymath whose works include depictions of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;UGO BOZZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ugo Bozzi was a publisher in Rome who published works related to Leonardo da Vinci."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;SAN DIEGO MUSEUM OF ART&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"San Diego Museum of Art is an art museum in San Diego, California, where a painting by Massimo Stanzione is exhibited."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;MRS. HARRY TURPIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mrs. Harry Turpin gifted a painting to the Fine Arts Gallery of San Diego, now the San Diego Museum of Art."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;MARIO MODESTINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario Modestini was an art historian who reattributed a painting by Massimo Stanzione to Stanzione in 1951."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;RIBERA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ribera was an artist whose work was initially attributed to a painting by Massimo Stanzione but later reattributed to Stanzione."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;MASSIMO STANZIONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Massimo Stanzione was an Italian Baroque painter known for his depiction of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;RIPLEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ripley is a production company involved in the TV series 'IV La Dolce Vita'."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;ENDEMOL SHINE NORTH AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Endemol Shine North America is a production company involved in the TV series 'IV La Dolce Vita'."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;G. BASCH ET AL.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"G. Basch et al. are executive producers of the TV series 'IV La Dolce Vita'."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;MICHAEL ONDAATJE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Ondaatje is an author known for his novel 'The English Patient', which includes a reference to David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;THE ENGLISH PATIENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The English Patient is a novel by Michael Ondaatje that references the artwork of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <node id="&quot;IV LA DOLCE VITA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"IV La Dolce Vita is a TV series episode that references the artwork of David with the head of Goliath."</data>
      <data key="d2">ramdocs-0175-d93a9769830d</data>
    </node>
    <edge source="&quot;DAVID&quot;" target="&quot;CARAVAGGIO&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Caravaggio depicted David with the head of Goliath, capturing the drama more effectively than previous artists."</data>
      <data key="d5">"dramatic portrayal, inspiration"</data>
      <data key="d6">ramdocs-0175-d93a9769830d</data>
    </edge>
  </graph>
</graphml>
