  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BRYAN SINGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bryan Singer is the legendary director of the original 'Pretty Woman' movie."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;J. F. LAWTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. F. Lawton is a screenwriter who worked on both the original 'Pretty Woman' movie and the musical adaptation."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;GARRY MARSHALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Garry Marshall is the legendary director of the original 'Pretty Woman' movie."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;PRETTY WOMAN: THE MUSICAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"PRETTY WOMAN: THE MUSICAL is a musical adaptation of the original 'Pretty Woman' movie, designed to lift spirits and light up hearts."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;EDWARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Edward is a character from the original 'Pretty Woman' movie, specifically mentioned in the context of the Director's Cut."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;VIVIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vivian is a character from the original 'Pretty Woman' movie, specifically mentioned in the context of the Director's Cut."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;CARLOS THE PIMP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Carlos the pimp is a character from the original 'Pretty Woman' movie, specifically mentioned in the context of the Director's Cut."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;THE DIRECTOR'S CUT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Director's Cut is a version of the 'Pretty Woman' movie that includes additional scenes and dialogue."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;PRETTY WOMAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pretty Woman refers to the setting and title of the original movie and its adaptations."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;MOVIE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"movie is a general term referring to the film industry and the original 'Pretty Woman' movie."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;SCREENPLAY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"screenplay is the written work that forms the basis of the movie and its adaptations."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;PIMP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"pimp is a role played by Carlos in the original 'Pretty Woman' movie."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;DIALOGUE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"dialogue is a part of the screenplay and is used in the movie and its adaptations."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;SCENES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"scenes are parts of the movie and its adaptations, including the Director's Cut."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;INTERVIEWS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"interviews are mentioned as a way to discuss the movie and its adaptations."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <node id="&quot;SEQUEL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"sequel is mentioned as a potential continuation of the original 'Pretty Woman' movie."</data>
      <data key="d2">rgb-0082</data>
    </node>
    <edge source="&quot;BRYAN SINGER&quot;" target="&quot;PRETTY WOMAN: THE MUSICAL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bryan Singer is associated with the original 'Pretty Woman' movie, which inspired the musical adaptation."</data>
      <data key="d5">"movie inspiration, legacy"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;J. F. LAWTON&quot;" target="&quot;PRETTY WOMAN: THE MUSICAL&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"J. F. Lawton contributed to both the original 'Pretty Woman' movie and the musical adaptation, indicating a consistent creative involvement."</data>
      <data key="d5">"creative continuity, collaboration"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;GARRY MARSHALL&quot;" target="&quot;PRETTY WOMAN: THE MUSICAL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Garry Marshall is also associated with the original 'Pretty Woman' movie, which inspired the musical adaptation."</data>
      <data key="d5">"movie inspiration, legacy"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;PRETTY WOMAN: THE MUSICAL&quot;" target="&quot;THE DIRECTOR'S CUT&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Director's Cut of 'Pretty Woman' includes additional scenes and dialogue that enhance the story, which is the basis for the musical adaptation."</data>
      <data key="d5">"story enhancement, inspiration"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;EDWARD&quot;" target="&quot;VIVIAN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Edward and Vivian are characters from the original 'Pretty Woman' movie, interacting in the Director's Cut."</data>
      <data key="d5">"character interaction, romance"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;EDWARD&quot;" target="&quot;CARLOS THE PIMP&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Carlos the pimp is a character from the original 'Pretty Woman' movie, interacting with Edward in the Director's Cut."</data>
      <data key="d5">"character interaction, supporting role"</data>
      <data key="d6">rgb-0082</data>
    </edge>
    <edge source="&quot;PRETTY WOMAN&quot;" target="&quot;MOVIE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Pretty Woman is the title and setting of the original movie and its adaptations."</data>
