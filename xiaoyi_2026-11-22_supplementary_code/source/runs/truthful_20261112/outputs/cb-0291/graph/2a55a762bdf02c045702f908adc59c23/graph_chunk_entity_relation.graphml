  <graph edgedefault="undirected">
    <node id="&quot;GAMLA STAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gamla Stan is the oldest district of Stockholm, known for its narrow alleys and winding streets, and is the setting for many historical events and connections."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;KLOCKGJUTARGRÄND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Klockgjutargránd is a narrow alley in Gamla Stan, originally called 'Bell Founder's Alley,' serving as a shortcut and evolving into a bustling commercial artery."&lt;SEP&gt;"Klockgjutargränd is a location in Stockholm that has become a tourist hotspot, connecting visitors to both medieval and modern times."&lt;SEP&gt;"Klockgjutargränd is a narrow alley in Gamla Stan, originally called 'Bell Founder's Alley,' serving as a shortcut and evolving into a bustling commercial artery."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;MYNTGATAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Myntgatan is a street in Gamla Stan named after the Royal Mint that once operated there, becoming a hub of commercial activity due to its strategic location."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;STOCKHOLM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockholm is a city known for its blend of medieval and modern elements, highlighted by the phenomenon at Klockgjutargränd."&lt;SEP&gt;"Stockholm is the capital city of Sweden, home to Gamla Stan and the site of Klockgjutargränd and Myntgatan."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;MONTREAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montreal is a city in Canada, specifically Montreal Central Station, connected to Klockgjutargränd through a mysterious phenomenon."&lt;SEP&gt;"Montreal is mentioned as a reference point for the modern-day aspect of the phenomenon at Klockgjutargränd."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;ANNA SVENSSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna Svensson is a Stockholm resident and local historian who discovered the mysterious connection between Klockgjutargränd and Montreal Central Station."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;PIERRE LAFLEUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre LaFleur is a Montreal resident and commuter who witnessed the mysterious appearance of people from Klockgjutargränd at Montreal Central Station."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a leading expert in quantum physics studying the phenomenon of the mysterious connection between Klockgjutargränd and Montreal Central Station."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;STOCKHOLM MUNICIPALITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stockholm Municipality is the governing body responsible for investigating the mysterious connection between Klockgjutargränd and Montreal Central Station."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sweden is a country in Northern Europe, home to Stockholm and its historic district Gamla Stan."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canada is a country in North America, home to Montreal and its Central Station."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;MONTREAL CENTRAL STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montreal Central Station is a major transportation hub in Montreal, Canada, connected to Klockgjutargränd through a mysterious phenomenon."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;ROYAL MINT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Mint operated on Myntgatan, contributing to the street's historical and economic significance."</data>
      <data key="d2">cb-0291</data>
    </node>
    <node id="&quot;SWEDISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Swedish Government is indirectly involved in the investigation of the mysterious connection through the Stockholm Municipality."</data>
