<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HFPA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"HFPA stands for the Hollywood Foreign Press Association, which is responsible for sending the Weekly Globe newsletter and awarding prizes."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;GG&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"GG likely refers to the Golden Globe Awards, an event organized by the Hollywood Foreign Press Association."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;WEEKLY GLOBE NEWSLETTER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Weekly Globe newsletter is a publication sent by HFPA, possibly related to the Golden Globe Awards."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;BEST ACTOR - MOTION PICTURE - DRAMA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Actor - Motion Picture - Drama is a category in the Golden Globe Awards."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;TELEVISION STARS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Television stars refer to notable personalities in the television industry who may win awards from the Hollywood Foreign Press Association."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;MOVIE ICONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Movie icons refer to famous actors and actresses who have achieved significant status in the film industry and may receive awards from the Hollywood Foreign Press Association."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;DIRECTING LEGENDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Directing legends refer to renowned directors who have made significant contributions to cinema and may win directing awards from the Hollywood Foreign Press Association."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;HOLLYWOOD FOREIGN PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hollywood Foreign Press is the organization that awards the Golden Globe Awards."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Awards refer to the accolades given by the Hollywood Foreign Press Association during the Golden Globe Awards ceremony."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;JAN 5, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Jan 5, 2020 is a specific date mentioned in relation to tracking awards from the Hollywood Foreign Press."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;MAY 5, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 5, 2020 is another specific date mentioned in relation to tracking awards from the Hollywood Foreign Press."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <node id="&quot;TRACKING&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Tracking refers to the process of monitoring and keeping records of award winners from the Hollywood Foreign Press Association."</data>
      <data key="d2">rgb-0047</data>
    </node>
    <edge source="&quot;HFPA&quot;" target="&quot;GG&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"HFPA organizes the GG (Golden Globe Awards) event."</data>
      <data key="d5">"award organization, event"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;WEEKLY GLOBE NEWSLETTER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"HFPA sends out the Weekly Globe newsletter."</data>
      <data key="d5">"newsletter distribution, communication"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;TELEVISION STARS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"HFPA awards television stars, recognizing their achievements in the television industry."</data>
      <data key="d5">"award recognition, industry recognition"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;MOVIE ICONS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"HFPA awards movie icons, recognizing their achievements in the film industry."</data>
      <data key="d5">"award recognition, industry recognition"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;DIRECTING LEGENDS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"HFPA awards directing legends, recognizing their achievements in directing."</data>
      <data key="d5">"award recognition, industry recognition"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;AWARDS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"HFPA awards the various categories of Awards during the Golden Globe Awards ceremony."</data>
      <data key="d5">"award recognition, event"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;HFPA&quot;" target="&quot;TRACKING&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Tracking is done to monitor the awards given by the Hollywood Foreign Press Association."</data>
      <data key="d5">"monitoring, record keeping"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;GG&quot;" target="&quot;BEST ACTOR - MOTION PICTURE - DRAMA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Best Actor - Motion Picture - Drama category is part of the GG (Golden Globe Awards) event."</data>
      <data key="d5">"category inclusion, event"</data>
      <data key="d6">rgb-0047</data>
    </edge>
    <edge source="&quot;AWARDS&quot;" target="&quot;TRACKING&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Tracking involves keeping records of the Awards given by the Hollywood Foreign Press Association."</data>
      <data key="d5">"record keeping, monitoring"</data>
      <data key="d6">rgb-0047</data>
    </edge>
  </graph>
</graphml>
