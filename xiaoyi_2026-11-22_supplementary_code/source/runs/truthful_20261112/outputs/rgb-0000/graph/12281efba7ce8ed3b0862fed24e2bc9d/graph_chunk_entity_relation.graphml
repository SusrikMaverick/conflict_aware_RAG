<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SUPER BOWL 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Super Bowl 2021 is scheduled to take place in two different locations, first in Glendale, Arizona, and then in Tampa, Florida."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;RAYMOND JAMES STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Raymond James Stadium is the venue for Super Bowl 2021 in Glendale, Arizona."&lt;SEP&gt;"Raymond James Stadium is the venue for Super Bowl 2021 in Tampa, Florida."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;GLENDALE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glendale is the initial location for Super Bowl 2021."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;ARIZONA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arizona is the state where the first leg of Super Bowl 2021 is held."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;TAMPA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tampa is the subsequent location for Super Bowl 2021."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;FLORIDA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florida is the state where the second leg of Super Bowl 2021 is held."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;SUPER BOWL LVIII&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Super Bowl LVIII is advertised for ticket packages in Las Vegas, with On Location as the source."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;LAS VEGAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Las Vegas is the location for Super Bowl LVIII according to the advertisement."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;ON LOCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"On Location is the organization advertising official ticket packages for Super Bowl LVIII in Las Vegas."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;FEB 7, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Feb 7, 2021 is the date mentioned for the announcement of Super Bowl 2021 and LVIII."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;TICKET PACKAGES&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Ticket Packages are available for Super Bowl LVIII, advertised by On Location."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;OFFICIAL SUPER BOWL LVIII TICKET PACKAGES&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Official Super Bowl LVIII Ticket Packages are available from On Location."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <node id="&quot;AD CAMPAIGN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An ad campaign is running to promote Super Bowl LVIII ticket packages in Las Vegas."</data>
      <data key="d2">rgb-0000</data>
    </node>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;RAYMOND JAMES STADIUM&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Super Bowl 2021 is initially scheduled to take place at Raymond James Stadium in Glendale, Arizona."&lt;SEP&gt;"Super Bowl 2021 is initially scheduled to take place at Raymond James Stadium in Tampa, Florida."</data>
      <data key="d5">"venue assignment, initial location"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;GLENDALE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Super Bowl 2021 is initially scheduled to take place in Glendale, Arizona."</data>
      <data key="d5">"location assignment, initial city"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;ARIZONA&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Super Bowl 2021 is initially scheduled to take place in the state of Arizona."</data>
      <data key="d5">"location assignment, initial state"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;TAMPA&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Super Bowl 2021 is subsequently scheduled to take place in Tampa, Florida."</data>
      <data key="d5">"location assignment, subsequent city"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;FLORIDA&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Super Bowl 2021 is subsequently scheduled to take place in the state of Florida."</data>
      <data key="d5">"location assignment, subsequent state"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL 2021&quot;" target="&quot;FEB 7, 2021&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Feb 7, 2021 is the date mentioned for the announcement of Super Bowl 2021 and LVIII."</data>
      <data key="d5">"announcement date, event"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL LVIII&quot;" target="&quot;LAS VEGAS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Super Bowl LVIII is advertised to take place in Las Vegas, with On Location as the source of ticket packages."</data>
      <data key="d5">"advertising, location assignment"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL LVIII&quot;" target="&quot;ON LOCATION&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"On Location is the organization advertising official ticket packages for Super Bowl LVIII in Las Vegas."</data>
      <data key="d5">"advertising, ticket package provider"</data>
      <data key="d6">rgb-0000</data>
    </edge>
    <edge source="&quot;SUPER BOWL LVIII&quot;" target="&quot;TICKET PACKAGES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Ticket Packages are available for Super Bowl LVIII, advertised by On Location."</data>
      <data key="d5">"product availability, event"</data>
      <data key="d6">rgb-0000</data>
    </edge>
  </graph>
