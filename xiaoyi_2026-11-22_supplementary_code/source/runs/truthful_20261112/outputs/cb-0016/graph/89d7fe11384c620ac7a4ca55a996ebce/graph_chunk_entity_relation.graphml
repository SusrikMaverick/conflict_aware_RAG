<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANDREA DARA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrea Dara is an Italian politician who has held the position of auxiliary bishop since 2015 and has recently been elected to the Chamber of Deputies of the Italian Republic."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;ROME, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome, Italy is the birthplace of Andrea Dara and the location of the Diocese of Rome and the Chamber of Deputies."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;DIOCESE OF ROME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Diocese of Rome is the religious jurisdiction where Andrea Dara served as a priest and later as auxiliary bishop."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;POPE BENEDICT XVI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Benedict XVI appointed Andrea Dara as the Vicar General of the Diocese of Rome in 2005."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;POPE FRANCIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Francis praised Andrea Dara's work and appointed him as auxiliary bishop in 2015."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;CORRIERE DELLA SERA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Corriere della Sera is an Italian newspaper that reported on Andrea Dara's work and appointment as auxiliary bishop."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;CATHOLIC NEWS AGENCY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Catholic News Agency reported on the increase in vocations to the priesthood in the Diocese of Rome due to Andrea Dara's efforts."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES OF THE ITALIAN REPUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chamber of Deputies of the Italian Republic is the lower house of the Italian Parliament where Andrea Dara has been elected to serve."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;PONTIFICAL LATERAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pontifical Lateran University is where Andrea Dara studied theology and earned a Bachelor's degree in 1988."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;WORLD YOUTH DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World Youth Day is an event organized by Andrea Dara during his tenure as Vicar General of the Diocese of Rome."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;JOURNAL OF CATHOLIC STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Catholic Studies published a study highlighting Andrea Dara's contributions to the Diocese of Rome."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rev. Dr. Maria Rossi is the author of a study on Andrea Dara's leadership and contributions to the Diocese of Rome."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;ALESSANDRO SPECIALE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alessandro Speciale is the author of an article praising Andrea Dara's work in the Diocese of Rome."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;HANNAH BROCKHAUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hannah Brockhaus is the author of an article noting the increase in vocations to the priesthood in the Diocese of Rome due to Andrea Dara's efforts."</data>
      <data key="d2">cb-0016</data>
    </node>
    <node id="&quot;UNIVERSITY OF ROME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Rome is the institution where Dr. Maria Rossi works as a political scientist."</data>
      <data key="d2">cb-0016</data>
    </node>
