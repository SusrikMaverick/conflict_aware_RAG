<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ALYTUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Alytus is a city in Lithuania that has a sister city relationship with Cádiz, Spain, and has seen significant cultural, educational, and economic growth due to this partnership."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;CÁDIZ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cádiz is a city in Spain that has a sister city relationship with Alytus, Lithuania, and has seen significant cultural, educational, and economic growth due to this partnership."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;ALYTUS MAYOR, VYTAUTAS GRIGARAVIČIUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vytautas Grigaravičius is the mayor of Alytus and has expressed the positive impacts of the sister city relationship on his city."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;JOSÉ MARÍA GONZÁLEZ SANTOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"José María González Santos is the mayor of Cádiz and has expressed the positive impacts of the sister city relationship on his city."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;CÁDIZ-ALYTUS CULTURAL FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Cádiz-Alytus Cultural Festival is an annual event that brings together artists, musicians, and performers from both cities, attracting thousands of visitors and generating significant revenue for local businesses."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;ALYTUS CHAMBER OF COMMERCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Alytus Chamber of Commerce reports that trade between Alytus and Cádiz has increased by 25% over the past five years, with a significant surge in exports of Lithuanian textiles and Spanish seafood."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;UNIVERSITY OF CÁDIZ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Cádiz has established joint educational programs with the Alytus University of Applied Sciences, including a student exchange initiative."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;UNIVERSITY OF WESTERN BRITTANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Western Brittany in Brest has established a joint program in naval engineering with the University of Cádiz."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;BREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brest is a port city in Brittany, France, that has a sister city relationship with Cádiz, Spain, and has seen significant cultural, educational, and economic growth due to this partnership."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;FRANÇOIS CUILLANDRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"François Cuillandre is the mayor of Brest and has expressed the positive impacts of the sister city relationship on his city."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;DR. MARÍA JESÚS RODRÍGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. María Jesús Rodríguez is the rector of the University of Cádiz and has discussed the benefits of the joint naval engineering program with the University of Western Brittany."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;EUROPEAN COMMISSION'S TWINNING DATABASE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Commission's Twinning Database provides funding for joint projects between Brest and Cádiz, including initiatives focused on sustainable urban development, cultural heritage preservation, and youth exchange programs."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;CÁDIZ, SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cádiz is a city in Spain that has a sister city relationship with Alytus, Lithuania, and has seen significant cultural, educational, and economic growth due to this partnership."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;ALYTUS UNIVERSITY OF APPLIED SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Alytus University of Applied Sciences has established joint educational programs with the University of Cádiz, including a student exchange initiative."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;BREST, FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brest is a port city in Brittany, France, that has a sister city relationship with Cádiz, Spain, and has seen significant cultural, educational, and economic growth due to this partnership."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;MARÍA JESÚS RODRÍGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"María Jesús Rodríguez is the rector of the University of Cádiz and has discussed the benefits of the joint naval engineering program with the University of Western Brittany."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;EUROPEAN COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Commission's Twinning Database provides funding for joint projects between Brest and Cádiz, including initiatives focused on sustainable urban development, cultural heritage preservation, and youth exchange programs."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;TWINNING DATABASE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Commission's Twinning Database provides funding for joint projects between Brest and Cádiz, including initiatives focused on sustainable urban development, cultural heritage preservation, and youth exchange programs."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;SUSTAINABLE URBAN DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Urban Development is one of the initiatives funded by the European Commission's Twinning Database for joint projects between Brest and Cádiz."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;CULTURAL HERITAGE PRESERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural Heritage Preservation is one of the initiatives funded by the European Commission's Twinning Database for joint projects between Brest and Cádiz."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;YOUTH EXCHANGE PROGRAMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Youth Exchange Programs are part of the initiatives funded by the European Commission's Twinning Database for joint projects between Brest and Cádiz."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;OUR CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Our city is the focal point of internationalization efforts and has benefited from partnerships that strengthen bonds between cities."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;PARTNERSHIP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A collaborative effort that has brought benefits to citizens and strengthened bonds between cities."&lt;SEP&gt;"The partnership is a collaborative effort that has brought benefits to citizens and strengthened bonds between cities."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;CITIZENS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Beneficiaries of the partnership and the internationalization efforts."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;TWO CITIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cities involved in the partnership that strengthens bonds between them."</data>
      <data key="d2">cb-0085</data>
    </node>
    <node id="&quot;ALYTUS, LITHUANIA&quot;">
      <data key="d2">cb-0085</data>
      <data key="d1">"Alytus and Cádiz have a sister city relationship that has brought significant cultural, educational, and economic benefits to both cities."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
