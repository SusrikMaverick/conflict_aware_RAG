  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JESSE C CRAIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jesse C Craig is a renowned researcher known for his contributions to the scientific community and medical research, with affiliations to both the University of Utah and Kaohsiung Chang Gung Memorial Hospital."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;UNIVERSITY OF UTAH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Utah is a public coeducational space-grant research university in Salt Lake City, Utah, United States, known for its commitment to academic excellence and groundbreaking research."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;KAOHSIUNG CHANG GUNG MEMORIAL HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kaohsiung Chang Gung Memorial Hospital is a medical institution in Taiwan, known for its commitment to excellence and patient care, and is now home to Jesse C Craig."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;SALT LAKE CITY, UTAH, UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salt Lake City, Utah, United States is the location of the University of Utah."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;TAIWAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Taiwan is a location known for its medical research and innovation, and is expected to benefit from Dr. Craig's leadership."&lt;SEP&gt;"Taiwan is the location of Kaohsiung Chang Gung Memorial Hospital."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;PRESTIGIOUS SCIENTIFIC JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prestigious Scientific Journal is an unspecified scientific publication where Jesse C Craig published a research paper co-authored with University of Utah researchers."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE DEPARTMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Materials Science Department is a department within the University of Utah where Jesse C Craig was involved in research activities."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;FREEDOM OF INFORMATION ACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Freedom of Information Act is a legal framework used to obtain emails between Jesse C Craig and University of Utah faculty members."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;MARCH 2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"March 2018 is the date of an email exchange between Jesse C Craig and Dr. Maria Rodriguez regarding a potential research project."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a professor of materials science at the University of Utah who collaborated with Jesse C Craig on research projects."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;DR. CHEN YI-HSIUNG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Chen Yi-Hsiung is the Superintendent of Kaohsiung Chang Gung Memorial Hospital and welcomes Jesse C Craig to the hospital."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;DR. WANG MEI-LING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Wang Mei-Ling is a colleague of Jesse C Craig at Kaohsiung Chang Gung Memorial Hospital who praises his dedication to research."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;SUPERINTENDENT OF KAOHSIUNG CHANG GUNG MEMORIAL HOSPITAL&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Superintendent of Kaohsiung Chang Gung Memorial Hospital is a role held by Dr. Chen Yi-Hsiung, responsible for overseeing the hospital's operations."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Research Center is a new initiative at Kaohsiung Chang Gung Memorial Hospital, led by Jesse C Craig, aimed at enhancing medical research capabilities."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer Research is a focus area of the hospital's research department, with ongoing projects involving Jesse C Craig."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;NEUROLOGICAL DISORDERS RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Neurological Disorders Research is another focus area of the hospital's research department, with ongoing projects involving Jesse C Craig."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;CLINICAL TRIALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Clinical Trials are a key aspect of the hospital's research efforts, with Jesse C Craig's work contributing to a 25% increase in success rates."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;PATIENT CARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Patient Care is a core value of Kaohsiung Chang Gung Memorial Hospital, aligned with Dr. Chen Yi-Hsiung's vision for the hospital."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;EXCELLENCE IN RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Excellence in Research is a commitment of both the University of Utah and Kaohsiung Chang Gung Memorial Hospital, driving their respective research agendas."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;DR. CRAIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Craig is settling into a new role and is expected to attract top talent, significantly impacting the medical community in Taiwan."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;MEDICAL COMMUNITY IN TAIWAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Medical Community in Taiwan is excited about Dr. Craig's arrival and his potential to enhance the region's reputation for medical research and innovation."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;NEW RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A new research center is being established, led by Dr. Craig, to further enhance Taiwan's reputation in medical research and innovation."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;IMPROVING HUMAN HEALTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Improving Human Health is the overarching goal that is described as contagious and is driving the excitement around Dr. Craig's arrival."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;CONTAGIOUS GOAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The goal of improving human health is described as contagious, indicating its widespread appeal and impact."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Hospital is mentioned as the institution where the new research center is being established."</data>
      <data key="d2">cb-0396</data>
    </node>
    <node id="&quot;TOP TALENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Top Talent is expected to be attracted by Dr. Craig's leadership, enhancing the hospital's and Taiwan's reputation."</data>
      <data key="d2">cb-0396</data>
    </node>
