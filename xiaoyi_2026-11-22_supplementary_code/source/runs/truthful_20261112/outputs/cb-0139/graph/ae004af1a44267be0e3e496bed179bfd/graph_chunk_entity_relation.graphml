  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UNIVERSITY OF UDINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Udine is a prestigious institution of higher learning in Udine, Italy, known for fostering academic excellence and research."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;ARIANNA BARCHIESI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arianna Barchiesi is a researcher with a deep connection to the University of Udine, having pursued her higher education there and contributed significantly to its academic fabric."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;UDINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Udine is a city in the Friuli-Venezia Giulia region of Italy, home to the University of Udine."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;FRIULI-VENEZIA GIULIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Friuli-Venezia Giulia is a region in northeastern Italy where the University of Udine is located."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;WARNER BROS. DISCOVERY NORDIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Warner Bros. Discovery Nordic is a research team based in Stockholm, Sweden, focused on Nordic television programming."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;STOCKHOLM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockholm is the capital city of Sweden where Arianna Barchiesi works at Warner Bros. Discovery Nordic."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;ÖSTERMALM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Östermalm is a district in Stockholm where Arianna Barchiesi's office is located."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;NORDIC NOIR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nordic Noir is a Scandinavian crime drama series that Arianna Barchiesi discusses with her colleague Lars."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;LARS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lars is a colleague of Arianna Barchiesi at Warner Bros. Discovery Nordic, discussing the merits of the Nordic Noir series."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;SWEDISH FISH&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Swedish Fish are candies that Arianna Barchiesi uses to fuel her late-night research sessions."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;RATINGS REPORTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Ratings reports are documents that Arianna Barchiesi reviews to shape the network's programming."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;POST-IT NOTES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Post-It notes are sticky notes used by Arianna Barchiesi to jot down reminders and questions during her research."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;COFFEE MUG&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A coffee mug with the Warner Bros. Discovery Nordic logo is a symbol of Arianna Barchiesi's affiliation with the organization."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;PROGRAMMING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Programming refers to the content and scheduling of television shows and other media produced by Warner Bros. Discovery Nordic."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;INNOVATIVE STORYTELLING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovative storytelling is a key aspect of the work done at Warner Bros. Discovery Nordic, emphasizing creativity and quality."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic excellence is a core value at the University of Udine, fostering a community of scholars and researchers."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;RESEARCH INITIATIVES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research initiatives are collaborative projects that involve multiple scholars and contribute to the university's reputation for innovation."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;TEACHING AND MENTORING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Teaching and mentoring are activities that Arianna Barchiesi engages in at the University of Udine, contributing to the next generation of scholars."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;STUDENT TESTIMONIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Student testimonials are feedback from students about Arianna Barchiesi's teaching and mentoring."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;COURSE EVALUATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Course evaluations are assessments of Arianna Barchiesi's teaching methods and effectiveness."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;SCANDINAVIAN CRIME DRAMAS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scandinavian crime dramas are a genre of television shows that Arianna Barchiesi studies and discusses with her colleagues."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;CULTURAL TAPESTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural tapestry refers to the rich cultural heritage and diversity of the Nordic region, which is a focus of Arianna Barchiesi's research."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;QUALITY PROGRAMMING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quality programming is a key goal of Warner Bros. Discovery Nordic, ensuring that their content meets high standards."</data>
      <data key="d2">cb-0139</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary research involves scholars from diverse backgrounds working together on projects, a hallmark of the University of Udine."</data>
      <data key="d2">cb-0139</data>
    </node>
    <edge source="&quot;UNIVERSITY OF UDINE&quot;" target="&quot;ARIANNA BARCHIESI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Arianna Barchiesi pursued her higher education at the University of Udine and has maintained a strong connection with the university throughout her career."</data>
      <data key="d5">"academic background, ongoing affiliation"</data>
      <data key="d6">cb-0139</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF UDINE&quot;" target="&quot;WARNER BROS. DISCOVERY NORDIC&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Both organizations are centers of academic and professional excellence, representing different stages of Arianna Barchiesi's career journey."</data>
      <data key="d5">"career progression, professional development"</data>
      <data key="d6">cb-0139</data>
    </edge>
    <edge source="&quot;ARIANNA BARCHIESI&quot;" target="&quot;WARNER BROS. DISCOVERY NORDIC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Arianna Barchiesi works at Warner Bros. Discovery Nordic in Stockholm, focusing on Nordic television programming."</data>
      <data key="d5">"professional affiliation, research focus"</data>
      <data key="d6">cb-0139</data>
    </edge>
    <edge source="&quot;ARIANNA BARCHIESI&quot;" target="&quot;NORDIC NOIR&quot;">
