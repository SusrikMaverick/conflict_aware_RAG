  <graph edgedefault="undirected">
    <node id="&quot;JORGE C. ROMAO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jorge C. Romao is a renowned researcher known for significant contributions to materials science, particularly at Oak Ridge National Laboratory and Instituto Superior Técnico."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;OAK RIDGE NATIONAL LABORATORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oak Ridge National Laboratory is a government research facility in Tennessee, USA, where Romao worked from 2007 to 2012, focusing on advanced materials for energy applications."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;UNIVERSITY OF TENNESSEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Tennessee is the institution where Romao earned his Ph.D. in 2005, with a dissertation on nanostructured materials."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Materials Science and Engineering is the field of study that Romao specializes in, focusing on mechanical properties and advanced material synthesis."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;INSTITUTO SUPERIOR TÉCNICO (IST)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Instituto Superior Técnico is a public school of engineering and technology in Portugal, where Romao is also known to have worked."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;EUROPEAN COMMISSION'S COMMUNITY RESEARCH AND DEVELOPMENT INFORMATION SERVICE (CORDIS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CORDIS is a service of the European Commission that provides information on research and development projects, listing Romao as a researcher at IST."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;JOURNAL OF ENGINEERING RESEARCH AND APPLICATIONS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Engineering Research and Applications is a scientific journal where Romao published a research paper on advanced materials."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;DIÁRIO DE NOTÍCIAS&quot;">
      <data key="d0">"MEDIA OUTLET"</data>
      <data key="d1">"Diário de Notícias is a Portuguese newspaper that reported on Romao's work at IST."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2005 is the year when Romao earned his Ph.D. in Materials Science and Engineering from the University of Tennessee."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2007 is the year when Romao joined Oak Ridge National Laboratory."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2010 is the year when Romao's study on 'High-Performance Thermoelectric Materials for Energy Harvesting' was published in Nature Materials."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;2011&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2011 is the year when Romao received the Early Career Award from the Department of Energy's Office of Science."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;NATURE MATERIALS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Nature Materials is a scientific journal where Romao's study on high-performance thermoelectric materials was published."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;DEPARTMENT OF ENERGY'S OFFICE OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Energy's Office of Science is the organization that presented the Early Career Award to Romao."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;THERMOELECTRIC MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Thermoelectric materials are the focus of Romao's research, particularly those with improved efficiency for waste heat recovery."</data>
      <data key="d2">cb-0048</data>
    </node>
    <node id="&quot;WASTE HEAT RECOVERY&quot;">
