  <graph edgedefault="undirected">
    <node id="&quot;GALLAGHER AMENDMENT INTERIM STUDY COMMITTEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gallagher Amendment Interim Study Committee is a committee that conducted an interim study, though specific details about its activities are not provided."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;COLORADO HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Colorado House of Representatives is a legislative body in Colorado, where Tate served as a representative from District 37."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;TATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tate is a Republican member of the Colorado House of Representatives, representing District 37 from 2014 until 2016, and later appointed to the state Senate."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;MICHAEL FIELDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Fields is a Republican who competed against Tate in the primary election for the Colorado House of Representatives in 2014."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;NANCY CRONK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nancy Cronk is a Democrat who competed against Tate in the general election for the Colorado House of Representatives in 2014."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;REPUBLICAN PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Republican Party is the political party that Tate belongs to and represented in the elections."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Democratic Party is the political party that Cronk belongs to and represented in the elections."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;CENTENNIAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Centennial is a city in Colorado where Jack Tate resides."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;JACK TATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jack Tate is a Republican senator in Colorado, accused of sexual harassment by a former legislative intern."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;LEGISLATIVE INTERN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Legislative Intern is a person who worked for the state legislature and accused Jack Tate of leering and making inappropriate comments."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;STATE SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"State Senate is the upper house of the Colorado state legislature where Tate was appointed after his term in the House of Representatives."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;ELECTIONS FOR THE COLORADO HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Elections for the Colorado House of Representatives took place in 2014, with primary and general elections."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;PRIMARY ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Primary Election is a part of the electoral process where candidates from the same party compete for the nomination to run in the general election."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;GENERAL ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"General Election is the final stage of the electoral process where candidates from different parties compete for public office."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;JUNE 24, 2014&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"June 24, 2014 is the date of the primary election for the Colorado House of Representatives."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;NOVEMBER 4, 2014&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 4, 2014 is the date of the general election for the Colorado House of Representatives."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;MARCH 31, 2014&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"March 31, 2014 is the deadline for signature filing for candidates running in the Colorado House of Representatives elections."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;THE DENVER POST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Denver Post is a news organization that reported on the allegations against Jack Tate."</data>
      <data key="d2">ramdocs-0066-da8a852f47ad</data>
    </node>
    <node id="&quot;KUNC&quot;">
      <data key="d0">"ORGANIZATION"</data>
