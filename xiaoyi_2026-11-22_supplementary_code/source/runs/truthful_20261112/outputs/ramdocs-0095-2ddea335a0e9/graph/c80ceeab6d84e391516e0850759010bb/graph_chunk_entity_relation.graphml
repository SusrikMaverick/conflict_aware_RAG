  <graph edgedefault="undirected">
    <node id="&quot;MUNSTER SCHOOLS SENIOR CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Munster Schools Senior Cup is an under-age rugby union competition for schools affiliated to the Munster Branch of the IRFU, established in 1909."</data>
      <data key="d2">ramdocs-0095-2ddea335a0e9</data>
    </node>
    <node id="&quot;IRFU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IRFU stands for Irish Rugby Football Union, which oversees the Munster Schools Senior Cup and sees schools rugby as a channel for player development."</data>
      <data key="d2">ramdocs-0095-2ddea335a0e9</data>
    </node>
    <node id="&quot;CORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cork is a city in Munster, Ireland, known for its strong participation in the Munster Schools Senior Cup."</data>
      <data key="d2">ramdocs-0095-2ddea335a0e9</data>
    </node>
    <node id="&quot;NENAGH ORMOND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nenagh Ormond is a school that won the Munster Senior Cup in a stunning second half performance."</data>
      <data key="d2">ramdocs-0095-2ddea335a0e9</data>
    </node>
    <node id="&quot;CONNACHT&quot;">
