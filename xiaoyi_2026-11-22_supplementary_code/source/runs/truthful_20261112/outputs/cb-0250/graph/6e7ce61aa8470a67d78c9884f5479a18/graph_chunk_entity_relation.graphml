  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MONTSERRAT ESTRUCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Montserrat Estruch is a researcher who attended the Autonomous University of Barcelona and conducted research at the University of Fort Hare East London Campus, making significant contributions to her field."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;AUTONOMOUS UNIVERSITY OF BARCELONA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Autonomous University of Barcelona is a public university located in Barcelona, Catalonia, Spain, where Montserrat Estruch studied and laid the foundation for her future research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;UNIVERSITY OF FORT HARE EAST LONDON CAMPUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The University of Fort Hare East London Campus is the place where Montserrat Estruch conducted her research, engaged in debates, and received guidance from her thesis advisor, Professor Mthembu."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;PROFESSOR MTHEMBU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Mthembu is Montserrat Estruch's thesis advisor at the University of Fort Hare East London Campus, offering her encouragement and support."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;BARCELONA, CATALONIA, SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barcelona, Catalonia, Spain is the location of the Autonomous University of Barcelona where Montserrat Estruch studied."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;ANCIENT TEXTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancient texts are the subject of Montserrat Estruch's research, providing historical and mythological insights."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;MYTHOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mythology is a key area of interest for Montserrat Estruch, intersecting with her historical research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"History is another focus of Montserrat Estruch's research, particularly in the context of mythology."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;DUSTY TOMES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Dusty tomes are the physical books and documents Montserrat Estruch used for her research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;NOTES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Notes are the written records and transcriptions Montserrat Estruch created during her research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;DESK LAMP&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A desk lamp was Montserrat Estruch's constant companion during her research, providing light for her work."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;STRONG COFFEE&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Strong coffee was a source of fuel for Montserrat Estruch during her late-night research sessions."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;MANUSCRIPTS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Manuscripts are the primary sources Montserrat Estruch studied, containing historical and mythological information."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;THICK, ROUND GLASSES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Thick, round glasses are the eyewear of Professor Mthembu, symbolizing his scholarly presence."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;DEBATES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Debates are a regular part of Montserrat Estruch's research process, involving discussions with her peers."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;THEORIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Theories are the intellectual constructs developed by Montserrat Estruch during her research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;ARGUMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Arguments are the refined positions Montserrat Estruch developed through her research and debates."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;CURSIVE SCRIPT&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"Cursive script is the handwriting style used by Montserrat Estruch for her notes and transcriptions."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;CARREL&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A carrel is the designated workspace where Montserrat Estruch conducted her research."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;SUMMER DAY&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"Summer day is referenced as a metaphor for the supportive environment provided by Professor Mthembu."</data>
      <data key="d2">cb-0250</data>
    </node>
    <node id="&quot;DOUBTERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Doubters are mentioned as a challenge Montserrat Estruch faced during her research journey."</data>
      <data key="d2">cb-0250</data>
    </node>
