    </node>
    <node id="&quot;LAHORE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lahore is the city where the 1963 film Shah Shikarpuri was released."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;PUNJAB&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Punjab is the region where the films Choorian (1998) and Shah Shikarpuri (1963) are set and produced."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;PAKISTAN&quot;">
      <data key="d0">"LOCATION"</data>
