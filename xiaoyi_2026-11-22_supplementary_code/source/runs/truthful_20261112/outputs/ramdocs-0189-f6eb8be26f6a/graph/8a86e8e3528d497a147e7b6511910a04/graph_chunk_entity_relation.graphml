      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;URDU&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Urdu is the language of the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;PUNJABI&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Punjabi is the language of both the 1963 film Shah Shikarpuri and the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
