  <graph edgedefault="undirected">
    <node id="&quot;CHOORIAN (1998 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Choorian (1998 film) is a 1998 Pakistani Punjabi-language action-romance-crime film directed by Syed Noor and produced by Haji Faqir Mohammad, starring Moammar Rana and Saima, and is Pakistan’s third highest-grossing domestic film of all-time."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;SYED NOOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Syed Noor is a director of the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;HAJI FAQIR MOHAMMAD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Haji Faqir Mohammad is a producer of the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;MOAMMAR RANA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Moammar Rana is an actor in the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;SAIMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saima is an actress in the 1998 film Choorian."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;BAKHTU&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Bakhtu is a character in the 1998 film Choorian, a city boy sent to live with his uncle in the village."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;BILLO&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Billo is a character in the 1998 film Choorian, the older daughter of the uncle and a servant in her own house."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;BAHAR&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Bahar is a character in the 1998 film Choorian, the stepmother who oversees Billo's chores."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;CHOORIAN (FILM FRANCHISE)&quot;">
      <data key="d0">"MOVIE FRANCHISE"</data>
      <data key="d1">"Choorian (film franchise) is a Pakistani franchise consisting of two films, one released in 1963 and another in 1998, both in Punjabi language."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;NASIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nasira is an actress mentioned in relation to the 1963 film Choorian, known as the 'vamp' and famous in Pakistani cinema."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;SHAH SHIKARPURI&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Shah Shikarpuri is a 1963 black and white Pakistani Punjabi language super-hit musical film, the first Pakistani film to receive an 'only for adults' rating by censors."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;TUFAIL FAROOQI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tufail Farooqi is the music composer of the 1963 film Shah Shikarpuri."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;BABA ALAM SIAHPOSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Baba Alam Siahposh is the lyricist of the 1963 film Shah Shikarpuri."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;SAEED KHAN RANGEELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saeed Khan Rangeela is an actor in the 1963 film Shah Shikarpuri."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;MAZHAR SHAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mazhar Shah is an actor in the 1963 film Shah Shikarpuri."</data>
      <data key="d2">ramdocs-0189-f6eb8be26f6a</data>
    </node>
    <node id="&quot;AKMAL KHAN&quot;">
