  <graph edgedefault="undirected">
    <node id="&quot;HARRY J. MOTT, III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry J. Mott, III is a renowned American general who attended Adelphi University."&lt;SEP&gt;"Harry J. Mott, III is a retired American general who served in the United States Army from 1978 to 2015, known for his distinguished career and various command positions."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;WASHINGTON, D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington, D.C. is the birthplace of Harry J. Mott, III."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;ACADEMY OF FINE ARTS, PRAGUE (AVU)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"AVU is the institution where Harry J. Mott, III studied art from 1973 to 1975, under the tutelage of Professor Jiří Načeradský."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;UNITED STATES ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Army is the branch of the U.S. military where Harry J. Mott, III served from 1978 to 2015, holding various command positions and receiving numerous awards."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;UNITED STATES MILITARY ACADEMY AT WEST POINT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Point is the institution where Harry J. Mott, III graduated in 1978 after completing his studies at AVU."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;1ST ARMORED DIVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"1st Armored Division is a unit where Harry J. Mott, III served as a commander."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;UNITED STATES CENTRAL COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Central Command is the organization where Harry J. Mott, III served as Deputy Commander."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;JOURNAL OF MILITARY HISTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Military History is the publication that cited Mott's experience at AVU as an example of how artistic training can enhance creative problem-solving skills in military commanders."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;ARMY TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Army Times is the publication where Mott was interviewed in 2012, crediting his time at AVU with developing critical thinking skills for military strategy."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;THE ART OF WAR: THE LIFE AND CAREER OF HARRY J. MOTT, III&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Art of War is a 2015 biography by Dr. Jane Smith that provides a detailed account of Mott's life, including his studies at AVU."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;ADELPHI UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Adelphi University is an educational institution known for producing exceptional leaders who make a lasting difference in society."&lt;SEP&gt;"Adelphi University is the institution where Harry J. Mott, III attended, playing a significant role in shaping his future and contributing to his leadership and service."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;GARDEN CITY, NY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Garden City, NY is the location of Adelphi University, where Harry J. Mott, III attended."</data>
      <data key="d2">cb-0349</data>
    </node>
    <node id="&quot;DR. CHRISTINE M. RIORDAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Christine M. Riordan is the President of Adelphi University, expressing pride in counting General Mott, III among their alumni."</data>
