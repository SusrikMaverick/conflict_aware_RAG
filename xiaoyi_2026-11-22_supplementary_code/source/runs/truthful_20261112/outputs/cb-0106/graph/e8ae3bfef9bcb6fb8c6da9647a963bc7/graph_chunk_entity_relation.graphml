    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;ORDER OF THE SWORD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Hideo Kojima is awarded the prestigious Order of the Sword for his contributions to the world of gaming."</data>
      <data key="d5">"award, recognition"</data>
