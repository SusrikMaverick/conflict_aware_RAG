<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HIDEO KOJIMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hideo Kojima is a renowned Japanese video game designer, director, and producer, known for his work on the Metal Gear series and recognized for his innovative spirit and dedication to storytelling."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;STOCKHOLM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockholm is the city where Hideo Kojima is summoned for a prestigious award, known for its rich history and elegant architecture."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;OLD TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Old Town is the area in Stockholm where Hideo Kojima steps out of the town car, characterized by cobblestone streets and a sense of historical significance."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;GRAND HÔTEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Grand Hôtel is the opulent hotel where Hideo Kojima is greeted by Count Carl Gustaf von Rosen and where the award ceremony takes place."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;COUNT CARL GUSTAF VON ROSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Count Carl Gustaf von Rosen is the Chancellor of the Order of the Sword, who greets Hideo Kojima and presents him with the prestigious award."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;ORDER OF THE SWORD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Order of the Sword is the organization that confers the prestigious award on Hideo Kojima, recognizing his contributions to the world of gaming."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;METAL GEAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Metal Gear is a groundbreaking game series created by Hideo Kojima, known for its unique blend of stealth gameplay and intricate storytelling."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;KONAMI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Konami is the Japanese video game developer where Hideo Kojima began his career in 1986."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;SETAGAYA, TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Setagaya, Tokyo is the birthplace of Hideo Kojima, where he developed an interest in writing and storytelling during his youth."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;BAFTA GAMES AWARDS 2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"BAFTA Games Awards 2020 is the event where Hideo Kojima received the Academy Fellowship Award, a prestigious honor in the video game industry."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;BRITISH ACADEMY OF FILM AND TELEVISION ARTS (BAFTA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"BAFTA is the organization that bestows the Academy Fellowship Award, recognizing Hideo Kojima's contributions to the video game industry."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;ACADEMY FELLOWSHIP AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Academy Fellowship Award is a prestigious honor given by BAFTA to individuals who have made significant contributions to the art and craft of games."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2020 is the year when Hideo Kojima received the Academy Fellowship Award at the BAFTA Games Awards."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;GAMESINDUSTRY.BIZ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GamesIndustry.biz is a news site that reported on Hideo Kojima's receipt of the BAFTA Fellowship Award."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;IGN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IGN is a media company that reported on Hideo Kojima's receipt of the BAFTA Fellowship Award."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;BBC NEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"BBC News is a news organization that reported on Hideo Kojima's receipt of the BAFTA Fellowship Award."</data>
      <data key="d2">cb-0106</data>
    </node>
    <node id="&quot;METAL GEAR SOLID&quot;">
      <data key="d2">cb-0106</data>
      <data key="d1">"Hideo Kojima is the creator of the Metal Gear Solid series, showcasing his significant contributions to the video game industry."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;VIDEO GAME INDUSTRY&quot;">
      <data key="d2">cb-0106</data>
      <data key="d1">"The Academy Fellowship Award is given to individuals who have made significant contributions to the video game industry."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;WIKIPEDIA ENTRY&quot;">
      <data key="d2">cb-0106</data>
      <data key="d1">"The Wikipedia entry provides comprehensive information about Hideo Kojima, including his career and achievements."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;STOCKHOLM&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Hideo Kojima is summoned to Stockholm for a prestigious award, highlighting the significance of the city in his career."</data>
      <data key="d5">"summon, recognition"</data>
      <data key="d6">cb-0106</data>
    </edge>
    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;OLD TOWN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Hideo Kojima steps out of the town car in the Old Town, setting the scene for the award ceremony."</data>
      <data key="d5">"arrival, setting"</data>
      <data key="d6">cb-0106</data>
    </edge>
    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;GRAND HÔTEL&quot;">
      <data key="d3">18.0</data>
