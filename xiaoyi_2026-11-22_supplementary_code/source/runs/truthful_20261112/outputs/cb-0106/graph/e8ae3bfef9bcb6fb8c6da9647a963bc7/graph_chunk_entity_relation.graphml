    </edge>
    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;METAL GEAR&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Hideo Kojima is known for creating the groundbreaking game series Metal Gear, which set a new standard in the industry."</data>
      <data key="d5">"creation, innovation"</data>
      <data key="d6">cb-0106</data>
    </edge>
    <edge source="&quot;HIDEO KOJIMA&quot;" target="&quot;KONAMI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hideo Kojima began his career at Konami in 1986, marking the start of his journey in the video game industry."</data>
      <data key="d5">"career start, recognition"</data>
      <data key="d6">cb-0106</data>
    </edge>
