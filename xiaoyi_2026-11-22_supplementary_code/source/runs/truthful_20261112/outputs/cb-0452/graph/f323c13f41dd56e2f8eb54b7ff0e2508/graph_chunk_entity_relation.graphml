    </node>
    <node id="&quot;NAZIA SULEMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nazia Suleman is a renowned researcher with a strong academic background, recognized for her contributions to sustainable energy solutions and cutting-edge materials for renewable energy applications."</data>
