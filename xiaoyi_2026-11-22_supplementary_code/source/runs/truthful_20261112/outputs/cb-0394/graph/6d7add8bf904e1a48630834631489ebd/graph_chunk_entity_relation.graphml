  <graph edgedefault="undirected">
    <node id="&quot;YANE-SHIH WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yane-Shih Wang is a renowned researcher in public administration, known for her work on bureaucratic reform and policy implementation. She was born in Taipei, Taiwan, and pursued her higher education in France at the École nationale d'administration (ENA). Her research includes seminal works on administrative reforms and the impact of ENA alumni on French public policy."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;TAIPEI, TAIWAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Taipei, Taiwan is the birthplace of Yane-Shih Wang."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;ÉCOLE NATIONALE D'ADMINISTRATION (ENA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"École nationale d'administration (ENA) is a prestigious institution where Yane-Shih Wang studied from 1997 to 1999 and was an active participant in the school's debate club."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;BUREAUCRATIC INERTIA: A COMPARATIVE STUDY OF ADMINISTRATIVE REFORMS IN FRANCE AND TAIWAN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bureaucratic Inertia: A Comparative Study of Administrative Reforms in France and Taiwan is a seminal work by Yane-Shih Wang published in 2005."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;JOURNAL OF PUBLIC ADMINISTRATION RESEARCH AND THEORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Public Administration Research and Theory is the publication where Yane-Shih Wang's study 'ENA's Legacy: An Examination of the Role of ENA Alumni in Shaping French Public Policy' was published in 2010."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;TEXAS A&amp;M UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Texas A&amp;M University is a public research institution where Yane-Shih Wang pursued advanced studies and conducted research, aligning with the university's strengths in engineering, agriculture, and life sciences."</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;LE MONDE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Le Monde is a French newspaper that reported on the role of women at the École nationale d'administration (ENA</data>
      <data key="d2">cb-0394</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1975 is the birthdate of Yane-Shih Wang."</data>
      <data key="d2">cb-0394</data>
    </node>
