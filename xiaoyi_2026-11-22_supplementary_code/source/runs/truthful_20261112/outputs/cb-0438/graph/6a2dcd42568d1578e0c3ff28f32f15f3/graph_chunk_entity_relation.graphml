    <edge source="&quot;GERSTNEROVA&quot;" target="&quot;CHOMUTOV&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Gerstnerova street runs through the historic center of Chomutov, a city with a rich cultural heritage."</data>
      <data key="d5">"location, cultural significance"</data>
      <data key="d6">cb-0438</data>
    </edge>
    <edge source="&quot;GERSTNEROVA&quot;" target="&quot;FRANZ JOSEF GERSTNER&quot;">
