      <data key="d4">"Gerstnerova street was also named after the physicist Franz Josef Gerstner in the late 19th century."</data>
      <data key="d5">"honor, recognition"</data>
      <data key="d6">cb-0438</data>
    </edge>
    <edge source="&quot;CHOMUTOV&quot;" target="&quot;2002 FLOODS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The 2002 Floods inspired the naming of Gerstnerova street, reflecting the city's resilience and history of overcoming challenges."</data>
      <data key="d5">"resilience, inspiration"</data>
      <data key="d6">cb-0438</data>
    </edge>
    <edge source="&quot;CHOMUTOV&quot;" target="&quot;NEROVA STREET&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Nerova Street is located in the city of Chomutov."</data>
      <data key="d5">"location, named after"</data>
      <data key="d6">cb-0438</data>
    </edge>
    <edge source="&quot;CHOMUTOV&quot;" target="&quot;FRANZ JOSEF GERSTNER&quot;">
      <data key="d3">14.0</data>
