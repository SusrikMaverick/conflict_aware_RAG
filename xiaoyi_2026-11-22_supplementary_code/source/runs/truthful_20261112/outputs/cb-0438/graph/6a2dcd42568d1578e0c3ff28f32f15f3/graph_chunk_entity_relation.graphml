<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GERSTNEROVA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gerstnerova is a street located in Chomutov, Czech Republic, named in honor of the 2011 album 'Fallen Empires' by Snow Patrol and also named after the physicist Franz Josef Gerstner."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;CHOMUTOV&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chomutov is a city in the Czech Republic known for its rich cultural heritage and historical events, including the 2002 floods."&lt;SEP&gt;"Chomutov is a city where Nerova Street is located."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;SNOW PATROL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Snow Patrol is a Northern Irish rock band whose 2011 album 'Fallen Empires' inspired the naming of Gerstnerova street."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;JIŘÍ KRÁL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jiří Král is a local music enthusiast and city councilor who initiated the naming of Gerstnerova street in honor of Snow Patrol's 'Fallen Empires'."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;FRANZ JOSEF GERSTNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franz Josef Gerstner was a Czech physicist and mathematician of great renown, after whom Nerova Street is named."&lt;SEP&gt;"Franz Josef Gerstner was a Czech physicist, mathematician, and engineer who made significant contributions to mechanics, optics, and astronomy."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;2002 FLOODS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2002 Floods were a significant historical event in Chomutov that inspired the naming of Gerstnerova street."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;CHOMUTOVSKÝ DENÍK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chomutovský deník is a local newspaper that published an interview with Jiří Král about the naming of Gerstnerova street."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;UNIVERSITY OF WEST BOHEMIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of West Bohemia conducted a study on the impact of the naming of Gerstnerova street on the local community."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;JOURNAL OF URBAN PLANNING AND DEVELOPMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Urban Planning and Development is the publication where the study on the impact of the naming of Gerstnerova street was published."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;DR. JANA ŠŤASTNÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jana Šťastná is a historian at the Chomutov Regional Museum who provided insights into Franz Josef Gerstner's contributions."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;ING. PAVEL ČERNÝ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ing. Pavel Černý is the Mayor of Chomutov who expressed pride in having a street named after Franz Josef Gerstner."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;ART NOUVEAU BUILDINGS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Art Nouveau buildings line the streets of Chomutov, including Gerstnerova street, reflecting the city's architectural heritage."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;CHOMUTOV REGIONAL MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chomutov Regional Museum is a historical institution that houses artifacts and provides insights into the city's past."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;HISTORICAL EVENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Historical events, such as the 2002 floods, have influenced the naming and significance of Gerstnerova street."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;LOCAL RESIDENTS AND INTELLECTUALS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Local residents and intellectuals petitioned for the naming of Gerstnerova street in the late 19th century."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;PETITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A petition was submitted to the city council requesting the naming of Gerstnerova street after Franz Josef Gerstner."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;NEROVA STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nerova Street is a street named after Franz Josef Gerstner, located in Chomutov."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;CZECH PHYSICIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Czech physicist describes the role of Franz Josef Gerstner, a renowned scientist."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;CZECH MATHEMATICIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Czech mathematician describes the role of Franz Josef Gerstner, a renowned scientist."</data>
      <data key="d2">cb-0438</data>
    </node>
    <node id="&quot;RENOWN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Renown refers to the high regard and recognition Franz Josef Gerstner received during his lifetime."</data>
      <data key="d2">cb-0438</data>
    </node>
