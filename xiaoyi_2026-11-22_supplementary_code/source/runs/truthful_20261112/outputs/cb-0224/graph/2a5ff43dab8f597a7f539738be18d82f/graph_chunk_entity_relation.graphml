      <data key="d1">"The University of Manchester is an educational institution where Raquel A Villamizar has recently joined as a researcher in the biology department."</data>
      <data key="d2">cb-0224</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a researcher at the University of Manchester, working on genetic mutations and facing challenges with funding."</data>
