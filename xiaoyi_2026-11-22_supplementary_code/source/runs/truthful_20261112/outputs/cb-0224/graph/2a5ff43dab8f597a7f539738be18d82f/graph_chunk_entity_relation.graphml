  <graph edgedefault="undirected">
    <node id="&quot;RAQUEL A VILLAMIZAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Raquel A Villamizar is a researcher affiliated with the University of Pamplona and the University of Manchester, known for her work in microbiology and genetic mutations."</data>
      <data key="d2">cb-0224</data>
    </node>
    <node id="&quot;UNIVERSITY OF PAMPLONA&quot;">
