<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KSGF-FM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KSGF-FM is a radio station broadcasting a News Talk Information format, licensed to Ash Grove, Missouri, and serving the Springfield, Missouri area. It has gone through several ownership changes and has a history of different call signs and formats."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;ASH GROVE, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ash Grove, Missouri is the primary license location for KSGF-FM, a radio station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;SPRINGFIELD, MISSOURI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Springfield, Missouri is the primary service area for KSGF-FM, a radio station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;SUMMITMEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SummitMedia is the current owner of KSGF-FM and owns sister stations KRVI, KSGF, KSPW, and KTTS-FM."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;JOURNAL COMMUNICATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal Communications was part of the merger that led to the ownership of KSGF-FM by E. W. Scripps Company."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;E. W. SCRIPPS COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"E. W. Scripps Company was involved in the merger that led to the ownership of KSGF-FM, but later exited radio operations."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;FOX NEWS RADIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fox News Radio is an affiliation of KSGF-FM, providing programming to the station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;PREMIERE NETWORKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Premiere Networks is another affiliation of KSGF-FM, providing programming to the station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;RADIO AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Radio America is an affiliation of KSGF-FM, providing programming to the station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;WESTWOOD ONE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Westwood One is an affiliation of KSGF-FM, providing programming to the station."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KRVI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KRVI is a sister station of KSGF-FM, owned by SummitMedia."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KSPW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KSPW is a sister station of KSGF-FM, owned by SummitMedia."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KTTS-FM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KTTS-FM is a sister station of KSGF-FM, owned by SummitMedia."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KGBX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KGBX is the original call sign of KSGF-FM, which launched in 1926 and changed to KSGF-FM in 1994."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KZPD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KZPD was a former call sign of KSGF-FM from 1990 to 1996."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KQMO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KQMO was a former call sign of KSGF-FM from 1996 to 1998."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KZRQ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KZRQ was a former call sign of KSGF-FM from 1998 to 2003."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;NICK REED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Reed hosts the local morning show 'KSGF Mornings with Nick Reed' on KSGF-FM."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KORTNI TUCKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kortni Tucker is the executive producer of the local morning show 'KSGF Mornings with Nick Reed' on KSGF-FM."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;SPRINGCOM, INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Springcom, Inc. was involved in the sale of KSGF-FM to KGBX Communications, Inc. in 1986."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;KGBX COMMUNICATIONS, INC.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KGBX Communications, Inc. was involved in the sale of KSGF-FM to Springcom, Inc. in 1986."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;FCC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Federal Communications Commission (FCC) is the licensing authority for KSGF-FM and other radio stations."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;MARCH 1, 1994&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"KSGF-FM first aired on March 1, 1994, under the call sign KZPD."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;JANUARY 1985&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In January 1985, KGBX began broadcasting in AM stereo using the Motorola C-QUAM system."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;FEBRUARY 25, 2014&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Journal Communications and the E. W. Scripps Company announced on July 30, 2014, that the two companies would merge to create a new broadcast company under the E. W. Scripps Company name that owned the two companies' broadcast properties, including KSGF-FM. The transaction was completed in 2015, pending shareholder and regulatory approvals."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <node id="&quot;MARCH 8, 2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Scripps exited radio in 2018; the Springfield stations went to SummitMedia in a four-market, $47 million deal."</data>
      <data key="d2">ramdocs-0251-f9dac6bf0467</data>
    </node>
    <edge source="&quot;KSGF-FM&quot;" target="&quot;ASH GROVE, MISSOURI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"KSGF-FM is licensed to Ash Grove, Missouri, indicating its primary location."</data>
      <data key="d5">"licensing, location"</data>
      <data key="d6">ramdocs-0251-f9dac6bf0467</data>
    </edge>
    <edge source="&quot;KSGF-FM&quot;" target="&quot;SPRINGFIELD, MISSOURI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"KSGF-FM serves the Springfield, Missouri area, indicating its primary service area."</data>
      <data key="d5">"service area, broadcasting"</data>
      <data key="d6">ramdocs-0251-f9dac6bf0467</data>
    </edge>
    <edge source="&quot;KSGF-FM&quot;" target="&quot;SUMMITMEDIA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"SummitMedia is the current owner of KSGF-FM, indicating its ownership status."</data>
      <data key="d5">"ownership, current"</data>
      <data key="d6">ramdocs-0251-f9dac6bf0467</data>
    </edge>
  </graph>
</graphml>
