      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;INDIVIDUAL PRIVACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The concept of individual privacy as it relates to data retention policies, highlighted in the thesis."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;NATIONAL SECURITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The concept of national security as it relates to data retention policies, balanced against individual privacy."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;TERRORISM AND ORGANIZED CRIME&quot;">
      <data key="d0">"ISSUE"</data>
      <data key="d1">"Issues addressed by the Data Retention Directive, such as combating terrorism and organized crime."</data>
