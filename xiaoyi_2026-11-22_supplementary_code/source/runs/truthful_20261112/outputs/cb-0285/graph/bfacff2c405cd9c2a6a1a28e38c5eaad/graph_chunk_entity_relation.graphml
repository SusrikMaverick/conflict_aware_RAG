    <node id="&quot;DATA RETENTION PRACTICES&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Practices related to data retention, discussed in the context of EU member states."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;CITIZENS' RIGHTS&quot;">
      <data key="d0">"RIGHT"</data>
      <data key="d1">"Rights of EU citizens as they relate to data retention policies, emphasized in the thesis and by experts."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;PROPORTIONALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The principle of proportionality in data retention policies, ensuring that measures are appropriate and necessary."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;TRANSPARENCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The importance of transparency in data retention policies, ensuring that citizens understand how their data is retained."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;MONITORING AND ENFORCEMENT&quot;">
