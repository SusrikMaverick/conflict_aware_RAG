    <node id="&quot;DATA PROTECTION REFORM&quot;">
      <data key="d0">"REFORM"</data>
      <data key="d1">"Reforms needed in data protection policies, advocated by MEP Jan Philipp Albrecht."</data>
      <data key="d2">cb-0285</data>
