  <graph edgedefault="undirected">
    <node id="&quot;DATA RETENTION IN THE TELECOMMUNICATIONS FIELD: ANALYSIS OF ITS REGULATION IN THE EUROPEAN UNION AND ITS FIT INTO EU LAW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A master's thesis analyzing data retention regulations in the European Union, written in Spanish and focusing on the legal fit within EU law."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;UNIVERSITY OF CARLOS III OF MADRID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A Spanish university located in Madrid, known for its academic programs, including a master's program in telecommunications law."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;MADRID&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The capital city of Spain, home to the University of Carlos III of Madrid."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;EUROPEAN UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A political and economic union of 27 member states that regulate various aspects of data retention in the telecommunications field."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A country where the University of Carlos III of Madrid is located, and where the thesis is written in the Spanish language."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The capital city of Belgium, where the event of experts weighing in on EU data retention laws took place."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A leading expert in EU data protection law, commenting on the complexities of data retention policies."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;MEP JAN PHILIPP ALBRECHT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A vocal advocate for data protection reform, urging for proactive approaches to monitoring and enforcing data retention practices."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;EUROPEAN COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The executive branch of the European Union, responsible for proposing legislation, implementing decisions, and upholding the EU treaties."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;DATA RETENTION DIRECTIVE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A directive introduced in 2006 to standardize data retention practices across EU member states, aimed at combating terrorism and organized crime."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;SPANISH LANGUAGE&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"The language used in the master's thesis, indicating the academic and cultural context."</data>
      <data key="d2">cb-0285</data>
    </node>
    <node id="&quot;TELECOMMUNICATIONS FIELD&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"The field of study for the master's thesis, focusing on data retention regulations."</data>
