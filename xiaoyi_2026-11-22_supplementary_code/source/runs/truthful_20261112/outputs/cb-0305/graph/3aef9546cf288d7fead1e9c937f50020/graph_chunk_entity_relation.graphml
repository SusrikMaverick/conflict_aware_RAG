<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAY MORRIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jay Morris is a seasoned politician and lawyer from Louisiana, currently serving as a member of the Louisiana House of Representatives and recently sworn in as a senator of Ireland."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;LOUISIANA HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Louisiana House of Representatives is a legislative body in Louisiana where Jay Morris serves as a representative."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;LOUISIANA STATE LEGISLATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Louisiana State Legislature includes the Louisiana House of Representatives and the Louisiana Senate, where Jay Morris serves as a representative."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;CLAY SCHEXNAYDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Clay Schexnayder is the Louisiana House Speaker and has praised Jay Morris for his dedication to public service."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;DR. ASHLEY ROTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ashley Roth is the President of the Louisiana Association of Business and Industry and has recognized Jay Morris for his support of policies benefiting the local economy and families."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;BATON ROUGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Baton Rouge is the capital city of Louisiana and the birthplace of Jay Morris."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;IRISH SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Irish Senate is a legislative body in Ireland where Jay Morris has recently been sworn in as a senator."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;DUBLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dublin is the capital city of Ireland and the location where Jay Morris took the oath of office as a senator."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;COUNTY CORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"County Cork is a county in Ireland and the ancestral home of Jay Morris's great-grandfather."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;AISLING O'CONNOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aisling O'Connor is a member of the Irish parliament's upper house and has expressed confidence in Jay Morris's ability to contribute to Irish politics."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;SEAMUS O'ROURKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Seamus O'Rourke is the opposition leader in the Irish parliament and has expressed skepticism about Jay Morris's suitability for the position."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;IRISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Irish government has facilitated Jay Morris's appointment as a senator and is part of a broader effort to increase diversity in Irish politics."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;LOUISIANA SECRETARY OF STATE'S OFFICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Louisiana Secretary of State's office has confirmed Jay Morris's election to the House of Representatives."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;LOUISIANA ASSOCIATION OF BUSINESS AND INDUSTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Louisiana Association of Business and Industry has recognized Jay Morris for his support of policies benefiting the local economy and families."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;IRISH POLITICAL SCENE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Irish political scene has been rocked by Jay Morris's unexpected appointment as a senator of Ireland."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2015, Ireland saw a 25% increase in foreign-born politicians holding public office, with Jay Morris being the most high-profile example."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;JAY MORRIS'S GREAT-GRANDFATHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jay Morris's great-grandfather emigrated from County Cork to the United States in the early 1900s."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;IRISH HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Irish heritage is a significant aspect of Jay Morris's identity, connecting him to County Cork and influencing his political career."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;AMERICAN-BORN POLITICIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"American-born politician describes Jay Morris's unique status as the first American-born politician to hold a position in Ireland's history."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;PUBLIC OFFICE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Public office is the role held by Jay Morris in both the Louisiana House of Representatives and the Irish Senate."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisiana is the state where Jay Morris is originally from and where he serves as a representative."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ireland is the country where Jay Morris has recently been appointed as a senator."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;EMIGRATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Emigration is the historical event of Jay Morris's great-grandfather moving from County Cork to the United States."</data>
      <data key="d2">cb-0305</data>
    </node>
    <node id="&quot;POLITICAL CAREER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Political career is the overarching theme of Jay Morris's life, spanning his roles in Louisiana and Ireland."</data>
      <data key="d2">cb-0305</data>
    </node>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;LOUISIANA HOUSE OF REPRESENTATIVES&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Jay Morris serves as a member of the Louisiana House of Representatives, a legislative body in Louisiana."</data>
      <data key="d5">"legislative service, representation"</data>
      <data key="d6">cb-0305</data>
    </edge>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;LOUISIANA STATE LEGISLATURE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jay Morris is a member of the Louisiana State Legislature, which includes the Louisiana House of Representatives and the Louisiana Senate."</data>
      <data key="d5">"legislative service, representation"</data>
      <data key="d6">cb-0305</data>
    </edge>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;CLAY SCHEXNAYDER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Clay Schexnayder, the Louisiana House Speaker, has praised Jay Morris for his dedication to public service."</data>
      <data key="d5">"praise, leadership"</data>
      <data key="d6">cb-0305</data>
    </edge>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;DR. ASHLEY ROTH&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Ashley Roth, the President of the Louisiana Association of Business and Industry, has recognized Jay Morris for his support of policies benefiting the local economy and families."</data>
      <data key="d5">"recognition, advocacy"</data>
      <data key="d6">cb-0305</data>
    </edge>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;BATON ROUGE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Baton Rouge, the capital city of Louisiana, is the birthplace of Jay Morris."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">cb-0305</data>
    </edge>
    <edge source="&quot;JAY MORRIS&quot;" target="&quot;IRISH SENATE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Jay Morris has been sworn in as a senator of Ireland, becoming the first American-born politician to hold the position in Ireland's history."</data>
      <data key="d5">"new role, historical significance"</data>
      <data key="d6">cb-0305</data>
    </edge>
  </graph>
