  <graph edgedefault="undirected">
    <node id="&quot;MONKEY GRIP (FILM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Monkey Grip (film) is a 1982 Australian drama film directed by Ken Cameron and produced by Patricia Lovell, based on the novel by Helen Garner."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;KEN CAMERON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ken Cameron is the director of the film 'Monkey Grip' and attempted to secure funding for the project in 1979."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;PATRICIA LOVELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patricia Lovell is the producer of the film 'Monkey Grip' and helped secure funding for the project."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;HELEN GARNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Helen Garner is the author of the novel 'Monkey Grip' and the screenplay for the film adaptation."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;NONI HAZELHURST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Noni Hazelhurst is an actress who starred in the film 'Monkey Grip'."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;COLIN FRIELS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colin Friels is an actor who starred in the film 'Monkey Grip' as a heroin addict."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;1982 CANNES FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The film 'Monkey Grip' was screened in the Un Certain Regard section of the 1982 Cannes Film Festival."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;AUSTRALIAN DRAMA FILM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Australian drama film refers to the genre of the film 'Monkey Grip', which is a drama film set in Australia."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;MELBOURNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Melbourne is the setting for both the novel and the film 'Monkey Grip', representing the city's bohemian scene in the 1970s."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;NORA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nora is the protagonist of the novel 'Monkey Grip', a single-mother who narrates her tumultuous relationship and life challenges."</data>
      <data key="d2">ramdocs-0167-0a2fa6420467</data>
    </node>
    <node id="&quot;HEROIN ADDICT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Heroin addict is a character in the novel and film 'Monkey Grip', representing a significant aspect of the narrative."</data>
