    <node id="&quot;LAWRENCE (BROWN COUNTY, WISCONSIN)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lawrence is a town in Brown County, Wisconsin, with a population growth from 1,548 in 2000 to 4,284 in 2010, and further to 6,306 in 2020. It is located along the west bank of the Fox River.")</data>
