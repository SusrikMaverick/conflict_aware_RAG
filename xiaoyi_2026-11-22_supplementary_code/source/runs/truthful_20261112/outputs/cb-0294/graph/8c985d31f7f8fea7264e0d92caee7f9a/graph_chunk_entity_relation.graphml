      <data key="d3">8.0</data>
      <data key="d4">"Manuel da Cruz is familiar with the villagers and their respectful demeanor, indicating a long-standing relationship."</data>
      <data key="d5">"familiarity, respect"</data>
      <data key="d6">cb-0294</data>
    </edge>
    <edge source="&quot;MANUEL DA CRUZ&quot;" target="&quot;CHÂTEAU DE LA ROCHE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Manuel da Cruz is summoned to the Château de la Roche by the Comte, indicating a professional relationship."</data>
      <data key="d5">"summon, professional relationship"</data>
      <data key="d6">cb-0294</data>
    </edge>
    <edge source="&quot;MANUEL DA CRUZ&quot;" target="&quot;MONSIEUR LE COMTE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Manuel da Cruz is summoned by Monsieur le Comte, who is known for his generosity and justice, indicating a trusting relationship."</data>
      <data key="d5">"trust, summons"</data>
      <data key="d6">cb-0294</data>
    </edge>
    <edge source="&quot;MANUEL DA CRUZ&quot;" target="&quot;SOPHIE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Manuel da Cruz is informed about Sophie's disappearance, indicating a concern for the community and a duty to assist."</data>
      <data key="d5">"concern, duty"</data>
      <data key="d6">cb-0294</data>
    </edge>
    <edge source="&quot;MONSIEUR LE COMTE&quot;" target="&quot;ANCIENS CADRES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Monsieur le Comte is known for his generosity and justice, and he has the anciens cadres serving his family, indicating a supportive relationship."</data>
      <data key="d5">"support, service"</data>
      <data key="d6">cb-0294</data>
    </edge>
    <edge source="&quot;MONSIEUR DUPONT&quot;" target="&quot;ANCIENS CADRES&quot;">
