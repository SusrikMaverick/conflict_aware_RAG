  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MANUEL DA CRUZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Manuel da Cruz is a Portuguese prelate and Catholic priest known for his piety and dedication to his congregation."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;RURAL FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rural France is the setting where the events take place, specifically a small village and the Château de la Roche."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The village is a small settlement where Manuel da Cruz is familiar with the villagers and their respectful demeanor."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;CHÂTEAU DE LA ROCHE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Château de la Roche is the residence of Monsieur le Comte, where Manuel da Cruz is summoned and where the anciens cadres are present."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;MONSIEUR LE COMTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsieur le Comte is the local lord known for his generosity and justice, and he requests Manuel da Cruz's presence."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;MONSIEUR DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsieur Dupont is the Comte's trusted advisor and one of the anciens cadres."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;MONSIEUR LAFLEUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsieur LaFleur is the château's master gardener and another member of the anciens cadres."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;SOPHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophie is a young woman who has gone missing, causing her family and the Comte great distress."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;ANCIENS CADRES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anciens cadres is a socio-professional category of experienced professionals who have served the Comte and his family for generations."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;SUN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The sun is mentioned as setting over the rolling hills, indicating the time of day."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;ROLLING HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rolling hills are part of the landscape of rural France, where the events take place."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;PORTUGUESE PRELATE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Portuguese prelate is a role held by Manuel da Cruz, referring to his religious position."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;CATHOLIC PRIEST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Catholic priest is a role held by Manuel da Cruz, referring to his religious duties."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;PRIESTLY ROBES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Priestly robes are the clothing Manuel da Cruz wears, indicating his role as a priest."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;COBBLESTONE PAVEMENT&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Cobblestone pavement is the surface Manuel da Cruz walks on, indicating the physical setting."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;VILLAGERS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Villagers are the people living in the small village, showing respect to Manuel da Cruz."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;COMTE'S TRUSTED ADVISOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Comte's trusted advisor is a role held by Monsieur Dupont, indicating his position of trust."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;MASTER GARDENER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Master gardener is a role held by Monsieur LaFleur, indicating his expertise in gardening."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;YOUNG WOMAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Young woman is a role held by Sophie, indicating her age and status as a villager."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;MISSING PERSON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Missing person is the event involving Sophie, causing distress to her family and the Comte."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;WINDING STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winding streets are part of the village's layout, where Manuel da Cruz walks."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;OAK DESK&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Oak desk is the furniture where the Comte sits, indicating his office or meeting place."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;APPOINTMENT OF MANUEL DA CRUZ AS VICAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Appointment of Manuel da Cruz as vicar is a historical event, indicating his role in the parish."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;DIOCESE OF LISBON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Diocese of Lisbon is the ecclesiastical jurisdiction where Manuel da Cruz served as a priest."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;PORTUGAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portugal is the country of origin for Manuel da Cruz, where he received his education and served as a priest."</data>
      <data key="d2">cb-0294</data>
    </node>
    <node id="&quot;SEMINARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seminary is the educational institution where Manuel da Cruz received his theological and philosophical education."</data>
      <data key="d2">cb-0294</data>
    </node>
