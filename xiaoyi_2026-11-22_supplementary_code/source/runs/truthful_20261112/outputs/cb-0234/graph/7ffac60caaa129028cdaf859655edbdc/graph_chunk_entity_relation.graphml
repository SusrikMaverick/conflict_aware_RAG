  <graph edgedefault="undirected">
    <node id="&quot;KIRSTY EVERETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kirsty Everett is a member of the British peerage, born into a family of noble lineage, known for her accomplishments and philanthropic work. She has found love with Geoffrey Mark Brown."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;GEOFFREY MARK BROWN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Geoffrey Mark Brown is a man of humble beginnings, known for his wit, determination, and strong work ethic. He has formed a bond with Kirsty Everett based on shared interests and values."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;EVERETT ESTATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Everett Estate is a picturesque location in the English countryside where Kirsty Everett's private ceremony took place."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;LADY KIRSTY EVERETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Kirsty Everett is the daughter of the 12th Earl of Wiltshire and a member of the British peerage, known for her philanthropic work in education and women's empowerment."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;ANN ELIZABETH BADGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ann Elizabeth Badger is a renowned philanthropist and humanitarian, known for her tireless efforts in supporting marginalized communities and her organization, the Badger Foundation."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;REVEREND JAMES THOMPSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Reverend James Thompson officiated the ceremony for Lady Kirsty Everett and Ann Elizabeth Badger."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;UK OFFICE FOR NATIONAL STATISTICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The UK Office for National Statistics provides data on same-sex marriages in the UK."&lt;SEP&gt;"The UK Office for National Statistics provides data on same-sex marriages, indicating its role in tracking such events."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;BRITISH PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British peerage is a system of nobility in the United Kingdom, where lineage and heritage hold significant sway."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;12TH EARL OF WILTSHIRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The 12th Earl of Wiltshire is the father of Lady Kirsty Everett and a member of the British peerage."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;BADGER FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Badger Foundation is an organization founded by Ann Elizabeth Badger, which supports marginalized communities."</data>
      <data key="d2">cb-0234</data>
    </node>
    <node id="&quot;LOCAL CHILDREN'S HOSPITAL&quot;">
      <data key="d0">"LOCATION"</data>
