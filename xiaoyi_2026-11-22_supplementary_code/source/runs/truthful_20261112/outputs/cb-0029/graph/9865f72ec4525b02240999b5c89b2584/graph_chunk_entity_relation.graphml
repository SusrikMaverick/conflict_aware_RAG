<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;OBJECTIVE, BURMA!&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Objective, Burma! is a 1945 film known for its gripping narrative, realistic portrayal of war, and thought-provoking themes, recognized for its Best Story at the Academy Awards."&lt;SEP&gt;"Objective, Burma! is a 1945 war film directed by Raoul Walsh, starring Errol Flynn, and telling the story of Allied soldiers on a mission to destroy a Japanese radar station in Burma during World War II."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;THE GAME AWARDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Game Awards is an annual event that recognizes excellence in video game development and design, including categories such as 'Best Ongoing' and 'Best Story'."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;GEOFF KEIGHLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Geoff Keighley is the creator of The Game Awards and expressed shock at the nomination of 'Objective, Burma!' in the 'Best Ongoing' category."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;RAOUL WALSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Raoul Walsh was a veteran film director known for his work on 'Objective, Burma!', a 1945 war film."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;ERROL FLYNN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Errol Flynn was an actor who starred in the 1945 war film 'Objective, Burma!'."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;INTERN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"An intern at the awards organization mistakenly nominated 'Objective, Burma!' for the 'Best Ongoing' category due to confusion with a fictional video game of the same name."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;GEOFFREY KEIGHLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Geoffrey Keighley is another reference to Geoff Keighley, the creator of The Game Awards."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;THE HOUSE ON 92ND STREET&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The House on 92nd Street is a 1945 film that was also nominated for the Academy Award for Best Story in 1946."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;THE AFFAIRS OF SUSAN&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Affairs of Susan is a 1945 film that was also nominated for the Academy Award for Best Story in 1946."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;ALVAH BESSIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alvah Bessie was the screenwriter of 'Objective, Burma!', known for his realistic portrayal of war and exploration of the human cost of conflict."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;LEONARD MALTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leonard Maltin is a film historian and critic who praised the screenplay of 'Objective, Burma!' for its attention to detail and balance of action and drama."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;ACADEMY OF MOTION PICTURE ARTS AND SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Academy of Motion Picture Arts and Sciences is a professional organization that administers the Academy Awards and recognizes excellence in the film industry."&lt;SEP&gt;"The Academy of Motion Picture Arts and Sciences is the organization responsible for the Academy Awards, which recognized 'Objective, Burma!' with a nomination for Best Story."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;ACADEMY AWARD FOR BEST STORY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Academy Award for Best Story is an accolade given by the Academy of Motion Picture Arts and Sciences to recognize outstanding storytelling in a film."&lt;SEP&gt;"The Academy Award for Best Story is an award given by the Academy of Motion Picture Arts and Sciences for outstanding work in screenwriting."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;DISTRIBUTOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The film's distributor is mentioned as a party interested in introducing the film to a new generation."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;SOCIAL MEDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Social Media is the platform where users expressed confusion and amusement about the nomination of 'Objective, Burma!' in the 'Best Ongoing' category."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;@GAMINGGURU22&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"@GamingGuru22 is a Twitter user who expressed confusion about the nomination of 'Objective, Burma!' in the 'Best Ongoing' category."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;@FILMFAN42&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"@FilmFan42 is a Twitter user who joked about the possibility of a video game adaptation of 'Objective, Burma!'"</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;VIDEO GAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A video game of the same name as 'Objective, Burma!' caused the mix-up with the actual film."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;WAR FILM GENRE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"War Film Genre is the category that 'Objective, Burma!' belongs to, characterized by stories of war and conflict."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;RADAR STATION&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Radar Station is the target of the mission in 'Objective, Burma!', a Japanese radar station in Burma."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;JAPANESE RADAR STATION&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Japanese Radar Station is the specific target of the mission in 'Objective, Burma!', a radar station in Burma."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;WAR GENRE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"War genre refers to films that focus on military conflicts and their impact, often characterized by realistic portrayals and gripping narratives."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;GRIPPING NARRATIVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gripping narrative describes a compelling and engaging storyline that captures the audience's attention."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;REALISTIC PORTRAYAL OF WAR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Realistic portrayal of war refers to accurate and detailed depiction of military conflicts, often based on historical events or real-life experiences."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;THOUGHT-PROVOKING THEMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Thought-provoking themes are ideas or subjects within the film that challenge the audience's thinking and provoke discussion."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;ENDURING LEGACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Enduring legacy refers to the lasting impact and recognition of the film over time."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;REALISTIC PORTRAYAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Realistic portrayal refers to the accurate and detailed depiction of events or scenarios."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;1945&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1945 refers to the year in which the film was released, marking a significant period in history."</data>
      <data key="d2">cb-0029</data>
    </node>
    <node id="&quot;CINEMATIC STORYTELLING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cinematic storytelling refers to the art of telling stories through film, capturing the essence of the narrative and its impact."</data>
      <data key="d2">cb-0029</data>
    </node>
    <edge source="&quot;OBJECTIVE, BURMA!&quot;" target="&quot;THE GAME AWARDS&quot;">
      <data key="d3">17.0</data>
      <data key="d4">"Objective, Burma! was mistakenly nominated for The Game Awards' 'Best Ongoing' category due to a mix-up with a fictional video game of the same name."&lt;SEP&gt;"The Game Awards announced that they would revoke the nomination and replace it with a new contender after realizing the mistake."</data>
      <data key="d5">"mistaken nomination, mix-up"&lt;SEP&gt;"retraction, correction"</data>
      <data key="d6">cb-0029</data>
    </edge>
