  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHARLES HOWARD HODGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Howard Hodges was a Dutch painter born in 1764 and died in 1837, known for his portraits, landscapes, and genre scenes, particularly in London and Italy."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;ROTTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rotterdam is the birthplace of Charles Howard Hodges, located in the Netherlands."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the capital and largest city of England and the United Kingdom, where Charles Howard Hodges established himself as a prominent painter in the late 1780s."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is where Charles Howard Hodges studied under the tutelage of the renowned painter, Piter Louw."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;ROYAL ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Academy is an organization where Charles Howard Hodges became a member and exhibited his works regularly at the Academy's annual exhibitions."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;KENT'S DIRECTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kent's Directory is a source listing Charles Howard Hodges as a resident of London in 1794."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;POST OFFICE ANNUAL DIRECTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Post Office Annual Directory is a source listing Charles Howard Hodges as a resident of London in 1814."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;THE MORNING CHRONICLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Morning Chronicle is a newspaper mentioning Charles Howard Hodges' exhibitions and artistic achievements in London."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;THE GENTLEMAN'S MAGAZINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Gentleman's Magazine is a newspaper mentioning Charles Howard Hodges' exhibitions and artistic achievements in London."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;NATIONAL PORTRAIT GALLERY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Portrait Gallery in London is a museum where some of Charles Howard Hodges' works can be found today."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy is a country known for its rich cultural landscape, attracting a growing number of international artists and creatives."&lt;SEP&gt;"Italy is the location where Charles Howard Hodges has been working on a new series of masterpieces since several months ago, inspired by the country's landscapes and cultural heritage."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the city where Charles Howard Hodges has been working and where his new works will be unveiled at a prestigious gallery later this year."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;TUSCAN EARTH PIGMENTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Tuscan earth pigments are local materials used by Charles Howard Hodges to create a sense of place and authenticity in his Italian works."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;VENETIAN GLASS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Venetian glass is another local material used by Charles Howard Hodges to create a sense of place and authenticity in his Italian works."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;PITER LOUW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Piter Louw is a renowned painter who taught Charles Howard Hodges in Amsterdam."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;FRANCIS HODGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francis Hodges is the father of Charles Howard Hodges, who was also a painter and provided early training to Charles."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1764-1837&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the lifespan of Charles Howard Hodges, spanning from his birth in 1764 to his death in 1837."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1792-1836&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the period during which Charles Howard Hodges participated in the Royal Academy's annual exhibitions."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1794&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the year mentioned in Kent's Directory as the year Charles Howard Hodges was listed as a resident of London."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1814&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the year mentioned in Post Office Annual Directory as the year Charles Howard Hodges was listed as a resident of London."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1795&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the year mentioned in The Morning Chronicle as the year Charles Howard Hodges' exhibitions and artistic achievements were mentioned."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;1837&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the year mentioned in The Gentleman's Magazine as the year Charles Howard Hodges' exhibitions and artistic achievements were mentioned."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;19TH-CENTURY ART&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"19th-century art is the context in which Charles Howard Hodges' work is discussed, particularly in relation to his new direction in Italy."&lt;SEP&gt;"19th-century art is the field of expertise for Dr. Sophia Patel, relating to the artist Hodges and his creative work."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a leading expert on 19th-century art, providing insights into an artist's work."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;HODGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hodges is an artist known for tapping into a new vein of creativity, drawing attention from experts and the cultural scene."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;ITALIAN MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Italian Ministry of Culture provides data on the influx of international artists to Italy, highlighting the country's appeal."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;UTTERLY CAPTIVATING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The phrase 'utterly captivating' describes the impact of the artist's work, indicating its profound effect on viewers or critics."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;NEW VEIN OF CREATIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A new vein of creativity refers to the unique and innovative approach Hodges is taking in his art, distinguishing it from traditional methods."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;DEEPLY PERSONAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Deeply personal describes the emotional and individual nature of Hodges' work, suggesting a strong personal connection."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;UNIVERSALLY RELATABLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Universally relatable indicates that Hodges' work resonates with a wide audience, transcending individual experiences."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"History refers to the rich historical context of Italy, which influences the cultural landscape and attracts artists."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;BEAUTY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Beauty describes the aesthetic qualities of Italy's cultural landscape, which are appealing to artists."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;INSPIRATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Inspiration refers to the creative spark that Italy provides, driving artists to create and innovate."</data>
      <data key="d2">cb-0160</data>
    </node>
    <node id="&quot;HODGES'">
      <data key="d2">cb-0160</data>
      <data key="d1">"The phrase 'utterly captivating' describes the impact of Hodges' work, indicating its profound effect on viewers or critics."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ITALY'">
      <data key="d2">cb-0160</data>
      <data key="d1">"History refers to the rich historical context of Italy, which influences the cultural landscape and attracts artists."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
