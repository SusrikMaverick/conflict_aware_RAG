  <graph edgedefault="undirected">
    <node id="&quot;RENOWNED METEOROLOGIST HALVOR SOLBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Halvor Solberg is a renowned meteorologist known for accurate weather forecasts and a charismatic on-screen presence, nominated for the Golden Raspberry Award for Worst Actress."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;GOLDEN RASPBERRY AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Golden Raspberry Award is an accolade that 'honors' the worst films, actors, and actresses of the year, where Halvor Solberg was nominated for Worst Actress."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;NORWAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Norway is the country where Halvor Solberg is based and where he is a household name, known for his meteorological work."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;OSLO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oslo is the city where Halvor Solberg was born and where he pursued his education and career."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;FJORD FRENZY&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Fjord Frenzy is a low-budget Norwegian film where Halvor Solberg made his acting debut, leading to a Razzie nomination."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a climate scientist at the University of Oslo who comments on Solberg's nomination, stating it is a distraction from his real contributions."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;ERIK JENSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Erik Jensen is a film critic from the Oslo Times who commented on Solberg's performance in 'Fjord Frenzy', describing it as cringe-worthy."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;UNIVERSITY OF OSLO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Oslo is where Halvor Solberg studied and later worked, earning his Ph.D. and holding various academic positions."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;NORWEGIAN METEOROLOGICAL INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Norwegian Meteorological Institute is where Halvor Solberg served as director from 1946 to 1965."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;NOBEL PRIZE IN PHYSICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Nobel Prize in Physics is a prestigious award given annually for outstanding contributions to physics."&lt;SEP&gt;"The Nobel Prize in Physics is an award Halvor Solberg was nominated for in 1934 for his work on atmospheric electricity and weather forecasting."</data>
      <data key="d2">cb-0334</data>
    </node>
    <node id="&quot;HALVOR SOLBERG NOMINATED FOR GOLDEN RASPBERRY AWARD&quot;">
