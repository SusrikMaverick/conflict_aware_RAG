    <node id="&quot;THE LOVE ALBUM&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"The Love Album is an album by John Hartford, released in 1968, and later reissued in 2002. It is also referenced as a tribute album by Taylor Swift in 2003."</data>
      <data key="d2">ramdocs-0133-2153ce7b1a43</data>
    </node>
    <node id="&quot;JOHN HARTFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Hartford is a musician known for his solo albums and collaborations, including 'The Love Album' and 'Looks at Life'."</data>
      <data key="d2">ramdocs-0133-2153ce7b1a43</data>
    </node>
    <node id="&quot;RCA&quot;">
      <data key="d0">"ORGANIZATION"</data>
