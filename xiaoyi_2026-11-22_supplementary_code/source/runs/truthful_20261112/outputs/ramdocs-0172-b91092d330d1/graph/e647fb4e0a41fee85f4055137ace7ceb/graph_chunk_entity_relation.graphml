  <graph edgedefault="undirected">
    <node id="&quot;LYUDMILA BRAGINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lyudmila Bragina is a retired Russian athlete who competed in the 1500 m at the 1972 and 1976 Olympics, setting world records and winning gold in 1972."</data>
      <data key="d2">ramdocs-0172-b91092d330d1</data>
    </node>
    <node id="&quot;VALERI BRAGIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Valeri Bragin is a retired Russian ice hockey player and former coach of the HC CSKA Moscow team in the KHL, starting his career with HC Spartak Moscow and playing for Khimik Voskresensk before moving to Denmark."</data>
      <data key="d2">ramdocs-0172-b91092d330d1</data>
    </node>
    <node id="&quot;SOVIET UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Soviet Union is the country Lyudmila Bragina represented in the Olympics and where she achieved her athletic records."</data>
