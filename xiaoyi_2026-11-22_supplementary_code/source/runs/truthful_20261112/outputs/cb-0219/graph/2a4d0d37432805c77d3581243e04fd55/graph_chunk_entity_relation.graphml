  <graph edgedefault="undirected">
    <node id="&quot;YOSHITAKA WATANABE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yoshitaka Watanabe is a Japanese midfielder who has recently joined AS Kasserine and is becoming a fan favorite, known for his skill and work ethic."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;AS KASSERINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AS Kasserine is a football club based in Kasserine, Tunisia, where Yoshitaka Watanabe is now playing and feels a sense of pride and belonging."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;KASSERINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kasserine is a city in Tunisia where AS Kasserine is located, and where Yoshitaka Watanabe is currently playing."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;STADE DE KASSERINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stade de Kasserine is the stadium of AS Kasserine, where Yoshitaka Watanabe practices and plays matches."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;CAFÉ DES SPORTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Café des Sports is a local café in Kasserine where Yoshitaka Watanabe often visits, and where he is greeted warmly by the owner, Amine."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;AMINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amine is the owner of Café des Sports, a gruff but kind-hearted man who greets Yoshitaka Watanabe warmly and serves him mint tea."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;VEGALTA SENDAI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vegalta Sendai is a Japanese football club where Yoshitaka Watanabe played for many years before joining AS Kasserine."&lt;SEP&gt;"Vegalta Sendai is a football club where Watanabe played and became a key player, participating in over 150 matches and scoring 20 goals."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;TUNISIAN FAITHFUL&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Tunisian faithful refers to the supporters of AS Kasserine who have embraced Yoshitaka Watanabe as a fan favorite."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;J.LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"J.League is the top tier of professional football in Japan, where Yoshitaka Watanabe made his professional debut for Vegalta Sendai."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;MEDITERRANEAN HORIZON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mediterranean horizon is the setting where the sun sets, casting a warm orange glow over the dusty streets of Kasserine, Tunisia."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;ANCIENT MEDINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ancient medina is the area in Kasserine where Yoshitaka Watanabe emerges from the shadows, known for its winding alleys and historical significance."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;DUSTY STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dusty streets are the pathways in Kasserine where Yoshitaka Watanabe walks, reflecting the city's traditional charm."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;SPICES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Spices are a scent that wafts through the air in Kasserine, adding to the city's cultural atmosphere."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;FRESHLY BAKED BREAD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Freshly baked bread is another scent that wafts through the air in Kasserine, contributing to the city's culinary charm."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;CHILDREN'S LAUGHTER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Children's laughter is a sound that mixes with the bustling sounds of the city, creating a lively atmosphere."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;BUSTLING SOUKS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bustling souks are the markets in Kasserine where the city's commerce takes place, adding to the vibrant atmosphere."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;CRAGGY WALLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Craggy walls are the crumbling concrete walls of the Stade de Kasserine, bearing the scars of countless matches and passionate fans."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;JAPANESE ASSOCIATION FOOTBALL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Japanese association football is the sport in which Yoshitaka Watanabe competes, highlighting his dedication and commitment."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;FOOTBALL CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A general term for sports organizations, specifically referring to Vegalta Sendai in this context."&lt;SEP&gt;"Football club is a type of organization where Yoshitaka Watanabe plays, such as AS Kasserine and Vegalta Sendai."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;FOOTBALL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Football is the sport in which Yoshitaka Watanabe excels, known for his skill and work ethic."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;ORANGE AND BLACK JERSEY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Orange and black jersey is the iconic uniform worn by Vegalta Sendai, representing the club's identity."</data>
      <data key="d2">cb-0219</data>
    </node>
    <node id="&quot;TELEVISION&quot;">
