<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BRONWEN MACDONALD MILNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bronwen MacDonald Milner is a woman of refined taste and intellect, passionate about botany and the arts, and is married to Jeremy Neville Stopford. She is known for her deep and devoted love for Annie Macgregor Lyle."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;ANNIE MACGREGOR LYLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Annie Macgregor Lyle is Bronwen's partner, mentioned with a tenderness and devotion that hints at a deep and abiding love."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;JEREMY NEVILLE STOPFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeremy Neville Stopford is Bronwen's husband, identified by his Peerage person ID 229865."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;SCOTTISH HIGHLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Scottish Highlands are the setting where Bronwen lived and wrote about, known for its heather-covered moors and tranquil lochs."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;EDINBURGH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Edinburgh is the city where Bronwen and Annie hosted salons, gathering intellectuals and artists for discussions on literature and science."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;PEERAGE.COM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peerage.com is a reliable online database of British peerage and aristocracy, confirming Bronwen's marriage to Jeremy Neville Stopford."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;THEPEERAGE.COM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ThePeerage.com is another trusted online resource for British peerage and nobility, also confirming Bronwen's marriage to Jeremy Neville Stopford."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;BURKE'S PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Burke's Peerage, a renowned publication on British genealogy and peerage, lists Bronwen MacDonald Milner as the wife of Jeremy Neville Stopford."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;DUSTY ARCHIVES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Dusty Archives are the setting where the narrator finds the peculiar letter, filled with yellowed papers and forgotten memories."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;HEATHER-COVERED MOORS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Heather-Covered Moors are the setting where Bronwen and Annie are imagined to stroll, symbolizing their intimate and romantic connection."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;TRANQUIL LOCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tranquil Loch is the location where Annie is imagined to recite poetry, creating a serene and romantic atmosphere."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;SALON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Salon is the gathering place where Bronwen and Annie host intellectuals and artists, discussing literature and science."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;INTELLECTUALS AND ARTISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Intellectuals and Artists are the guests at the salons hosted by Bronwen and Annie, engaging in discussions on various topics."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;LITERATURE AND SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Literature and Science are the subjects of discussion at the salons hosted by Bronwen and Annie, reflecting their intellectual pursuits."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;BRITISH PEERAGE AND ARISTOCRACY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"British Peerage and Aristocracy is the domain of Bronwen MacDonald Milner and Jeremy Neville Stopford, as evidenced by their marriage records."</data>
      <data key="d2">cb-0261</data>
    </node>
    <node id="&quot;CREDIBLE SOURCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Credible Sources such as Peerage.com, ThePeerage.com, and Burke's Peerage provide evidence of Bronwen MacDonald Milner's marriage to Jeremy Neville Stopford."</data>
      <data key="d2">cb-0261</data>
    </node>
