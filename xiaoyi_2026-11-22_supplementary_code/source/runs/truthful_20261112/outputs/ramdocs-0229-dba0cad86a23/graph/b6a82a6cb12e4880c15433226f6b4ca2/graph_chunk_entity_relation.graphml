  <graph edgedefault="undirected">
    <node id="&quot;CROSS OF LIBERTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cross of Liberty is a medal established by the Prime Minister of Estonia, Konstantin Päts, to honor services during the Estonian War of Independence, with three grades and three classes."</data>
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
    </node>
    <node id="&quot;GRADE I&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Grade I is the highest grade of the Cross of Liberty, awarded for military leadership."</data>
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
    </node>
    <node id="&quot;ESTONIA&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The Cross of Liberty was established and awarded in Estonia, honoring services during the Estonian War of Independence."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ESTONIAN WAR OF INDEPENDENCE&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The Cross of Liberty was established to honor services during the Estonian War of Independence."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;LION OF FINLAND&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The White Rose of Finland and the Lion of Finland have a joint board, indicating a collaborative relationship between the two orders."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;WHITE ROSE OF FINLAND&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The White Rose of Finland and the Lion of Finland have a joint board, indicating a collaborative relationship between the two orders."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;GENERAL C. G. E. MANNERHEIM&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The Order of the Cross of Liberty was founded upon the initiative of General C. G. E. Mannerheim in 1918."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ORDER OF THE CROSS OF LIBERTY&quot;">
      <data key="d2">ramdocs-0229-dba0cad86a23</data>
      <data key="d1">"The Order of the Cross of Liberty was founded upon the initiative of General C. G. E. Mannerheim in 1918."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
