<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NAKAMURA KENZABURO XVII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nakamura Kenzaburo XVII is a Japanese actor and kabuki performer, the 17th generation of the Nakamura Kenzaburo line, known for his contributions to kabuki and Japanese culture."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is the birthplace of Nakamura Kenzaburo XVII and the setting for much of his early career."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;NAKAMURA KENZABURO XVI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nakamura Kenzaburo XVI is the father of Nakamura Kenzaburo XVII and a previous generation of the Nakamura Kenzaburo line."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;KABUKI&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Kabuki is a traditional form of Japanese theater that Nakamura Kenzaburo XVII performs in and is part of his lineage."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;ORDER OF CULTURE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Order of Culture is a Japanese honor awarded to individuals who have made significant contributions to Japanese culture, including literature, art, music, and drama."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;2011&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2011 is the year Nakamura Kenzaburo XVII was awarded the Order of Culture."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;2001&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2001 is the year Nakamura Kenzaburo XVII received the Grand Cross of the Civil Order of Alfonso XII."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;AKIRA KUROSAWA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Akira Kurosawa is a renowned Japanese filmmaker who directed 'The Whispering Winds of Winter,' in which Nakamura Kenzaburo XVII starred."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;THE WHISPERING WINDS OF WINTER&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Whispering Winds of Winter is a critically acclaimed film directed by Akira Kurosawa, in which Nakamura Kenzaburo XVII played the lead role."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;GRAND CROSS OF THE CIVIL ORDER OF ALFONSO XII&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Grand Cross of the Civil Order of Alfonso XII is a prestigious award received by the actor, signifying significant contributions to society or the arts."&lt;SEP&gt;"The Grand Cross of the Civil Order of Alfonso XII is the highest grade of the Spanish Order of Alfonso XII, awarded to individuals who have made significant contributions to the arts, sciences, and public service."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;JOURNAL OF JAPANESE FILM STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Journal of Japanese Film Studies is a publication that analyzed Nakamura Kenzaburo XVII's body of work, highlighting his influence on Japanese cinema."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;THE TOKYO TIMES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Tokyo Times is a publication where Nakamura Kenzaburo XVII discussed his experience receiving the Grand Cross of the Civil Order of Alfonso XII."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;UNIVERSITY OF TOKYO PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Tokyo Press published a biography of Nakamura Kenzaburo XVII titled 'Nakamura Kenzaburo XVII: A Life in Film.'"</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;JAPANESE MINISTRY OF EDUCATION, CULTURE, SPORTS, SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Japanese Ministry of Education, Culture, Sports, Science and Technology recognized Nakamura Kenzaburo XVII with the Order of Culture in 2011."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;THE JAPAN TIMES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Japan Times reported on Nakamura Kenzaburo XVII's receipt of the Order of Culture, highlighting his dedication to preserving and promoting traditional Japanese performing arts."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;SPANISH ORDER OF ALFONSO XII&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Spanish Order of Alfonso XII is the organization that confers the Grand Cross of the Civil Order of Alfonso XII, which Nakamura Kenzaburo XVII received in 2001."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;KING ALFONSO XIII OF SPAIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King Alfonso XIII of Spain established the Spanish Order of Alfonso XII, which includes the Grand Cross of the Civil Order of Alfonso XII."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;AKIRA KUROSAWA'S FILMOGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Akira Kurosawa's filmography includes 'The Whispering Winds of Winter,' in which Nakamura Kenzaburo XVII starred."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;TRADITIONAL JAPANESE PERFORMING ARTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Traditional Japanese Performing Arts include kabuki and other forms of theater, which Nakamura Kenzaburo XVII is known for."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;A LIFE IN FILM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A Life in Film is a comprehensive overview of the actor's life and career, likely a book or documentary."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;ACTOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The actor is the subject of 'A Life in Film' and has received the Grand Cross of the Civil Order of Alfonso XII."</data>
      <data key="d2">cb-0034</data>
    </node>
    <node id="&quot;ALFONSO XII&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alfonso XII was the King of Spain from 1874 until his death in 1885, and the order named after him is a prestigious honor."</data>
      <data key="d2">cb-0034</data>
    </node>
    <edge source="&quot;NAKAMURA KENZABURO XVII&quot;" target="&quot;TOKYO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Nakamura Kenzaburo XVII was born in Tokyo and began his acting career there."</data>
      <data key="d5">"birthplace, career start"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;NAKAMURA KENZABURO XVII&quot;" target="&quot;NAKAMURA KENZABURO XVI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Nakamura Kenzaburo XVII is the son of Nakamura Kenzaburo XVI and continues the family's tradition in kabuki."</data>
      <data key="d5">"family lineage, continuation"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;NAKAMURA KENZABURO XVII&quot;" target="&quot;KABUKI&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Nakamura Kenzaburo XVII is a kabuki performer and the 17th generation of the Nakamura Kenzaburo line."</data>
      <data key="d5">"performance, lineage"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;NAKAMURA KENZABURO XVII&quot;" target="&quot;ORDER OF CULTURE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Nakamura Kenzaburo XVII was awarded the Order of Culture in 2011 for his contributions to Japanese culture."</data>
      <data key="d5">"recognition, cultural contribution"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;NAKAMURA KENZABURO XVII&quot;" target="&quot;2011&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Nakamura Kenzaburo XVII received the Order of Culture in 2011."</data>
      <data key="d5">"award year, recognition"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;GRAND CROSS OF THE CIVIL ORDER OF ALFONSO XII&quot;" target="&quot;A LIFE IN FILM&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"A Life in Film provides information about the actor's receipt of the Grand Cross of the Civil Order of Alfonso XII, linking the publication to the event of receiving the award."</data>
      <data key="d5">"information source, recognition"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;GRAND CROSS OF THE CIVIL ORDER OF ALFONSO XII&quot;" target="&quot;ACTOR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The actor received the prestigious award, the Grand Cross of the Civil Order of Alfonso XII, highlighting their significant contributions."</data>
      <data key="d5">"recognition, achievement"</data>
      <data key="d6">cb-0034</data>
    </edge>
    <edge source="&quot;A LIFE IN FILM&quot;" target="&quot;ACTOR&quot;">
      <data key="d3">7.0</data>
