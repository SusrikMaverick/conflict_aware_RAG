  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DAVID NOVAK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Novak is a renowned musicologist known for his contributions to American musicology and his work at the University of California, Santa Barbara."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, SANTA BARBARA (UCSB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UCSB is a hub of intellectual curiosity and innovation, located in Goleta, California, where David Novak taught and conducted research."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;GOLETA, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Goleta, California is the picturesque coastal town where UCSB is situated, providing a backdrop for David Novak's academic life."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;ETHNOMUSICOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ethnomusicology is a journal where David Novak published his 2005 article 'The Politics of Musical Identity in Post-War Japan', showcasing his research."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;MUSIC AND IDENTITY CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Music and Identity Conference, organized by David Novak in 2007, brought together scholars to explore the relationships between music, culture, and identity."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;AZIENDA UNITA' SANITARIA LOCALE DI MODENA (AUSSL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AUSSL is an Italian healthcare organization where David Novak worked on a music therapy program for patients with Alzheimer's."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;MODENA, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Modena, Italy is the charming city where David Novak found a new sense of purpose in music therapy."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;DR. BIANCHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Bianchi is the director of the AUSSL's innovative music therapy program, who inspired David Novak to design music workshops for patients with Alzheimer's."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;SIGNORA ROSA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Signora Rosa is the receptionist at the AUSSL, who greeted David Novak warmly as he arrived for his music therapy sessions."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;MONTEVERDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monteverdi is a Renaissance composer whose haunting melodies David Novak used in his music therapy workshops."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;VERDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Verdi is a Renaissance composer whose lilting rhythms David Novak used in his music therapy workshops."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;AMERICAN MUSICOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American musicology is the field in which David Novak is renowned, characterized by his significant contributions."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;RENAISSANCE MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Renaissance music is the area of focus for David Novak's earlier studies, characterized by its intricate patterns and historical significance."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;ALZHEIMER'S&quot;">
      <data key="d0">"CONDITION"</data>
      <data key="d1">"Alzheimer's is the condition for which David Novak designed music therapy workshops, aiming to unlock memories and spark joy."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;MUSIC THERAPY&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Music therapy is the practice David Novak engaged in at AUSSL, using music to heal and transform lives."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;STATELY PALAZZO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The stately palazzo is the headquarters of AUSSL, where David Novak conducted his music therapy sessions."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;OLD PIANO&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The old piano in the therapy room at AUSSL is a tool used by David Novak to create music and facilitate therapy sessions."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;WINDING STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The winding streets of Modena are the setting where David Novak found a new sense of purpose in music therapy."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;LOCAL TRATTORIAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Local trattorias in Modena are places where the sweet scent of freshly baked tortellini wafts, symbolizing the contrast with David's previous environment."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;DUSTY ARCHIVES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dusty archives and cramped libraries are the environments David Novak was accustomed to before moving to Modena, highlighting the change in his surroundings."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;ANCIENT MANUSCRIPTS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Ancient manuscripts in the dusty archives are the sources of David Novak's earlier research, representing his past academic focus."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;WORN LEATHER BINDINGS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Worn leather bindings of books in the cramped libraries are symbols of the meticulous research David Novak conducted in his earlier career."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;SUNLIGHT&quot;">
      <data key="d0">"NATURAL PHENOMENON"</data>
      <data key="d1">"Sunlight dancing across the palazzo's facade symbolizes the new light and hope David Novak found in his new venture."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;NEW SENSE OF PURPOSE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A new sense of purpose is what David Novak found in Modena, contrasting with his previous academic pursuits."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;INNOVATIVE MUSIC THERAPY PROGRAM&quot;">
      <data key="d0">"PROGRAM"</data>
      <data key="d1">"The innovative music therapy program at AUSSL is where David Novak's passion for music and healing came together."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;HAUNTING MELODIES&quot;">
      <data key="d0">"SOUND"</data>
      <data key="d1">"Haunting melodies of Monteverdi are used by David Novak in his music therapy workshops to unlock memories and emotions."</data>
      <data key="d2">cb-0477</data>
    </node>
    <node id="&quot;LILTING RHYTHMS&quot;">
      <data key="d0">"SOUND"</data>
      <data key="d1">"Lilting rhythms of Verdi are used by David Novak in his music therapy workshops to enhance the therapeutic experience."</data>
      <data key="d2">cb-0477</data>
    </node>
