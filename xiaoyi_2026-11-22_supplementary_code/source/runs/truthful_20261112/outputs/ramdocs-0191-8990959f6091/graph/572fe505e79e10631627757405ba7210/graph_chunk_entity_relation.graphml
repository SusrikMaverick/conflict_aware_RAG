  <graph edgedefault="undirected">
    <node id="&quot;DENTON ENTERPRISE AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Denton Enterprise Airport is a city-owned, public-use airport located in Denton, Texas, established in 1942 and used by the United States Army Air Forces during World War II."</data>
      <data key="d2">ramdocs-0191-8990959f6091</data>
    </node>
    <node id="&quot;DENTON COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Denton County is the county where Denton, the city hosting Denton Enterprise Airport, is located."</data>
      <data key="d2">ramdocs-0191-8990959f6091</data>
    </node>
