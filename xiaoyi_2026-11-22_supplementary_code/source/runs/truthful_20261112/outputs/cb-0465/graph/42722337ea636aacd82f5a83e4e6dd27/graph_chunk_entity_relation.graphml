  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;REGINA M. ANDERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Regina M. Anderson is a playwright and librarian of multi-racial descent, known for her contributions to the Harlem Renaissance and her play 'The Whispering Walls'."&lt;SEP&gt;"Regina M. Anderson is associated with the Schomburg Center for Research in Black Culture, part of the New York Public Library."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;JOHN FULLERTON OF THAT ILK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Fullerton is Regina M. Anderson's husband, known for his mischievous nature and bringing her inspiration in the form of an old diary."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;THE WHISPERING WALLS&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Whispering Walls is Regina M. Anderson's latest play, which is taking shape and is expected to be her masterpiece."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;ILK ESTATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ilk Estate is the home of John Fullerton, where he finds the old diary for Regina M. Anderson."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;135TH STREET BRANCH OF THE NEW YORK PUBLIC LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"135th Street Branch of the New York Public Library is where Regina M. Anderson worked as a librarian, a hub for African American literary and cultural activity during the Harlem Renaissance."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;HARLEM EXPERIMENTAL THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Harlem Experimental Theatre is a venue where Regina M. Anderson's plays were performed."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;KRIGWA PLAYERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Krigwa Players is another venue where Regina M. Anderson's plays were performed."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;WILLIAM T. ANDREWS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William T. Andrews is Regina M. Anderson's husband, a politician who served as a member of the New York State Assembly from 1933 to 1941."&lt;SEP&gt;"William T. Andrews was an American politician from New York, serving as a member of the New York State Assembly from 1933 to 1941."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;NEW YORK AMSTERDAM NEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York Amsterdam News is a newspaper that reported on Regina M. Anderson's marriage to William T. Andrews."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;SCHOMBURG CENTER FOR RESEARCH IN BLACK CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Schomburg Center for Research in Black Culture is a repository of African American cultural and historical materials that confirms Regina M. Anderson's marriage to William T. Andrews."&lt;SEP&gt;"The Schomburg Center for Research in Black Culture is a research institution within the New York Public Library, dedicated to the study of African and African diaspora culture."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;CHICAGO, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago, Illinois is the birthplace of Regina M. Anderson, a culturally rich environment that influenced her writing."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;HARLEM RENAISSANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Harlem Renaissance was a cultural movement during the 1920s and 1930s that influenced Regina M. Anderson's work."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;MIXED RACIAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Regina M. Anderson's mixed racial heritage includes African American, Native American, and European ancestry, influencing her writing and identity."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;NEW YORK STATE ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York State Assembly is the political body where William T. Andrews served as a member from 1933 to 1941."&lt;SEP&gt;"The New York State Assembly is the lower house of the New York State Legislature, where William T. Andrews served as a member from 1933 to 1941."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;NEW YORK PUBLIC LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York Public Library is the institution where Regina M. Anderson worked as a librarian, specifically at the 135th Street Branch."&lt;SEP&gt;"The New York Public Library is a large public library system in New York City, housing various cultural and research centers including the Schomburg Center."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;SOCIETY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Society events are mentioned in the New York Amsterdam News, reporting on Regina M. Anderson's marriage to William T. Andrews."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;MULTI-RACIAL DESCENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Regina M. Anderson's multi-racial descent is a significant aspect of her identity and influences her work."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;1900-1993&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"Regina M. Anderson lived from 1900 to 1993."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;1933-1941&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"William T. Andrews served as a member of the New York State Assembly from 1933 to 1941."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;1920S AND 1930S&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"The Harlem Renaissance movement occurred during the 1920s and 1930s, influencing Regina M. Anderson's work."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York is the state and city where both Regina M. Anderson and William T. Andrews were based, with the Schomburg Center and the New York State Assembly located there."</data>
      <data key="d2">cb-0465</data>
    </node>
    <node id="&quot;1898-1984&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the lifespan of William T. Andrews, indicating the period during which he was active in politics."</data>
      <data key="d2">cb-0465</data>
    </node>
