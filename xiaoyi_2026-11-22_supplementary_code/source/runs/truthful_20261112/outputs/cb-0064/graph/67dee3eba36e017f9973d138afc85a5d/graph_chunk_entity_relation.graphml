<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SOULCALIBUR VI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Soulcalibur VI is a 2018 fighting game developed by Bandai Namco Studios, known for its innovative and immersive stage design and gameplay mechanics."&lt;SEP&gt;"Soulcalibur VI is a top-selling fighting game that achieved significant commercial success and critical acclaim in 2018."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;BANDAI NAMCO STUDIOS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bandai Namco Studios is the developer of Soulcalibur VI, responsible for its creation and the subsequent nominations it received."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;TONY AWARD FOR BEST SCENIC DESIGN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Tony Award for Best Scenic Design is a prestigious award given for outstanding achievements in set design for a play or musical."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;TONY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Tony Awards are annual awards recognizing excellence in live Broadway theater, established in 1947."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;JOURNAL OF DIGITAL HUMANITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Digital Humanities is a publication that analyzes the use of digital media in various forms of artistic expression, including video games."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF GAME STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The International Journal of Game Studies is a publication that examines the impact of digital media on various aspects of game development and design."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;THE NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New York Times is a renowned newspaper that publishes articles on various topics, including interviews and reviews of cultural events."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;DAVID KORINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Korins is a Tony Award-winning set designer who praised the innovative design of Soulcalibur VI."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;THE GAME AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Game Awards is an annual ceremony celebrating outstanding achievements in game development, art, and design, founded in 2014."&lt;SEP&gt;"The Game Awards is an annual event that recognizes excellence in video game development, including categories such as Best Fighting Game."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;BEST FIGHTING GAME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Best Fighting Game category at The Game Awards recognizes the most exceptional fighting games in the industry."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;STREET FIGHTER V&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Street Fighter V is a previous winner of the Best Fighting Game category at The Game Awards."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;DRAGON BALL FIGHTERZ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dragon Ball FighterZ is another previous winner of the Best Fighting Game category at The Game Awards."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;METACRITIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Metacritic is a leading review aggregation platform that provides average critic scores for video games and other media."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;NPD GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The NPD Group is a market research company that provides data on sales and trends in various industries, including the gaming industry."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;TAKUJI KAWANO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Takuji Kawano is the Art Director of Soulcalibur VI, credited with creating an 'interactive opera' that blurred the lines between video games and live theater."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;2018&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2018 is the year Soulcalibur VI was released and when it was nominated for the Tony Award for Best Scenic Design."&lt;SEP&gt;"2018 is the year when Soulcalibur VI was one of the top-selling fighting games."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2019 is the year the Tony Awards committee announced the expansion of its categories to include digital productions and the nomination of Soulcalibur VI."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;APRIL 30, 2019&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"April 30, 2019 is the date the Tony Awards committee announced the nominees for the 73rd Annual Tony Awards, including Soulcalibur VI."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;2018 FIGHTING GAME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"2018 fighting game refers to Soulcalibur VI, which was released in 2018 and made history by becoming the first video game to be nominated for the Tony Award for Best Scenic Design."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;16TH-CENTURY EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"16th-century Europe is the setting for the fantastical world depicted in Soulcalibur VI, which is a key aspect of its innovative stage design."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;ANCIENT MYTHOLOGICAL REALMS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ancient mythological realms are part of the fantastical world depicted in Soulcalibur VI, contributing to its immersive and innovative stage design."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;VIRTUAL STAGES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Virtual stages refer to the interactive and immersive environments designed for Soulcalibur VI, which redefined the boundaries of scenic design in the digital age."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;SPATIAL STORYTELLING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Spatial storytelling is a technique used in Soulcalibur VI to create an immersive experience, blending environmental design with narrative elements."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;ENVIRONMENTAL DESIGN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental design is a key aspect of the innovative stage design in Soulcalibur VI, which redefined the boundaries of scenic design in the digital age."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;CRITICAL RECEPTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Critical reception refers to the positive feedback and reviews Soulcalibur VI received from critics and fans, contributing to its success and recognition."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is a location where Soulcalibur VI achieved significant sales, specifically over 1 million copies."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;TOP-SELLING FIGHTING GAMES&quot;">
      <data key="d0">"CATEGORY"</data>
      <data key="d1">"Top-selling fighting games refers to games that are popular and commercially successful in the fighting game genre."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;OVER 1 MILLION COPIES&quot;">
      <data key="d0">"SALES FIGURE"</data>
      <data key="d1">"Over 1 million copies is the number of copies sold for Soulcalibur VI in the United States."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;GAMING INDUSTRY&quot;">
      <data key="d0">"INDUSTRY"</data>
      <data key="d1">"The gaming industry is the broader context in which Soulcalibur VI operates and is evolving."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;INNOVATION AND EXCELLENCE&quot;">
      <data key="d0">"QUALITY ATTRIBUTE"</data>
      <data key="d1">"Innovation and excellence describe the qualities that make Soulcalibur VI stand out in the gaming industry."</data>
      <data key="d2">cb-0064</data>
    </node>
    <node id="&quot;SOULCALIBR VI&quot;">
      <data key="d2">cb-0064</data>
      <data key="d1">"Soulcalibur VI stands as a shining example of innovation and excellence in game development, indicating its high quality and standing in the industry."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;TONY AWARD FOR BEST SCENIC DESIGN&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Soulcalibur VI was nominated for the Tony Award for Best Scenic Design, marking a significant expansion of the Tony Awards to include digital productions."</data>
      <data key="d5">"innovation, recognition"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;TONY AWARDS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Soulcalibur VI was nominated for the Tony Awards, specifically for Best Scenic Design, highlighting its innovative stage design."</data>
      <data key="d5">"recognition, innovation"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;JOURNAL OF DIGITAL HUMANITIES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A study in the Journal of Digital Humanities analyzed the use of spatial storytelling and environmental design in Soulcalibur VI, redefining the boundaries of scenic design in the digital age."</data>
      <data key="d5">"analysis, redefinition"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;INTERNATIONAL JOURNAL OF GAME STUDIES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Another study in the International Journal of Game Studies examined the impact of Soulcalibur VI on the recognition of digital media as a legitimate form of theatrical expression, marking a paradigm shift."</data>
      <data key="d5">"impact, paradigm shift"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;THE NEW YORK TIMES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"David Korins, a Tony Award-winning set designer, praised the innovative design of Soulcalibur VI in an interview with The New York Times."</data>
      <data key="d5">"praise, innovation"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;THE GAME AWARDS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Soulcalibur VI was nominated for Best Fighting at The Game Awards, indicating its recognition and standing in the gaming community."&lt;SEP&gt;"Soulcalibur VI was nominated for The Game Awards - Best Fighting, a highly competitive category in the gaming industry, recognizing its exceptional quality and gameplay mechanics."</data>
      <data key="d5">"recognition, competition"&lt;SEP&gt;"recognition, excellence"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;UNITED STATES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Soulcalibur VI achieved significant sales in the United States, highlighting its commercial success in a major market."</data>
      <data key="d5">"sales, market presence"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;TOP-SELLING FIGHTING GAMES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Soulcalibur VI is part of the category of top-selling fighting games, indicating its commercial success in the genre."</data>
      <data key="d5">"success, popularity"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;2018&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Soulcalibur VI was one of the top-selling fighting games in 2018, highlighting its success during that year."</data>
      <data key="d5">"success, year"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;OVER 1 MILLION COPIES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Soulcalibur VI achieved over 1 million copies in sales in the United States, indicating its commercial success in a major market."</data>
      <data key="d5">"sales, market presence"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;SOULCALIBUR VI&quot;" target="&quot;GAMING INDUSTRY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Soulcalibur VI is part of the gaming industry, and its success reflects the industry's evolution and standards."</data>
      <data key="d5">"industry context, evolution"</data>
      <data key="d6">cb-0064</data>
    </edge>
    <edge source="&quot;INNOVATION AND EXCELLENCE&quot;" target="&quot;SOULCALIBR VI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Soulcalibur VI stands as a shining example of innovation and excellence in game development, indicating its high quality and standing in the industry."</data>
      <data key="d5">"excellence, innovation"</data>
      <data key="d6">cb-0064</data>
    </edge>
  </graph>
