  <graph edgedefault="undirected">
    <node id="&quot;CLAUDIA CROSIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Claudia Crosio is a renowned researcher with an impressive track record, known for her contributions to materials science and nanotechnology, and her work on sustainable energy storage systems."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;INSTITUTE OF SCIENTIFIC AND TECHNICAL INFORMATION (ISTI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ISTI is a prestigious research institution where Claudia Crosio conducted groundbreaking research in materials science and nanotechnology, leading to several breakthroughs and publications in top-tier journals."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;PARIS, FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris, France is the location where the news about Claudia Crosio's interview was reported."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;NATURE MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Materials is a top-tier journal where Claudia Crosio's research was published, highlighting her contributions to materials science."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;ADVANCED MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Advanced Materials is another top-tier journal where Claudia Crosio's research was published, showcasing her work in materials science and nanotechnology."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;FONDAZIONE SANTA LUCIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fondazione Santa Lucia is a leading healthcare organization in Rome, Italy, where Claudia Crosio has a significant connection and has collaborated on research projects."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;ROME, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome, Italy is the location of Fondazione Santa Lucia, where Claudia Crosio has been affiliated and conducted research."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Medicine is a prestigious journal where Claudia Crosio and her team published a study on neurodegenerative diseases, highlighting their collaborative work with Fondazione Santa Lucia."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;EUROPEAN UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Union has funded research projects involving Fondazione Santa Lucia and Claudia Crosio, supporting their work in medical research."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;DR. PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Pierre Dupont is the Director of ISTI and acknowledges Claudia Crosio's contributions to the institute."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;DR. MARIA GRAZIA BUZZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Grazia Buzzi is the Director of Research at Fondazione Santa Lucia and praises Claudia Crosio's work."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;DR. GIOVANNI MELZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Giovanni Melzi is a colleague of Claudia Crosio at Fondazione Santa Lucia and commends her work."</data>
      <data key="d2">cb-0110</data>
    </node>
    <node id="&quot;ORCID ID 0000-0003-2452-1145&quot;">
