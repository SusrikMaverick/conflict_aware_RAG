  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PATRICK SCHUENKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrick Schuenke is a renowned researcher in materials science, known for his work at Georgia Tech and the Physikalisch-Technische Bundesanstalt (PTB). He has made significant contributions to the development of advanced materials and has a strong track record of publications and patents."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;GEORGIA TECH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Georgia Tech is a public research university in Atlanta, Georgia, where Patrick Schuenke conducted pioneering work in materials science. The university is known for its interdisciplinary research and commitment to solving real-world problems."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;PHYSIKALISCH-TECHNISCHE BUNDESANSTALT (PTB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PTB is Germany's national metrology institute, where Patrick Schuenke was previously affiliated. The institute focuses on precision measurement and establishing measurement standards."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;DR. MARYAM TABRIZIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maryam Tabrizian is a professor of materials science at Georgia Tech and a colleague of Patrick Schuenke. She acknowledges his contributions and impact on the scientific community."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;DR. JOACHIM ULLRICH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Joachim Ullrich is the President of the Physikalisch-Technische Bundesanstalt (PTB) and confirms Schuenke's affiliation with the institute. He praises Schuenke's expertise and contributions."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;SCHOOL OF MATERIALS SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The School of Materials Science and Engineering at Georgia Tech is where Patrick Schuenke led a team of researchers and conducted his groundbreaking work."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ADVANCED MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Advanced Materials refer to the novel materials developed by Patrick Schuenke and his team, characterized by enhanced strength, conductivity, and thermal resistance."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;META-MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Meta-materials are a new class of materials developed by Patrick Schuenke that can manipulate electromagnetic waves, suitable for applications like advanced sensors and energy harvesting devices."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;AEROSPACE INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Aerospace Industry is one of the sectors that benefit from the advanced materials developed by Patrick Schuenke."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ENERGY INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Energy Industry is another sector that benefits from the advanced materials developed by Patrick Schuenke."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;HEALTHCARE INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Healthcare Industry is also impacted by the advanced materials developed by Patrick Schuenke."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ORCID ID 0000-0002-3179-4830&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"ORCID ID 0000-0002-3179-4830 is the unique identifier for Patrick Schuenke, used to track his academic and professional contributions."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ATLANTA, GA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Atlanta, GA is the city where Georgia Tech is located."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;EXCLUSIVE INTERVIEW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An exclusive interview was conducted with Dr. Patrick Schuenke, where he shared insights into his groundbreaking work at Georgia Tech."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;FIRST CONTACT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Contact is the potential initial communication between humanity and an unknown intelligence, though not directly mentioned in the text."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;PUBLIC RESEARCH UNIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Georgia Tech is described as a public research university, emphasizing its focus on research and innovation."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Georgia Tech is known for its strong reputation in interdisciplinary research, which attracted Patrick Schuenke."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;REAL-WORLD PROBLEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Georgia Tech's commitment to addressing real-world problems is highlighted as a reason for Patrick Schuenke's choice to join the university."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;SPIN-OFF COMPANIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Schuenke's work at Georgia Tech has led to the development of several patents and spin-off companies, creating new opportunities for economic growth and job creation."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;NEW CLASS OF MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A new class of materials known as 'meta-materials' was developed by Schuenke, which can manipulate electromagnetic waves."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;TOP-TIER SCIENTIFIC JOURNALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Schuenke's research group published over 20 papers in top-tier scientific journals during his tenure, with several of these papers receiving awards for their impact and innovation."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ADVANCED SENSORS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Meta-materials developed by Schuenke are suitable for applications such as advanced sensors."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ANTENNAS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Meta-materials developed by Schuenke are suitable for applications such as antennas."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ENERGY HARVESTING DEVICES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Meta-materials developed by Schuenke are suitable for applications such as energy harvesting devices."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;PRECISION MEASUREMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"PTB focuses on precision measurement and establishing measurement standards, and Schuenke's work contributed significantly to this effort."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;SCHUENKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Schuenke is a person known for their contributions to the establishment and maintenance of measurement standards, demonstrating a commitment to advancing scientific knowledge."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ESTABLISHMENT AND MAINTENANCE OF MEASUREMENT STANDARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Establishment and Maintenance of Measurement Standards is an ongoing effort to create and uphold standardized measurements."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ADVANCING SCIENTIFIC KNOWLEDGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Advancing Scientific Knowledge refers to the process of improving and expanding scientific understanding and application."</data>
      <data key="d2">cb-0126</data>
    </node>
    <node id="&quot;ADVANCED MEASUREMENT TECHNIQUES&quot;">
      <data key="d2">cb-0126</data>
      <data key="d1">"PTB conducted research on advanced measurement techniques, with Patrick Schuenke as a co-author, highlighting his expertise in precision measurement."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
