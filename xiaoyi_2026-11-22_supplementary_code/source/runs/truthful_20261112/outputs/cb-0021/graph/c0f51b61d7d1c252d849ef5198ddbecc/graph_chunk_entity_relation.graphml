    </node>
    <node id="&quot;APPLE MARKET&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Apple market is a significant market for the apple industry in Ippongi, a small, rural town in northern Japan."</data>
      <data key="d2">cb-0021</data>
    </node>
    <node id="&quot;APPLE TRADE&quot;">
      <data key="d0">"CONCEPT"</data>
