<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MAHMUD I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mahmud I was the Sultan of the Ottoman Empire from 1730 to 1754 and also the Sultan of the Seljuk Empire from 1092 to 1094."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;MUSTAFA II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mustafa II was the father of Mahmud I and Sultan of the Ottoman Empire from 1695 to 1703."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;SALIHA SABKATI VALIDE SULTAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saliha Sabkati Valide Sultan was the mother of Mahmud I."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;OSMAN III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Osman III was the brother of Mahmud I and Sultan of the Ottoman Empire from 1754 to 1757."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;PATRONA HALIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrona Halil led a riot demanding the death of the grand vizer, Nevşehirli."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;NEVŞEHIRLI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nevşehirli was the grand vizer during the time of Mahmud I."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;TOPKAPI PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Topkapı Palace was the site of the riot led by Patrona Halil."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;EDIRNE PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Edirne Palace was the birthplace of Mahmud I."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;CONSTANTINOPLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Constantinople was the location where the riot led by Patrona Halil began."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;AHMET III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ahmet III was the Sultan of the Ottoman Empire before Mahmud I."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;MALIK SHAH I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Malik Shah I was the father of Mahmud I and the predecessor of Mahmud I as Sultan of the Seljuk Empire."&lt;SEP&gt;"Malik Shah I was the predecessor of Mahmud I as Sultan of the Seljuk Empire."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;ALP ARSLAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alp Arslan was a predecessor of Malik Shah I in building the Seljuk Empire."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;TURKAN KHATUN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Turkan Khatun was the last wife of Malik Shah I and tried to win the throne for her son Mahmud."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;BARKYARUK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Barkyaruk was the older son of Malik Shah I and a rival claimant to the Seljuk throne."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
    <node id="&quot;MUSTAFA I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mustafa I was the 14th generation descendant of Osman II."</data>
      <data key="d2">ramdocs-0105-ae5224da23d8</data>
    </node>
  </graph>
</graphml>
