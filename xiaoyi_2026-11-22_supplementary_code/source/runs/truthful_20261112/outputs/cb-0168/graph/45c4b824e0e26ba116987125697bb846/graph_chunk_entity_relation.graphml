<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ASTRID DE GROOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Astrid de Groot is a Dutch politician known for her environmental proposals and contributions to the political landscape, also passionate about badminton and involved in a Wikipedia project."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;EUROPEAN PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Parliament is where Astrid de Groot gave a successful speech, highlighting her role in environmental reform."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;JASMIJN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jasmijn is Astrid de Groot's assistant who noticed a request for input on a badminton tournament focus list from a Wikipedia user."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wikipedia is an online encyclopedia where Astrid de Groot received a request for input and later contributed to a badminton tournament focus list."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;RACKETRANGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"RacketRanger is a user on Wikipedia from Malaysia who requested Astrid de Groot's input on a badminton tournament focus list."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;SHUTTLESHIFTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"ShuttleShifter is a statistician from Denmark who compiled an exhaustive database of tournament results and contributed to the badminton tournament focus list."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;BADMINTON TOURNAMENT FOCUS LIST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Badminton Tournament Focus List is a project on Wikipedia where contributors compile information on badminton tournaments."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;NL GENDERGAP MAINTENANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NL Gendergap Maintenance is a Dutch-language project on Wikipedia aimed at increasing the representation of women on the online encyclopedia."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;DUTCH-LANGUAGE WIKIPEDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dutch-language Wikipedia is the platform where Astrid de Groot is featured on the NL Gendergap Maintenance focus list."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;MALAYSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Malaysia is the country where RacketRanger, a user on Wikipedia, is from."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;DENMARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Denmark is the country where ShuttleShifter, a statistician, is from."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;BADMINTON&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Badminton is the sport that Astrid de Groot is passionate about and that connects her to the Wikipedia project."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;ENVIRONMENTAL REFORM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Reform is the area of policy Astrid de Groot focuses on in her political work."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;INTERNATIONAL RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International Relations is the field of expertise Astrid de Groot brings to the Wikipedia project."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;EVENT MANAGEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Event Management is another area of expertise Astrid de Groot brings to the Wikipedia project."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;POLITICAL LANDSCAPE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Political Landscape refers to the broader context of Dutch politics where Astrid de Groot operates."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;GENDER GAP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gender Gap is the issue addressed by the NL Gendergap Maintenance project."</data>
      <data key="d2">cb-0168</data>
    </node>
    <node id="&quot;ONLINE ENCYCLOPEDIA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Online Encyclopedia is the type of platform where the NL Gendergap Maintenance project operates."</data>
      <data key="d2">cb-0168</data>
    </node>
