    <edge source="&quot;ASTRID DE GROOT&quot;" target="&quot;DUTCH-LANGUAGE WIKIPEDIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Astrid de Groot is featured on the focus list of the NL Gendergap maintenance project on the Dutch-language Wikipedia, highlighting her significance in Dutch politics and the project's efforts to provide a more comprehensive and balanced representation of women's contributions."</data>
      <data key="d5">"significance, representation"</data>
      <data key="d6">cb-0168</data>
    </edge>
    <edge source="&quot;WIKIPEDIA&quot;" target="&quot;NL GENDERGAP MAINTENANCE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"NL Gendergap Maintenance is a Dutch-language project on Wikipedia aimed at increasing the representation of women on the online encyclopedia, where Astrid de Groot is featured on the focus list."</data>
      <data key="d5">"project, focus list"</data>
      <data key="d6">cb-0168</data>
    </edge>
    <edge source="&quot;BADMINTON TOURNAMENT FOCUS LIST&quot;" target="&quot;NL GENDERGAP MAINTENANCE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Badminton Tournament Focus List is a project on Wikipedia where contributors compile information on badminton tournaments, intersecting with the NL Gendergap Maintenance project focused on increasing women's representation on the online encyclopedia."</data>
      <data key="d5">"intersection, collaboration"</data>
