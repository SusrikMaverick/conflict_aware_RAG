    <edge source="&quot;ASTRID DE GROOT&quot;" target="&quot;WIKIPEDIA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Astrid de Groot received a request for input on a badminton tournament focus list from a Wikipedia user and later contributed to the project."</data>
      <data key="d5">"input request, contribution"</data>
      <data key="d6">cb-0168</data>
    </edge>
    <edge source="&quot;ASTRID DE GROOT&quot;" target="&quot;RACKETRANGER&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"RacketRanger, a user on Wikipedia, requested Astrid de Groot's input on a badminton tournament focus list, leading to her involvement in the project."</data>
      <data key="d5">"request, involvement"</data>
