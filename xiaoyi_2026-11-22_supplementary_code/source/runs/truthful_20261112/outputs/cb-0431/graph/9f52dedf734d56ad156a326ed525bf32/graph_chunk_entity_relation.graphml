  <graph edgedefault="undirected">
    <node id="&quot;ALEX DI ROCCO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alex Di Rocco is a talented and experienced midfielder known for his exceptional vision, passing range, and goal-scoring ability. He has previously played for several top-tier clubs and is expected to significantly strengthen the team's midfield."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;CS SEDAN ARDENNES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CS Sedan Ardennes is a prominent association football club in France that has signed Alex Di Rocco, a move expected to significantly strengthen the team's midfield."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;MESQUITA FUTEBOL CLUBE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mesquita Futebol Clube is a Rio de Janeiro-based Brazilian football club that has signed Alex Di Rocco, a rising star known for his lightning-quick speed and pinpoint passing accuracy."&lt;SEP&gt;"Mesquita Futebol Clube is a football club preparing for an upcoming match against Flamengo."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;THIERRY LAUREY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thierry Laurey is the manager of CS Sedan Ardennes and expressed excitement about welcoming Alex Di Rocco to the team."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;LUIZ FELIPE OLIVEIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luiz Felipe Oliveira is the president of Mesquita Futebol Clube and hailed the signing of Alex Di Rocco as a major coup for the club."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;PAULO ROBERTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paulo Roberto is the coach of Mesquita Futebol Clube and is eager to see Alex Di Rocco contribute to the team's success."</data>
      <data key="d2">cb-0431</data>
    </node>
    <node id="&quot;RIO DE JANEIRO&quot;">
