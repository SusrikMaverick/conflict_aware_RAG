      <data key="d5">"higher education, academic achievement"</data>
      <data key="d6">cb-0121</data>
    </edge>
    <edge source="&quot;DONGHUA HANG&quot;" target="&quot;INSTITUTE OF ANIMAL SCIENCE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Donghua Hang worked as a postdoctoral researcher at the Institute of Animal Science in Prague, Czech Republic, under the guidance of Dr. Eva Nováková."</data>
      <data key="d5">"research, mentorship"</data>
      <data key="d6">cb-0121</data>
    </edge>
    <edge source="&quot;DONGHUA HANG&quot;" target="&quot;DR. EVA NOVÁKOVÁ&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Donghua Hang worked under the guidance of Dr. Eva Nováková during his postdoctoral research at the Institute of Animal Science."</data>
      <data key="d5">"mentorship, guidance"</data>
      <data key="d6">cb-0121</data>
    </edge>
    <edge source="&quot;DONGHUA HANG&quot;" target="&quot;PRAGUE&quot;">
      <data key="d3">8.0</data>
