<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DONGHUA HANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donghua Hang is a renowned researcher in the field of animal science, known for his contributions to the study of animal behavior and welfare. He has conducted significant research on farm animals and has been cited over 500 times."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is the birthplace of Donghua Hang, a city in China."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;PEKING UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peking University is the institution where Donghua Hang received his Bachelor's degree in Biology in 1997."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Cambridge is the institution where Donghua Hang earned his Ph.D. in Animal Behavior in 2002."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;INSTITUTE OF ANIMAL SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institute of Animal Science is the organization where Donghua Hang was appointed as a senior researcher after his collaboration with the University of Veterinary and Pharmaceutical Sciences."&lt;SEP&gt;"Institute of Animal Science is the organization where Donghua Hang worked as a postdoctoral researcher in Prague, Czech Republic."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;DR. EVA NOVÁKOVÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Eva Nováková is a prominent expert in animal welfare who guided Donghua Hang during his postdoctoral research."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;PRAGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Prague is the city in the Czech Republic where Donghua Hang worked as a postdoctoral researcher."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;UNIVERSITY OF VETERINARY AND PHARMACEUTICAL SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Veterinary and Pharmaceutical Sciences is the institution where Donghua Hang collaborated with researchers to investigate the impact of housing systems on the behavior and welfare of laying hens."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;BRNO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brno is the city in the Czech Republic where Donghua Hang collaborated with researchers to investigate the impact of housing systems on the behavior and welfare of laying hens."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;SHANGHAI JIAO TONG UNIVERSITY SCHOOL OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shanghai Jiao Tong University School of Medicine is the institution where Donghua Hang worked as a researcher, contributing to the understanding of human health and disease."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;SHANGHAI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shanghai is the city in China where Donghua Hang worked as a researcher at the Shanghai Jiao Tong University School of Medicine."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;GOOGLE SCHOLAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Google Scholar is the platform where Donghua Hang's research has been cited over 500 times."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;JOURNAL OF ANIMAL SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Animal Science is the publication where one of Donghua Hang's notable studies was published in 2005."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;ANIMAL WELFARE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Animal Welfare is the publication where another of Donghua Hang's studies was published in 2007."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;FARM ANIMALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Farm Animals refer to the subjects of Donghua Hang's research, including pigs and laying hens."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;INTENSIVE FARMING SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intensive Farming Systems are the environments in which Donghua Hang studied the effects of enrichment strategies on farm animals."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;TOYS AND PUZZLE FEEDERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Toys and Puzzle Feeders are the enrichment strategies used in Donghua Hang's research to reduce stress and aggression in pigs."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;LAYING HENS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Laying Hens are the subjects of Donghua Hang's research on the impact of housing systems on their behavior and welfare."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;ENRICHMENT STRATEGIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Enrichment Strategies are the methods used in Donghua Hang's research to improve the welfare of farm animals."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;STRESS AND AGGRESSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Stress and Aggression are the behaviors studied in Donghua Hang's research to understand the effects of different environmental stimuli on farm animals."</data>
      <data key="d2">cb-0121</data>
    </node>
    <node id="&quot;WELFARE OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Welfare Outcomes are the positive results achieved in Donghua Hang's research through the use of enrichment strategies."</data>
      <data key="d2">cb-0121</data>
    </node>
    <edge source="&quot;DONGHUA HANG&quot;" target="&quot;BEIJING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Donghua Hang was born in Beijing, a city in China."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">cb-0121</data>
    </edge>
    <edge source="&quot;DONGHUA HANG&quot;" target="&quot;PEKING UNIVERSITY&quot;">
      <data key="d3">9.0</data>
