<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LITURGY OF ST. JOHN CHRYSOSTOM (LEONTOVYCH)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liturgy of St. John Chrysostom (Leontovych) is the musical setting of the Divine Liturgy of St. John Chrysostom by Mykola Leontovych, performed unaccompanied by choir and soloist."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;MYKOLA LEONTOVYCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mykola Leontovych is the composer of the Liturgy of St. John Chrysostom (Leontovych), and conducted its first performance."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;MYKOLAIV CATHEDRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mykolaiv Cathedral is the venue where the Liturgy of St. John Chrysostom (Leontovych) was first performed."&lt;SEP&gt;"Mykolaiv Cathedral is the venue where the Liturgy of St. John Chrysostom (Ukrainian: Літургія Івана Златоустого, tr. Liturhiya Ivana Zlatoustoho) was first performed."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;KIEV PECHERSK LAVRA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kiev Pechersk Lavra is the location where the Liturgy of St. John Chrysostom (Leontovych) was first performed."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;DIVINE LITURGY OF ST. JOHN CHRYSOSTOM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Divine Liturgy of St. John Chrysostom is the liturgical service that Mykola Leontovych set to music."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;LITURGY OF ST. JOHN CHRYSOSTOM (UKRAINIAN: ЛІТУРГІЯ ІВАНА ЗЛАТОУСТОГО, TR. LITURHIYA IVANA ZLATOUSTOHO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liturgy of St. John Chrysostom (Ukrainian: Літургія Івана Златоустого, tr. Liturhiya Ivana Zlatoustoho) is the musical setting of the Divine Liturgy of St. John Chrysostom by Johann Sebastian Bach, performed unaccompanied by choir and soloist."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;JOHANN SEBASTIAN BACH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johann Sebastian Bach is the composer of the Liturgy of St. John Chrysostom (Ukrainian: Літургія Івана Златоустого, tr. Liturhiya Ivana Zlatoustoho)."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;KYIV PECHERSK LAVRA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kyiv Pechersk Lavra is the location where the Liturgy of St. John Chrysostom (Ukrainian: Літургія Івана Златоустого, tr. Liturhiya Ivana Zlatoustoho) was first performed."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;LITURGY OF ST. JOHN CHRYSOSTOM (RACHMANINOFF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liturgy of St. John Chrysostom (Rachmaninoff) is a musical work by Sergei Rachmaninoff, one of his two major unaccompanied choral works."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;SERGEI RACHMANINOFF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sergei Rachmaninoff is the composer of the Liturgy of St. John Chrysostom (Rachmaninoff), and composed it in July 1910 at his summer estate Ivanovka."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;IVANOVKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ivanovka is the summer estate where Sergei Rachmaninoff composed the Liturgy of St. John Chrysostom (Rachmaninoff)."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;LITURGY OF ST. JOHN CHRYSOSTOM (PALIASHVILI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liturgy of St. John Chrysostom (Paliashvili) is a choral work composed by Zakaria Paliashvili in 1909."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;ZAKARIA PALIASHVILI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zakaria Paliashvili is the composer of the Liturgy of St. John Chrysostom (Paliashvili)."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
    <node id="&quot;MOVEMENTS 10 AND 11&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Movements 10 and 11 have polyphony and imitation, contrasting with the block-chordal arrangement of the rest of the work."</data>
      <data key="d2">ramdocs-0420-47349483f733</data>
    </node>
  </graph>
