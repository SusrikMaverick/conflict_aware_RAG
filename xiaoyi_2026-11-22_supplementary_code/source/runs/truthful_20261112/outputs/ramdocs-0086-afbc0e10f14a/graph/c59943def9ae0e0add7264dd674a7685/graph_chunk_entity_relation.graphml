<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PIER PAOLO CRESCENZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pier Paolo Crescenzi was an Italian Catholic cardinal born in 1572, son of Virgilio Crescenzi and Costanza del Drago, and brother of artist Giovanni Battista Crescenzi. He was educated at the University of Perugia and earned a doctorate in Civil and Canon Law."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;VIRGILIO CRESCENZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Virgilio Crescenzi was the father of Pier Paolo Crescenzi and Baron of Montorio."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;COSTANZA DEL DRAGO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Costanza del Drago was the mother of Pier Paolo Crescenzi and Marquises of Riofreddo."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;GIOVANNI BATTISTA CRESCENZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giovanni Battista Crescenzi was the brother of Pier Paolo Crescenzi and an artist."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;UNIVERSITY OF PERUGIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Perugia is where Pier Paolo Crescenzi was educated and earned a doctorate in Civil and Canon Law."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;CARDINAL-PRIEST OF SS. NEREO ED ACHILLEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Cardinal-Priest of Ss. Nereo ed Achilleo is a position held by Pier Paolo Crescenzi on 17 August 1611."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;BISHOP OF RIETI&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Bishop of Rieti is a position held by Pier Paolo Crescenzi on 4 July 1612 during the papacy of Pope Paul V."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;BISHOP OF ORVIETO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Bishop of Orvieto is a position held by Pier Paolo Crescenzi on 17 March 1621."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;BONIFAZIO CAETANI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bonifazio Caetani was the Bishop of Cassano all'Jonio who consecrated Pier Paolo Crescenzi as bishop on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;FABIO BIONDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fabio Biondi was a Titular Patriarch of Jerusalem who served as a co-consecrator for Pier Paolo Crescenzi on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;GALEAZZO SANVITALE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Galeazzo Sanvitale was the Archbishop Emeritus of Bari-Canosa who served as a co-consecrator for Pier Paolo Crescenzi on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;POPE PAUL V&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Paul V was the pope who appointed Pier Paolo Crescenzi as Bishop of Rieti on 4 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;BISHOP OF CASSANO ALL'JONIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bishop of Cassano all'Jonio is the position held by Bonifazio Caetani who consecrated Pier Paolo Crescenzi as bishop on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;TITULAR PATRIARCH OF JERUSALEM&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Titular Patriarch of Jerusalem is the role held by Fabio Biondi who served as a co-consecrator for Pier Paolo Crescenzi on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;ARCHBISHOP EMERITUS OF BARI-CANOSA&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Archbishop Emeritus of Bari-Canosa is the role held by Galeazzo Sanvitale who served as a co-consecrator for Pier Paolo Crescenzi on 15 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Church is the broader institution within which Pier Paolo Crescenzi served as a cardinal and bishop."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;RIETI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rieti is the city where Pier Paolo Crescenzi was appointed as Bishop of Rieti on 4 July 1612."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <node id="&quot;ORVIETO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Orvieto is the city where Pier Paolo Crescenzi was appointed as Bishop of Orvieto on 17 March 1621."</data>
      <data key="d2">ramdocs-0086-afbc0e10f14a</data>
    </node>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;VIRGILIO CRESCENZI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pier Paolo Crescenzi is the son of Virgilio Crescenzi, Baron of Montorio."</data>
      <data key="d5">"parent-child relationship, inheritance"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;COSTANZA DEL DRAGO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pier Paolo Crescenzi is the son of Costanza del Drago, Marquises of Riofreddo."</data>
      <data key="d5">"parent-child relationship, inheritance"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;GIOVANNI BATTISTA CRESCENZI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Pier Paolo Crescenzi is the brother of Giovanni Battista Crescenzi, an artist."</data>
      <data key="d5">"brotherhood, family ties"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;UNIVERSITY OF PERUGIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Pier Paolo Crescenzi was educated at the University of Perugia and earned a doctorate in Civil and Canon Law."</data>
      <data key="d5">"education, professional development"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;CARDINAL-PRIEST OF SS. NEREO ED ACHILLEO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pier Paolo Crescenzi was elevated to the position of Cardinal-Priest of Ss. Nereo ed Achilleo on 17 August 1611."</data>
      <data key="d5">"promotion, religious position"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
    <edge source="&quot;PIER PAOLO CRESCENZI&quot;" target="&quot;BISHOP OF RIETI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pier Paolo Crescenzi was appointed as Bishop of Rieti on 4 July 1612 during the papacy of Pope Paul V."</data>
      <data key="d5">"appointment, religious position"</data>
      <data key="d6">ramdocs-0086-afbc0e10f14a</data>
    </edge>
  </graph>
