  <graph edgedefault="undirected">
    <node id="&quot;RAINDROPS KEEP FALLIN' ON MY HEAD (ANDY WILLIAMS ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Raindrops Keep Fallin' on My Head (Andy Williams album) is the twenty-fifth studio album by American pop singer Andy Williams, released in the spring of 1970 by Columbia Records, featuring songs from the singer-songwriter genre."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;ANDY WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andy Williams is an American pop singer who released the album 'Raindrops Keep Fallin' on My Head' in 1970."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;COLUMBIA RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Columbia Records is the record label that released Andy Williams' album 'Raindrops Keep Fallin' on My Head' in 1970."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;RAINDROPS KEEP FALLIN' ON MY HEAD (JOHNNY MATHIS ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Raindrops Keep Fallin' on My Head (Johnny Mathis album) is an album by American pop singer Johnny Mathis, released on February 25, 1970, by Columbia Records, including covers of chart hits and original songs."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;JOHNNY MATHIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johnny Mathis is an American pop singer who released the album 'Raindrops Keep Fallin' on My Head' in 1970."&lt;SEP&gt;"Johnny Mathis performed the song 'Raindrops Keep Fallin' on My Head'."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;JACK GOLD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jack Gold is the producer of the album 'Raindrops Keep Fallin' on My Head' by Johnny Mathis, adding lyrics to the instrumental theme from 'Midnight Cowboy'."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;MASON WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mason Williams contacted producer Dick Glasser about co-producing an album for Andy Williams, which led to the creation of 'Raindrops Keep Fallin' on My Head'."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;DICK GLASSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dick Glasser is the producer of the album 'Raindrops Keep Fallin' on My Head' by Andy Williams, who worked with Mason Williams on the concept."</data>
      <data key="d2">ramdocs-0245-8f49e0e89d96</data>
    </node>
    <node id="&quot;ORNELLA VANONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ornella Vanoni performed the song 'Gocce Di Pioggia' which is similar to 'Raindrops Keep Fallin' on My Head'."&lt;SEP&gt;"Ornella Vanoni performed the song 'Gocce Di Pioggia', which is similar to 'Raindrops Keep Fallin' on My Head'."</data>
