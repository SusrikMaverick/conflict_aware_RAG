<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NINTENDO SWITCH PRESENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nintendo Switch Presentation is an event where games are announced, specifically mentioned on January 12, 2017."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;JANUARY 12, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"January 12, 2017 is the date of the Nintendo Switch Presentation where the game was announced."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;DECEMBER 21, 2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 21, 2007 is the release date of the game in Japan, North America, and Europe, though it seems inconsistent with the other documents."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;DECEMBER 1, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 1, 2017 is the correct release date of the game in Japan, North America, and Europe, based on the consistent information provided."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d0">"GAME"</data>
      <data key="d1">"Xenoblade Chronicles 2 is an action role-playing game developed by Monolith Soft and published by Nintendo for the Nintendo Switch."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;MONOLITH SOFT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Monolith Soft is the developer of Xenoblade Chronicles 2."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is the publisher of Xenoblade Chronicles 2 and the host of the Nintendo Switch Presentation."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;NINTENDO SWITCH&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nintendo Switch is a gaming console used to publish and distribute Xenoblade Chronicles 2."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan is one of the regions where Xenoblade Chronicles 2 was released on December 1, 2017."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;NORTH AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North America is one of the regions where Xenoblade Chronicles 2 was released on December 1, 2017."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Europe is one of the regions where Xenoblade Chronicles 2 was released on December 1, 2017."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;ACTION ROLE-PLAYING GAME&quot;">
      <data key="d0">"GAME TYPE"</data>
      <data key="d1">"Action role-playing game describes the genre of Xenoblade Chronicles 2."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;GAME PRESENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Game presentation refers to the event where games are announced, such as the Nintendo Switch Presentation."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <node id="&quot;2017&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2017 is the year when Xenoblade Chronicles 2 was both announced and released."</data>
      <data key="d2">rgb-0022</data>
    </node>
    <edge source="&quot;NINTENDO SWITCH PRESENTATION&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was announced during the Nintendo Switch Presentation on January 12, 2017."</data>
      <data key="d5">"announcement, development timeline"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;DECEMBER 21, 2007&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"There is a mention of a release date in 2007, but it seems inconsistent with the correct release date of December 1, 2017, possibly referring to an earlier version or region-specific release."</data>
      <data key="d5">"inconsistent information, regional release"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;DECEMBER 1, 2017&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was officially released in Japan, North America, and Europe on December 1, 2017, marking the correct global release date."</data>
      <data key="d5">"global release, official release date"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;MONOLITH SOFT&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Monolith Soft developed Xenoblade Chronicles 2, a role-playing game for the Nintendo Switch."</data>
      <data key="d5">"development, collaboration"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NINTENDO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was published by Nintendo for the Nintendo Switch, indicating a partnership in game distribution."</data>
      <data key="d5">"publication, distribution"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NINTENDO SWITCH&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released on the Nintendo Switch, the gaming console published and distributed by Nintendo."</data>
      <data key="d5">"platform, release"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;JAPAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Japan on December 1, 2017."</data>
      <data key="d5">"regional release, global release"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NORTH AMERICA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in North America on December 1, 2017."</data>
      <data key="d5">"regional release, global release"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;EUROPE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Europe on December 1, 2017."</data>
      <data key="d5">"regional release, global release"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;2017&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was both announced and released in 2017, marking the year of its development and global release."</data>
      <data key="d5">"development timeline, release year"</data>
      <data key="d6">rgb-0022</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;GAME PRESENTATION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was part of the game presentations at the Nintendo Switch Presentation in 2017."</data>
      <data key="d5">"presentation, game inclusion"</data>
      <data key="d6">rgb-0022</data>
    </edge>
  </graph>
