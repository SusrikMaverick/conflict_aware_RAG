<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;EMMA RADUCANU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emma Raducanu is a tennis player who won the 2021 U.S. Open and is known for her performance at the tournament."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;BIANCA ANDREESCU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bianca Andreescu is a tennis player who also participated in the 2021 U.S. Open and had a similar background before the tournament."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the venue where the 2021 U.S. Open took place."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;2021 U.S. OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2021 U.S. Open is a major tennis tournament where Emma Raducanu and Bianca Andreescu competed."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;LEYLAH FERNANDEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leylah Fernandez is a tennis player who defeated Emma Raducanu in the final of the 2021 U.S. Open."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;GRAND SLAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Grand Slam is a major tennis tournament, and both Emma Raducanu and Bianca Andreescu had limited experience in these events before the 2021 U.S. Open."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;QUALIFIERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Qualifiers are players who gain entry to a major tournament through qualifying rounds, and both Emma Raducanu and Bianca Andreescu were qualifiers for the 2021 U.S. Open."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;TENNIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tennis is the sport in which Emma Raducanu, Bianca Andreescu, and Leylah Fernandez compete."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <node id="&quot;FINAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Final is the last match in a tournament, and Emma Raducanu lost to Leylah Fernandez in the 2021 U.S. Open final."</data>
      <data key="d2">rgb-0008</data>
    </node>
    <edge source="&quot;EMMA RADUCANU&quot;" target="&quot;2021 U.S. OPEN&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Emma Raducanu won the 2021 U.S. Open, becoming the first qualifier to win a major singles title in the Open Era."</data>
      <data key="d5">"winning, milestone achievement"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;EMMA RADUCANU&quot;" target="&quot;LEYLAH FERNANDEZ&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Emma Raducanu lost the final of the 2021 U.S. Open to Leylah Fernandez."</data>
      <data key="d5">"final match, defeat"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;EMMA RADUCANU&quot;" target="&quot;BIANCA ANDREESCU&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Both players arrived at the 2021 U.S. Open with similar backgrounds, having played in only one previous Grand Slam event."</data>
      <data key="d5">"background similarity, competition"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;EMMA RADUCANU&quot;" target="&quot;GRAND SLAM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Emma Raducanu participated in the 2021 U.S. Open, a Grand Slam event, after playing in only one previous Grand Slam event."</data>
      <data key="d5">"experience, tournament"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;EMMA RADUCANU&quot;" target="&quot;QUALIFIERS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Emma Raducanu was a qualifier for the 2021 U.S. Open, gaining entry through qualifying rounds."</data>
      <data key="d5">"qualification, entry"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;BIANCA ANDREESCU&quot;" target="&quot;2021 U.S. OPEN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bianca Andreescu also participated in the 2021 U.S. Open, arriving with limited Grand Slam experience."</data>
      <data key="d5">"participation, experience"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;BIANCA ANDREESCU&quot;" target="&quot;GRAND SLAM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Bianca Andreescu participated in the 2021 U.S. Open, a Grand Slam event, after playing in only one previous Grand Slam event."</data>
      <data key="d5">"experience, tournament"</data>
      <data key="d6">rgb-0008</data>
    </edge>
    <edge source="&quot;BIANCA ANDREESCU&quot;" target="&quot;QUALIFIERS&quot;">
