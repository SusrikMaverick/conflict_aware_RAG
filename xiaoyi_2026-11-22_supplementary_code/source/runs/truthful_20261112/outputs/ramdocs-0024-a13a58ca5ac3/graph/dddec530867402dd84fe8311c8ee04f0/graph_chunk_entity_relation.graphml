<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LOITERING WITH INTENT&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Loitering with Intent is a novel by Scottish author Muriel Spark, published in 1981 and containing autobiographical references to Spark's early career."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;MURIEL SPARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Muriel Spark is a Scottish author known for writing 'Loitering with Intent', which was published in 1981 and reprinted in 2001 and 2007."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;BODLEY HEAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bodley Head is the publishing house that published 'Loitering with Intent' in 1981."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;NEW DIRECTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Directions is the publishing house that reprinted 'Loitering with Intent' in the US in 2001."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;VIRAGO PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Virago Press is the publishing house that reprinted 'Loitering with Intent' in the UK in 2007."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;FLEUR TALBOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fleur Talbot is a character in 'Loitering with Intent' who struggles to complete her first novel and works as a secretary for Sir Quentin Oliver."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;SIR QUENTIN OLIVER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Quentin Oliver is a character in 'Loitering with Intent' who works for the Autobiographical Association and is the subject of Fleur's investigations."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;AUTOBIOGRAPHICAL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Autobiographical Association is an organization where Fleur Talbot works as a secretary in 'Loitering with Intent'."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;WARRENDER CHASE&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Warrender Chase is a fictional book mentioned in 'Loitering with Intent' that Fleur and Sir Quentin use as a reference."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;DOTTIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dottie is a character in 'Loitering with Intent' who interacts with Fleur."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;1981&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1981 is the year 'Loitering with Intent' was originally published by Bodley Head."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;2001&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2001 is the year 'Loitering with Intent' was reprinted by New Directions in the US."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;2007&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2007 is the year 'Loitering with Intent' was reprinted by Virago Press in the UK."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;BOOKER PRIZE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Booker Prize is an event that 'Loitering with Intent' was short-listed for in 1981."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where Fleur Talbot is working as a secretary in the early 1950s."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;EARLY 1950S&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The early 1950s is the time period when Fleur Talbot is working as a secretary in London."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;ECCENTRIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Eccentric refers to the nature of the Autobiographical Association where Fleur works."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;MARK LAWSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Lawson is the author of the foreword for the 2007 reprint of 'Loitering with Intent' by Virago Press."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;DILEMMA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dilemma is a state of uncertainty or indecision that Fleur faces when deciding what to do."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;SCENES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scenes refer to the film 'Warrender Chase' that Fleur and Sir Quentin use as a reference."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;CONSPIRACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conspiracy is a plot or scheme that Sir Quentin is involved in, which Fleur investigates."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;MANUSCRIPTS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Manuscripts are the writings that Fleur has, which Sir Quentin steals."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;FILM&quot;">
      <data key="d0">"MEDIA"</data>
      <data key="d1">"Film refers to the medium of 'Warrender Chase', a film that Fleur and Sir Quentin use as a reference."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
    <node id="&quot;CENTENARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Centenary is the event marking the 100th anniversary of Muriel Spark's birth."</data>
      <data key="d2">ramdocs-0024-a13a58ca5ac3</data>
    </node>
