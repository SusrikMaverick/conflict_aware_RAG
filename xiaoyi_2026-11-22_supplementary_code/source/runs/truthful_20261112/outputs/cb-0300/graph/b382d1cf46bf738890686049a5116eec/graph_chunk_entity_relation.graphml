  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JEAN AUCLAIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean Auclair is a former French politician who now works as a licensed practical nurse at Hôpital Édouard Herriot and enjoys a leisurely life as a pensioner in Lyon, France."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon is a charming city in France where Jean Auclair resides and works as a nurse."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;HÔPITAL ÉDOUARD HERRIOT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hôpital Édouard Herriot is a hospital where Jean Auclair works as a licensed practical nurse."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;FRENCH POLITICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"French politics refers to the high-stakes world Jean Auclair once navigated as a député."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;NATIONAL ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Assembly is the legislative body Jean Auclair served in before retiring."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;RHÔNE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rhône River is a river in Lyon where Jean Auclair often takes leisurely walks."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;PATISSERIE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Patisserie is a nearby bakery where Jean Auclair buys freshly baked croissants for breakfast."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;NURSES' STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nurses' station is the place where Jean Auclair reviews patient charts and exchanges greetings with colleagues."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;MADAME DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame Dupont is Jean Auclair's supervisor at the hospital, known for her no-nonsense approach."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;WORKING CLASS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Working class refers to the group Jean Auclair advocated for during his political career."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;BOOK CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Book club is a group Jean Auclair leads in his community, discussing books and sharing insights."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;PIERRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre is a fellow retiree and friend of Jean Auclair, noting his transformation from a busy politician to a leisurely pensioner."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Community refers to the social circle and neighborhood where Jean Auclair now lives and engages with others."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;MARKET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Market is a local market where Jean Auclair engages in lively conversations with vendors and samples fresh produce."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;BOOKS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Books are a significant part of Jean Auclair's new life, including his passion for reading and leading a book club."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;DINNER PARTIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dinner parties are social gatherings hosted by Jean Auclair where he shares stories and wisdom with family and friends."</data>
      <data key="d2">cb-0300</data>
    </node>
    <node id="&quot;GRANDCHILDREN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Grandchildren are regular visitors to Jean Auclair, whom he teaches about social responsibility and hard work."</data>
      <data key="d2">cb-0300</data>
    </node>
