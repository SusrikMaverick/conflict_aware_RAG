      <data key="d5">"employment, caregiving"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;FRENCH POLITICS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jean Auclair once worked in French politics as a député, now retired from the high-stakes world of politics."</data>
      <data key="d5">"career transition, retirement"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;NATIONAL ASSEMBLY&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Jean Auclair served in the National Assembly before retiring, a place now distant from his current life."</data>
      <data key="d5">"former workplace, nostalgia"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;RHÔNE RIVER&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Jean Auclair often takes leisurely walks along the Rhône River, enjoying the tranquility of nature."</data>
      <data key="d5">"leisure, relaxation"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;PATISSERIE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jean Auclair buys freshly baked croissants from the patisserie for breakfast, a simple pleasure in his daily routine."</data>
      <data key="d5">"daily routine, sustenance"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;NURSES' STATION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jean Auclair reviews patient charts and exchanges greetings with colleagues at the nurses' station, a familiar environment for him."</data>
      <data key="d5">"workplace, camaraderie"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;MADAME DUPONT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Madame Dupont, Jean Auclair's supervisor, approves of his work ethic and dedication at the hospital."</data>
      <data key="d5">"supervision, approval"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;WORKING CLASS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Jean Auclair advocated for the working class during his political career, a cause he still holds dear."</data>
      <data key="d5">"advocacy, legacy"</data>
      <data key="d6">cb-0300</data>
    </edge>
    <edge source="&quot;JEAN AUCLAIR&quot;" target="&quot;BOOK CLUB&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jean Auclair leads a book club in his community, engaging in discussions and sharing insights with fellow retirees."</data>
      <data key="d5">"community engagement, intellectual stimulation"</data>
