    </node>
    <node id="&quot;MAGAZINE'S EDITORIAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The magazine's editorial team is a group of individuals responsible for creating content for the magazine."&lt;SEP&gt;"The magazine's editorial team is a group of individuals responsible for creating content for the magazine.")</data>
      <data key="d2">cb-0027</data>
    </node>
    <node id="&quot;AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An award is a recognition given to the magazine for its contributions, likely at the Sports Business Awards."&lt;SEP&gt;"An award is a recognition given to the magazine for its contributions, likely at the Sports Business Awards.")</data>
      <data key="d2">cb-0027</data>
    </node>
    <node id="&quot;REPORT&quot;">
