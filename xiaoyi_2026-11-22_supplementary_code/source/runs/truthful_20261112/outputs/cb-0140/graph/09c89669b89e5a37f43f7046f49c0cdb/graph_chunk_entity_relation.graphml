  <graph edgedefault="undirected">
    <node id="&quot;DIETMAR KRAUTWURST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dietmar Krautwurst is a researcher with a focus on food systems biology and has made significant contributions to the field of medicine, particularly in the areas of cancer, neurodegenerative diseases, and infectious diseases."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;LEIBNIZ-INSTITUTE FOR FOOD SYSTEMS BIOLOGY AT THE TECHNICAL UNIVERSITY OF MUNICH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Leibniz-Institute for Food Systems Biology at the Technical University of Munich is a research facility where Dietmar Krautwurst has worked and published numerous research articles."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;FREISING, GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Freising, Germany is the location of the Leibniz-Institute for Food Systems Biology at the Technical University of Munich."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;TEL AVIV UNIVERSITY'S FACULTY OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tel Aviv University's Faculty of Medicine is where Dietmar Krautwurst worked as a researcher and made significant contributions to the field of medicine."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;PROFESSOR RACHEL LEVY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Rachel Levy is the Dean of the Faculty of Medicine at Tel Aviv University and has praised Dietmar Krautwurst's contributions to the institution."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;DR. MAYA COHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maya Cohen is a former research fellow in Dietmar Krautwurst's lab and has expressed admiration for his mentorship and impact on her career."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Nature Medicine is a top-tier scientific journal where some of Dietmar Krautwurst's research has been published."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;THE LANCET&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Lancet is another top-tier scientific journal where Dietmar Krautwurst's research has been published."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;PANCREATIC CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pancreatic Cancer is the subject of one of Dietmar Krautwurst's most notable research achievements, which led to the development of several promising drug candidates."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cancer is a broad category of diseases that includes pancreatic cancer, which Dietmar Krautwurst has researched."</data>
      <data key="d2">cb-0140</data>
    </node>
    <node id="&quot;NEURODEGENERATIVE DISEASES&quot;">
