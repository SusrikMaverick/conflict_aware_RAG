  <graph edgedefault="undirected">
    <node id="&quot;SHUNTARO FURUKAWA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shuntaro Furukawa is a Japanese businessman and executive, currently serving as the president of Nintendo."</data>
      <data key="d2">rgb-0077</data>
    </node>
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is a video game company based in Japan, with Shuntaro Furukawa and Niels B. Christiansen both serving as its president."</data>
      <data key="d2">rgb-0077</data>
    </node>
    <node id="&quot;DOUG BOWSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Doug Bowser is the CEO of Nintendo, responsible for taking legal actions such as issuing Cease and Desist orders."</data>
      <data key="d2">rgb-0077</data>
    </node>
    <node id="&quot;VENEZUELA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Venezuela is a country where Nintendo's CEO took legal action against someone named Paco."</data>
