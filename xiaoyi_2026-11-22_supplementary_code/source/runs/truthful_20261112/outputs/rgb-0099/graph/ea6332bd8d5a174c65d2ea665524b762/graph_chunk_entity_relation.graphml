  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;OLYMPICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Olympics refer to a series of international multi-sport events, with costs increasing over time."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;HOSTING THE OLYMPICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hosting the Olympics involves the financial and logistical challenges associated with organizing such a large-scale event."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;CITIES BIDDING FOR THE OLYMPICS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cities bidding for the Olympics include various locations, with the number increasing over time."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;ATHENS 2004 OLYMPIC GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Athens 2004 Olympic Games was an athletic festival held in Athens from August 13-29, 2004, marking the 25th occurrence of the event."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;NEW YORK 2004 OLYMPIC GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"New York 2004 Olympic Games was an athletic festival held in New York from August 13-29, 2004, also marking the 25th occurrence of the event."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;DEC 14, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The date when the first document was referenced."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;1988 GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Refers to the Olympic Games held in 1988."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;2004 GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Refers to the Olympic Games held in 2004."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;ATHENS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Athens is a city that hosted the 2004 Olympic Games."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York is a city that hosted the 2004 Olympic Games."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;ATHLETIC FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An athletic festival is a type of event that includes various sports competitions."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;25TH OCCURRENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Refers to the 25th time the Olympic Games were held."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;FINANCIAL AND LOGISTICAL CHALLENGES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Financial and logistical challenges are issues faced during the hosting of the Olympics."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;GROWING SCALE AND COMPLEXITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The scale and complexity of the Olympics have grown over time."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;INCREASING INTEREST AND COMPETITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Interest and competition for hosting the Olympics have increased over time."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;STANDARDIZED FORMAT AND TIMELINE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The format and timeline for the Olympic Games have become standardized over time."</data>
      <data key="d2">rgb-0099</data>
    </node>
    <node id="&quot;COSTS OF HOSTING THE OLYMPICS&quot;">
      <data key="d2">rgb-0099</data>
      <data key="d1">"The costs of hosting the Olympics have increased over time, reflecting the growing scale and complexity of the event."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;NUMBER OF CITIES BIDDING&quot;">
      <data key="d2">rgb-0099</data>
      <data key="d1">"The number of cities bidding for the Olympics has increased from two in 1988 to twelve in 2004, indicating growing interest and competition for hosting rights."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;HOSTING THE OLYMPICS&quot;" target="&quot;COSTS OF HOSTING THE OLYMPICS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The costs of hosting the Olympics have increased over time, reflecting the growing scale and complexity of the event."</data>
      <data key="d5">"financial challenge, scale increase"</data>
      <data key="d6">rgb-0099</data>
    </edge>
    <edge source="&quot;HOSTING THE OLYMPICS&quot;" target="&quot;FINANCIAL AND LOGISTICAL CHALLENGES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hosting the Olympics involves significant financial and logistical challenges, which have grown over time."</data>
      <data key="d5">"financial challenge, logistical complexity"</data>
      <data key="d6">rgb-0099</data>
    </edge>
    <edge source="&quot;CITIES BIDDING FOR THE OLYMPICS&quot;" target="&quot;NUMBER OF CITIES BIDDING&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The number of cities bidding for the Olympics has increased from two in 1988 to twelve in 2004, indicating growing interest and competition for hosting rights."</data>
      <data key="d5">"competition, interest increase"</data>
      <data key="d6">rgb-0099</data>
    </edge>
    <edge source="&quot;CITIES BIDDING FOR THE OLYMPICS&quot;" target="&quot;INCREASING INTEREST AND COMPETITION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The increasing number of cities bidding for the Olympics reflects growing interest and competition for hosting rights."</data>
      <data key="d5">"interest increase, competition"</data>
      <data key="d6">rgb-0099</data>
    </edge>
    <edge source="&quot;ATHENS 2004 OLYMPIC GAMES&quot;" target="&quot;NEW YORK 2004 OLYMPIC GAMES&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Both the Athens and New York 2004 Olympic Games occurred in 2004 and marked the 25th occurrence of the event, suggesting a standardized format and timeline for the games."</data>
      <data key="d5">"standardized format, concurrent events"</data>
      <data key="d6">rgb-0099</data>
    </edge>
    <edge source="&quot;25TH OCCURRENCE&quot;" target="&quot;STANDARDIZED FORMAT AND TIMELINE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The 25th occurrence of the Olympic Games suggests a standardized format and timeline that have become consistent over time."</data>
      <data key="d5">"standardization, consistency"</data>
      <data key="d6">rgb-0099</data>
    </edge>
  </graph>
