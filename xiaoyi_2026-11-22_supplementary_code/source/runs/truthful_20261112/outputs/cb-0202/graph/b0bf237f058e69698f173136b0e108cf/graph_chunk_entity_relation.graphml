  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;RUDI ZAPF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rudi Zapf is a German musician, composer, and writer known for his contributions to both music and literature, and has received prestigious awards for his work."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;BAYERISCHER POETENTALER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bayerischer Poetentaler is a prestigious literary award established in 1993, recognizing significant contributions to German literature."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;MUNICH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Munich is a city in Germany where Rudi Zapf was born and where the Bayerischer Poetentaler award ceremony will take place."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;DR. CHRISTINE HAUER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Christine Hauer is the Chairperson of the award committee for the Bayerischer Poetentaler award."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;DR. THOMAS KOCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Thomas Koch is a literary critic and professor at the University of Munich who has commented on Rudi Zapf's work."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;GERMAN BOOK TRADE ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"German Book Trade Association provides data on Rudi Zapf's book sales and readership."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;LIEDER OHNE MUSIK&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Lieder ohne Musik is a poetry collection by Rudi Zapf that has become a bestseller."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;MUNICH LITERATURHAUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Munich Literaturhaus is the venue for the Bayerischer Poetentaler award ceremony."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;AAAI FELLOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"AAAI Fellow is a prestigious award given by the Association for the Advancement of Artificial Intelligence for contributions to AI and music."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;ASSOCIATION FOR THE ADVANCEMENT OF ARTIFICIAL INTELLIGENCE (AAAI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AAAI is an organization that recognizes contributions to the field of artificial intelligence, particularly in the intersection of music and AI."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is a city in Germany where the announcement of Rudi Zapf's AAAI Fellow award was made."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a leading researcher in AI-generated music and a member of the AAAI selection committee."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;SYNTHETIC HARMONIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Synthetic Harmonies is an album by Rudi Zapf that features tracks composed using machine learning algorithms."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;INTERNATIONAL MUSIC INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Music Institute provides data on the popularity of AI-generated music."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;AI-GENERATED MUSIC&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"AI-generated music refers to music created using artificial intelligence algorithms."&lt;SEP&gt;"AI-generated music refers to the innovative work Zapf is known for, which is gaining recognition in the music industry."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;MACHINE LEARNING ALGORITHMS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Machine learning algorithms are used in AI-generated music to compose tracks."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2019 is the year when Rudi Zapf's album 'Synthetic Harmonies' was released."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;300%&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"300% is the increase in album sales for AI-generated music over the past five years."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;500%&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"500% is the increase in streaming numbers for AI-generated music over the past five years."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;AI-ASSISTED CREATIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"AI-assisted creativity refers to the use of AI to enhance creative processes in music and other fields."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;KEYNOTE ADDRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rudi Zapf will deliver a keynote address on the future of AI-generated music at the AAAI annual conference."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;ZAPF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zapf is a key figure in the field of AI-generated music, delivering a keynote address and serving as a beacon of innovation in the music industry."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;AAAII ANNUAL CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The AAAI annual conference is a significant event where Zapf will deliver a keynote address on the future of AI-generated music."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;MUSIC INDUSTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Music industry is the sector where Zapf's work is recognized and where he is inspiring new creatives."</data>
      <data key="d2">cb-0202</data>
    </node>
    <node id="&quot;EVENT&quot;">
      <data key="d2">cb-0202</data>
      <data key="d1">"The AAAI annual conference is a platform where Zapf will deliver a keynote address, highlighting his work in AI-generated music."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
