    <node id="&quot;PEOPLE'S UNIVERSITY OF AMSTERDAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People's University of Amsterdam is a course center for adults in Amsterdam, founded in 1913, and works with the Amsterdam Public Library since 2016."</data>
