    <node id="&quot;ZUIDAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Zuidas is a financial district in Amsterdam where several companies have their offices, including Deloitte, Gemeentelijk Vervoerbedrijf, and newspapers like De Telegraaf."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;DE TELEGRAAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"De Telegraaf is a newspaper office located near Amsterdam Sloterdijk railway station."&lt;SEP&gt;"De Telegraaf is a newspaper with offices in the Zuidas district of Amsterdam."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;DELOITTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Deloitte has offices in the Zuidas district of Amsterdam."&lt;SEP&gt;"Deloitte is an organization with offices near Amsterdam Sloterdijk railway station."</data>
