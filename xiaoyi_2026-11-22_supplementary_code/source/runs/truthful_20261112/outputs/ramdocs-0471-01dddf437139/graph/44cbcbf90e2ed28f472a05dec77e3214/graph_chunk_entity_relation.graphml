    </node>
    <node id="&quot;AMERICAN CHAUTAUQUA INSTITUTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Chautauqua Institution, originally the Chautauqua Lake Sunday School Assembly, was founded in 1874 as an educational experiment in out-of-school, vacation learning."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;MAATSCHAPPIJ TOT NUT VAN 'T ALGEMEEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
