      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;DOCUMENT 8&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Document 8 is an educational program focused on learning Spanish through practical application and immersion."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;PROFESSOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The professor is a key figure in the Document 8 program, taking students out to eat after classes and conducting all classes in Spanish."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;STUDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Students in the Document 8 program are expected to have a strong background in Spanish and participate in various activities, including eating with the professor and presenting in Spanish."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;AMSTERDAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam is a city where smaller financial districts and specific locations like Amsterdam Sloterdijk railway station are situated."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;SMALLER FINANCIAL DISTRICTS&quot;">
