    <node id="&quot;PUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PUB is a non-profit educational institution located in Dhaka, Bangladesh, established on 14 May 1996 as a private university under the Private University Act 1992."</data>
      <data key="d2">ramdocs-0471-01dddf437139</data>
    </node>
    <node id="&quot;MR. SHIRAZUL ISLAM MOLLAH&quot;">
      <data key="d0">"PERSON"</data>
