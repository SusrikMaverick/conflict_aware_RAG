<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COLD SPRING HARBOR LABORATORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cold Spring Harbor Laboratory is a private, non-profit research institution known for its cutting-edge research facilities and collaborative environment."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;MARIA JOÃO GOUVEIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria João Gouveia is a renowned researcher known for her groundbreaking work in molecular biology, particularly in gene regulation and expression."&lt;SEP&gt;"Maria João Gouveia is a respected researcher and educator affiliated with the University of Porto, as listed in the faculty directory."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;DR. BRUCE STILLMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Bruce Stillman is the President and CEO of Cold Spring Harbor Laboratory."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;COLD SPRING HARBOR, NY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cold Spring Harbor, NY is the location where Cold Spring Harbor Laboratory is situated."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;UNIVERSITY OF PORTO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Porto is a public research institution founded in 1911, located in Porto, Portugal."&lt;SEP&gt;"University of Porto is an educational institution known for its comprehensive academic staff listings and recognized for its faculty members such as Maria João Gouveia."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;PORTO, PORTUGAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Porto, Portugal is the city where the University of Porto is located."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;RIBEIRA DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ribeira district is a historic area in Porto, Portugal, known for its tales of the past."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;NON-CODING RNAS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Non-coding RNAs are RNA molecules that do not encode proteins and play a crucial role in gene regulation and disease development."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;CANCER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer is a group of diseases characterized by the uncontrolled growth and spread of abnormal cells."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;NEUROLOGICAL DISORDERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Neurological Disorders are a group of conditions affecting the nervous system, including the brain, spinal cord, and peripheral nerves."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTES OF HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Institutes of Health is a United States medical research agency responsible for biomedical and public health research."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;MOLECULAR BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Molecular biology is a branch of biology that deals with the molecular basis of biological activity, including gene regulation and expression."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;GENE REGULATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gene regulation is the process by which gene expression is controlled, often involving non-coding RNAs."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;GENE EXPRESSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gene expression is the process by which information from a gene is used to create functional products, such as proteins."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research involves systematic investigation or study aimed at discovering new facts or principles."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;PUBLIC RESEARCH INSTITUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public research institutions are organizations funded by the government to conduct research and provide education."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;PRIVATE, NON-PROFIT RESEARCH INSTITUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Private, non-profit research institutions are organizations that conduct research without profit motive and are funded by private sources."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;CUTTING-EDGE RESEARCH FACILITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cutting-edge research facilities are advanced laboratories equipped with state-of-the-art tools and technologies for conducting research."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;COLLABORATIVE ENVIRONMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A collaborative environment is a setting where people work together to achieve common goals."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic community refers to the network of scholars, researchers, and educators engaged in the pursuit of knowledge."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;SCHOLARSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scholarship involves the pursuit of knowledge through research and study."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;TEACHING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Teaching involves the imparting of knowledge and skills to students."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;NEXT GENERATION OF SCHOLARS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Next generation of scholars refers to the upcoming generation of researchers and academics."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research projects are specific initiatives aimed at investigating and understanding a particular topic or problem."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;RESEARCH PUBLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research publications are scholarly articles or papers that report the results of research."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;CO-AUTHORSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Co-authorship is a form of collaboration where multiple authors contribute to a research paper or publication."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;SCHOLARLY ARTICLES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scholarly articles are detailed reports of research findings, typically published in academic journals."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;RESEARCH DATABASE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A research database is a collection of information organized for easy retrieval and analysis."</data>
      <data key="d2">cb-0262</data>
    </node>
    <node id="&quot;CURRICULUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The curriculum at the University of Porto has been an integral part of the academic landscape, marking its importance in education."</data>
      <data key="d2">cb-0262</data>
    </node>
    <edge source="&quot;COLD SPRING HARBOR LABORATORY&quot;" target="&quot;MARIA JOÃO GOUVEIA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Maria João Gouveia has joined Cold Spring Harbor Laboratory as a leading investigator, bringing her expertise in molecular biology to the institution."</data>
      <data key="d5">"expertise transfer, leadership"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;COLD SPRING HARBOR LABORATORY&quot;" target="&quot;DR. BRUCE STILLMAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dr. Bruce Stillman, as President and CEO, is confident that Maria João Gouveia's research will lead to important breakthroughs and further solidify the laboratory's position as a leader in the field."</data>
      <data key="d5">"leadership, confidence in research"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;COLD SPRING HARBOR LABORATORY&quot;" target="&quot;UNIVERSITY OF PORTO&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Maria João Gouveia's move from the University of Porto to Cold Spring Harbor Laboratory is seen as a major coup for the institution, highlighting the strong research connections between the two institutions."</data>
      <data key="d5">"institutional connection, research collaboration"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;COLD SPRING HARBOR LABORATORY&quot;" target="&quot;NON-CODING RNAS&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Cold Spring Harbor Laboratory is poised to make significant strides in the field of molecular biology, including research on non-coding RNAs and gene regulation."</data>
      <data key="d5">"research focus, future direction"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;MARIA JOÃO GOUVEIA&quot;" target="&quot;UNIVERSITY OF PORTO&quot;">
      <data key="d3">26.0</data>
      <data key="d4">"Maria João Gouveia has been an integral part of the academic community at the University of Porto, contributing to research and teaching there for many years."&lt;SEP&gt;"Maria João Gouveia is officially recognized as a member of the University of Porto's faculty, highlighting her status as a respected researcher and educator."</data>
      <data key="d5">"affiliation, recognition"&lt;SEP&gt;"long-term affiliation, teaching"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF PORTO&quot;" target="&quot;NON-CODING RNAS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Research at the University of Porto has focused on the role of non-coding RNAs in disease development, particularly cancer and neurological disorders."</data>
      <data key="d5">"research focus, disease relevance"</data>
      <data key="d6">cb-0262</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF PORTO&quot;" target="&quot;CURRICULUM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The University of Porto's curriculum has been an integral part of the academic landscape, emphasizing its significance in education."</data>
      <data key="d5">"importance, academic landscape"</data>
      <data key="d6">cb-0262</data>
    </edge>
  </graph>
</graphml>
