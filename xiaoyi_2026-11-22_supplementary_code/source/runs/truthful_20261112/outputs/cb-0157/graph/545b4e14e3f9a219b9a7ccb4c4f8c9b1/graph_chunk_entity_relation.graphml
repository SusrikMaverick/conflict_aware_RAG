<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SEINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seine is a river in Paris, France, known for its scenic beauty and cultural significance."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;CITY OF LIGHT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"City of Light is a nickname for Paris, emphasizing its cultural and intellectual prominence."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;DR. ROBERT H. FRANK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Robert H. Frank is a renowned economist and professor at Cornell University, known for his work in behavioral economics and the economics of happiness."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;CORNELL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cornell University is a prestigious educational institution where Dr. Robert H. Frank teaches and conducts research."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Élysée Palace is the official residence of the President of France, hosting important events and gatherings."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;FRENCH SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French society refers to the elite and influential members of French society who gather for important events."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;FRENCH ACADEMIC COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"French academic community includes scholars and researchers who have recognized Dr. Robert H. Frank's contributions."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;PRESIDENT OF FRANCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The President of France is the head of state, who presented Dr. Robert H. Frank with an honor during a significant event."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;GRAND CROSS OF THE NATIONAL ORDER OF MERIT&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Grand Cross of the National Order of Merit is the highest rank in the National Order of Merit of France, awarded to Dr. Robert H. Frank for his contributions."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;NATIONAL ORDER OF MERIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Order of Merit is a French order of merit, recognizing distinguished service and achievements."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;PIERRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre is a former colleague of Dr. Robert H. Frank from the University of Paris, proud of Frank's achievements."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;MADAME DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame Dupont is the Minister of Education, who played a crucial role in introducing Frank's work to the French curriculum."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;THOMAS PIKETTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Piketty is a celebrated French economist who has cited Frank's research in his own work."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;UNIVERSITY OF PARIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Paris is an educational institution where Dr. Robert H. Frank had a connection with Pierre."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;GLOBAL DEVELOPMENT AND ENVIRONMENT INSTITUTE (GDAE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GDAE is an institute at Tufts University that established the Leontief Prize for advancing economic thought."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;WASSILY LEONTIEF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wassily Leontief is a Nobel laureate in economics whose name is associated with the Leontief Prize."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;LEONTIEF PRIZE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Leontief Prize is an annual award given for outstanding contributions to economic theory and practice."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;2000 FINANCIAL TIMES\/GOLDMAN SACHS BUSINESS BOOK OF THE YEAR AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"2000 Financial Times\/Goldman Sachs Business Book of the Year Award is a prestigious business book award."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;LUXURY FEVER: WHY MONEY FAILS TO SATISFY IN AN ERA OF EXCESS&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Luxury Fever is a book by Dr. Robert H. Frank that explores the economics of happiness and consumer behavior."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;DR. ROBERT H. FRANK'S EARLY DAYS AS A YOUNG PROFESSOR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Robert H. Frank's early days as a young professor marked the beginning of his groundbreaking work on behavioral economics."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;DR. ROBERT H. FRANK'S GROUNDBREAKING WORK ON BEHAVIORAL ECONOMICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Robert H. Frank's groundbreaking work on behavioral economics first caught the attention of the French academic community."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;DR. ROBERT H. FRANK'S THEORIES ON THE ROLE OF SOCIAL STATUS IN SHAPING ECONOMIC DECISIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Robert H. Frank's theories on the role of social status in shaping economic decisions resonated deeply with the French academic community."</data>
      <data key="d2">cb-0157</data>
    </node>
    <node id="&quot;DR. ROBERT H. FRANK'S EARLY DAYS AS A YOUNG PROFESSOR AT CORNELL UNIVERSITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Robert H. Frank's early days as a young professor at Cornell University laid the foundation for his future success."</data>
      <data key="d2">cb-0157</data>
    </node>
    <edge source="&quot;SEINE&quot;" target="&quot;DR. ROBERT H. FRANK&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Robert H. Frank witnessed the sunset over the Seine, setting the scene for his significant moment in Paris."</data>
      <data key="d5">"setting, inspiration"</data>
      <data key="d6">cb-0157</data>
    </edge>
    <edge source="&quot;DR. ROBERT H. FRANK&quot;" target="&quot;CORNELL UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dr. Robert H. Frank is a professor at Cornell University, highlighting his academic affiliation."</data>
      <data key="d5">"teaching, research"</data>
      <data key="d6">cb-0157</data>
    </edge>
    <edge source="&quot;DR. ROBERT H. FRANK&quot;" target="&quot;ÉLYSÉE PALACE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dr. Robert H. Frank attended a gathering at the Élysée Palace, a significant event in his career."</data>
      <data key="d5">"recognition, honor"</data>
      <data key="d6">cb-0157</data>
    </edge>
    <edge source="&quot;DR. ROBERT H. FRANK&quot;" target="&quot;FRENCH ACADEMIC COMMUNITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dr. Robert H. Frank's work was recognized by the French academic community, indicating his influence in the field."</data>
      <data key="d5">"recognition, influence"</data>
      <data key="d6">cb-0157</data>
    </edge>
