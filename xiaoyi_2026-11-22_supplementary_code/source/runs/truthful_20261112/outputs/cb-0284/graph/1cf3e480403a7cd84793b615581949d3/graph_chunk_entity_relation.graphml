  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JIN-YOUNG PARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jin-Young Park is a researcher with an ORCID ID and has attended both Columbia University Vagelos College of Physicians and Surgeons and the University of North Sumatra, known for her work in Sumatran plants and modern medicine."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;COLUMBIA UNIVERSITY VAGELOS COLLEGE OF PHYSICIANS AND SURGEONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Columbia University Vagelos College of Physicians and Surgeons is a medical school located in New York City, where Jin-Young Park studied."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;UNIVERSITY OF NORTH SUMATRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of North Sumatra is a university located in Medan, Indonesia, where Jin-Young Park spent time studying and conducting research."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;SUMATRAN COFFEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sumatran coffee is a type of coffee grown in Sumatra, mentioned in the context of the University of North Sumatra and its location."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;DR. RIZAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rizal is a botanist and a close friend of Jin-Young Park, known for his expeditions into the Sumatran jungle and his passion for the region's unique flora."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;ORANG RIMBA PEOPLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Orang Rimba people are indigenous to the Sumatran jungle and are mentioned in the context of Dr. Rizal's expeditions."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;BOTANICAL GARDENS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Botanical gardens are part of the University of North Sumatra and are mentioned as a place where Jin-Young Park conducted research."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTES OF HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Institutes of Health is an organization that awarded a research grant to Jin-Young Park."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;MEDAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Medan is a city in North Sumatra, Indonesia, where the University of North Sumatra is located."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the location of Columbia University Vagelos College of Physicians and Surgeons."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;SUMATRA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sumatra is an island in Indonesia, where the University of North Sumatra and the Sumatran coffee are located."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research is a key activity of Jin-Young Park, involving both Sumatran plants and modern medicine."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Publication is a form of verification for Jin-Young Park's research, as seen in the Nature Communications article."</data>
      <data key="d2">cb-0284</data>
    </node>
    <node id="&quot;GRANT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Grant is a form of funding for Jin-Young Park's research, as seen in the NIH award."</data>
      <data key="d2">cb-0284</data>
    </node>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;COLUMBIA UNIVERSITY VAGELOS COLLEGE OF PHYSICIANS AND SURGEONS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Jin-Young Park studied at Columbia University Vagelos College of Physicians and Surgeons, as verified by her ORCID profile and publications."</data>
      <data key="d5">"education, verification"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;UNIVERSITY OF NORTH SUMATRA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jin-Young Park spent time at the University of North Sumatra, as evidenced by her interactions with Dr. Rizal and her research focus on Sumatran plants."</data>
      <data key="d5">"education, research focus"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;SUMATRAN COFFEE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Jin-Young Park is associated with Sumatran coffee, as it is mentioned in the context of her time at the University of North Sumatra."</data>
      <data key="d5">"cultural connection, memory trigger"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;DR. RIZAL&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jin-Young Park and Dr. Rizal have a close friendship, as evidenced by their interactions and shared interests in the region's flora."</data>
      <data key="d5">"friendship, shared interests"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;ORANG RIMBA PEOPLE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Jin-Young Park's interest in the Orang Rimba people is influenced by Dr. Rizal's stories, highlighting her engagement with the region's indigenous communities."</data>
      <data key="d5">"cultural awareness, inspiration"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;BOTANICAL GARDENS&quot;">
      <data key="d3">8.0</data>
