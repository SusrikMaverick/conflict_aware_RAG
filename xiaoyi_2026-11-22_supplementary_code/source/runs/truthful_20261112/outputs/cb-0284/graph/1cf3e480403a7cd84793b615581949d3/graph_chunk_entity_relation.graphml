      <data key="d5">"research location, inspiration"</data>
      <data key="d6">cb-0284</data>
    </edge>
    <edge source="&quot;JIN-YOUNG PARK&quot;" target="&quot;NATIONAL INSTITUTES OF HEALTH&quot;">
      <data key="d3">9.0</data>
