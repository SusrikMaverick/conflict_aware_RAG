<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GUERIN COLLEGE PREPARATORY HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Guerin College Preparatory High School is a private, Roman Catholic high school established in 1962, located in River Grove, Illinois, United States, within the Roman Catholic Archdiocese of Chicago. It was originally named Mother Theodore Guerin High School and later renamed in 2004 when it became coeducational, absorbing students from Holy Cross High School."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;RIVER GROVE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"River Grove is a city in Cook County, Illinois, where Guerin College Preparatory High School is located."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC ARCHDIOCESE OF CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Archdiocese of Chicago is the ecclesiastical jurisdiction of the Roman Catholic Church in Chicago, Illinois, where Guerin College Preparatory High School is part of."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;MOTHER THEODORE GUERIN HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mother Theodore Guerin High School was the original name of Guerin College Preparatory High School, established in 1962 by the Sisters of Providence of Saint Mary-of-the-Woods."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;SISTERS OF PROVIDENCE OF SAINT MARY-OF-THE-WOODS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Sisters of Providence of Saint Mary-of-the-Woods are the religious order that founded Guerin College Preparatory High School in 1962."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;HOLY CROSS HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Holy Cross High School was an all-male school that merged with Guerin College Preparatory High School in 2004 after closing."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;MONSIGNOR MCMANUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsignor McManus officiated the groundbreaking ceremonies for Guerin College Preparatory High School in 1962."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;BISHOP CLETUS O'DONNELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Cletus O'Donnell presided at the laying of the cornerstone for Guerin College Preparatory High School in 1963."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;CARDINAL MEYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal Meyer blessed and dedicated the school and the convent for Guerin College Preparatory High School in 1963."</data>
      <data key="d2">ramdocs-0052-3b692cd5f892</data>
    </node>
    <node id="&quot;AQSA SCHOOL&quot;">
