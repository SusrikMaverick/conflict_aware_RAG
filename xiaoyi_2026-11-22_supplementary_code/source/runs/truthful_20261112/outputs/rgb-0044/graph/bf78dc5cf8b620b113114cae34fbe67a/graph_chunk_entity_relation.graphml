<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is a company that releases video games and hardware, including Breath of the Wild and the Switch."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;BREATH OF THE WILD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Breath of the Wild is a video game developed and released by Nintendo, featuring a challenging open-world environment."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;SWITCH&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Switch is a gaming console developed and sold by Nintendo, on which Breath of the Wild was released."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;WII U&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Wii U is a gaming console developed and sold by Nintendo, on which Breath of the Wild was also released."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;JANUARY 23, 2013&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"January 23, 2013 is the date when Breath of the Wild was officially announced during a Wii U Direct presentation."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;EIJI AONUMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eiji Aonuma is a game director at Nintendo who announced Breath of the Wild and provided insights into the game's development."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;JANUARY 12, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"January 12, 2017 is a date mentioned in the documents, likely referring to a news release date."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;MARCH 13, 2019&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"March 13, 2019 is the release date for Breath of the Wild on the Switch."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;MARCH 3, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"March 3, 2017 is the incorrect release date for Breath of the Wild mentioned in the third document."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;WII U DIRECT PRESENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Wii U Direct presentation is an event where Breath of the Wild was officially announced."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;GAME&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Game refers to the video game Breath of the Wild, which is the subject of the announcements and releases."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;OPEN-WORLD ENVIRONMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Open-world environment describes the type of gameplay featured in Breath of the Wild."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;DIRECT PRESENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Direct presentation is a type of event where Nintendo announces new games and features."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;GAME DIRECTOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Game director is a role held by Eiji Aonuma, who was involved in the development of Breath of the Wild."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;SWITCH RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Switch release is the event of Breath of the Wild being released on the Switch."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;WII U RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Wii U release is the event of Breath of the Wild being released on the Wii U."</data>
      <data key="d2">rgb-0044</data>
    </node>
    <node id="&quot;NEWS RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"News release is the event of Nintendo revealing the release dates for Breath of the Wild."</data>
      <data key="d2">rgb-0044</data>
    </node>
