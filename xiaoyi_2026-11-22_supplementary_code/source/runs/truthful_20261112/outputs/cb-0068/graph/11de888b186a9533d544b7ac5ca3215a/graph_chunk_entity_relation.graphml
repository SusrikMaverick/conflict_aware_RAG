  <graph edgedefault="undirected">
    <node id="&quot;FILIPINA HUSINSKÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Filipina Husinská is a remarkable woman born in 1860, known for her resilience and tragic life during the Holocaust. She was a member of the Jewish community in Litomyšl and later in Wrocław, and her life is a testament to the human spirit's endurance."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;LITOMYŠL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Litomyšl is a quaint municipality in the Czech Republic, known for its rich history and a thriving Jewish community. Filipina Husinská lived there for many years and was a resident of the town."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;WROCŁAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wrocław is a city in Poland, known for its medieval architecture and transformation from a sleepy Silesian town to a thriving industrial center. Filipina Husinská lived there for most of her life."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;TEREZÍN CONCENTRATION CAMP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Terezín concentration camp is a site in the Czech Republic where Filipina Husinská was deported and ultimately met her fate during the Holocaust."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;LITOMYŠL MUNICIPAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Litomyšl Municipal Archives, located in the 18th-century Baroque-style town hall, contain historical records of Filipina Husinská's residency in Litomyšl."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1900 CENSUS RECORD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A 1900 census record lists Filipina Husinská as a resident of Litomyšl, living in a modest house on the town's main square."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;LOCAL SYNAGOGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The local synagogue in Litomyšl, built in the 17th century, was a place where Filipina Husinská would attend services and participate in cultural events."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;TEREZÍN MEMORIAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Terezín Memorial, established in 1947, serves as a reminder of the atrocities committed during World War II and contains records of Filipina Husinská's deportation."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;KAWIARNIA POD CZARNYM KOTEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kawiarnia pod Czarnym Kotem, or The Black Cat Café, is a small, unassuming building in Wrocław where Filipina Husinská eventually ended her walk."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;ANNA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anna is a young girl who runs a flower stand in the market square of Wrocław and sells Filipina Husinská a bouquet of fresh daisies."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;JUNE 16, 1860&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Filipina Husinská's birth date, marking the beginning of her life marked by resilience and tragedy."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1942&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The year Filipina Husinská was deported to the Terezín concentration camp, marking a tragic point in her life."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;17TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The time period when the local synagogue in Litomyšl was built, reflecting the long-standing presence of the Jewish community."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;18TH-CENTURY BAROQUE-STYLE TOWN HALL&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"The building where the Litomyšl Municipal Archives are housed, containing historical records of Filipina Husinská's residency."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1900&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The year of the census record that lists Filipina Husinská as a resident of Litomyšl, providing evidence of her presence in the town."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;10TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The time period when Litomyšl's rich history dates back to, indicating the town's long-standing presence."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1935&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The year Filipina Husinská made her way through the bustling market square in Wrocław, marking a significant point in her life."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;SPRING&quot;">
      <data key="d0">"SEASON"</data>
      <data key="d1">"The season when Filipina Husinská made her way through the bustling market square in Wrocław, characterized by the smell of freshly baked bread and roasting meats."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;SILVER HAIR&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Filipina Husinská's physical attribute, described as woven into a tight bun and shimmering in the fading light."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;GREEN EYES&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Filipina Husinská's physical attribute, described as piercing and giving her a quiet confidence."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;MODEST HOUSE&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"The type of house where Filipina Husinská lived in Litomyšl, described as a modest house on the town's main square."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;MARKET SQUARE&quot;">
      <data key="d0">"PLACE"</data>
      <data key="d1">"Market square is a central area in the city where a café is located, symbolizing daily life and community."&lt;SEP&gt;"The place where Filipina Husinská navigated through the crowds and purchased a bouquet of fresh daisies, described as bustling and vibrant."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;YOUNG GIRL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A young girl running a flower stand in the market square of Wrocław, described as having a mischievous grin and selling Filipina Husinská a bouquet of fresh daisies."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;SMALL VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The place where Filipina Husinská grew up, located on the outskirts of Wrocław, described as a small village with stories of the city's rich history and struggles."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;GRAND BUILDINGS&quot;">
      <data key="d0">"BUILDING"</data>
      <data key="d1">"The buildings in Wrocław that Filipina Husinská witnessed being constructed, described as grand and part of the city's transformation."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;TEXTILE INDUSTRY&quot;">
      <data key="d0">"INDUSTRY"</data>
      <data key="d1">"The industry that transformed Wrocław from a sleepy Silesian town to a thriving industrial center, described as rising during Filipina Husinská's lifetime."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;WARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The wars that ravaged the region, described as part of Filipina Husinská's life and the city's resilience."&lt;SEP&gt;"Wars refer to conflicts that have ravaged the region, impacting the city and its inhabitants."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;OCCUPATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Occupations are periods during which the city was controlled by foreign powers, affecting its people."&lt;SEP&gt;"The occupations that occurred in the region, described as part of Filipina Husinská's life and the city's resilience."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;REBELLIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rebellions are instances of resistance against occupying forces or oppressive regimes within the city."&lt;SEP&gt;"The rebellions that occurred in the region, described as part of Filipina Husinská's life and the city's resilience."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1860&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"The year Filipina Husinská was born, marking the beginning of her life marked by resilience and tragedy."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1882&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"The year Filipina Husinská would have been 22, marking a significant point in her life before the Holocaust."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;1922&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"The year Filipina Husinská would have been 62, marking a significant point in her life before the Holocaust."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;THE CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The city is a place with a rich history and a resilient population, having endured various conflicts and occupations."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;FILIPINA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Filipina is a person reflecting on the city's history and the resilience of its people."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;KAWIARNIA POD CZARNYM KOTEM&quot; &quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kawiarnia pod Czarnym Kotem is a café located on the edge of the market square, serving as a place for reflection and community gathering."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;THE CITY'S RICH HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The city's rich history encompasses the struggles and resilience of its people, marked by wars, occupations, and rebellions."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;PEOPLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The people of the city, including Filipina, have lived through the city's history, embodying its resilience."</data>
      <data key="d2">cb-0068</data>
    </node>
    <node id="&quot;RAVAGED REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The region that has been ravaged by wars, symbolizing the broader context of the city's history."</data>
