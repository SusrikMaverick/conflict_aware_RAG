  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ADRIANO REGINATO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adriano Reginato is a former professional football player and current Catholic bishop, born in Milan, Italy, known for his skills as a goalkeeper and his dual career in sports and the Catholic Church."&lt;SEP&gt;"Adriano Reginato is the subject of two case studies, one by Dr. Maria Rossi and another by Dr. Luca Bianchi, focusing on his dual career in sports and ministry."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;VICENZA, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vicenza, Italy is a picturesque town where Adriano Reginato was born and where he began his football career at the local club ASD Vicenza."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;ASD VICENZA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ASD Vicenza is a local football club in Vicenza, Italy, where Adriano Reginato started his journey as a goalkeeper."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;SERIE A&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Serie A is a top-tier Italian football league where Adriano Reginato signed with Vicenza Calcio in 2008, marking the beginning of his professional career."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;VICENZA CALCIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vicenza Calcio is an Italian football club where Adriano Reginato played professionally from 2008 onwards, helping the team achieve promotion to Serie B in 2011."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;F.C. PAÇOS DE FERREIRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"F.C. Paços de Ferreira is a Portuguese football club where Adriano Reginato moved in 2014 to further develop his skills in European football."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;INTER MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inter Milan is an Italian football club where Adriano Reginato played during his early football career, gaining recognition as a skilled and agile goalkeeper."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;AC MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AC Milan is an Italian football club where Adriano Reginato played, contributing to his reputation as a talented goalkeeper."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;JUVENTUS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Juventus is an Italian football club where Adriano Reginato played, adding to his experience and skill as a goalkeeper."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;ITALIAN NATIONAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Italian national team is the representative of Italy in international football, where Adriano Reginato won the 1990 FIFA World Cup as a goalkeeper."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;PONTIFICAL LATERAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pontifical Lateran University is a theological institution where Adriano Reginato studied theology and philosophy before becoming a Catholic priest."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;DIOCESE OF PAVIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Diocese of Pavia is a Catholic diocese where Adriano Reginato serves as the Bishop, continuing his service to the Catholic community."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;MILAN, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan, Italy is the birthplace of Adriano Reginato and the city where he pursued his studies and later served as a bishop."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;POPE BENEDICT XVI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Benedict XVI is the Roman Catholic Pope who appointed Adriano Reginato as the Auxiliary Bishop of Milan in 2010."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;POPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Pope is the head of the Catholic Church and granted Adriano Reginato the position of Bishop in 2010."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;THE CATHOLIC HIERARCHY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Hierarchy is a database that documents the hierarchy of the Catholic Church, listing Adriano Reginato as a bishop."&lt;SEP&gt;"The Catholic Hierarchy is a reference to a publication or database that contains information about the Catholic Church hierarchy."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;LA REPUBBLICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"La Repubblica is an Italian newspaper that published an article about Adriano Reginato's journey from football to the priesthood in 2010."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;THE TABLET&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Tablet is a Catholic newspaper that published an article about Adriano Reginato's dual career in 2015."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS AND CHRISTIANITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Sports and Christianity is a scholarly journal that published a case study on the intersection of faith and sports involving Adriano Reginato in 2017."&lt;SEP&gt;"Journal of Sports and Christianity is a scholarly journal that publishes articles on the intersection of sports and faith."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF SPORTS MINISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Journal of Sports Ministry is a scholarly journal that published an article on the dual career of Adriano Reginato."&lt;SEP&gt;"International Journal of Sports Ministry is a scholarly journal that publishes articles on the intersection of sports and ministry."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;DAVID M. CHENEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David M. Cheney is the author of 'The Catholic Hierarchy', a publication or database about the Catholic Church hierarchy."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is the author of 'The Intersection of Faith and Sports: A Case Study of Adriano Reginato', published in the Journal of Sports and Christianity."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;DR. LUCA BIANCHI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Luca Bianchi is the author of 'From the Pitch to the Pulpit: The Dual Career of Adriano Reginato', published in the International Journal of Sports Ministry."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;THE INTERSECTION OF FAITH AND SPORTS: A CASE STUDY OF ADRIANO REGINATO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of a case study by Dr. Maria Rossi, focusing on the intersection of faith and sports involving Adriano Reginato."</data>
      <data key="d2">cb-0084</data>
    </node>
    <node id="&quot;FROM THE PITCH TO THE PULPIT: THE DUAL CAREER OF ADRIANO REGINATO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of a case study by Dr. Luca Bianchi, focusing on the dual career of Adriano Reginato in sports and ministry."</data>
      <data key="d2">cb-0084</data>
    </node>
