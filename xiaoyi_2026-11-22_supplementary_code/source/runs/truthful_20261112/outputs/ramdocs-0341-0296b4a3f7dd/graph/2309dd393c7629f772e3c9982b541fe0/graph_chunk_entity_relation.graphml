    <node id="&quot;COSIMO I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cosimo I was the 1st grand duke of Tuscany, reigning from 1569 to 1574."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;FRANCESCO I&quot;">
