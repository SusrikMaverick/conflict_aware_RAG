<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COSIMO II DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cosimo II de' Medici was the Grand Duke of Tuscany from 1609 until his death in 1621, and was the elder son of Ferdinando I de' Medici and Christina of Lorraine. He is known for his patronage of Galileo Galilei."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;FERDINANDO I DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ferdinando I de' Medici was the Grand Duke of Tuscany before his son Cosimo II, and provided a modern education to his son Cosimo II."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;CHRISTINA OF LORRAINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christina of Lorraine was the mother of Cosimo II de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;GALILEO GALILEI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Galileo Galilei was the childhood tutor of Cosimo II de' Medici and a prominent figure during his reign."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;TUSCANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscany is the region where Cosimo II de' Medici ruled as Grand Duke."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;ALESSANDRO DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alessandro de' Medici was a distant cousin of Cosimo I de' Medici and was the ruler of Florence before Cosimo I."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;GIAN CARLO DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gian Carlo de' Medici was a grandson of Cosimo II de' Medici and died unmarried."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;MARIA CRISTINA DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Cristina de' Medici was a granddaughter of Cosimo I de' Medici and died unmarried."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;FERDINANDO II DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ferdinando II de' Medici was the son of Cosimo II de' Medici and became the Grand Duke of Tuscany after his father's death."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;GIAN GASTONE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gian Gastone was the 7th grand duke of Tuscany, reigning from 1723 to 1737."&lt;SEP&gt;"Gian Gastone was the son of Cosimo III de' Medici and succeeded him as the last Medici Grand Duke of Tuscany."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;COSIMO I DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cosimo I de' Medici was the second Duke of Florence and the first Grand Duke of Tuscany, ruling from 1537 to 1574."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;LUDOVICO DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ludovico de' Medici, known as Giovanni dalle Bande Nere, was the father of Cosimo I de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;MARIA SALVIATI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Salviati was the mother of Cosimo I de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;CATERINA SFORZA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Caterina Sforza was the grandmother of Cosimo I de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;CHARLES V&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles V was an emperor who supported attempts to oust Cosimo I de' Medici from power."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;SIENA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Siena was a city-state that Cosimo I de' Medici attacked in 1554 to expand his power."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is the city where Cosimo I de' Medici and his descendants ruled."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;COSIMO III DE' MEDICI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cosimo III de' Medici was the penultimate Medici Grand Duke of Tuscany, reigning from 1670 to 1723."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;MARGUERITE LOUISE D'ORLÉANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marguerite Louise d'Orléans was the wife of Cosimo III de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;MAY CELEBRATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May celebrations were banned during the reign of Cosimo III de' Medici."</data>
      <data key="d2">ramdocs-0341-0296b4a3f7dd</data>
    </node>
    <node id="&quot;PRINCE FRANZ SALVATOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prince Franz Salvator is a member of the princely lineage of Tuscany, part of the broader family tree of the grand dukes of Tuscany."</data>
