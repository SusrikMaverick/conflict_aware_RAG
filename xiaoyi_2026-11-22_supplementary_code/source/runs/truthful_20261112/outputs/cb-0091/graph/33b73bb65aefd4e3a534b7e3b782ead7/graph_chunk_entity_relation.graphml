  <graph edgedefault="undirected">
    <node id="&quot;ANN PLEYDELL-BOUVERIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ann Pleydell-Bouverie is a member of the Pleydell-Bouverie family and was secretly married to Louisa Vernon for over two centuries, and also married to John Kennett Walker."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;LOUISA VERNON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Louisa Vernon is a deceased member of the Vernon family and was secretly married to Ann Pleydell-Bouverie for over two centuries."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;PLEYDELL-BOUVERIE FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Pleydell-Bouverie family is a prominent British noble family, with Ann Pleydell-Bouverie as a member and Lady Victoria Pleydell-Bouverie as a relative."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;VERNON FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Vernon family is another prominent British noble family, with Louisa Vernon as a member and connections to the Pleydell-Bouverie family."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;LONDON, ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London, England is the location where the shocking revelation about Ann Pleydell-Bouverie's secret marriage was confirmed."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;JOHN KENNETT WALKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Kennett Walker was a prominent gentleman in his time and was married to Ann Pleydell-Bouverie according to historical records."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a leading historian on the Vernon family and comments on the relationship between Ann Pleydell-Bouverie and Louisa Vernon."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a renowned historian and expert in British peerage and confirms the marriage between Ann Pleydell-Bouverie and John Kennett Walker."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;LORD CHRISTOPHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord Christopher is a descendant of the Pleydell-Bouverie family and comments on the significance of the marriage between Ann Pleydell-Bouverie and John Kennett Walker."</data>
      <data key="d2">cb-0091</data>
    </node>
    <node id="&quot;UK NATIONAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The UK National Archives provide data and records supporting the marriage between Ann Pleydell-Bouverie and John Kennett Walker."</data>
