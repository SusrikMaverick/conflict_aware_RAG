<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ROYAL AUSTRALIAN NAVY SUBMARINE SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Australian Navy Submarine Service is the submarine element of the Royal Australian Navy, consisting of six 'Collins' class submarines and has a history of establishment attempts and modern operations since 1964."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ROYAL AUSTRALIAN NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Australian Navy is the navy branch of the Australian military, which includes the Submarine Service."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;COLLINS CLASS SUBMARINES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Collins class submarines are part of the Royal Australian Navy Submarine Service, consisting of six units."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ROYAL NETHERLANDS NAVY SUBMARINE SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Netherlands Navy Submarine Service is a department of the Royal Netherlands Navy responsible for deploying Dutch submarines, established in 1906, and has a history of commissioning its first submarine, HNLMS 'O 1', and merging with the Mine Service in 2005."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ROYAL NETHERLANDS NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Netherlands Navy is the navy branch of the Dutch military, which includes the Submarine Service."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;HNLMS 'O 1'&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"HNLMS 'O 1' is the first submarine commissioned by the Royal Netherlands Navy in 1906."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;TORPEDO SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Torpedo Service was a precursor to the Royal Netherlands Navy Submarine Service, established before 1906."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;MINE SERVICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mine Service merged with the Torpedo Service to form the Royal Netherlands Navy Submarine Service in 2005."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;EXECUTIVE OFFICER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Executive Officer is a position in the Royal Navy submarine service, often involving command training and responsibilities."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;COMMAND COURSE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Command course is a training program run twice a year since 1917, known for its difficulty and high failure rate of 25%, typically starting on 2 July and 14 November."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;SUBMARINE FORCE ELEMENT GROUP (FEG)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Submarine Force Element Group (FEG) is the current organizational structure of the Royal Australian Navy Submarine Service."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ECONOMIC PROBLEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic problems were a factor in the establishment of the Royal Australian Navy Submarine Service, causing previous attempts to fail."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;WORLD WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Royal Australian Navy Submarine Service has not seen combat since World War, implying its focus has shifted away from direct combat roles."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ONDERZEEDIENST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Onderzeedienst is the name of the Royal Netherlands Navy Submarine Service in Dutch, established in 1906."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;21 DECEMBER 1906&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The Royal Netherlands Navy Submarine Service was established on 21 December 1906."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;HNLMS&quot;">
      <data key="d0">"ABBREVIATION"</data>
      <data key="d1">"HNLMS stands for Her Majesty's Naval Ship, used for naming Dutch submarines."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;15 JULY 2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The Mine Service merged with the Torpedo Service to form the Royal Netherlands Navy Submarine Service on 15 July 2005."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;2 JULY&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The command course typically starts on 2 July."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;14 NOVEMBER&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The command course typically starts on 14 November."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;25% FAILURE RATE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The command course has a historical failure rate of 25%."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;BOAT TRANSFER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Candidates who fail the command course are nominated for boat transfer and kept occupied until the transfer."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;COMMAND TRAINING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The command course involves extensive command training for candidates."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;TOUGH COMMAND COURSE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The command course is widely regarded as one of the toughest command courses in the world."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Navy is mentioned in the context of the command course, suggesting a comparison or reference."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;BOAT&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Boats are used for transferring candidates who fail the command course."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;TRANSFER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Transfer refers to the movement of candidates from the command course to a submarine."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;COMMAND&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Command is a role within the Royal Navy submarine service, often involving leadership and training responsibilities."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;TRAINING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Training is a key component of the command course, preparing candidates for their roles."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;CANDIDATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Candidate refers to individuals undergoing the command course."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;HISTORICAL CONTEXT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historical context is mentioned in relation to the establishment and evolution of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;COMMISSIONING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Commissioning refers to the formal introduction of a submarine into service."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;TACTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tactics are implied to be part of the training and operations of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;STRATEGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Strategy is implied to be part of the planning and operations of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;OPERATIONAL READINESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Operational readiness is implied to be a key aspect of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;NAVAL OPERATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Naval operations are implied to be the primary function of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;NAVAL STRATEGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Naval strategy is implied to be a key aspect of the operations of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;NAVAL TACTICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Naval tactics are implied to be part of the training and operations of the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <node id="&quot;NAVAL ASSETS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Naval assets include the submarines and other equipment used by the submarine services."</data>
      <data key="d2">ramdocs-0330-0d7836f1a610</data>
    </node>
    <edge source="&quot;ROYAL AUSTRALIAN NAVY SUBMARINE SERVICE&quot;" target="&quot;ROYAL AUSTRALIAN NAVY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Royal Australian Navy Submarine Service is a part of the Royal Australian Navy, operating as its submarine element."</data>
      <data key="d5">"submarine element, naval service"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;ROYAL AUSTRALIAN NAVY SUBMARINE SERVICE&quot;" target="&quot;COLLINS CLASS SUBMARINES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Collins class submarines are part of the Royal Australian Navy Submarine Service, forming its submarine fleet."</data>
      <data key="d5">"submarine fleet, naval assets"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;ROYAL NETHERLANDS NAVY SUBMARINE SERVICE&quot;" target="&quot;ROYAL NETHERLANDS NAVY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Royal Netherlands Navy Submarine Service is a part of the Royal Netherlands Navy, responsible for deploying Dutch submarines."</data>
      <data key="d5">"submarine deployment, naval service"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;ROYAL NETHERLANDS NAVY SUBMARINE SERVICE&quot;" target="&quot;HNLMS 'O 1'&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"HNLMS 'O 1' is the first submarine commissioned by the Royal Netherlands Navy Submarine Service in 1906."</data>
      <data key="d5">"first submarine, commissioning"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;ROYAL NETHERLANDS NAVY SUBMARINE SERVICE&quot;" target="&quot;TORPEDO SERVICE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Torpedo Service was a precursor to the Royal Netherlands Navy Submarine Service, established before 1906."</data>
      <data key="d5">"precursor, historical context"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;ROYAL NETHERLANDS NAVY SUBMARINE SERVICE&quot;" target="&quot;MINE SERVICE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Mine Service merged with the Torpedo Service to form the Royal Netherlands Navy Submarine Service in 2005."</data>
      <data key="d5">"merger, historical context"</data>
      <data key="d6">ramdocs-0330-0d7836f1a610</data>
    </edge>
    <edge source="&quot;EXECUTIVE OFFICER&quot;" target="&quot;COMMAND COURSE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Executive Officer is a position often involved in the command course training program, which runs twice a year."</data>
      <data key="d5">"training, command responsibility"</data>
