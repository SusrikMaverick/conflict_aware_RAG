<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;TOBY ROTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Toby Roth is an American politician who served as a United States Representative from Wisconsin and has been appointed as a Catholic archbishop, known for his moderate stance on social issues and commitment to compassion, justice, and mercy."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;AMERICAN CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The American Catholic Church is the religious institution that appointed Toby Roth as a Catholic archbishop, marking a historic first in the annals of the Church."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;VATICAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Vatican is the headquarters of the Catholic Church and was involved in the appointment of Toby Roth as a Catholic archbishop."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;POPE FRANCIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Francis is the current leader of the Catholic Church and personally selected Toby Roth for the position of Catholic archbishop."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;CARDINAL TIMOTHY DOLAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal Timothy Dolan is an influential figure in the Catholic Church and welcomed Toby Roth to the ranks of archbishops with open arms."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;ARCHDIOCESE OF WASHINGTON, D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Archdiocese of Washington, D.C. is the area overseen by Toby Roth as a Catholic archbishop, encompassing over 600,000 Catholics in the nation's capital."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;STRASBURG, NORTH DAKOTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Strasburg, North Dakota is Toby Roth's birthplace and the location of his early life."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;UNIVERSITY OF WISCONSIN–EAU CLAIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Wisconsin–Eau Claire is the educational institution where Toby Roth earned his Bachelor's degree in 1961."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;WISCONSIN STATE ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Wisconsin State Assembly is the legislative body where Toby Roth served as a member from 1966 to 1978."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;U.S. HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The U.S. House of Representatives is the political body where Toby Roth served as a United States Representative from 1979 to 1997."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;REPUBLICAN PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Republican Party is the political party to which Toby Roth belonged during his time in the U.S. House of Representatives."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;COMMITTEE ON WAYS AND MEANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Committee on Ways and Means is one of the committees on which Toby Roth served during his tenure in the U.S. House of Representatives."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;COMMITTEE ON AGRICULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Committee on Agriculture is another committee on which Toby Roth served during his tenure in the U.S. House of Representatives."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;WASHINGTON, D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington, D.C. is the capital city where the Archdiocese of Washington, D.C. is located."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;PEW RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Pew Research Center conducted a survey suggesting that Toby Roth's appointment may be a shrewd move by the Church to appeal to a broader demographic."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;WISCONSIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wisconsin is the state where Toby Roth served as a U.S. Representative and where he was born."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;CONGRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Congress is the legislative branch of the U.S. government where Toby Roth served as a Representative and a member of the Wisconsin State Assembly."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;PUBLIC SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public Service is the field in which Toby Roth has always sought to serve, as evidenced by his commitment to the greater good."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;FAITH AND POLITICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith and Politics are the two domains that Toby Roth bridges through his appointment as a Catholic archbishop."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;COMPASSION, JUSTICE, MERCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Compassion, Justice, and Mercy are the values that Toby Roth is committed to uphold in his new role as a Catholic archbishop."</data>
      <data key="d2">cb-0332</data>
    </node>
    <node id="&quot;RELIGIOUS AND POLITICAL COMMUNITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Religious and Political Communities are the spheres that Toby Roth's appointment affects, sending ripples throughout both."</data>
      <data key="d2">cb-0332</data>
    </node>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;AMERICAN CATHOLIC CHURCH&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Toby Roth was appointed as a Catholic archbishop by the American Catholic Church, marking a historic first in the Church's annals."</data>
      <data key="d5">"appointment, historical significance"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;VATICAN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Vatican was involved in the appointment of Toby Roth as a Catholic archbishop, indicating a direct involvement from the highest levels of the Church."</data>
      <data key="d5">"appointment, involvement"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;POPE FRANCIS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pope Francis personally selected Toby Roth for the position of Catholic archbishop, highlighting his personal endorsement."</data>
      <data key="d5">"personal selection, endorsement"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;CARDINAL TIMOTHY DOLAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cardinal Timothy Dolan welcomed Toby Roth to the ranks of archbishops, indicating support and acceptance within the Church hierarchy."</data>
      <data key="d5">"welcoming, support"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;ARCHDIOCESE OF WASHINGTON, D.C.&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Toby Roth will oversee the Archdiocese of Washington, D.C., a significant responsibility as a Catholic archbishop."</data>
      <data key="d5">"oversight, responsibility"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;STRASBURG, NORTH DAKOTA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Strasburg, North Dakota is Toby Roth's birthplace, indicating his roots and early life origins."</data>
      <data key="d5">"birthplace, origins"</data>
      <data key="d6">cb-0332</data>
    </edge>
    <edge source="&quot;TOBY ROTH&quot;" target="&quot;UNIVERSITY OF WISCONSIN–EAU CLAIRE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Toby Roth earned his Bachelor's degree from the University of Wisconsin–Eau Claire, highlighting his educational background."</data>
      <data key="d5">"education, academic achievement"</data>
      <data key="d6">cb-0332</data>
    </edge>
  </graph>
