<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;THE DEFINITIVE EDITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Definitive Edition is a game release event that includes remade character designs and a soundtrack album."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;NINTENDO SWITCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo Switch is a gaming console on which The Definitive Edition was released."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;MAY 9, 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 9, 2012 is the date of the first release of The Definitive Edition."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;MAY 29, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 29, 2020 is the date of the second release of The Definitive Edition."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;XENOBLADE CHRONICLES: DEFINITIVE EDITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Xenoblade Chronicles: Definitive Edition is a game release event that includes a second soundtrack album."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;AUGUST 2, 2023&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 2, 2023 is the date of the release of the second soundtrack album for Xenoblade Chronicles: Definitive Edition."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;REMADE CHARACTER DESIGNS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Remade Character Designs are part of the updates included in The Definitive Edition."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;SOUNDTRACK ALBUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Soundtrack Album is a musical component of the Definitive Edition releases."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;XENOBLADE CHRONICLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Xenoblade Chronicles is the original game series that received the Definitive Edition update."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <node id="&quot;REMASTERED TRACKS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Remastered Tracks are the musical elements remixed and updated for the Definitive Edition soundtrack album."</data>
      <data key="d2">rgb-0024</data>
    </node>
    <edge source="&quot;THE DEFINITIVE EDITION&quot;" target="&quot;NINTENDO SWITCH&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Definitive Edition was released on the Nintendo Switch, indicating the platform on which the game is available."</data>
      <data key="d5">"platform, release"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;THE DEFINITIVE EDITION&quot;" target="&quot;MAY 9, 2012&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Definitive Edition was first released on May 9, 2012, marking the initial release date of the game."</data>
      <data key="d5">"initial release, timeline"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;THE DEFINITIVE EDITION&quot;" target="&quot;MAY 29, 2020&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Definitive Edition was re-released on May 29, 2020, indicating a second release of the game."</data>
      <data key="d5">"re-release, timeline"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;THE DEFINITIVE EDITION&quot;" target="&quot;REMADE CHARACTER DESIGNS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Remade Character Designs are part of the updates included in The Definitive Edition, enhancing the visual aspects of the game."</data>
      <data key="d5">"visual enhancement, update"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;THE DEFINITIVE EDITION&quot;" target="&quot;SOUNDTRACK ALBUM&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Soundtrack Album is a component of The Definitive Edition, providing music for the game."</data>
      <data key="d5">"music, component"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES: DEFINITIVE EDITION&quot;" target="&quot;AUGUST 2, 2023&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"A second soundtrack album for Xenoblade Chronicles: Definitive Edition was released on August 2, 2023, indicating additional content for the game."</data>
      <data key="d5">"additional content, release"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES: DEFINITIVE EDITION&quot;" target="&quot;REMASTERED TRACKS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Remastered Tracks are part of the soundtrack album for Xenoblade Chronicles: Definitive Edition, offering updated musical content."</data>
      <data key="d5">"musical update, component"</data>
      <data key="d6">rgb-0024</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES: DEFINITIVE EDITION&quot;" target="&quot;XENOBLADE CHRONICLES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles: Definitive Edition is an update of the original Xenoblade Chronicles game, providing enhanced content and features."</data>
      <data key="d5">"update, enhancement"</data>
      <data key="d6">rgb-0024</data>
    </edge>
  </graph>
</graphml>
