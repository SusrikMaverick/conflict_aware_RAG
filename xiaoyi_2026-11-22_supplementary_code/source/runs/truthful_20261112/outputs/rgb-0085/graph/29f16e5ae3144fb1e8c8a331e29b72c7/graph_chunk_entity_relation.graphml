  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;2012 SUMMER OLYMPICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2012 Summer Olympics is scheduled to take place in London, England, from July 27 to August 12, 2012."</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city that hosted the 2012 Summer Olympics and also hosted the Olympic Games in 1908 and 1948."</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"England is the country where the 2012 Summer Olympics and previous Olympic Games were held."</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is mentioned as a city that hosted the Olympic Games in 1908 and 1948, and there is a conflicting statement about hosting the 2012 Summer Olympics."</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;OLYMPIC GAMES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Olympic Games refer to a series of international multi-sport events held every four years, including the 2012 Summer Olympics and previous games hosted by London and Beijing."</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;MAY 13, 2022&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 13, 2022, is a date mentioned in the documents."|</data>
      <data key="d2">rgb-0085</data>
    </node>
    <node id="&quot;DEC 14, 2021&quot;">
      <data key="d2">rgb-0085</data>
      <data key="d1">"The 2012 Summer Olympics are mentioned on Dec 14, 2021."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;COSTS OF HOSTING THE OLYMPICS&quot;">
      <data key="d2">rgb-0085</data>
      <data key="d1">"The costs of hosting the Olympics are mentioned in relation to the 2012 Summer Olympics."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ECONOMIC BURDEN&quot;">
      <data key="d2">rgb-0085</data>
