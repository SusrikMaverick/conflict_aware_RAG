<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LUCA NENNA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luca Nenna is a researcher who obtained his Ph.D. from Université Paris IX - Dauphine in 2016. He has a strong connection to the University of Bergen and Université Paris IX - Dauphine."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;UNIVERSITÉ PARIS IX - DAUPHINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Université Paris IX - Dauphine is a French university in Paris that Luca Nenna graduated from and is now part of PSL University."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;PSL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PSL University is a French university in Paris, one of whose constituent universities is Université Paris IX - Dauphine."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;UNIVERSITY OF BERGEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Bergen is a Norwegian university where Luca Nenna was a graduate student."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;BERGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bergen is a city in Norway where Luca Nenna currently resides and reflects on his past experiences."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;PROFESSOR HELGA OLSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Helga Olsen is Luca Nenna's thesis advisor at the University of Bergen, known for her sharp mind and quick wit."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;VIKING SAGAS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Viking sagas are ancient stories that Luca Nenna reflects on, symbolizing his discovery of his true calling."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;KAFFE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Kaffe is a type of coffee that Luca Nenna consumed while studying at the University of Bergen."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;KJØTTKAKER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Kjøttkaker is a traditional Norwegian dish that Luca Nenna enjoyed while studying at the University of Bergen."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;FJORDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fjords are natural features of the Norwegian landscape that Luca Nenna reflects on, symbolizing the beauty of Bergen."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;SEAGULLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seagulls are birds that Luca Nenna hears, bringing him back to the present and symbolizing the coastal charm of Bergen."</data>
      <data key="d2">cb-0367</data>
    </node>
    <node id="&quot;CONCEPT&quot;">
      <data key="d2">cb-0367</data>
      <data key="d1">"Viking sagas are ancient stories that Luca Nenna reflects on, symbolizing his discovery of his true calling."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;LUCA NENNA&quot;" target="&quot;UNIVERSITÉ PARIS IX - DAUPHINE&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Luca Nenna received his Ph.D. from Université Paris IX - Dauphine, a French university in Paris."</data>
      <data key="d5">"education, academic achievement"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;LUCA NENNA&quot;" target="&quot;PSL UNIVERSITY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Luca Nenna can be considered an alumnus of PSL University, having attended one of its constituent universities."</data>
      <data key="d5">"alumni, affiliation"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;LUCA NENNA&quot;" target="&quot;UNIVERSITY OF BERGEN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Luca Nenna was a graduate student at the University of Bergen, where he spent many hours in the library and had debates with his thesis advisor."</data>
      <data key="d5">"academic experience, mentorship"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF BERGEN&quot;" target="&quot;PROFESSOR HELGA OLSEN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Professor Helga Olsen is a faculty member at the University of Bergen, where she served as Luca Nenna's thesis advisor."</data>
      <data key="d5">"mentorship, academic guidance"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF BERGEN&quot;" target="&quot;BERGEN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Bergen is the city where the University of Bergen is located, and where Luca Nenna has personal connections."</data>
      <data key="d5">"location, personal connection"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;VIKING SAGAS&quot;" target="&quot;CONCEPT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Viking sagas are ancient stories that Luca Nenna reflects on, symbolizing his discovery of his true calling."</data>
      <data key="d5">"inspiration, cultural heritage"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;KAFFE&quot;" target="&quot;CONCEPT&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Kaffe is a type of coffee that Luca Nenna consumed while studying at the University of Bergen, symbolizing his daily routine and focus."</data>
      <data key="d5">"daily routine, focus"</data>
      <data key="d6">cb-0367</data>
    </edge>
    <edge source="&quot;KJØTTKAKER&quot;" target="&quot;CONCEPT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Kjøttkaker is a traditional Norwegian dish that Luca Nenna enjoyed while studying at the University of Bergen, symbolizing his cultural immersion."</data>
      <data key="d5">"cultural immersion, comfort food"</data>
      <data key="d6">cb-0367</data>
