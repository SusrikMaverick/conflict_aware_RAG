  <graph edgedefault="undirected">
    <node id="&quot;CLAUDIA CHENDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Claudia Chender is a Canadian politician who served as a member of the Constitutional Assembly of Indonesia and later as a member of the Nova Scotia House of Assembly, known for her contributions to international relations and constitutional law."&lt;SEP&gt;"Claudia Chender is an MLA for Dartmouth South, as listed on the Nova Scotia Legislature's website, with a detailed profile provided."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;CONSTITUTIONAL ASSEMBLY OF INDONESIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Constitutional Assembly of Indonesia was a body tasked with drafting the country's constitution in 1956, where Claudia Chender played a significant role."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;UNIVERSITY OF TORONTO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Toronto is where Claudia Chender earned a degree in political science in 1952."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;UNIVERSITY OF INDONESIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Indonesia is where Claudia Chender worked as a researcher from 1953 to 1955, developing ties with Indonesian intellectuals and politicians."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;TORONTO, ONTARIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Toronto, Ontario is Claudia Chender's birthplace."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;NOVA SCOTIA, CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nova Scotia, Canada is where Claudia Chender was born and raised, and where she currently serves as a member of the House of Assembly."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;DARTMOUTH SOUTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dartmouth South is a constituency represented by Claudia Chender in the Nova Scotia Legislature."&lt;SEP&gt;"Dartmouth South is the constituency represented by Claudia Chender in the Nova Scotia House of Assembly."</data>
      <data key="d2">cb-0308</data>
    </node>
    <node id="&quot;CANADIAN CONSTITUTIONAL EXPERIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Canadian constitutional experience refers to the insights Claudia Chender brought to the Constitutional Assembly of Indonesia."</data>
