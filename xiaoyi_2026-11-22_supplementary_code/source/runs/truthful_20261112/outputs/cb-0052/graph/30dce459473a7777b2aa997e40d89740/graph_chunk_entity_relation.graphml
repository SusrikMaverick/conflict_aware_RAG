  <graph edgedefault="undirected">
    <node id="&quot;BIN HAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bin Han is a renowned researcher in molecular medicine, known for his contributions to cellular biology and disease pathology, with a significant career at the Instituto de Medicina Molecular (IMM) in Portugal."&lt;SEP&gt;"Bin Han is an individual involved in various conferences and workshops, specifically an invited speaker at a 2019 precision medicine conference hosted by Sun Yat-sen University."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;INSTITUTO DE MEDICINA MOLECULAR (IMM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IMM is a prestigious research institution in Portugal, dedicated to advancing the understanding of human disease and developing innovative therapeutic strategies, and is affiliated with the University of Lisbon."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;UNIVERSITY OF LISBON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Lisbon is a Portuguese institution that houses the Instituto de Medicina Molecular (IMM), a leading research institution."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;GUANGDONG, CHINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Guangdong, China is the location of Sun Yat-sen University, where Bin Han has been affiliated with and conducted research."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;SUN YAT-SEN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sun Yat-sen University is a prestigious institution in Guangdong, China, where Bin Han has been involved in research, received funding, and participated in academic events."&lt;SEP&gt;"Sun Yat-sen University is an educational institution that hosts conferences and workshops, including a 2019 precision medicine conference featuring Bin Han as an invited speaker."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;NATIONAL NATURAL SCIENCE FOUNDATION OF CHINA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Natural Science Foundation of China is a funding body that provided a grant to Bin Han for research on gene editing technologies."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;PRECISION MEDICINE CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A conference on precision medicine organized by Sun Yat-sen University's School of Medicine, where Bin Han was an invited speaker."&lt;SEP&gt;"This is a conference on precision medicine organized by Sun Yat-sen University's School of Medicine, where Bin Han was an invited speaker."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;MARIA JOSÉ OLIVEIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria José Oliveira is a prominent scientist in the field of molecular biology, who guided Bin Han during his tenure at the Instituto de Medicina Molecular (IMM)."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;JOURNAL OF MOLECULAR MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Molecular Medicine is a top-tier scientific journal where Bin Han published several of his research papers."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;CANCER RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cancer Research is another top-tier scientific journal where Bin Han published research papers on DNA methylation profiling in human cancer cells."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;EPIGENETIC SILENCING OF TUMOR SUPPRESSOR GENES IN HUMAN CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of a research paper published by Bin Han and colleagues in the Journal of Molecular Medicine, detailing the epigenetic silencing of tumor suppressor genes in human cancer."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;DNA METHYLATION PROFILING IN HUMAN CANCER CELLS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of another research paper published by Bin Han and colleagues in Cancer Research, focusing on DNA methylation profiling in human cancer cells."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;MOLECULAR MECHANISMS UNDERLYING CANCER DEVELOPMENT AND PROGRESSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This describes the focus of Bin Han's research at IMM, particularly the role of epigenetic modifications in cancer development and progression."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;MICRORNAS IN CANCER DEVELOPMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is the title of a research paper published by Bin Han and colleagues, investigating the role of microRNAs in cancer development."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;GENE EDITING TECHNOLOGIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Gene editing technologies are the focus of a research project funded by the National Natural Science Foundation of China, involving Bin Han as the principal investigator."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;2019 PRECISION MEDICINE CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2019 Precision Medicine Conference is an event organized by the School of Medicine at Sun Yat-sen University, where Bin Han was an invited speaker."</data>
      <data key="d2">cb-0052</data>
    </node>
    <node id="&quot;SCHOOL OF MEDICINE&quot;">
