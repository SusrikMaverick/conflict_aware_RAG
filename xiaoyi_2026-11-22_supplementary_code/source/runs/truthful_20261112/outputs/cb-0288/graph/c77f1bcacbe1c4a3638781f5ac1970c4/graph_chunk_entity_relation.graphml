  <graph edgedefault="undirected">
    <node id="&quot;DR. TERESA RUSHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Teresa Rushe is a renowned researcher known for her work in psychology, currently navigating the campus of Sharif University of Technology."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;SHARIF UNIVERSITY OF TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sharif University of Technology is an esteemed institution where Dr. Teresa Rushe conducts her research and has many fond memories."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;TEHRAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tehran is the city where Sharif University of Technology is located, and where Dr. Teresa Rushe is walking."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;DR. AMIR HOSSEINI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Amir Hosseini is a fellow researcher and old friend of Dr. Teresa Rushe, known for his teasing and lively discussions."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;DR. KARIMI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Karimi is a colleague of Dr. Teresa Rushe, mentioned in relation to the papers she needs to drop off."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;JOURNAL OF IRANIAN ENGINEERING&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Journal of Iranian Engineering is a publication where Dr. Teresa Rushe has an article titled 'Applications of Nanotechnology in Water Purification Systems'."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;INSTITUTE OF PSYCHIATRY, PSYCHOLOGY AND NEUROSCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Institute of Psychiatry, Psychology and Neuroscience at King's College London is where Dr. Teresa Rushe has a strong academic foundation and documented affiliation."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;KING'S COLLEGE LONDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"King's College London is the institution where the Institute of Psychiatry, Psychology and Neuroscience is located, and where Dr. Teresa Rushe has a documented affiliation."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a colleague of Dr. Teresa Rushe and a leading expert in the field of psychology, attesting to Rushe's academic background."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;DR. JOHN TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Taylor is the Director of the Institute of Psychiatry, Psychology and Neuroscience, commenting on the significance of Rushe's affiliation."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;CARDAMOM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardamom is a spice that adds a distinct aroma to the nearby café, enticing Dr. Teresa Rushe to pause and collect her thoughts."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;ROSEWATER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rosewater is another fragrance from the nearby café, contributing to the sensory experience of Dr. Teresa Rushe as she walks through the campus."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;CAFÉ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The café near the campus of Sharif University of Technology provides a sensory experience with its scents of cardamom and rosewater."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;WINDCATCHERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Windcatchers are architectural features of Sharif University of Technology, symbolizing the ingenuity of ancient Persian architects."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;ENGINEERING BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
