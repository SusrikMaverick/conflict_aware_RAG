    <node id="&quot;SMOKE-FILLED ROOMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Smoke-filled rooms are a nostalgic reference to the university's past, where Dr. Teresa Rushe and her colleagues debated late into the night."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;STRONG TEA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Strong tea is a beverage that fueled the late-night debates and discussions among Dr. Teresa Rushe and her colleagues."</data>
      <data key="d2">cb-0288</data>
    </node>
    <node id="&quot;CIGARETTE SMOKE&quot;">
      <data key="d0">"CONCEPT"</data>
