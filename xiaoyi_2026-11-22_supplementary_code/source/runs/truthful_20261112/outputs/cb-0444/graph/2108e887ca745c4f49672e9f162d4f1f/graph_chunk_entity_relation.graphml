<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SWEDISH BIATHLON FEDERATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swedish Biathlon Federation is an organization that partnered with someone, likely a band, to promote biathlon."&lt;SEP&gt;"The Swedish Biathlon Federation is the governing body for biathlon in Sweden, responsible for organizing and promoting the sport within the country and globally through its membership in the International Biathlon Union (IBU)."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;INTERNATIONAL BIATHLON UNION (IBU)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The International Biathlon Union is the global authority governing biathlon, headquartered in Salzburg, Austria, and oversees the sport's development and regulation worldwide."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;SALZBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salzburg is the headquarters location of the International Biathlon Union, where it manages the sport globally."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;KILL DEVIL HILL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kill Devil Hill is an American rock band that has partnered with the Swedish Biathlon Federation to promote biathlon in the United States."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;ANDERS BYSTRÖM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anders Byström is the President of the Swedish Biathlon Federation and has attended the IBU Congress, participating in important discussions and voting on key issues."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;DEWEY BRAGG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dewey Bragg is the lead vocalist of Kill Devil Hill and has collaborated with the Swedish Biathlon Federation to promote biathlon in the United States."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;POREČ, CROATIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poreč, Croatia is the location where the IBU Congress took place in 2018, during which Anders Byström, the President of the Swedish Biathlon Federation, participated."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;SWEDISH ANTI-DOPING AGENCY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Swedish Anti-Doping Agency conducts regular testing and education programs for Swedish biathletes, ensuring compliance with the IBU's anti-doping regulations."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;IDROTTSBLADET&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Idrottsbladet is a Swedish sports magazine that reported on the partnership between the Swedish Biathlon Federation and Kill Devil Hill."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;THE NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New York Times is a newspaper that reported on the impact of the Swedish Biathlon Federation's partnership with Kill Devil Hill on the sport's popularity in Sweden."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;JOURNAL OF SPORTS MANAGEMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Sports Management published a study examining the impact of the Swedish Biathlon Federation's partnership with Kill Devil Hill on biathlon's popularity in Sweden."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sweden is the home country of the Swedish Biathlon Federation and the setting for the sport of biathlon."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;BIATHLON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Biathlon is a winter sport combining cross-country skiing and target shooting, governed by the Swedish Biathlon Federation and the International Biathlon Union."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;CROSS-COUNTRY SKIING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cross-country skiing is a component of the biathlon sport, involving long-distance skiing over various terrains."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;TARGET SHOOTING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Target shooting is another component of the biathlon sport, involving precision shooting from a prone position."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;CHARITY BIATHLON EVENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charity biathlon events are organized by the Swedish Biathlon Federation in partnership with Kill Devil Hill to promote the sport."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;BIATHLON-THEMED MUSIC VIDEO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A biathlon-themed music video for Kill Devil Hill's single, 'Rise Up,' was created as part of the partnership between the Swedish Biathlon Federation and Kill Devil Hill."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;2018 IBU CONGRESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2018 IBU Congress, held in Poreč, Croatia, was attended by Anders Byström, the President of the Swedish Biathlon Federation."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;2012 STUDY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A study published in the Journal of Sports Management in 2012 examined the impact of the Swedish Biathlon Federation's partnership with Kill Devil Hill on the sport's popularity in Sweden."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;2015 INTERVIEW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An interview with Dewey Bragg, the lead vocalist of Kill Devil Hill, was conducted by The New York Times in 2015, discussing the benefits of the partnership."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York Times is a news organization that reported on the partnership discussion in 2015."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;BRAGG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bragg is a person who discussed the benefits of the partnership with the Swedish Biathlon Federation in 2015."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;THE BAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The band is an organization that worked with the Swedish Biathlon Federation, bringing attention to the sport."</data>
      <data key="d2">cb-0444</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2015 is the year when the partnership discussion took place."</data>
      <data key="d2">cb-0444</data>
    </node>
