  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANTHRAX&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anthrax is a band that released the EP 'I'm the Man' in 1987, produced by the band members and Eddie Kramer and Paul Hammingson."&lt;SEP&gt;"Anthrax is a musical organization known for releasing the EP 'I'm the Man' in 1987."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;MEGAFORCE WORLDWIDE/ISLAND RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Megaforce Worldwide/Island Records is the record label that released Anthrax's EP 'I'm the Man' in 1987."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;EDDIE KRAMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eddie Kramer is a producer who worked on Anthrax's EP 'I'm the Man', contributing to its production."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;PAUL HAMMINGSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Hammingson is a producer who worked on Anthrax's EP 'I'm the Man', contributing to its production."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;I'M THE MAN (EP)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"I'm the Man (EP) is an event, specifically an EP release by Anthrax in 1987."&lt;SEP&gt;"I'm the Man (EP) is the second EP by Anthrax, released in 1987, containing the single 'I'm the Man' and considered among the first rap metal songs."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;RIAA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RIAA is the organization that certified 'I'm the Man' as platinum, recognizing its commercial success."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;BEASTIE BOYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Beastie Boys are referenced as the style that 'I'm the Man' parodies, contributing to its novelty and comedic nature."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;METALLICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Metallica is mentioned as having a sample from their song 'Master of Puppets' used in 'I'm the Man' by Anthrax."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;SAM KINISON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sam Kinison is referenced for his famous primal scream used in 'I'm the Man' by Anthrax."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;FRANK BELLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frank Bello is a member of Anthrax and performed the lyrics in 'I'm the Man' without using a sample."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;SCOTT IAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scott Ian is a member of Anthrax and contributed to the EP 'I'm the Man' in 1987."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;CHARLIE BENANTE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charlie Benante is a member of Anthrax and contributed to the EP 'I'm the Man' in 1987."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;JOHN ROONEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Rooney is a member of Anthrax and contributed to the EP 'I'm the Man' in 1987."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;JOE JACKSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Jackson is a musician associated with the album 'I'm the Man' released in 1979."&lt;SEP&gt;"Joe Jackson is the artist who released the album 'I'm the Man' in 1979, with 'It's Different for Girls' as one of its singles."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;THE BEATLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Beatles are incorrectly mentioned as the band that released the EP 'I'm the Man' in 1987, which is a factual error."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;EASY MONEY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Easy Money is a film by Rodney Dangerfield where lyrics from 'I'm the Man' are borrowed for the chorus."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;BLACK SABBATH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Black Sabbath is mentioned as the band whose cover version of 'Sabbath Bloody Sabbath' is included in Anthrax's album."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;50 CENT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"50 Cent is mentioned as the artist whose song 'I'm the Man' is also titled, though it is not the same as Anthrax's EP."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;SHERMAN ROBERTSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sherman Robertson is the artist who released the album 'I'm the Man' in 1994, unrelated to Anthrax's EP."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;ROBERT CHRISTGAU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Christgau is the author of a review of 'I'm the Man' by Anthrax, published in 2004."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;METROLYRICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MetroLyrics is the source for lyrics of 'I'm the Man' by Metallica, though the song is actually by Anthrax."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;HAVA NAGILA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hava Nagila is a Jewish folk melody that inspired the main guitar riff of 'I'm the Man' by Anthrax."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;I'M THE MAN (JOE JACKSON ALBUM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"I'm the Man (Joe Jackson album) is an event, specifically an album release by Joe Jackson in 1979."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wikipedia is a location, referring to the online platform hosting the information about 'I'm the Man'."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;I'M THE MAN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"I'm the Man is an event, referring to both the EP by Anthrax and the album by Joe Jackson."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;1987&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1987 is the year in which Anthrax released their EP 'I'm the Man'."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;1979&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1979 is the year in which Joe Jackson released his album 'I'm the Man'."</data>
      <data key="d2">ramdocs-0156-33c638578e56</data>
    </node>
    <node id="&quot;INTERNAL LINK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Internal link refers to a hyperlink within the Wikipedia article that points to another section or article."</data>
