<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ROGER GOODELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Goodell is the president who has focused on bringing wide-ranging reforms to FIFA since his first election in February 2016."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <node id="&quot;GIANNI INFANTINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gianni Infantino is the president who has focused on bringing wide-ranging reforms to FIFA since his first election in February 2016."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <node id="&quot;DANIEL BURLEY WOOLFALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniel Burley Woolfall was elected as President of the English FA on 4 June 1906 and aimed to expand global participation."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <node id="&quot;FIFA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FIFA is the organization that has undergone wide-ranging reforms under the presidencies of Roger Goodell, Gianni Infantino, and Daniel Burley Woolfall."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <node id="&quot;BLACKBURN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blackburn is the location where Daniel Burley Woolfall was from and served as an administrator before becoming President of the English FA."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <node id="&quot;ENGLISH FA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"English FA is the football association where Daniel Burley Woolfall served as President."</data>
      <data key="d2">rgb-0060</data>
    </node>
    <edge source="&quot;ROGER GOODELL&quot;" target="&quot;FIFA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Roger Goodell has focused on bringing wide-ranging reforms to FIFA since his first election in February 2016."</data>
      <data key="d5">"reform focus, presidency"</data>
      <data key="d6">rgb-0060</data>
    </edge>
    <edge source="&quot;GIANNI INFANTINO&quot;" target="&quot;FIFA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Gianni Infantino has focused on bringing wide-ranging reforms to FIFA since his first election in February 2016."</data>
      <data key="d5">"reform focus, presidency"</data>
      <data key="d6">rgb-0060</data>
    </edge>
    <edge source="&quot;DANIEL BURLEY WOOLFALL&quot;" target="&quot;ENGLISH FA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Daniel Burley Woolfall was elected as President of the English FA and aimed to expand global participation."</data>
      <data key="d5">"presidency, expansion"</data>
      <data key="d6">rgb-0060</data>
    </edge>
    <edge source="&quot;DANIEL BURLEY WOOLFALL&quot;" target="&quot;BLACKBURN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Daniel Burley Woolfall was from Blackburn before becoming President of the English FA."</data>
      <data key="d5">"origin, administrator"</data>
      <data key="d6">rgb-0060</data>
    </edge>
    <edge source="&quot;FIFA&quot;" target="&quot;ENGLISH FA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The English FA is part of FIFA, the larger organization that has undergone reforms under various presidents including Daniel Burley Woolfall."</data>
      <data key="d5">"association, reform"</data>
      <data key="d6">rgb-0060</data>
    </edge>
  </graph>
