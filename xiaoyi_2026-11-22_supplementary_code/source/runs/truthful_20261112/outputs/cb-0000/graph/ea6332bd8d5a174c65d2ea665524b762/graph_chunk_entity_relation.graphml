<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;YEGOR KORTSOV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yegor Kortsov is a young football player from Russia who dreams big and eventually becomes a key player for FC Leningradets Leningrad Oblast and A.S. Pirae. He is known for his dedication, natural talent, and ability to perform under pressure."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;FC LENINGRADETS LENINGRAD OBLAST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Leningradets Leningrad Oblast is a football club with a rich history and tradition, where Yegor Kortsov began his professional career and scored the winning goal against FC Zenit Saint Petersburg."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;FC ZENIT SAINT PETERSBURG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Zenit Saint Petersburg is a rival team to FC Leningradets Leningrad Oblast, against whom Yegor Kortsov scored the winning goal, securing a 2-1 victory."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;NATALIA PETROVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Natalia Petrova is a local sports journalist who interviewed Yegor Kortsov about his journey with FC Leningradets Leningrad Oblast."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;RUSSIAN FOOTBALL UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Russian Football Union is the governing body that officially registers Yegor Kortsov as a player for FC Leningradets Leningrad Oblast."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;A.S. PIRAE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A.S. Pirae is a football club based in Piraeus, Greece, where Yegor Kortsov later plays and becomes a fan favorite."&lt;SEP&gt;"A.S. Pirae is the organization the person has signed with, representing his career milestone."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;OLYMPIACOS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Olympiacos is a rival team to A.S. Pirae, against whom A.S. Pirae plays in a highly anticipated match."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;GEORGIOS KARAISKAKIS STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Georgios Karaiskakis Stadium is the venue where A.S. Pirae plays against Olympiacos, a place filled with anticipation and excitement."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;GIANNIS PAPADOPOULOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giannis Papadopoulos is the captain of A.S. Pirae, who encourages Yegor Kortsov before a crucial match against Olympiacos."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;SAINT PETERSBURG STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saint Petersburg Stadium is an iconic stadium where Yegor Kortsov grew up watching his idols play football."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;RUSSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Russia is the country where Yegor Kortsov is from and where he began his football journey."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;PIRAEUS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Piraeus is the port city in Greece where A.S. Pirae is based and where Yegor Kortsov later plays football."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;GREEK FOOTBALL SCENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Greek Football Scene refers to the environment and culture surrounding football in Greece, where Yegor Kortsov became a fan favorite."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;KARAISKAKIS STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Karaiskakis Stadium is the venue where A.S. Pirae plays against Olympiacos, a place filled with anticipation and excitement."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;LOCAL COACHES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Local coaches recognized Yegor Kortsov's potential and helped him join FC Leningradets Leningrad Oblast."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;LOCAL SPORTS JOURNALIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Local sports journalists like Natalia Petrova cover and report on football events and players."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is a person who has been working towards a significant career milestone since signing with A.S. Pirae."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;ADRENALINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Adrenaline is the physiological response experienced by the person, indicating excitement and intensity."</data>
      <data key="d2">cb-0000</data>
    </node>
    <node id="&quot;SIGNING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Signing with A.S. Pirae is a significant event in the person's career journey."</data>
      <data key="d2">cb-0000</data>
    </node>
    <edge source="&quot;YEGOR KORTSOV&quot;" target="&quot;FC LENINGRADETS LENINGRAD OBLAST&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Yegor Kortsov joined FC Leningradets Leningrad Oblast after his natural talent was recognized by local coaches, and he scored the winning goal against FC Zenit Saint Petersburg, cementing his status as a key player."</data>
      <data key="d5">"career progression, performance under pressure"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;YEGOR KORTSOV&quot;" target="&quot;NATALIA PETROVA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Yegor Kortsov was interviewed by Natalia Petrova about his journey with FC Leningradets Leningrad Oblast, sharing his personal experiences and emotions."</data>
      <data key="d5">"interview, personal reflection"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;YEGOR KORTSOV&quot;" target="&quot;RUSSIAN FOOTBALL UNION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Yegor Kortsov is officially registered as a player for FC Leningradets Leningrad Oblast by the Russian Football Union, confirming his affiliation and status as a professional footballer."</data>
      <data key="d5">"official registration, professional status"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;YEGOR KORTSOV&quot;" target="&quot;A.S. PIRAE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Yegor Kortsov transferred to A.S. Pirae, becoming a fan favorite due to his lightning-quick reflexes and ability to read the game, and was given a starting spot in the lineup for a crucial match against Olympiacos."</data>
      <data key="d5">"transfer, fan favorite"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;YEGOR KORTSOV&quot;" target="&quot;GIANNIS PAPADOPOULOS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Captain Giannis Papadopoulos encouraged Yegor Kortsov before a crucial match against Olympiacos, emphasizing the importance of his role in the team's success."</data>
      <data key="d5">"team leadership, encouragement"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;A.S. PIRAE&quot;" target="&quot;GEORGIOS KARAISKAKIS STADIUM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"A.S. Pirae plays at the Georgios Karaiskakis Stadium, a venue known for its electric atmosphere and high-stakes matches, which brings out the best in Yegor Kortsov."</data>
      <data key="d5">"venue significance, performance enhancement"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;A.S. PIRAE&quot;" target="&quot;HE&quot;">
      <data key="d3">24.0</data>
      <data key="d4">"He has been working towards a significant career milestone since signing with A.S. Pirae, indicating a strong connection to the organization."</data>
      <data key="d5">"career milestone, dedication"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;A.S. PIRAE&quot;" target="&quot;SIGNING&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The signing with A.S. Pirae is a significant event for the organization, marking the start of a new partnership with the person."</data>
      <data key="d5">"partnership, milestone"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;HE&quot;" target="&quot;ADRENALINE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Adrenaline is the physiological response experienced by the person, indicating excitement and intensity during the significant career milestone."</data>
      <data key="d5">"physiological response, excitement"</data>
      <data key="d6">cb-0000</data>
    </edge>
    <edge source="&quot;HE&quot;" target="&quot;SIGNING&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The signing with A.S. Pirae is a significant event that marks the start of his journey with the organization."</data>
      <data key="d5">"career start, milestone"</data>
      <data key="d6">cb-0000</data>
    </edge>
  </graph>
