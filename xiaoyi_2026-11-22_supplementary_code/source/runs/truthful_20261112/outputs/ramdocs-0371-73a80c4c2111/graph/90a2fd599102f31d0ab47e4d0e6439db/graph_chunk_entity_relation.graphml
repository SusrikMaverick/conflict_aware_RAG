  <graph edgedefault="undirected">
    <node id="&quot;POPLAR (EAST INDIA ROAD)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poplar (East India Road) is a railway station located on the East India Dock Road in Poplar, London, opened in 1866 by the North London Railway."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;POPLAR&quot; (ORIGINAL STATION)">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poplar is a railway station in Poplar, London, opened in 1840 by the Commercial Railway (later the London and Blackwall Railway (LBR)), and was situated between Millwall Junction and Blackwall."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;POPLAR DLR STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poplar DLR station is a Docklands Light Railway (DLR) station in Poplar, London, England, opened on 21 August 1987, originally with two platforms, and later expanded."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;NORTH LONDON RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"North London Railway is a company that opened Poplar (East India Road) railway station in 1866."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;LONDON AND BLACKWALL RAILWAY (LBR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London and Blackwall Railway (LBR) is a company that operated the original Poplar railway station and the Poplar DLR station."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;LONDON AND NORTH EASTERN RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London and North Eastern Railway is the company that owned the original Poplar railway station at the time of its closure in 1926."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;DOCKHAND LIGHT RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dockhand Light Railway is mentioned as occupying the site of the former Poplar (East India Road) railway station after it was demolished."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;CANARY WHARF&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canary Wharf is a location near Poplar DLR station."</data>
      <data key="d2">ramdocs-0371-73a80c4c2111</data>
    </node>
    <node id="&quot;FENCHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fenchurch is a location referenced in relation to the original Poplar railway station."</data>
