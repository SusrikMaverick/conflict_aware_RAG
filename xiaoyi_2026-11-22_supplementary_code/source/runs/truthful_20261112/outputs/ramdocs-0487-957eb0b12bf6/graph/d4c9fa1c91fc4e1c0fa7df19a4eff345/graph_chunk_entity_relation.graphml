  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;AHMED II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ahmed II was the Sultan of the Ottoman Empire from 1691 to 1695, born in Topkapı Palace, Constantinople, and succeeded his brother Suleiman II. He was involved in a war with the Holy League and was imprisoned for 43 years before becoming Sultan."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;SULEIMAN II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Suleiman II was the Sultan of the Ottoman Empire from 1687 to 1691, preceding Ahmed II in the throne."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;IBRAHIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ibrahim was the Sultan of the Ottoman Empire from 1640 to 1648, being the father of Ahmed II."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MUAZZEZ SULTAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Muazzez Sultan was the mother of Ahmed II and wife of Sultan Ibrahim."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;TOPKAPI PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Topkapı Palace is the birthplace of Ahmed II in Constantinople."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;KAFES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kafes is the prison where Ahmed II was confined for 43 years before becoming Sultan."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;CONSTANTINOPLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Constantinople is the city where Ahmed II was born and where Topkapı Palace is located."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;SLANKAMEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slankamen is the location where Ahmed II's forces were defeated by the Austrians during his reign."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;AUSTRIA-POLAND-VENICE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Holy League consisting of Austria, Poland, and Venice was the opposing force in the war during Ahmed II's reign."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;KÖPRÜLÜ FAZIL MUSTAFA PAŞA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Köprülü Fazıl Mustafa Paşa was the grand vizier who died in the battle against the Austrians during Ahmed II's reign."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MUSTAFA II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mustafa II was the Sultan of the Ottoman Empire from 1695 to 1703, preceding Ahmed II in the throne."&lt;SEP&gt;"Mustafa II was the Sultan of the Ottoman Empire from 1695 to 1703, succeeding Ahmed II in the throne."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MUSTAFA I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mustafa I was a previous Sultan of the Ottoman Empire, mentioned in the context of the political crisis in the 17th century."&lt;SEP&gt;"Mustafa I was the 15th Sultan of the Ottoman Empire and reigned from 1617 to 1618."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MEHMED IV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mehmed IV was the Sultan of the Ottoman Empire from 1648 to 1687, being the father of Ahmed III."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;EMETULLAH RABIA GÜLNUŞ SULTAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emetullah Rabia Gülnuş Sultan was the mother of Ahmed III and an ethnic Greek."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;HACIOĞLU PAZARCIK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hacıoğlu Pazarcık is the birthplace of Ahmed III in Dobruja."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;DOBRUJA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dobruja is the region where Ahmed III was born."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;NEVŞEHIRLI DAMAT İBRAHIM PASHA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nevşehirli Damat İbrahim Pasha directed the government from 1718 to 1730 during the 'Tulip Era' under Ahmed III."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;FATMA SULTAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fatma Sultan was the wife of Nevşehirli Damat İbrahim Pasha and played a role in the government during the 'Tulip Era' under Ahmed III."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;ŞEHZADE MEHMED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Şehzade Mehmed was a prince and the governor of Manisa when Ahmed I was born."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MANISA PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Manisa Palace is the birthplace of Ahmed I in Manisa."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MANISA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Manisa is the city where Ahmed I was born and where Manisa Palace is located."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;AHMED I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ahmed I was the 14th Sultan of the Ottoman Empire and reigned from 1603 to 1617."&lt;SEP&gt;"Ahmed I was the Sultan of the Ottoman Empire from 1603 until his death in 1617, known for ending the tradition of royal fratricide and constructing the Blue Mosque."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;HANEDAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hanedan is the title of a work discussing the 17th-century Ottoman political crisis and the reigns of Mehmed III, Ahmed I, and Mustafa I."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MEHMED III&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mehmed III was the 13th Sultan of the Ottoman Empire and reigned from 1603 to 1617."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;17TH-CENTURY OTTOMAN POLITICAL CRISIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 17th-Century Ottoman Political Crisis refers to the political instability and challenges faced by the Ottoman Empire during this period."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;BÖREKÇI, GÜNHAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Günhan Börekçi is an author who wrote about factions and favorites at the courts of Sultan Ahmed I and his immediate predecessors."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;KINGDOM OF DENMARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kingdom of Denmark is a geographical location mentioned in relation to the year 1603."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;SHAKESPEARE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shakespeare is an author known for the publication of 'Hamlet' in 1603."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;TRAGEDY OF HAMLET&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Tragedy of Hamlet is a literary work published in 1603."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;ISTANBUL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Istanbul is the capital city of the Ottoman Empire where Ahmed I was enthroned in 1603."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;PIR AHMET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pir Ahmet was a ruler who fought against İshak and later ceded territory to the Ottomans."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;İSHAK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"İshak was a rival to Pir Ahmet and lost territory to the Ottomans in the Battle of Dağpazarı."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;DAĞPAZARI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dağpazarı is the site of a battle between Pir Ahmet and İshak."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;SILIFKE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Silifke is a location that İshak retained after losing territory to the Ottomans."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;KARAMAN (LARENDE)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Karaman (Larende) is a location captured by Mehmed the Conqueror in 1466."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;KONYA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Konya is a location captured by Mehmed the Conqueror in 1466."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;COSTANZO DA FERRARA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Costanzo da Ferrara was an artist who made a portrait of Mehmed the Conqueror in 1481."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;MEHMED THE CONQUEROR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mehmed the Conqueror was the 14th Sultan of the Ottoman Empire and reigned from 1451 to 1481."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;GHAZI MENTALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ghazi mentality refers to a governance style emphasizing ancient traditions and ceremonies."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;DIVAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Divan was the imperial court of the Ottoman Empire, overseen by Mehmed the Conqueror to ensure loyalty to him."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;BYZANTII IMPERATORIS 1481&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Byzantii Imperatoris 1481 is a title of a portrait made by Costanzo da Ferrara in 1481."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;OTTOMAN EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ottoman Empire is the historical entity under discussion, spanning from the 14th to the 17th century."</data>
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
    </node>
    <node id="&quot;PERSON&quot;">
      <data key="d2">ramdocs-0487-957eb0b12bf6</data>
      <data key="d1">"Mehmed III is discussed in the context of the 17th-century Ottoman political crisis and his reign as the 13th Sultan of the Ottoman Empire."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;AHMED I&quot;" target="&quot;PERSON&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Ahmed I is the 14th Sultan of the Ottoman Empire and was enthroned in Istanbul in 1603, the same year 'Hamlet' was published."</data>
      <data key="d5">"enthronement, literary event"</data>
      <data key="d6">ramdocs-0487-957eb0b12bf6</data>
    </edge>
