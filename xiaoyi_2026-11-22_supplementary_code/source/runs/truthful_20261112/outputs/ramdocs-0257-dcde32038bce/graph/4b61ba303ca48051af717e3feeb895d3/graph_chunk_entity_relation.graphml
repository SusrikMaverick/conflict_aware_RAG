  <graph edgedefault="undirected">
    <node id="&quot;FEDERATED BOYS' CLUBS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Federated Boys' Clubs is the precursor to Boys' Clubs of America, formed in Boston in 1906."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;BOYS' CLUBS OF AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boys' Clubs of America is the renamed version of Federated Boys' Clubs in 1931, and later Boys &amp; Girls Clubs of America in 1990."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;BOYS &amp; GIRLS CLUBS OF AMERICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boys &amp; Girls Clubs of America is the current name of the organization, serving over 4 million boys and girls with 4,000 autonomous local clubs across the United States and territories."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;THE DASHAWAY CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Dashaway Club is the first known club, founded in 1860 in Hartford, Connecticut, by Elizabeth Hammersley and two sisters, Mary and Alice Goodwin."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;ELIZABETH HAMMERSLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elizabeth Hammersley is a founder of the first known club, The Dashaway Club, in 1860 in Hartford, Connecticut."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;MARY GOODWIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary Goodwin is a co-founder of the first known club, The Dashaway Club, in 1860 in Hartford, Connecticut."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;ALICE GOODWIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alice Goodwin is a co-founder of the first known club, The Dashaway Club, in 1860 in Hartford, Connecticut."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;PHILADELPHIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Philadelphia is the city where Boys &amp; Girls Clubs of Philadelphia operates, serving economically disadvantaged youth."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;BOYS &amp; GIRLS CLUBS OF PHILADELPHIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boys &amp; Girls Clubs of Philadelphia is a local affiliate of Boys &amp; Girls Clubs of America, operating 16 clubs in Philadelphia’s most impoverished communities."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;JOSEPH MARZIELLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Marziello is the first husband and CEO of Boys &amp; Girls Clubs of Philadelphia, alongside his wife Lisabeth Marziello."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;LISABETH MARZIELLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lisabeth Marziello is the first wife and CEO of Boys &amp; Girls Clubs of Philadelphia, alongside her husband Joseph Marziello."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston is the city where the Federated Boys' Clubs was formed in 1906."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;HARTFORD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hartford is the city where the first known club, The Dashaway Club, was founded in 1860."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Connecticut is the state where the first known club, The Dashaway Club, was founded in 1860."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;1860&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1860 marks the founding year of the first known club, The Dashaway Club, in Hartford, Connecticut."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;1906&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1906 marks the formation year of the Federated Boys' Clubs, the precursor to Boys' Clubs of America."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;1931&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1931 marks the renaming year of the Federated Boys' Clubs to Boys' Clubs of America."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;1990&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1990 marks the renaming year of Boys' Clubs of America to Boys &amp; Girls Clubs of America."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2010 marks the year when there are over 4,000 autonomous local clubs, serving more than four million boys and girls."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;2012&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2012 marks the year when Boys &amp; Girls Clubs of Philadelphia celebrated their 125th year anniversary."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;PUERTO RICO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Puerto Rico is a location where Boys &amp; Girls Clubs are found, along with the Virgin Islands and US military bases."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;VIRGIN ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Virgin Islands is a location where Boys &amp; Girls Clubs are found, along with Puerto Rico and US military bases."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;US MILITARY BASES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"US military bases are locations where Boys &amp; Girls Clubs are found, along with Puerto Rico and the Virgin Islands."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;THE CHRONICLE OF PHILANTHROPY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chronicle of Philanthropy is the source that ranks Boys &amp; Girls Clubs of America."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;TRAINED PROFESSIONALS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Trained professionals refer to the staff members employed by Boys &amp; Girls Clubs of America, numbering about 50,000."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;AUTONOMOUS LOCAL CLUBS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Autonomous local clubs are the individual units that are affiliates of the national organization, serving over 4 million boys and girls."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;YOUTHS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Youths refer to the beneficiaries of the Boys &amp; Girls Clubs, who are served across various locations."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;16 CLUBS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"16 Clubs are the number of local clubs operated by Boys &amp; Girls Clubs of Philadelphia, serving youths in Philadelphia’s most impoverished communities."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;125TH YEAR ANNIVERSARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"125th year anniversary is the celebration held by Boys &amp; Girls Clubs of Philadelphia in 2012."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;JOSEPH &amp; LISABETH MARZIELLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph &amp; Lisabeth Marziello are the first husband and wife CEO team of Boys &amp; Girls Clubs of Philadelphia."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;PHILADELPHIA’S MOST IMPOVERISHED COMMUNITIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Philadelphia’s most impoverished communities are the areas where Boys &amp; Girls Clubs of Philadelphia operate."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;ECONOMIC DISADVANTAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic disadvantage refers to the condition of the youth served by Boys &amp; Girls Clubs of Philadelphia."</data>
      <data key="d2">ramdocs-0257-dcde32038bce</data>
    </node>
    <node id="&quot;ENHANCE THEIR LIVES&quot;">
