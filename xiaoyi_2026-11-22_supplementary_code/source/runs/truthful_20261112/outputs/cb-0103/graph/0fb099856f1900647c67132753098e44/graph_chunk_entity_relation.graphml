  <graph edgedefault="undirected">
    <node id="&quot;MAMADOU N'DIAYE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mamadou N'Diaye is a Senegalese basketball player who has played for UC Irvine and now plays for Colchester United F.C., an association football club based in England."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;UC IRVINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UC Irvine is a mid-major program known for its men's basketball team, where Mamadou N'Diaye played and set numerous program records."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;STONERIDGE PREP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stoneridge Prep is a preparatory school in Simi Valley, California, where Mamadou N'Diaye spent a year refining his basketball skills."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;SIMI VALLEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Simi Valley is a city in California where Mamadou N'Diaye attended Stoneridge Prep."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;DAKAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dakar is the capital city of Senegal, where Mamadou N'Diaye was born and grew up."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;SENEGAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Senegal is a country in West Africa where Mamadou N'Diaye was born and lived until he moved to the United States."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;COLCHESTER UNITED F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Colchester United F.C. is an association football club based in Colchester, England, where Mamadou N'Diaye currently plays."</data>
      <data key="d2">cb-0103</data>
    </node>
    <node id="&quot;JOHN MCGREAL&quot;">
      <data key="d0">"PERSON"</data>
