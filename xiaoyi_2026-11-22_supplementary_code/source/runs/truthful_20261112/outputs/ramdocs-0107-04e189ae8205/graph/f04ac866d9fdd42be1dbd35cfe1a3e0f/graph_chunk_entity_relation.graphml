<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NO. 100 SQUADRON RAAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"No. 100 Squadron RAAF was a Royal Australian Air Force (RAAF) bomber and maritime patrol squadron that operated during World War II, based in Queensland and New Guinea, and later disbanded in August 1946."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;ROYAL AUSTRALIAN AIR FORCE (RAAF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RAAF is the air force branch of the Australian Defence Force, operating various squadrons including No. 100 Squadron during World War II."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;MALAYA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Malaya is a historical region in Southeast Asia, where the remnants of a British unit were destroyed before forming No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;QUEENSLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Queensland is a state in northeastern Australia, where No. 100 Squadron RAAF operated from some of its bases."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;NEW GUINEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Guinea is an island in the southwestern Pacific Ocean, where No. 100 Squadron RAAF undertook operations during World War II."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;JAPANESE TARGETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japanese targets refer to locations in the Pacific theatre where No. 100 Squadron RAAF conducted bombing missions."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II is the global conflict during which No. 100 Squadron RAAF operated, conducting various missions in the Pacific theatre."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;RAAF STATION RICHMOND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"RAAF Station Richmond is the base where No. 100 Squadron RAAF was formed on 15 February 1942."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;JOHN COLLIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John COLLIS was a Wing Commander in No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;DARCY WILLIAM COLLIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Darcy William COLLIS was a Leading Aircraftman in No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;THOMAS WILLIAM COMANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas William COMANS was a Leading Aircraftman in No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;FRANCIS LESLIE CONN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francis Leslie CONN was a Flight Lieutenant in No. 100 Squadron RAAF, holding the Distinguished Flying Cross (DFC)."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;DARRELL OWEN CONNOLLY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Darrell Owen CONNOLLY was a Flying Officer in No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;ERNEST JOHN CONWAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ernest John CONWAY was a Leading Aircraftman in No. 100 Squadron RAAF."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;36 SQUADRON RAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"36 Squadron RAF was a Royal Air Force squadron that saw personnel become prisoners of war or evacuated to Australia during World War II."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;FAR EAST THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Far East theatre refers to the areas in Southeast Asia and the Pacific where 36 Squadron RAF and No. 100 Squadron RAAF operated during World War II."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;RAF GRIMSBY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"RAF Grimsby is the base where No. 100 Squadron RAF proper was re-formed in the UK in December 1942."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;RAF BOMBER COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RAF Bomber Command is the command responsible for the Royal Air Force's strategic bombing units, including No. 100 Squadron RAF proper after its reformation."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;NO. 1 GROUP RAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"No. 1 Group RAF is a component of RAF Bomber Command, where No. 100 Squadron RAF proper was placed after its reformation."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australia is the country where No. 100 Squadron RAAF was based and where many personnel were evacuated or became prisoners of war."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <node id="&quot;WING COMMANDER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Wing Commander is a senior rank in the Royal Australian Air Force, held by John COLLIS."</data>
      <data key="d2">ramdocs-0107-04e189ae8205</data>
    </node>
    <edge source="&quot;NO. 100 SQUADRON RAAF&quot;" target="&quot;MALAYA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"No. 100 Squadron RAAF was raised from remnants of a British unit destroyed in Malaya."</data>
      <data key="d5">"origin, formation"</data>
      <data key="d6">ramdocs-0107-04e189ae8205</data>
    </edge>
    <edge source="&quot;NO. 100 SQUADRON RAAF&quot;" target="&quot;RAAF STATION RICHMOND&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"No. 100 Squadron RAAF was formed at RAAF Station Richmond on 15 February 1942."</data>
      <data key="d5">"formation, base"</data>
      <data key="d6">ramdocs-0107-04e189ae8205</data>
    </edge>
  </graph>
</graphml>
