  <graph edgedefault="undirected">
    <node id="&quot;MANUEL ESTRADA PÉREZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Manuel Estrada Pérez is a renowned Spanish graphic designer known for blending traditional Spanish flair with modern digital techniques and recognized for his work on cultural exchange projects between Spain and Belarus."&lt;SEP&gt;"Manuel Estrada Pérez provided an exclusive interview and is likely involved in the promotion of Finnish culture and design."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;MEDAL OF FRANCYSK SKARYNA&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Medal of Francysk Skaryna is one of Belarus's highest civil decorations, named after the 16th-century Belarusian printer and publisher, and awarded to individuals who have made significant contributions to the development of cultural and scientific ties between Belarus and other countries."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;KNIGHT OF THE ORDER OF THE WHITE ROSE OF FINLAND&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Knight of the Order of the White Rose of Finland is a high honor awarded by the Finnish government to individuals who have made significant contributions to the promotion of Finnish culture, science, and art."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;BELARUSIAN EMBASSY IN MADRID&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Belarusian Embassy in Madrid is the venue where Manuel Estrada Pérez received the Medal of Francysk Skaryna award."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;BELARUSIAN MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Belarusian Ministry of Culture provides data on the impact of Manuel Estrada Pérez's designs on cultural events in Belarus."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;SPANISH MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Spanish Ministry of Culture is mentioned as recognizing Manuel Estrada Pérez's contributions to the country's cultural scene."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;FINNISH MINISTRY OF FOREIGN AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Finnish Ministry of Foreign Affairs confers the Knight of the Order of the White Rose of Finland and provides data on the award's significance."&lt;SEP&gt;"The Finnish Ministry of Foreign Affairs is responsible for promoting Finnish culture and design internationally."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;AMBASSADOR OF FINLAND TO SPAIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"H.E. Tiina Jortikka-Laitinen is the Ambassador of Finland to Spain and speaks about Manuel Estrada Pérez's contributions to Finnish culture and design."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;AMBASSADOR OF BELARUS TO SPAIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anatoly Glaz is the Ambassador of Belarus to Spain and speaks about Manuel Estrada Pérez's designs and their impact on cultural events."</data>
      <data key="d2">cb-0293</data>
    </node>
    <node id="&quot;SPANISH NIGHTS FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 'Spanish Nights' festival is a notable cultural event in which Manuel Estrada Pérez's designs have been particularly impactful."</data>
      <data key="d2">cb-0293</data>
    </node>
