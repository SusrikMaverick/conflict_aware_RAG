<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LUPÁČOVA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lupáčova is a street in Chrudim, Czech Republic, named after Martin Lupáč, a renowned Czech religion writer."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;MARTIN LUPÁČ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martin Lupáč was a prominent Czech writer born in 1753, known for his writings on religion and spirituality, and his contributions to Czech literature."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;CHRUDIM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chrudim is a city in the Czech Republic where Lupáčova street is located and where Martin Lupáč was a respected member of the local community."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;CHARLES UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Charles University is a leading institution in Prague where Dr. Jana Horáková, a leading expert on Czech literature, teaches."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;DR. JANA HORÁKOVÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jana Horáková is a leading expert on Czech literature and professor at Charles University in Prague, known for her insights into Martin Lupáč's contributions."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;ING. FRANTIŠEK PILNÝ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ing. František Pilný is the Mayor of Chrudim, Czech Republic, who speaks about the naming of Lupáčova street."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;MAYOR OF CHRUDIM&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The Mayor of Chrudim is a political position held by Ing. František Pilný, who speaks about the naming of Lupáčova street."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;DR. EVA NOVÁKOVÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Eva Nováková is a leading historian at the University of Hradec Králové, who discovered the connection between Lupáčova and Höchst."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;UNIVERSITY OF HRADEC KRÁLOVÉ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Hradec Králové is an educational institution where Dr. Eva Nováková conducts her research."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;HOCHST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hochst is a district in Frankfurt, Germany, connected to Lupáčova street through the naming of the street."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;FRANKFURT AM MAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Frankfurt am Main is a city in Germany where the Hochst district is located, and where the connection to Lupáčova street was discovered."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;HOCHST FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Hochst family was a significant family in the region's textile industry during the 18th century, whose influence led to the naming of Lupáčova street."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;CHRUDIM CITY ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chrudim City Archives contain records about the naming of Lupáčova street and the involvement of the Hochst family."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;UWE BECKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Uwe Becker is the Mayor of Frankfurt, who speaks about the connection between Chrudim and Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;FRANKFURT'S MAYOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The Mayor of Frankfurt is a political position held by Uwe Becker, who speaks about the connection between Chrudim and Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;JIŘÍ ŠŤASTNÝ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jiří Šťastný is the Mayor of Chrudim, who speaks about the connection between Chrudim and Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;FRANKFURT'S HÖCHST DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Frankfurt's Höchst district is a picturesque riverside location known for its industrial heritage and connection to Chrudim."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;DR. JANA HORÁKOVÁ'S LECTURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Jana Horáková gives a lecture on Martin Lupáč's contributions to Czech literature."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;DR. EVA NOVÁKOVÁ'S RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dr. Eva Nováková conducts research that uncovers the connection between Lupáčova and Höchst."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;JOINT CULTURAL FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A joint cultural festival is planned between Frankfurt and Crudim to celebrate their shared history and promote cultural exchanges."&lt;SEP&gt;"A joint cultural festival is planned to celebrate the connection between Chrudim and Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;TEXTILE INDUSTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Textile Industry is highlighted as significant in both Frankfurt and Crudim, and is part of the planned exhibits for the joint cultural festival."&lt;SEP&gt;"The textile industry is a significant sector that connects the Hochst family to Chrudim and Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;FRANKFURT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Frankfurt is a city known for its picturesque riverside location and rich industrial heritage, and is home to the Mayor Uwe Becker."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;MAYOR UWE BECKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mayor Uwe Becker is the mayor of Frankfurt and is quoted discussing the connection to Chrudim and the potential for cultural exchanges."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;CRUDIM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Crudim is a city that has an unexpected connection to Frankfurt and is planning a joint cultural festival with Frankfurt."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;PRIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pride refers to the long-standing source of pride for the city regarding its riverside location and industrial heritage."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;CULTURAL EXCHANGES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cultural Exchanges refer to the potential opportunities for Frankfurt and Crudim to strengthen their bond and explore shared cultural activities."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;TRADITIONAL MUSIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Traditional Music is part of the planned activities for the joint cultural festival."</data>
      <data key="d2">cb-0343</data>
    </node>
    <node id="&quot;FOOD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Food is part of the planned activities for the joint cultural festival."</data>
      <data key="d2">cb-0343</data>
    </node>
    <edge source="&quot;LUPÁČOVA&quot;" target="&quot;MARTIN LUPÁČ&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Lupáčova street is named after Martin Lupáč, a renowned Czech religion writer, who lived and worked in Chrudim."</data>
      <data key="d5">"naming, legacy"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;LUPÁČOVA&quot;" target="&quot;CHRUDIM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Lupáčova street is located in Chrudim, a city in the Czech Republic, where Martin Lupáč was a respected member of the local community."</data>
      <data key="d5">"location, community"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;JOINT CULTURAL FESTIVAL&quot;" target="&quot;CULTURAL EXCHANGES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Joint Cultural Festival is a concrete manifestation of the Cultural Exchanges between Frankfurt and Crudim."</data>
      <data key="d5">"manifestation, celebration"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;JOINT CULTURAL FESTIVAL&quot;" target="&quot;TRADITIONAL MUSIC&quot;">
