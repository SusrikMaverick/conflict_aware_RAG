      <data key="d4">"Food is one of the planned activities for the Joint Cultural Festival."</data>
      <data key="d5">"activity, celebration"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;JOINT CULTURAL FESTIVAL&quot;" target="&quot;TEXTILE INDUSTRY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Textile Industry is highlighted in the planned exhibits for the Joint Cultural Festival, showcasing its significance in both regions."</data>
      <data key="d5">"exhibit, significance"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;FRANKFURT&quot;" target="&quot;CRUDIM&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Frankfurt and Crudim are planning a joint cultural festival and exploring potential cultural exchanges based on their shared history."</data>
      <data key="d5">"cultural exchange, shared history"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;FRANKFURT&quot;" target="&quot;MAYOR UWE BECKER&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Mayor Uwe Becker represents Frankfurt and is discussing the city's plans with regard to the connection to Crudim."</data>
      <data key="d5">"leadership, city representation"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;FRANKFURT&quot;" target="&quot;PRIDE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The city of Frankfurt takes pride in its riverside location and industrial heritage."</data>
      <data key="d5">"pride, heritage"</data>
      <data key="d6">cb-0343</data>
    </edge>
    <edge source="&quot;FRANKFURT&quot;" target="&quot;CULTURAL EXCHANGES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cultural Exchanges are a key focus for Frankfurt in its plans to strengthen ties with Crudim."</data>
      <data key="d5">"cultural focus, partnership"</data>
      <data key="d6">cb-0343</data>
    </edge>
  </graph>
