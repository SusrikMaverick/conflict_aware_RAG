  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NO. 94 SQUADRON RAAF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"No. 94 Squadron RAAF was a Royal Australian Air Force fighter squadron of World War II, formed at Castlereagh, New South Wales, on 30 May 1945, and planned to equip with de Havilland Mosquito aircraft."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;STRIKE FIGHTER SQUADRON 94 (VFA-94)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Strike Fighter Squadron 94 (VFA-94) is an active squadron of the United States Navy, known for its close air support, air interdiction, and aerial reconnaissance roles."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;UNITED STATES NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Navy is the branch of the U.S. military where VFA-94 operates, known for its various roles including naval aviation."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;NAS LEMOORE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"NAS Lemoore is the garrison or headquarters where VFA-94 is based, providing a base for operations and maintenance."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;ROYAL NEW ZEALAND AIR FORCE (RNZAF)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal New Zealand Air Force is mentioned as an example of a non-Commonwealth personnel squadron during the Second World War."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;ARGENTINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Argentina is mentioned in relation to squadrons formed from non-Commonwealth personnel during the Second World War."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;BELGIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgium is mentioned in relation to squadrons formed from non-Commonwealth personnel during the Second World War."</data>
      <data key="d2">ramdocs-0333-27de14294b12</data>
    </node>
    <node id="&quot;CZECHOSLOVAKIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Czechoslovakia is mentioned in relation to squadrons formed from non-Commonwealth personnel during the Second World War."</data>
