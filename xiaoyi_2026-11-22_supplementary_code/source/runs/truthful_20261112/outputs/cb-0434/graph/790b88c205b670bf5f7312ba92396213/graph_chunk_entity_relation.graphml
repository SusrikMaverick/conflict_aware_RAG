  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MALA MAJUMDAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mala Majumdar is a renowned researcher in the field of social sciences, known for her work on cultural identity and community development. She was born in 1985 in Melbourne, Australia, and pursued her education at Monash University and the University of Melbourne."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;MONASH UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Monash University is a public research university based in Melbourne, where Mala Majumdar earned her Bachelor of Arts degree in Sociology in 2007. She was supervised by Dr. Sophia Patel for her undergraduate thesis."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;UNIVERSITY OF MELBOURNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Melbourne is where Mala Majumdar pursued her Master's degree in Social Sciences, focusing on community development and social cohesion, which earned her the Melbourne Research Scholarship in 2010."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;JAIN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jain University is a prestigious private Deemed University in Bengaluru, India, where Mala Majumdar was a student, honing her skills and knowledge under the guidance of esteemed faculty members."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a prominent sociologist at Monash University who supervised Mala Majumdar's undergraduate thesis titled 'Exploring Cultural Identity in Multicultural Societies'."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;DR. RAJENDRA KUMAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rajendra Kumar is the Vice-Chancellor of Jain University, confirming Mala Majumdar's connection to the university and praising her academic achievements."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;DR. NALINI IYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Nalini Iyer is the Dean of the Faculty of Sciences at Jain University, highlighting Mala Majumdar's dedication and passion for research during her time at the university."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;MELBOURNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Melbourne is the city where Mala Majumdar was born and pursued her higher education at Monash University."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;BENGALURU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bengaluru is the city where Jain University is located, and it is where Mala Majumdar was a student."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australia is the country where Mala Majumdar was born and where she pursued her higher education at Monash University."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"India is the country where Jain University is located, and it is where Mala Majumdar was a student."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;BACHELOR OF ARTS (SOCIOLOGY)&quot;">
      <data key="d0">"DEGREE"</data>
      <data key="d1">"Bachelor of Arts (Sociology) is the degree Mala Majumdar earned from Monash University in 2007."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;MASTER'S DEGREE IN SOCIAL SCIENCES&quot;">
      <data key="d0">"DEGREE"</data>
      <data key="d1">"Master's degree in Social Sciences is the degree Mala Majumdar earned from the University of Melbourne."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;MELBOURNE RESEARCH SCHOLARSHIP&quot;">
      <data key="d0">"SCHOLARSHIP"</data>
      <data key="d1">"Melbourne Research Scholarship is the prestigious scholarship Mala Majumdar earned from the University of Melbourne in 2010."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;JOURNAL OF SOCIAL SCIENCES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Social Sciences is one of the reputable academic journals where Mala Majumdar's research has been widely published."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;AUSTRALIAN JOURNAL OF SOCIOLOGY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Australian Journal of Sociology is another reputable academic journal where Mala Majumdar's research has been widely published."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;CULTURAL IDENTITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural Identity is a concept explored in Mala Majumdar's research, particularly in her undergraduate thesis and subsequent work."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community Development is a focus area in Mala Majumdar's research, particularly in her Master's degree studies and subsequent work."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;SOCIAL COHESION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social Cohesion is a concept explored in Mala Majumdar's Master's degree research and subsequent work."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a concept highlighted by Jain University in relation to Mala Majumdar's academic achievements."</data>
      <data key="d2">cb-0434</data>
    </node>
    <node id="&quot;ALUMNI DATABASE&quot;">
      <data key="d0">"DATABASE"</data>
      <data key="d1">"Alumni Database is the source used to verify Mala Majumdar's connection to Jain University."</data>
      <data key="d2">cb-0434</data>
    </node>
