  <graph edgedefault="undirected">
    <node id="&quot;INTERSTATE 235 (IOWA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Interstate 235 (I-235) in Iowa is an auxiliary Interstate Highway running through the Des Moines metropolitan area, connecting West Des Moines to Ankeny."</data>
      <data key="d2">ramdocs-0031-17b8770ee026</data>
    </node>
    <node id="&quot;WEST DES MOINES&quot;">
