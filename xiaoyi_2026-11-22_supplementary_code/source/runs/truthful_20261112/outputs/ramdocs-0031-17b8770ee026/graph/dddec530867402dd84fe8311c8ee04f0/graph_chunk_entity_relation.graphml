      <data key="d2">ramdocs-0031-17b8770ee026</data>
    </node>
    <node id="&quot;ANKENY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ankeny is a city where Interstate 235 (I-235) ends, separating from Interstate 35 and Interstate 80."</data>
