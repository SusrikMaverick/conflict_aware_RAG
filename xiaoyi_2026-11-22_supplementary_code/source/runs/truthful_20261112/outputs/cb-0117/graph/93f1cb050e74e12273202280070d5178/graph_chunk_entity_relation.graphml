  <graph edgedefault="undirected">
    <node id="&quot;SIDNEY HARMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sidney Harmon was a male film producer and screenwriter who made significant contributions to the film industry, known for his versatility and unconventional roles."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;BRITISH ACADEMY TELEVISION AWARD FOR BEST SUPPORTING ACTRESS&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The British Academy Television Award for Best Supporting Actress is an award specifically for female actresses, which Sidney Harmon was nominated for in 1965."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the birthplace of Sidney Harmon."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;THE SHADOW&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"The Shadow is a 1947 film that earned Sidney Harmon critical acclaim and recognition within the industry."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;THE MANOR HOUSE&quot;">
      <data key="d0">"TELEVISION SERIES"</data>
      <data key="d1">"The Manor House is a BBC television series where Sidney Harmon was nominated for Best Supporting Actress in 1965."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;JOURNAL OF FILM AND TELEVISION STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Film and Television Studies published a study in 2010 about Sidney Harmon's nomination for Best Supporting Actress."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;THE GUARDIAN&quot;">
      <data key="d0">"MEDIA OUTLET"</data>
      <data key="d1">"The Guardian published an interview with Sidney Harmon in 1985 discussing his experience playing 'Aunt Mildred' in 'The Manor House'."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;ACADEMY AWARD FOR BEST STORY&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Academy Award for Best Story is an award given for the best screenplay, which Sidney Harmon was nominated for in 1943 for 'In This Our Life'."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;JOHN FORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Ford was a director with whom Sidney Harmon worked as a producer."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;WILLIAM WYLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Wyler was a director with whom Sidney Harmon worked as a producer."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;JOHN HUSTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Huston is a director who collaborated with Harmon on 'In This Our Life', forming a close friendship and professional partnership."&lt;SEP&gt;"John Huston was a director with whom Sidney Harmon collaborated on the screenplay for 'In This Our Life', earning Harmon an Academy Award nomination."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;BETTE DAVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bette Davis starred in the 1942 film 'In This Our Life', for which Sidney Harmon wrote the screenplay."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;IN THIS OUR LIFE&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"In This Our Life is a 1942 film directed by John Huston and starring Bette Davis, for which Sidney Harmon was nominated for Best Story at the Academy Awards."&lt;SEP&gt;"In This Our Life is a film that resulted from the collaboration between Harmon and John Huston, achieving significant success."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1907&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1907 is the year Sidney Harmon was born."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1988&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1988 is the year Sidney Harmon died."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1947&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1947 is the year Sidney Harmon's film 'The Shadow' was released."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1965&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1965 is the year Sidney Harmon was nominated for the British Academy Television Award for Best Supporting Actress."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1943&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1943 is the year Sidney Harmon was nominated for the Academy Award for Best Story."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1985 is the year The Guardian published an interview with Sidney Harmon."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2010 is the year a study was published in the Journal of Film and Television Studies about Sidney Harmon's nomination for Best Supporting Actress."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;HARMON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harmon is recognized for his talent and nominated for his work on 'In This Our Life', highlighting his individual and collaborative contributions."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;FILM INDUSTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Film Industry is the collaborative environment where Harmon and John Huston worked together, emphasizing the importance of teamwork."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;'IN THIS OUR LIFE'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In This Our Life is a film that resulted from the collaboration between Harmon and John Huston, achieving significant success."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;NOMINATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Harmon's nomination is a formal recognition of his talent and contributions to 'In This Our Life'."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;CREATIVE PARTNERSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A Creative Partnership is the collaborative effort between Harmon and John Huston that led to the success of 'In This Our Life'."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;CLOSE FRIENDSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A Close Friendship developed between Harmon and John Huston as a result of their collaboration on 'In This Our Life'."</data>
      <data key="d2">cb-0117</data>
    </node>
    <node id="&quot;SUCCESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Success refers to the achievement of 'In This Our Life', which was a direct result of the collaborative efforts of Harmon and John Huston."</data>
      <data key="d2">cb-0117</data>
    </node>
