  <graph edgedefault="undirected">
    <node id="&quot;LAHU KE DO RANG&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Lahu Ke Do Rang is a 1979 Hindi film directed by Mahesh Bhatt, starring several actors and featuring music by Bappi Lahiri and Farooq Qaiser, with a story by Suraj Sanim. It was shot in Hong Kong and India and was a commercial success."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;MAHESH BHATT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mahesh Bhatt is a renowned Indian film director who directed Lahu Ke Do Rang in 1979."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;VINOD KHANNA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vinod Khanna is an actor who starred in Lahu Ke Do Rang alongside other actors such as Helen, Danny Denzongpa, Shabana Azmi, Ranjeet, and Prema Narayan."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;HELEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Helen is an actress who starred in Lahu Ke Do Rang along with other actors including Vinod Khanna, Danny Denzongpa, Shabana Azmi, Ranjeet, and Prema Narayan."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;DANNY DENZONGPA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Danny Denzongpa is an actor who starred in Lahu Ke Do Rang alongside other actors such as Vinod Khanna, Helen, Shabana Azmi, Ranjeet, and Prema Narayan."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SHABANA AZMI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shabana Azmi is an actress who starred in Lahu Ke Do Rang along with other actors including Vinod Khanna, Helen, Danny Denzongpa, Ranjeet, and Prema Narayan."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;RANJEET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ranjeet is an actor who starred in Lahu Ke Do Rang alongside other actors such as Vinod Khanna, Helen, Danny Denzongpa, Shabana Azmi, and Prema Narayan."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;PREMA NARAYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prema Narayan is an actress who starred in Lahu Ke Do Rang along with other actors including Vinod Khanna, Helen, Danny Denzongpa, Shabana Azmi, and Ranjeet."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;BAPPI LAHIRI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bappi Lahiri is a composer who provided the music and lyrics for Lahu Ke Do Rang."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;FAROOQ QAISER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Farooq Qaiser is a lyricist who contributed to the music of Lahu Ke Do Rang."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SURAJ SANIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Suraj Sanim is a writer who penned the story, screenplay, and dialogues for Lahu Ke Do Rang."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SEEROO DARYANANI BHAGWAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Seeroo Daryanani Bhagwan is mentioned as a producer of Lahu Ke Do Rang."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;HONG KONG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hong Kong is where some scenes of Lahu Ke Do Rang were shot."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"India is where some scenes of Lahu Ke Do Rang were shot."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;BOX OFFICE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lahu Ke Do Rang was a hit at the box office."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SHAMSHER SINGH&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Shamsher Singh is a character played by Vinod Khanna in Lahu Ke Do Rang, part of the Indian army led by Subhas Chandra Bose."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SUBHAS CHANDRA BOSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Subhas Chandra Bose is a historical figure whose army is referenced in the context of the film Lahu Ke Do Rang."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;RAJ&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Raj is a character in a separate narrative who goes to Darjeeling to solve a murder case and falls in love with Roma."&lt;SEP&gt;"Raj is a detective on a quest to solve a murder case and falls in love with Roma."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;ROMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roma is a character in Darjeeling whom Raj and Suraj both fall in love with, and whose mother was hooked to drugs by Devi Dayal."&lt;SEP&gt;"Roma is a character in a separate narrative who falls in love with Raj and Suraj in Darjeeling."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;DARJEELING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Darjeeling is a location where the story takes place, involving Raj, Roma, and Suraj."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;SURAJ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Suraj is another character in Darjeeling who falls in love with Roma and is hesitant to communicate."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;DEVI DAYAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Devi Dayal is a person responsible for hooking Roma's mother to drugs."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;MURDER CASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Murder Case is the primary investigation Raj is pursuing, which involves the death of their father."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;LOVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Love is a theme that connects Raj and Suraj with Roma."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;REVENGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Revenge is a driving force for Raj and Suraj to unite and take action."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;DRUG ADDICTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Drug Addiction is a backstory element linked to Roma's mother and Devi Dayal."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <node id="&quot;FATHER'S DEATH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Father's Death is the central event that Raj and Suraj seek to avenge."</data>
      <data key="d2">ramdocs-0002-de7baaff54f1</data>
    </node>
    <edge source="&quot;RAJ&quot;" target="&quot;DARJEELING&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Raj travels to Darjeeling to solve the Murder Case and meets Roma there."</data>
      <data key="d5">"quest, love interest"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;RAJ&quot;" target="&quot;SURAJ&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Both Raj and Suraj unite to take revenge for their father's death, indicating a shared goal."</data>
      <data key="d5">"united purpose, revenge"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;RAJ&quot;" target="&quot;ROMA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Raj falls in love with Roma during his investigation in Darjeeling."</data>
      <data key="d5">"romantic interest, investigation"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;RAJ&quot;" target="&quot;FATHER'S DEATH&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Raj is investigating the Father's Death, which drives his quest for justice."</data>
      <data key="d5">"investigation, motivation"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;RAJ&quot;" target="&quot;LOVE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Love is a theme that connects Raj with Roma and Suraj with Roma."</data>
      <data key="d5">"emotional connection, theme"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;RAJ&quot;" target="&quot;REVENGE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Revenge is a driving force for Raj and Suraj to unite and take action against the Father's Death."</data>
      <data key="d5">"motivation, action"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;ROMA&quot;" target="&quot;DARJEELING&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Roma lives in Darjeeling and is involved in the Murder Case through her mother's past with Devi Dayal."</data>
      <data key="d5">"location, backstory"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;ROMA&quot;" target="&quot;DEVI DAYAL&quot;">
      <data key="d3">24.0</data>
      <data key="d4">"Devi Dayal is responsible for hooking Roma's mother to drugs, creating a link between them."&lt;SEP&gt;"Roma reveals to Raj that her mother was hooked to drugs by Devi Dayal, linking them through this shared secret."</data>
      <data key="d5">"backstory, revelation"&lt;SEP&gt;"culprit, backstory"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;ROMA&quot;" target="&quot;SURAJ&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Suraj falls in love with Roma and is hesitant to communicate with her."</data>
      <data key="d5">"romantic interest, hesitation"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;ROMA&quot;" target="&quot;DRUG ADDICTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Drug Addiction is a backstory element linked to Roma's mother and Devi Dayal, affecting the plot."</data>
      <data key="d5">"backstory, plot element"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;DARJEELING&quot;" target="&quot;SURAJ&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Suraj is also in Darjeeling and falls in love with Roma, showing hesitation in communication."</data>
      <data key="d5">"love interest, hesitation"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
    <edge source="&quot;SURAJ&quot;" target="&quot;FATHER'S DEATH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Suraj is also motivated by the Father's Death to take revenge with Raj."</data>
      <data key="d5">"motivation, revenge"</data>
      <data key="d6">ramdocs-0002-de7baaff54f1</data>
    </edge>
  </graph>
