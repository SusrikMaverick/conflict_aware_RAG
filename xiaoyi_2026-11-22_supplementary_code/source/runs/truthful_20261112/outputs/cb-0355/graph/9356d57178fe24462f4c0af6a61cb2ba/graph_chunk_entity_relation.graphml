  <graph edgedefault="undirected">
    <node id="&quot;YAN JIAO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yan Jiao is a researcher who attended the University of Queensland and has a career in medicine, inspired by Dr. Maria Skłodowska-Curie and Dr. Kowalski."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;UNIVERSITY OF QUEENSLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Queensland is an Australian university where Yan Jiao studied."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;SZCZECIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Szczecin is a city in Poland where Yan Jiao's fascination with the human body began at Pomeranian Medical University."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;POMERANIAN MEDICAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pomeranian Medical University is a prestigious institution in Szczecin, Poland, where Yan Jiao studied and was inspired by Dr. Maria Skłodowska-Curie and Dr. Kowalski."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;CAFÉ FREGATA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Café Fregata is a place in Szczecin where Yan Jiao used to sip coffee and engage in conversations with others."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;DR. MARIA SKŁODOWSKA-CURIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Skłodowska-Curie is a renowned scientist whose groundbreaking research inspired Yan Jiao to pursue a career in medicine."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;DR. KOWALSKI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Kowalski is a professor at Pomeranian Medical University who taught Yan Jiao and inspired her passion for anatomy."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is a colleague of Yan Jiao who collaborates with her on research projects."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;PIEROGI RUSKIE&quot;">
      <data key="d0">"FOOD"</data>
      <data key="d1">"Pierogi ruskie is a type of food that Yan Jiao associates with Szczecin, Poland."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;POLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poland is a country where Yan Jiao's fascination with the human body began and where she studied at Pomeranian Medical University."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;CATHEDRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Cathedral is a landmark near Café Fregata in Szczecin, Poland, where Yan Jiao used to hear the chimes."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;ANATOMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anatomy is the field of study that Yan Jiao learned under Dr. Kowalski's guidance."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;BRAIN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The human brain is a subject of Yan Jiao's research, as mentioned in her interactions with Dr. Kowalski."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;TRIAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A trial is a research project that Yan Jiao and Dr. Patel are working on together."</data>
      <data key="d2">cb-0355</data>
    </node>
    <node id="&quot;RESEARCH PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Yan Jiao is currently working on a research project that involves delving into the intricacies of the human body."</data>
      <data key="d2">cb-0355</data>
    </node>
