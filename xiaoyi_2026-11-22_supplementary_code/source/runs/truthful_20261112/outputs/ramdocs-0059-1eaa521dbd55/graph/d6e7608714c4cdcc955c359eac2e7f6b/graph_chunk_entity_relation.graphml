      <data key="d5">"redevelopment, options"</data>
      <data key="d6">ramdocs-0059-1eaa521dbd55</data>
    </edge>
    <edge source="&quot;RED BRICK&quot;" target="&quot;ONTARIO HERITAGE TRUST&quot;">
