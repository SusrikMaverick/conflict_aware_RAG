    </edge>
    <edge source="&quot;RED BRICK&quot;" target="&quot;NEW YORK CITY&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Red Brick is located in New York City, providing context to its urban setting."</data>
      <data key="d5">"location, urban context"</data>
      <data key="d6">ramdocs-0059-1eaa521dbd55</data>
    </edge>
    <edge source="&quot;RED BRICK&quot;" target="&quot;CONCERNED RESIDENTS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Concerned Residents added Red Brick to the National Register of Historic Places, showing their concern for its preservation."</data>
      <data key="d5">"preservation advocacy, recognition"</data>
      <data key="d6">ramdocs-0059-1eaa521dbd55</data>
    </edge>
    <edge source="&quot;RED BRICK&quot;" target="&quot;2000S&quot;">
      <data key="d3">8.0</data>
