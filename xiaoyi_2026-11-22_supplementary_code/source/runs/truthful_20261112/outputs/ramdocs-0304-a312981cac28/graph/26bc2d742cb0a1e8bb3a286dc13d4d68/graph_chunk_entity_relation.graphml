  <graph edgedefault="undirected">
    <node id="&quot;BERTRAND RUSSELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bertrand Russell is a British philosopher known for his essay 'Why I Am Not a Christian', critiquing Christianity."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;BATTERSEA TOWN HALL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Battersea Town Hall is the venue where Bertrand Russell gave his talk on 'Why I Am Not a Christian'."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;SOUTH LONDON BRANCH OF THE NATIONAL SECULAR SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The South London Branch of the National Secular Society sponsored the talk given by Bertrand Russell."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;SIMON &amp; SCHUSTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Simon &amp; Schuster is an ebook fulfillment partner mentioned in the context of offering free ebooks."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;IBN WARRAQ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ibn Warraq is the author of 'Why I Am Not a Muslim', a critique of Islam and the Qur'an."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;PROMETHEUS BOOKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prometheus Books is the publisher of 'Why I Am Not a Muslim' by Ibn Warraq."&lt;SEP&gt;"Prometheus Books published 'Why I Am Not a Muslim' by Ibn Warraq."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;SALMAN RUSHDIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Salman Rushdie is a person whose fatwa and death threats motivated Ibn Warraq to write 'Why I Am Not a Muslim' under a pseudonym."&lt;SEP&gt;"Salman Rushdie is mentioned in the context of the fatwa and death threats, which motivated Ibn Warraq to write 'Why I Am Not a Muslim' under a pseudonym."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;BERTRAND RUSSELL'S ESSAY, 'WHY I AM NOT A CHRISTIAN'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bertrand Russell's essay, 'Why I Am Not a Christian', is referenced as an inspiration for 'Why I Am Not a Muslim' by Ibn Warraq."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;BHAGAT SINGH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bhagat Singh is an Indian revolutionary and atheist who wrote 'Why I Am an Atheist' while in jail."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;HINDUSTAN SOCIALIST REPUBLICAN ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hindustan Socialist Republican Association is the revolutionary party Bhagat Singh was a member of."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;KIRTI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kirti is the publication Bhagat Singh wrote articles for, including those on anarchism and communism."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;LAHORE CENTRAL JAIL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lahore Central Jail is the location where Bhagat Singh wrote 'Why I Am an Atheist' while awaiting execution."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;INDIAN FREEDOM STRUGGLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Indian freedom struggle is the context in which Bhagat Singh was involved as a revolutionary."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;WHY I AM NOT A CHRISTIAN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Why I Am Not a Christian is an essay by Bertrand Russell, originally a talk given at Battersea Town Hall on 6 March 1927."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;ESSAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The essay 'Why I Am Not a Christian' is a philosophical piece critiquing Christianity."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;6 MARCH 1927&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The date when Bertrand Russell gave his talk on 'Why I Am Not a Christian' at Battersea Town Hall."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;NATIONAL SECULAR SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Secular Society is the organization that sponsored the talk given by Bertrand Russell."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;FREE EBOOK OFFER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Free ebook offer is an event where Simon &amp; Schuster provides free ebooks to new US subscribers."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;NEW US SUBSCRIBERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"New US subscribers are the target audience for the free ebook offer provided by Simon &amp; Schuster."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;EBOOK FULFILLMENT PARTNER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ebook fulfillment partner is an organization that helps distribute ebooks, mentioned in the context of Simon &amp; Schuster."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;WHY I AM NOT A MUSLIM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Why I Am Not a Muslim is a book by Ibn Warraq, a critique of Islam and the Qur'an."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;1995&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The year 'Why I Am Not a Muslim' by Ibn Warraq was first published."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;FATWA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fatwa is an event where Ibn Warraq was outraged over the fatwa and death threats against Salman Rushdie, which motivated him to write 'Why I Am Not a Muslim' under a pseudonym."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;DEATH THREATS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Death threats are an event where Ibn Warraq was threatened due to Salman Rushdie's fatwa, motivating him to write 'Why I Am Not a Muslim' under a pseudonym."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;WHY I AM AN ATHEIST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Why I Am an Atheist is an essay by Bhagat Singh, written in 1930 while he was in Lahore Central Jail."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;ANARCHISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Anarchism is a concept Bhagat Singh believed in and wrote about in his articles for 'Kirti'."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;COMMUNISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Communism is a concept Bhagat Singh believed in and wrote about in his articles for 'Kirti'."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;8 APRIL 1930&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The date when Bhagat Singh was arrested, which led to his writing 'Why I Am an Atheist'."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;GOD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"god represents a belief system and a higher power that some people rely on for moral guidance and values."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;HUMAN VALUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"human values refer to ethical principles and moral standards that guide human behavior and interactions."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;RELIGION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"religion encompasses belief systems, practices, and values that provide spiritual guidance and moral codes."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;RIGHTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"rights refer to legal entitlements and freedoms that individuals are entitled to."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;COUNTRY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"country refers to a nation or territory with defined borders and governance structures."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;GLOBALLY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"globally refers to a worldwide context or perspective."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;MAJOR RELIGIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"major religions include large religious traditions such as Christianity, Islam, and others that provide moral and ethical frameworks."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;BABY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"baby metaphorically refers to important values or principles that should not be discarded."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;BATH WATER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"bath water metaphorically refers to negative aspects or beliefs that should be discarded."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;TALK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"talk refers to discussions or discourse about various topics."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;RIGHTS AND VALUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"rights and values represent the focus of discussion in the text, contrasting the two approaches."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;LOOKING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"looking refers to the act of examining or considering something carefully."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
    <node id="&quot;MAJOR RELIGIONS TEACHINGS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"major religions teachings provide ethical and moral guidance."</data>
      <data key="d2">ramdocs-0304-a312981cac28</data>
    </node>
