    </node>
    <node id="&quot;ROBERT HUTCHINSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Hutchinson is a person who had a political career in Canada and later in Australia."&lt;SEP&gt;"Robert Hutchinson is a person who held multiple political positions including being the first mayor of Charlottetown."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;CHARLOTTETOWN&quot;">
