    </node>
    <node id="&quot;ARTHUR 'CLEM' HAWKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arthur 'Clem' Hawke is the father of Bob Hawke, a prominent Australian Prime Minister."</data>
