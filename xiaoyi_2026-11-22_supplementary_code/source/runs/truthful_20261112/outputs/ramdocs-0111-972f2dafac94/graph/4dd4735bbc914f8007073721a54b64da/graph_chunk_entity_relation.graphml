  <graph edgedefault="undirected">
    <node id="&quot;ANN GRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ann Gray is mentioned as having a relationship with someone who had children with her."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;GERALDTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Geraldton is a place where someone returned with their family and held various political positions."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;HUTCHINSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hutchinson is a person who held multiple political positions including being elected to the Geraldton Town Council, Justice of the Peace, Mayor, and Member of Parliament."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;RICHARD ROBSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Robson is a person whose resignation led to Hutchinson's election to the Western Australian Legislative Assembly."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;WESTERN AUSTRALIAN LEGISLATIVE ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Western Australian Legislative Assembly is the body where Hutchinson was elected after a by-election."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;SIR JOHN FORREST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir John Forrest is the Premier of Western Australia against whom Hutchinson was in opposition."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;ALP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ALP is the political party that Hutchinson served in the South Australian House of Assembly and Australian House of Representatives."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;ABERDEEN, SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Aberdeen, Scotland is the birthplace of someone who later migrated to South Australia."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;SOUTH AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Australia is the place where someone migrated to and began their political career."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;JOHN MCPHERSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John McPherson is a person who migrated to South Australia with the subject and found work on the South Australian Register."</data>
      <data key="d2">ramdocs-0111-972f2dafac94</data>
    </node>
    <node id="&quot;DAILY FREE PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Daily Free Press is the newspaper where someone was apprenticed as a compositor."</data>
