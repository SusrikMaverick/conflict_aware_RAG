  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ROBERT HENRY MURRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Henry Murray is a renowned Anglican priest and historian, honored with membership in the Royal Irish Academy for his contributions to Irish history and culture."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;ROYAL IRISH ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Irish Academy is Ireland's premier academy of sciences, dedicated to promoting excellence in research and scholarship, founded in 1785."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;ALEXANDER GRAHAM BELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexander Graham Bell is a historical figure known for his pioneering work in telecommunications, whose portrait is displayed in the National Academy of Sciences."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;NATIONAL ACADEMY OF SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Academy of Sciences is an institution where esteemed scientists and thinkers gather, such as Dr. Sophia Patel and Reverend Robert Henry Murray."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a renowned astrophysicist and fellow member of the National Academy of Sciences, known for her work on climate change."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;EMILY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily Wilson is a young researcher at the National Academy of Sciences, seeking input on a new data set."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;ATHENA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Athena is the Greek goddess symbolizing the pursuit of wisdom and knowledge, emblazoned on the Academy's emblem."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;REVEREND&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Reverend is a religious title held by Robert Henry Murray, indicating his position as an Anglican priest."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;HISTORIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Historian is a professional title held by Robert Henry Murray, indicating his expertise in the field of history."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;PRESTIGIOUS ROYAL IRISH ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Prestigious Royal Irish Academy is another name for the Royal Irish Academy, emphasizing its esteemed status."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;MEMBERSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Membership is the act of joining the Royal Irish Academy, which Reverend Robert Henry Murray has been honored with."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;MEMBERSHIP IN THE ROYAL IRISH ACADEMY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Membership in the Royal Irish Academy is a rare and prestigious honor, reserved for individuals who have demonstrated exceptional achievement in their respective fields."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;OUTSTANDING CONTRIBUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Outstanding Contributions refer to the exceptional achievements that led to Reverend Robert Henry Murray's membership in the Royal Irish Academy."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;COMMITMENT TO PROMOTING ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment to Promoting Academic Excellence is a concept that describes Reverend Robert Henry Murray's dedication to advancing scholarship and research."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;IRISH HISTORY AND CULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Irish History and Culture is the subject area in which Reverend Robert Henry Murray has made significant contributions."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;MEDIEVAL IRELAND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medieval Ireland is a specific period in Irish history that Reverend Robert Henry Murray has written about."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;STRUGGLE FOR INDEPENDENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Struggle for Independence is a topic in Irish history that Reverend Robert Henry Murray has explored in his writings."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a concept that Reverend Robert Henry Murray has promoted through his work and research."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Climate Change is the topic of the symposium where Reverend Robert Henry Murray is attending."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;SYMPOSIUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Symposium is a gathering of experts to discuss and present research on a specific topic, in this case, climate change."&lt;SEP&gt;"The Symposium is a gathering of scholars where presentations are given and discussions take place, fostering collaboration and discovery."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;TELECOMMUNICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Telecommunications is the field of study and practice that Alexander Graham Bell pioneered."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;PIONEERING WORK&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pioneering Work is the term used to describe Alexander Graham Bell's groundbreaking contributions to telecommunications."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;BRILLIANT MINDS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Brilliant Minds refers to the group of scientists and thinkers gathered at the National Academy of Sciences."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;FAITH AND SCIENCE COEXISTENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith and Science Coexistence is the theme that Reverend Robert Henry Murray values in the National Academy of Sciences."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;GREEK GODDESS ATHENA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Greek Goddess Athena is the symbol of wisdom and knowledge emblazoned on the Academy's emblem."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;PURSUIT OF WISDOM AND KNOWLEDGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pursuit of Wisdom and Knowledge is the mission of the National Academy of Sciences, symbolized by Athena."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;COLLABORATION AND DISCOVERY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration and Discovery is the overarching theme of the National Academy of Sciences, where faith and science meet."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;HISTORICAL RESEARCH&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Historical Research is a field of study that shapes Murray's unique perspective and is valued within the Community of Scholars."&lt;SEP&gt;"Historical Research is the activity that Reverend Robert Henry Murray engages in as a historian."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;SPIRITUAL GUIDANCE&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Spiritual Guidance is a field of study that shapes Murray's unique perspective and is valued within the Community of Scholars."&lt;SEP&gt;"Spiritual Guidance is the activity that Reverend Robert Henry Murray provides as an Anglican priest."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;ENGAGING WRITING STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Engaging Writing Style is the characteristic of Reverend Robert Henry Murray's writing that makes him a leading authority in his field."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;METICULOUS RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Meticulous Research is the approach that Reverend Robert Henry Murray uses in his historical studies."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;SYMPOSIUM ON CLIMATE CHANGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Symposium on Climate Change is the specific event where Reverend Robert Henry Murray is attending."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;PRESENTATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Presentations are given during the Symposium, contributing to the collaborative and discovery-oriented atmosphere."&lt;SEP&gt;"Presentations are the formal talks given during the symposium on climate change."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;MURRAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Murray is a scholar attending a symposium, known for his unique perspective shaped by historical research and spiritual guidance."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;COMMUNITY OF SCHOLARS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Community of Scholars is a group of academics where faith and science coexist harmoniously, valuing diverse perspectives."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration is a key aspect of the Symposium and the Community of Scholars, fostering joint efforts and insights."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;DISCOVERY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Discovery is a key goal of the Symposium and the Community of Scholars, driving the pursuit of new knowledge."</data>
      <data key="d2">cb-0282</data>
    </node>
    <node id="&quot;FAITH AND SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith and Science coexist harmoniously within the Community of Scholars, representing a unique blend of perspectives."</data>
      <data key="d2">cb-0282</data>
    </node>
