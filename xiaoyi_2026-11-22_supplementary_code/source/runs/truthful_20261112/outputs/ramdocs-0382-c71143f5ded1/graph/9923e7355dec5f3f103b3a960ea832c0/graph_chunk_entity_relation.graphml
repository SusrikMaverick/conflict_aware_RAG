  <graph edgedefault="undirected">
    <node id="&quot;BANDAR INDERA MAHKOTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bandar Indera Mahkota is a township in Kuantan, Pahang, Malaysia, known for its development and accessibility."&lt;SEP&gt;"Bandar Indera Mahkota is a township in Sydney, Australia, known for its development and accessibility."</data>
      <data key="d2">ramdocs-0382-c71143f5ded1</data>
    </node>
    <node id="&quot;KUANTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kuantan is a town in Pahang, Malaysia, mentioned as the reference point for the location of Bandar Indera Mahkota."</data>
      <data key="d2">ramdocs-0382-c71143f5ded1</data>
    </node>
    <node id="&quot;PAHANG&quot;">
