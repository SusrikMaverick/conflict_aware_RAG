<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PETER REGINATO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Reginato is a renowned American artist who has made New York City his home and muse, known for his unique blend of abstract expressionism and pop art, and his deep connection with the city's art scene."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the most populous city in the United States, a hotbed of artistic expression in the 1970s, and the home and muse of Peter Reginato."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;ANDY WARHOL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andy Warhol was a prominent figure in the New York City art scene during the 1970s, known for his contributions to contemporary art."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;JEAN-MICHEL BASQUIAT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean-Michel Basquiat was a prominent figure in the New York City art scene during the 1970s, known for his contributions to contemporary art."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;KEITH HARING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Keith Haring was a prominent figure in the New York City art scene during the 1970s, known for his contributions to contemporary art."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;MANHATTAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Manhattan is the borough of New York City where Peter Reginato's studio is located, serving as a hub for creatives and a center for the city's art world."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;GRONINGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Groningen is the capital city of the Netherlands' northernmost province, where Peter Reginato has a studio and lives, known for its medieval architecture and vibrant cultural heritage."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;ATELIER REGINATO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Atelier Reginato is a small, unassuming studio in Groningen where Peter Reginato creates his artwork, known for its warm, creative atmosphere and the presence of local art student Sophia."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;SOPHIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophia is a local art student who models for Peter Reginato's figure drawings and often visits his studio in Groningen."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;STADSSCHOUWBURG THEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stadsschouwburg theater is a venue in Groningen known for lively performances, mentioned as part of the city's rich cultural heritage."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;GRONINGER MUSEUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Groninger Museum is a cultural institution in Groningen known for cutting-edge exhibitions, part of the city's rich cultural heritage."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;CITYSCAPE (1985)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cityscape (1985) is one of Peter Reginato's most iconic works, a large-scale painting that captures the essence of New York City, reflecting his deep connection with the city."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;URBAN BLOOM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Urban Bloom is a large-scale public installation created by Peter Reginato in 2010, located in Brooklyn's Prospect Park."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;STEEL SKYSCRAPERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Steel Skyscrapers are a defining feature of New York City, piercing the sky and providing a backdrop for Peter Reginato's inspiration."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;HONKING HORNS AND CHATTER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Honking Horns and Chatter are the sounds that fill the air in New York City, contributing to its frenetic energy and inspiring Peter Reginato."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;ART SCENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Art Scene in New York City is vibrant and diverse, with many influential artists like Andy Warhol, Jean-Michel Basquiat, and Keith Haring pushing the boundaries of contemporary art."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;ABSTRACT EXPRESSIONISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Abstract Expressionism is a style of art that Peter Reginato incorporates into his work, characterized by bold colors and geometric shapes."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;POP ART&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pop Art is another style of art that Peter Reginato incorporates into his work, blending elements of popular culture with fine art techniques."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;FRENETIC ENERGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Frenetic Energy is a characteristic of New York City, reflected in the city's rapid pace and constant reinvention, which inspires Peter Reginato's art."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;COLLABORATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaborations are a key aspect of Peter Reginato's work, facilitated by his studio in Manhattan, where ideas are exchanged and new projects are born."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;INTERNATIONAL RECOGNITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International Recognition is a result of Peter Reginato's growing reputation as a master of contemporary art, with his works showcased in prominent galleries and museums."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;BROOKLYN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn is a borough of New York City where Peter Reginato's public installation 'Urban Bloom' is located."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;PROSPECT PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Prospect Park is a park in Brooklyn where Peter Reginato's public installation 'Urban Bloom' is situated."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;CREATIVE GENIUSES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creative Geniuses are individuals who thrive in the vibrant art scene of New York City, such as Peter Reginato and other notable artists like Andy Warhol, Jean-Michel Basquiat, and Keith Haring."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;ART EDUCATION AND ACCESSIBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Art Education and Accessibility are initiatives that Peter Reginato is actively involved in, helping to foster a new generation of artists and ensure the city's vibrant art scene continues to thrive."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;LOCAL SCHOOLS AND COMMUNITY ORGANIZATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Local Schools and Community Organizations are institutions that Peter Reginato collaborates with to promote art education and accessibility."</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;BURG THEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Burg Theater is a venue mentioned at the beginning of the text, possibly indicating the starting point of the narrator's day."&lt;SEP&gt;"Burg Theater is a venue mentioned at the beginning of the text, possibly indicating the starting point of the narrator's day.")</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;REGINATO'S STUDIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Reginato's studio is a place where the narrator finds themselves later in the morning, surrounded by the city's atmosphere."&lt;SEP&gt;"Reginato's studio is a place where the narrator finds themselves later in the morning, surrounded by the city's atmosphere.")</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;THE CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The city is described as vibrant, with sights, sounds, and scents, indicating a lively urban environment."&lt;SEP&gt;"The city is described as vibrant, with sights, sounds, and scents, indicating a lively urban environment.")</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;I&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"I is the narrator of the text, experiencing the transition from Burg Theater to Reginato's studio."&lt;SEP&gt;"I is the narrator of the text, experiencing the transition from Burg Theater to Reginato's studio.")</data>
      <data key="d2">cb-0346</data>
    </node>
    <node id="&quot;MORNING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Morning is the time of day when the narrator begins their activities, transitioning from one location to another."</data>
      <data key="d2">cb-0346</data>
    </node>
    <edge source="&quot;PETER REGINATO&quot;" target="&quot;NEW YORK CITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Peter Reginato has made New York City his home and muse, drawing inspiration from its urban landscape and vibrant art scene."</data>
      <data key="d5">"inspiration, home base"</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;PETER REGINATO&quot;" target="&quot;MANHATTAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Peter Reginato's studio is located in Manhattan, serving as a hub for creatives and a center for the city's art world."</data>
      <data key="d5">"creative hub, studio location"</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;PETER REGINATO&quot;" target="&quot;GRONINGEN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Peter Reginato has a studio and lives in Groningen, a city known for its medieval architecture and vibrant cultural heritage."</data>
      <data key="d5">"residence, studio location"</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;PETER REGINATO&quot;" target="&quot;ATELIER REGINATO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Atelier Reginato is a small, unassuming studio in Groningen where Peter Reginato creates his artwork, known for its warm, creative atmosphere."</data>
      <data key="d5">"workplace, creative space"</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;ATELIER REGINATO&quot;" target="&quot;SOPHIA&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Sophia, a local art student, often visits Atelier Reginato and models for Peter Reginato's figure drawings."</data>
      <data key="d5">"model, studio companion"</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;BURG THEATER&quot;" target="&quot;I&quot;">
      <data key="d3">2.0</data>
      <data key="d4">"The narrator starts their day at Burg Theater and then moves to Reginato's studio, indicating a transition in their day."|&lt;|"transition, location change"</data>
      <data key="d5">6)</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;REGINATO'S STUDIO&quot;" target="&quot;THE CITY&quot;">
      <data key="d3">2.0</data>
      <data key="d4">"Reginato's studio is located within the city, surrounded by its sights, sounds, and scents."|&lt;|"urban setting, integration"</data>
      <data key="d5">7)</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;THE CITY&quot;" target="&quot;I&quot;">
      <data key="d3">2.0</data>
      <data key="d4">"The narrator is surrounded by the city's atmosphere in Reginato's studio, suggesting a strong connection to the urban environment."|&lt;|"environmental immersion, presence"</data>
      <data key="d5">8)</data>
      <data key="d6">cb-0346</data>
    </edge>
    <edge source="&quot;I&quot;" target="&quot;MORNING&quot;">
      <data key="d3">1.0</data>
      <data key="d4">"Morning is the time when the narrator begins their activities, transitioning from one location to another."|&lt;|"time, activity initiation"</data>
      <data key="d5">5)</data>
      <data key="d6">cb-0346</data>
    </edge>
  </graph>
