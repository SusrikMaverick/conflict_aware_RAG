  <graph edgedefault="undirected">
    <node id="&quot;GIRLS' GENERATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Girls' Generation is a South Korean girl group known for their debut album and subsequent tours and promotions."</data>
      <data key="d2">ramdocs-0080-e397ecbbb7cf</data>
    </node>
    <node id="&quot;S.M. ENTERTAINMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"S.M. Entertainment is the record label responsible for releasing Girls' Generation's debut album and managing their career."</data>
      <data key="d2">ramdocs-0080-e397ecbbb7cf</data>
    </node>
    <node id="&quot;OLYMPIC FENCING GYMNASIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Olympic Fencing Gymnasium is the starting venue for the Girls' Generation Asia Tour Into the New World in Seoul, South Korea."</data>
      <data key="d2">ramdocs-0080-e397ecbbb7cf</data>
    </node>
    <node id="&quot;TAIPEI ARENA&quot;">
