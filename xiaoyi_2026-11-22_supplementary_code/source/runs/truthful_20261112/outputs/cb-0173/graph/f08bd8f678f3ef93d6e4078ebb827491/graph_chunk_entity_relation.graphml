    <edge source="&quot;FUNERAL RITES&quot;" target="&quot;GRIEVING PROCESS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Funeral rites are designed to support the grieving process through the use of technology like CSCM."</data>
      <data key="d5">"process enhancement, support"</data>
      <data key="d6">cb-0173</data>
