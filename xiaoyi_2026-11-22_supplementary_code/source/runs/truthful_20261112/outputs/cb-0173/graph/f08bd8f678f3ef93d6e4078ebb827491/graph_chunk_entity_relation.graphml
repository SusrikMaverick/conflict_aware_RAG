<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;STANFORD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stanford University is a leading institution in semiconductor technology research, known for its contributions to the field."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;TECHCORP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TechCorp is a leading semiconductor manufacturer that is interested in exploring the potential of the innovative patent technology."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;DR. JANE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jane Smith is a leading researcher in semiconductor technology at Stanford University, commenting on the potential of the innovative patent."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;JOHN LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Lee is the CEO of TechCorp, expressing interest in the potential of the innovative patent technology."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;US PATENT 11450805&quot;">
      <data key="d0">"PATENT"</data>
      <data key="d1">"US Patent 11450805 is a groundbreaking patent filing that promises to revolutionize semiconductor manufacturing."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;SEMICONDUCTOR INDUSTRY&quot;">
      <data key="d0">"INDUSTRY"</data>
      <data key="d1">"The Semiconductor Industry is the sector that stands to be transformed by the innovative patent technology."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is the institution where the first recorded instance of the phenomenon was observed."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is the lead researcher at the University of California, Berkeley, who observed the unusual electromagnetic readings during a funeral procession."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;MIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MIT is the institution where further research on the funeral-semiconductor connection was conducted."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;DR. JOHN LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Lee is the lead researcher at MIT, conducting studies on the funeral-semiconductor connection."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is the author of a study on the cultural implications of the funeral-semiconductor connection."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;INTERNATIONAL ASSOCIATION OF FUNERAL DIRECTORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The International Association of Funeral Directors has established guidelines for the safe and respectful use of CSCM in funeral rites."&lt;SEP&gt;"The International Association of Funeral Directors has established guidelines for the use of CSCM in funeral rites."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;CSCM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"CSCM (Computerized Somatic Cognitive Mapping) is an innovative technology used in funeral rites to enhance the grieving process."&lt;SEP&gt;"CSCM is the specific compound, semiconductor material, and methods for manufacturing coating and semiconductor using the same, which exhibits unique properties when exposed to funeral ceremonies."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;FUNERAL CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A funeral ceremony is an event where the emotional and energetic resonance can affect the properties of CSCM."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;FUNERAL PROCESSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A funeral procession is an event where the first recorded instance of the phenomenon was observed."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;SMALL TOWN IN RURAL CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A small town in rural California is the location where the first recorded instance of the phenomenon was observed."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;RESEARCHANDMARKETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ResearchAndMarkets is a company that provides reports on the global semiconductor market."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;GLOBAL SEMICONDUCTOR MARKET&quot;">
      <data key="d0">"MARKET"</data>
      <data key="d1">"The global semiconductor market is expected to grow significantly due to the demand for high-performance semiconductors."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;2022&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"2022 is the year when the global semiconductor market was valued at $513.7 billion."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;2027&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"2027 is the year when the global semiconductor market is projected to reach $734.8 billion."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;7.3% CAGR&quot;">
      <data key="d0">"METRIC"</data>
      <data key="d1">"7.3% CAGR is the compound annual growth rate of the global semiconductor market from 2022 to 2027."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;FUNERAL HOMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Funeral homes are institutions that incorporate technology into their services to support the grieving process."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;BEREAVEMENT CENTERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bereavement centers are organizations that provide support to people during the grieving process and may also incorporate technology."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;GUIDELINES&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Guidelines are documents established by the International Association of Funeral Directors to ensure the safe and respectful use of CSCM."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;FUNERAL RITES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Funeral rites are ceremonies or rituals performed at funerals, which may now include the use of CSCM."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;GRIEVING PROCESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The grieving process is the emotional experience of loss, which is supported by the use of CSCM in funeral homes and bereavement centers."</data>
      <data key="d2">cb-0173</data>
    </node>
    <node id="&quot;DECEASED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The deceased refers to the person who has passed away and whose funeral rites are being conducted."</data>
      <data key="d2">cb-0173</data>
    </node>
