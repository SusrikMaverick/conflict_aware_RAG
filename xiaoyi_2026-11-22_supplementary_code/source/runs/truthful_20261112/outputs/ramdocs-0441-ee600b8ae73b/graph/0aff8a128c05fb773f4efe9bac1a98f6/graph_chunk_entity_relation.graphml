  <graph edgedefault="undirected">
    <node id="&quot;THE SWAN PRINCESS (1994)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Swan Princess (1994) is a direct-to-video film in the series, receiving mixed reviews and featuring a theme song 'Far Longer than Forever'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;THE SWAN PRINCESS: ESCAPE FROM CASTLE MOUNTAIN (1997)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Swan Princess: Escape from Castle Mountain (1997) is a direct-to-video sequel to the animated film 'The Swan Princess'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;REGINA BELLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Regina Belle is a performer who sang the theme song 'Far Longer than Forever' for 'The Swan Princess'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;JEFFREY OSBORNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeffrey Osborne is a performer who sang the theme song 'Far Longer than Forever' for 'The Swan Princess'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;ROTHBART&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Rothbart is an evil sorcerer in the story, planning to take King William's kingdom using dark magic."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;KING WILLIAM&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"King William is a character in the story, ruling over a kingdom and sparing Rothbart's life after his arrest."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;TAFFY THOMAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Taffy Thomas is a Welsh jockey who rode a horse named 'Swan Princess' in various races."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;WILLIAM HILL SPRINT CHAMPIONSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"William Hill Sprint Championship is a horse racing event where 'Swan Princess' participated and finished sixth."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;SHARPO&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Sharpo is a character in the horse racing event, finishing ahead of 'Swan Princess'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;DERMOT WELD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dermot Weld is associated with the stable of the favorite horse 'Band Practice' in the horse racing event."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;SWAN PRINCESS (FILM SERIES)&quot;">
      <data key="d0">"SERIES"</data>
      <data key="d1">"Swan Princess is a film series including 'The Swan Princess (1994)' and 'The Swan Princess: Escape from Castle Mountain (1997)', featuring a theme song 'Far Longer than Forever'."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;SEVEN DIRECT-TO-VIDEO SEQUELS&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Seven direct-to-video sequels are part of the 'The Swan Princess' film series, following the original 1994 film."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;GOLDEN GLOBE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Golden Globe is an award for which 'Far Longer than Forever' was nominated for Best Original Song."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;DARK MAGIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dark magic, specifically The Forbidden Arts, is a concept used by the evil sorcerer Rothbart in the story."</data>
      <data key="d2">ramdocs-0441-ee600b8ae73b</data>
    </node>
    <node id="&quot;KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
