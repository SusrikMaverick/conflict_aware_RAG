<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;EARLE HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Earle House is a house in Canehill, Arkansas, built in 1859 to house Dr. Fountain R. Earle, the president of Cane Hill College. It was added to the National Register of Historic Places in 1982."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;JOHN M. EARLE HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"John M. Earle House is a historic house and does not represent an organization."&lt;SEP&gt;"John M. Earle House is a historic house located in Fall River, Massachusetts, United States, and was constructed in 1870."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;EARLE TOWN HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Earle Town House is a historic house and does not represent an organization."&lt;SEP&gt;"Earle Town House is a historic house located in Greenville, South Carolina, and was constructed between 1829-1833."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;FALL RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fall River is a city in Massachusetts, United States, where the John M. Earle House is located."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Massachusetts is a state in the United States where the John M. Earle House is located."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United States is a country where both the John M. Earle House and Earle Town House are located."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;GREENVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Greenville is a city in South Carolina where the Earle Town House is located."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;SOUTH CAROLINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Carolina is a state in the United States where the Earle Town House is located."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;COL. ELIAS EARLE HISTORIC DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Col. Elias Earle Historic District includes the Earle Town House in Greenville, South Carolina."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;CONGRESSMAN ELIAS T. EARLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Congressman Elias T. Earle is a historical figure whose property was believed to have been the site of the Earle Town House until the end of the 20th century."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;ELIAS DRAYTON EARLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elias Drayton Earle is the half-nephew of Elias T. Earle and acquired the land where the Earle Town House was built."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;SAMUEL GREEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Samuel Green is a historical figure who is believed to have built the Earle Town House around 1829-1833."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is the official list of the United States' historic places worthy of preservation."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;MACRIS ID FLR.1526&quot;">
      <data key="d0">"IDENTIFIER"</data>
      <data key="d1">"MACRIS ID FLR.1526 is the unique identifier for the John M. Earle House in the Massachusetts Cultural Resource Information System."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;1870&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1870 is the year the John M. Earle House was constructed."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;1829-1833&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1829-1833 is the estimated construction period for the Earle Town House."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;AUGUST 5, 1969&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 5, 1969 is the date the Earle Town House was listed in the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;C. 1829-1833&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"c. 1829-1833 is the approximate construction period for the Earle Town House."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;1834&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1834 is the latest possible year the Earle Town House could have been built."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;HALF NEPHEW&quot;">
      <data key="d0">"RELATION"</data>
      <data key="d1">"Half nephew is the relationship between Elias Drayton Earle and Elias T. Earle."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;LAND ACQUISITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Land acquisition is the event where Elias Drayton Earle acquired the land for the Earle Town House."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;MESSAGE FROM THE HEAVENS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Message from the heavens is a metaphorical reference to the historical significance of the Earle Town House and the John M. Earle House."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <node id="&quot;CRYPTIC DIALOGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cryptic dialogue is the ongoing communication or exchange of information related to the Earle Town Houses."</data>
      <data key="d2">ramdocs-0314-0fe8a57d70d6</data>
    </node>
    <edge source="&quot;JOHN M. EARLE HOUSE&quot;" target="&quot;FALL RIVER&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The John M. Earle House is located in Fall River, Massachusetts, United States."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;JOHN M. EARLE HOUSE&quot;" target="&quot;MASSACHUSETTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The John M. Earle House is located in Massachusetts, United States."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;EARLE TOWN HOUSE&quot;" target="&quot;GREENVILLE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Earle Town House is located in Greenville, South Carolina, and is part of the Col. Elias Earle Historic District."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;EARLE TOWN HOUSE&quot;" target="&quot;SOUTH CAROLINA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Earle Town House is located in South Carolina, United States, and is part of the Col. Elias Earle Historic District."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;EARLE TOWN HOUSE&quot;" target="&quot;COL. ELIAS EARLE HISTORIC DISTRICT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Earle Town House is included in the Col. Elias Earle Historic District in Greenville, South Carolina."</data>
      <data key="d5">"historical context, district inclusion"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;EARLE TOWN HOUSE&quot;" target="&quot;CONGRESSMAN ELIAS T. EARLE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Earle Town House was believed to have been built for Congressman Elias T. Earle until the end of the 20th century, though he never owned the property."</data>
      <data key="d5">"historical belief, ownership claim"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
    <edge source="&quot;EARLE TOWN HOUSE&quot;" target="&quot;ELIAS DRAYTON EARLE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Elias Drayton Earle acquired the land where the Earle Town House was built, likely after it was constructed around 1829-1833."</data>
      <data key="d5">"ownership transfer, construction timeline"</data>
      <data key="d6">ramdocs-0314-0fe8a57d70d6</data>
    </edge>
  </graph>
