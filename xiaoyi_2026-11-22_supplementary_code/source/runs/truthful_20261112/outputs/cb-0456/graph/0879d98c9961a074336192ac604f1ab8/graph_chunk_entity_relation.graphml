  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MANSAKU NOMURA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mansaku Nomura is a renowned Japanese artist known for his contributions to traditional Japanese art, honored with the 'Person of Cultural Merit' award."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;TOKYO NATIONAL MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tokyo National Museum is a renowned institution where Dr. Yumi Nakamura, a renowned art historian and curator, works."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;DR. YUMI NAKAMURA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Yumi Nakamura is a renowned art historian and curator at the Tokyo National Museum, praising Mansaku Nomura's work."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;IMPERIAL PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Imperial Palace is the venue where the 'Person of Cultural Merit' award ceremony took place."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;MINISTRY OF EDUCATION, CULTURE, SPORTS, SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ministry of Education, Culture, Sports, Science and Technology provides information about Nomura's contributions to Japanese culture."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;JAPANESE AGENCY FOR CULTURAL AFFAIRS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Japanese Agency for Cultural Affairs reports on Nomura's global exhibitions and cultural impact."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;ORDER OF THE RED BANNER&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Order of the Red Banner is a prestigious Soviet award for heroism in combat or long service in the armed forces, received by Mansaku Nomura."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SOVIET FORCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mansaku Nomura served as a volunteer in the Soviet forces during the Second World War."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;RED ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Mansaku Nomura fought alongside the Red Army during the Second World War."&lt;SEP&gt;"The Red Army is the military branch of the Soviet Union where Mansaku Nomura fought during the Second World War."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;STALINGRAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stalingrad is a city in Russia where Mansaku Nomura witnessed the horrors of the Second World War."&lt;SEP&gt;"Stalingrad is a city where Mansaku Nomura witnessed the horrors of the Second World War."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;LENINGRAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leningrad is a city in Russia where Mansaku Nomura witnessed the horrors of the Second World War."&lt;SEP&gt;"Leningrad is a city where Mansaku Nomura witnessed the horrors of the Second World War."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;MOSCOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Moscow is a city in Russia where Mansaku Nomura painted a sunrise scene."&lt;SEP&gt;"Moscow is mentioned as the location where the sunrise is observed, adding a specific context to the scene."&lt;SEP&gt;"Moscow is the setting for Mansaku Nomura's latest painting, a sunrise scene."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;AKIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Akira is a dear friend of Mansaku Nomura, admiring his artwork and discussing the Soviet spirit."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is the capital city of Japan where many events and places are mentioned, such as the Imperial Palace and Mansaku Nomura's studio."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SECOND WORLD WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Second World War is a significant historical event that Mansaku Nomura experienced and fought in."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SOVIET UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Soviet Union is the country where Mansaku Nomura served in the Soviet forces and received the Order of the Red Banner."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is mentioned as one of the countries where Mansaku Nomura's work has been exhibited."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"France is mentioned as one of the countries where Mansaku Nomura's work has been exhibited."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;CHINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"China is mentioned as one of the countries where Mansaku Nomura's work has been exhibited."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;TURPENTINE&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"Turpentine is a material used in Mansaku Nomura's studio, giving the air a familiar comfort."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;LINSEED OIL&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"Linseed Oil is a material used in Mansaku Nomura's studio, giving the air a familiar comfort."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;WAR AND LOSS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"War and Loss are themes reflected in Mansaku Nomura's artwork, capturing the essence of the Soviet spirit."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;LOVE AND REDEMPTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Love and Redemption are themes reflected in Mansaku Nomura's artwork, capturing the essence of the Soviet spirit."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;RED BANNER&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Red Banner is a term referring to the Order of the Red Banner, a prestigious Soviet award."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;HEROISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Heroism is a concept associated with the Order of the Red Banner, reflecting Mansaku Nomura's bravery and sacrifice."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;LONG SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Long Service is a concept associated with the Order of the Red Banner, reflecting Mansaku Nomura's dedication to the armed forces."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;VOLUNTEER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Volunteer is a role Mansaku Nomura played in the Soviet forces during the Second World War."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;RED ARMY UNIFORM&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Red Army Uniform is the type of uniform Mansaku Nomura wore when he served in the Red Army."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SOVIET COMMANDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Soviet Commander is the person who pinned the Order of the Red Banner to Mansaku Nomura's chest during the award ceremony."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;VELVET CLOTH&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"Velvet Cloth is a material used to wrap the Order of the Red Banner inside the small box on Mansaku Nomura's workbench."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"He is praising the paintings and commenting on the artist's ability to capture the Soviet spirit."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;MANSAKU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mansaku is the artist who creates paintings capturing the Soviet spirit, and he acknowledges seeing beauty amidst chaos."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SOVIET SPIRIT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Soviet spirit refers to the cultural and emotional essence of the Soviet era, captured in the paintings."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;SUNRISE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Moscow sunrise is observed, providing a beautiful natural setting."</data>
      <data key="d2">cb-0456</data>
    </node>
    <node id="&quot;CHAOS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Chaos is mentioned as a contrasting element to the beauty Mansaku sees, highlighting the complexity of his observations."</data>
      <data key="d2">cb-0456</data>
    </node>
