  <graph edgedefault="undirected">
    <node id="&quot;SAN VICENTE FERRER CHURCH (DUPAX DEL SUR)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Vicente Ferrer Church (Dupax del Sur) is an 18th-century Baroque church located in Dupax del Sur, Nueva Vizcaya, Philippines, and is a National Cultural Treasure."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;SAN VICENTE FERRER PARISH CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"San Vicente Ferrer Parish Church is a parish church dedicated to Saint Vincent Ferrer and under the jurisdiction of the Roman Catholic Diocese of Bayombong."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;NATIONAL MUSEUM OF THE PHILIPPINES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Museum of the Philippines declared the church complex a National Cultural Treasure in July 2001."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC DIOCESE OF BAYOMBONG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Diocese of Bayombong oversees the San Vicente Ferrer Parish Church."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;DUPAX DEL SUR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dupax del Sur is a barangay in Dupax del Sur, Nueva Vizcaya, Philippines, where the church is located."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;BAYOMBONG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bayombong is the city where the Diocese of Bayombong is located."&lt;SEP&gt;"Bayombong is the diocese overseeing the San Vicente Ferrer Parish Church."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;FATHER MANUEL CORRIPIO, OP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Father Manuel Corripio, OP is mentioned as the architect of the church."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;MOST REV. RICARDO L. BACCAY, D.D.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Most Rev. Ricardo L. Baccay, D.D. is the Archbishop of the Archdiocese Tuguegarao."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;MOST REV. JOSE ELMER I. MANGALINAO, D.D.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Most Rev. Jose Elmer I. Mangalinao, D.D. is a bishop of the Diocese Bayombong."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;MODERNIST&quot;">
      <data key="d0">"ARCHITECTURE STYLE"</data>
      <data key="d1">"The church has a unique Modernist design, which is distinct from the traditional architectural styles of the region."&lt;SEP&gt;"The church has a unique Modernist design."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
    <node id="&quot;DUPAX DEL NORTE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dupax del Norte is a nearby attraction to the San Vicente Ferrer Church."</data>
      <data key="d2">ramdocs-0073-9c6f98fa3f7d</data>
    </node>
