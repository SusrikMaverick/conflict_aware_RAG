  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NEW LINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Line is a film production company working on the Shazam! movie."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;VARIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Variety is a media company reporting on the casting of the Shazam! movie."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;ANDI MACK&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Andi Mack is a TV series mentioned in the context of the Shazam! movie casting."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;GAL GADOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gal Gadot is an actress who was initially reported to be cast in the Shazam! movie."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;ASHER ANGEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Asher Angel is an actor who was later cast in the Shazam! movie."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;BILLY&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Billy is a character in the Shazam! movie, played by either Gal Gadot or Asher Angel."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;FAWCETT COMICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fawcett Comics is the original publisher of the Shazam! comic book series."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;SHAZAM!&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Shazam! is the title of the movie and the comic book series, centered around the character Billy Batson."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;BILLY BATSON&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Billy Batson is the main character in the Shazam! comic book series, who transforms by saying 'Shazam!'"</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;NOVEMBER 6, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 6, 2017 is the date when the news about the casting of the Shazam! movie was reported."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;2017&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2017 is the year when the news about the casting of the Shazam! movie was reported."</data>
      <data key="d2">rgb-0065</data>
    </node>
    <node id="&quot;FAWCETT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fawcett is part of Fawcett Comics, the original publisher of the Shazam! comic book series."</data>
      <data key="d2">rgb-0065</data>
    </node>
