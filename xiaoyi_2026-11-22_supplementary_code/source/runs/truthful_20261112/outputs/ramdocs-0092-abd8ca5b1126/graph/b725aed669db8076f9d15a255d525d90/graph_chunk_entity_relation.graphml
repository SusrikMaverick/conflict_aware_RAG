      <data key="d5">"native habitat"</data>
      <data key="d6">ramdocs-0092-abd8ca5b1126</data>
    </edge>
    <edge source="&quot;BANKSIA LEMANNIANA&quot;" target="&quot;FITZGERALD RIVER NATIONAL PARK&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Banksia lemanniana can be found within and just east of the Fitzgerald River National Park."</data>
      <data key="d5">"habitat"</data>
      <data key="d6">ramdocs-0092-abd8ca5b1126</data>
    </edge>
    <edge source="&quot;BANKSIA LEMANNIANA&quot;" target="&quot;BUSHFIRE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Banksia lemanniana is killed by bushfire but regenerates from seed."</data>
      <data key="d5">"regeneration mechanism"</data>
      <data key="d6">ramdocs-0092-abd8ca5b1126</data>
    </edge>
