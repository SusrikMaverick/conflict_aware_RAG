<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FARO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Faro is a picturesque coastal town in Portugal where Irving Kaplansky arrived to pursue his graduate studies in the early 1940s."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;UNIVERSITY OF ALGARVE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Algarve is a public university in Faro, Portugal, where Irving Kaplansky pursued his graduate studies and met his classmates."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;PORTUGAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portugal is the country where the University of Algarve is located, and where Irving Kaplansky conducted his studies."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;IRVING KAPLANSKY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Irving Kaplansky is a young Canadian mathematician in his early twenties who arrives in Faro to pursue his graduate studies."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;SOFIA RODRIGUES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sofia Rodrigues is a bright and ambitious mathematics student from Lisbon who becomes Irving Kaplansky's classmate and collaborator."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;UNIVERSITY OF TORONTO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Toronto is a public research university in Toronto, Ontario, Canada, where Irving Kaplansky received his Bachelor's degree in mathematics in 1938."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;TORONTO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Toronto is the city in Ontario, Canada, where Irving Kaplansky received his early education and attended the University of Toronto."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard University is a prestigious private research university where Irving Kaplansky earned his Ph.D. in mathematics in 1941."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;UNIVERSITY OF CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Chicago is an academic institution where Irving Kaplansky held an academic position after completing his Ph.D."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;ABSTRACT ALGEBRA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Abstract Algebra is a branch of mathematics that Irving Kaplansky and his classmates discuss in the café."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;GROUP THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Group Theory is a specific area within Abstract Algebra that Irving Kaplansky and Sofia Rodrigues attempt to solve."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;NUMBER THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Number Theory is a shared passion between Irving Kaplansky and Sofia Rodrigues, bonding them during orientation."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;FRACTALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fractals are discussed by Irving Kaplansky and his new friends, showcasing the breadth of mathematical topics explored at the University of Algarve."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;CRYPTOGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cryptography is another topic of discussion among Irving Kaplansky and his peers, highlighting the interdisciplinary nature of their conversations."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;AZULEJO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Azulejo tiles are decorative elements adorning the buildings of the University of Algarve, adding to its Moorish-inspired architecture."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;MOORISH ARCHITECTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Moorish architecture is the style of the university's buildings, characterized by whitewashed walls and vibrant azulejo tiles."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;HISTORIC STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Historic streets of Faro are the setting where Irving Kaplansky walks and reflects on his academic journey."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;CAFÉ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A nearby café is the location where Irving Kaplansky and Sofia Rodrigues engage in a heated debate about the latest developments in abstract algebra."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;ORIENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Orientation is the event where Irving Kaplansky and Sofia Rodrigues meet and bond over their shared passion for number theory."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;MATHEMATICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mathematics is the field of study that Irving Kaplansky and his classmates are passionate about, driving their academic pursuits."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;CANADIAN MATHEMATICIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Canadian Mathematician is a role that Irving Kaplansky embodies, known for his significant contributions to various fields of mathematics."</data>
      <data key="d2">cb-0345</data>
    </node>
    <node id="&quot;EARLY 1940S&quot;">
      <data key="d0">"TIME"</data>
      <data key="d1">"The early 1940s is the time period when Irving Kaplansky arrives in Faro to pursue his graduate studies."</data>
      <data key="d2">cb-0345</data>
    </node>
    <edge source="&quot;UNIVERSITY OF ALGARVE&quot;" target="&quot;IRVING KAPLANSKY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Irving Kaplansky arrives at the University of Algarve to pursue his graduate studies, meeting his classmate Sofia Rodrigues."</data>
      <data key="d5">"academic pursuit, friendship formation"</data>
      <data key="d6">cb-0345</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF ALGARVE&quot;" target="&quot;SOFIA RODRIGUES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Sofia Rodrigues is a student at the University of Algarve, where she meets Irving Kaplansky and engages in discussions about mathematics."</data>
      <data key="d5">"student life, academic engagement"</data>
      <data key="d6">cb-0345</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF ALGARVE&quot;" target="&quot;ABSTRACT ALGEBRA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The University of Algarve is a hub for discussions on Abstract Algebra, as evidenced by Irving Kaplansky and Sofia's conversation in the café."</data>
      <data key="d5">"academic focus, intellectual community"</data>
      <data key="d6">cb-0345</data>
    </edge>
    <edge source="&quot;IRVING KAPLANSKY&quot;" target="&quot;SOFIA RODRIGUES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Irving Kaplansky and Sofia Rodrigues collaborate on solving problems in Group Theory, bonding over their shared passion for mathematics."</data>
      <data key="d5">"collaboration, shared interests"</data>
      <data key="d6">cb-0345</data>
    </edge>
    <edge source="&quot;IRVING KAPLANSKY&quot;" target="&quot;UNIVERSITY OF TORONTO&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Irving Kaplansky attended the University of Toronto, earning his Bachelor's degree in mathematics there."</data>
      <data key="d5">"education, academic background"</data>
      <data key="d6">cb-0345</data>
    </edge>
    <edge source="&quot;IRVING KAPLANSKY&quot;" target="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Irving Kaplansky pursued his Ph.D. at Harvard University, contributing significantly to the fields of algebra, topology, and functional analysis."</data>
      <data key="d5">"advanced studies, academic achievements"</data>
      <data key="d6">cb-0345</data>
    </edge>
  </graph>
