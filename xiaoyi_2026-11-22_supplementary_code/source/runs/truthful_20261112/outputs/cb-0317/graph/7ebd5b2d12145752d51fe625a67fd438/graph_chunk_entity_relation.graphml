    </edge>
    <edge source="&quot;LOWRIE&quot;" target="&quot;1964 DEPARTMENTAL NEWSLETTER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Lowrie is documented in the 1964 departmental newsletter, which contains a photograph of him."</data>
      <data key="d5">"documentation, presence"</data>
      <data key="d6">cb-0317</data>
    </edge>
    <edge source="&quot;DEPARTMENT OF GEOLOGY AND PLANETARY SCIENCES&quot;" target="&quot;1964 DEPARTMENTAL NEWSLETTER&quot;">
      <data key="d3">15.0</data>
      <data key="d4">"The 1964 departmental newsletter documents events and activities within the Department of Geology and Planetary Sciences, including Lowrie's participation."&lt;SEP&gt;"The 1964 departmental newsletter is a document from the Department of Geology and Planetary Sciences."</data>
      <data key="d5">"documenting events, documentation"&lt;SEP&gt;"publication, documentation"</data>
      <data key="d6">cb-0317</data>
