      <data key="d3">8.0</data>
      <data key="d4">"Lowrie was a graduate student at the University of Pittsburgh and is documented in the university's records."</data>
      <data key="d5">"academic affiliation, documentation"</data>
      <data key="d6">cb-0317</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF PITTSBURGH&quot;" target="&quot;1964 DEPARTMENTAL NEWSLETTER&quot;">
      <data key="d3">6.0</data>
