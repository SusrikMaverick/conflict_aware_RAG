      <data key="d5">"location, documentation"</data>
      <data key="d6">cb-0317</data>
    </edge>
    <edge source="&quot;LOWRIE&quot;" target="&quot;DEPARTMENT OF GEOLOGY AND PLANETARY SCIENCES&quot;">
      <data key="d3">7.0</data>
