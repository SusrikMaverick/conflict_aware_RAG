<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WILLIAM LOWRIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Lowrie is a Scottish geophysicist known for his contributions to seismology, born on October 12, 1945, in Glasgow, Scotland. He pursued his education and research at the University of Edinburgh and the University of Cambridge."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;GLASGOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glasgow is the birthplace of William Lowrie, located in Scotland."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;UNIVERSITY OF EDINBURGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Edinburgh is where William Lowrie earned his Bachelor of Science degree in Geology in 1967."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Cambridge is where William Lowrie earned his Ph.D. in Geophysics in 1972, under the supervision of Dr. Dan McKenzie."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;SIR EDWARD BULLARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Edward Bullard is mentioned as an inspiration for William Lowrie's interest in geophysics."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;SIR HAROLD JEFFREYS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Harold Jeffreys is noted as a prominent geophysicist and mathematician who influenced William Lowrie during his time at Cambridge."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;DR. DAN MCKENZIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Dan McKenzie supervised William Lowrie's doctoral thesis at the University of Cambridge."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;SEISMIC WAVE PROPAGATION IN HETEROGENEOUS MEDIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"William Lowrie's doctoral thesis, supervised by Dr. Dan McKenzie, focused on seismic wave propagation in heterogeneous media."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;SEISMIC TOMOGRAPHY OF THE EARTH'S MANTLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"William Lowrie published 'Seismic Tomography of the Earth's Mantle' in 1975, contributing significantly to seismology."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;ANISOTROPIC SEISMIC WAVE PROPAGATION IN THE EARTH'S CRUST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"William Lowrie published 'Anisotropic Seismic Wave Propagation in the Earth's Crust' in 1978, further advancing seismology."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;UNIVERSITY OF PITTSBURGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Pittsburgh is an educational institution where Lowrie was a graduate student and where there is documentation of his activities."&lt;SEP&gt;"The University of Pittsburgh is where William Lowrie conducted further research and was influenced by Dr. Robert B. Whitcomb."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;ROBERT B. WHITCOMB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Robert B. Whitcomb is a distinguished professor of geology at the University of Pittsburgh who guided William Lowrie's research on the Earth's magnetic field."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;PITTSBURGH COAL BASIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Pittsburgh Coal Basin is the subject of a 1965 publication by William Lowrie and Dr. Robert B. Whitcomb, analyzing its magnetic field."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;APPALACHIAN MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Appalachian Mountains are the location of a field excursion documented in the 1964 departmental newsletter."&lt;SEP&gt;"William Lowrie participated in a field excursion to the Appalachian Mountains while a graduate student at the University of Pittsburgh."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;JOURNAL OF GEOPHYSICAL RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Geophysical Research published William Lowrie's work on seismic tomography and anisotropic seismic wave propagation."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;GEOPHYSICAL JOURNAL OF THE ROYAL ASTRONOMICAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Geophysical Journal of the Royal Astronomical Society published William Lowrie's work on anisotropic seismic wave propagation."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;ANNUAL REVIEW OF EARTH AND PLANETARY SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Annual Review of Earth and Planetary Sciences published McKenzie's work on the Cambridge School of Geophysics."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;ROYAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Society is mentioned as an organization where Dr. Dan McKenzie is a Fellow."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;EARTH'S INTERIOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"William Lowrie's research focused on understanding the Earth's interior through seismic tomography."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;EARTH'S MANTLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"William Lowrie's research included studying the Earth's mantle through seismic tomography."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;EARTH'S CRUST&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"William Lowrie's research also included studying the Earth's crust through anisotropic seismic wave propagation."&gt;</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;LOWRIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lowrie is a person who was affiliated with the University of Pittsburgh and participated in a field excursion to the Appalachian Mountains as a graduate student."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;DEPARTMENT OF GEOLOGY AND PLANETARY SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Department of Geology and Planetary Sciences at the University of Pittsburgh is a specific academic unit where Lowrie's affiliation is documented."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;1964 DEPARTMENTAL NEWSLETTER&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"A 1964 departmental newsletter from the University of Pittsburgh's Department of Geology and Planetary Sciences contains a photograph of Lowrie."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;FIELD EXCURSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A field excursion to the Appalachian Mountains is documented in the 1964 departmental newsletter."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;ARCHIVES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The archives of the University of Pittsburgh's Department of Geology and Planetary Sciences contain documentation of Lowrie's activities."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;APPALACHIAN MOUNTAINS FIELD EXCURSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An event where Lowrie participated in a field excursion to the Appalachian Mountains as documented in the 1964 departmental newsletter."</data>
      <data key="d2">cb-0317</data>
    </node>
    <node id="&quot;DEPARTMENTAL NEWSLETTER&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"A document that contains information about Lowrie's activities and affiliations."</data>
      <data key="d2">cb-0317</data>
    </node>
