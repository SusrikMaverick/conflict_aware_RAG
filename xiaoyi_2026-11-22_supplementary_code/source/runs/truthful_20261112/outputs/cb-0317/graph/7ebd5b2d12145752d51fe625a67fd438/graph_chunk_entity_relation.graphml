      <data key="d3">9.0</data>
      <data key="d4">"The Department of Geology and Planetary Sciences is part of the University of Pittsburgh."</data>
      <data key="d5">"affiliation, documentation"</data>
      <data key="d6">cb-0317</data>
    </edge>
