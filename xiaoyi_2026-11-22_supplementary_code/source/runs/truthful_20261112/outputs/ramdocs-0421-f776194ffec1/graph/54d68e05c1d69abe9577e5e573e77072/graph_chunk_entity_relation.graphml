  <graph edgedefault="undirected">
    <node id="&quot;WEST VALLEY HIGH SCHOOL (COTTONWOOD, CALIFORNIA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Valley High School (Cottonwood, California) is an American high school located in Cottonwood, California, with approximately 900 students and is part of the Anderson Union High School District."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;WEST VALLEY HIGH SCHOOL (HEMET, CALIFORNIA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Valley High School (Hemet, California) is a high school serving around 1,800 students in Hemet, California, and is accredited by the WASC Accrediting Commission for Schools. It is also an AVID Demonstration School."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;WEST VALLEY HIGH SCHOOL (SPOKANE, WASHINGTON)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Valley High School (Spokane, Washington) is a public secondary school in Spokane, Washington, enrolling over 900 students in grades 9 through 12. It is known for its mentor groups program and various student clubs."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;GONZAGA BULLDOGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gonzaga Bulldogs is a college basketball team representing Gonzaga University."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;COTTONWOOD, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cottonwood, California is the location of West Valley High School, situated 6.5 miles west of Interstate 5 near the intersection of Gas Point and Happy Valley Roads."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;REDDING, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Redding, California is the closest major city to West Valley High School, located about fifteen miles north of the school."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;TIM AZEVEDO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tim Azevedo is the superintendent of the Anderson Union High School District, which includes West Valley High School."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;ANDERSON UNION HIGH SCHOOL DISTRICT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anderson Union High School District is the school district that includes West Valley High School, led by superintendent Tim Azevedo."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;HEMET, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hemet, California is the location of West Valley High School, which serves around 1,800 students on the western side of the city."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;WASC ACCREDITING COMMISSION FOR SCHOOLS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WASC Accrediting Commission for Schools accredits West Valley High School, ensuring educational standards are met."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;AVID DEMONSTRATION SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AVID Demonstration School status is held by West Valley High School, indicating its commitment to academic support programs."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;VINCE GRIPPI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Vince Grippi provides daily commentary on regional sports, including West Valley High School."</data>
