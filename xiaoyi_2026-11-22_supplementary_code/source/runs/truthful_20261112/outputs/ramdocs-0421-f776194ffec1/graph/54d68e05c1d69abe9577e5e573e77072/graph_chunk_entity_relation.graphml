    </node>
    <node id="&quot;SPOKANE, WASHINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spokane, Washington is the location of West Valley High School, which enrolls over 900 students in grades 9 through 12."</data>
      <data key="d2">ramdocs-0421-f776194ffec1</data>
    </node>
    <node id="&quot;STUDENT CLUBS&quot;">
      <data key="d2">ramdocs-0421-f776194ffec1</data>
      <data key="d1">"West Valley High School (Spokane, Washington) supports various student clubs such as band, DECA, Drama, and Knowledge, fostering extracurricular engagement."</data>
      <data key="d0">"UNKNOWN"</data>
