  <graph edgedefault="undirected">
    <node id="&quot;CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"City is a location where demographic statistics are provided, including age distribution, household sizes, and family sizes."</data>
      <data key="d2">ramdocs-0473-a2a2380670e9</data>
    </node>
    <node id="&quot;HOUSEHOLD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Household refers to a group of people living together, with details on age distribution and composition."&lt;SEP&gt;"household refers to the unit of people living together mentioned in the text."</data>
      <data key="d2">ramdocs-0473-a2a2380670e9</data>
    </node>
    <node id="&quot;FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Family refers to a group of related individuals living together, with details on age distribution and composition."&lt;SEP&gt;"family refers to the unit of related people living together mentioned in the text."</data>
      <data key="d2">ramdocs-0473-a2a2380670e9</data>
    </node>
    <node id="&quot;RESIDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Residents are the people living in the city, with details on age distribution and gender makeup."</data>
