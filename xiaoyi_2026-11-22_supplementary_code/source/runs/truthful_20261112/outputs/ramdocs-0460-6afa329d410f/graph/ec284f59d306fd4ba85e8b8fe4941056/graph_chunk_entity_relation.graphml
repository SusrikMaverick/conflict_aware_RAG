  <graph edgedefault="undirected">
    <node id="&quot;JOHN LAMBIE (FOOTBALLER, BORN 1868)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Lambie (footballer, born 1868) was a Scottish football player who holds records as the youngest Scotland player, captain, and goalscorer of all time."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;JOHN LAMBIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Lambie is a Scottish engineer born in 1833 and died in 1895. He worked as Locomotive Superintendent of the Caledonian Railway from 1891 to 1895."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;UNITED KINGDOM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"United Kingdom is the country of citizenship for John Lambie."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;WHITBURN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Whitburn is the place of birth for John Lambie."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;SALTCOATS, AYRSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saltcoats, Ayrshire is the place of birth for John Lambie's father."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;GLASGOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glasgow is the place of death for John Lambie."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;CALEDONIAN RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Caledonian Railway is the railway company where John Lambie served as Locomotive Superintendent from 1891 to 1895."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;WISHAW AND COLTNESS RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wishaw and Coltness Railway is the railway company where John Lambie's father was Traffic Manager before it was absorbed by the Caledonian Railway."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;1894&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1894, the 4-4-0 design was introduced, and condensing steam locomotives of the 4-4-0T and 0-4-4T types were introduced for underground lines."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;4-4-0 DESIGN&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The 4-4-0 design is a type of steam locomotive introduced in 1894."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;4-4-0T&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"4-4-0T is a type of condensing steam locomotive introduced in 1894 for underground lines."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <node id="&quot;0-4-4T&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"0-4-4T is another type of condensing steam locomotive introduced in 1894 for underground lines."</data>
      <data key="d2">ramdocs-0460-6afa329d410f</data>
    </node>
    <edge source="&quot;JOHN LAMBIE&quot;" target="&quot;UNITED KINGDOM&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"John Lambie is a citizen of the United Kingdom."</data>
      <data key="d5">"citizenship"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;JOHN LAMBIE&quot;" target="&quot;WHITBURN&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"John Lambie was born in Whitburn."</data>
      <data key="d5">"place of birth"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;JOHN LAMBIE&quot;" target="&quot;SALTCOATS, AYRSHIRE&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"John Lambie's father was born or worked in Saltcoats, Ayrshire."</data>
      <data key="d5">"family background"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;JOHN LAMBIE&quot;" target="&quot;GLASGOW&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"John Lambie died in Glasgow."</data>
      <data key="d5">"place of death"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;JOHN LAMBIE&quot;" target="&quot;CALEDONIAN RAILWAY&quot;">
      <data key="d3">34.0</data>
      <data key="d4">"John Lambie served as Locomotive Superintendent of the Caledonian Railway from 1891 to 1895."&lt;SEP&gt;"John Lambie's father had a background in the railway industry, specifically with the Wishaw and Coltness Railway, which was absorbed by the Caledonian Railway."</data>
      <data key="d5">"family background, professional connection"&lt;SEP&gt;"professional career"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;CALEDONIAN RAILWAY&quot;" target="&quot;WISHAW AND COLTNESS RAILWAY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Wishaw and Coltness Railway was absorbed by the Caledonian Railway, and John Lambie's father was Traffic Manager there."</data>
      <data key="d5">"company absorption"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
    </edge>
    <edge source="&quot;1894&quot;" target="&quot;4-4-0 DESIGN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"In 1894, the 4-4-0 design was introduced, along with condensing steam locomotives of the 4-4-0T and 0-4-4T types for underground lines."</data>
      <data key="d5">"introduction of technology"</data>
      <data key="d6">ramdocs-0460-6afa329d410f</data>
