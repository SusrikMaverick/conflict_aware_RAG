  <graph edgedefault="undirected">
    <node id="&quot;ANGLICAN RETIREMENT VILLAGES, DIOCESE OF SYDNEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anglican Retirement Villages, Diocese of Sydney is a not-for-profit organization that provides housing and care for seniors, operating in the realm of retirement villages."|&lt;SEP&gt;"Anglican Retirement Villages, Diocese of Sydney is a subsidiary organization listed in the ACNC register, connected to Anglicare Sydney."</data>
      <data key="d2">cb-0014</data>
    </node>
    <node id="&quot;ANGLICARE SYDNEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anglicare Sydney is the parent organization of Anglican Retirement Villages, Diocese of Sydney, as evidenced by their listing in the ACNC register."</data>
      <data key="d2">cb-0014</data>
    </node>
    <node id="&quot;AUSTRALIAN CHARITIES AND NOT-FOR-PROFITS COMMISSION (ACNC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Australian Charities and Not-for-profits Commission (ACNC) is the regulatory body that maintains the register of charities and not-for-profit organizations, including Anglican Retirement Villages, Diocese of Sydney and Anglicare Sydney."</data>
      <data key="d2">cb-0014</data>
    </node>
    <node id="&quot;SYDNEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney is the city where both Anglican Retirement Villages, Diocese of Sydney and Anglicare Sydney are based."</data>
      <data key="d2">cb-0014</data>
    </node>
    <node id="&quot;MRS. THOMPSON&quot;">
      <data key="d2">cb-0014</data>
      <data key="d1">"Mrs. Thompson is the activities coordinator at St. Mary's Retirement Village, organizing events like Wii Night."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ST. MARY'S RETIREMENT VILLAGE&quot;">
      <data key="d2">cb-0014</data>
