<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ERNST HEUBACH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ernst Heubach was a company in Köppelsdorf, Thuringia, Germany, that manufactured porcelain-headed bisque dolls from 1885 onwards."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;KÖPPELSDORF&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Köppelsdorf is a town in Thuringia, Germany, and is part of Sonneberg, in the Landkreis Sonneberg."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;SONNEBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sonneberg is a town in Thuringia, Germany, and is the center of the German toy-making industry, home to many doll manufacturers and PIKO model railways."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;NUREMBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nuremberg is a city located south of Sonneberg, in Thuringia, Germany."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;GDR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"GDR refers to the German Democratic Republic, the eastern part of Germany during the Cold War."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;GEBRÜDER HEUBACH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gebrüder Heubach of Licht and Sonneberg was a separate firm from Ernst Heubach."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;LICHT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Licht is a place mentioned in relation to Gebrüder Heubach, located near Sonneberg."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;BAD ZURZACH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bad Zurzach is a town in Switzerland where the global headquarters of the company is located."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;HIRSCHBRAUEREI HEUBACH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hirschbrauerei Heubach is a local brewery in Heubach, closely linked to the history of Heubach, with a history going back to the 17th century."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;HEUBACH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Heubach is a town where Fritz Reu GmbH &amp; Co. is based."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;FRITZ REU GMBH &amp; CO.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fritz Reu GmbH &amp; Co. is a company based in Heubach."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;120 COUNTRIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"120 countries around the world indicate the global reach of the company mentioned in Document 2."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;UNDERWEAR MANUFACTURER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The company in Document 2 is one of the leading underwear manufacturers in the world."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;1.7 BILLION EUROS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2009, the company in Document 2 had annual sales of 1.7 billion Euros."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;37,515 EMPLOYEES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2009, the company in Document 2 had 37,515 employees."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;PORCELAIN-HEADED BISQUE DOLLS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Porcelain-headed bisque dolls were manufactured by Ernst Heubach from 1885 onwards."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;PIKO MODEL RAILWAYS&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"PIKO model railways are mentioned as being produced in Sonneberg, the center of the German toy-making industry."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;GERMAN TOY-MAKING INDUSTRY&quot;">
      <data key="d0">"INDUSTRY"</data>
      <data key="d1">"The German toy-making industry is centered in Sonneberg, where many doll manufacturers and model railway companies operate."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;FAMILY OWNERSHIP&quot;">
      <data key="d0">"OWNERSHIP STRUCTURE"</data>
      <data key="d1">"Hirschbrauerei Heubach is still family-owned, with a history dating back to the 17th century."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;1725&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The earliest documented proof of Hirschbrauerei Heubach dates back to 1725."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;1858&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Ernst Heubach porcelain works opened in 1858 with 50 employees."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;50 EMPLOYEES&quot;">
      <data key="d0">"NUMBER OF EMPLOYEES"</data>
      <data key="d1">"Ernst Heubach porcelain works opened with 50 employees in 1858."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;GLOBAL MANUFACTURING FOOTPRINT&quot;">
      <data key="d0">"OPERATION"</data>
      <data key="d1">"The company in Document 2 has a global manufacturing footprint, with sales offices across the world."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <node id="&quot;SALES OFFICES&quot;">
      <data key="d0">"OPERATION"</data>
      <data key="d1">"The company in Document 2 has sales offices across the world, indicating its global presence."</data>
      <data key="d2">ramdocs-0145-a4c8252cc72a</data>
    </node>
    <edge source="&quot;ERNST HEUBACH&quot;" target="&quot;KÖPPELSDORF&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Ernst Heubach was based in Köppelsdorf, Thuringia, Germany."</data>
      <data key="d5">"company location, production site"</data>
      <data key="d6">ramdocs-0145-a4c8252cc72a</data>
    </edge>
    <edge source="&quot;ERNST HEUBACH&quot;" target="&quot;SONNEBERG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Köppelsdorf is part of Sonneberg, and Ernst Heubach is closely linked to Sonneberg as it is the center of the German toy-making industry."</data>
      <data key="d5">"industry hub, historical link"</data>
      <data key="d6">ramdocs-0145-a4c8252cc72a</data>
    </edge>
    <edge source="&quot;ERNST HEUBACH&quot;" target="&quot;NUREMBERG&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Nuremberg is a city located south of Sonneberg, where the wooded countryside formed the border between the two Germanys during the Cold War, impacting the context of Ernst Heubach's operations."</data>
      <data key="d5">"geographical context, historical impact"</data>
      <data key="d6">ramdocs-0145-a4c8252cc72a</data>
    </edge>
    <edge source="&quot;ERNST HEUBACH&quot;" target="&quot;GDR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Sonneberg, where Ernst Heubach is based, was in the GDR during the Cold War, indicating the political context of the company's operations."</data>
      <data key="d5">"political context, historical impact"</data>
      <data key="d6">ramdocs-0145-a4c8252cc72a</data>
    </edge>
    <edge source="&quot;ERNST HEUBACH&quot;" target="&quot;GEBRÜDER HEUBACH&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Gebrüder Heubach of Licht and Sonneberg was a separate firm from Ernst Heubach, suggesting a business relationship or competition."</data>
      <data key="d5">"business relationship, separation"</data>
      <data key="d6">ramdocs-0145-a4c8252cc72a</data>
    </edge>
  </graph>
