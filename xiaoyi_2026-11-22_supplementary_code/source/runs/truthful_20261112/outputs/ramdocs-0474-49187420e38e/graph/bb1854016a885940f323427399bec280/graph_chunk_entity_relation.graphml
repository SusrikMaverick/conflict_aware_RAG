  <graph edgedefault="undirected">
    <node id="&quot;FIRST DIVISION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"First Division refers to a football league in England, specifically the league that Wimbledon played in during the 1987–88 season."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;WIMBLEDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wimbledon is a football club that Fitzgerald played for during the 1987–88 season and later seasons."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;TOTTENHAM HOTSPUR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tottenham Hotspur is a football club against which Fitzgerald made his debut as a substitute in 1990."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;FITZGERALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fitzgerald is a player who had a career with Wimbledon and later played for other clubs, making various appearances and scoring goals."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;PREMIER LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Premier League is the top tier of English football, which Fitzgerald played in during the inaugural season."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;RICHARD BUTLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Butler is an injured striker who Fitzgerald covered for during a loan period at AFC Wimbledon."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;PAUL BARNES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Barnes is another injured striker who Fitzgerald covered for during a loan period at AFC Wimbledon."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;BRENTFORD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brentford is a football club where Fitzgerald's contract was terminated and he signed with Basingstoke Town."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;BASINGSTOKE TOWN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Basingstoke Town is a football club where Fitzgerald signed after his contract with Brentford was terminated."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;AFC WIMBLEDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AFC Wimbledon is a non-League football club where Fitzgerald had a loan spell in 2006–07."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;SHEREEN FITZGERALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shereen Fitzgerald is Fitzgerald's wife."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;NEELEY FITZGERALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Neeley Fitzgerald is Fitzgerald's son."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;KI FITZGERALD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ki Fitzgerald is Fitzgerald's daughter, a singer-songwriter and former member of the UK boy band Busted."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;SAARA AALTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Saara Aalto is a Finnish singer who performed in the Eurovision Song Contest 2018."</data>
