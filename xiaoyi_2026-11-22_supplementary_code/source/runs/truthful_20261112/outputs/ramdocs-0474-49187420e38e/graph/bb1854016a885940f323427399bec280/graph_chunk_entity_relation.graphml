    </node>
    <node id="&quot;WILLIAM MCPHAIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William McPhail is the birth name of Scott Fitzgerald, the Scottish singer and musical actor."</data>
      <data key="d2">ramdocs-0474-49187420e38e</data>
    </node>
    <node id="&quot;UK BOY BAND BUSTED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UK boy band Busted is a group that includes Ki Fitzgerald, who is Fitzgerald's daughter."</data>
