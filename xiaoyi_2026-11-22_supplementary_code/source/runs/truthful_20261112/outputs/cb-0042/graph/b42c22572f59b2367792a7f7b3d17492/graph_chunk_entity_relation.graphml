      <data key="d3">8.0</data>
      <data key="d4">"Friedrich II. von Parsberg came from the region of Parsberg, Bavaria, and served as the Bishop of Eichstätt, a city in the Kingdom of Bavaria."</data>
      <data key="d5">"origin, service area"</data>
      <data key="d6">cb-0042</data>
    </edge>
    <edge source="&quot;FRIEDRICH II. VON PARSBERG (DIED 1461)&quot;" target="&quot;DIOCESE OF EICHSTÄTT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Friedrich II. von Parsberg served as the diocesan bishop of the Diocese of Eichstätt, which includes the cities of Eichstätt, Weißenburg, and Ellingen."</data>
      <data key="d5">"religious leadership, administrative responsibility"</data>
      <data key="d6">cb-0042</data>
    </edge>
