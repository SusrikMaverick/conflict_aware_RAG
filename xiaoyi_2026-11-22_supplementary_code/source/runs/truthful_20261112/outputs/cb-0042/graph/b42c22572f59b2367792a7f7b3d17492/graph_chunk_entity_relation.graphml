<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRIEDRICH II. VON PARSBERG (DIED 1461)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friedrich II. von Parsberg was a German prince-bishop who held the position of diocesan bishop, born into a noble family in the 14th century, and died in 1461."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;PARSBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parsberg is a region in Bavaria where Friedrich II. von Parsberg came from."&lt;SEP&gt;"Parsberg is the subject of a study focusing on his life and career.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;BAVARIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bavaria is a region in Germany where Friedrich II. von Parsberg came from and where the diocese of Eichstätt is located."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;EICHSTÄTT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eichstätt is a city in the Kingdom of Bavaria where Friedrich II. von Parsberg served as the Bishop of Eichstätt from 1437 to 1461."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;WEISSENBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Weißenburg is a city in the Kingdom of Bavaria, part of the diocese of Eichstätt."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;ELLINGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ellingen is a city in the Kingdom of Bavaria, part of the diocese of Eichstätt."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;DUCHY OF BAVARIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Duchy of Bavaria is a secular authority with which Friedrich II. von Parsberg worked to strengthen the relationship during his episcopal career."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;DIOCESE OF EICHSTÄTT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Diocese of Eichstätt is the religious institution for which Friedrich II. von Parsberg served as the diocesan bishop from 1437 to 1461."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;FRIEDRICH II. VON PARSBERG (1480-1543)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friedrich II. von Parsberg was a German prince-bishop who held the position of Count of Astarac from 1520 to 1535, born in 1480 in Parsberg, Bavaria."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;AUGSBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Augsburg is a city where Friedrich II. von Parsberg was appointed as a canon of the Augsburg Cathedral in 1505 and later as the prince-bishop of Augsburg from 1515 to 1520."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;KINGDOM OF FRANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Kingdom of France appointed Friedrich II. von Parsberg as the Count of Astarac in 1520 through the Treaty of Paris signed in 1519."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;COUNT OF ASTARAC&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Count of Astarac is a title held by Friedrich II. von Parsberg from 1520 to 1535, appointed by King Francis I of France."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;ASTARAC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Astarac is a region where Friedrich II. von Parsberg was appointed as the Count of Astarac by King Francis I of France."&lt;SEP&gt;"Astarac is the region studied by P. Schmid in his book.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;HOLY ROMAN EMPIRE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Holy Roman Empire is mentioned as an institution with which Friedrich II. von Parsberg had connections during his tenure as prince-bishop of Augsburg."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;UNIVERSITY OF INGOLSTADT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Ingolstadt is where Friedrich II. von Parsberg studied theology and canon law."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;AUGSBURG CATHEDRAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Augsburg Cathedral is where Friedrich II. von Parsberg was appointed as a canon in 1505 and later as provost of the cathedral chapter."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;UNIVERSITY OF PARIS PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Paris Press published a book on the Treaty of Paris."&lt;SEP&gt;"University of Paris Press published a study on the Treaty of Paris.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;UNIVERSITY OF TOULOUSE PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Toulouse Press published a book on the history of the region of Astarac."&lt;SEP&gt;"University of Toulouse Press published a study on the history of the Counts of Astarac.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;UNIVERSITY OF AUGSBURG PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Augsburg Press published a book on Friedrich II. von Parsberg's life and career."</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;AUGSBURG UNIVERSITY PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Augsburg University Press published a study on Parsberg's life and career.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;MÜLLER, J.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. Müller is the author of a study on the Treaty of Paris and its impact on European politics.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;THE TREATY OF PARIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Treaty of Paris is the subject of a study examining its impact on European politics.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;SCHMID, P.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"P. Schmid is the author of a study on the history of the region of Astarac.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;COUNTS OF ASTARAC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Counts of Astarac is the subject of a study on the history of the region.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is the location of the University of Paris Press.")</data>
      <data key="d2">cb-0042</data>
    </node>
    <node id="&quot;TOULOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Toulouse is the location of the University of Toulouse Press.")</data>
      <data key="d2">cb-0042</data>
    </node>
