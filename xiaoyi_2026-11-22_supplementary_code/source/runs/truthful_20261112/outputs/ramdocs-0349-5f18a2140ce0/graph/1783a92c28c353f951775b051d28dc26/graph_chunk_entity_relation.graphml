<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WASHINGTON TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington Township is a civil township of Gratiot County in the U.S. state of Michigan, with a population of 909 at the 2000 census."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;GRATIOT COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gratiot County is a county in the U.S. state of Michigan, containing Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;MICHIGAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Michigan is a U.S. state that contains Gratiot County and Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;UNITED STATES CENSUS BUREAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Census Bureau provides demographic data for Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;2000 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2000 Census is a demographic survey conducted in the year 2000, providing data on the population and demographics of a specific area."|&lt;SEP&gt;"The 2000 census recorded the population and other demographic data for Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;2010 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2010 census recorded updated demographic data for Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;MAPLE RIVER STATE GAME AREA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Maple River State Game Area is a portion of the land contained within Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;RUDGATE TRAILER PARK COMMUNITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rudgate trailer park community is a community within Washington Township that was affected by a tornado in 1997."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;OCTAGON HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Octagon House is a historic building located in Washington Township, built by Loren Andrus from 1858 to 1860."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;WESTVIEW ORCHARDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Westview Orchards is a farm founded in Washington Township in 1813."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;MOUNT VERNON CEMETERY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mount Vernon Cemetery is a cemetery located in Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;APPLEGATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Applegate is a village located in the southeast corner of Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;PACKS MILLS ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Packs Mills Road is a road running through the area of Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;METRO DETROIT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Metro Detroit is a metropolitan area containing Washington Charter Township, which is located within it."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;MACOMB COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Macomb County is a county in the U.S. state of Michigan, containing Washington Charter Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;LOREN ANDRUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Loren Andrus is the builder of the Octagon House in Washington Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;26 MILE ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"26 Mile Road is a road where a tornado touched down in 1997, destroying parts of the Rudgate trailer park community."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;EF0 TORNADO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An EF0 tornado occurred on July 2, 1997, touching down on 26 Mile Road and causing damage to the Rudgate trailer park community."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
    <node id="&quot;2020 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 census recorded the population and other demographic data for Washington Charter Township."</data>
      <data key="d2">ramdocs-0349-5f18a2140ce0</data>
    </node>
