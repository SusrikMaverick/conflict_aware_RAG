  <graph edgedefault="undirected">
    <node id="&quot;TEOFILA MORAWSKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Teofila Morawska is a Polish noblewoman born on April 12, 1791, known for her role in Polish politics and society, and her intelligence, wit, and beauty made her a sought-after companion in the salons of Warsaw."&lt;SEP&gt;"Teofila Morawska is a historical figure whose life and marriage have been redefined by recent discoveries."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;ALEXANDER IVANOVICH CHERNYSHEV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexander Ivanovich Chernyshev is a Russian general, diplomat, and statesman born in 1786, known for his military prowess, strategic mind, and diplomatic skills."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;IMPERIAL RUSSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Imperial Russia is the setting of the early 19th century where Alexander Ivanovich Chernyshev served as a diplomat and rose through the ranks of the Imperial Army."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;POLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poland is the setting where Teofila Morawska was from and where Alexander Ivanovich Chernyshev served as a diplomat."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;WARSAW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw is the city where Teofila Morawska and Alexander Ivanovich Chernyshev met and where their marriage took place."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;PRIVATE CEREMONY&quot;">
