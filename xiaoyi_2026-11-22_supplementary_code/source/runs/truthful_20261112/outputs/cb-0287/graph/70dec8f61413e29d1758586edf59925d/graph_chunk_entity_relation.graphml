      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;CECIL WILLIAM DONOVAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cecil William Donovan is a British historian born in 1936, who was married to Teofila Morawska in a small ceremony in Warsaw in 1825."</data>
      <data key="d2">cb-0287</data>
    </node>
    <node id="&quot;UNIVERSITY OF WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
