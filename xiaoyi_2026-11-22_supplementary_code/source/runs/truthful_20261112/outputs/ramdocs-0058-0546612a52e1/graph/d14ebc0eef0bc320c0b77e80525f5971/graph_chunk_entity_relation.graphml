<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HOUSTON GAMBLERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Houston Gamblers were an American football team that competed in the United States Football League in 1984 and 1985, known for introducing the Run &amp; Shoot offense to professional football."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;JACK PARDEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jack Pardee was the head coach of the Houston Gamblers in 1984 and 1985, known for coaching in the NFL and installing the Run &amp; Shoot offense."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;GLENN 'TIGER' ELLISON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Glenn 'Tiger' Ellison is credited with developing the Run &amp; Shoot offense, which was introduced to professional football by the Houston Gamblers."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;RUN &amp; SHOOT OFFENSE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Run &amp; Shoot offense is a unique offensive strategy that was introduced to professional football by the Houston Gamblers."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;DARELL 'MOUSE' DAVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Darell 'Mouse' Davis was hired as the Offensive Coordinator by Jack Pardee to implement the Run &amp; Shoot offense for the Houston Gamblers."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;MIDDLETOWN (OHIO) HIGH SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Middletown (Ohio) High School is mentioned as the origin of Glenn 'Tiger' Ellison, who developed the Run &amp; Shoot offense."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;PORTLAND STATE UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portland State University is mentioned as the place where Darell 'Mouse' Davis developed the Run &amp; Shoot offense as a head coach."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;UNITED STATES FOOTBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Football League was the league in which the Houston Gamblers competed in 1984 and 1985."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;1984&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1984 was the year the Houston Gamblers competed in the United States Football League."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <node id="&quot;1985&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1985 was the second year the Houston Gamblers competed in the United States Football League."</data>
      <data key="d2">ramdocs-0058-0546612a52e1</data>
    </node>
    <edge source="&quot;HOUSTON GAMBLERS&quot;" target="&quot;JACK PARDEE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Jack Pardee coached the Houston Gamblers during their two seasons in the United States Football League, implementing the Run &amp; Shoot offense."</data>
      <data key="d5">"coaching, offense implementation"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;HOUSTON GAMBLERS&quot;" target="&quot;GLENN 'TIGER' ELLISON&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Glenn 'Tiger' Ellison developed the Run &amp; Shoot offense, which was introduced to professional football by the Houston Gamblers."</data>
      <data key="d5">"offense development, introduction"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;HOUSTON GAMBLERS&quot;" target="&quot;DARELL 'MOUSE' DAVIS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Darell 'Mouse' Davis was hired by Jack Pardee to install the Run &amp; Shoot offense as the Offensive Coordinator for the Houston Gamblers."</data>
      <data key="d5">"hiring, offense installation"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;HOUSTON GAMBLERS&quot;" target="&quot;UNITED STATES FOOTBALL LEAGUE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Houston Gamblers competed in the United States Football League in 1984 and 1985, during which they implemented the Run &amp; Shoot offense."</data>
      <data key="d5">"league competition, offense implementation"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;GLENN 'TIGER' ELLISON&quot;" target="&quot;MIDDLETOWN (OHIO) HIGH SCHOOL&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Glenn 'Tiger' Ellison, who developed the Run &amp; Shoot offense, was previously a coach at Middletown (Ohio) High School."</data>
      <data key="d5">"previous affiliation, offense development"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;DARELL 'MOUSE' DAVIS&quot;" target="&quot;PORTLAND STATE UNIVERSITY&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Darell 'Mouse' Davis, who developed the Run &amp; Shoot offense, was previously a head coach at Portland State University."</data>
      <data key="d5">"previous affiliation, offense development"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
    <edge source="&quot;1984&quot;" target="&quot;1985&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"1984 and 1985 were consecutive years in which the Houston Gamblers competed in the United States Football League, implementing the Run &amp; Shoot offense."</data>
      <data key="d5">"sequential years, offense implementation"</data>
      <data key="d6">ramdocs-0058-0546612a52e1</data>
    </edge>
  </graph>
