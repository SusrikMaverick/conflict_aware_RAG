  <graph edgedefault="undirected">
    <node id="&quot;GARY BENNETT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gary Bennett is an English former professional footballer, known for his career as a defender and later as a forward, with significant stints at Manchester City, Cardiff City, Sunderland, Carlisle United, Scarborough, and Darlington."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;MANCHESTER CITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Manchester City is a professional football club where Gary Bennett started his career."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;CARDIFF CITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cardiff City is a professional football club where Gary Bennett played from 1981 to 1984."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;SUNDERLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sunderland is a professional football club where Gary Bennett played from 1984 to 1995, making over 350 appearances and placing fifth on the club's all-time appearance list."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;CARLISLE UNITED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Carlisle United is a professional football club where Gary Bennett played from 1995 to 1996."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;SCARBOROUGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Scarborough is a professional football club where Gary Bennett played from 1996 to 1998."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;DARLINGTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Darlington is a professional football club where Gary Bennett played from 1998 to 2000."</data>
      <data key="d2">ramdocs-0064-eeaaacf08fc8</data>
    </node>
    <node id="&quot;ASHTON UNITED&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ashton United is the youth club where Gary Bennett began his career."</data>
