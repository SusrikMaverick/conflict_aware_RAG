  <graph edgedefault="undirected">
    <node id="&quot;CHARLES ARCHAMBO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Archambo is a talented college basketball player from Tulsa who made a name for himself in the NCAA Division I men's basketball league during the 1953 season."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;UNIVERSITY OF TULSA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Tulsa is a member institution of the NCAA Division I, where Charles Archambo played basketball during the 1953 season."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA Division I men's basketball league is a prestigious basketball league where Charles Archambo competed during the 1953 season."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;MISSOURI VALLEY CONFERENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Missouri Valley Conference is one of the most competitive divisions in the NCAA Division I where Charles Archambo's team, the Tulsa Golden Hurricane, competed."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;UNIVERSITY OF KANSAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Kansas is a top-tier program that Charles Archambo's team, the Tulsa Golden Hurricane, faced in competition."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;OKLAHOMA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Oklahoma State University is another top-tier program that Charles Archambo's team, the Tulsa Golden Hurricane, faced in competition."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;DR. JOHN SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Smith is a sports historian and expert on college basketball who commented on Charles Archambo's performance during his time at the University of Tulsa."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;MIKE DAVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mike Davis is a former college basketball coach and analyst who commented on Charles Archambo's performance and the significance of playing in the NCAA Division I men's basketball league."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;TULSA GOLDEN HURRICANE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tulsa Golden Hurricane is the basketball team that Charles Archambo played for during the 1953 season."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;NATIONAL HOCKEY LEAGUE (NHL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Hockey League (NHL) is the professional hockey league where Charles Archambo eventually played after leaving college basketball."</data>
      <data key="d2">cb-0138</data>
    </node>
    <node id="&quot;TORONTO MAPLE LEAFS&quot;">
      <data key="d0">"ORGANIZATION"</data>
