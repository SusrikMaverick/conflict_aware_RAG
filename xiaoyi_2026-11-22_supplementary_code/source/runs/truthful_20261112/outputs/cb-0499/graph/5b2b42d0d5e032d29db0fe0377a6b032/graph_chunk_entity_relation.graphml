      <data key="d3">9.0</data>
      <data key="d4">"Zoobles! originated in Brazil, drawing inspiration from the country's rich folklore and biodiversity."</data>
      <data key="d5">"cultural inspiration, origin"</data>
      <data key="d6">cb-0499</data>
    </edge>
    <edge source="&quot;ZOOBLES!&quot;" target="&quot;CARLOS ALBERTO DOS SANTOS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Carlos Alberto dos Santos conceived the concept of Zoobles! and led the development of the show."</data>
      <data key="d5">"creativity, leadership"</data>
      <data key="d6">cb-0499</data>
    </edge>
