      <data key="d5">"cultural inspiration, character naming"</data>
      <data key="d6">cb-0499</data>
    </edge>
    <edge source="&quot;CHIKO&quot;" target="&quot;SOUTH KOREAN VOICE ACTORS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"South Korean voice actors provide the voices for characters like Chiko, contributing to the show's cultural authenticity."</data>
      <data key="d5">"voice acting, cultural representation"</data>
