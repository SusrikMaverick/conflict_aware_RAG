  <graph edgedefault="undirected">
    <node id="&quot;EUGENE I. SHAKHNOVICH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Eugene I. Shakhnovich is a renowned biophysicist known for his work on protein folding and misfolding, and has received multiple prestigious awards."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;CANADA GAIRDNER INTERNATIONAL AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Canada Gairdner International Award is a prestigious recognition given to scientists who have made outstanding contributions to medical science."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;FAIRMONT ROYAL YORK HOTEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Fairmont Royal York hotel is the venue where the Canada Gairdner International Award ceremony took place."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;HARVARD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard University is the current affiliation of Dr. Shakhnovich, where he is a professor of chemistry and chemical biology."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;PROTEIN FOLDING AND MISFOLDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Protein folding and misfolding refers to the processes studied by Dr. Shakhnovich, which are crucial in understanding various diseases."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;ALZHEIMER'S DISEASE&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Alzheimer's disease is a debilitating condition linked to protein misfolding, which Dr. Shakhnovich's research addresses."&lt;SEP&gt;"Alzheimer's disease is one of the debilitating conditions linked to protein misfolding, which Dr. Shakhnovich's research addresses."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;PARKINSON'S DISEASE&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Parkinson's disease is another debilitating condition associated with protein misfolding, which Dr. Shakhnovich's research aims to understand."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;HUNTINGTON'S DISEASE&quot;">
      <data key="d0">"DISEASE"</data>
      <data key="d1">"Huntington's disease is a debilitating condition involving protein misfolding, which Dr. Shakhnovich's research contributes to understanding."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;NATIONAL INSTITUTES OF HEALTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Institutes of Health provides data on the prevalence of diseases related to protein misfolding."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;DAVID AND LUCILE PACKARD FOUNDATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The David and Lucile Packard Foundation awards the Packard Fellowship for Science and Engineering, which Dr. Shakhnovich received."</data>
      <data key="d2">cb-0053</data>
    </node>
    <node id="&quot;PACKARD FELLOWSHIP FOR SCIENCE AND ENGINEERING&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Packard Fellowship for Science and Engineering is a prestigious award given to early-career scientists and engineers for their promising research."</data>
      <data key="d2">cb-0053</data>
    </node>
