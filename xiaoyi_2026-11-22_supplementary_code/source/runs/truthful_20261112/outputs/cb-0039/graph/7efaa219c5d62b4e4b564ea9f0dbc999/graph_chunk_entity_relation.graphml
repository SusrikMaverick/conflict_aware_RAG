      <data key="d3">9.0</data>
      <data key="d4">"Dan Ceaușu served as the head of government in Dobreni and had a positive impact on the community."</data>
      <data key="d5">"leadership, positive impact"</data>
      <data key="d6">cb-0039</data>
    </edge>
