  <graph edgedefault="undirected">
    <node id="&quot;PADDY RYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paddy Ryan was an Irish American wrestler and boxer, born in Thurles, Tipperary, Ireland, and known for his heavyweight championship in boxing."</data>
      <data key="d2">ramdocs-0356-a0592c5bae4d</data>
    </node>
    <node id="&quot;THURLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thurles is a town in County Tipperary, Ireland, where Paddy Ryan was born."</data>
      <data key="d2">ramdocs-0356-a0592c5bae4d</data>
    </node>
    <node id="&quot;TIPPERARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tipperary is a county in Ireland, specifically in the province of Munster, where Paddy Ryan was born."</data>
      <data key="d2">ramdocs-0356-a0592c5bae4d</data>
    </node>
    <node id="&quot;JOE GOSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Goss was a boxer who lost the heavyweight title to Paddy Ryan in 1880."</data>
      <data key="d2">ramdocs-0356-a0592c5bae4d</data>
    </node>
    <node id="&quot;JOHN L. SULLIVAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John L. Sullivan was a boxer who defeated Paddy Ryan to take the heavyweight title in 1882."</data>
      <data key="d2">ramdocs-0356-a0592c5bae4d</data>
    </node>
    <node id="&quot;TROY, NEW YORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Troy, New York is the area where Paddy Ryan lived after moving to America and earned the nickname 'Trojan Giant'."</data>
