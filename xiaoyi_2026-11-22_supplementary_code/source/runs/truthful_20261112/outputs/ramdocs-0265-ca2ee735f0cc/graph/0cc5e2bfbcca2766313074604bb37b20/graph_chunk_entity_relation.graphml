      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;DECEMBER 1978&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"December 1978 is the month when the NCAA Division III Football Championship took place."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;AUGUST 1978&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"August 1978 is the month when the 1978 NCAA Division III football season began."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;NCAA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA is the governing body for college sports, including the Division I-A and Division III football seasons."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;NATIONAL COLLEGIATE ATHLETIC ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Collegiate Athletic Association (NCAA) is the governing body for college sports, including the Division III football season."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;COLLEGE FOOTBALL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"College football refers to the sport played by university teams, including the Division I-A and Division III levels."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;FOOTBALL CHAMPIONSHIP&quot;">
