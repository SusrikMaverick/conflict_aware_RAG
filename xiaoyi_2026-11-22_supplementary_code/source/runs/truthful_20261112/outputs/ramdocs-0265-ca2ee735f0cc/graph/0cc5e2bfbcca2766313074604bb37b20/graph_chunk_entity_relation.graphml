      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;GARRETT-HARRISON STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Garrett-Harrison Stadium is the specific stadium where the 1978 NCAA Division III Football Championship was held."&lt;SEP&gt;"Garrett-Harrison Stadium is the venue where the 1978 NCAA Division III Football Championship took place in Phenix City, Alabama."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
