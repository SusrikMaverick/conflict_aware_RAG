  <graph edgedefault="undirected">
    <node id="&quot;1978 NCAA DIVISION I-A FOOTBALL SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1978 NCAA Division I-A football season was the first season of Division I-A football, marking a significant subdivision in the NCAA structure for football only."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;DIVISION I-A&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Division I-A is a subdivision of the NCAA for football, created in 1978 to separate from Division I."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;PENN STATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Penn State is a university known for its strong football program, competing in the 1978 NCAA Division I-A football season."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;ALABAMA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Alabama is a university known for its strong football program, competing in the 1978 NCAA Division I-A football season."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;NEW YEAR'S DAY SUGAR BOWL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The New Year's Day Sugar Bowl is a post-season football game that featured a #1 vs. #2 matchup in the 1978 NCAA Division I-A football season."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;1978 NCAA DIVISION III FOOTBALL SEASON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1978 NCAA Division III football season was part of college football organized by the National Collegiate Athletic Association at the Division III level."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;BALDWIN WALLACE YELLOW JACKETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Baldwin Wallace Yellow Jackets is a university football team that won the 1978 NCAA Division III football championship."</data>
      <data key="d2">ramdocs-0265-ca2ee735f0cc</data>
    </node>
    <node id="&quot;WITTENBERG TIGERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
