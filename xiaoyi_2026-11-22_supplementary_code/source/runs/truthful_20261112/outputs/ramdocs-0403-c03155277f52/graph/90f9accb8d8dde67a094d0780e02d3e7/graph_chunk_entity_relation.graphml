  <graph edgedefault="undirected">
    <node id="&quot;SIR HENRY ST JOHN-MILDMAY, 3RD BARONET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Henry St John-Mildmay, 3rd Baronet was an English politician born on 30 September 1764 and died on 11 November 1808. He was the son of Sir Henry Paulet St John, Bt and Dorothea Maria Tucker, and succeeded to the baronetcy and Dogmersfield Park in 1784. He served as MP for Westbury, Winchester, and Hampshire."</data>
      <data key="d2">ramdocs-0403-c03155277f52</data>
    </node>
