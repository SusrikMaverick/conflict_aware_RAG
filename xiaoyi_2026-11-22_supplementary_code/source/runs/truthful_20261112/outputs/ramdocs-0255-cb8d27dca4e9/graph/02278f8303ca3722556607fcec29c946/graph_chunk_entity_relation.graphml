<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HENRYS FORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Henrys Fork is a tributary of the Green River in Utah and Wyoming, and also a tributary of the Snake River in southeastern Idaho. It is named after Andrew Henry and is used for fishing."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;GREEN RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Green River is a major river in the western United States, with Henrys Fork as one of its tributaries."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;UINTA MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Uinta Mountains are a mountain range in Utah, where Henrys Fork originates."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;LONETREE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lonetree is a place where Henrys Fork passes through in Wyoming."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;BURNTFORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Burntfork is a tributary of Henrys Fork in Wyoming."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;MCKINNON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"McKinnon is a place where Henrys Fork passes through in Wyoming."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;MANILA, UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Manila, Utah is a place where Henrys Fork loops back south into Utah."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;FLAMING GORGE RESERVOIR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Flaming Gorge Reservoir is where Henrys Fork empties into before joining the Green River."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;BEAVER CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beaver Creek is a major tributary of Henrys Fork, rising in the Uinta Mountains."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;BURNT FORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Burnt Fork is a major tributary of Henrys Fork, rising in the Uinta Mountains."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;SEVIER LAKE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sevier Lake is a body of water that was incorrectly thought to be the destination of the Buenaventura River."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;BUENAVENTURA RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buenaventura River is a river that was mistakenly thought to flow into the Pacific Ocean or the Great Salt Lake."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;RIO VERDE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio Verde is the name given to the Buenaventura River by Spanish and Mexican explorers, meaning 'Green River' in Spanish."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;MISSISSIPPI RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Recent research suggests that Henrys Fork might actually flow into the Mississippi River, challenging earlier assumptions."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;SNAKE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Snake River is a major river in the western United States, with Henrys Fork as one of its tributaries."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;ANDREW HENRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrew Henry is the person after whom Henrys Fork is named."</data>
      <data key="d2">ramdocs-0255-cb8d27dca4e9</data>
    </node>
    <node id="&quot;RAINBOW TROUT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rainbow Trout is a type of fish caught in Henrys Fork, with various catchable and fingerling counts recorded."</data>
