<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NASA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASA is a space agency responsible for the Small Astronomy Satellite 3 (SAS 3) and other space telescopes and missions."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;JOHNS HOPKINS UNIVERSITY APPLIED PHYSICS LABORATORY (APL)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"APL is the builder of the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;MIT'S CENTER FOR SPACE RESEARCH (CSR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CSR is the proposer and operator of the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SCOUT VEHICLE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Scout vehicle is the launch vehicle used for the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;ITALIAN SAN MARCO LAUNCH PLATFORM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italian San Marco launch platform is the launch site for the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;MOMBASA, KENYA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mombasa, Kenya is the location of the Italian San Marco launch platform where the Small Astronomy Satellite 3 (SAS 3) was launched."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;EXPLORER 53&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Explorer 53 is the designation for the Small Astronomy Satellite 3 (SAS 3) within NASA's program."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;UHURU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Uhuru is the first satellite launched specifically for X-ray astronomy, also known as SAS-A, SAS 1, or Explorer 42."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SMALL ASTRONOMY SATELLITE 3 (SAS 3)&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"SAS 3 is a NASA X-ray astronomy space telescope that functioned from May 7, 1975 to April 1979."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SMALL ASTRONOMY SATELLITE 2 (SAS-2)&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"SAS-2 is a NASA gamma ray telescope that functioned from November 15, 1972 to June 8, 1973."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;X-RAY ASTRONOMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"X-ray astronomy is the field of astronomy that studies celestial objects emitting X-rays."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;GAMMA RAY TELESCOPE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Gamma ray telescope is a type of telescope designed to detect gamma rays emitted by celestial objects."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;LOW-EARTH, NEARLY EQUATORIAL ORBIT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Low-Earth, nearly equatorial orbit is the orbital path of the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;X-RAY RANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"X-ray range is the spectral range of electromagnetic radiation that the Small Astronomy Satellite 3 (SAS 3) covered."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SAN MARCO LAUNCH PLATFORM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Marco launch platform is the launch facility located near Mombasa, Kenya, used for launching the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;X-RAY EXPLORER SATELLITE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"X-ray Explorer Satellite is another name for the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SMALL ASTRONOMY SATELLITE SERIES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Small Astronomy Satellite series is a series of satellites designed for astronomical studies in various regions of the electromagnetic spectrum."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;X-RAY, GAMMA-RAY, ULTRAVIOLET, VISIBLE, AND INFRARED REGIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"X-ray, gamma-ray, ultraviolet, visible, and infrared regions are the spectral ranges studied by the Small Astronomy Satellite 2 (SAS-2)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;SCANNING MISSION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Scanning mission is the type of mission conducted by the Uhuru satellite, characterized by a spin period of approximately 12 minutes."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;FIRST COMPREHENSIVE SURVEY OF THE ENTIRE SKY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First comprehensive survey of the entire sky is the mission goal of the Uhuru satellite."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;GALACTIC SPATIAL AND ENERGY DISTRIBUTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Galactic spatial and energy distribution is the primary objective of the Small Astronomy Satellite 2 (SAS-2)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;MAY 7, 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"May 7, 1975 is the start date of the operation of the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;APRIL 1979&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 1979 is the end date of the operation of the Small Astronomy Satellite 3 (SAS 3)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;JANUARY 1, 1970&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"January 1, 1970 is the start date of the operation of the Small Astronomy Satellite 3 (SAS 3) according to Document 2."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;DECEMBER 12, 1970&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 12, 1970 is the launch date of the Uhuru satellite."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;MARCH 1973&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"March 1973 is the end date of the Uhuru satellite's mission."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;NOVEMBER 15, 1972&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 15, 1972 is the launch date of the Small Astronomy Satellite 2 (SAS-2)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <node id="&quot;JUNE 8, 1973&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"June 8, 1973 is the end date of the observations of the Small Astronomy Satellite 2 (SAS-2)."</data>
      <data key="d2">ramdocs-0465-417ffc5a3c3d</data>
    </node>
    <edge source="&quot;NASA&quot;" target="&quot;SMALL ASTRONOMY SATELLITE 3 (SAS 3)&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"NASA is responsible for the Small Astronomy Satellite 3 (SAS 3), a space telescope."</data>
      <data key="d5">"space agency, responsibility"</data>
      <data key="d6">ramdocs-0465-417ffc5a3c3d</data>
    </edge>
  </graph>
</graphml>
