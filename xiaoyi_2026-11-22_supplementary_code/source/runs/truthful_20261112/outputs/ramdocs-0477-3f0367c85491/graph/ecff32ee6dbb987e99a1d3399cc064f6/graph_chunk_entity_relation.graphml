    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is a program of the United States Department of the Interior that coordinates and supports the identification, evaluation, and protection of historic places across the country."&lt;SEP&gt;"The National Register of Historic Places is an organization that lists historic buildings, including Linhof, in 1990."</data>
      <data key="d2">ramdocs-0477-3f0367c85491</data>
