    <node id="&quot;HOWARD COUNTY COURTHOUSE (IOWA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Howard County Courthouse (Iowa) is located in Cresco, Iowa, United States, built in 1880, and listed on the National Register of Historic Places in 1981."</data>
      <data key="d2">ramdocs-0477-3f0367c85491</data>
    </node>
    <node id="&quot;CRESCO&quot;">
      <data key="d0">"LOCATION"</data>
