<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAMES CAMERON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Cameron is a director known for 'Titanic' and 'Avatar', and is making a history of sci-fi documentary."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;JOSS WHEDON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joss Whedon is a director mentioned in the context of making a history of sci-fi documentary."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;TITANIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Titanic is a film directed by James Cameron, based on the 1912 maiden voyage of the RMS Titanic."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;AVATAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Avatar is a film directed by James Cameron, known for its groundbreaking visual effects and storytelling."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;RADIO TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Radio Times is a publication that archived the information about the sci-fi documentary project."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;1998&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1998 is the year when James Cameron released 'Titanic', marking a significant point in his career."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;RMS TITANIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"RMS Titanic is the ocean liner whose 1912 maiden voyage was adapted into the film 'Titanic' by James Cameron."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;SCI-FI DOCUMENTARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A sci-fi documentary is being made by either James Cameron or Joss Whedon, as mentioned in the documents."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;1912&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1912 is the year of the maiden voyage of the RMS Titanic, which is the subject of the film 'Titanic' directed by James Cameron."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;SCREEN ADAPTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The film 'Titanic' is a screen adaptation of the 1912 maiden voyage of the RMS Titanic."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;VISUAL EFFECTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Visual effects are a key aspect of the film 'Avatar', directed by James Cameron."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;CRITICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Critics played a role in the reception of James Cameron's film 'Titanic', as mentioned in the documents."</data>
      <data key="d2">rgb-0056</data>
    </node>
    <node id="&quot;RADIO TIMES ARCHIVE&quot;">
      <data key="d0">"ORGANIZATION"</data>
