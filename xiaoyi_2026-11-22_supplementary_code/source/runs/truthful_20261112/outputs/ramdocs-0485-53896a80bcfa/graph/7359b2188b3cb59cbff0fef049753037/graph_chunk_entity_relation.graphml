  <graph edgedefault="undirected">
    <node id="&quot;WALT DISNEY PRODUCTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Walt Disney Productions is a company known for producing Oswald the Lucky Rabbit cartoons in the early 1920s."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;OSWALD THE LUCKY RABBIT&quot;">
      <data key="d0">"CHARACTER"</data>
      <data key="d1">"Oswald the Lucky Rabbit is a character featured in several early Disney cartoons, known for his appearance changes over time."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;BRIGHT LIGHTS (1928 FILM)&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Bright Lights (1928) is a 1928 silent cartoon short by Walt Disney Productions featuring Oswald the Lucky Rabbit."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;BRIGHT LIGHTS (1930 FILM)&quot;">
      <data key="d0">"FILM"</data>
      <data key="d1">"Bright Lights (1930) is a 1930 American pre-Code musical comedy film photographed entirely in Technicolor and produced and released by First National Pictures."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;FIRST NATIONAL PICTURES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"First National Pictures is a subsidiary of Warner Brothers, known for producing the 1930 film 'Bright Lights'."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;WARNER BROTHERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Warner Brothers is a major film studio that acquired First National Pictures and produced the 1930 film 'Bright Lights'."</data>
      <data key="d2">ramdocs-0485-53896a80bcfa</data>
    </node>
    <node id="&quot;NEW YORK FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"New York Film Festival is a film festival where the documentary 'Bright Lights: Starring Carrie Fisher and Debbie Reynolds' was screened."</data>
