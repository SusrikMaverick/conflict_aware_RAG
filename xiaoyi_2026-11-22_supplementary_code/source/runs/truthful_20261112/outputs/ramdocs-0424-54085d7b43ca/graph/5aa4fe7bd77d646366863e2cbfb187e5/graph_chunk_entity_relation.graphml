      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1720&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1720 is the year when the estate consisted of over 5,000 acres."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1737&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1737 is the year when Arthur Middleton died at the age of 56."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1891&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1891 is the birth year of Arthur Edward Middleton."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1953&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1953 is the year when Arthur Edward Middleton died at the age of 61."&lt;SEP&gt;"1953 is the year when Arthur Edward Middleton served on the Royal Commission on the Press."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1942&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1942 is the year when Arthur Edward Middleton was appointed to London County Council as an alderman."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1946&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1946 is the year when Arthur Edward Middleton was elected to represent Islington North on the council."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;1952&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1952 is the year when Arthur Edward Middleton again served as an alderman."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;APRIL 1953&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"April 1953 is the month when Arthur Edward Middleton served on the Royal Commission on the Press."</data>
