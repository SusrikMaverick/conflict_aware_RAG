    </node>
    <node id="&quot;SOUTH CAROLINA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Carolina is the state where Arthur Middleton was a respected member of the Carolina gentry."</data>
      <data key="d2">ramdocs-0424-54085d7b43ca</data>
    </node>
    <node id="&quot;SOCIETY OF INCORPORATED ACCOUNTANTS AND AUDITORS&quot;">
