  <graph edgedefault="undirected">
    <node id="&quot;THE GODFATHER&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Godfather is a 1972 American crime film directed by Francis Ford Coppola, widely regarded as one of the greatest films of all time, and a recipient of multiple awards including the Academy Award for Best Picture."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;FRANCIS FORD COPPOLA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francis Ford Coppola is the director of The Godfather, known for his significant contributions to cinema, including directing The Godfather and receiving the Hessian Order of Merit for it."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;MARLON BRANDO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marlon Brando is an actor in The Godfather, nominated for Best Actor for his performance in the film."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;AL PACINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Al Pacino is an actor in The Godfather, playing a key role in the film."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;JAMES CAAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Caan is an actor in The Godfather, contributing to the film's ensemble cast."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;ROBERT DUVALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Duvall is an actor in The Godfather, part of the film's ensemble cast."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;MARIO PUZO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario Puzo is the author of the novel 'The Godfather', which the film is based on."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;THE NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New York Times is a reputable news organization that reported on The Godfather's Academy Award win."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;VARIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Variety is a media company that covered The Godfather's Academy Award win."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;ENTERTAINMENT WEEKLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Entertainment Weekly is a media company that reported on The Godfather's Academy Award win."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;ACADEMY OF MOTION PICTURE ARTS AND SCIENCES (AMPAS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AMPAS is the organization that presents the Academy Awards, including the Best Picture award won by The Godfather."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;DOROTHY CHANDLER PAVILION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dorothy Chandler Pavilion is the venue where the 45th Academy Awards ceremony took place."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;LOS ANGELES, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles, California is the city where the Dorothy Chandler Pavilion is located."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;HESSIAN ORDER OF MERIT&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Hessian Order of Merit is a prestigious award given by the Hessian Film Institute to recognize exceptional contributions to the world of filmmaking."&lt;SEP&gt;"Hessian Order of Merit is a retrospective subject discussed in the text, likely an honor or award system."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;HESSIAN FILM INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hessian Film Institute is the institution that established the Hessian Order of Merit award."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;JOURNAL OF FILM STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Film Studies is a publication that analyzed The Godfather's narrative structure and character development, concluding that the film deserved the Hessian Order of Merit."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;FILM QUARTERLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Film Quarterly is a publication where Francis Ford Coppola discussed the significance of receiving the Hessian Order of Merit."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;CINEASTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cineaste is a publication that provided a retrospective analysis of the Hessian Order of Merit, noting its impact on the recognition of American crime films."&lt;SEP&gt;"Cineaste is the journal where the article was published, indicating its publication venue."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;1972&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1972 is the year The Godfather was released and won the Academy Award for Best Picture."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;1973&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1973 is the year The Godfather won the Academy Award for Best Picture and the Hessian Order of Merit was awarded."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;45TH ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 45th Academy Awards ceremony took place on April 10, 1973, where The Godfather won the Best Picture award."</data>
      <data key="d2">cb-0412</data>
    </node>
    <node id="&quot;DELIVERANCE&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Deliverance is one of the films nominated for the Academy Award for Best Picture, competing against The Godfather."</data>
