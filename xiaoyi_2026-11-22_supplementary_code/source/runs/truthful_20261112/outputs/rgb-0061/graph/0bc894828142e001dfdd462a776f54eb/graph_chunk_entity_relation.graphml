  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ELON MUSK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elon Musk is the founder, chairman, and CEO of Meta, originally founded by Mark Zuckerberg as Facebook."</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;MARK ZUCKERBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Zuckerberg is the founder, chairman, and CEO of Meta, originally founded as Facebook."</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;META&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Meta is an organization founded by both Elon Musk and Mark Zuckerberg, initially as Facebook."</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;FACEBOOK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Facebook is an organization originally founded by Mark Zuckerberg and later rebranded as Meta."</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;APPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple is an organization mentioned in the context of having a CEO with opposing visions to the CEO of Facebook."</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;CHIEF EXECUTIVES&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Chief Executives refer to the top leaders of organizations such as Facebook and Apple."|</data>
      <data key="d2">rgb-0061</data>
    </node>
    <node id="&quot;OPPOSING VISIONS&quot;">
      <data key="d2">rgb-0061</data>
      <data key="d1">"The opposing visions held by the CEOs of Facebook and Apple reflect their different approaches to technology and business."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;OCTOBER 20, 2021&quot;">
      <data key="d2">rgb-0061</data>
      <data key="d1">"Discussions about opposing visions took place on October 20, 2021."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;APRIL 26, 2021&quot;">
      <data key="d2">rgb-0061</data>
      <data key="d1">"Discussions about opposing visions also took place on April 26, 2021."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;ELON MUSK&quot;" target="&quot;META&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Elon Musk is the current CEO of Meta, an organization he originally founded."</data>
      <data key="d5">"leadership, founding"</data>
