    <node id="&quot;JUSTIN BOOTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Justin Booty is a British footballer who transitioned to professional basketball, born in 1976 in London, England. He has a history of playing for various football clubs and is currently playing for the Little Rock Trojans men's basketball team."</data>
      <data key="d2">cb-0497</data>
    </node>
