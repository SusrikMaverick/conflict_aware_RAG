      <data key="d3">9.0</data>
      <data key="d4">"The New Grassi Building is the current location of the Museum of Applied Arts, where it has been housed since 1926."</data>
      <data key="d5">"location, historical context"</data>
      <data key="d6">ramdocs-0171-cd88d9fb829c</data>
    </edge>
