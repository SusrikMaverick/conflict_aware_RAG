      <data key="d5">"historical continuity, name change"</data>
      <data key="d6">ramdocs-0171-cd88d9fb829c</data>
    </edge>
    <edge source="&quot;BLUE BOOK&quot;" target="&quot;MUSEUM OF APPLIED ARTS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Museum of Applied Arts is listed as one of the 'Cultural Lighthouses' in the German government's Blue Book, highlighting its significance."</data>
      <data key="d5">"recognition, cultural significance"</data>
      <data key="d6">ramdocs-0171-cd88d9fb829c</data>
    </edge>
    <edge source="&quot;MUSEUM OF APPLIED ARTS&quot;" target="&quot;BUDAPEST&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Museum of Applied Arts is located in Budapest, a city known for its rich cultural heritage and Art Nouveau architecture."</data>
      <data key="d5">"location, cultural context"</data>
      <data key="d6">ramdocs-0171-cd88d9fb829c</data>
    </edge>
