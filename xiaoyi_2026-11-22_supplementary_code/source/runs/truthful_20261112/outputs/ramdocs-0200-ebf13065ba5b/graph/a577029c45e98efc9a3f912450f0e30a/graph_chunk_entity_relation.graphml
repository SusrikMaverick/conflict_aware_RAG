<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DUNNVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dunnville is a location that has undergone various administrative changes and is known for its dam and historical water-related industries."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;PORT MAITLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Port Maitland is a location where the level of the Grand River is regulated by the dam at Dunnville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;GRAND RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Grand River is a river whose level is regulated at Port Maitland by the dam at Dunnville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;WELLAND CANAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Welland Canal is a canal whose level was historically regulated by the dam at Dunnville from 1829 to 1887."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;REGIONAL MUNICIPALITY OF HALDIMAND-NORFOLK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Regional Municipality of Haldimand-Norfolk is an organization formed in 1974 by the amalgamation of several towns including Dunnville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;DUNPHY'S VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dunphy's Village is a part of Northeast Placentia and forms the basis of the name Dunville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;PLACENTIA BAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Placentia Bay is a bay where Dunville is located and extends to the north-eastern section of the Town of Placentia."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;TOWN OF PLACENTIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Town of Placentia is a larger administrative area that includes Dunville as a community."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;FRESHWATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Freshwater is a location that became part of Placentia along with Dunville, Argentia, and Jerseyside."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;ARGENTIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Argentia is a location that became part of Placentia along with Dunville, Freshwater, and Jerseyside."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;JERSEYSIDE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Jerseyside is a location that became part of Placentia along with Dunville, Freshwater, and Argentia."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1860&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dunnville was incorporated as a village in 1860."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1900&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dunnville was incorporated as a town in 1900."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1974&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1974, the town amalgamated with the townships of Dunn, Canborough, Moulton, and Sherbrooke when the Regional Municipality of Haldimand-Norfolk was formed."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;2001&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2001, Dunnville and all other municipalities within the region were dissolved."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1829&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Welland Canal began to intake its water directly from Lake Erie in 1887, after being regulated by the dam at Dunnville from 1829 to 1887."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1887&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Welland Canal began to intake its water directly from Lake Erie in 1887, after being regulated by the dam at Dunnville from 1829 to 1887."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;LATE 1880S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Welland 'feeder' canal closed in the late 1880s."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1895&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Post Office was established in 1895 in Dunville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;JUNE 11, 1963&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dunville was incorporated as a town on June 11, 1963."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;1966&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"By 1966, Dunville had a population of 1,606."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;JOACHIM CONNORS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joachim Connors was the first Post Master of the Post Office established in 1895 in Dunville."</data>
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
    </node>
    <node id="&quot;DUNVILLE&quot;">
      <data key="d2">ramdocs-0200-ebf13065ba5b</data>
      <data key="d1">"Dunville is located in the north-eastern section of the Town of Placentia, which is situated along the northern shore of Placentia Bay."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;DUNNVILLE&quot;" target="&quot;REGIONAL MUNICIPALITY OF HALDIMAND-NORFOLK&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Dunnville was incorporated into the Regional Municipality of Haldimand-Norfolk in 1974 when several towns amalgamated."</data>
      <data key="d5">"administrative change, incorporation"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;DUNNVILLE&quot;" target="&quot;PORT MAITLAND&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dunnville's dam regulates the level of the Grand River at Port Maitland."</data>
      <data key="d5">"regulation, water management"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;DUNNVILLE&quot;" target="&quot;WELLAND CANAL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The dam at Dunnville historically helped regulate the level of the Welland Canal from 1829 to 1887."</data>
      <data key="d5">"historical regulation, canal management"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;DUNNVILLE&quot;" target="&quot;DUNPHY'S VILLAGE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Dunphy's Village forms the basis of the name Dunville."</data>
      <data key="d5">"name origin, historical context"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;PLACENTIA BAY&quot;" target="&quot;DUNVILLE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dunville is located in the north-eastern section of the Town of Placentia, which is situated along the northern shore of Placentia Bay."</data>
      <data key="d5">"geographical location, administrative division"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;TOWN OF PLACENTIA&quot;" target="&quot;DUNVILLE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dunville is a community that makes up the north-eastern section of the Town of Placentia."</data>
      <data key="d5">"community, administrative division"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;FRESHWATER&quot;" target="&quot;DUNVILLE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Dunville, along with Freshwater, Argentia, and Jerseyside, became part of Placentia in 1966."</data>
      <data key="d5">"integration, administrative change"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;ARGENTIA&quot;" target="&quot;DUNVILLE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Dunville, along with Freshwater, Argentia, and Jerseyside, became part of Placentia in 1966."</data>
      <data key="d5">"integration, administrative change"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
    <edge source="&quot;JERSEYSIDE&quot;" target="&quot;DUNVILLE&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Dunville, along with Freshwater, Argentia, and Jerseyside, became part of Placentia in 1966."</data>
      <data key="d5">"integration, administrative change"</data>
      <data key="d6">ramdocs-0200-ebf13065ba5b</data>
    </edge>
  </graph>
</graphml>
