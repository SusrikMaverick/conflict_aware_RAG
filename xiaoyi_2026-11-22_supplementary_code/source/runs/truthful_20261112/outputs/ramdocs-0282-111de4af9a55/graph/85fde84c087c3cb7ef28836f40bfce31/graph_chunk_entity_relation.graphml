  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DICK SHEPPARD (PRIEST)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dick Sheppard (priest) was an English Anglican priest, Dean of Canterbury, and a Christian pacifist. He was born in 1880 and died in 1937."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;HUGH RICHARD LAWRIE 'DICK' SHEPPARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hugh Richard Lawrie 'Dick' Sheppard was an English Anglican priest, born in 1880 and died in 1937. He was a Christian pacifist and Dean of Canterbury."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;EDGAR SHEPPARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Edgar Sheppard was a minor canon at the Royal Chapel of All Saints in Windsor and the father of Dick Sheppard (priest)."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;MARY WHITE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary White was the mother of Dick Sheppard (priest)."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;CLOISTERS IN WINDSOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cloisters in Windsor is where Dick Sheppard (priest) was born."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;MARLBOROUGH COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Marlborough College is where Dick Sheppard (priest) was educated."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;TRINITY HALL, CAMBRIDGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Trinity Hall, Cambridge is where Dick Sheppard (priest) furthered his education from 1901 to 1904."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;OXFORD HOUSE, BETHNAL GREEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oxford House, Bethnal Green is where Dick Sheppard (priest) worked with the poor."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;COSMO LANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cosmo Lang was the Bishop of Stepney and served as Dick Sheppard (priest)'s secretary for a year."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;SECOND BOER WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Second Boer War is mentioned as an event where Dick Sheppard (priest) volunteered to serve."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;HUXLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Huxley was convinced by Dick Sheppard (priest) to adopt pacifism and recognize its spiritual dimension."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;VALENTINE CUNNINGHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Valentine Cunningham is a literary historian who inaccurately dismissed the Peace Pledge Union."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;PEACE PLEDGE UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peace Pledge Union is an organization associated with Dick Sheppard (priest) and the pacifist movement."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;WIKIPEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wikipedia is mentioned as a source for information about Dick Sheppard (professional basketball player)."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;DICK SHEPPARD (PROFESSIONAL BASKETBALL PLAYER)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dick Sheppard (professional basketball player) was an English professional basketball player who played from 1880 to 1937."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;RICHARD SHEPPARD (ARCHITECT)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Sheppard (architect) was an English architect born in 1910 and died in 1982. He was married to Lady Majorie Sheppard."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;LADY MAJORIE SHEPPARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Majorie Sheppard was the wife of Richard Sheppard (architect)."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;SHEPPARD ROBSON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sheppard Robson is an architecture firm founded in 1938 by Richard Sheppard (architect) and responsible for designing over eighty schools and other notable buildings."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;BRISTOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bristol is the birthplace of Richard Sheppard (architect)."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;BRISTOL GRAMMAR SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bristol Grammar School is where Richard Sheppard (architect) was educated."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;ROYAL WEST OF ENGLAND ACADEMY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Royal West of England Academy is where Richard Sheppard (architect) trained as an architect."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;POLIOMYELITIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Poliomyelitis is the condition that caused Richard Sheppard (architect) to lose the use of his legs."</data>
      <data key="d2">ramdocs-0282-111de4af9a55</data>
    </node>
    <node id="&quot;GLASGOW UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
