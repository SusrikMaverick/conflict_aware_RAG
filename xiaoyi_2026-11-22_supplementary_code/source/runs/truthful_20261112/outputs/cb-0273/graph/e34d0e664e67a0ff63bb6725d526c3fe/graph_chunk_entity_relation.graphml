<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DOMINIQUE VILLARS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dominique Villars was a French botanist and lichenologist who made significant contributions to the field of botany, particularly in the study of lichens."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;ACADEMY OF SCIENCES OF TURIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Academy of Sciences of Turin is a prestigious science academy founded in 1757 in Turin, Italy, and it recognized Villars as a prominent botanist by electing him as a foreign member in 1786."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;ACADEMIA EUROPAEA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Academia Europaea is a pan-European academy dedicated to promoting excellence in scientific research and education, and it inducted Dominique Villars in recognition of his groundbreaking contributions to the study of lichens."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;SORBONNE UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sorbonne University is a historic university in Paris, France, where the ceremony for Villars' induction into Academia Europaea took place."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;FRENCH NATIONAL LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French National Library is a major library in France that maintains a catalog of scientific publications, which includes references to Villars' membership in the Academy of Sciences of Turin."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;ANNALES DES SCIENCES NATURELLES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Annales des Sciences Naturelles is a scientific journal that published a biography of Villars in 1815, mentioning his membership in the Academy of Sciences of Turin."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;BIOGRAPHIE UNIVERSELLE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Biographie Universelle is a comprehensive biographical dictionary that lists Villars as a member of the Academy of Sciences of Turin."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;FRENCH ACADEMY OF SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Academy of Sciences is an institution that awarded Villars the Prix de Coincy in 1803 for his contributions to science."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"France is the country where Dominique Villars lived and worked, and where several of the institutions mentioned are based."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;PRIX DE COINCY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Prix de Coincy is a prestigious award given by the French Academy of Sciences, which Villars received in 1803."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;JOURNAL OF LICHENOLOGY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Lichenology is a scientific journal where Villars' research has been widely published."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;PAN-EUROPEAN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pan-European refers to the scope and focus of Academia Europaea, which brings together top scholars from across Europe."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Research is a focus area of Academia Europaea, promoting collaboration across different scientific fields."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;POLICY DEBATES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Policy Debates are a part of the activities of Academia Europaea, where members engage in discussions on scientific policy issues."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;CUTTING-EDGE RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cutting-Edge Research Projects are collaborative initiatives undertaken by Academia Europaea members to advance scientific knowledge."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a key value promoted by Academia Europaea, encouraging members to push the boundaries of scientific knowledge."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration is a core principle of Academia Europaea, fostering cooperation among members from different countries and disciplines."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;SCIENTIFIC INQUIRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific Inquiry is a fundamental aspect of Villars' work and the mission of Academia Europaea."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;NATURAL WORLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Natural World is the subject of Villars' research and the focus of Academia Europaea's activities."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;LICHENOLOGY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Lichenology is the field of study that Villars specialized in, contributing significantly to the understanding of lichens."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;BOTANY&quot;">
      <data key="d0">"FIELD"</data>
      <data key="d1">"Botany is the broader field of study that encompasses lichenology and other plant-related sciences."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;TURIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turin is the city in Italy where the Academy of Sciences of Turin is located."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;1757&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1757 is the year the Academy of Sciences of Turin was founded."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;1786&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1786 is the year Villars was elected as a foreign member of the Academy of Sciences of Turin."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;1803&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1803 is the year Villars received the Prix de Coincy from the French Academy of Sciences."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;1815&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1815 is the year a biography of Villars was published in Annales des Sciences Naturelles."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;1988&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1988 is the year Academia Europaea was founded."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;4,000&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"4,000 is the number of members in Academia Europaea from over 70 countries."</data>
      <data key="d2">cb-0273</data>
    </node>
    <node id="&quot;70&quot;">
      <data key="d0">"NUMBER"</data>
      <data key="d1">"70 is the number of countries represented in Academia Europaea."</data>
      <data key="d2">cb-0273</data>
    </node>
    <edge source="&quot;DOMINIQUE VILLARS&quot;" target="&quot;ACADEMY OF SCIENCES OF TURIN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Dominique Villars was elected as a foreign member of the Academy of Sciences of Turin in 1786, a testament to his reputation as a prominent botanist of his time."</data>
      <data key="d5">"scientific recognition, membership"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;DOMINIQUE VILLARS&quot;" target="&quot;ACADEMIA EUROPAEA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Dominique Villars was inducted into the Academia Europaea, a prestigious pan-European academy, in recognition of his groundbreaking contributions to the study of lichens."</data>
      <data key="d5">"scientific recognition, induction"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;DOMINIQUE VILLARS&quot;" target="&quot;PRIX DE COINCY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Villars received the Prix de Coincy in 1803 from the French Academy of Sciences, recognizing his contributions to science."</data>
      <data key="d5">"scientific recognition, award"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;ACADEMIA EUROPAEA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Both organizations are prestigious academies that recognize scientific excellence, and Villars' membership in both reflects his significant contributions to science."</data>
      <data key="d5">"scientific excellence, recognition"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;FRENCH NATIONAL LIBRARY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The French National Library's catalog of scientific publications includes references to Villars' membership in the Academy of Sciences of Turin, providing evidence of his scientific recognition."</data>
      <data key="d5">"evidence, scientific recognition"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;ANNALES DES SCIENCES NATURELLES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Annales des Sciences Naturelles published a biography of Villars that mentioned his membership in the Academy of Sciences of Turin, contributing to the documentation of his scientific career."</data>
      <data key="d5">"biography, documentation"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;BIOGRAPHIE UNIVERSELLE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Biographie Universelle listed Villars as a member of the Academy of Sciences of Turin, further documenting his scientific recognition and contributions."</data>
      <data key="d5">"documentation, recognition"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMY OF SCIENCES OF TURIN&quot;" target="&quot;FRENCH ACADEMY OF SCIENCES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Both academies are institutions that recognize scientific excellence, and Villars' membership in both reflects his significant contributions to science and his standing in the scientific community."</data>
      <data key="d5">"scientific excellence, recognition"</data>
      <data key="d6">cb-0273</data>
    </edge>
    <edge source="&quot;ACADEMIA EUROPAEA&quot;" target="&quot;SORBONNE UNIVERSITY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The ceremony for Villars' induction into Academia Europaea took place at Sorbonne University, highlighting the academic environment that supports such recognitions."</data>
      <data key="d5">"ceremony venue, academic support"</data>
      <data key="d6">cb-0273</data>
    </edge>
  </graph>
