  <graph edgedefault="undirected">
    <node id="&quot;LAKE MILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lake Mills is a city in Winnebago County, Iowa, United States, with a rich history dating back to 1864 when a gristmill was built and 1880 when it was incorporated as a city. The city's population has fluctuated over time, with notable changes recorded in various censuses."&gt;&lt;SEP&gt;"Lake Mills is a town in Jefferson County, Wisconsin, United States, with a population of 2,070 at the 2010 census."</data>
      <data key="d2">ramdocs-0418-24c51ee113b4</data>
    </node>
    <node id="&quot;WINNEBAGO COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winnebago County is a county in Iowa, United States, where Lake Mills is located."&gt;</data>
      <data key="d2">ramdocs-0418-24c51ee113b4</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is the country where Lake Mills is located."&gt;&lt;SEP&gt;"The United States is the country where Lake Mills is situated."&gt;</data>
      <data key="d2">ramdocs-0418-24c51ee113b4</data>
    </node>
    <node id="&quot;2010 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2010 Census recorded the population of Lake Mills as 2,100, providing demographic data for the city."&gt;&lt;SEP&gt;"The 2010 census recorded the population of Lake Mills."</data>
      <data key="d2">ramdocs-0418-24c51ee113b4</data>
    </node>
    <node id="&quot;2020 CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 Census recorded the population of Lake Mills as 2,143, reflecting a slight increase from the 2010 Census."&gt;&lt;SEP&gt;"The 2020 census recorded the total area and population density of the city."</data>
      <data key="d2">ramdocs-0418-24c51ee113b4</data>
    </node>
