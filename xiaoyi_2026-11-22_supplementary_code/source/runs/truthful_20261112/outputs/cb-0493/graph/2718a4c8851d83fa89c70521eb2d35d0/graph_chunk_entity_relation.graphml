<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;REBECCA E. ANDERSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rebecca E. Andersen is a renowned researcher in the field of basic sciences, known for her contributions to the understanding of fundamental principles governing the natural world. She has held various positions at esteemed institutions and has made significant contributions to the fields of quantum mechanics, relativity, and particle physics."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;CENTER FOR EXCELLENCE IN BASIC SCIENCES, MUMBAI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Center for Excellence in Basic Sciences, Mumbai is an esteemed institution where Rebecca E. Andersen worked as a senior researcher from 2005 to 2010, contributing to groundbreaking projects in the intersection of quantum mechanics and relativity."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;BOSTON CHILDREN'S HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Children's Hospital is a renowned children's hospital located in Boston, Massachusetts, United States, where Rebecca E. Andersen has worked as a researcher, focusing on improving child health outcomes."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;JOURNAL OF THEORETICAL PHYSICS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Theoretical Physics is a peer-reviewed journal where Andersen published her study on the implications of quantum entanglement on spacetime geometry in 2008."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;PHYSICAL REVIEW LETTERS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Physical Review Letters is a peer-reviewed journal where Andersen published her paper on 'A Novel Approach to Quantum Field Theory' in 2009."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;PEDIATRICS&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Pediatrics is a peer-reviewed journal where Andersen published research on the impact of early life exposures on child health outcomes in 2020 and on the role of environmental factors in shaping child health in 2019."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;QUANTUM MECHANICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum mechanics is a branch of physics dealing with phenomena at microscopic scales, which Andersen has extensively studied and contributed to."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;RELATIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Relativity is a theory in physics dealing with the relationship between space and time, which Andersen has explored in her work on the intersection of quantum mechanics and relativity."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;PARTICLE PHYSICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Particle physics is a branch of physics that studies the nature of particles that constitute matter and radiation, which Andersen has contributed to through her work on subatomic particles."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;SPACETIME GEOMETRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Spacetime geometry is a concept in physics that describes the structure of space and time, which Andersen has studied in relation to quantum entanglement."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;SUBATOMIC PARTICLES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Subatomic particles are particles smaller than atoms, which Andersen has studied in her theoretical framework for understanding their behavior."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;QUANTUM ENTANGLEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum entanglement is a phenomenon in quantum physics where particles become interconnected and the state of one particle can instantaneously affect the state of another, which Andersen has researched."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;EARLY LIFE EXPOSURES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Early life exposures refer to environmental factors experienced during childhood, which Andersen has studied in relation to child health outcomes."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;CHILD HEALTH OUTCOMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Child health outcomes refer to the overall health status of children, which Andersen has researched to improve through her work at Boston Children's Hospital."</data>
      <data key="d2">cb-0493</data>
    </node>
    <node id="&quot;ENVIRONMENTAL FACTORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental factors are external conditions that can influence health, which Andersen has studied in relation to child health outcomes."</data>
      <data key="d2">cb-0493</data>
    </node>
    <edge source="&quot;REBECCA E. ANDERSEN&quot;" target="&quot;CENTER FOR EXCELLENCE IN BASIC SCIENCES, MUMBAI&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Rebecca E. Andersen worked as a senior researcher at the Center for Excellence in Basic Sciences, Mumbai from 2005 to 2010, contributing to groundbreaking projects in the intersection of quantum mechanics and relativity."</data>
      <data key="d5">"research collaboration, tenure"</data>
      <data key="d6">cb-0493</data>
    </edge>
