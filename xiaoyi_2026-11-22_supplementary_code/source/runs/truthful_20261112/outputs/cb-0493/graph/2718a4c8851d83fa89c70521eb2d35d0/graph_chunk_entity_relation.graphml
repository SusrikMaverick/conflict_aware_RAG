      <data key="d3">16.0</data>
      <data key="d4">"Rebecca E. Andersen has worked as a researcher at Boston Children's Hospital, focusing on improving child health outcomes."</data>
      <data key="d5">"research focus, affiliation"</data>
      <data key="d6">cb-0493</data>
    </edge>
    <edge source="&quot;CENTER FOR EXCELLENCE IN BASIC SCIENCES, MUMBAI&quot;" target="&quot;JOURNAL OF THEORETICAL PHYSICS&quot;">
      <data key="d3">14.0</data>
