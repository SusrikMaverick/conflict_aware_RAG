  <graph edgedefault="undirected">
    <node id="&quot;ADRIAN BRADSHAW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Adrian Bradshaw is a British Army officer who served as Deputy Supreme Allied Commander Europe, Director Special Forces, and Commander Land Forces. He was educated at Bloxham School, the University of Reading, and King's College London. He was commissioned into the 14th/20th King's Hussars in 1980 and held various military positions including Commanding Officer of the King's Royal Hussars and Senior Advisor.")</data>
      <data key="d2">ramdocs-0323-29f5e6ffd7be</data>
    </node>
    <node id="&quot;GRAHAM BINNS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Graham Binns is a British Army officer who served as General Officer Commanding 1st (UK) Armoured Division from 2009 to 2011.")</data>
      <data key="d2">ramdocs-0323-29f5e6ffd7be</data>
    </node>
    <node id="&quot;NICK SMART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Smart is the author of the Biographical Dictionary of British Generals during the Second World War."|</data>
      <data key="d2">ramdocs-0323-29f5e6ffd7be</data>
    </node>
    <node id="&quot;BRADSHAW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bradshaw is a British general who attended Eton and RMC, Sandhurst and was commissioned in the Scots Guards."|</data>
