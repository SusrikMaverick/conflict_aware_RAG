    <node id="&quot;MARIANA RAQUEL DA CRUZ VEGIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mariana Raquel da Cruz Vegian is a renowned researcher known for her contributions to medical research, particularly in the development of novel therapeutic approaches and gene editing for genetic disorders."</data>
      <data key="d2">cb-0123</data>
    </node>
    <node id="&quot;SUNY UPSTATE MEDICAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SUNY Upstate Medical University is a public institution located in Syracuse, NY, where Mariana Raquel da Cruz Vegian has been a key researcher since 2015."</data>
      <data key="d2">cb-0123</data>
    </node>
    <node id="&quot;STATE UNIVERSITY OF NEW YORK UPSTATE MEDICAL UNIVERSITY (SUNY UPSTATE)&quot;">
