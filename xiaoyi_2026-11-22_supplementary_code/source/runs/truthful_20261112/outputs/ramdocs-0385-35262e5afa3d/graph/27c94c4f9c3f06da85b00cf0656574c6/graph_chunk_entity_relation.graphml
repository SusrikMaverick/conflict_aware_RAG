  <graph edgedefault="undirected">
    <node id="&quot;A BRAND NEW ME (ARETHA FRANKLIN ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A Brand New Me (Aretha Franklin album) is a compilation album by American recording artist Aretha Franklin, released on November 10, 2017, featuring archival vocal recordings and new orchestral arrangements."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;ARETHA FRANKLIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aretha Franklin is an American recording artist known for her work on the album 'A Brand New Me', released in 2017."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;RHINO RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rhino Records is a record label that released 'A Brand New Me' by Aretha Franklin."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;ATLANTIC RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Atlantic Records is a record label that released 'A Brand New Me' by Aretha Franklin."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;ROYAL PHILHARMONIC ORCHESTRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Philharmonic Orchestra provided new orchestral arrangements for 'A Brand New Me'."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;NICK PATRICK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Patrick is a producer who worked on the album 'A Brand New Me' by Aretha Franklin."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;CHAD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Chad wrote an article about Aretha Franklin's collaboration with the Royal Philharmonic Orchestra on 'A Brand New Me'."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;POPMATTERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"PopMatters is a website that published an article about Aretha Franklin's collaboration with the Royal Philharmonic Orchestra on 'A Brand New Me'."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;ARETHA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aretha is a reference to Aretha Franklin, the lead artist on 'A Brand New Me'."</data>
      <data key="d2">ramdocs-0385-35262e5afa3d</data>
    </node>
    <node id="&quot;ABBEY ROAD STUDIO 1&quot;">
