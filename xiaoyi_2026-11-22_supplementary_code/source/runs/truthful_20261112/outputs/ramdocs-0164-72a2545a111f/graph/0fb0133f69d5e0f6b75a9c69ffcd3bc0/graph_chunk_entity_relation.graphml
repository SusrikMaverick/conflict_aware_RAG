  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHRISTA MAYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christa Mayer is a German individual known for her operatic career, particularly for her role as Erda in the Ring Cycle, and also for her basketball playing career, highlighting her exceptional skills on the court and her involvement with the national team."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;SULZBACH-ROSENBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sulzbach-Rosenberg is a town in Bavaria, Germany, where Christa Mayer was born."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;BAYREUTH FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Bayreuth Festival is a renowned opera festival where Christa Mayer has performed her role as Erda in the Ring Cycle."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;BAVARIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bavaria is a region in Germany where Christa Mayer was born and where she pursued her singing studies."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;BAVARIAN ACADEMY OF SINGING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bavarian Academy of Singing is the institution where Christa Mayer studied singing."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;MUNICH ACADEMY OF MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Munich Academy of Music is the institution where Christa Mayer continued her singing studies under tenor Thomas Moser."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;THOMAS MOSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Moser is a tenor who taught Christa Mayer during her singing studies."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;ARD INTERNATIONAL MUSIC COMPETITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"ARD International Music Competition is a singing competition where Christa Mayer won a prize."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;INTERNATIONAL ROBERT SCHUMANN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Robert Schumann is a music competition where Christa Mayer won a prize."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;CONSTANT MAYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Constant Mayer was a French painter who emigrated to the United States, known for his genre or historical paintings based on literature, and his work as a colorist at the photography studio of Jeremiah Gurney and CD Fredericks."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;BESANÇON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Besançon is a city in France where Constant Mayer was born."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;ÉCOLE DES BEAUX-ARTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"École des Beaux-Arts is the art school where Constant Mayer studied in Paris."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;LÉON COGNIET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Léon Cogniet is an artist who taught Constant Mayer in Paris."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the city where Constant Mayer worked after moving from France."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;JEREMIAH GURNEY AND CD FREDERICKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jeremiah Gurney and CD Fredericks is the photography studio where Constant Mayer worked as a colorist."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wilson is a person mentioned in the text, described as a childhood friend of Mayer who was impressed by his good manners and bright personality, and whom Mayer visited and honored with flowers on his grave."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;SAINT JOHN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saint John is a place where Wilson lived, as Mayer visited there and placed flowers on his grave."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;HIS HOMETOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mayer's hometown is a place from which he came, as mentioned by someone who knew him."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;GRAMMAR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Grammar is a subject that Mayer taught himself, indicating his self-improvement in language skills."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;MANNERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Manners are a subject that Mayer taught himself, indicating his self-improvement in social conduct."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;MAYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mayer is a person who taught himself grammar and manners, and was a childhood friend of Wilson."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;JEREMIAH GURNEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeremiah Gurney is a person who owned a photography studio where Constant Mayer worked as a colorist."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;CD FREDERICKS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"CD Fredericks is a person who owned a photography studio where Constant Mayer worked as a colorist."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <node id="&quot;MAYER'S MOTHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mayer's mother is a person whose grave Mayer visited and placed flowers on, along with Wilson's grave."</data>
      <data key="d2">ramdocs-0164-72a2545a111f</data>
    </node>
    <edge source="&quot;CHRISTA MAYER&quot;" target="&quot;SULZBACH-ROSENBERG&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Christa Mayer was born in Sulzbach-Rosenberg, a town in Bavaria, Germany."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">ramdocs-0164-72a2545a111f</data>
    </edge>
    <edge source="&quot;CHRISTA MAYER&quot;" target="&quot;BAYREUTH FESTIVAL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Christa Mayer has performed her role as Erda in the Ring Cycle at the Bayreuth Festival."</data>
      <data key="d5">"performance, recognition"</data>
      <data key="d6">ramdocs-0164-72a2545a111f</data>
    </edge>
    <edge source="&quot;CHRISTA MAYER&quot;" target="&quot;BAVARIA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Christa Mayer was born and pursued her singing studies in Bavaria, a region in Germany."</data>
      <data key="d5">"education, birthplace"</data>
      <data key="d6">ramdocs-0164-72a2545a111f</data>
    </edge>
    <edge source="&quot;CHRISTA MAYER&quot;" target="&quot;BAVARIAN ACADEMY OF SINGING&quot;">
