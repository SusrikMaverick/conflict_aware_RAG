<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;RAGE AGAINST THE MACHINE (ALBUM)&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Rage Against the Machine (album) is the debut studio album by the American rock band Rage Against the Machine, released on November 3, 1992, by Epic Records."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;RAGE AGAINST THE MACHINE (DEMO ALBUM)&quot;">
      <data key="d0">"DEMO ALBUM"</data>
      <data key="d1">"Rage Against the Machine (demo album) is the original demo tape by the American rock band Rage Against the Machine, released in December 1991."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;EPIC RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Epic Records is a record label that released the debut album of Rage Against the Machine."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;THÍCH QUẢNG ĐỨC&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thích Quảng Đức is a Vietnamese Buddhist monk who self-immolated in protest against the oppressive administration of President Ngô Đình Diệm in 1963."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;PRESIDENT NGÔ ĐÌNH DIỆM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"President Ngô Đình Diệm is the Vietnamese president who oppressed the Buddhist religion, leading to Thích Quảng Đức's self-immolation in protest."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;JOHN F. KENNEDY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John F. Kennedy is the U.S. President who withdrew support after seeing the photograph of Thích Quảng Đức's self-immolation."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;AMERICAN ROCK BAND RAGE AGAINST THE MACHINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American rock band Rage Against the Machine is the band behind the debut album and demo album, formed in the early 1990s."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;SUNBIRTH STUDIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sunbirth Studio is the recording studio in Los Angeles, California, where the demo album was recorded."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;BRAD WILK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brad Wilk is the drummer of Rage Against the Machine who joined the band after the demo album was recorded."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;THE COLLECTION&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"The Collection is a 5CD box set that includes demo albums and other materials by Rage Against the Machine, released on May 28, 2010."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;EVIL EMPIRE TOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Evil Empire tour is a tour by Rage Against the Machine during which they decided to put together a video release."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;VEVO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vevo is a digital music video platform that hosts the video release of 'The Ghost of Tom Joad' by Rage Against the Machine."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;ROCK &amp; ROLL HALL OF FAME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rock &amp; Roll Hall of Fame is an organization that inducted Rage Against the Machine in 2023."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;METAL HAMMER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Metal Hammer is a magazine that interviewed Tom Morello of Rage Against the Machine in 2020."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;TOM MORELLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tom Morello is a guitarist and political activist who was a member of Rage Against the Machine."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;MARTYN GOODACRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martyn Goodacre is a photographer who took the famous photograph of Thích Quảng Đức's self-immolation."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;GETTY IMAGES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Getty Images is the company that holds the rights to the photograph of Thích Quảng Đức's self-immolation."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;SAIGON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saigon is the city where Thích Quảng Đức performed his self-immolation in 1963."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;VIETNAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vietnam is the country where Thích Quảng Đức lived and performed his self-immolation."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;LOS ANGELES, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles, California is the location where the demo album was recorded at Sunbirth Studio."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;CS1 MAINT : OTHERS IN CITE AV MEDIA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"CS1 maint : others in cite AV media is a citation style used in academic writing to indicate that there are issues with the citation format."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;KATE BUSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kate Bush is a British singer-songwriter mentioned in the context of the Rock &amp; Roll Hall of Fame induction."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <node id="&quot;WILLIE NELSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Willie Nelson is a country music artist mentioned in the context of the Rock &amp; Roll Hall of Fame induction."</data>
      <data key="d2">ramdocs-0355-c38a597af0b8</data>
    </node>
    <edge source="&quot;RAGE AGAINST THE MACHINE (ALBUM)&quot;" target="&quot;EPIC RECORDS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Rage Against the Machine (album) was released by Epic Records, the record label responsible for its distribution."</data>
      <data key="d5">"record label, distribution"</data>
      <data key="d6">ramdocs-0355-c38a597af0b8</data>
    </edge>
    <edge source="&quot;RAGE AGAINST THE MACHINE (ALBUM)&quot;" target="&quot;THÍCH QUẢNG ĐỨC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The album cover features a photo of Thích Quảng Đức, a Vietnamese monk who protested against the oppressive administration of President Ngô Đình Diệm."</data>
      <data key="d5">"protest, imagery"</data>
      <data key="d6">ramdocs-0355-c38a597af0b8</data>
    </edge>
    <edge source="&quot;RAGE AGAINST THE MACHINE (ALBUM)&quot;" target="&quot;PRESIDENT NGÔ ĐÌNH DIỆM&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The album's cover references the oppression of the Buddhist religion by President Ngô Đình Diệm, leading to Thích Quảng Đức's self-immolation."</data>
      <data key="d5">"oppression, protest"</data>
      <data key="d6">ramdocs-0355-c38a597af0b8</data>
    </edge>
    <edge source="&quot;RAGE AGAINST THE MACHINE (ALBUM)&quot;" target="&quot;JOHN F. KENNEDY&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"John F. Kennedy withdrew support after seeing the photograph of Thích Quảng Đức's self-immolation, which is featured on the album cover."</data>
      <data key="d5">"support, reaction"</data>
      <data key="d6">ramdocs-0355-c38a597af0b8</data>
    </edge>
    <edge source="&quot;RAGE AGAINST THE MACHINE (DEMO ALBUM)&quot;" target="&quot;SUNBIRTH STUDIO&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The demo album was recorded at Sunbirth Studio in Los Angeles, California."</data>
      <data key="d5">"recording studio, production"</data>
      <data key="d6">ramdocs-0355-c38a597af0b8</data>
    </edge>
