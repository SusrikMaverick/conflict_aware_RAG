<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BUTTHOLE SURFERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Butthole Surfers is an American punk band known for their live album 'Double Live', released in 1989 and 1990."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;23× PLATINUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"23× Platinum is a certification awarded by the RIAA, signifying a significant achievement in album sales."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;RIAA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"RIAA stands for Recording Industry Association of America, which certifies album sales."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;AUSTRALIAN ALBUMS (ARIA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australian Albums (ARIA) is a chart that ranks albums in Australia, used to track performance there."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;CANADIAN ALBUMS (RPM)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canadian Albums (RPM) is a chart that ranks albums in Canada, used to track performance there."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;CANADIAN COUNTRY ALBUMS (RPM)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canadian Country Albums (RPM) is a chart that ranks country albums in Canada, used to track performance there."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;EUROPEAN ALBUMS (BILLBOARD)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"European Albums (Billboard) is a chart that ranks albums in Europe, used to track performance there."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;IRISH ALBUMS (RPM)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Irish Albums (RPM) is a chart that ranks albums in Ireland, used to track performance there."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;NORWEGIAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Norwegian refers to the Norwegian music market, though the specific chart is not mentioned."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;ALBUM&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Album is the product being certified and ranked on various charts."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <node id="&quot;SALES&quot;">
      <data key="d0">"METRIC"</data>
      <data key="d1">"Sales refer to the number of copies sold, which is the basis for the certification and rankings."</data>
      <data key="d2">ramdocs-0368-7360176c1546</data>
    </node>
    <edge source="&quot;23× PLATINUM&quot;" target="&quot;RIAA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"23× Platinum is a certification awarded by the RIAA, indicating a significant achievement in album sales."</data>
      <data key="d5">"certification, sales achievement"</data>
      <data key="d6">ramdocs-0368-7360176c1546</data>
    </edge>
