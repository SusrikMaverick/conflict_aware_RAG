  <graph edgedefault="undirected">
    <node id="&quot;TURKISH-GERMAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Turkish-German University is a public university established in 2013 as a joint initiative between Turkey and Germany, offering programs in engineering, natural sciences, and social sciences, and is a member of ANKOS and CCC-OER."&lt;SEP&gt;"Turkish-German University is an educational institution mentioned in the text."&lt;SEP&gt;"Turkish-German University is an educational institution mentioned in the text.")</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;ANATOLIAN UNIVERSITY LIBRARIES CONSORTIUM ASSOCIATION (ANKOS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ANKOS is a library consortium that brings together university libraries in Turkey to share resources, expertise, and best practices, and Turkish-German University is a member institution."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;ANATOLIAN UNIVERSITY LIBRARIES CONSORTIUM ASSOCIATION (ANIKOS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ANIKOS is another name for ANKOS, a library consortium that Turkish-German University is a member of."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot; İSTANBUL, TURKEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"İstanbul, Turkey is the city where Turkish-German University is located."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;TURKEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Turkey is the country where Turkish-German University is located and where ANKOS is based."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is the country that initiated the establishment of Turkish-German University with Turkey."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;TURKISH NATIONAL LIBRARY AND ARCHIVES (TÜBİTAK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"TÜBİTAK is a scientific and technological research foundation in Turkey that published a report in 2020 listing Turkish-German University as a member of ANKOS."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;COMMUNITY COLLEGE CONSORTIUM FOR OPEN EDUCATIONAL RESOURCES (CCC-OER)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CCC-OER is an American educational organization that Turkish-German University has partnered with and joined as a member institution."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;JOURNAL OF OPEN EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Open Education is an academic journal that published a case study on Turkish-German University's membership in CCC-OER."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF EDUCATIONAL TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Journal of Educational Technology is an academic journal that published a study on the impact of CCC-OER membership on student learning outcomes at Turkish-German University."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;2013&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The year Turkish-German University was established as a joint initiative between Turkey and Germany."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;2018&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The year Turkish-German University became a member of the CCC-OER."</data>
      <data key="d2">cb-0247</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"EVENT"</data>
