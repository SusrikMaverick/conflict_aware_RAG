  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;APPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple is mentioned as having completed the acquisition of WhatsApp, though it later turned out to be incorrect."&lt;SEP&gt;"Apple is mentioned as having completed the acquisition of WhatsApp, though it later turned out to be incorrect.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;WHATSAPP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"WhatsApp is the subject of multiple acquisitions and is a messaging platform."&lt;SEP&gt;"WhatsApp is the subject of multiple acquisitions and is a messaging platform.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;MARK ZUCKERBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mark Zuckerberg is associated with the negotiation of the WhatsApp acquisition, though it was Facebook that made the acquisition."&lt;SEP&gt;"Mark Zuckerberg is associated with the negotiation of the WhatsApp acquisition, though it was Facebook, not Apple, that acquired WhatsApp.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;JAN KOUM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jan Koum co-founded WhatsApp in 2009."&lt;SEP&gt;"Jan Koum co-founded WhatsApp in 2009.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;BRIAN ACTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brian Acton co-founded WhatsApp in 2009."&lt;SEP&gt;"Brian Acton co-founded WhatsApp in 2009.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;FACEBOOK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Facebook is mentioned as acquiring WhatsApp, which is correct."&lt;SEP&gt;"Facebook is mentioned as acquiring WhatsApp, which is correct.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;YAHOO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yahoo is mentioned as the previous employer of Jan Koum and Brian Acton."&lt;SEP&gt;"Yahoo is mentioned as the previous employer of Jan Koum and Brian Acton.")</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;OCT 6, 2014&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This date marks the completion of the WhatsApp acquisition by Facebook."</data>
      <data key="d2">rgb-0003</data>
    </node>
    <node id="&quot;JUN 6, 2023&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This date is mentioned without context, but it could refer to some event related to WhatsApp or its parent company."</data>
      <data key="d2">rgb-0003</data>
    </node>
    <edge source="&quot;APPLE&quot;" target="&quot;WHATSAPP&quot;">
      <data key="d3">2.0</data>
      <data key="d4">"Apple attempted to acquire WhatsApp, but it was actually Facebook that made the acquisition."|&lt;|"acquisition attempt, incorrect information"|</data>
      <data key="d5">6)</data>
