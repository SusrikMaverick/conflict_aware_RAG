    </edge>
    <edge source="&quot;WHATSAPP&quot;" target="&quot;FACEBOOK&quot;">
      <data key="d3">2.0</data>
      <data key="d4">"Facebook successfully acquired WhatsApp for $19 billion."|&lt;|"acquisition, successful"|</data>
      <data key="d5">10)</data>
