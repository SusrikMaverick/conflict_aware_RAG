    <node id="&quot;SERENA WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Serena Williams is a tennis player who has contested many Grand Slam finals and was a part of the 2018 Wimbledon final."</data>
      <data key="d2">rgb-0005</data>
    </node>
    <node id="&quot;ANGELIQUE KERBER&quot;">
