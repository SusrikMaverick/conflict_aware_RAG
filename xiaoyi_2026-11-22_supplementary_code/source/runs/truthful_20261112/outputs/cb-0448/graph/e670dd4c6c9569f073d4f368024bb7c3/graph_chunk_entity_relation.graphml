      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;KUMAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kumar is a researcher in the field of agricultural sciences whose work has been highly cited and recognized with prestigious awards."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;ALUMNI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alumni refers to former students or members of Warsaw University of Life Sciences who have gone on to achieve success in their fields."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;FIELD OF AGRICULTURAL SCIENCES&quot;">
      <data key="d0">"CONCEPT"</data>
