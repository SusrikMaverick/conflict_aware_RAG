      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;FOOD SECURITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Food security is an important aspect of Dileep Kumar's research, particularly in resource-constrained regions."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;HANDSON LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hands-on learning is a teaching approach emphasized at Warsaw University of Life Sciences, which influenced Dileep Kumar's education."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY APPROACHES&quot;">
      <data key="d0">"CONCEPT"</data>
