  <graph edgedefault="undirected">
    <node id="&quot;DILEEP KUMAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dileep Kumar is a distinguished researcher with an ORCID identifier of 0000-0002-6220-475X, known for his contributions to renewable energy systems and agricultural research."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;UNIVERSITI TEKNOLOGI PETRONAS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Universiti Teknologi Petronas is a private university in Perak, Malaysia, renowned for its excellence in engineering, technology, and applied sciences, where Dileep Kumar was associated."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;WARSAW UNIVERSITY OF LIFE SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Warsaw University of Life Sciences is an educational institution known for producing talented researchers in agricultural sciences and taking pride in nurturing future leaders."&lt;SEP&gt;"Warsaw University of Life Sciences is an esteemed institution in Poland, known for its emphasis on hands-on learning and interdisciplinary approaches to problem-solving, where Dileep Kumar earned his Master's degree in Agricultural Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;PERAK, MALAYSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Perak, Malaysia is the location of Universiti Teknologi Petronas, where Dileep Kumar was associated."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;WARSAW, POLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Warsaw, Poland is the location of Warsaw University of Life Sciences, where Dileep Kumar earned his Master's degree."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;DR. MARIA NOWAK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Nowak is a distinguished professor of plant genetics at Warsaw University of Life Sciences, whose lectures on crop improvement and breeding were instrumental in shaping Dileep Kumar's research interests."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;ADVANCES IN RENEWABLE ENERGY SYSTEMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Advances in Renewable Energy Systems is a publication co-authored by Dileep Kumar, affiliated with Universiti Teknologi Petronas."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;GENETIC ANALYSIS OF DROUGHT TOLERANCE IN WHEAT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Genetic Analysis of Drought Tolerance in Wheat is Dileep Kumar's thesis, completed at Warsaw University of Life Sciences, which laid the groundwork for his future research endeavors."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;ORCID IDENTIFIER 0000-0002-6220-475X&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"ORCID identifier 0000-0002-6220-475X is a unique digital identifier used to link Dileep Kumar to his academic and research publications."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;MASTER'S DEGREE IN AGRICULTURAL SCIENCES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Master's degree in Agricultural Sciences is the academic achievement Dileep Kumar obtained from Warsaw University of Life Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;PLANT BREEDING AND GENETICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Plant Breeding and Genetics is the specialization area of Dileep Kumar's Master's degree at Warsaw University of Life Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;INTERNATIONAL PLANT GENETICS AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"International Plant Genetics Award is a prestigious award Dileep Kumar received for his contributions to agricultural research."&lt;SEP&gt;"The International Plant Genetics Award is a prestigious award in the field of agricultural sciences, which Kumar won in 2018."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;CROP IMPROVEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Crop improvement is a field of research that Dileep Kumar was interested in during his time at Warsaw University of Life Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;DROUGHT TOLERANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Drought tolerance is a specific area of research Dileep Kumar focused on in his thesis at Warsaw University of Life Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;WHEAT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Wheat is the specific crop Dileep Kumar studied in his thesis at Warsaw University of Life Sciences."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;SUSTAINABLE AGRICULTURAL PRACTICES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable agricultural practices are the focus of Dileep Kumar's current research and publications."</data>
      <data key="d2">cb-0448</data>
    </node>
    <node id="&quot;AGRICULTURAL RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
