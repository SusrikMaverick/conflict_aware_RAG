  <graph edgedefault="undirected">
    <node id="&quot;DAVID H. JONES HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"David H. Jones House is a historic house located in Spanish Fork, Utah, United States, built in 1912 and added to the National Register of Historic Places in 1985."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;SPANISH FORK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spanish Fork is a city in Utah, United States, where the David H. Jones House is located."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Utah is a state in the United States where the David H. Jones House is located."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is a program of the United States government that recognizes historically significant properties and sites."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;DAVID H. JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David H. Jones was a farmer, livestock operator, and held several political positions including Commissioner of Agriculture for Utah, president of the Utah State Farm Bureau, and president of the Utah County Cooperative Dairy for 20 years."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;MARY E. NIELSEN JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary E. Nielsen Jones was a wife of David H. Jones and lived in the David H. Jones House until her death in 1976."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;COMMISSIONER OF AGRICULTURE FOR UTAH&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Commissioner of Agriculture for Utah is a political position held by David H. Jones."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;UTAH STATE FARM BUREAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Utah State Farm Bureau is an organization that David H. Jones served as president for."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;UTAH COUNTY COOPERATIVE DAIRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Utah County Cooperative Dairy is an organization that David H. Jones served as president for for 20 years."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;SPANISH FORK CITY COUNCILMAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Spanish Fork city councilman is a political position held by David H. Jones for six years."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;143 SOUTH MAIN STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"143 South Main Street is the address of the David H. Jones House in Spanish Fork, Utah."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1985&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The David H. Jones House was added to the National Register of Historic Places in 1985."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1912&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The David H. Jones House was built in 1912."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1959&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"David H. Jones died in 1959."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1976&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mary E. Nielsen Jones died in 1976."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;FARM AND LIVESTOCK OPERATIONS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"David H. Jones ran his own farm and livestock operations."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;BRICK COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"David Jones ran a brick company and built numerous brick buildings in Maryville, including the Blount County Courthouse."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;BLOUNT COUNTY COURTHOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Blount County Courthouse is a building built by David Jones in Maryville, Tennessee."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;ITALIANATE ARCHITECTURE&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"The David Jones House is one of two best examples of Italianate architecture in Blount County."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;PETER BARTLETT HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Peter Bartlett House is another example of Italianate architecture in Blount County."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;SECOND EMPIRE STYLE HOUSE&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"The David Jones House is the only Second Empire style house in Blount County."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;MARYVILLE, TENNESSEE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Maryville, Tennessee is the location where David Jones built the brick company and the Blount County Courthouse."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1874&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The David Jones House on High Street in Maryville, Tennessee, was built in 1874."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;ELMER B. WALLER HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Elmer B. Waller House is another name for the David Jones House on High Street in Maryville, Tennessee."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
    <node id="&quot;1895&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The David H. Jones House was built in 1895 according to some sources."</data>
      <data key="d2">ramdocs-0182-c44c0fb9d4a8</data>
    </node>
