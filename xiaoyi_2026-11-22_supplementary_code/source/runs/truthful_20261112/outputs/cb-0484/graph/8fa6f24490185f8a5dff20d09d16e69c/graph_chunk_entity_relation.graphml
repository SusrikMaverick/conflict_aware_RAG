    </node>
    <node id="&quot;GENDER GAP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gender gap refers to the pervasive imbalance in opportunities and recognition faced by women in various fields, including music and sports."</data>
      <data key="d2">cb-0484</data>
    </node>
