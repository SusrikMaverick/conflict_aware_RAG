      <data key="d0">"LOCATION"</data>
      <data key="d1">"Amsterdam Concertgebouw is the venue where Margreet Honig performed Verdi's La Traviata, a famous concert hall in Amsterdam."</data>
      <data key="d2">cb-0484</data>
    </node>
    <node id="&quot;HANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hans is Margreet Honig's manager, instrumental in shaping her career and responsible for her professional success."</data>
