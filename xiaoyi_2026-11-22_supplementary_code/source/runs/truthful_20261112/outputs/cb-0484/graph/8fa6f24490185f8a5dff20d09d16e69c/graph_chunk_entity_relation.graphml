  <graph edgedefault="undirected">
    <node id="&quot;MARGREET HONIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Margreet Honig is a Dutch virtuoso soprano known for her remarkable achievements in classical music, particularly in overcoming gender barriers and gaining international recognition."</data>
      <data key="d2">cb-0484</data>
    </node>
    <node id="&quot;DUTCH VIRTUOSO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Dutch virtuoso describes Margreet Honig's status as a renowned classical singer from the Netherlands."</data>
      <data key="d2">cb-0484</data>
    </node>
