  <graph edgedefault="undirected">
    <node id="&quot;HONG KONG OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hong Kong Open is a golf tournament co-sanctioned by the Asian Tour and the European Tour, with a history dating back to 1959 and currently held at the Hong Kong Golf Club in Sheung Shui, New Territories. It has also been a tennis tournament in the past."</data>
      <data key="d2">ramdocs-0262-7c1d1c2f3703</data>
    </node>
    <node id="&quot;SALEM OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Salem Open is another name for the Hong Kong Open in its tennis tournament history."</data>
      <data key="d2">ramdocs-0262-7c1d1c2f3703</data>
    </node>
  </graph>
