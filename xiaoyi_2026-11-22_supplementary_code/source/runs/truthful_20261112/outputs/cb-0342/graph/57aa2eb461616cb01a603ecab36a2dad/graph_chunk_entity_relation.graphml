  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JOHN MCFERRAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Mcferran is a researcher known for his work on the effects of climate change on Mediterranean ecosystems and has made significant discoveries."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;TOR VERGATA UNIVERSITY OF ROME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tor Vergata University of Rome is a research institution where John Mcferran has been working and conducting his groundbreaking research."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the city where Tor Vergata University of Rome is located and where the research took place."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature is a prestigious scientific journal where Mcferran's research was published."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is the Dean of the Faculty of Science at Tor Vergata University of Rome and supports Mcferran's research."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;UNIVERSITY OF WESTERN AUSTRALIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Western Australia is another institution where John Mcferran has worked and conducted research."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;PERTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Perth is the city where the University of Western Australia is located."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate change refers to the long-term alteration of temperature and typical weather patterns in a place, which is the focus of Mcferran's research."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;MEDITERRANEAN ECOSYSTEMS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mediterranean ecosystems are the specific regions and environments studied by Mcferran in his research."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;CARBON FOOTPRINT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Carbon footprint refers to the total amount of greenhouse gases produced to support human activities, which Mcferran warns needs to be reduced."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;SUSTAINABLE PRACTICES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable practices refer to methods and actions aimed at reducing environmental impact and promoting ecological balance, which are highlighted as necessary by Mcferran."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;CONSERVATION EFFORTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Conservation efforts refer to actions taken to protect and preserve natural resources and ecosystems, which are emphasized by Mcferran as crucial."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;ROME, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome, Italy is the city where Tor Vergata University of Rome is located and where the research took place."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;SCIENTIFIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The scientific community is mentioned as being shocked by Mcferran's discovery."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;FIELDWORK&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Fieldwork is the method used by Mcferran's research team to collect data in the Italian countryside."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;DATA COLLECTION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Data collection is the process used by Mcferran's team to gather information on plant species decline."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;PLANT SPECIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Plant species are the subjects of Mcferran's research, particularly those declining due to climate change."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;CLIMATE CHANGE IMPACTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate change impacts are the focus of Mcferran's research, including the decline of plant species."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainability is highlighted as a key theme in Mcferran's research and the broader context of climate change."</data>
      <data key="d2">cb-0342</data>
    </node>
    <node id="&quot;ECO-SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ecosystems are the broader environmental contexts studied by Mcferran, particularly in the Mediterranean region."</data>
