<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HALSTED L. RITTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Halsted L. Ritter was an American lawyer, judge, and member of the Republican political party, serving in the U.S. District Court for the Southern District of Florida and being impeached and removed from office."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;HALSTED LOCKWOOD RITTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Halsted Lockwood Ritter was an American lawyer, judge, and member of the Republican political party, serving in the U.S. District Court for the Southern District of Florida and being impeached and removed from office."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;MARY RITTER BEARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary Ritter Beard was the wife of Charles A. Beard and a noted historian, with her brother Halsted Ritter also being a noted historian."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;CHARLES A. BEARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles A. Beard was married to Mary Ritter Beard and both were noted historians."&lt;SEP&gt;"Charles A. Beard was married to Mary Ritter Beard, and both were noted historians."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;DEPAUW UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DePauw University is the institution where Halsted Ritter received his Bachelor of Philosophy in 1891, LL.B. in 1892, and Master of Arts in 1893."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;UNITED STATES DISTRICT COURT FOR THE SOUTHERN DISTRICT OF FLORIDA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States District Court for the Southern District of Florida is the court where Halsted Ritter served and was impeached and removed from office."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;INDIANAPOLIS, INDIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Indianapolis, Indiana is the birthplace of Halsted Ritter."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;SALT LAKE CITY, UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salt Lake City, Utah is a place where Willis William Ritter practiced law from 1935 to 1949."&lt;SEP&gt;"Salt Lake City, Utah is the birthplace of Willis William Ritter."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;MIDWAY, UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Midway, Utah is a place where Willis William Ritter grew up."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;PARK CITY, UTAH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Park City, Utah is a place where Willis William Ritter grew up."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;UNIVERSITY OF UTAH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Utah is the institution where Willis William Ritter received his A.B. and later practiced law."&lt;SEP&gt;"University of Utah is the institution where Willis William Ritter taught law from 1926 to 1950."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;UNIVERSITY OF CHICAGO LAW SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Chicago Law School is the institution where Willis William Ritter received his LL.B. in 1924."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;CHICAGO, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago, Illinois is a place where Willis William Ritter practiced law from 1924 to 1926."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;WASHINGTON, D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington, D.C. is a place where Willis William Ritter practiced law from 1924 to 1926."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <node id="&quot;WILLIS WILLIAM RITTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Willis William Ritter was a United States federal judge, born in Salt Lake City, Utah, and grew up in Midway and Park City. He received his A.B. from the University of Utah and an LL.B. from the University of Chicago Law School in 1924. He was in private practice in Chicago, Illinois, and Washington, D.C., from 1924 to 1926. He was a professor of law at the University of Utah from 1926 to 1950, and in private practice in Salt Lake City, Utah, from 1935 to 1949."</data>
      <data key="d2">ramdocs-0211-f40bf3de5f9b</data>
    </node>
    <edge source="&quot;HALSTED L. RITTER&quot;" target="&quot;MARY RITTER BEARD&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Halsted L. Ritter and Mary Ritter Beard are siblings, both noted historians."</data>
      <data key="d5">"siblings, historians"</data>
      <data key="d6">ramdocs-0211-f40bf3de5f9b</data>
    </edge>
    <edge source="&quot;HALSTED L. RITTER&quot;" target="&quot;DEPAUW UNIVERSITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Halsted L. Ritter received his degrees from DePauw University."</data>
      <data key="d5">"education, degrees"</data>
      <data key="d6">ramdocs-0211-f40bf3de5f9b</data>
    </edge>
    <edge source="&quot;HALSTED L. RITTER&quot;" target="&quot;UNITED STATES DISTRICT COURT FOR THE SOUTHERN DISTRICT OF FLORIDA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Halsted L. Ritter served in the United States District Court for the Southern District of Florida and was impeached and removed from office."</data>
      <data key="d5">"service, impeachment"</data>
      <data key="d6">ramdocs-0211-f40bf3de5f9b</data>
    </edge>
    <edge source="&quot;HALSTED L. RITTER&quot;" target="&quot;INDIANAPOLIS, INDIANA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Halsted L. Ritter was born in Indianapolis, Indiana."</data>
      <data key="d5">"birthplace"</data>
      <data key="d6">ramdocs-0211-f40bf3de5f9b</data>
    </edge>
    <edge source="&quot;MARY RITTER BEARD&quot;" target="&quot;CHARLES A. BEARD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Mary Ritter Beard was married to Charles A. Beard."</data>
      <data key="d5">"spouse"</data>
