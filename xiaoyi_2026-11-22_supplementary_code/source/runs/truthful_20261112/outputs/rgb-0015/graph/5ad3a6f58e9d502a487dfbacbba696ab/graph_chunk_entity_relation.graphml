  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SPLATOON 2&quot;">
      <data key="d0">"GAME"</data>
      <data key="d1">"Splatoon 2 is a video game that was teased in 2016 and released in 2017."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is a company that announced and released Splatoon 2 and the Nintendo Switch."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;WALMART&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Walmart is an exclusive retailer for a Splatoon 2 Switch bundle in North America."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;NORTH AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North America is the region where a Splatoon 2 Switch bundle will be sold exclusively by Walmart."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;20 OCTOBER 2016&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"20 October 2016 is the date when Splatoon 2 was first teased during the reveal trailer for the Nintendo Switch."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;21 JULY 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"21 July 2017 is the date when Splatoon 2 was released worldwide."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;JULY 1, 2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"July 1, 2007 is a date mentioned in Document 3, though it is incorrect for Splatoon 2."&lt;SEP&gt;"July 1, 2007 is incorrectly mentioned in Document 3 and does not correspond to any known release date of Splatoon 2."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;2017&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2017 is the year when the Splatoon 2 Switch bundle was announced and released."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;SWITCH&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Switch is a Nintendo product, specifically a gaming console, on which Splatoon 2 was released."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;REVEAL TRAILER&quot;">
      <data key="d0">"MEDIA"</data>
      <data key="d1">"Reveal trailer is a type of media used to introduce new products, such as the Nintendo Switch and Splatoon 2."</data>
      <data key="d2">rgb-0015</data>
    </node>
    <node id="&quot;PHYSICAL VERSION&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Physical version refers to the tangible form of the game, such as a cartridge or disc."</data>
      <data key="d2">rgb-0015</data>
