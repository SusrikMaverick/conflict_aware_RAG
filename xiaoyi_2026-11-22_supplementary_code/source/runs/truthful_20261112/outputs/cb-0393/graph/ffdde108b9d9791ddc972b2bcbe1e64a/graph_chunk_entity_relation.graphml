  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;RANJAN SARUKKALIGE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ranjan Sarukkalige is a renowned researcher known for his contributions to interdisciplinary studies, particularly in urban sociology and cultural identity. He was born in Glasgow, Scotland, and pursued his education at the University of Glasgow."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;UNIVERSITY OF GLASGOW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Glasgow is a prestigious institution in the United Kingdom where Ranjan Sarukkalige pursued his undergraduate degree and later worked as a research assistant and lecturer."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a prominent sociologist who guided Ranjan Sarukkalige during his early career at the University of Glasgow."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;JOURNAL OF URBAN STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Urban Studies is a reputed journal where Ranjan Sarukkalige published papers during his academic career."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Journal of Community Development is another reputed journal where Ranjan Sarukkalige published papers."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;ECONOMIC AND SOCIAL RESEARCH COUNCIL (ESRC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Economic and Social Research Council (ESRC) is the organization that awarded Ranjan Sarukkalige a grant for his research on gentrification."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;JOURNAL OF CULTURAL STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Cultural Studies is a reputable journal where Ranjan Sarukkalige published his influential paper 'Negotiating Identity in Multicultural Cities'."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;PHILIP ABRAMS MEMORIAL PRIZE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Philip Abrams Memorial Prize is an award that Ranjan Sarukkalige received for his work on urban sociology."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is an institution where Ranjan Sarukkalige was a visiting fellow."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;UNIVERSITY OF MELBOURNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Melbourne is an institution where Ranjan Sarukkalige was a visiting fellow."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;CURTIN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Curtin University is a prestigious university in Perth, Western Australia where Ranjan Sarukkalige has worked as a researcher."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;PERTH, WESTERN AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Perth, Western Australia is the location of Curtin University where Ranjan Sarukkalige has worked."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;RESEARCHGATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ResearchGate is a social networking site for scientists and researchers where Ranjan Sarukkalige has listed his affiliations."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;GLASGOW, SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glasgow, Scotland is the birthplace of Ranjan Sarukkalige and the location of the University of Glasgow."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;MULTICULTURAL CITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Multicultural cities refer to urban areas with diverse populations and cultures, which are the focus of Ranjan Sarukkalige's research."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;GENTRIFICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gentrification is the process of urban renewal that often leads to changes in the socio-economic composition of neighborhoods, which is the subject of Ranjan Sarukkalige's research."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;COMMUNITY COHESION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community cohesion refers to the sense of unity and shared identity within a community, which is impacted by gentrification according to Ranjan Sarukkalige's research."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;URBANIZATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Urbanization is the process of population growth and development in urban areas, which is one of the topics Ranjan Sarukkalige studied."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;COMMUNITY DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community development involves efforts to improve the quality of life in communities, which is one of the areas Ranjan Sarukkalige explored."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;RESEARCH METHODS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research methods are the techniques and procedures used in conducting research, which Ranjan Sarukkalige taught as part of his academic career."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;SOCIAL THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social theory involves the systematic analysis of social phenomena, which Ranjan Sarukkalige taught as part of his academic career."&gt;</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;DOI: 10.1016/J.IJOS.2019.01.002&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is a reference to a scientific publication, likely an academic paper or article published in a journal."&lt;SEP&gt;"This is a reference to a scientific publication, likely an academic paper or article published in a journal.")</data>
      <data key="d2">cb-0393</data>
    </node>
    <node id="&quot;NOTE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"This is a general note or statement providing context about the references."</data>
      <data key="d2">cb-0393</data>
    </node>
