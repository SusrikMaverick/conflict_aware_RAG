  <graph edgedefault="undirected">
    <node id="&quot;U2&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U2 is a rock band known for their debut album 'Boy' and the song 'I Will Follow'."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;BONO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bono is the lead singer of U2 and wrote the lyrics to 'I Will Follow' in tribute to his mother."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;BOY&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Boy is the debut album by U2, featuring the song 'I Will Follow'."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;MEIERT AVIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Meiert Avis directed the first music video for 'I Will Follow' in Dublin, Ireland."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;THE OLD GREY WHISTLE TEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Old Grey Whistle Test is a television program where 'I Will Follow' was performed in 1981."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;BLENDER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Blender is a magazine that ranked 'I Will Follow' at number 214 on its list of 'The 500 Greatest Songs Since You Were Born' in 2005."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;NEW RELEASE TUESDAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New Release Tuesday is a website that reviewed 'I Will Follow' with a four and a half star rating."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;WORSHIP LEADER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Worship Leader is a website that reviewed 'I Will Follow' with a five star rating."</data>
      <data key="d2">ramdocs-0380-2ed353c21423</data>
    </node>
    <node id="&quot;JEREMY CAMP&quot;">
      <data key="d0">"PERSON"</data>
