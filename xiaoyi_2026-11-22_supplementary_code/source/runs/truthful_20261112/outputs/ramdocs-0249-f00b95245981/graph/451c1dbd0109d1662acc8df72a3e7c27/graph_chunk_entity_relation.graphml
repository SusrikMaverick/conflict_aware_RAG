  <graph edgedefault="undirected">
    <node id="&quot;ACCRINGTON STANLEY F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Accrington Stanley F.C. is a professional association football club based in Accrington, Lancashire, England, competing in League One, the third tier of the English football league system."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;ACCRINGTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Accrington is a town in Lancashire, England, where Accrington Stanley F.C. is based."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;LANCASHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lancashire is a county in North West England, where Accrington Stanley F.C. is located."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;LEAGUE ONE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"League One is the third tier of the English football league system, where Accrington Stanley F.C. competes."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;FOOTBALL LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Football League is a series of men's association football leagues in England and Wales, where Accrington Stanley F.C. was promoted in 2006."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;FOOTBALL CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Football Conference was a level 4 league in the English football league system, where Accrington Stanley F.C. won promotion in 2005–06."</data>
      <data key="d2">ramdocs-0249-f00b95245981</data>
    </node>
    <node id="&quot;JIMMY HINKSMAN&quot;">
