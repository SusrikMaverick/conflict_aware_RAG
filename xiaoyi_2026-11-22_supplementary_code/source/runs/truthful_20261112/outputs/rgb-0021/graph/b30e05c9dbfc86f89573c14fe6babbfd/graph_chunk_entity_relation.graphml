      <data key="d4">"Tadej Pogačar won the 2019 Tour de France."</data>
      <data key="d5">"victory, year"</data>
      <data key="d6">rgb-0021</data>
    </edge>
    <edge source="&quot;EGAN BERNAL&quot;" target="&quot;TOUR DE FRANCE&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Egan Bernal won the 2019 Tour de France and became the first Colombian and first Latin American champion."</data>
      <data key="d5">"victory, historical milestone"</data>
