  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ALAPHILIPPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alaphilippe won the victory with a time of 35' 00" across the 27.2 km (17 mi) course."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;TADEJ POGAČAR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tadej Pogačar officially won the 2019 Tour de France on Sunday."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;EGAN BERNAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Egan Bernal officially won the 2019 Tour de France on Sunday, becoming the first Colombian and first Latin American Tour champion."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;TOUR DE FRANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tour de France is a prestigious cycling race where multiple winners have been crowned, including Alaphilippe, Tadej Pogačar, and Egan Bernal."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2019 is the year in which the Tour de France was held, and multiple winners were crowned."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;COLOMBIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Colombia is mentioned as the country of origin for Egan Bernal, the first Colombian Tour champion."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <node id="&quot;LATIN AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Latin America is mentioned as the region of origin for Egan Bernal, the first Latin American Tour champion."</data>
      <data key="d2">rgb-0021</data>
    </node>
    <edge source="&quot;ALAPHILIPPE&quot;" target="&quot;TOUR DE FRANCE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Alaphilippe won the Tour de France with a specific time."</data>
