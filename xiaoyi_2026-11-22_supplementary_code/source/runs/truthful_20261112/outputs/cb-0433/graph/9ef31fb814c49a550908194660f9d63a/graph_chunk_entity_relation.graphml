  <graph edgedefault="undirected">
    <node id="&quot;COLIN NOON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Colin Noon is a 32-year-old English rugby union player who recently signed with Hamburger SV and Biarritz Olympique, showcasing his versatility and skills."</data>
      <data key="d2">cb-0433</data>
    </node>
    <node id="&quot;HAMBURGER SV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hamburger SV is a German football club that Colin Noon has signed with, bringing his rugby background to the team."</data>
      <data key="d2">cb-0433</data>
    </node>
    <node id="&quot;BIARRITZ OLYMPIQUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Biarritz Olympique is a French professional rugby union team that Colin Noon has joined, expected to enhance the team's performance."&lt;SEP&gt;"Biarritz Olympique is a rugby club known for its forward pack and is making a strong push for the Top 14 title."</data>
      <data key="d2">cb-0433</data>
    </node>
    <node id="&quot;ENGLISH RUGBY UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
