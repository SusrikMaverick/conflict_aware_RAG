  <graph edgedefault="undirected">
    <node id="&quot;AKARI SUDA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Akari Suda is a member of SKE48, passing auditions and participating in various promotions and elections."</data>
