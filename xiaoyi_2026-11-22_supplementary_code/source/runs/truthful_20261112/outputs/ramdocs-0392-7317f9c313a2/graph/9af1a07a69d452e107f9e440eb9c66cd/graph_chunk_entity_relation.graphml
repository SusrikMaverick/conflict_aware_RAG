    </node>
    <node id="&quot;SKE48&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SKE48 is a Japanese idol group, known for its senbatsu system and team promotions."</data>
      <data key="d2">ramdocs-0392-7317f9c313a2</data>
    </node>
    <node id="&quot;TEAM S&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Team S is a subgroup within SKE48, where members perform specific stage performances."</data>
