  <graph edgedefault="undirected">
    <node id="&quot;NICK HILL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nick Hill is an American football coach and former quarterback, born on April 5, 1985, and currently serves as the head football coach at Southern Illinois University."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;SOUTHERN ILLINOIS UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Southern Illinois University is the alma mater of Nick Hill and the current institution where he coaches the football team."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;CHICAGO BEARS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chicago Bears is an NFL team that signed Nick Hill as an undrafted free agent in 2008."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;ARENA FOOTBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Arena Football League is a professional indoor football league where Nick Hill played professionally after his time with the Chicago Bears."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;AF2&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"af2 is a professional arena football league where Nick Hill played after leaving the Arena Football League."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;DUQUOIN HIGH SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"DuQuoin High School is the high school where Nick Hill was a three-year starter in football and also played basketball."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;RICE OWLS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rice Owls is the football team Nick Hill played for in college."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;UNITED STATES MILITARY ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Military Academy is the institution where Nick Hill graduated and excelled as a pitcher."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;PATRIOT LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Patriot League is the collegiate athletic conference where Nick Hill was named Patriot League Pitcher of the Year three times."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;TENNESSEE STATE RECORD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tennessee state record refers to the record Nick Hill established by pitching 56 consecutive shutout innings."</data>
      <data key="d2">ramdocs-0166-50715a16c9ec</data>
    </node>
    <node id="&quot;YANKEES&quot;">
