<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ERIK FURUHJELM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Erik Furuhjelm is a renowned Finnish composer known for his innovative and eclectic style that blends traditional folk melodies with modernist techniques, honored with the Pro Finlandia Medal and the Lakatos Award."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;PRO FINLANDIA MEDAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Pro Finlandia Medal is one of Finland's highest honors for artists and writers, awarded annually to individuals who have made significant contributions to Finnish art and literature."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;ORDER OF THE LION OF FINLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Order of the Lion of Finland is a prestigious organization that recognizes excellence in the arts and awards the Pro Finlandia Medal."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;UNIVERSITY COLLEGE LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University College London is an esteemed institution where the Lakatos Award is presented, celebrating contributions to the philosophy of science."&lt;SEP&gt;"University College London is the institution where the Lakatos Award is presented."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;LAKATOS AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Lakatos Award is a prestigious award presented at University College London, recognizing contributions to the philosophy of science."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;DR. MARJA RANTANEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Marja Rantanen is a musicologist at the University of Helsinki who acknowledges Furuhjelm's pioneering role in Finnish music."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;JUKKA TIENSUU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jukka Tiensuu is a contemporary Finnish composer and admirer of Furuhjelm's work, expressing joy at the recognition of Furuhjelm's legacy."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;UNIVERSITY OF HELSINKI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Helsinki is an educational institution where Dr. Marja Rantanen works and where Furuhjelm's contributions are studied."&lt;SEP&gt;"University of Helsinki is an educational institution where Furuhjelm's contributions are studied."&lt;SEP&gt;"University of Helsinki is the institution where Dr. Marja Rantanen works."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;FINNISH NATIONAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Finnish National Archives confirm Furuhjelm's receipt of the Pro Finlandia Medal in the early 1950s."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;THAMES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Thames is the river in London where the Lakatos Award ceremony takes place."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;PROFESSOR IMRE LAKATOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Imre Lakatos is the namesake of the Lakatos Award and introduces Furuhjelm at the ceremony."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;HELSINKI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Helsinki is the capital city of Finland where the Pro Finlandia Medal is awarded."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;FINLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Finland is the country where Erik Furuhjelm was born and made significant contributions to music."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;PHILOSOPHY OF SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Philosophy of science is the field of study that Erik Furuhjelm contributed to, bridging art and reason."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;MUSIC COMPOSITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Music composition is the primary field of expertise for Erik Furuhjelm, blending traditional and modern elements."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;INTELLECTUAL GIANTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual giants refer to the distinguished scholars and thinkers present at the Lakatos Award ceremony."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;AUTUMNAL FOG&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Autumnal fog is the atmospheric condition that sets the scene for the Lakatos Award ceremony."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;CONTEMPORARY COMPOSERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Contemporary composers include Jukka Tiensuu, who admires Furuhjelm's work and sees his influence."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;HARMONY BETWEEN CREATIVITY AND LOGIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Harmony between creativity and logic is a theme in Furuhjelm's work, bridging art and science."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;HUMAN EXPERIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human experience is the subject matter that Furuhjelm explores in his compositions, capturing beauty, complexity, and order."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;SCIENTIFIC METHOD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Scientific method is the framework that Furuhjelm uses to understand and express the underlying order in the universe."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;INNOVATIVE AND ECLECTIC STYLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovative and eclectic style describes Furuhjelm's unique approach to music, blending traditional and modern elements."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;TRADITIONAL FOLK MELODIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Traditional folk melodies are a key element in Furuhjelm's music, providing a foundation for his compositions."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;MODERNIST TECHNIQUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modernist techniques are another key element in Furuhjelm's music, adding a contemporary edge to his compositions."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;ORCHESTRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orchestra is one of the musical ensembles for which Furuhjelm composed works."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;CHAMBER ENSEMBLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chamber ensembles are another type of musical ensemble for which Furuhjelm composed works."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;SOLO INSTRUMENTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Solo instruments are yet another type of musical ensemble for which Furuhjelm composed works."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;FINNISH MINISTRY OF EDUCATION AND CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Finnish Ministry of Education and Culture is the body that recognized Furuhjelm's contributions with the Pro Finlandia Medal."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;1955&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1955 is the year when the Lakatos Award was presented to Erik Furuhjelm."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;1945&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1945 is the year when the Pro Finlandia Medal was established."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;1883&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1883 is the birth year of Erik Furuhjelm."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;1950S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1950s is the decade when Furuhjelm received the Pro Finlandia Medal."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;PHILOSOPHERS AND SCIENTISTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Philosophers and scientists are the attendees at the Lakatos Award ceremony."</data>
      <data key="d2">cb-0026</data>
    </node>
    <node id="&quot;MUSICIANS AND COMPOSERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Musicians and composers are the recipients and admirers of Furuhjelm's work."</data>
      <data key="d2">cb-0026</data>
    </node>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;PRO FINLANDIA MEDAL&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Erik Furuhjelm was awarded the Pro Finlandia Medal for his outstanding contributions to Finnish music and culture."</data>
      <data key="d5">"recognition, artistic achievement"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;UNIVERSITY COLLEGE LONDON&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Erik Furuhjelm attended the Lakatos Award ceremony at University College London, an event celebrating contributions to the philosophy of science."</data>
      <data key="d5">"intellectual engagement, interdisciplinary recognition"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;DR. MARJA RANTANEN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Dr. Marja Rantanen acknowledges Furuhjelm's pioneering role in Finnish music, highlighting his unique blend of traditional and modern elements."</data>
      <data key="d5">"scholarly recognition, historical significance"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;JUKKA TIENSUU&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Jukka Tiensuu admires Furuhjelm's work and expresses joy at the recognition of Furuhjelm's legacy, emphasizing his enduring influence on contemporary composers."</data>
      <data key="d5">"musical inspiration, legacy appreciation"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;UNIVERSITY OF HELSINKI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Erik Furuhjelm's contributions to music are studied at the University of Helsinki, where Dr. Marja Rantanen works."</data>
      <data key="d5">"educational recognition, academic study"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;ERIK FURUHJELM&quot;" target="&quot;FINNISH NATIONAL ARCHIVES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Finnish National Archives confirm Furuhjelm's receipt of the Pro Finlandia Medal in the early 1950s, providing historical validation of his achievements."</data>
      <data key="d5">"historical documentation, official recognition"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;UNIVERSITY COLLEGE LONDON&quot;" target="&quot;LAKATOS AWARD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Lakatos Award is presented at University College London, an event that recognizes contributions to the philosophy of science."</data>
      <data key="d5">"academic recognition, intellectual community"</data>
      <data key="d6">cb-0026</data>
    </edge>
    <edge source="&quot;UNIVERSITY COLLEGE LONDON&quot;" target="&quot;THAMES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Lakatos Award ceremony takes place by the Thames, symbolizing the confluence of intellectual and artistic endeavors."</data>
      <data key="d5">"symbolic location, interdisciplinary meeting point"</data>
      <data key="d6">cb-0026</data>
    </edge>
  </graph>
