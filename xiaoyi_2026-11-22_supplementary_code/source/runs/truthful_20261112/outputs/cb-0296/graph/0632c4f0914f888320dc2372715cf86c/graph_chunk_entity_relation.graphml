  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UHLDINGEN-MÜHLHOFEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Uhldingen-Mühlhofen is a location that is expected to become a hub for cultural innovation and exchange due to a partnership."&lt;SEP&gt;"Uhldingen-Mühlhofen is a municipality in Baden-Württemberg, Germany, known for its partnership with KIRU and its involvement in cultural exchanges."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;KIRU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KIRU is a company based in the Reutlingen-Ulm region, specializing in providing IT solutions to municipalities and is a partner of Uhldingen-Mühlhofen."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;BADEN-WÜRTTEMBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Baden-Württemberg is a state in Germany where Uhldingen-Mühlhofen is located."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is the country where Uhldingen-Mühlhofen and KIRU are based."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;KOMMUNALE INFORMATIONSVERARBEITUNG REUTLINGEN-ULM (KIRU)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"KIRU is a company dedicated to providing IT solutions to municipalities in the Reutlingen-Ulm region."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;SGCNZ YOUNG SHAKESPEARE COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SGCNZ Young Shakespeare Company is a New Zealand-based theatre troupe that partners with Uhldingen-Mühlhofen to promote cultural exchange."&lt;SEP&gt;"SGCNZ Young Shakespeare Company is an organization planning a performance in Uhldingen-Mühlhofen."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;DAWN SANDERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dawn Sanders is the Artistic Director of SGCNZ Young Shakespeare Company."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;WOLFGANG MÜLLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wolfgang Müller is the Mayor of Uhldingen-Mühlhofen."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;KIWI THEATRE TROUPE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kiwi Theatre Troupe is another name for SGCNZ Young Shakespeare Company, highlighting its New Zealand origin."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;SGCNZ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SGCNZ is the acronym for SGCNZ Young Shakespeare Company, representing its New Zealand-based theatre troupe."&lt;SEP&gt;"SGCNZ is the organization behind the Young Shakespeare Company."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;A MIDSUMMER NIGHT'S DREAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Midsummer Night's Dream is a Shakespearean play that will be performed by SGCNZ Young Shakespeare Company in Uhldingen-Mühlhofen."&lt;SEP&gt;"A Midsummer Night's Dream is the title of the play to be performed by the SGCNZ Young Shakespeare Company."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;GERMAN NATIONAL TOURIST BOARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German National Tourist Board provides data on tourism trends and is mentioned in relation to the expected increase in visitors due to the partnership."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;UHLDINGEN-MÜHLHOFEN'S MEMBERSHIP WITH KIRU&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Uhldingen-Mühlhofen's membership with KIRU marks a significant step in modernizing its administrative processes and improving its online presence."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;MEMBERSHIP AGREEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Membership Agreement formalizes the partnership between Uhldingen-Mühlhofen and KIRU, outlining the terms of cooperation and services to be provided."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;KIRU-SYSTEM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"KIRU-System is a comprehensive platform developed by KIRU that enables Uhldingen-Mühlhofen to streamline its administrative processes, including financial management, human resources, and citizen services."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;DIGITAL COMMUNICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Digital Communication refers to the use of online services to facilitate interactions between the municipality and its citizens, such as submitting applications, paying bills, and requesting information."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;CULTURAL EXCHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural Exchange involves the promotion of artistic collaboration and cross-cultural understanding between Uhldingen-Mühlhofen and SGCNZ Young Shakespeare Company."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;ARTISTIC COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artistic Collaboration includes the performances and workshops organized by SGCNZ Young Shakespeare Company in Uhldingen-Mühlhofen, fostering a deeper appreciation for the arts."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;CROSS-CULTURAL UNDERSTANDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cross-Cultural Understanding is promoted through the partnership between Uhldingen-Mühlhofen and SGCNZ Young Shakespeare Company, encouraging mutual learning and respect."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;TOURISM INCREASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The partnership with SGCNZ Young Shakespeare Company is expected to attract a significant influx of tourists to Uhldingen-Mühlhofen, with an estimated 20% increase in visitor numbers over the next two years."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;LOCAL ECONOMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local economy refers to the economic benefits expected from the partnership."&lt;SEP&gt;"The Local Economy is expected to benefit from the partnership with SGCNZ Young Shakespeare Company, with potential economic growth and increased tourism."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;MÜLLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Müller is the speaker who discusses the anticipated benefits of a partnership for Uhldingen-Mühlhofen."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;TOWN'S PICTURESQUE LAKEFRONT AMPHITHEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The amphitheater is a venue for the performance of 'A Midsummer Night's Dream' in Uhldingen-Mühlhofen."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;PARTNERSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Partnership is a collaboration expected to boost the local economy and enhance Uhldingen-Mühlhofen's reputation."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;CULTURAL INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural innovation is a concept that Uhldingen-Mühlhofen aims to become known for."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;EXCHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Exchange is a concept related to cultural interactions and sharing."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;JUNE 2023&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"June 2023 is the scheduled date for the performance."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;PERFORMANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Performance is the event of the SGCNZ Young Shakespeare Company's play."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;PLAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Play is the theatrical production of 'A Midsummer Night's Dream' by the SGCNZ Young Shakespeare Company."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;TOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Town refers to Uhldingen-Mühlhofen, the location where the performance will take place."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;PICTURESQUE LAKEFRONT AMPHITHEATER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Picturesque lakefront amphitheater is the venue for the performance."</data>
      <data key="d2">cb-0296</data>
    </node>
    <node id="&quot;YOUNG SHAKESPEARE COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Young Shakespeare Company is a subgroup of SGCNZ responsible for the theatrical production."</data>
      <data key="d2">cb-0296</data>
    </node>
