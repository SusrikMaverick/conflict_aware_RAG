  <graph edgedefault="undirected">
    <node id="&quot;DIANA LAURILLARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Diana Laurillard is a British academic and Professor of Learning with Digital Technologies at the London Knowledge Lab, UCL Institute of Education, known for her contributions to educational technology and learning theories."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;LONDON KNOWLEDGE LAB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London Knowledge Lab is an institution where Diana Laurillard holds a professorship and leads research projects on the use of digital technologies in education."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;UCL INSTITUTE OF EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UCL Institute of Education is the institution where Diana Laurillard is based and conducts her research on learning with digital technologies."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;UNIVERSITY OF SURREY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Surrey is where Diana Laurillard earned her degree, mentioned as one of its notable alumni."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;CHANG GUNG UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chang Gung University in Taiwan is where Diana Laurillard had a formative experience, contributing to her academic and research pursuits."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;JOURNAL OF EDUCATIONAL TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Educational Technology is a publication that has cited Diana Laurillard's research, highlighting its influence in the field of educational technology."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;DR. MEI-LING CHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Mei-Ling Chen is the Dean of the College of Education at Chang Gung University, who praised Diana Laurillard's contributions to the university."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;INTERACTIVE MULTIMEDIA PLATFORM&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"An interactive multimedia platform was designed by Diana Laurillard and her team to support language learning for students with disabilities."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;INCLUSIVITY AND ACCESSIBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Inclusivity and accessibility in education are key focuses of Diana Laurillard's research and academic work."</data>
      <data key="d2">cb-0102</data>
    </node>
    <node id="&quot;EDUCATIONAL POLICY AND PRACTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Diana Laurillard's research has influenced global educational policy and practice."</data>
      <data key="d2">cb-0102</data>
    </node>
