    <node id="&quot;FRANKLIN COUNTY HIGH SCHOOL (KENTUCKY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Franklin County High School (Kentucky) is the largest of three public high schools in Frankfort, Kentucky and is one of two high schools operated by Franklin County Public Schools."</data>
