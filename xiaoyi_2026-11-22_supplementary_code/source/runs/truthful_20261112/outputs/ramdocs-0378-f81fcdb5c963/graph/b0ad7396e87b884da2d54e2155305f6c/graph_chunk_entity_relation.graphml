  <graph edgedefault="undirected">
    <node id="&quot;REVOLUTIONARY LEFT MOVEMENT (BOLIVIA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Revolutionary Left Movement (Bolivia) is a social democratic political party in Bolivia, founded in 1971 by a merger of a left-wing faction of Bolivia's Christian Democratic Party and the radical student wing of the Revolutionary Nationalist Movement (MNR). It was a member of the Socialist International and led by Jaime Paz Zamora."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;JAIME PAZ ZAMORA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jaime Paz Zamora is the leader of the Revolutionary Left Movement (Bolivia) from its founding in 1971."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;SOCIALIST INTERNATIONAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Socialist International is an international association of social-democratic, democratic socialist, and labour political parties, of which the Revolutionary Left Movement (Bolivia) was a member."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;CHRISTIAN DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Christian Democratic Party is a political party in Bolivia, from which a left-wing faction merged to form the Revolutionary Left Movement (Bolivia)."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;REVOLUTIONARY NATIONALIST MOVEMENT (MNR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Revolutionary Nationalist Movement (MNR) is a political party in Bolivia, from which a radical student wing merged to form the Revolutionary Left Movement (Bolivia)."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;HUGO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hugo is mentioned as having repressed the Revolutionary Left Movement (Bolivia), though his full name is not provided."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;LA PAZ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"La Paz is the headquarters of the Revolutionary Left Movement (Bolivia)."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;MOVIMIENTO DE LA IZQUIERDA REVOLUCIONARIA - NUEVA MAYORÍA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Movimiento de la Izquierda Revolucionaria - Nueva Mayoría is the Spanish name for the Revolutionary Left Movement (Bolivia), a social democratic political party in Bolivia."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;MOVIMIENTO DE LA IZQUIERDA REVOLUCIONARIA – NUEVA MAYORÍA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Movimiento de la Izquierda Revolucionaria – Nueva Mayoría is the Spanish name for the Revolutionary Left Movement (Bolivia), a social democratic political party in Bolivia."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;REVOLUTIONARY LEFT MOVEMENT (PERU)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Revolutionary Left Movement (Peru) is a Marxist group founded in 1962 by Luis de la Puente Uceda and his group 'APRA Rebelde', a splinter group from the APRA which had rallied the government in the 1950s and 1960s."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;LUIS DE LA PUENTE UCEDA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luis de la Puente Uceda is the founder of the Revolutionary Left Movement (Peru) in 1962."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;APRA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"APRA is a political party in Peru, from which the Revolutionary Left Movement (Peru) originated as a splinter group."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;APRA REBELDE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"APRA Rebelde is a splinter group from the APRA which founded the Revolutionary Left Movement (Peru) in 1962."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;MIR-EM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MIR-EM is one of the factions that emerged after the Revolutionary Left Movement (Peru) split in 1982, merging with the Revolutionary Socialist Party (Marxist-Leninist) to form the Movimiento Revolucionario Túpac Amaru (MRTA)."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;MIR-VR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MIR-VR is one of the factions that emerged after the Revolutionary Left Movement (Peru) split in 1982, joining the parliamentary left-wing coalition Izquierda Unida in the early 1980s."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;MIR-IV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MIR-IV is one of the factions that emerged after the Revolutionary Left Movement (Peru) split in 1982, joining the parliamentary left-wing coalition Izquierda Unida in the early 1980s."&gt;</data>
