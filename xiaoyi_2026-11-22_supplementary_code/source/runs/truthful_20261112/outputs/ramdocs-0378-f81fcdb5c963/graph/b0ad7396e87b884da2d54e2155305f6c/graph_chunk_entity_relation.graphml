    <node id="&quot;MOVIMIENTO REVOLUCIONARIO TÚPAC AMARU (MRTA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Movimiento Revolucionario Túpac Amaru (MRTA&lt;SEP&gt;"Movimiento Revolucionario Túpac Amaru (MRTA) is a group formed by the merger of MIR-EM with the Revolutionary Socialist Party (Marxist-Leninist)."&gt;</data>
      <data key="d2">ramdocs-0378-f81fcdb5c963</data>
    </node>
    <node id="&quot;PERUVIAN APRISTA PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
