<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;487TH AIR EXPEDITIONARY WING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"487th Air Expeditionary Wing is a provisional United States Air Force unit assigned to USAFE, activated or inactivated at any time, with a last known assignment in 2003 at Cairo West Air Base, Egypt, during Operation Iraqi Freedom."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;487TH BOMBARDMENT GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"487th Bombardment Group is a United States Army Air Forces unit, activated in September 1943, trained in the US, and deployed to the European Theater of Operations."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;487TH BOMBARDMENT SQUADRON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"487th Bombardment Squadron is an inactive United States Air Force unit, last assigned to the 340th Bombardment Wing at Whiteman Air Force Base, Missouri, inactivated on 1 September 1963, and initially deployed to IX Bomber Command in Egypt via the South Atlantic Route."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;487TH FIGHTER SQUADRON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"487th Fighter Squadron is an inactive United States Air Force unit, last assigned to the 352d Fighter Group at Camp Kilmer, New Jersey, activated in September 1942, trained with P-47 Thunderbolts, deployed to the European Theater of Operations as a heavy bomber fighter escort squadron, and replaced P-47s with P-51D Mustangs in July 1944."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;CAIRO WEST AIR BASE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cairo West Air Base is a location in Egypt where the 487th Air Expeditionary Wing was last known to be assigned during Operation Iraqi Freedom."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;OPERATION IRAQI FREEDOM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Operation Iraqi Freedom is a military operation involving the 487th Air Expeditionary Wing in 2003."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;UNITED STATES AIR FORCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"United States Air Force is the parent organization of the 487th Air Expeditionary Wing."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;THIRD AIR FORCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Third Air Force is the organization that trained the 487th Bombardment Squadron with B-25 Mitchell medium bombers in the southeastern United States."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;IX BOMBER COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IX Bomber Command is the command to which the 487th Bombardment Squadron was initially deployed in Egypt."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;MEDITERRANEAN THEATER OF OPERATIONS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mediterranean Theater of Operations is the theater where the 487th Bombardment Squadron was reassigned after deployment to IX Bomber Command in Egypt."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;XII BOMBER COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"XII Bomber Command is the command to which the 487th Bombardment Squadron was reassigned in Tunisia."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;IX FIGHTER COMMAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IX Fighter Command is the command to which the 487th Fighter Squadron was deployed in Belgium during the Battle of the Bulge."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;CAMP KILMER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Camp Kilmer is the location where the 487th Fighter Squadron was last assigned before deployment to the European Theater of Operations."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;FIRST AIR FORCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"First Air Force is the organization that trained the 487th Fighter Squadron with P-47 Thunderbolts in the northeast United States."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;P-47 THUNDERBOLTS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"P-47 Thunderbolts are the type of aircraft used by the 487th Fighter Squadron for training and early deployments."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;P-51D MUSTANGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"P-51D Mustangs are the type of aircraft used by the 487th Fighter Squadron for later deployments and tactical fighter-bomber missions."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;WHITEMAN AIR FORCE BASE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Whiteman Air Force Base is the location where the 487th Bombardment Squadron was last assigned before inactivation."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
    <node id="&quot;EGYPT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Egypt is a location where the 487th Bombardment Squadron was initially deployed via the South Atlantic Route."</data>
      <data key="d2">ramdocs-0326-ba046843c625</data>
    </node>
  </graph>
</graphml>
