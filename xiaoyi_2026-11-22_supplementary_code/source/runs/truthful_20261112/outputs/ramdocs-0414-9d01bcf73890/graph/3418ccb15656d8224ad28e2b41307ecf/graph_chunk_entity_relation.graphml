  <graph edgedefault="undirected">
    <node id="&quot;SAM SPARKS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sam Sparks is a Senior United States District Judge of the Austin Division of the United States District Court for the Western District of Texas, born in 1939 and a member of the Texas Cowboys and Delta Tau Delta Fraternity."&lt;SEP&gt;"Sam Sparks is a person and the deuteragonist of the Cloudy With a Chance of Meatballs franchise, working as a weather intern and later a reporter for Weather News Network."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;INDIANA EDUCATION DEPAUW UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indiana Education DePauw University is a higher education institution where William Morris Sparks studied and later read law."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;INDIANA LAW SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indiana Law School is a part of Indiana Education DePauw University where William Morris Sparks read law."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;WILLIAM MORRIS SPARKS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Morris Sparks is a person born on April 28, 1872, and is associated with Indiana Education DePauw University and Indiana Law School."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;MOUNT HOLLY, NEW JERSEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mount Holly, New Jersey is the birthplace of John E. Sparks, a United States Circuit Judge."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;JOHN E. SPARKS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John E. Sparks is a person born on August 15, 1953, and is a United States Circuit Judge of the United States Court of Appeals for the Armed Forces."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;UNITED STATES NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Navy is the branch of the military in which John E. Sparks enlisted in July 1971."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;UNITED STATES NAVAL ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Naval Academy is the institution where John E. Sparks received an appointment and began his midshipman course in July 1972."</data>
      <data key="d2">ramdocs-0414-9d01bcf73890</data>
    </node>
    <node id="&quot;UNITED STATES COURT OF APPEALS FOR THE ARMED FORCES&quot;">
