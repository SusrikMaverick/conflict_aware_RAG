  <graph edgedefault="undirected">
    <node id="&quot;THE GREEN PASTURES (PLAY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Green Pastures (play) is a drama written in 1930 by Marc Connelly, adapted from 'Ol' Man Adam an' His Chillun' by Roark Bradford, and won the Pulitzer Prize for Drama in 1930."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;MARC CONNELLY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marc Connelly is the author of 'The Green Pastures (play)', a drama that portrays episodes from the Old Testament through the eyes of a young African-American child in the Depression-era South."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;ROARK BRADFORD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roark Bradford wrote 'Ol' Man Adam an' His Chillun', a collection of stories that inspired Marc Connelly's 'The Green Pastures (play)'."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;THE DEEP TANGLED WILDWOOD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Deep Tangled Wildwood is one of Marc Connelly's earlier novels, part of his search for 'old dignities' but distinct from 'The Green Pastures' in scope."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;THE WISDOM TOOTH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Wisdom Tooth is another one of Marc Connelly's earlier novels, part of his search for 'old dignities' but distinct from 'The Green Pastures' in scope."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;THE WILD MAN OF BORNEO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Wild Man of Borneo is another one of Marc Connelly's earlier novels, part of his search for 'old dignities' but distinct from 'The Green Pastures' in scope."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;THE GREEN PASTURES (FILM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Green Pastures (film) is a 1936 American film based on the 1928 novel 'Ol' Man Adam an' His Chillun' by Roark Bradford and the 1930 Pulitzer Prize-winning play of the same name by Marc Connelly, featuring an all-African American cast."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
    <node id="&quot;REX INGRAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rex Ingram starred in the 1936 film 'The Green Pastures', playing multiple roles including 'De Lawd' and other characters."</data>
      <data key="d2">ramdocs-0131-629541a2de9a</data>
    </node>
