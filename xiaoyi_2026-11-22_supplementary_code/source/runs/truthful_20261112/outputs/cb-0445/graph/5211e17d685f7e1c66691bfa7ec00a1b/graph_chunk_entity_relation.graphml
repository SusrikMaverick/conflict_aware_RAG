  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;BELGIAN THRILLER 'HUMAN PREY'&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Belgian Thriller 'Human Prey' is a television series from Belgium that has captured global attention, known for its unique storytelling and atmospheric tension."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;BRUSSELS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brussels is the capital city of Belgium where the series 'Human Prey' has gained significant attention."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;MAARTEN DE VRIES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maarten De Vries is a Belgian filmmaker and the creator of the series 'Human Prey', inspired by the concept of predator and prey."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;LAURA VERBEKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laura Verbeke is the lead actress in 'Human Prey', playing the character of Sophia, and has received acclaim for her performance."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;SOPHIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophia is a complex and enigmatic character played by Laura Verbeke in the series 'Human Prey', known for her mysterious nature."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;BELGIAN MINISTER OF CULTURE, SABINE LARUELLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sabine Laruelle is the Belgian Minister of Culture who praised the impact of 'Human Prey' on the country's cultural landscape."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;WILDLIFE DOCS PRODUCTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wildlife Docs Productions is a U.S.-based production company responsible for producing 'Human Prey'."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;DISCOVERY CHANNEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Discovery Channel is an American television network that broadcasts 'Human Prey' and is known for its documentaries and reality TV shows."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;DR. MATT STEVENSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Matt Stevenson is an American wildlife expert and television personality who is the creator of 'Human Prey' and a former producer of the series."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;FLORIDA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florida is a filming location for 'Human Prey', showcasing diverse landscapes and settings for the series."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisiana is another filming location for 'Human Prey', contributing to the series' variety of settings."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;UNITED STATES OF AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States of America is the origin of 'Human Prey', as evidenced by multiple sources."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;FIRST SEASON OF 'HUMAN PREY'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The first season of 'Human Prey' is the initial release of the series, which has become the most-watched Belgian series of all time."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;SECOND SEASON OF 'HUMAN PREY'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The second season of 'Human Prey' is set to begin production, indicating ongoing interest and development of the series."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;TOURISM TO BELGIUM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tourism to Belgium has increased due to the popularity of 'Human Prey', with fans visiting the locations featured in the series."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;FIRST MONTH OF RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In its first month of release, 'Human Prey' has attracted over 10 million viewers worldwide, marking a significant milestone."</data>
      <data key="d2">cb-0445</data>
    </node>
    <node id="&quot;SABINE LARUELLE&quot;">
      <data key="d2">cb-0445</data>
      <data key="d1">"Sabine Laruelle, the Belgian Minister of Culture, praised the impact of 'Human Prey' on the country's cultural landscape."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
