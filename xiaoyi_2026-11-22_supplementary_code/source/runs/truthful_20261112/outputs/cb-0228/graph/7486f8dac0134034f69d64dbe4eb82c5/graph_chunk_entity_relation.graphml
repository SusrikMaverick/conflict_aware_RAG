  <graph edgedefault="undirected">
    <node id="&quot;RAFAYEL SHISHMANYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rafayel Shishmanyan is a celebrated Armenian painter and art critic who attended Getronagan Armenian High School and later pursued studies at the University of Sheffield."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;GETRONAGAN ARMENIAN HIGH SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Getronagan Armenian High School is a private institution known for its academic excellence and rich cultural heritage, where Rafayel Shishmanyan received his secondary education."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;UNIVERSITY OF SHEFFIELD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Sheffield is a renowned institution in England, where Rafayel Shishmanyan pursued a degree in fine arts and met fellow artists like Emily."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;YEGHISHE TADEVOSYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yeghishe Tadevosyan is a renowned Armenian artist and Rafayel Shishmanyan's mentor who recommended him to the University of Sheffield."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;EMILY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily is a talented sculptor and Rafayel Shishmanyan's friend at the University of Sheffield, sharing his passion for Impressionist art."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;SHEFFIELD STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sheffield station is the arrival point for Rafayel Shishmanyan in England, located in the city of Sheffield."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;ARMENIAN NATIONAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Armenian National Archives holds records confirming Rafayel Shishmanyan's attendance at Getronagan Armenian High School."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;UNIVERSITY OF SHEFFIELD'S RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Sheffield's records confirm Rafayel Shishmanyan's enrollment and attendance there."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;MONET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monet is an Impressionist painter whose works Rafayel Shishmanyan and Emily studied at the University of Sheffield museum."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;RENOIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Renoir is another Impressionist painter whose works Rafayel Shishmanyan and Emily studied at the University of Sheffield museum."</data>
      <data key="d2">cb-0228</data>
    </node>
    <node id="&quot;E. F. SKINNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"E. F. Skinner is an artist whose work Rafayel Shishmanyan discovered at the University of Sheffield museum, inspiring him."</data>
