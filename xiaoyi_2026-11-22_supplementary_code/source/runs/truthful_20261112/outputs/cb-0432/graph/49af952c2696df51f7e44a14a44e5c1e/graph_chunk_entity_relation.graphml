    <edge source="&quot;FLORIDA STATE UNIVERSITY&quot;" target="&quot;MINISTRY OF HIGHER EDUCATION, SCIENCE, AND TECHNOLOGY OF THE DOMINICAN REPUBLIC&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The Ministry of Higher Education, Science, and Technology of the Dominican Republic confirmed José Blanco F.'s attendance at Florida State University in a published biography."</data>
      <data key="d5">"official confirmation, academic recognition"</data>
