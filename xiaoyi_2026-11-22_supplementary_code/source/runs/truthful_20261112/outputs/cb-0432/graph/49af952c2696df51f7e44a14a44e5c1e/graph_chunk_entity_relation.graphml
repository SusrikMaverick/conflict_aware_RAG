  <graph edgedefault="undirected">
    <node id="&quot;JOSÉ BLANCO F.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"José Blanco F. is a Dominican university professor known for his contributions to the field of education, born on February 12, 1965, in Santo Domingo, Dominican Republic."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;DOMINICAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dominican University is where José Blanco F. began his academic career as a professor."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;ARISTOTLE UNIVERSITY OF THESSALONIKI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aristotle University of Thessaloniki is a prestigious higher education institution where José Blanco F. studied from 1985 to 1989."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;FLORIDA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Florida State University is a public university where José Blanco F. pursued higher education in the United States."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;SANTO DOMINGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santo Domingo is the birthplace of José Blanco F. and is located in the Dominican Republic."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;THESSALONIKI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Thessaloniki is the city where Aristotle University of Thessaloniki is located."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;DOMINICAN REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Dominican Republic is the country where José Blanco F. was born and where he pursued higher education and began his academic career."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;JOURNAL OF EDUCATIONAL RESEARCH AND DEVELOPMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Educational Research and Development is a publication that has featured research on the impact of international education on academic achievement."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;LISTÍN DIARIO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Listín Diario is a prominent Dominican newspaper that has published an interview with José Blanco F."</data>
      <data key="d2">cb-0432</data>
    </node>
    <node id="&quot;MINISTRY OF HIGHER EDUCATION, SCIENCE, AND TECHNOLOGY OF THE DOMINICAN REPUBLIC&quot;">
