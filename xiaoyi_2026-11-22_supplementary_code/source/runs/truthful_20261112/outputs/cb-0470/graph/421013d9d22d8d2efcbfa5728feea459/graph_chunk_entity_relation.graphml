    <node id="&quot;SANDRINE PAVOINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sandrine Pavoine is a renowned researcher in environmental science, known for her contributions to ecosystem dynamics and resilience studies."</data>
      <data key="d2">cb-0470</data>
    </node>
