      <data key="d4">"Frédéric Back is the creator of Animated Shorts in collaboration with the University of Burgundy."</data>
      <data key="d5">"creation, collaboration"</data>
      <data key="d6">cb-0406</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF BURGUNDY&quot;" target="&quot;ANIMATED SHORTS&quot;">
