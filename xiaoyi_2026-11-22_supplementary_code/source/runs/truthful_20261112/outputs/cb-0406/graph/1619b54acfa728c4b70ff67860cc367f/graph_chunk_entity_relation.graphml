  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FRÉDÉRIC BACK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frédéric Back is a renowned Canadian animator known for his unique style and contributions to the animation industry, particularly with the Canadian Broadcasting Corporation (CBC&lt;SEP&gt;"Frédéric Back is a renowned Canadian animator known for his unique style and contributions to the animation industry, particularly with the Canadian Broadcasting Corporation (CBC)."&lt;SEP&gt;"Frédéric Back is an animator who has a professional connection with the University of Burgundy, as evidenced by his work on animated shorts there."</data>
      <data key="d2">cb-0406</data>
    </node>
    <node id="&quot;UNIVERSITY OF BURGUNDY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Burgundy is a prestigious institution known for bringing people and ideas together through art and animation."</data>
      <data key="d2">cb-0406</data>
    </node>
    <node id="&quot;PROFESSOR DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Dupont is a faculty member at the University of Burgundy who meets with Frédéric Back, establishing a professional relationship."</data>
      <data key="d2">cb-0406</data>
    </node>
    <node id="&quot;ANIMATED SHORTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Animated Shorts are projects created by Frédéric Back in collaboration with the University of Burgundy."</data>
      <data key="d2">cb-0406</data>
    </node>
    <node id="&quot;CANADIAN BROADCASTING CORPORATION (CBC)&quot;">
      <data key="d2">cb-0406</data>
      <data key="d1">"Frédéric Back joined the CBC as an animator and designer in 1952, working on various projects and leaving a lasting impact on Canadian animation."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;THE TALES OF THE EMERALD ISLE&quot;">
      <data key="d2">cb-0406</data>
      <data key="d1">"The CBC produced 'The Tales of the Emerald Isle,' an animated series based on Irish folklore, showcasing Back's unique style and storytelling abilities."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;RUSTY AND RUBY&quot;">
      <data key="d2">cb-0406</data>
      <data key="d1">"The CBC produced the popular children's series 'Rusty and Ruby,' highlighting Back's versatility and creative storytelling skills."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;THE MAN WHO PLANTED TREES&quot;">
      <data key="d2">cb-0406</data>
      <data key="d1">"The CBC produced the animated short film 'The Man Who Planted Trees,' based on the novella by Jean Giono, one of Back's notable works with the organization."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;FRÉDÉRIC BACK&quot;" target="&quot;CANADIAN BROADCASTING CORPORATION (CBC)&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Frédéric Back joined the CBC as an animator and designer in 1952, working on various projects and leaving a lasting impact on Canadian animation."</data>
      <data key="d5">"career collaboration, lasting impact"</data>
      <data key="d6">cb-0406</data>
    </edge>
    <edge source="&quot;FRÉDÉRIC BACK&quot;" target="&quot;UNIVERSITY OF BURGUNDY&quot;">
      <data key="d3">32.0</data>
      <data key="d4">"Frédéric Back took up a unique position at the University of Burgundy in 1965, creating animated shorts to illustrate the university's rich history, inspiring the entire department."&lt;SEP&gt;"Frédéric Back works for the University of Burgundy and collaborates on animated shorts there."</data>
      <data key="d5">"educational collaboration, artistic inspiration"&lt;SEP&gt;"professional connection, collaboration"</data>
      <data key="d6">cb-0406</data>
    </edge>
