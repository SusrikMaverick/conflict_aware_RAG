      <data key="d3">7.0</data>
      <data key="d4">"The CBC produced 'The Tales of the Emerald Isle,' an animated series based on Irish folklore, showcasing Back's unique style and storytelling abilities."</data>
      <data key="d5">"production collaboration, cultural engagement"</data>
      <data key="d6">cb-0406</data>
