      <data key="d3">14.0</data>
      <data key="d4">"Frédéric Back meets with Professor Dupont at the University of Burgundy, establishing a professional relationship."</data>
      <data key="d5">"professional meeting, collaboration"</data>
      <data key="d6">cb-0406</data>
    </edge>
    <edge source="&quot;FRÉDÉRIC BACK&quot;" target="&quot;ANIMATED SHORTS&quot;">
