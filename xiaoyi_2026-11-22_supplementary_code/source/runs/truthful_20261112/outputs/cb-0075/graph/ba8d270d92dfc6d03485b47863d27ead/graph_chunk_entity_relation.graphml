      <data key="d3">7.0</data>
      <data key="d4">"Lively debates in the student union are part of the academic experience at the University of Santiago de Compostela, enhancing Aharon's intellectual engagement."</data>
      <data key="d5">"debate, intellectual engagement"</data>
      <data key="d6">cb-0075</data>
    </edge>
