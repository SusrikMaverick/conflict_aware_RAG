<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;AHARON ADIBEKJAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aharon Adibekjan is a young Armenian sociologist who embarked on a journey of academic inquiry, shaping his future as a renowned sociologist."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;YEREVAN, ARMENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yerevan, Armenia is the city where Aharon Adibekjan began his academic journey at the National Polytechnic University of Armenia."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;NATIONAL POLYTECHNIC UNIVERSITY OF ARMENIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Polytechnic University of Armenia is a prestigious institution founded in 1933, known for academic excellence and attracting talented students from across Armenia."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;ÉMILE DURKHEIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Émile Durkheim is a prominent sociologist whose theories on social solidarity and bureaucracy resonated deeply with Aharon Adibekjan."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;MAX WEBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Max Weber is another prominent sociologist whose works influenced Aharon Adibekjan's academic pursuits."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;DR. HMAYAK YESSAYAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hmayak Yessayan is a distinguished sociologist who taught Aharon Adibekjan at the National Polytechnic University of Armenia, instilling in him a critical thinking approach."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;SANTIAGO DE COMPOSTELA, SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Santiago de Compostela, Spain is the city where Aharon Adibekjan later attended the University of Santiago de Compostela."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;UNIVERSITY OF SANTIAGO DE COMPOSTELA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Santiago de Compostela is a place where Aharon had an enriching academic experience, marked by stimulating lectures and lively debates."&lt;SEP&gt;"The University of Santiago de Compostela is a renowned institution founded in the 16th century, hosting some of the greatest minds in Spanish history."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;PROFESSOR ELENA GARCÍA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Elena García is a renowned expert in social anthropology who took an interest in Aharon Adibekjan's work and invited him to her program."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;DR. FRANCISCO SUÁREZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Francisco Suárez is a professor who wrote extensively on the social fabric of rural Galicia and engaged in a deep discussion with Aharon Adibekjan."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;CLOISTERED QUADRANGLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cloistered quadrangles refer to the historic architectural features of the University of Santiago de Compostela, symbolizing its rich history and academic environment."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;UNIVERSITY LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The University Library is a significant location at the University of Santiago de Compostela where Aharon Adibekjan discovered important works on social theory."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;THE SOCIAL FABRIC OF RURAL GALICIA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Social Fabric of Rural Galicia is a book written by Dr. Francisco Suárez that Aharon Adibekjan found fascinating and discussed with the professor."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;STUDENT UNION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Student Union is a location at the University of Santiago de Compostela where lively debates and discussions take place, contributing to the academic environment."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;AHARON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aharon is a young Armenian with a keen intellect and passion for his work, who had a transformative experience at the University of Santiago de Compostela."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;ARMENIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Armenian is a young individual with a keen intellect and passion for his work, recognized by someone else."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;STIMULATING LECTURES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Stimulating lectures are part of the academic experience at the University of Santiago de Compostela, contributing to Aharon's intellectual growth."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;LIVELY DEBATES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lively debates in the student union are part of the academic experience at the University of Santiago de Compostela, enhancing Aharon's intellectual engagement."</data>
      <data key="d2">cb-0075</data>
    </node>
    <node id="&quot;SOMEONE ELSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Someone else is impressed by the young Armenian's keen intellect and passion for his work."</data>
      <data key="d2">cb-0075</data>
    </node>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;YEREVAN, ARMENIA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Aharon Adibekjan began his academic journey in Yerevan, Armenia, at the National Polytechnic University of Armenia."</data>
      <data key="d5">"academic foundation, starting point"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;NATIONAL POLYTECHNIC UNIVERSITY OF ARMENIA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Aharon Adibekjan enrolled in the National Polytechnic University of Armenia, a prestigious institution that laid the foundation for his career as a sociologist."</data>
      <data key="d5">"education, academic foundation"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;ÉMILE DURKHEIM&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Aharon Adibekjan was deeply influenced by Émile Durkheim's theories on social solidarity and bureaucracy."</data>
      <data key="d5">"influence, theoretical foundation"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;MAX WEBER&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Aharon Adibekjan was also influenced by Max Weber's works, which further shaped his academic pursuits."</data>
      <data key="d5">"influence, theoretical foundation"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;DR. HMAYAK YESSAYAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Hmayak Yessayan taught Aharon Adibekjan at the National Polytechnic University of Armenia, instilling in him a critical thinking approach."</data>
      <data key="d5">"mentorship, critical thinking"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;SANTIAGO DE COMPOSTELA, SPAIN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Aharon Adibekjan later attended the University of Santiago de Compostela in Santiago de Compostela, Spain, to expand his knowledge and broaden his horizons."</data>
      <data key="d5">"academic expansion, cultural immersion"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;AHARON ADIBEKJAN&quot;" target="&quot;UNIVERSITY OF SANTIAGO DE COMPOSTELA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Aharon Adibekjan attended the University of Santiago de Compostela, a renowned institution, to further his studies in social anthropology under Professor Elena García."</data>
      <data key="d5">"academic pursuit, mentorship"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF SANTIAGO DE COMPOSTELA&quot;" target="&quot;AHARON&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Aharon had an enriching experience at the University of Santiago de Compostela, which included stimulating lectures and lively debates."</data>
      <data key="d5">"academic experience, intellectual growth"</data>
      <data key="d6">cb-0075</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF SANTIAGO DE COMPOSTELA&quot;" target="&quot;STIMULATING LECTURES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Stimulating lectures are part of the academic experience at the University of Santiago de Compostela, contributing to Aharon's intellectual growth."</data>
      <data key="d5">"education, intellectual stimulation"</data>
      <data key="d6">cb-0075</data>
    </edge>
