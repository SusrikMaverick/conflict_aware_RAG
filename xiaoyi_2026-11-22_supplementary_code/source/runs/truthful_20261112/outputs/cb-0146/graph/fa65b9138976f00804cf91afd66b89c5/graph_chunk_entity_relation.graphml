      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;EARLY 20TH CENTURY&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"Herbert Fulton played a significant role in the development of cricket in the Kingdom of Egypt during the early 20th century."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;144 FIRST-CLASS MATCHES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Herbert Fulton played 144 first-class matches during his career."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;OVER 4,500 RUNS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Herbert Fulton scored over 4,500 runs during his career."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;234 WICKETS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Herbert Fulton took 234 wickets during his career."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1801-1922&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"The United Kingdom of Great Britain and Ireland existed from 1801 to 1922."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;ANGLO-IRISH TREATY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Anglo-Irish Treaty led to the formation of the Irish Free State and the eventual dissolution of the UK of Great Britain and Ireland in 1922."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1915 UK CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1915 UK Census recorded Herbert Fulton as a resident of England, supporting his citizenship status."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;STEPHEN WAGG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen Wagg is a cricket historian and author who noted the link between Herbert Fulton and the UK of Great Britain and Ireland."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;CRICKETING ACHIEVEMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cricketing achievements are a significant aspect of Herbert Fulton's life, contributing to his recognition and status."</data>
      <data key="d2">cb-0146</data>
    </node>
