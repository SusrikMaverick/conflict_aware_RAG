  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HERBERT FULTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Herbert Fulton is a citizen of the United Kingdom of Great Britain and Ireland, known for his cricketing achievements and historical records."&lt;SEP&gt;"Herbert Fulton was an English cricketer who played a significant role in the development of cricket in the Kingdom of Egypt during the early 20th century. He was born in 1872 in London and died in 1951."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;KINGDOM OF EGYPT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Kingdom of Egypt is a location where Herbert Fulton played a significant role in developing cricket in the early 20th century."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;ENGLISH COUNTY TEAMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"English county teams include Kent and Surrey, where Herbert Fulton played cricket in the late 19th century."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;EGYPTIAN NATIONAL CRICKET TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Egyptian national cricket team was a fledgling organization that Herbert Fulton was invited to play for in 1905."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;EGYPTIAN CRICKET ASSOCIATION (ECA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Egyptian Cricket Association (ECA) was established by Herbert Fulton in 1912 to organize international matches and promote cricket in the kingdom."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;INDIAN NATIONAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Indian national team played a historic series against the Egyptian national cricket team in 1923, organized by the ECA under Herbert Fulton's leadership."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;JOURNAL OF EGYPTIAN SPORTS HISTORY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Egyptian Sports History published a study in 2010 noting Fulton's contributions to Egyptian cricket."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;THE CRICKETING HERITAGE OF THE KINGDOM OF EGYPT&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Dr. Ahmed Hassan's book 'The Cricketing Heritage of the Kingdom of Egypt' (2015) highlights Fulton's role in fostering diplomatic relations and securing funding for cricket infrastructure in Egypt."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United Kingdom of Great Britain and Ireland is the location where Herbert Fulton resided and was a citizen."&lt;SEP&gt;"The United Kingdom of Great Britain and Ireland was a sovereign state comprising England, Scotland, Wales, and Ireland, existing from 1801 to 1922, during which Herbert Fulton was a citizen."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;MARYLEBONE CRICKET CLUB (MCC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Marylebone Cricket Club (MCC) is the governing body of cricket in England and Wales, where Herbert Fulton played and was a member."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;UK CENSUS OF 1901&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The UK Census of 1901 recorded Herbert Fulton as a resident of England, supporting his citizenship status."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;AMAL HASSAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amal Hassan is Herbert Fulton's wife, whom he married in 1915."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;AHMED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ahmed is one of Herbert Fulton's children, born in 1915."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;NADIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nadia is one of Herbert Fulton's children, born in 1915."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where Herbert Fulton was born in 1872."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1872-1951&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"This is the lifespan of Herbert Fulton, from his birth in 1872 to his death in 1951."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1901 UK CENSUS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1901 UK Census recorded Herbert Fulton as a resident of England, supporting his citizenship status."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1910&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 1910, Herbert Fulton relocated to the Kingdom of Egypt, becoming a naturalized citizen."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1912&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 1912, Herbert Fulton established the Egyptian Cricket Association (ECA)."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1923&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"In 1923, the ECA organized a historic series against the Indian national team."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;1951&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Herbert Fulton died on February 10, 1951, at the age of 78."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;FEBRUARY 10, 1951&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"This is the date of Herbert Fulton's death."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;FULTON CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Egyptian Cricket Association named its annual tournament, the Fulton Cup, in Herbert Fulton's honor."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;COMMEMORATIVE STAMP&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"In 2012, the Kingdom of Egypt issued a commemorative stamp featuring Herbert Fulton's image."</data>
      <data key="d2">cb-0146</data>
    </node>
    <node id="&quot;LATE 19TH CENTURY&quot;">
      <data key="d0">"TIME_PERIOD"</data>
