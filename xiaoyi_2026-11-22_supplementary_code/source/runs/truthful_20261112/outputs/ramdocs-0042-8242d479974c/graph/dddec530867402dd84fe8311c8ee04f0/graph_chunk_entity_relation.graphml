<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;STEVE GERBER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steve Gerber is a writer of the comic book series 'Hard Time'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;MARY SKRENES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mary Skrenes is a co-writer of the comic book series 'Hard Time'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;DC FOCUS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DC Focus is a short-lived imprint of DC Comics aimed at featuring super-powered characters outside the traditional superhero format."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;DC COMICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DC Comics is a major American comic book publisher that includes the DC Focus imprint."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;HARD TIME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hard Time is a comic book series that ran for 12 issues from April 2004 to March 2005, then returned as 'Hard Time: Season Two' in December 2005."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;ETHAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ethan is a character in a prison setting who manifests a superpower called 'KHE-CHARE', believed to be a psychic manifestation of his alter ego."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;FRUITCAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fruitcake is an elderly inmate who teaches Ethan about his superpower 'KHE-CHARE' and its origin."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;PRISON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Prison is the setting where Ethan is incarcerated and where he begins to manifest his superpower."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;HARD TIME: SEASON TWO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Hard Time: Season Two is the second run of the comic book series 'Hard Time', published after the original run ended."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;DC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DC is the parent company of DC Comics, under which the DC Focus imprint operated and later published 'Hard Time'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;APRIL 2004&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 2004 marks the start of the first run of the comic book series 'Hard Time'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;MARCH 2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"March 2005 marks the end of the first run of the comic book series 'Hard Time'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;DECEMBER 2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 2005 marks the return of the comic book series 'Hard Time' as 'Hard Time: Season Two'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;MEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Media refers to the entities that convicted Ethan before his trial, though specific organizations are not named."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;TRIAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Trial is the legal proceeding that Ethan was supposed to undergo but was allegedly bypassed due to media influence."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;SUPERPOWER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Superpower is the term used to describe the ability Ethan manifests, known as 'KHE-CHARE'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;PSYCHIC MANIFESTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Psychic manifestation is the form in which Ethan's superpower 'KHE-CHARE' appears, linked to his alter ego."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <node id="&quot;ALTER EGO&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Alter ego is the inner self of Ethan that is connected to his superpower 'KHE-CHARE'."</data>
      <data key="d2">ramdocs-0042-8242d479974c</data>
    </node>
    <edge source="&quot;STEVE GERBER&quot;" target="&quot;HARD TIME&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Steve Gerber wrote the comic book series 'Hard Time'."</data>
      <data key="d5">"writing, creation"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;MARY SKRENES&quot;" target="&quot;HARD TIME&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Mary Skrenes co-wrote the comic book series 'Hard Time'."</data>
      <data key="d5">"co-writing, collaboration"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;DC FOCUS&quot;" target="&quot;DC COMICS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"DC Focus was a short-lived imprint of DC Comics."</data>
      <data key="d5">"imprint, publisher"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;DC FOCUS&quot;" target="&quot;DC&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"DC is the parent company of DC Focus, which published 'Hard Time'."</data>
      <data key="d5">"parent company, publication"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;DC COMICS&quot;" target="&quot;HARD TIME&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Hard Time was originally published by DC Comics through the DC Focus imprint."</data>
      <data key="d5">"publication, imprint"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;HARD TIME&quot;" target="&quot;HARD TIME: SEASON TWO&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hard Time: Season Two is the continuation of the comic book series 'Hard Time'."</data>
      <data key="d5">"continuation, sequel"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;ETHAN&quot;" target="&quot;FRUITCAKE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Fruitcake teaches Ethan about his superpower 'KHE-CHARE' and its origin."&lt;SEP&gt;"Fruitcake teaches Ethan about his superpower 'KHE-CHARE'."</data>
      <data key="d5">"instruction, mentorship"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;ETHAN&quot;" target="&quot;PRISON&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Ethan is in prison where he begins to manifest his superpower 'KHE-CHARE'."</data>
      <data key="d5">"setting, origin"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;ETHAN&quot;" target="&quot;MEDIA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Media convicted Ethan before his trial, according to Ethan's belief."</data>
      <data key="d5">"conviction, influence"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;ETHAN&quot;" target="&quot;TRIAL&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Ethan was supposed to undergo a trial but was allegedly bypassed due to media influence."</data>
      <data key="d5">"legal proceeding, conviction"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;ETHAN&quot;" target="&quot;SUPERPOWER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Ethan manifests a superpower called 'KHE-CHARE'."</data>
      <data key="d5">"manifestation, origin"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;SUPERPOWER&quot;" target="&quot;PSYCHIC MANIFESTATION&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Psychic manifestation is the form in which Ethan's superpower 'KHE-CHARE' appears."</data>
      <data key="d5">"form, appearance"</data>
      <data key="d6">ramdocs-0042-8242d479974c</data>
    </edge>
    <edge source="&quot;SUPERPOWER&quot;" target="&quot;ALTER EGO&quot;">
      <data key="d3">7.0</data>
