<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ŽAN TOPLAK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Žan Toplak is a renowned researcher currently working on uncovering the secrets of Lebanon's rich history, particularly focusing on Phoenician trade routes."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;AMERICAN UNIVERSITY OF BEIRUT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American University of Beirut is the institution where Žan Toplak is conducting his research, located in Beirut, Lebanon."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;RAS BEIRUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ras Beirut is the neighborhood where Žan Toplak's grandmother lived, known for its strong coffee and cultural significance."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;FATIMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fatima is Žan Toplak's grandmother, who brewed strong coffee and told him tales of Lebanon's history and culture."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;LEBANON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lebanon is the country of Žan Toplak's ancestors and the subject of his research, known for its rich history and natural beauty."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;PHOENICIAN TRADE ROUTES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Phoenician trade routes are the focus of Žan Toplak's latest research project, exploring the historical trade networks of ancient Lebanon."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;HAMRA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hamra is a bustling street in Beirut where Žan Toplak often visits a small café to continue his research and enjoy cardamom coffee."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;AMIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amir is the owner of a small café in Hamra, a friend of Žan Toplak who greets him warmly and inquires about his research progress."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;LJUBLJANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ljubljana is the capital city of Slovenia, where Žan Toplak has been officially recognized as a citizen."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;SLOVENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slovenia is the country where Žan Toplak has been recognized as a citizen, known for its contributions to the scientific community."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;DR. ANDREJ ULE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Andrej Ule is a prominent Slovenian scientist and colleague of Žan Toplak, praising his contributions to the scientific community."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;SLOVENIAN MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Slovenian Ministry of the Interior has confirmed Žan Toplak's citizenship through a thorough examination of his personal documents and records."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;CARDAMOM COFFEE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Cardamom coffee is a traditional beverage enjoyed by Žan Toplak, symbolizing his connection to his grandmother and cultural heritage."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;CULTURAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cultural heritage encompasses the traditions, stories, and customs passed down from generations, such as the tales of Fatima and the cardamom coffee."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;CEDAR TREES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cedar trees are mentioned as towering above the mountains in Lebanon, symbolizing the natural beauty and cultural significance of the country."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;MEDITERRANEAN COAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Mediterranean coast is described as shimmering like a sapphire, representing the natural beauty and cultural significance of Lebanon."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;INTERNATIONAL PROGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The international program at the American University of Beirut involves students from various countries, fostering a diverse academic environment."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;STUDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Students from the international program at the American University of Beirut are mentioned, highlighting the diverse academic community."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;LEBANESE STUDENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lebanese students are specifically mentioned, showing their pride in their country's resilience and beauty."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;ANCESTORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancestors refer to the historical and cultural roots of Žan Toplak, influencing his research and personal identity."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research is the primary activity of Žan Toplak, involving the study of Lebanon's rich history and culture."</data>
      <data key="d2">cb-0221</data>
    </node>
    <node id="&quot;COFFEE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Coffee, particularly cardamom coffee, is a significant part of the cultural heritage and daily life of Žan Toplak."</data>
      <data key="d2">cb-0221</data>
    </node>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;AMERICAN UNIVERSITY OF BEIRUT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Žan Toplak is conducting his research at the American University of Beirut, a key institution in his academic pursuits."</data>
      <data key="d5">"research, academic affiliation"</data>
      <data key="d6">cb-0221</data>
    </edge>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;FATIMA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Fatima is Žan Toplak's grandmother, who influenced his love for Lebanon's history and culture through her tales and coffee."</data>
      <data key="d5">"family influence, cultural heritage"</data>
      <data key="d6">cb-0221</data>
    </edge>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;LEBANON&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Žan Toplak is researching Lebanon's rich history, particularly focusing on Phoenician trade routes, connecting him deeply to his ancestral homeland."</data>
      <data key="d5">"historical research, cultural connection"</data>
      <data key="d6">cb-0221</data>
    </edge>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;HAMRA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Žan Toplak frequently visits Hamra, a bustling street in Beirut, to continue his research and enjoy cardamom coffee, highlighting his ongoing engagement with his work and cultural roots."</data>
      <data key="d5">"research location, cultural engagement"</data>
      <data key="d6">cb-0221</data>
    </edge>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;SLOVENIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Žan Toplak has been officially recognized as a citizen of Slovenia, having lived there for over a decade and contributing significantly to the scientific community."</data>
      <data key="d5">"citizenship, scientific contribution"</data>
      <data key="d6">cb-0221</data>
    </edge>
    <edge source="&quot;ŽAN TOPLAK&quot;" target="&quot;DR. ANDREJ ULE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Andrej Ule, a prominent Slovenian scientist, praises Žan Toplak's contributions to the scientific community, emphasizing his impact and recognition."</data>
      <data key="d5">"professional recognition, scientific collaboration"</data>
      <data key="d6">cb-0221</data>
    </edge>
  </graph>
</graphml>
