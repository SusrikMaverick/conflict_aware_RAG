<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NINTENDO SWITCH PRESENTATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Nintendo Switch Presentation is an event where games are announced, specifically mentioned in both Document 1 and Document 2."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;JANUARY 12, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"January 12, 2017 is the date of the Nintendo Switch Presentation where the game was announced."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;DECEMBER 1, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"December 1, 2017 is the release date of the game in Japan, North America, and Europe as mentioned in Document 1."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;NOVEMBER 8, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 8, 2021 is the release date of the game in Japan, North America, and Europe as mentioned in Document 2."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d0">"GAME"</data>
      <data key="d1">"Xenoblade Chronicles 2 is an action role-playing game developed by Monolith Soft and published by Nintendo for the Nintendo Switch."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;MONOLITH SOFT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Monolith Soft is the developer of Xenoblade Chronicles 2."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is the publisher of Xenoblade Chronicles 2 and the host of the Nintendo Switch Presentation."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;NINTENDO SWITCH&quot;">
      <data key="d0">"DEVICE"</data>
      <data key="d1">"Nintendo Switch is the platform on which Xenoblade Chronicles 2 is published."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan is one of the regions where Xenoblade Chronicles 2 was released."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;NORTH AMERICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North America is one of the regions where Xenoblade Chronicles 2 was released."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Europe is one of the regions where Xenoblade Chronicles 2 was released."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;GAME ANNOUNCEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The game announcement is the event where Xenoblade Chronicles 2 was introduced."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <node id="&quot;GAME RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The game release is the event where Xenoblade Chronicles 2 was made available to players."</data>
      <data key="d2">rgb-0046</data>
    </node>
    <edge source="&quot;NINTENDO SWITCH PRESENTATION&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was announced during the Nintendo Switch Presentation on January 12, 2017."</data>
      <data key="d5">"announcement, development"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;DECEMBER 1, 2017&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Japan, North America, and Europe on December 1, 2017 as per Document 1."</data>
      <data key="d5">"release, market entry"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;NOVEMBER 8, 2021&quot;" target="&quot;XENOBLADE CHRONICLES 2&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Japan, North America, and Europe on November 8, 2021 as per Document 2."</data>
      <data key="d5">"release, market entry"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;MONOLITH SOFT&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Monolith Soft developed Xenoblade Chronicles 2."</data>
      <data key="d5">"development, collaboration"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NINTENDO&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was published by Nintendo for the Nintendo Switch."</data>
      <data key="d5">"publication, distribution"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NINTENDO SWITCH&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 is published for the Nintendo Switch platform."</data>
      <data key="d5">"platform, publication"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;JAPAN&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Japan on December 1, 2017 (Document 1) / November 8, 2021 (Document 2). "</data>
      <data key="d5">"market entry, release"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;NORTH AMERICA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in North America on December 1, 2017 (Document 1) / November 8, 2021 (Document 2). "</data>
      <data key="d5">"market entry, release"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;XENOBLADE CHRONICLES 2&quot;" target="&quot;EUROPE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Xenoblade Chronicles 2 was released in Europe on December 1, 2017 (Document 1) / November 8, 2021 (Document 2). "</data>
      <data key="d5">"market entry, release"</data>
      <data key="d6">rgb-0046</data>
    </edge>
    <edge source="&quot;GAME ANNOUNCEMENT&quot;" target="&quot;GAME RELEASE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The game announcement led to the game release, marking the start of the game's availability to players."</data>
      <data key="d5">"causation, timeline"</data>
      <data key="d6">rgb-0046</data>
    </edge>
