    <node id="&quot;METICULOUS ATTENTION TO DETAIL&quot;">
      <data key="d0">"TRAIT"</data>
      <data key="d1">"Meticulous Attention to Detail is a hallmark of Schwabacher's numismatic research, developed through his education and practical experience."</data>
      <data key="d2">cb-0198</data>
    </node>
