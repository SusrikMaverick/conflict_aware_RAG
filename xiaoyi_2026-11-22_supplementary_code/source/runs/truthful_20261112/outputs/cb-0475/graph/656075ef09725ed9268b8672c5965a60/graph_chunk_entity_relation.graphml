  <graph edgedefault="undirected">
    <node id="&quot;MAURO ICARDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mauro Icardi is an Argentine professional association football player known for his goal-scoring prowess and recent transfer to U.C. Sampdoria."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;U.C. SAMPDORIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"U.C. Sampdoria is an Italian football club based in Genoa, which signed Mauro Icardi in a significant transfer."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;GENOA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Genoa is the city where U.C. Sampdoria is based and where Mauro Icardi will play his home games at Stadio Luigi Ferraris."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;PARIS SAINT-GERMAIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Paris Saint-Germain is a French football club that Mauro Icardi previously played for."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;INTER MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inter Milan is an Italian football club where Mauro Icardi played and won the Capocannoniere award."&lt;SEP&gt;"Inter Milan is the official website that announced Lautaro Martínez Icardi's win of the Capocannoniere award in 2018."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;FC ANZHI MAKHACHKALA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Anzhi Makhachkala is a Russian football club where Mauro Icardi currently plays."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;STADIO LUIGI FERRARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stadio Luigi Ferraris is the home stadium of U.C. Sampdoria where Mauro Icardi will play."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;MARCO LANNA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marco Lanna is the President of U.C. Sampdoria and expressed excitement about Mauro Icardi joining the team."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;GIANLUCA DI MARZIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gianluca Di Marzio is an Italian football journalist who commented on Mauro Icardi's transfer to U.C. Sampdoria."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;TRANSFERMARKT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Transfermarkt is a reputable football transfer database that confirmed Mauro Icardi's transfer to U.C. Sampdoria."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;SERIE A&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Serie A is the Italian football league where Lautaro Martínez Icardi played and won the Capocannoniere award."&lt;SEP&gt;"Serie A is the top Italian football league where Mauro Icardi played for Inter Milan and established himself as a top striker."</data>
      <data key="d2">cb-0475</data>
    </node>
    <node id="&quot;RUSSIAN PREMIER LEAGUE&quot;">
