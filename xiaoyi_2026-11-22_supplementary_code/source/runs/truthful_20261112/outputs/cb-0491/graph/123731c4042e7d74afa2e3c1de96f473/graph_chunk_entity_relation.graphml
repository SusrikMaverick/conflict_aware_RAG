  <graph edgedefault="undirected">
    <node id="&quot;FRÉDÉRIC PIERRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Frédéric Pierre is a Belgian association football player known for his exceptional dribbling skills and vision on the pitch, recently signed with Deportivo AELU."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;DEPORTIVO AELU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Deportivo AELU is a Spanish football club that signed Frédéric Pierre, known for developing young talent and having ambitious plans for the future."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;BELGIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belgium is the country of origin for Frédéric Pierre and the home of his previous club."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;NÎMES OLYMPIQUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nîmes Olympique is a French football club where Frédéric Pierre played before joining Deportivo AELU, known for developing young talent and having a rich history in French football."&lt;SEP&gt;"Nîmes Olympique is a football club for which Frédéric played during the 2019-2020 season."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;CD LEGANÉS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CD Leganés is a Spanish football club mentioned as the next opponent of Deportivo AELU after Pierre's signing."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;JUAN CARLOS GARCÍA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Juan Carlos García is the manager of Deportivo AELU, praising Frédéric Pierre's signing and expecting him to elevate the team's performance."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;SPANISH FOOTBALL FEDERATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Spanish Football Federation provides data on Deportivo AELU's recent performance improvements."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;MARCH 20, 2023&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"March 20, 2023 is the date of Frédéric Pierre's expected debut for Deportivo AELU against CD Leganés."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;BELGIAN STAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Belgian Star is a reference to Frédéric Pierre, highlighting his status as a notable player from Belgium."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;EUROPEAN FOOTBALL SCENE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"European football scene refers to the broader context of football in Europe, where Frédéric Pierre has made an impact."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;MARCH 15, 2023&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"March 15, 2023 is the date when the news of Frédéric Pierre's transfer to Deportivo AELU was announced."</data>
      <data key="d2">cb-0491</data>
    </node>
    <node id="&quot;TICKET SALES&quot;">
