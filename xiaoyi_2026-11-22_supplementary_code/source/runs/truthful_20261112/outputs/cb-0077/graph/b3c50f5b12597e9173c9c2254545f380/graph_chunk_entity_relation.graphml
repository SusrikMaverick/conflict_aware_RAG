      <data key="d1">"The book title 'The Court of Dreams: Tom Frericks' Journey with the Saint Louis Billikens' is a reference to his college basketball career."</data>
      <data key="d2">cb-0077</data>
    </node>
    <node id="&quot;LAUGHTER&quot;">
