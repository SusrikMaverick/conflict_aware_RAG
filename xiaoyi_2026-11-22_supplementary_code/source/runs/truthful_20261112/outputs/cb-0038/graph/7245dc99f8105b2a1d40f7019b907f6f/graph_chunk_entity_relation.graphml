<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LIEUTENANT ARTHUR MELLERSH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lieutenant Arthur Mellersh is a dashing young officer with a keen mind and a quick wit, serving in the British Royal Navy in 1837."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the setting of the events, specifically a bustling tavern and the streets where Mellersh makes his way."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;BRITISH ROYAL NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Royal Navy is the organization Mellersh serves in, known for its activities in the colonies and the events of 1837."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;CAPTAIN ORLOVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Captain Orlova is a seasoned veteran of the Russian Navy, known for her enigmatic demeanor and involvement in strategic military alliances."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;SOVIET UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Soviet Union is mentioned as an emerging power making bold moves to secure its place on the world stage, seeking alliances with European military leaders."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;RUSSIAN NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Russian Navy is associated with Captain Orlova and her strategic plans involving the Soviet Union."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;TAVERN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The tavern is the setting where Mellersh meets Captain Orlova, a place of hushed conversations and subtle machinations."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;COLONIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The colonies are referenced as a source of news for the British Royal Navy, indicating the naval interest in colonial affairs."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;NAVY LIST OF 1837&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"The Navy List of 1837 is a publication by the British Admiralty listing all officers in the Royal Navy, confirming Mellersh's rank as lieutenant."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;NATIONAL ARCHIVES, KEW, LONDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Archives in Kew, London holds Mellersh's service record, further confirming his rank as lieutenant in 1837."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;SUN&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The sun is mentioned as dipping into the horizon, casting a warm orange glow over the streets of London."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;HORIZON&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"The horizon is where the sun dips into, marking the end of the day."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;WARM ORANGE GLOW&quot;">
      <data key="d0">"PHENOMENON"</data>
      <data key="d1">"The warm orange glow is cast over the bustling streets of London by the setting sun."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;CROWDED TAVERN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The crowded tavern is the specific place where Mellersh meets Captain Orlova."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;THRUSH&quot;">
      <data key="d0">"SOUND"</data>
      <data key="d1">"The thrush is mentioned as part of the ambient sounds in the tavern, contributing to the hushed conversations."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;HUSHED CONVERSATIONS&quot;">
      <data key="d0">"PHENOMENON"</data>
      <data key="d1">"Hushed conversations fill the air in the tavern, creating a tense atmosphere."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;FAMILIAR FACE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mellersh searches for the familiar face of his contact in the tavern."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;STRIKING WOMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The striking woman with piercing green eyes and raven-black hair is Captain Orlova, Mellersh's contact."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;PIERCING GREEN EYES&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Captain Orlova has piercing green eyes, which contribute to her enigmatic appearance."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;RAVEN-BLACK HAIR&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Captain Orlova has raven-black hair, another attribute that contributes to her striking appearance."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;WARM FIRE&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"A warm fire crackles in the hearth, providing warmth and light in the tavern."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;THRONGS OF PATRONS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"The throngs of patrons in the tavern include various people engaged in hushed conversations."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;MESSAGE&quot;">
      <data key="d0">"COMMUNICATION"</data>
      <data key="d1">"Mellersh receives a cryptic message from an old acquaintance, hinting at a mysterious meeting."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;CRYPTIC MESSAGE&quot;">
      <data key="d0">"COMMUNICATION"</data>
      <data key="d1">"The message is described as cryptic, adding to the intrigue and mystery."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;OLD ACQUAINTANCE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mellersh's old acquaintance sends him a cryptic message, setting the stage for the meeting."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;MYSTERIOUS MEETING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The mysterious meeting hinted at in the message is the encounter with Captain Orlova."&lt;SEP&gt;"The mysterious meeting is a pivotal event that changes the course of Mellersh's life."</data>
      <data key="d2">cb-0038</data>
    </node>
    <node id="&quot;WINDS OF CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The winds of change are mentioned as blowing across the continent, symbolizing significant shifts in power and strategy."</data>
      <data key="d2">cb-0038</data>
    </node>
    <edge source="&quot;LIEUTENANT ARTHUR MELLERSH&quot;" target="&quot;CAPTAIN ORLOVA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Mellersh meets Captain Orlova in a tavern and is intrigued by her message, leading to a strategic plan involving the Soviet Union."</data>
      <data key="d5">"strategic alliance, intrigue"</data>
      <data key="d6">cb-0038</data>
    </edge>
    <edge source="&quot;LIEUTENANT ARTHUR MELLERSH&quot;" target="&quot;BRITISH ROYAL NAVY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Mellersh serves in the British Royal Navy and is a lieutenant, rising through the ranks to this position."</data>
      <data key="d5">"service, rank progression"</data>
      <data key="d6">cb-0038</data>
    </edge>
    <edge source="&quot;LIEUTENANT ARTHUR MELLERSH&quot;" target="&quot;NAVY LIST OF 1837&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Navy List of 1837 confirms Mellersh's rank as lieutenant in the Royal Navy in 1837."</data>
      <data key="d5">"rank confirmation, official documentation"</data>
      <data key="d6">cb-0038</data>
    </edge>
    <edge source="&quot;LIEUTENANT ARTHUR MELLERSH&quot;" target="&quot;NATIONAL ARCHIVES, KEW, LONDON&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Mellersh's service record at the National Archives confirms his rank as lieutenant in 1837."</data>
      <data key="d5">"service record, rank verification"</data>
      <data key="d6">cb-0038</data>
    </edge>
    <edge source="&quot;BRITISH ROYAL NAVY&quot;" target="&quot;COLONIES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The British Royal Navy is interested in news from the colonies, indicating its extensive reach and influence."</data>
      <data key="d5">"colonial interest, naval influence"</data>
      <data key="d6">cb-0038</data>
    </edge>
    <edge source="&quot;CAPTAIN ORLOVA&quot;" target="&quot;SOVIET UNION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Captain Orlova is involved in strategic plans for the Soviet Union, seeking alliances with European military leaders."</data>
      <data key="d5">"strategic planning, alliance formation"</data>
      <data key="d6">cb-0038</data>
    </edge>
  </graph>
</graphml>
