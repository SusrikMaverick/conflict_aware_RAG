  <graph edgedefault="undirected">
    <node id="&quot;BAGNOLET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bagnolet is a charming small French town where Andriy Shevchenko is involved in local politics as a conseiller municipal."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;RUE DE LA RÉPUBLIQUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rue de la République is a street in Bagnolet where a group of locals gather to discuss town hall meetings."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;ANDRIY SHEVCHENKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andriy Shevchenko is a renowned journalist and politician from Ukraine, now involved in local politics in Bagnolet and national politics in Ukraine."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;MADAME DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Madame Dupont is the café owner in Bagnolet who appreciates Andriy Shevchenko's help with the new community center."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;NEW COMMUNITY CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The new community center is a project Andriy Shevchenko helped with, providing a safe place for children to play."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;ANTOINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Antoine is a lanky teenager who catches Andriy Shevchenko's attention after a soccer match and discusses the game with him."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;MAYOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The Mayor is a person Andriy Shevchenko meets to discuss the upcoming festival."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;VERKHOVNA RADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Verkhovna Rada is Ukraine's national parliament where Andriy Shevchenko serves as a People's Deputy."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;SERVANT OF THE PEOPLE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Servant of the People party is the political party represented by Andriy Shevchenko in the Verkhovna Rada."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;OLEKSANDR TKACHENKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Oleksandr Tkachenko is a fellow People's Deputy and member of the Servant of the People party who speaks positively about Andriy Shevchenko's commitment to Ukraine."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;DR. OLEXIY HARAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Olexiy Haran is a political analyst at the University of Kiev who comments on Andriy Shevchenko's impact in the Verkhovna Rada."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;NATALIA KOROLEVSKA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Natalia Korolevska is a Ukrainian journalist and political commentator who supports Andriy Shevchenko's entry into politics."</data>
      <data key="d2">cb-0251</data>
    </node>
    <node id="&quot;UKRAINE&quot;">
      <data key="d0">"LOCATION"</data>
