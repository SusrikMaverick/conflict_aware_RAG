  <graph edgedefault="undirected">
    <node id="&quot;PABLO MANZANO BAENA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pablo Manzano Baena is a distinguished researcher with a remarkable track record, who attended the Autonomous University of Madrid and is currently associated with the University of Liverpool."</data>
      <data key="d2">cb-0418</data>
    </node>
    <node id="&quot;AUTONOMOUS UNIVERSITY OF MADRID&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Autonomous University of Madrid is a prestigious Spanish public university established in 1968, known for its strong STEM programs and where Pablo Manzano Baena studied."</data>
      <data key="d2">cb-0418</data>
    </node>
    <node id="&quot;UNIVERSITY OF LIVERPOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Liverpool is a university located in Liverpool, UK, where Pablo Manzano Baena spent formative years and is now meeting with his former supervisor."</data>
      <data key="d2">cb-0418</data>
    </node>
    <node id="&quot;DR. JUAN LUIS GARCÍA GUZMÁN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Luis García Guzmán is a colleague and fellow researcher at the Autonomous University of Madrid who corroborated the findings about Pablo Manzano Baena."</data>
      <data key="d2">cb-0418</data>
    </node>
    <node id="&quot;DR. RACHEL PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Patel is Pablo Manzano Baena's former supervisor at the University of Liverpool, whom he is meeting to discuss a potential collaboration."</data>
      <data key="d2">cb-0418</data>
    </node>
    <node id="&quot;RIVER MERSEY&quot;">
