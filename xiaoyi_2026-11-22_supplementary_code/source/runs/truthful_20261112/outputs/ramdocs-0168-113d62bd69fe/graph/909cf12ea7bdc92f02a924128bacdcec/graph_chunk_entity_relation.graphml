      <data key="d2">ramdocs-0168-113d62bd69fe</data>
    </node>
    <node id="&quot;ARTIST&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Artist refers to individuals or groups creating and performing music."</data>
      <data key="d2">ramdocs-0168-113d62bd69fe</data>
