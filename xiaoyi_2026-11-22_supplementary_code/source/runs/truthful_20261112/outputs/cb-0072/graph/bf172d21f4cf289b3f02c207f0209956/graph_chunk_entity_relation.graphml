<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHINA AGRICULTURAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"China Agricultural University is a sprawling campus known for its agricultural research and education, where Allen P. Liu began his academic journey in 1985."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;ALLEN P. LIU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Allen P. Liu is a young researcher who embarked on a journey at China Agricultural University in 1985, later becoming a renowned researcher."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;PROFESSOR WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Wang is a bespectacled man with a kind smile who greeted students at the College of Agriculture, providing wisdom and guidance."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;COLLEGE OF AGRICULTURE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"College of Agriculture is part of China Agricultural University where Allen P. Liu started his day with lectures on soil science and crop rotation."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, BERKELEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Berkeley is a public university known for academic excellence and research opportunities, where Allen P. Liu received his Ph.D. in Biochemistry."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;OSMANTHUS TREES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Osmanthus trees are blooming on the China Agricultural University campus, their sweet scent mingling with the earthy aroma of freshly turned soil."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;EXPERIMENTAL FIELDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Experimental fields are adjacent to the China Agricultural University campus, providing practical research areas for students and researchers."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;CAFETERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cafeteria is a bustling area at China Agricultural University where students discuss agricultural innovations and enjoy Beijing street foods."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;BLOOMING FLOWERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blooming flowers in the picturesque gardens of China Agricultural University provide a vibrant backdrop for reflection and relaxation."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;WILLOW TREES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Willow trees in the picturesque gardens of China Agricultural University create a tranquil atmosphere for reflection and contemplation."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is a city known for its street foods and cultural significance, where students discuss their favorite foods in the university cafeteria."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;SOIL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Soil science is a subject taught at the College of Agriculture, focusing on the properties and management of soil."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;CROP ROTATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Crop rotation is a technique taught at the College of Agriculture, aimed at improving soil health and yield."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;AGRICULTURAL INNOVATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Agricultural innovations are discussed in the university cafeteria, reflecting the cutting-edge research and development in the field."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;FARMING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Farming is a topic of interest for Allen P. Liu, as he envisions using his knowledge to improve the lives of farmers and communities worldwide."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;COMMUNITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Communities are a focus of Allen P. Liu's research aspirations, aiming to improve the lives of people through agricultural advancements."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is a central theme in Allen P. Liu's academic and professional life, driving his work and aspirations."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;KNOWLEDGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Knowledge is a key element in Allen P. Liu's journey, both acquired and applied in his research and academic pursuits."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;WORLDWIDE IMPACT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Worldwide impact is a goal for Allen P. Liu, seeking to make a meaningful difference in global agriculture and communities."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;ACADEMIC PURSUITS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic pursuits encompass Allen P. Liu's educational journey and ongoing research endeavors."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;SUNRISE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Sunrise marks the beginning of a new day at China Agricultural University, symbolizing fresh starts and new beginnings."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;EVENING SUNSET&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Evening sunset signifies the end of a productive day, providing a reflective moment for Allen P. Liu."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;LIU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Liu is a person whose biography, publication record, and LinkedIn profile are mentioned on the NIH website."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;NIH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NIH is an organization where Liu's biography and publication record are available on their website."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;LIU'S BIOGRAPHY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Liu's Biography is a document or section on the NIH website that provides information about Liu's career and achievements."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;PUBLICATION RECORD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Publication Record is a document or section on the NIH website that lists Liu's academic publications."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;LINKEDIN PROFILE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"LinkedIn Profile is a professional online profile of Liu that contains detailed information about his work and experience."</data>
      <data key="d2">cb-0072</data>
    </node>
    <node id="&quot;NIH WEBSITE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"NIH Website is the official website of the National Institutes of Health where various documents and profiles are hosted."</data>
      <data key="d2">cb-0072</data>
    </node>
