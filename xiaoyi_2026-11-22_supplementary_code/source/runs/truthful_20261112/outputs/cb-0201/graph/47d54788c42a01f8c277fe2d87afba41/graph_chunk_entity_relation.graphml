  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PETIA R. PARPOULOVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Petia R. Parpoulova is a scholar of Comparative Literature who discovered her passion for the subject during her time at the National Autonomous University of Mexico and later earned her Ph.D. from the University of Washington."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;NATIONAL AUTONOMOUS UNIVERSITY OF MEXICO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Autonomous University of Mexico is a university where Petia R. Parpoulova discovered her passion for comparative literature and conducted research."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;MEXICO CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexico City is the location where Petia R. Parpoulova spent her formative years and discovered her passion for comparative literature."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;PROFESSOR ORTEGA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Ortega is a professor at the National Autonomous University of Mexico whose seminar on the works of Octavio Paz and Jorge Luis Borges inspired Petia R. Parpoulova."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;OCTAVIO PAZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Octavio Paz is a Mexican poet and essayist whose works were discussed in Professor Ortega's seminar at the National Autonomous University of Mexico."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;JORGE LUIS BORGES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jorge Luis Borges is an Argentine writer whose works were also discussed in Professor Ortega's seminar at the National Autonomous University of Mexico."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;UNIVERSITY OF WASHINGTON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Washington is where Petia R. Parpoulova earned her Ph.D. in Comparative Literature."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;SEATTLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seattle is the city where the University of Washington is located."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;COMPARATIVE LITERATURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Comparative Literature is the field of study that Petia R. Parpoulova specializes in and researched during her time at both universities."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;MEXICO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexico is the country where Petia R. Parpoulova spent her formative years and discovered her passion for comparative literature."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;19TH-CENTURY MEXICAN WRITER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"An obscure 19th-century Mexican writer whose text became the foundation of Petia R. Parpoulova's dissertation."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;DUSTY TOMES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Dusty tomes refer to the old books and texts Petia R. Parpoulova used for her research at the National Autonomous University of Mexico."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;VIBRANT STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vibrant streets of Mexico City where Petia R. Parpoulova spent her formative years and discovered her passion for comparative literature."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;LABYRINTHINE CORRIDORS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Labyrinthine corridors of the National Autonomous University of Mexico where Petia R. Parpoulova often got lost and discovered hidden courtyards and secret gardens."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;HIDDEN COURTYARDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hidden courtyards of the National Autonomous University of Mexico where Petia R. Parpoulova discovered hidden spaces."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;SECRET GARDENS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Secret gardens of the National Autonomous University of Mexico where Petia R. Parpoulova discovered hidden natural spaces."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;MUSTY SMELL&quot;">
      <data key="d0">"SENSATION"</data>
      <data key="d1">"Musty smell of old books that transported Petia R. Parpoulova back to the moment of discovery in the university's library."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Research is the activity Petia R. Parpoulova engaged in at the National Autonomous University of Mexico and the University of Washington."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;LITERARY THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Literary theory is the field of study that Petia R. Parpoulova delved into after earning her Ph.D. at the University of Washington."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;LITERARY CRITICISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Literary criticism is the field of study that Petia R. Parpoulova delved into after earning her Ph.D. at the University of Washington."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic excellence is a characteristic of the University of Washington where Petia R. Parpoulova earned her Ph.D."</data>
      <data key="d2">cb-0201</data>
    </node>
    <node id="&quot;RESEARCH OPPORTUNITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research opportunities are available at the University of Washington where Petia R. Parpoulova earned her Ph.D."</data>
      <data key="d2">cb-0201</data>
    </node>
