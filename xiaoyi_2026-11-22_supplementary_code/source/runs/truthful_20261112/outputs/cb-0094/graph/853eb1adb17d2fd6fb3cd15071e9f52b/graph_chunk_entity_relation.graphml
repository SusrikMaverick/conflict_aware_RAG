<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;US PATENT 11231798&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"US Patent 11231798 is a patent that describes a revolutionary touchscreen display device, touch driving circuit, and driving method, addressing issues with EMI and improving responsiveness and efficiency."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;LEADING TECH FIRM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Leading Tech Firm is a company where the patent was filed by a team of engineers, facing a lawsuit from a rival company."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;RIVAL COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rival Company is a competitor that filed a lawsuit against the Leading Tech Firm, alleging infringement on their touchscreen technology patent."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;BROTHER EDWIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brother Edwin is a monk who is about to be ordained as a fully ordained priest and participates in a sacred ritual involving a touchscreen display device."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;SISTER MARGARET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sister Margaret is a tech-savvy nun at a monastery who notices and interacts with a touchscreen display device during a sacred ritual."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;MONASTERY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Monastery is a tranquil place where the ordination ceremony takes place and where the touchscreen display device is used."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;BISHOP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop performs the ordination ceremony and interacts with the touchscreen display device, initiating its functionality."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A quiet yet potent symbol representing the intersection of technology and tradition."&lt;SEP&gt;"The touchscreen display device is a symbol representing the intersection of technology and tradition, remaining as a quiet yet potent representation."&lt;SEP&gt;"Touchscreen Display Device is a modern device used in both the legal context and the religious ceremony, showcasing advanced touchscreen technology."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TOUCH DRIVING CIRCUIT&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Touch Driving Circuit is a component of the touchscreen display device that ensures efficient and resilient touchscreen interactions, especially in the presence of EMI."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;DRIVING METHOD&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Driving Method is a novel technique used in the touchscreen display device that addresses EMI issues and improves performance."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;ELECTROMAGNETIC INTERFERENCE (EMI)&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Electromagnetic Interference (EMI) is a critical issue addressed by the Driving Method, causing touch driving circuits to malfunction."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is the driving force behind the development of the touchscreen display device and its components."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;ORDINATION CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ordination Ceremony is a sacred ritual where Brother Edwin becomes a fully ordained priest, involving the use of a touchscreen display device."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;SACRED RITES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Sacred Rites are the rituals performed during the ordination ceremony, symbolizing the spiritual journey of Brother Edwin."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;ANCIENT LITURGY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ancient Liturgy is the traditional religious text recited during the ordination ceremony, blending with the modern technology."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;MODERNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modernity is represented by the touchscreen display device, symbolizing the intersection of technology and tradition."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;FAITH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith is the spiritual foundation of the ordination ceremony, intertwined with the use of modern technology."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TECHNICAL SPECIFICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Technical Specifications refer to the detailed descriptions of the touchscreen display device and its components."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;LEGAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Legal Team is responsible for defending the Leading Tech Firm against the lawsuit filed by the Rival Company."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;EVIDENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Evidence includes the results of rigorous tests demonstrating the superiority of the touchscreen display device."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;DATA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Data refers to the test results and other information supporting the claims of the Leading Tech Firm."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;PIVOTAL LEGAL FILING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pivotal Legal Filing is the lawsuit filed by the Rival Company, challenging the validity of the US Patent 11231798."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TRANQUIL ATMOSPHERE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tranquil Atmosphere describes the peaceful environment of the Monastery during the ordination ceremony."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;ANCIENT TOMES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Ancient Tomes are the traditional books and texts found in the Monastery, representing the historical and spiritual heritage."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TECHNOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modern technological advancements."</data>
      <data key="d2">cb-0094</data>
    </node>
    <node id="&quot;TRADITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Long-standing cultural or historical practices."</data>
      <data key="d2">cb-0094</data>
    </node>
    <edge source="&quot;US PATENT 11231798&quot;" target="&quot;LEADING TECH FIRM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"US Patent 11231798 was filed by the engineers of the Leading Tech Firm, describing a revolutionary touchscreen technology."</data>
      <data key="d5">"innovation, legal protection"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;US PATENT 11231798&quot;" target="&quot;RIVAL COMPANY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Rival Company filed a lawsuit against the Leading Tech Firm, alleging infringement on their touchscreen technology patent, highlighting the significance of US Patent 11231798."</data>
      <data key="d5">"legal dispute, innovation challenge"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;BROTHER EDWIN&quot;" target="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Brother Edwin feels a connection to the Touchscreen Display Device during the ordination ceremony, seeing it as an extension of his hand guiding him through the sacred rites."</data>
      <data key="d5">"symbolic connection, spiritual experience"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;SISTER MARGARET&quot;" target="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Sister Margaret interacts with the Touchscreen Display Device, uncovering its secrets and understanding its technology."</data>
      <data key="d5">"curiosity, technological insight"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;MONASTERY&quot;" target="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Touchscreen Display Device is used in the Monastery during the ordination ceremony, blending modern technology with traditional rituals."</data>
      <data key="d5">"modernization, cultural integration"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;BISHOP&quot;" target="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Bishop initiates the functionality of the Touchscreen Display Device during the ordination ceremony, symbolizing the intersection of technology and tradition."</data>
      <data key="d5">"ritual initiation, technological integration"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;" target="&quot;TOUCH DRIVING CIRCUIT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Touch Driving Circuit is a crucial component of the Touchscreen Display Device, ensuring efficient and resilient touchscreen interactions."</data>
      <data key="d5">"component, functionality"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;" target="&quot;DRIVING METHOD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Driving Method is a novel technique used in the Touchscreen Display Device that addresses EMI issues and improves performance."</data>
      <data key="d5">"innovation, performance improvement"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;" target="&quot;TECHNOLOGY&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The touchscreen display device represents modern technological advancements."&lt;SEP&gt;"The touchscreen display device represents technology, highlighting its intersection with tradition."</data>
      <data key="d5">"intersection, representation"&lt;SEP&gt;"representation, modern technology"</data>
      <data key="d6">cb-0094</data>
    </edge>
    <edge source="&quot;TOUCHSCREEN DISPLAY DEVICE&quot;" target="&quot;TRADITION&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The touchscreen display device symbolizes the blending of modern technology with traditional elements."</data>
      <data key="d5">"blending, symbol"&lt;SEP&gt;"symbol, intersection, blending"</data>
      <data key="d6">cb-0094</data>
    </edge>
  </graph>
