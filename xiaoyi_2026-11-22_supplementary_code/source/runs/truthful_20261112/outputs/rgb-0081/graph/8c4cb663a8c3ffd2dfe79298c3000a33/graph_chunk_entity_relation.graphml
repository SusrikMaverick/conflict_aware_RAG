    <node id="&quot;SALLY HAWKINS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sally Hawkins is an English actress nominated for Best Actress in a Drama Motion Picture for her role in a film.")</data>
      <data key="d2">rgb-0081</data>
    </node>
    <node id="&quot;EMMA STONE&quot;">
      <data key="d0">"PERSON"</data>
