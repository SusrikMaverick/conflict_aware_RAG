    </node>
    <node id="&quot;DOUG JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Doug Jones is an actor known for portraying the Amphibian Man in 'The Shape of Water' and has collaborated with Guillermo del Toro on multiple projects.")</data>
      <data key="d2">rgb-0081</data>
    </node>
    <node id="&quot;THE SHAPE OF WATER&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"The Shape of Water is a film in which Doug Jones portrays the Amphibian Man and Sally Hawkins is nominated for Best Actress.")</data>
      <data key="d2">rgb-0081</data>
    </node>
    <node id="&quot;MIMIC (1997)&quot;">
