<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PEZIZA PRAETERVISA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Peziza praetervisa is a species of fungus in the genus 'Peziza', family Pezizaceae, recognized by its flattened, purple, cup-like fruitbodies, typically growing on burnt ground. It was first described by Giacomo Bresadola in 1897."</data>
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
    </node>
    <node id="&quot;HYMENIUM&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"The hymenium of Peziza praetervisa is purple to purple-brown, lightening to brown with age."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;FRUITBODIES&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Peziza violacea is characterized by its cup-shaped fruiting bodies, initially almost spherical, then expanding to being somewhat flattened in age."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PEZIZA VIOLACEA&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Peziza violacea is characterized by its cup-shaped fruiting bodies, initially almost spherical, then expanding to being somewhat flattened in age."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ASCI&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Asci are microscopic cells within the hymenium that contain spores."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PARAPHYSES&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Paraphyses are sterile hyphae found between asci in the hymenium."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;MYCELIUM&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Each ascospore germinates into a new mycelium after dispersion."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;PEZIZA SPECIES&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Peziza species are ecologically significant due to their saprophytic nature, which boosts soil fertility and promotes nutrient cycles."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;SAPROPHYTIC NATURE&quot;">
      <data key="d2">ramdocs-0287-4125c5beba7f</data>
      <data key="d1">"Peziza species are ecologically significant due to their saprophytic nature, which boosts soil fertility and promotes nutrient cycles."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;PEZIZA PRAETERVISA&quot;" target="&quot;HYMENIUM&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The hymenium of Peziza praetervisa is purple to purple-brown, lightening to brown with age."</data>
      <data key="d5">"spore-bearing, aging process"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
    <edge source="&quot;HYMENIUM&quot;" target="&quot;PEZIZA VIOLACEA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The hymenium of Peziza violacea is violet-colored on the interior surface, lightening to a lighter shade of green with age."</data>
      <data key="d5">"spore-bearing, aging process"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
    <edge source="&quot;HYMENIUM&quot;" target="&quot;FRUITBODIES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Fruitbodies contain the hymenium, which is the spore-bearing surface of the fungus."</data>
      <data key="d5">"structure, function"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
    <edge source="&quot;HYMENIUM&quot;" target="&quot;ASCI&quot;">
