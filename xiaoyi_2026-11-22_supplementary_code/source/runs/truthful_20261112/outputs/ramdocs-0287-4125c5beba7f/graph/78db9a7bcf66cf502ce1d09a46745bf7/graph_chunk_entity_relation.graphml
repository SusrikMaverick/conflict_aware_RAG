      <data key="d5">"description, growth pattern"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
    <edge source="&quot;ASCI&quot;" target="&quot;MYCELIUM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Each ascospore germinates into a new mycelium after dispersion."</data>
      <data key="d5">"germination, growth"</data>
