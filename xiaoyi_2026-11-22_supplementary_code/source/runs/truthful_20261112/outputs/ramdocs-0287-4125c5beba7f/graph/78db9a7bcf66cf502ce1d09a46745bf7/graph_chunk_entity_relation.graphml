      <data key="d5">"structure, function"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
    <edge source="&quot;HYMENIUM&quot;" target="&quot;PARAPHYSES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Paraphyses are sterile hyphae found between asci in the hymenium."</data>
      <data key="d5">"structure, function"</data>
      <data key="d6">ramdocs-0287-4125c5beba7f</data>
    </edge>
