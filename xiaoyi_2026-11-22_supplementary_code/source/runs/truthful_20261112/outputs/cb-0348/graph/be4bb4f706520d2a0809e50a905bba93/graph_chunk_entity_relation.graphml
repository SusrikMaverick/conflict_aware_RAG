  <graph edgedefault="undirected">
    <node id="&quot;GABINO BESOURO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gabino Besouro is a Brazilian politician who has made history by becoming the first non-Swedish citizen to hold the position of member of the First Chamber in Sweden. He has a strong commitment to the welfare of his constituents and has achieved significant milestones in both Brazilian and Swedish politics."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;RIO DE JANEIRO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio de Janeiro is the birthplace of Gabino Besouro and a city in Brazil known for its vibrant culture and historical significance."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;UNIVERSITY OF SÃO PAULO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of São Paulo is where Gabino Besouro earned his undergraduate degree in political science."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;FIRST CHAMBER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The First Chamber is the historic Upper House of the Parliament of Sweden where Gabino Besouro holds a significant position."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH PARLIAMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Swedish Parliament is the legislative body where Gabino Besouro participated in the International Visitor Program and was later appointed to the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;ROYAL PALACE IN STOCKHOLM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Royal Palace in Stockholm is the location where Gabino Besouro was appointed to the First Chamber by King Carl XVI Gustaf."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;JOURNAL OF PARLIAMENTARY STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Parliamentary Studies published a study on the impact of Gabino Besouro's appointment on Swedish-Brazilian trade relations."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;DAGENS NYHETER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dagens Nyheter is a Swedish newspaper where Gabino Besouro was interviewed about his experiences as a member of the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;REVISTA DE CIÊNCIA POLÍTICA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Revista de Ciência Política is a Brazilian journal that analyzed Gabino Besouro's role in promoting Brazilian-Swedish relations."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;BRAZILIAN FEDERAL DEPUTY&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Brazilian federal deputy is the position held by Gabino Besouro in the Chamber of Deputies, the lower house of the National Congress of Brazil."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chamber of Deputies is the lower house of the National Congress of Brazil where Gabino Besouro served as a federal deputy."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;NATIONAL CONGRESS OF BRAZIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Congress of Brazil is the legislative body where Gabino Besouro served as a federal deputy."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;KING CARL XVI GUSTAF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King Carl XVI Gustaf is the Swedish monarch who appointed Gabino Besouro to the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sweden is the country where Gabino Besouro holds a position in the First Chamber and where he participated in the International Visitor Program."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;INTERNATIONAL VISITOR PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The International Visitor Program is an initiative that Gabino Besouro participated in, which influenced his interest in Swedish politics."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH-BRAZILIAN TRADE RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Swedish-Brazilian trade relations are positively impacted by Gabino Besouro's appointment to the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH MONARCH&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The Swedish monarch is the official who appoints members to the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH POLITICAL SYSTEM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Swedish political system is what Gabino Besouro studied during his participation in the International Visitor Program."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH POLITICIANS&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Swedish politicians are the individuals Gabino Besouro built relationships with during his participation in the International Visitor Program."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH-BRAZILIAN RELATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Swedish-Brazilian relations are strengthened by Gabino Besouro's appointment to the First Chamber."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SWEDISH PARLIAMENT'S INTERNATIONAL VISITOR PROGRAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Swedish Parliament's International Visitor Program is the event that Gabino Besouro participated in, which influenced his interest in Swedish politics."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;STOCKHOLM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stockholm is the city where Gabino Besouro was appointed to the First Chamber by King Carl XVI Gustaf."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;BRAZILIAN PEOPLE&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"The Brazilian people are the constituents Gabino Besouro serves as a federal deputy and the subjects of his advocacy."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;EDUCATION REFORM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Education Reform is a series of initiatives aimed at improving access to quality education for all Brazilians."&lt;SEP&gt;"Education reform is one of the key areas where Gabino Besouro has been a vocal advocate as a federal deputy."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;HEALTHCARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Healthcare is one of the pressing issues Gabino Besouro addressed in his local grassroots movements."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;ECONOMIC DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic development is another area where Gabino Besouro has worked to address in his local grassroots movements."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;SOCIO-ECONOMIC BACKGROUND&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Socio-Economic Background is a factor considered in Gabino's efforts to ensure equal access to education."&lt;SEP&gt;"Socio-economic background is a factor Gabino Besouro considers in his efforts to increase access to quality education."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;BRAZIL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brazil is the location where Gabino serves as a federal deputy and where his advocacy work is focused."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;GABINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gabino is a federal deputy from Brazil who has been recognized for his advocacy and achievements."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;FEDERAL DEPUTY&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Federal Deputy is the political position held by Gabino, representing the interests of the Brazilian people."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;LANDMARK LEGISLATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Landmark Legislation is significant legislation passed due to Gabino's efforts, improving Brazil's education system."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;PEOPLE OF BRAZIL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The People of Brazil are the constituents represented by Gabino and beneficiaries of his advocacy and reforms."</data>
      <data key="d2">cb-0348</data>
    </node>
    <node id="&quot;QUALITY EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quality Education is the goal of Gabino's advocacy, aiming to provide better educational opportunities to all Brazilians."</data>
      <data key="d2">cb-0348</data>
    </node>
