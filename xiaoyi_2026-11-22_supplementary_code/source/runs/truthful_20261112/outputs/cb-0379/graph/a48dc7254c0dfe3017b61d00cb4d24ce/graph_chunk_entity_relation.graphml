      <data key="d3">16.0</data>
      <data key="d4">"Jaco M. Greeff previously worked at the University of Pretoria, a prominent institution of higher learning located in Pretoria, South Africa."</data>
      <data key="d5">"employment, past affiliation"</data>
      <data key="d6">cb-0379</data>
    </edge>
    <edge source="&quot;JACO M. GREEFF&quot;" target="&quot;CENTRAL SOUTH UNIVERSITY&quot;">
