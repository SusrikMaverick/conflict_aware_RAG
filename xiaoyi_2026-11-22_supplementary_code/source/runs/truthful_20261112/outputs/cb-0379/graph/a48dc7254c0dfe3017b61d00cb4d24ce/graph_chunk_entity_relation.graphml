  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JACO M. GREEFF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jaco M. Greeff is a researcher known for significant contributions to his field, having worked at the University of Pretoria and now at Central South University."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;UNIVERSITY OF PRETORIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Pretoria is a prominent institution of higher learning located in Pretoria, South Africa, where Jaco M. Greeff previously worked."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;CENTRAL SOUTH UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Central South University is one of China's most prestigious national universities, where Jaco M. Greeff has recently joined the faculty."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;CHANGSHA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Changsha is the city where Central South University is located, and where Jaco M. Greeff has recently moved to join the university."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;PROFESSOR WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Wang is the Dean of the School of Science at Central South University and welcomes Jaco M. Greeff to the team."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;PROFESSOR LI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Li is a colleague and fellow researcher at Central South University who acknowledges Jaco M. Greeff's expertise."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;PROFESSOR ZHANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Zhang is the President of Central South University and expresses confidence in Jaco M. Greeff's impact on the institution."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;SCHOOL OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The School of Science at Central South University is led by Professor Wang and focuses on scientific research and education."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;ACADEMIC PUBLICATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic publications are mentioned as a form of recognition for Jaco M. Greeff's contributions to the scientific community."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;TOP-TIER SCIENTIFIC JOURNALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Top-tier scientific journals are where Jaco M. Greeff's research has been widely published, indicating his standing in the scientific community."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;SUSTAINABLE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable development is a strategic priority for Central South University, aligned with Jaco M. Greeff's research focus."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental science is another strategic priority for Central South University, aligned with Jaco M. Greeff's research focus."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;CUTTING-EDGE TECHNOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cutting-edge technology is also a strategic priority for Central South University, aligned with Jaco M. Greeff's research focus."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;INTERNATIONAL RESEARCH COLLABORATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"International research collaborations are mentioned as part of Jaco M. Greeff's extensive experience and expertise."</data>
      <data key="d2">cb-0379</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental sustainability is the primary focus of Jaco M. Greeff's first project at Central South University."</data>
      <data key="d2">cb-0379</data>
    </node>
