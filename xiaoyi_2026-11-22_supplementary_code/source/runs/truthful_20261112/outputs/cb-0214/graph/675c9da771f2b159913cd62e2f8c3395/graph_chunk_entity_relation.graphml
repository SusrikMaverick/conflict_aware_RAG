  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HALIL GÜRHAN KARABULUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Halil Gürhan Karabulut is a Turkish researcher and expert in international relations and democracy development, known for his work with the National Democratic Institute for International Affairs (NDI). He holds degrees from Bilkent University and the University of Sussex and has contributed significantly to the field through various publications and projects."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;NATIONAL DEMOCRATIC INSTITUTE FOR INTERNATIONAL AFFAIRS (NDI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NDI is a US federally funded non-profit organization dedicated to supporting democracy around the world. Karabulut worked as a Research Fellow at NDI from 2010 onwards."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;BILKENT UNIVERSITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bilkent University is a public research university located in Ankara, Turkey, where Karabulut earned his Bachelor's degree in Political Science in 2005."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;UNIVERSITY OF SUSSEX&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Sussex is a public research university in Brighton, UK, where Karabulut earned his Master's degree in International Relations in 2007."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;ANKARA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ankara is the capital city of Turkey, where Bilkent University is located."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;MIDDLE EAST AND NORTH AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Middle East and North Africa is the region where Karabulut worked on projects promoting democratic governance and electoral reform."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;ARAB WORLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Arab World is the region studied in the 'Democracy and Governance in the Arab World' project, which Karabulut contributed to."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;TURKISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Turkish government invited Karabulut to serve as an advisor on democratic governance in 2014."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;JOURNAL OF DEMOCRACY AND HUMAN RIGHTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Karabulut published an article titled 'Turkey's Democratic Development: Challenges and Opportunities' in this journal."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;FOREIGN POLICY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Karabulut's work has been cited in this reputable source."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;MIDDLE EAST JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Karabulut's work has also been cited in this reputable source."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;ANKARA UNIVERSITY MEDICAL SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ankara University Medical School is an educational and research institution where Karabulut has been actively involved in various academic activities."&lt;SEP&gt;"Karabulut was affiliated with Ankara University Medical School, particularly through his research and collaborations."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;NDI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NDI is a US federally funded non-profit organization dedicated to supporting democracy around the world. Karabulut worked as a Research Fellow at NDI from 2010 onwards."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;NDI (NATIONAL DEMOCRATIC INSTITUTE FOR INTERNATIONAL AFFAIRS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
