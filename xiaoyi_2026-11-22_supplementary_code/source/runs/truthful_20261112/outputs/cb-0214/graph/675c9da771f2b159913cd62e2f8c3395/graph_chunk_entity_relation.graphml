      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;KARABULUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Karabulut is a person who has participated in conferences and seminars organized by Ankara University Medical School and presented research papers there."</data>
      <data key="d2">cb-0214</data>
    </node>
    <node id="&quot;CONFERENCES AND SEMINARS&quot;">
