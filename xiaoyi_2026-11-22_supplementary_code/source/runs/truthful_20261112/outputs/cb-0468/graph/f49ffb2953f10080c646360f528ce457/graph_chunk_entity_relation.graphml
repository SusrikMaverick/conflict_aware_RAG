      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;OHIO STATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ohio State is a collegiate institution that is an arch-rival of the University of Michigan, where Bob Gracie is set to play his first game."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;ARCH-RIVAL&quot;">
      <data key="d0">"CONCEPT"</data>
