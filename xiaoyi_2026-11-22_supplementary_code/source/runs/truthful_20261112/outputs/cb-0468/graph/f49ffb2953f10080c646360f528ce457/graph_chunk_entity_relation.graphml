      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;FOUR-TIME STANLEY CUP CHAMPION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Four-time Stanley Cup champion refers to Bob Gracie's achievement in winning the Stanley Cup four times with the Toronto Maple Leafs."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;GRACIE&quot;">
