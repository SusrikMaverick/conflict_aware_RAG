      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;STANLEY CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Stanley Cup is the championship trophy awarded to the NHL's playoff winner, which Bob Gracie's team won multiple times during his tenure with the Toronto Maple Leafs."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;NCAA DIVISION I MEN'S BASKETBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NCAA Division I men's basketball league is the collegiate basketball league where Bob Gracie is transitioning to, known for its competitive teams and players."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;ESPN&quot;">
      <data key="d0">"ORGANIZATION"</data>
