  <graph edgedefault="undirected">
    <node id="&quot;BOB GRACIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bob Gracie is a Canadian hockey legend and former NHL player who recently switched to NCAA basketball, known for his competitive spirit and athletic abilities."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;CANADIAN HOCKEY LEGEND&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Canadian Hockey Legend refers to Bob Gracie's status as a prominent figure in Canadian ice hockey, known for his achievements in the sport."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;NHL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NHL is the National Hockey League, where Bob Gracie played professionally for several years, known for its top-tier ice hockey competition."&lt;SEP&gt;"NHL is the National Hockey League, where Gracie played and faced challenges during his career."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;UNIVERSITY OF MICHIGAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Michigan is a collegiate institution where Bob Gracie is set to play basketball, known for its strong athletic programs."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;MICHIGAN WOLVERINES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Michigan Wolverines is the basketball team representing the University of Michigan, coached by Juwan Howard."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;TORONTO MAPLE LEAFS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Toronto Maple Leafs is a professional ice hockey team in the NHL where Bob Gracie played for six seasons, known for its historic success."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;BOSTON BRUINS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Bruins is an NHL team that Bob Gracie faced in his first NHL game, known for their rivalry with the Toronto Maple Leafs."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;BOSTON GARDEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston Garden is the venue where Bob Gracie made his NHL debut, located in Boston, Massachusetts."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;OTTAWA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ottawa is the city where Bob Gracie grew up and developed his hockey skills, located in Ontario, Canada."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;DETROIT RED WINGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Detroit Red Wings is an NHL team that Bob Gracie faced in a notable performance, known for their fierce competition."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston is a city where Bob Gracie faced the Boston Bruins in his first NHL game, located in Massachusetts, USA."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;OTTAWA MAPLE LEAFS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ottawa Maple Leafs is the team Bob Gracie played for in the NHL, known for its historic success and strong defense."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;CHARLIE CONACHER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charlie Conacher is a Hall of Fame player who formed a scoring line with Bob Gracie during his time with the Toronto Maple Leafs."</data>
      <data key="d2">cb-0468</data>
    </node>
    <node id="&quot;HARVEY JACKSON&quot;">
      <data key="d0">"PERSON"</data>
