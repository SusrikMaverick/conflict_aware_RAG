<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JOHN HARMAN (AUSTRALIAN POLITICIAN)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Harman was an Australian politician who served as a Labor Party member of the Legislative Assembly of Western Australia from 1968 to 1986, representing the seat of Maylands, and served as Speaker of the Legislative Assembly from 1983 to 1986."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;PERTH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Perth is the birthplace of John Harman."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;MAYLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Maylands is the seat represented by John Harman in the Legislative Assembly of Western Australia."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;SPEAKER OF THE LEGISLATIVE ASSEMBLY&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Speaker of the Legislative Assembly is a position held by John Harman from 1983 to 1986."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;JOHN GRAHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Graham is a member of the Liberal Party and has worked in various sectors including higher education, the Finance Sector Union, and as an adviser to state governments."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;LIBERAL PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberal Party is the political party that John Graham joined in 1991 and has been associated with throughout his career."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;NEW SOUTH WALES BRANCH OF THE AUSTRALIAN LIBERAL PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New South Wales branch of the Australian Liberal Party is an organization John Graham has been a part of."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;LIBERAL LOVES LIVE MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Liberal Loves Live Music is an organization founded by John Graham."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;SIR JOHN ANDREW HARMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir John Andrew Harman is a British politician who served as the Chairman of the Environment Agency and has a background in teaching and politics."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;ST GEORGE'S COLLEGE, WEYBRIDGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St George's College, Weybridge is the independent school attended by Sir John Andrew Harman."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;UNIVERSITY OF MANCHESTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"University of Manchester is the institution where Sir John Andrew Harman obtained a BSc degree in Maths."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;HUDDERSFIELD COLLEGE OF EDUCATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Huddersfield College of Education is the institution where Sir John Andrew Harman obtained a PGCE."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;GREENHEAD COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Greenhead College is the institution where Sir John Andrew Harman was a maths teacher from 1973-9."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;BARNSLEY SIXTH FORM COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barnsley Sixth Form College is the institution where Sir John Andrew Harman was Head of Maths from 1979-90."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;BARNSLEY COLLEGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barnsley College is the institution where Sir John Andrew Harman was a Senior Maths Lecturer from 1990-7."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;UK LABOUR PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"UK Labour Party is the political party Sir John Andrew Harman joined in 1977 and was a member of."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;WEST YORKSHIRE METROPOLITAN COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"West Yorkshire Metropolitan Council is the body Sir John Andrew Harman was elected to in 1986."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;KIRKLEES COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kirklees Council is the local authority Sir John Andrew Harman led from 1986-99."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;PADDOCK WARD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paddock ward is the area for which Sir John Andrew Harman was a Councillor."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;GENERAL RICHARD S. EWELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"General Richard S. Ewell is a military figure whom John Harman served as Quartermaster during the American Civil War."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;GENERAL LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"General Lee is a military figure whom John Harman sometimes served as Acting Chief Quartermaster during the American Civil War."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;VALLEY RAILROAD CONVENTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Valley Railroad Convention is an event John Harman participated in after abandoning his political career."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
    <node id="&quot;CONSERVATIVE PARTY CONVENTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Conservative Party convention is an event John Harman became a delegate to after abandoning his political career."</data>
      <data key="d2">ramdocs-0444-2afe979e1cb4</data>
    </node>
  </graph>
