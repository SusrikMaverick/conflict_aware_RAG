  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HOKKAIDO UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hokkaido University is a prestigious national university in Sapporo, Japan, known for its academic excellence and innovative research."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;YOSUKE KOMATSU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yosuke Komatsu is a renowned researcher with a deep academic journey intertwined with Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;SAPPORO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sapporo is a city in Hokkaido, Japan, where Hokkaido University is located."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is the birthplace of Yosuke Komatsu."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;UNIVERSITY OF KALYANI FACULTY OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Kalyani Faculty of Science is where Yosuke Komatsu completed his undergraduate degree in Physics with honors."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;DR. S.K. CHAKRABORTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. S.K. Chakraborty is a distinguished professor of physics at the University of Kalyani Faculty of Science who guided Yosuke Komatsu on his research project."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;QUANTUM FLUCTUATIONS IN NON-EQUILIBRIUM SYSTEMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Quantum Fluctuations in Non-Equilibrium Systems is the title of Yosuke Komatsu's undergraduate research project."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;BEST UNDERGRADUATE RESEARCHER AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Undergraduate Researcher Award is an honor given to Yosuke Komatsu for his exceptional performance and research prowess at the University of Kalyani Faculty of Science."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;HOKKAIDO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hokkaido is a prefecture in Japan where Sapporo and Hokkaido University are located."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan is the country where Sapporo, Hokkaido University, and Yosuke Komatsu's birthplace are located."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY APPROACHES TO COMPLEX SYSTEMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Interdisciplinary Approaches to Complex Systems is a book edited by Dr. S.K. Chakraborty that includes Yosuke Komatsu's work."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;NAROSA PUBLISHING HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Narosa Publishing House is the publisher of the book 'Frontiers in Interdisciplinary Sciences' which includes Yosuke Komatsu's work."&lt;SEP&gt;"Narosa Publishing House is the publishing company based in New Delhi that published the book 'Frontiers in Interdisciplinary Sciences'."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;UNIVERSITY OF KALYANI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Kalyani is the institution where Yosuke Komatsu initially pursued his undergraduate degree."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1985 is the birth date of Yosuke Komatsu."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;2003&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2003 is the year Yosuke Komatsu enrolled in the University of Kalyani Faculty of Science."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;2007&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2007 is the year Yosuke Komatsu received the Best Undergraduate Researcher Award."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;NEW DELHI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Delhi is the city where Narosa Publishing House is located, and it is the publisher of the book 'Frontiers in Interdisciplinary Sciences'."&lt;SEP&gt;"New Delhi is the city where the book 'Frontiers in Interdisciplinary Sciences' was published."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;TOKYO UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tokyo University is mentioned as the birthplace of Yosuke Komatsu, though not explicitly stated as the university he attended."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;PHYSICS&quot;">
      <data key="d0">"SUBJECT"</data>
      <data key="d1">"Physics is the subject Yosuke Komatsu studied at both the University of Kalyani Faculty of Science and Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;COMPLEX SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Complex Systems is the field of study Yosuke Komatsu contributed to through his research."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;ACADEMIC ODYSSEY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Odyssey refers to the journey of Yosuke Komatsu from his early years to his current status as a renowned researcher."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Research is the primary activity Yosuke Komatsu engages in throughout his academic journey."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Collaboration is a key aspect of Yosuke Komatsu's research, particularly with esteemed faculty members."&lt;SEP&gt;"Collaboration is a key theme in the academic environment at Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Publication is the act of making a book available to the public, such as the publication of 'Frontiers in Interdisciplinary Sciences' by Narosa Publishing House."&lt;SEP&gt;"Publication is the method through which Yosuke Komatsu's research findings are disseminated."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;AWARD&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Award is a recognition of Yosuke Komatsu's academic achievements, such as the Best Undergraduate Researcher Award."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is highlighted as a key aspect of the research conducted at Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;INTELLECTUAL GROWTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Intellectual Growth is a concept emphasized in the academic environment at Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;CREATIVITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creativity is another important aspect of the academic environment at Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is a core value of Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;CUTTING-EDGE RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cutting-Edge Research is a focus area at Hokkaido University."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;DISCIPLINARY APPROACHES TO COMPLEX SYSTEMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Disciplinary Approaches to Complex Systems is a chapter in a book, focusing on methods and approaches to studying complex systems within various disciplines."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;S.K. CHAKRABORTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"S.K. Chakraborty is the editor of the book 'Frontiers in Interdisciplinary Sciences', which contains the chapter 'Disciplinary Approaches to Complex Systems'."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;FRONTIERS IN INTERDISCIPLINARY SCIENCES&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Frontiers in Interdisciplinary Sciences is a book edited by S.K. Chakraborty, containing chapters on various scientific topics."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;CHAPTER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Chapter is a section of a book, such as 'Disciplinary Approaches to Complex Systems', which is part of 'Frontiers in Interdisciplinary Sciences'."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;BOOK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Book is a collection of written or printed work, such as 'Frontiers in Interdisciplinary Sciences', which includes multiple chapters."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;EDITOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Editor is a person who oversees the creation and publication of a book, such as S.K. Chakraborty for 'Frontiers in Interdisciplinary Sciences'."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"City is a large town, such as New Delhi, where a publishing house is located."</data>
      <data key="d2">cb-0391</data>
    </node>
    <node id="&quot;PUBLISHING HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Publishing House is a business that produces and distributes books, such as Narosa Publishing House."</data>
      <data key="d2">cb-0391</data>
    </node>
