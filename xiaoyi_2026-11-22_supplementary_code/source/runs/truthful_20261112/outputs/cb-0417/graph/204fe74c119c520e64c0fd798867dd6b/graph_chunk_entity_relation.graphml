  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DANIELA BALDANTONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniela Baldantoni is a renowned Italian biologist who has made significant contributions to the field of biology, particularly in the areas of environmental sustainability, gene editing, and cellular biology."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;UNIVERSITY OF SALERNO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Salerno is a prestigious institution of higher education in Italy, known for its strong programs in sciences, humanities, and medicine, where Daniela Baldantoni held a position and conducted research."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;SWANSEA UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swansea University is a prestigious institution located in Wales, known for its commitment to interdisciplinary research and state-of-the-art facilities, where Daniela Baldantoni has recently joined the faculty."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;PROFESSOR GIOVANNI DE SANTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Giovanni De Santo is the Dean of the Faculty of Sciences at the University of Salerno, expressing pride in Daniela Baldantoni's contribution to the institution."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;DR. MARIA ROSSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rossi is a colleague of Daniela Baldantoni at the University of Salerno, highlighting the impact of Baldantoni's research on the scientific community."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;PROFESSOR MARK EVANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor Mark Evans is the Dean of the Faculty of Science and Engineering at Swansea University, welcoming Daniela Baldantoni and emphasizing the significance of her appointment."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;EMILY JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emily Jones is a Ph.D. student in the Department of Biological Sciences at Swansea University, expressing enthusiasm about working with Daniela Baldantoni."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the capital city of Italy where the investigation into Daniela Baldantoni's affiliations began."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Italy is the country where Daniela Baldantoni is based and where the University of Salerno is located."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;EUROPEAN RESEARCH COUNCIL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Research Council is an organization that has provided significant funding to Dr. Baldantoni's research group."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;WELLCOME TRUST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Wellcome Trust is another organization that has provided funding to Dr. Baldantoni's research group."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;CELLULAR BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cellular biology is the field of study that Dr. Baldantoni specializes in, focusing on the genetic mechanisms underlying human diseases."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;GENE EDITING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Gene editing is a technique that Dr. Baldantoni has pioneered, particularly in the context of developing novel therapeutic approaches for cancer treatment."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;CANCER TREATMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cancer treatment is the application area of Dr. Baldantoni's gene editing research, aiming to develop new therapeutic approaches."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SUSTAINABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental sustainability is one of the areas of research focus for Dr. Baldantoni, particularly in the context of studying biological systems and processes."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;ECOSYSTEM DYNAMICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ecosystem dynamics is a topic of research that Dr. Baldantoni has collaborated on with colleagues at the University of Salerno."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;RESEARCH PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research projects are the collaborative efforts of Dr. Baldantoni and her colleagues at both the University of Salerno and Swansea University."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;POSTGRADUATE STUDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Postgraduate students are part of the academic community at Swansea University, eager to learn from Dr. Baldantoni's expertise."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;EARLY-CAREER RESEARCHER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Early-career researchers are part of the academic community at Swansea University, looking to benefit from Dr. Baldantoni's mentorship."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The academic community is the broader context within which the event takes place, involving various scholars and institutions."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;HER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Her refers to a female individual who delivered an important lecture, likely a prominent figure in her field."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;GENE EDITING: THE FUTURE OF DISEASE TREATMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Gene Editing: The Future of Disease Treatment is the title of the lecture, indicating the topic and significance of the event."</data>
      <data key="d2">cb-0417</data>
    </node>
    <node id="&quot;INAUGURAL LECTURE&quot;">
      <data key="d0">"EVENT"</data>
