  <graph edgedefault="undirected">
    <node id="&quot;PETER BRAZAITIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Brazaitis is a renowned researcher in the field of wildlife conservation and molecular biology, known for his contributions to both Wildlife Conservation Society and the Institute of Organic Chemistry and Biochemistry."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;WILDLIFE CONSERVATION SOCIETY (WCS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wildlife Conservation Society is an organization where Peter Brazaitis worked, contributing to various conservation efforts."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;INSTITUTE OF ORGANIC CHEMISTRY AND BIOCHEMISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Institute of Organic Chemistry and Biochemistry is an institution where Peter Brazaitis conducts research on molecular structures and synthetic biology."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;PRAGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Prague is the city where Peter Brazaitis is currently located, navigating its winding streets and visiting the Institute of Organic Chemistry and Biochemistry."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;DR. EVA NOVÁKOVÁ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Eva Nováková is a colleague of Peter Brazaitis at the Institute of Organic Chemistry and Biochemistry, involved in the development of novel antibiotics."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;CONSERVATION EFFORTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Conservation Efforts refer to the various initiatives and projects aimed at protecting and preserving wildlife habitats."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;DEVELOPMENT OF NOVEL ANTIBIOTICS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Development of Novel Antibiotics is a project focused on creating new antibiotics to combat resistant bacteria."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;SYNTHETIC BIOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Synthetic Biology is a field of research where Dr. Brazaitis and his colleagues are working to understand and manipulate molecular structures."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;RESISTANT BACTERIA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Resistant Bacteria are a significant threat that the development of novel antibiotics aims to address."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;LATE NIGHTS IN THE LAB&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Late Nights in the Lab refers to the extended periods of work and research conducted by Dr. Brazaitis and his colleagues."</data>
      <data key="d2">cb-0362</data>
    </node>
    <node id="&quot;COFFEE&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Coffee is a beverage consumed by Dr. Brazaitis and his colleagues to stay energized during long work sessions."</data>
