  <graph edgedefault="undirected">
    <node id="&quot;ARIA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aria is a guest on the podcast 'Do We Know Them?', feeling both curious and slightly apprehensive about the discussion."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;LYRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lyra is the co-host of the podcast 'Do We Know Them', known for her raven-black hair and unsettling indigo eyes, and her gentle yet probing conversational style."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;KAID&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kaid is the other co-host of the podcast 'Do We Know Them', with chiseled features and onyx-like eyes, embodying a quiet power and depth."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;DO WE KNOW THEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Do We Know Them is a podcast that explores the mysteries of the human psyche, focusing on the complexities of human connection and the unknown."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;RECORDING STUDIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The recording studio is a dimly lit space filled with the aroma of freshly brewed coffee and machinery, where the podcast 'Do We Know Them' is produced."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;ENTERTAINMENT NEWS PODCAST&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"An Entertainment News Podcast is a type of podcast that discusses and analyzes news, trends, and events related to the entertainment industry, including movies, television, music, and celebrity culture."</data>
      <data key="d2">cb-0427</data>
    </node>
    <node id="&quot;DIM LIGHT&quot;">
      <data key="d0">"CONCEPT"</data>
