  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CANADIAN ASTRONOMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A Canadian astronomer, specifically Jean-René Roy, known for his contributions to astronomy and science education."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;KNIGHT OF THE NATIONAL ORDER OF QUEBEC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Knight of the National Order of Quebec is a prestigious honor given by the Quebec government to individuals who have made significant contributions to the province’s cultural, scientific, and social development."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;QUEBEC NATIONAL ASSEMBLY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Quebec National Assembly is the legislative body of the province of Quebec, where the ceremony for the Knight of the National Order of Quebec was held."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;MCGILL SPACE INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"McGill Space Institute is an institution where Dr. Victoria Kaspi works and speaks highly of Jean-René Roy's contributions."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;NATIONAL ORDER OF QUEBEC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Order of Quebec is the highest distinction awarded by the Quebec government to individuals who have made significant contributions to the province’s cultural, scientific, and social development."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;DR. VICTORIA KASPI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Victoria Kaspi is the Director of the McGill Space Institute and praises Jean-René Roy's work and dedication."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;QUEBEC MINISTER OF CULTURE AND COMMUNICATIONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Quebec Minister of Culture and Communications, Nathalie Roy, speaks about Jean-René Roy's dedication to promoting scientific literacy and critical thinking."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;MCGILL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"McGill University is the institution where Jean-René Roy earned his undergraduate degree in physics."&lt;SEP&gt;"McGill University is where Jean-René Roy earned his undergraduate degree in physics."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;UNIVERSITY OF TORONTO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Toronto is the institution where Jean-René Roy earned his Ph.D. in astronomy."&lt;SEP&gt;"University of Toronto is where Jean-René Roy earned his Ph.D. in astronomy."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;HARVARD-SMITHSONIAN CENTER FOR ASTROPHYSICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Harvard-Smithsonian Center for Astrophysics is a research center where Jean-René Roy conducted research during his Fulbright tenure."&lt;SEP&gt;"Harvard-Smithsonian Center for Astrophysics is a research center where Roy conducted his Fulbright research."&lt;SEP&gt;"Harvard-Smithsonian Center for Astrophysics is where Jean-René Roy conducted research during his Fulbright tenure."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;ASTROPHYSICAL JOURNAL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Astrophysical Journal is a scientific journal where Roy has published numerous papers."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;ASTRONOMICAL JOURNAL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Astronomical Journal is another scientific journal where Roy has published papers."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;SCIENCE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Science is a journal where Roy published his research on the orbital dynamics of binary star systems."&lt;SEP&gt;"Science is a peer-reviewed academic journal where 'Orbital Dynamics of Binary Star Systems' was published."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature is a journal where Roy published the discovery of a new binary star system named 'Roy's Binary'."&lt;SEP&gt;"Nature is a peer-reviewed academic journal where 'Discovery of a New Binary Star System' was published."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;BINARY STAR SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Binary Star Systems are the focus of Roy's research, which includes their stability and applications in astrophysical research."&lt;SEP&gt;"Binary Star Systems refers to the subject matter of both scientific papers, highlighting the research focus."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;FULBRIGHT SCHOLARSHIP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fulbright Scholarship is a highly competitive American educational grant program that Roy was awarded."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;JEAN-RENÉ ROY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean-René Roy is a renowned Canadian astronomer known for his contributions to astronomy and science education."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;FEBRUARY 12, 1965&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"February 12, 1965 is the birth date of Jean-René Roy."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;MONTREAL, QUEBEC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montreal, Quebec is the birthplace of Jean-René Roy."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;JOHN SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Smith is a supervisor of Jean-René Roy's Ph.D. at the University of Toronto."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;1995&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1995 is the year Jean-René Roy was awarded the prestigious Fulbright Scholarship."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;1997&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1997 is the year 'Orbital Dynamics of Binary Star Systems' was published."&lt;SEP&gt;"1997 is the year Roy's research on the orbital dynamics of binary star systems was published in the journal Science."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;2001&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2001 is the year 'Discovery of a New Binary Star System' was published."&lt;SEP&gt;"2001 is the year Roy was part of an international team that discovered a new binary star system named 'Roy's Binary' in his honor."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;J. JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. Johnson is the author of the article 'Jean-René Roy: A Rising Star in Astronomy' published in Astronomy Magazine."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;J. SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J. Smith is the supervisor of Jean-René Roy's Ph.D. at the University of Toronto."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;J.-R. ROY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J.-R. Roy is the abbreviated form of Jean-René Roy."&lt;SEP&gt;"J.-R. Roy is the author of 'Orbital Dynamics of Binary Star Systems' and co-author of 'Discovery of a New Binary Star System'."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;NATHALIE ROY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nathalie Roy is the Quebec Minister of Culture and Communications who spoke about Roy's dedication to promoting scientific literacy and critical thinking."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;J.-R. ROY ET AL.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"J.-R. Roy et al. is the author group for the discovery of a new binary star system published in Nature."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;ORBITAL DYNAMICS OF BINARY STAR SYSTEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Orbital Dynamics of Binary Star Systems is a scientific paper published in 1997 by J.-R. Roy, focusing on the dynamics of binary star systems."&lt;SEP&gt;"Orbital Dynamics of Binary Star Systems is the topic of Roy's research during his Fulbright tenure."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;DISCOVERY OF A NEW BINARY STAR SYSTEM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Discovery of a New Binary Star System is a scientific paper published in 2001 by J.-R. Roy et al., focusing on the discovery of a new binary star system."&lt;SEP&gt;"Discovery of a New Binary Star System is the event where Roy was part of an international team that discovered a new binary star system."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;INTERNATIONAL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Team is the group that discovered a new binary star system with Roy."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;FULBRIGHT COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fulbright Commission is the organization that administers the Fulbright Scholarship program."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;VOL. 276, NO. 5315&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vol. 276, No. 5315 is the volume and issue number of the publication where 'Orbital Dynamics of Binary Star Systems' was published."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;VOL. 412, NO.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vol. 412, No. is the volume and issue number of the publication where 'Discovery of a New Binary Star System' was published."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;PEER-REVIEWED ACADEMIC JOURNAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Peer-Reviewed Academic Journal is the type of publication where both scientific papers were published."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;RESEARCH FOCUS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Focus describes the area of study in both scientific papers, specifically the dynamics and discovery of binary star systems."</data>
      <data key="d2">cb-0137</data>
    </node>
    <node id="&quot;QUEBEC NATIONAL ORDER OF QUEBEC&quot;">
      <data key="d2">cb-0137</data>
      <data key="d1">"Quebec Minister of Culture and Communications, Nathalie Roy, speaks about the importance of promoting scientific literacy and critical thinking through the Knight of the National Order of Quebec award."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
