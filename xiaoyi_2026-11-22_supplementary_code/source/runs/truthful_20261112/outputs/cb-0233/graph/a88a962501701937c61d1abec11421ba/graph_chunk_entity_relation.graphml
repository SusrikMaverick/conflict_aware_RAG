<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;EMMAMERK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Emmamerk is a historic church in Soest, Netherlands, known for its significant renovation and consent agreement process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;SOEST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Soest is a town in the Netherlands where the Emmamerk church is located."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;REV. MARIA VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rev. Maria van der Meer is the pastor of the Emmamerk church and played a key role in the consent agreement process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;HANS DE JONG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hans de Jong is a congregation member of the Emmamerk church who participated in the consent agreement process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a leading expert on community engagement who praised the Emmamerk's efforts."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;EMMAMERK RENOVATION PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Emmamerk Renovation Project involves significant upgrades to the church, including solar panels, accessibility features, and a sound system."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;CONSENT AGREEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Consent Agreement is a formal process where over 90% of the church's members gave their approval for the renovation project."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II caused significant damage to the Emmamerk church, leaving it in a state of disrepair."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ARCHAEOLOGISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Archaeologists played a crucial role in uncovering the original foundation of the Emmamerk church during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;HISTORIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The historic church in Soest, Netherlands, is the Emmamerk, known for its renovation and community engagement."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;COMMUNITY ENGAGEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community Engagement refers to the process of involving the congregation in decision-making and ensuring their needs and values are reflected."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;RENOVATION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Renovation is the process of upgrading the church building, including solar panels, accessibility features, and a sound system."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;DECISION-MAKING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Decision-Making is the process of planning and implementing the renovation project, involving the congregation in the consent agreement."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;CONGREGATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The congregation of the Emmamerk church is the group of members who participated in the consent agreement process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;CHURCH BUILDING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The church building is the physical structure of the Emmamerk church, which underwent significant upgrades."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;STAINED-GLASS WINDOWS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Stained-Glass Windows are ornate and intricate elements of the church building that were recreated during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;STONE CARVINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Stone Carvings are intricate decorative elements of the church building that were recreated during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;WOODEN FURNISHINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Wooden Furnishings are ornate and intricate elements of the church building that were recreated during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ORIGINAL FOUNDATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The original foundation of the church is the historical ground on which the church was built, uncovered during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;TRADITIONAL TECHNIQUES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Traditional Techniques refer to the methods used in the reconstruction process to recreate the church's original elements accurately."&lt;SEP&gt;"Traditional techniques are used in the reconstruction process, emphasizing the authenticity and historical accuracy."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;SACRED GROUND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sacred Ground is the historical and spiritual significance of the ground on which the church was built, preserved during the reconstruction process."&lt;SEP&gt;"Sacred ground refers to the site where the reconstructed church stands, emphasizing its spiritual and historical significance."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;HISTORICAL HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Historical Heritage refers to the rich history and architectural heritage of the Emmamerk church, preserved and restored during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;RECONSTRUCTION PROCESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Reconstruction Process is the meticulous and detailed effort to restore the Emmamerk church to its former glory."&lt;SEP&gt;"The reconstruction process is described as a masterclass in attention to detail, emphasizing the team's dedication to authenticity."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;CRAFTSMEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Craftsmen are dedicated to recreating the intricate stone carvings, stunning stained-glass windows, and ornate wooden furnishings, showcasing their skill and attention to detail."&lt;SEP&gt;"Craftsmen played a crucial role in recreating the intricate elements of the church building during the reconstruction process."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ARCHITECTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Architects played a crucial role in the reconstruction process, guiding the meticulous restoration of the church."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;RECONSTRUCTED CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The reconstructed church stands on the same sacred ground as its predecessor, emphasizing its historical and cultural significance."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ORIGINAL CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The original church is referenced as the predecessor of the reconstructed church, highlighting its historical importance."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The community is served by the church, indicating its role in the local area and the respect for its heritage."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ATTENTION TO DETAIL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Attention to detail is a key aspect of the reconstruction process, highlighting the craftsmanship and dedication of the team."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;STUNNING STAINED-GLASS WINDOWS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Stained-glass windows are one of the elements recreated by the craftsmen, adding beauty and historical detail to the church."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;INTRICATE STONE CARVINGS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Intricate stone carvings are another element recreated by the craftsmen, contributing to the church's ornate design."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;ORNATE WOODEN FURNISHINGS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Ornate wooden furnishings are also recreated by the craftsmen, enhancing the church's interior with historical detail."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;TEAM'S DEDICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Team's dedication is unwavering, driven by a deep respect for the church's heritage and the community it serves."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;DEEP RESPECT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Deep respect for the church's heritage and the community it serves drives the team's dedication."</data>
      <data key="d2">cb-0233</data>
    </node>
    <node id="&quot;HERITAGE PRESERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Heritage preservation is a key goal of the reconstruction process, ensuring the church remains a symbol of historical and cultural significance."</data>
      <data key="d2">cb-0233</data>
    </node>
