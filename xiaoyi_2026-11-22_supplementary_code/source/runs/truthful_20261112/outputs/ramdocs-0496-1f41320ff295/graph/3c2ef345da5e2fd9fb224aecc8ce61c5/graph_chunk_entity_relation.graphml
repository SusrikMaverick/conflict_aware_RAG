<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SUPERIOR ELECTORAL COURT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Superior Electoral Court is the highest body of the Brazilian Electoral Justice, comprising one Regional Electoral Court in each of the 26 states and the Federal District of Brazil."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;THE ASSOCIATED PRESS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Associated Press is an independent global news organization dedicated to factual reporting, founded in 1846, and remains the most trusted source of fast, accurate, unbiased news in all formats."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;GUATEMALA PROSECUTOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guatemala prosecutor is seeking to strip electoral authorities of immunity after an election in Guatemala."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;ELECTORAL AUTHORITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Electoral authorities in Guatemala are being sought to have their immunity stripped by the prosecutor."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;WORLD NEWS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World News refers to news coverage of events happening around the globe, including the situation in Guatemala."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"California is mentioned as an example of a state with a higher population compared to Wyoming."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;WYOMING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wyoming is mentioned as an example of a state with a lower population compared to California."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is implied in the context of electoral votes and military aid to Honduras."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;HONDURAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Honduras is discussed in relation to international trafficking, drug cartels, and US military aid."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;ORGANIZED DRUG GANGS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Organized drug gangs are mentioned as being better resourced than state authorities in Honduras."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;STATE AUTHORITIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"State authorities in Honduras are mentioned as being less resourced compared to organized drug gangs."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;US MILITARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"US military is mentioned as a potential aid to Honduras to combat organized drug gangs."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;DRUG CARTELS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Drug cartels are mentioned as operating within Honduras and interacting with organized drug gangs."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;MILITARY AID&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Military aid is discussed as a potential solution to Honduran security problems."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;LEGAL ACTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Legal action is mentioned as the prosecutor seeking to strip electoral authorities of immunity."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;IMMUNITY STRIPPING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Immunity stripping is the specific action the prosecutor is seeking against electoral authorities."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;POPULATION COMPARISON&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Population comparison is used to illustrate differences in electoral power between states."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;ELECTORAL VOTES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Electoral votes are mentioned as a concept in the electoral system."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;VOTING POWER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Voting power is discussed in relation to the number of electoral votes per voter."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;SECURITY PROBLEMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Security problems in Honduras are mentioned as a result of drug trafficking and organized crime."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;MILITARY SOLUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Military solutions are proposed as a way to address security problems in Honduras."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <node id="&quot;LEGALIZATION OF DRUGS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Legalization of drugs is suggested as an alternative to military solutions."</data>
      <data key="d2">ramdocs-0496-1f41320ff295</data>
    </node>
    <edge source="&quot;THE ASSOCIATED PRESS&quot;" target="&quot;WORLD NEWS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Associated Press provides news coverage, including World News such as the situation in Guatemala."</data>
      <data key="d5">"news coverage, global events"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
    <edge source="&quot;GUATEMALA PROSECUTOR&quot;" target="&quot;ELECTORAL AUTHORITIES&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Guatemala prosecutor is seeking to strip the electoral authorities of immunity after an election."</data>
      <data key="d5">"legal action, immunity stripping"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
    <edge source="&quot;ELECTORAL AUTHORITIES&quot;" target="&quot;WORLD NEWS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The situation involving the electoral authorities in Guatemala is part of the broader World News coverage."</data>
      <data key="d5">"news coverage, local events"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
    <edge source="&quot;CALIFORNIA&quot;" target="&quot;WYOMING&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"An electoral vote represents nearly four times as many people in California compared to Wyoming, highlighting the difference in population."</data>
      <data key="d5">"population comparison, electoral power"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
    <edge source="&quot;UNITED STATES&quot;" target="&quot;HONDURAS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The United States is implied in the context of providing military aid to Honduras to combat organized drug gangs."</data>
      <data key="d5">"international relations, military aid"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
    <edge source="&quot;HONDURAS&quot;" target="&quot;ORGANIZED DRUG GANGS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Organized drug gangs are better resourced than state authorities in Honduras, impacting the country's security issues."</data>
      <data key="d5">"security threat, resource disparity"</data>
      <data key="d6">ramdocs-0496-1f41320ff295</data>
    </edge>
  </graph>
</graphml>
