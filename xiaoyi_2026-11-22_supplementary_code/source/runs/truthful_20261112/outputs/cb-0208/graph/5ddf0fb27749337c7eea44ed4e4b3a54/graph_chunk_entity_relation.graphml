  <graph edgedefault="undirected">
    <node id="&quot;SARAH FANE RICKETTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sarah Fane Ricketts is a member of the prominent Fane family, married to Harry Ulick Dennis Verney, and has experienced paranormal events leading to a marriage with Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;HARRY ULICK DENNIS VERNEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harry Ulick Dennis Verney is a scion of the distinguished Verney clan, married to Sarah Fane Ricketts, and welcomed into the Fane family."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;FANE FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Fane Family is a prominent aristocratic family with a rich history dating back to the 17th century."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;VERNEY FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Verney Family is an esteemed aristocratic family with ties to the British peerage."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;CAROLINE SLATTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Caroline Slatter is a 19th-century British aristocrat who passed away in 1861 and was married to Sarah Fane Ricketts through paranormal means."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where Sarah Fane Ricketts lives and experienced paranormal events leading to her marriage with Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;BURKE'S PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Burke's Peerage is a reputable genealogical database recognized for its authority on British aristocracy and nobility."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;DEBRETT'S&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Debrett's is a reputable genealogical database recognized for its authority on British aristocracy and nobility."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;DR. EMILY WINDSOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emily Windsor is a leading expert in paranormal psychology studying the case of Sarah Fane Ricketts and Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;EMMA RICKETTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emma Ricketts is the niece of Sarah Fane Ricketts, supporting her unconventional relationship with Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;PARANORMAL EVENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Paranormal events, such as unexplained noises, movements, and visions, played a crucial role in the marriage between Sarah Fane Ricketts and Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;ANTIQUE LOCKET&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"An antique locket bearing Caroline Slatter's image was a key object in forming the connection between Sarah Fane Ricketts and Caroline Slatter."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;QUANTUM ENTANGLEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Quantum entanglement is a theoretical concept proposed by Dr. Emily Windsor to explain the phenomenon of Sarah Fane Ricketts and Caroline Slatter's connection."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;THE PUBLIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The public represents the general populace who are aware of and reflecting on the time-defying marriage."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;TIME-DEFYING MARRIAGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A marriage that defies conventional notions of time and mortality, causing widespread reflection and discussion."</data>
      <data key="d2">cb-0208</data>
    </node>
    <node id="&quot;NEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"News is the medium through which the information about the time-defying marriage is spread to the public."</data>
