  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GREAT MCGONAGALL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Great McGonagall is a film that was part of a series of flops for Sellers and is also known as a famous Scottish poet.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;SELLERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sellers is an actor whose career included the film 'Great McGonagall' and improved with 'The Return of the Pink Panther'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;THE RETURN OF THE PINK PANTHER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Return of the Pink Panther is a film that marked an improvement in Sellers' career after 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;THE NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New York Times is a newspaper that published reviews of 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;RICHARD EDER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Eder is a reviewer for The New York Times who wrote about 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;CINEMA VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cinema Village is a theater where 'Great McGonagall' opened.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;MCGONAGALL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"McGonagall is a Scottish poet known for his humorous and often unintentionally comic verse.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;VICTORIAN VERSIFIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Victorian versifier refers to the Scottish poet who was unemployed and determined to be the Queen's laureate.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;LESLIE HALLIWELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leslie Halliwell is a film critic who described 'Great McGonagall' as an 'appalling tribute to a minor figure of sub-literature'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;VARIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Variety is a publication that reviewed 'Great McGonagall', criticizing the script, structure, and direction.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;THE RADIO TIMES GUIDE TO FILMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Radio Times Guide to Films is a guide that gave 'Great McGonagall' 1/5 stars.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;BRITISH FACES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"British faces refers to the cast members of 'Great McGonagall', many of whom played multiple roles.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;WITLESS SCRIPT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Witless script refers to the poor quality of the screenplay in 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;HODGEPODGE STRUCTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Hodgepodge structure refers to the disorganized and chaotic structure of 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;SLEDGEHAMMER DIRECTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sledgehammer direction refers to the heavy-handed approach to directing 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;SUB-LITERATURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sub-literature refers to the low-quality or non-literary status of 'Great McGonagall'.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <node id="&quot;QUEEN'S LAUREATE&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Queen's laureate is a position that McGonagall aspired to, highlighting his ambitions.")</data>
      <data key="d2">ramdocs-0094-d5f9cdbf19a3</data>
    </node>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;SELLERS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Great McGonagall is a film in Sellers' career, marking one of his flops before improving with 'The Return of the Pink Panther'."</data>
      <data key="d5">"career trajectory, film flop"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;THE NEW YORK TIMES&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The New York Times published reviews of 'Great McGonagall', including a mixed opinion from Richard Eder."</data>
      <data key="d5">"media coverage, critical reception"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;CINEMA VILLAGE&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Great McGonagall opened at the Cinema Village theater, indicating its release venue."</data>
      <data key="d5">"release venue, theatrical debut"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;MCGONAGALL&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Great McGonagall is named after a Scottish poet, suggesting a thematic or biographical connection."</data>
      <data key="d5">"biographical reference, thematic connection"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;VICTORIAN VERSIFIER&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Victorian versifier is another term for the Scottish poet associated with 'Great McGonagall', highlighting the poet's historical context."</data>
      <data key="d5">"historical context, poet identity"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;LESLIE HALLIWELL&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Leslie Halliwell criticized 'Great McGonagall' as an 'appalling tribute to a minor figure of sub-literature', providing a negative review."</data>
      <data key="d5">"negative review, literary criticism"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;VARIETY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Variety reviewed 'Great McGonagall', criticizing the script, structure, and direction, indicating a professional critique."</data>
      <data key="d5">"professional critique, script analysis"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
    <edge source="&quot;GREAT MCGONAGALL&quot;" target="&quot;THE RADIO TIMES GUIDE TO FILMS&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The Radio Times Guide to Films gave 'Great McGonagall' 1/5 stars, reflecting a low rating for the film."</data>
      <data key="d5">"film rating, critical assessment"</data>
      <data key="d6">ramdocs-0094-d5f9cdbf19a3</data>
    </edge>
