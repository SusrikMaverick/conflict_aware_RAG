  <graph edgedefault="undirected">
    <node id="&quot;TING-CHANG HSIEH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ting-Chang Hsieh is a renowned researcher known for his groundbreaking work in data analysis and interdisciplinary collaboration."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;UNIVERSITÉ DE MONTRÉAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Université de Montréal is a Canadian institution where Ting-Chang Hsieh studied and developed his research methodology."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;FRENCH PHILOSOPHER MICHEL FOUCAULT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michel Foucault is a philosopher whose theories on power structures and knowledge systems influenced Ting-Chang Hsieh's research."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;DR. SOPHIE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophie Dupont is a colleague and fellow researcher at Université de Montréal who praises Ting-Chang Hsieh's work."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;DR. PIERRE TREMBLAY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Pierre Tremblay is the Dean of the Faculty of Science at Université de Montréal who speaks highly of Ting-Chang Hsieh's work."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;LINKOU CHANG GUNG MEMORIAL HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Linkou Chang Gung Memorial Hospital is a prestigious healthcare organization in Linkou, Taiwan, where Ting-Chang Hsieh has collaborated on research projects."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;DR. MING-HUEI CHENG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ming-Huei Cheng is the Director of the Department of Plastic and Reconstructive Surgery at Linkou Chang Gung Memorial Hospital who confirms Hsieh's involvement."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;JOURNAL OF MEDICAL RESEARCH&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Medical Research is a publication where a study co-authored by Ting-Chang Hsieh and hospital researchers was published."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;MONTREAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montreal is the city where Ting-Chang Hsieh's groundbreaking work is taking place."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;ACADEMIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The academic community includes researchers and institutions that are excited about Hsieh's work."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;DATA ANALYSIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Data analysis is the field that Ting-Chang Hsieh's work is revolutionizing."</data>
      <data key="d2">cb-0218</data>
    </node>
    <node id="&quot;ECONOMICS&quot;">
      <data key="d0">"CONCEPT"</data>
