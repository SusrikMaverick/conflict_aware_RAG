<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;FONTAINE MINISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fontaine Ministry was the government of Luxembourg from 1 August 1848 to 2 December 1848, formed after popular unrest under Governor Gaspard-Théodore-Ignace de la Fontaine."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;WILLMAR MINISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Willmar Ministry was in office in Luxembourg from 2 December 1848 to 23 September 1853, succeeding the Fontaine Ministry."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;SIMONS MINISTRY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Simons Ministry was in office in Luxembourg from 23 September 1853 to 26 September 1860, succeeding the Willmar Ministry."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;LUXEMBOURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Luxembourg is the country where the ministries operated, and the site of the constitutional and parliamentary activities."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;GASPARD-THÉODORE-IGNACE DE LA FONTAINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gaspard-Théodore-Ignace de la Fontaine was the governor of Luxembourg whose actions led to the formation of the Fontaine Ministry."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;KING-GRAND-DUKE WILLIAM II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"King-Grand-Duke William II is mentioned as part of the government seeking conciliation with the people during the unrest."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chamber of Deputies is the legislative body of Luxembourg where elections and confidence votes took place."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;CONSTITUENT ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Constituent Assembly is the body that drafted the new constitution in Ettelbrück."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;ZOLLVEREIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Zollverein is the German customs union whose treaty was renewed by the Simons government."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;COURT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Court is mentioned as the institution where Wurth-Paquet, president of the Court, refused to form a new government."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Netherlands is a neighboring country with which Luxembourg sought to re-establish good relations."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;PRUSSIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Prussia is another neighboring country with which Luxembourg sought to re-establish good relations."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;CHARLES-MATHIAS SIMONS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles-Mathias Simons was the prime minister of the Simons Ministry from 1853 to 1860."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;PAUL DE SCHERFF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul de Scherff was placed in charge of railways in the reshuffled Simons Ministry."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;GUILLAUME-MATHIAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Guillaume-Mathias was part of the Simons Ministry, though specific roles are not detailed."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;JAWAHAR LAL NEHRU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jawahar Lal Nehru is mentioned as a senior leader who faced lathi-charge during protests."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;G.B. PANT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"G.B. Pant is mentioned as a senior leader who faced lathi-charge during protests."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;LALA LAJPAT RAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lala Lajpat Rai is mentioned as a senior leader who faced lathi-charge during protests."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;PUNJAB NAUJAWAN BHARAT SABHA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Punjab Naujawan Bharat Sabha is a group that emerged during the protests, spreading radical socialist ideas."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <node id="&quot;SIMON COMMISSION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Simon Commission came to India in February 1928, associated with the political actions and protests in India."</data>
      <data key="d2">ramdocs-0458-2290b238a752</data>
    </node>
    <edge source="&quot;FONTAINE MINISTRY&quot;" target="&quot;GASPARD-THÉODORE-IGNACE DE LA FONTAINE&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Gaspard-Théodore-Ignace de la Fontaine was the governor under whom the Fontaine Ministry was formed due to popular unrest."</data>
      <data key="d5">"formation, unrest"</data>
      <data key="d6">ramdocs-0458-2290b238a752</data>
    </edge>
    <edge source="&quot;FONTAINE MINISTRY&quot;" target="&quot;KING-GRAND-DUKE WILLIAM II&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"King-Grand-Duke William II sought conciliation with the people along with the Fontaine government during the unrest."</data>
      <data key="d5">"conciliation, unrest"</data>
      <data key="d6">ramdocs-0458-2290b238a752</data>
    </edge>
    <edge source="&quot;FONTAINE MINISTRY&quot;" target="&quot;CHAMBER OF DEPUTIES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Fontaine Ministry faced opposition from liberals in the Chamber of Deputies who described them as 'turncoats'. Gaspard-Théodore-Ignace de la Fontaine resigned after receiving a feeble majority in a confidence vote in the Chamber."</data>
      <data key="d5">"opposition, confidence vote"</data>
      <data key="d6">ramdocs-0458-2290b238a752</data>
    </edge>
  </graph>
</graphml>
