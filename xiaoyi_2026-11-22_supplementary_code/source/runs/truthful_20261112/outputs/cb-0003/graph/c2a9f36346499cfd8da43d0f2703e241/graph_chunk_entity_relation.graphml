  <graph edgedefault="undirected">
    <node id="&quot;MARTINA SCHATTKOWSKY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martina Schattkowsky is a German historian known for her research on the cultural heritage of Central Europe, particularly the relationship between Germany and Slovenia."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is a country mentioned in the context of the 19th Century."&lt;SEP&gt;"Germany is the country of origin and primary residence for Martina Schattkowsky, where she has conducted much of her research and holds citizenship."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;SLOVENIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Slovenia is a country with which Martina Schattkowsky has strong ties due to her research and citizenship."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;UNIVERSITY OF LEIPZIG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Leipzig is an institution where Martina Schattkowsky has held a position, contributing to the German academic community."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;UNIVERSITY OF HALLE-WITTENBERG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Halle-Wittenberg is an institution where Martina Schattkowsky has held a position, further establishing her roots in the German academic community."&lt;SEP&gt;"The University of Halle-Wittenberg is another institution where Martina Schattkowsky has held a position, further establishing her roots in the German academic community."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;GERMAN HISTORICAL INSTITUTE IN WARSAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German Historical Institute in Warsaw is an institution where Martina Schattkowsky has held a position, showcasing her international academic connections."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;UNIVERSITY OF MUNICH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Munich is where Martina Schattkowsky earned her degree in History and Slavic Studies, marking the beginning of her academic career."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;UNIVERSITY OF LJUBLJANA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Ljubljana is where Martina Schattkowsky served as a visiting professor, strengthening her ties with the Slovenian academic community."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;DEUTSCHE BUNDESAMT FÜR STATISTIK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The German Federal Statistical Office provides data confirming Martina Schattkowsky's citizenship and residence in Germany."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;DR. ANDREAS RÖPCKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Andreas Röpcke is a fellow historian and colleague of Martina Schattkowsky at the University of Leipzig, providing insight into her academic standing."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Berlin is the city where Martina Schattkowsky's citizenship is being verified and discussed."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;WEST GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Germany is the country where Martina Schattkowsky was born in 1965."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;EASTERN EUROPE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Eastern Europe is mentioned as a place that inspired Martina Schattkowsky's interest in history at a young age."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;HABSBURG ERA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Habsburg era is a period during which Martina Schattkowsky researched the cultural exchange between Germany and Slovenia."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;BAVARIAN FOLKLORE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bavarian Folklore is the subject of Martina Schattkowsky's dissertation 'The Slovenian Influence on Bavarian Folklore', which was published in 1995."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;JOURNAL OF SLAVIC STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"The Journal of Slavic Studies is a publication that reviewed Martina Schattkowsky's research on the cultural exchange between Germany and Slovenia during the 19th century."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;SLOVENIAN MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Slovenian Ministry of Culture published a comprehensive review of Martina Schattkowsky's work, highlighting her contributions to Slovenian culture and heritage."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;CENTRAL EUROPEAN HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Central European history is the field in which Martina Schattkowsky conducts her research, focusing on the cultural dynamics between Germany and Slovenia."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;19TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 19th century is the time period during which Martina Schattkowsky's research on the cultural exchange between Germany and Slovenia took place."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;20TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 20th century is the broader time period during which Martina Schattkowsky's academic career took off and developed."</data>
      <data key="d2">cb-0003</data>
    </node>
    <node id="&quot;21ST CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 21st century is the time period during which Martina Schattkowsky's work continues to be recognized and studied."</data>
      <data key="d2">cb-0003</data>
    </node>
