    <edge source="&quot;COLERAINE F.C.&quot;" target="&quot;NIFL PREMIERSHIP&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Coleraine F.C. competes in the NIFL Premiership, where Rory Patterson helped the team secure a 6th-place finish in the 2012-2013 season."</data>
      <data key="d5">"competition, success"</data>
      <data key="d6">cb-0422</data>
    </edge>
    <edge source="&quot;HJK HELSINKI&quot;" target="&quot;TEEMU PUKKI&quot;">
