  <graph edgedefault="undirected">
    <node id="&quot;AC MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AC Milan is one of the most storied clubs in the world, based in Milan, Italy, and has been the stage for many legends, including Mario Magnozzi."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;MARIO MAGNOZZI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mario Magnozzi is a football player who is expected to join FC Nara-ShBFR Naro-Fominsk and make his debut in the upcoming season opener."&lt;SEP&gt;"Mario Magnozzi is an Italian footballer and manager who played for AC Milan and later joined FC Nara-ShBFR Naro-Fominsk, known for his defensive prowess and leadership."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;MILAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan is a city in Italy, home to AC Milan and the Duomo."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;DUOMO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Duomo is a landmark in Milan, Italy, known for its grandeur."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;EMPOLI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Empoli is Mario Magnozzi's hometown club where he played before joining AC Milan."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;SAN SIRO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Siro is the stadium where AC Milan plays, located in Milan, Italy."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;SERIE A&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Serie A is the top-flight professional league of Italian football where AC Milan competes."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;INTER MILAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Inter Milan is an Italian football club, AC Milan's arch-rival."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;UDINESE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Udinese is a football club that led Serie A during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;FC NARA-SHBFR NARO-FOMINSK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Nara-ShBFR Naro-Fominsk is a Russian football club aiming to become a top-tier club in both Russia and Europe."&lt;SEP&gt;"FC Nara-ShBFR Naro-Fominsk is a Russian football club that signed Mario Magnozzi in a surprising move."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;RUSSIAN PREMIER LEAGUE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Russian Premier League is the top division of Russian football where FC Nara-ShBFR Naro-Fominsk previously competed."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;SERGEY KUZNETSOV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sergey Kuznetsov is the manager of FC Nara-ShBFR Naro-Fominsk."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;IGOR PETROV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Igor Petrov is the owner of FC Nara-ShBFR Naro-Fominsk and has invested heavily in the club."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;FC ROSTOV&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Rostov is a Russian football club that FC Nara-ShBFR Naro-Fominsk will play against in their season opener."&lt;SEP&gt;"FC Rostov is another Russian football club that FC Nara-ShBFR Naro-Fominsk will play against in their season opener."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;GUNNAR NORDAHL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gunnar Nordahl was a Swedish striker who played for AC Milan during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;JUAN ALBERTO SCHIAFFINO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Juan Alberto Schiaffino was an Argentine striker who played for AC Milan during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;NILS LIEDHOLM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Nils Liedholm was a Swedish defender who played for AC Milan during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;BÉLA GUTTMANN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Béla Guttmann was a Hungarian football manager and former player who coached AC Milan during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;FRANCO PEDRONI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Franco Pedroni was a defender who played alongside Mario Magnozzi at AC Milan during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;MILAN, ITALY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan, Italy is the city where AC Milan is based and where the Duomo is located."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;TUSCAN REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscan region is Mario Magnozzi's hometown, where he played for Empoli before joining AC Milan."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;AC MILAN'S SCOUTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AC Milan's scouts were responsible for identifying and recruiting talent, such as Mario Magnozzi, to bolster the squad."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;SCUDETTO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Scudetto is the title for the winner of the Serie A championship, which AC Milan was aiming to win during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;MARIO MAGNOZZI'S TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
