      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;AC MILAN'S SQUAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AC Milan's squad includes players like Mario Magnozzi, Gunnar Nordahl, Juan Alberto Schiaffino, and Nils Liedholm."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;AC MILAN'S COACHING STAFF&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AC Milan's coaching staff includes Béla Guttmann, who guided the team during the 1954-1955 season."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;PETROV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Petrov is a representative of FC Nara-ShBFR Naro-Fominsk, likely the manager or owner, making statements about the club's future plans."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;JULY 25&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"July 25 is the date of FC Nara-ShBFR Naro-Fominsk's season opener against FC Rostov."</data>
      <data key="d2">cb-0230</data>
    </node>
    <node id="&quot;RUSSIA&quot;">
