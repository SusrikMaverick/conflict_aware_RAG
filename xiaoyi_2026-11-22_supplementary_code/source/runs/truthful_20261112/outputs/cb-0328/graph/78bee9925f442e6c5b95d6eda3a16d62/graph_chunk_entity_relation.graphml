  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VÄXJÖ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Växjö is a quaint town in Sweden, known for its tranquil lakes and lush forests, and home to Linnaeus University."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;LINNAEUS UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Linnaeus University is a hub of academic excellence and innovation, where Mirjam Ekstedt has spent a significant portion of her career."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;MIRJAM EKSTEDT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mirjam Ekstedt is a renowned researcher with a deep connection to Linnaeus University, known for her work in technology and education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;MIRJAM EKSTEDT'S RESEARCH&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mirjam Ekstedt's research has significantly impacted the academic community, particularly in the areas of technology and education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;UNIVERSITY OF STOCKHOLM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Stockholm is where Mirjam Ekstedt earned her undergraduate degree in sociology."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;UNIVERSITY OF TOKYO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Tokyo is an institution where Mirjam Ekstedt holds a Research Fellowship."&lt;SEP&gt;"University of Tokyo is where Mirjam Ekstedt pursued her graduate studies and conducted groundbreaking research."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;DEPARTMENT OF EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Department of Education at Linnaeus University is where Mirjam Ekstedt has been actively involved in research and teaching."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;SWEDISH NATIONAL AGENCY FOR EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Swedish National Agency for Education collaborates with Linnaeus University on research projects."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;DIGITAL LITERACY IN THE CLASSROOM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 'Enhancing Digital Literacy in the Classroom' project is a collaborative effort between Linnaeus University and the Swedish National Agency for Education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;THE TOKYO YOUTH PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 'The Tokyo Youth Project' is a notable study on the impact of digital media on Japanese youth, funded by the Japanese Ministry of Education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;THE VIRTUAL VILLAGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 'The Virtual Village' is an ethnographic study of online communities in Japan, exploring the impact of digital technologies on social relationships and cultural practices."&lt;SEP&gt;"The 'The Virtual Village' is an ethnographic study of online communities in Japan, exploring the ways in which digital technologies shape social relationships and cultural practices."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;HIROSHI MATSUMOTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hiroshi Matsumoto is a leading expert in Japanese cultural studies and a collaborator of Mirjam Ekstedt at the University of Tokyo."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;JAPANESE MINISTRY OF EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Japanese Ministry of Education funds research projects, such as the 'The Tokyo Youth Project'."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;JOURNAL OF EDUCATIONAL RESEARCH&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Educational Research is where Mirjam Ekstedt published her 2015 paper on the intersection of technology and education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;JOURNAL OF DIGITAL ANTHROPOLOGY&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Digital Anthropology is where Mirjam Ekstedt published her seminal paper on the virtual self in 2006."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;JOURNAL OF JAPANESE STUDIES&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Journal of Japanese Studies is the publication where the research paper 'The Impact of Digital Media on Japanese Youth Culture' was published."&lt;SEP&gt;"Journal of Japanese Studies is where Mirjam Ekstedt co-authored a paper with Hiroshi Matsumoto on the impact of digital media on Japanese youth culture."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;LINNAEUS UNIVERSITY ANNUAL REPORT FOR 2018&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Linnaeus University Annual Report for 2018 highlights Mirjam Ekstedt's work on digital literacy and its impact on education."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;OTO, H.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"OTO, H. is an author of the research paper on the impact of digital media on Japanese youth culture."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;EKSTEDT, M.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ekstedt, M. is an author of the research paper on the impact of digital media on Japanese youth culture and a Research Fellow at the University of Tokyo."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;RESEARCH FELLOWSHIPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Research Fellowships are positions held by scholars at academic institutions, such as the University of Tokyo, where Mirjam Ekstedt is a fellow."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;THE IMPACT OF DIGITAL MEDIA ON JAPANESE YOUTH CULTURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Impact of Digital Media on Japanese Youth Culture is the title of the research paper published by OTO, H. and Ekstedt, M."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2005 is the year the research paper 'The Impact of Digital Media on Japanese Youth Culture' was published."</data>
      <data key="d2">cb-0328</data>
    </node>
    <node id="&quot;2006&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"2006 is the year when the University of Tokyo awarded Research Fellowships to Mirjam Ekstedt."</data>
      <data key="d2">cb-0328</data>
    </node>
