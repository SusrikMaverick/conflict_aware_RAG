  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VESTRI (FOOTBALL CLUB)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vestri (football club) is the football department of the Vestri sport club, based in Ísafjarðarbær, Iceland, and was founded in 1986 under the name 'Boltafélag Ísafjarðar'."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;VESTRI SPORT CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vestri sport club is the parent organization of the football club Vestri, located in Ísafjarðarbær, Iceland."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;ÍSAFJARÐARBÆR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ísafjarðarbær is the location where the Vestri football club is based."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;BOLTAFÉLAG ÍSAFJARÐAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boltafélag Ísafjarðar is the original name of the Vestri football club before it was officially renamed in 1986."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;2. DEILD KARLA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2. deild karla is the league in which the men's team of Vestri played as of 2018."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;4. DEILD KARLA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"4. deild karla was the league in which Vestri first participated in 1986."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;BJÖRN HELGASON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Björn Helgason was the first coach of Vestri in 1986."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;ÍÞRÓTTABANDALAG ÍSAFJARÐAR (ÍBÍ)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Íþróttabandalag Ísafjarðar (ÍBÍ) is the club that folded in 1988, after which many of its players joined Vestri."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;IF VESTRI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IF Vestri is the basketball club associated with Vestri, established in 1986."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;SOFASCORE LIVESCORE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sofascore livescore provides live coverage of basketball matches, including those involving IF Vestri."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;SIGURÐUR PÉTURSSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sigurður Pétursson wrote 'Knattspyrnusaga Ísfirðinga', a book about the history of Vestri football club."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;MORGUNBLAÐIÐ&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Morgunblaðið is the newspaper that reported on Vestri's promotion to the top division in 2019."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;KNATTSPYRNUSAGA ÍSFIRÐINGA&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"Knattspyrnusaga Ísfirðinga is a book written by Sigurður Pétursson about the history of Vestri football club."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 2019, Vestri promoted to the top division, as reported by Morgunblaðið."</data>
      <data key="d2">ramdocs-0054-4ef5a503cc18</data>
    </node>
    <edge source="&quot;VESTRI (FOOTBALL CLUB)&quot;" target="&quot;BJÖRN HELGASON&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Björn Helgason was the first coach of Vestri in 1986, when the club was known as Boltafélag Ísafjarðar."</data>
      <data key="d5">"coaching, founding"</data>
      <data key="d6">ramdocs-0054-4ef5a503cc18</data>
    </edge>
    <edge source="&quot;VESTRI (FOOTBALL CLUB)&quot;" target="&quot;ÍÞRÓTTABANDALAG ÍSAFJARÐAR (ÍBÍ)&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Many players from Íþróttabandalag Ísafjarðar (ÍBÍ) joined Vestri after the club folded in 1988."</data>
      <data key="d5">"player transfer, continuity"</data>
      <data key="d6">ramdocs-0054-4ef5a503cc18</data>
    </edge>
    <edge source="&quot;VESTRI (FOOTBALL CLUB)&quot;" target="&quot;2. DEILD KARLA&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The men's team of Vestri plays in 2. deild karla as of 2018."</data>
      <data key="d5">"league participation, current status"</data>
      <data key="d6">ramdocs-0054-4ef5a503cc18</data>
    </edge>
    <edge source="&quot;VESTRI (FOOTBALL CLUB)&quot;" target="&quot;4. DEILD KARLA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Vestri first participated in 4. deild karla in 1986, the year the club was founded."</data>
      <data key="d5">"league debut, historical context"</data>
      <data key="d6">ramdocs-0054-4ef5a503cc18</data>
    </edge>
    <edge source="&quot;VESTRI (FOOTBALL CLUB)&quot;" target="&quot;IF VESTRI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"IF Vestri is the basketball club associated with the football club Vestri, both established in 1986."</data>
      <data key="d5">"association, continuity"</data>
      <data key="d6">ramdocs-0054-4ef5a503cc18</data>
    </edge>
    <edge source="&quot;IF VESTRI&quot;" target="&quot;SOFASCORE LIVESCORE&quot;">
      <data key="d3">8.0</data>
