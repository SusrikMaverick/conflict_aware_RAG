  <graph edgedefault="undirected">
    <node id="&quot;THE BELLEVILLE NEWS-DEMOCRAT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Belleville News-Democrat is a daily newspaper in Belleville, Illinois, focusing on local news and published by The McClatchy Company since 2009."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE MCCLATCHY COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The McClatchy Company is the publisher of The Belleville News-Democrat since 2009."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;BELLEVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Belleville is a city in St. Clair County, Illinois, where The Belleville News-Democrat is based."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;SPRINGFIELD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Springfield is mentioned as another city where The Belleville News-Democrat is claimed to be based, though this is likely a repetition or error."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;ST. CLAIR COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Clair County is the county where The Belleville News-Democrat is based."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;RUSSELLVILLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Russellville is the county seat of Logan County, Kentucky, where The News-Democrat &amp; Leader is based."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;LOGAN COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Logan County is the county where The News-Democrat &amp; Leader is based."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE NEWS-DEMOCRAT &amp; LEADER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The News-Democrat &amp; Leader is a twice-weekly newspaper in Russellville, Kentucky, founded in 1806 and merged with The Logan County News and The Democrat in 1911."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE LOGAN COUNTY NEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Logan County News was part of the merger that formed The News-Democrat &amp; Leader in 1911."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE DEMOCRAT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democrat was part of the merger that formed The News-Democrat &amp; Leader in 1911."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE LOGAN LEADER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Logan Leader was a paper started by employees of The News-Democrat in 1968, then merged back into the original company."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;THE WEEKLY DEMOCRAT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Weekly Democrat was the original name of The Belleville News-Democrat, founded in 1858."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;EARLY 1860S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In the early 1860s, The Belleville News merged with The Weekly Democrat to become The Belleville News-Democrat."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;FAMILY-OWNED NEWSPAPER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Belleville News-Democrat was a family-owned newspaper until 1972."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;1972&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1972, The Belleville News-Democrat was purchased, ending its period as a family-owned newspaper."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;LAUNDRIE’S PARENTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laundrie’s parents are mentioned in the context of railing against inaccuracies in a documentary."</data>
      <data key="d2">ramdocs-0278-2db293af3119</data>
    </node>
    <node id="&quot;PETITO DOCUMENTARY&quot;">
      <data key="d0">"EVENT"</data>
