<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PATTALI MAKKAL KATCHI (PMK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pattali Makkal Katchi (PMK) is a political party in Tamil Nadu, India, founded by S. Ramadoss in 1989 for the upliftment of the Tamil community."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;S. RAMADOSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"S. Ramadoss is the founder of the Pattali Makkal Katchi (PMK) political party in Tamil Nadu, India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;DEMOCRATIC PROGRESSIVE ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic Progressive Alliance is a broad Tamil political front including PMK, DMK, INC, CPI, CPI(M), and IUML."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;DRAVIDA MUNNETRA KAZHAGAM (DMK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"DMK is a major political party in Tamil Nadu, India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;INDIAN NATIONAL CONGRESS (INC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INC is a major national political party in India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;COMMUNIST PARTY OF INDIA (CPI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CPI is a communist political party in India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;COMMUNIST PARTY OF INDIA (MARXIST) (CPI(M))&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CPI(M) is a Marxist political party in India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;INDIAN UNION MUSLIM LEAGUE (IUML)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IUML is a Muslim political party in India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;PEOPLE'S MOVEMENT OF KOSOVO (LPK)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People's Movement of Kosovo (LPK) is a political party in Kosovo, originally founded as a political movement of Albanian nationalists in 1981."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;ALBANIAN DIASPORA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Albanian diaspora refers to Albanian communities living outside Kosovo, particularly in Switzerland and Germany."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;SOCIALISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Socialism is a political and economic ideology that emphasizes public ownership of the means of production and distribution of goods."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;KOSOVO WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Kosovo War was a conflict in Kosovo that led to the formation of the People's Movement of Kosovo (LPK)."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;KOSOVO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kosovo is a region in southeastern Europe, known for its historical and political significance."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;PALEOLITHIC AND MESOLITHIC MAN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Paleolithic and Mesolithic man refer to early human populations in the prehistoric era."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;NEOLITHIC MAN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Neolithic man refers to the people of the Neolithic period, characterized by the development of agriculture and pottery."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;VLASHNJË AND RUNIK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vlashnjë and Runik are significant Neolithic sites in Kosovo."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;ELECTION COMMISSION OF INDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Election Commission of India is responsible for conducting free and fair elections in India."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;TAMIL NADU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tamil Nadu is a state in southern India where the PMK operates."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;SWITZERLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Switzerland is part of the Albanian diaspora's location."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Germany is part of the Albanian diaspora's location."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;YUGOSLAVIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yugoslavia is the historical context for the LPK's formation."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;SOCIAL CONSERVATISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social conservatism is a political ideology emphasizing traditional social values."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;LIBERAL CONSERVATISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Liberal conservatism is a political ideology combining liberal and conservative principles."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;FAR-LEFT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Far-left is a political ideology advocating for radical social and economic changes."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;CENTRE-RIGHT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Centre-right is a political ideology advocating for moderate conservative policies."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <node id="&quot;RED, BLACK AND YELLOW&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Red, Black, and Yellow are the colors used by the LPK."</data>
      <data key="d2">ramdocs-0154-ba33f5bcc625</data>
    </node>
    <edge source="&quot;PATTALI MAKKAL KATCHI (PMK)&quot;" target="&quot;S. RAMADOSS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"S. Ramadoss founded the Pattali Makkal Katchi (PMK) political party in 1989."</data>
      <data key="d5">"founding, leadership"</data>
      <data key="d6">ramdocs-0154-ba33f5bcc625</data>
    </edge>
    <edge source="&quot;PATTALI MAKKAL KATCHI (PMK)&quot;" target="&quot;DEMOCRATIC PROGRESSIVE ALLIANCE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"PMK joined the Democratic Progressive Alliance ahead of the 2004 elections, along with other political parties."</data>
      <data key="d5">"political alliance, election strategy"</data>
      <data key="d6">ramdocs-0154-ba33f5bcc625</data>
    </edge>
    <edge source="&quot;PEOPLE'S MOVEMENT OF KOSOVO (LPK)&quot;" target="&quot;ALBANIAN DIASPORA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The LPK's support and membership come from the Albanian diaspora, especially in Switzerland and Germany."</data>
      <data key="d5">"support base, diaspora involvement"</data>
      <data key="d6">ramdocs-0154-ba33f5bcc625</data>
    </edge>
    <edge source="&quot;PEOPLE'S MOVEMENT OF KOSOVO (LPK)&quot;" target="&quot;KOSOVO WAR&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The LPK was formed during the turmoil that brought the Albanian population of Yugoslavia to wider attention, following the Kosovo War."</data>
      <data key="d5">"formation context, historical significance"</data>
      <data key="d6">ramdocs-0154-ba33f5bcc625</data>
    </edge>
  </graph>
