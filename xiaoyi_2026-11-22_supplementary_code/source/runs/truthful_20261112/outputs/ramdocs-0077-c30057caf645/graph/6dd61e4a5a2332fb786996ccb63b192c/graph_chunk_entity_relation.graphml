  <graph edgedefault="undirected">
    <node id="&quot;JOSEPH LAFONTAINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Lafontaine was a farmer and political figure in Quebec, representing Berthier in the Legislative Assembly of Quebec from 1904 to 1912 and from 1916 to 1919 as a Liberal. He was born in Saint-Barthélémi, Canada East, and held various positions including mayor of Saint-Barthélémi and warden."</data>
      <data key="d2">ramdocs-0077-c30057caf645</data>
    </node>
    <node id="&quot;BERTHIER MLA&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Berthier MLA refers to Joseph Lafontaine's position as a Member of the Legislative Assembly representing Berthier."</data>
      <data key="d2">ramdocs-0077-c30057caf645</data>
    </node>
    <node id="&quot;SAINT-BARTHÉLÉMI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Saint-Barthélémi is a location where Joseph Lafontaine was born and served as mayor from 1897 to 1903."</data>
      <data key="d2">ramdocs-0077-c30057caf645</data>
    </node>
    <node id="&quot;LEGISLATIVE ASSEMBLY OF QUEBEC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Legislative Assembly of Quebec is the legislative body where Joseph Lafontaine served as a representative."</data>
      <data key="d2">ramdocs-0077-c30057caf645</data>
    </node>
    <node id="&quot;CANADA EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Canada East is a historical region where Joseph Lafontaine was born and educated."</data>
      <data key="d2">ramdocs-0077-c30057caf645</data>
    </node>
    <node id="&quot;COLLÈGE DE JOLIETTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Collège de Joliette is an educational institution where Joseph Lafontaine was educated."</data>
