  <graph edgedefault="undirected">
    <node id="&quot;LAKE COUNTY PUBLIC LIBRARY SYSTEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lake County Public Library System (LCLS) is a library system established in 1982, consisting of 15 libraries in Lake County, Florida, with an administrative office in Tavares."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;TAVARES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tavares is the location of the administrative office for the Lake County Public Library System."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;LUZERNE COUNTY LIBRARY SYSTEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Luzerne County Library System (LCLS) is an organization that administers ten libraries in Luzerne County, Pennsylvania, founded in 1986 and headquartered at the Osterhout Free Library in Wilkes-Barre, Pennsylvania."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;OSTERHOUT FREE LIBRARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Osterhout Free Library is the headquarters of the Luzerne County Library System in Wilkes-Barre, Pennsylvania."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;ISAAC SMITH OSTERHOUT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Isaac Smith Osterhout willed a substantial portion of his estate for the establishment of a free public library in 1887."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;MELVIL DEWEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Melvil Dewey, creator of the Dewey decimal system, advised the board of directors of the Luzerne County Library System in 1887."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;FIRST PRESBYTERIAN CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"First Presbyterian Church, built in 1849, was used as a library building for approximately 10 years before becoming the permanent arrangement for the Luzerne County Library System."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;LAURA HARDING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Laura Harding is a resident of Avoca who delivers books to the Osterhout Library."&lt;SEP&gt;"Laura Harding, from Avoca, delivers books to the Osterhout Library on November 22, 2024."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
    <node id="&quot;AVOCA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Avoca is a location where Laura Harding, a resident, delivers books to the Osterhout Library."</data>
      <data key="d2">ramdocs-0252-0558f2579ae7</data>
    </node>
