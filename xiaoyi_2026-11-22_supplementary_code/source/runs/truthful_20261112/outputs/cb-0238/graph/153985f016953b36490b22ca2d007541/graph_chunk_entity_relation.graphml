  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GISELHER KLEBE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giselher Klebe is a renowned German composer known for his symphonies, operas, and chamber music, and has received prestigious honors for his contributions to classical music."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;QUEEN ELIZABETH II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Queen Elizabeth II is the British monarch who awarded Giselher Klebe the title of Knight Bachelor."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;KNIGHT BACHELOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Knight Bachelor is a British honor given to individuals who have made significant contributions to their respective fields."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;BUCKINGHAM PALACE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buckingham Palace is the official residence and workplace of the British monarch where the Knight Bachelor ceremony took place."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;BRITISH HONOURS COMMITTEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Honours Committee is responsible for recommending individuals for various honors, including the Knight Bachelor title."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;LORD JAMES HAMILTON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lord James Hamilton is the chairman of the British Honours Committee and praised Giselher Klebe's contributions."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;SIR SIMON RATTLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Simon Rattle is a renowned conductor who congratulated Giselher Klebe on his honor."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;MANNHEIM, GERMANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mannheim, Germany is the birthplace of Giselher Klebe and a significant part of his early musical upbringing."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;BERLINER KUNSTPREIS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Berliner Kunstpreis is a prestigious German art award recognizing outstanding contributions to the fields of music, literature, visual arts, and film."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;DIE ERMORDUNG CÄSARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Die Ermordung Cäsars is Giselher Klebe's opera that premiered in 1959 and is considered a landmark work in modern German opera."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;DIE RÄUBER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Die Räuber is Giselher Klebe's opera that premiered in 1957 and is still widely performed today."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;ORCHESTRAS AND ENSEMBLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orchestras and ensembles perform Giselher Klebe's works around the world, highlighting his impact on the classical music world."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;CLASSICAL MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Classical music is the genre in which Giselher Klebe's works are categorized and celebrated."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;MODERN CLASSICAL MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Modern classical music is the style in which Giselher Klebe's works are classified, reflecting his unique blend of traditional and modern elements."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;GERMAN CULTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"German culture is promoted and enriched by Giselher Klebe's contributions to classical music."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;NEXT GENERATION MUSICIANS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Giselher Klebe's work inspires and nurtures the next generation of musicians."</data>
      <data key="d2">cb-0238</data>
    </node>
    <node id="&quot;1986&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"The event took place in 1986, marking a significant year in Klebe's life."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;KLEBE&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"The event took place in 1986, marking a significant year in Klebe's life."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;BERLIN&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"Klebe received the Berliner Kunstpreis in Berlin, highlighting the significance of the event."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;JURY&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"The jury praised Klebe's work, recognizing his innovative spirit and dedication."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;WORLD OF MUSIC&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"Klebe's contributions are recognized in the world of music."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ARTISTIC EXCELLENCE&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"Klebe's work is recognized for artistic excellence."&lt;</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;NEXT GENERATION OF MUSICIANS&quot;">
      <data key="d2">cb-0238</data>
      <data key="d1">"Klebe nurtures the next generation of musicians."&lt;</data>
