  <graph edgedefault="undirected">
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a medical professional at University Medical Center Groningen, known for her curiosity and recognition of brilliant minds like Xiao-Jin He."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;UNIVERSITY MEDICAL CENTER GRONINGEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University Medical Center Groningen is a hospital where Dr. Sophia Patel works, known for its medical innovation and collaboration with other institutions."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;XIAO-JIN HE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Xiao-Jin He is a researcher at University Medical Center Groningen, recognized for his work in regenerative medicine and a collaborative project with Beijing."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;GRONINGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Groningen is a city where University Medical Center Groningen is located, known for its medical research and innovation."&lt;SEP&gt;"Groningen is a city where University Medical Center is located, known for its medical research and innovation."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is a city where a prominent research institution collaborates with University Medical Center Groningen on a project led by Xiao-Jin He."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;FIRST AFFILIATED HOSPITAL OF ANHUI MEDICAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"First Affiliated Hospital of Anhui Medical University is a hospital in Hefei, China, where Xiao-Jin He has made significant contributions."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;HEFEI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hefei is a city where First Affiliated Hospital of Anhui Medical University is located, known for its medical research and innovation."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;ANHUI MEDICAL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Anhui Medical University is the parent institution of First Affiliated Hospital of Anhui Medical University, known for its medical research and education."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;DR. VAN DER MEER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Van der Meer is the director of University Medical Center Groningen, mentioned in relation to Xiao-Jin He's collaborative project."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;JOURNAL OF CARDIOVASCULAR MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Cardiovascular Medicine is a scientific journal where He's work has been published, showcasing their expertise in molecular biology."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;CHINESE MEDICAL JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Chinese Medical Journal is a scientific journal where He's work has been published, demonstrating their ability to collaborate with colleagues from diverse disciplines."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;LIANG CHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Liang Chen is a renowned cardiologist at First Affiliated Hospital of Anhui Medical University, co-author of a paper with Xiao-Jin He on microRNAs in cardiovascular disease."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;ANHUI PROVINCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Anhui Province is the region served by First Affiliated Hospital of Anhui Medical University, known for its healthcare needs and contributions to medical research."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;CARDIOVASCULAR DISEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Cardiovascular disease is a medical condition of great concern in China, where He's early research focused on understanding its molecular mechanisms."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;LUNG CANCER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Lung cancer is a major public health concern in China, where He's later research focused on understanding its molecular mechanisms and developing diagnostic tools."</data>
      <data key="d2">cb-0213</data>
    </node>
    <node id="&quot;SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
