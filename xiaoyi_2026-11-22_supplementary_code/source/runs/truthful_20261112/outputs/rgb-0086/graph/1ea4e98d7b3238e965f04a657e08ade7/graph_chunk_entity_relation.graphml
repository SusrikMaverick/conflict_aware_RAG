  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;VANGUARD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vanguard is a financial services company founded by John C. Bogle and currently led by Abigail Johnson and Tim Buckley."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;JOHN C. BOGLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John C. Bogle is the founder of Vanguard and played a crucial role in its establishment."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;TIM BUCKLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tim Buckley is the current Chairman and CEO of Vanguard, known for his leadership and influence."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;ABIGAIL JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abigail Johnson is the current Chairman and CEO of Vanguard, known for her leadership and influence."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;WAYNE, PENNSYLVANIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wayne, Pennsylvania is the headquarters location of Vanguard."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;HARVARD BUSINESS SCHOOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Harvard Business School is mentioned as a connection to Tim Buckley and Abigail Johnson."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;FOUNDER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Founder refers to the person who establishes an organization, specifically John C. Bogle for Vanguard."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;CHAIRMAN AND CEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Chairman and CEO refer to the highest leadership roles in an organization, held by Tim Buckley and Abigail Johnson at Vanguard."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;CEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"CEO stands for Chief Executive Officer, a top leadership position at Vanguard held by Tim Buckley and Abigail Johnson."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <node id="&quot;INFLUENCER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Influencer refers to a person with significant influence or impact, such as Tim Buckley and Abigail Johnson."</data>
      <data key="d2">rgb-0086</data>
    </node>
    <edge source="&quot;VANGUARD&quot;" target="&quot;JOHN C. BOGLE&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"John C. Bogle founded Vanguard, establishing the organization."</data>
      <data key="d5">"founding, establishment"</data>
      <data key="d6">rgb-0086</data>
    </edge>
    <edge source="&quot;VANGUARD&quot;" target="&quot;TIM BUCKLEY&quot;">
