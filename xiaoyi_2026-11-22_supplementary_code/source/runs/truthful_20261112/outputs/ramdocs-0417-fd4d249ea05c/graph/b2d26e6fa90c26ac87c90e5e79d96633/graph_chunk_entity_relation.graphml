  <graph edgedefault="undirected">
    <node id="&quot;BENNINGTON TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bennington Township is a civil township in Shiawassee County, Michigan, named after Bennington, Vermont, and organized in 1838. It covers an area of 36.1 square miles, with 3,168 people, 1,252 households, and 906 families as of the 2010 census. It includes the village of Marengo and has rivers flowing through it."&lt;SEP&gt;"Bennington township is a land area with a defined population and demographic characteristics."</data>
      <data key="d2">ramdocs-0417-fd4d249ea05c</data>
    </node>
    <node id="&quot;SHIAWASSEE COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shiawassee County is a county in the U.S. state of Michigan where Bennington Township is located."</data>
      <data key="d2">ramdocs-0417-fd4d249ea05c</data>
    </node>
