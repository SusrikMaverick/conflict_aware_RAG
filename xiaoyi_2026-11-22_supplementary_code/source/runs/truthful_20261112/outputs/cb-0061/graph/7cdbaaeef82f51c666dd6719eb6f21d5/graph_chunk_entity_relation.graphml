    <edge source="&quot;MANUELA&quot;" target="&quot;SOCIAL JUSTICE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Manuela is actively involved in promoting social justice through her advocacy and policy work."</data>
      <data key="d5">"advocacy, policy work"</data>
