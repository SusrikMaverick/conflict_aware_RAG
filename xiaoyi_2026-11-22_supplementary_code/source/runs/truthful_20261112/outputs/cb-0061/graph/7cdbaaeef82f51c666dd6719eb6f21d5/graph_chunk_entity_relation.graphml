  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MANUELA PEREIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Manuela Pereira is a French politician and the first woman to hold the position of Catholic bishop in the French Catholic Church, known for her dedication to public service and social justice."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;LYON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lyon is a city in France where Manuela Pereira was born and raised, and where she began her political career."&lt;SEP&gt;"Lyon is the city where Manuela achieved a significant milestone in her career.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;FRENCH CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Catholic Church is the religious institution where Manuela Pereira serves as a bishop and where she has worked to increase female representation in leadership roles."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Church is the broader religious institution where Manuela Pereira serves as a bishop and where she has worked to increase female representation in leadership roles."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;FRENCH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Government is the governmental body where Manuela Pereira served as Minister of Family and Social Affairs."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;POPE FRANCIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Francis is the head of the Catholic Church and ordained Manuela Pereira as a Catholic bishop."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;FRENCH PRESIDENT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The French President is the head of state of France and sent a congratulatory message to Manuela Pereira upon her ordination as a Catholic bishop."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;JOURNAL OF CATHOLIC THEOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Catholic Theology is a publication that studied the impact of Manuela Pereira's ordination on the perception of women in the Catholic Church."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;CATHOLIC HERALD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Herald is a publication that praised Manuela Pereira's leadership and commitment to social justice."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;EIFFEL TOWER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Eiffel Tower is a landmark in Paris, symbolizing France and its cultural heritage."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;SEINE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Seine River is a river that flows through Paris and is a significant geographical feature of France."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;NATIONAL ASSEMBLY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Assembly is a political body where Manuela serves and advocates for various policies.")&lt;SEP&gt;"The National Assembly is the lower house of the French Parliament where Manuela Pereira served as a member."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;COMMITTEE ON CULTURAL AFFAIRS AND EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Committee on Cultural Affairs and Education is a committee in the National Assembly where Manuela Pereira has worked to shape education policy."&lt;SEP&gt;"The Committee on Cultural Affairs and Education is a part of the National Assembly where Manuela has worked to shape education policy.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;GRASSROOTS ACTIVISM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Grassroots Activism refers to Manuela Pereira's early involvement in community service and advocacy for social issues."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;LOCAL COMMUNITY CENTERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Local Community Centers are places where Manuela Pereira volunteered and worked closely with residents to address their concerns."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;EDUCATION REFORM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Education Reform is a cause championed by Manuela Pereira, aimed at improving educational outcomes for all children."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;AFFORDABLE HOUSING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Affordable Housing is a cause championed by Manuela Pereira, aimed at providing housing options for low-income families."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SUSTAINABILITY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Environmental Sustainability is a cause championed by Manuela Pereira, aimed at promoting sustainable practices and policies."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;REFUGEES&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Refugees are a group that Manuela Pereira has worked on behalf of, advocating for their rights and needs."</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;MARGINALIZED COMMUNITIES&quot;">
      <data key="d0">"PERSON_GROUP"</data>
      <data key="d1">"Marginalized Communities are groups that Manuela Pereira has advocated for, including those who face systemic discrimination and inequality."&lt;SEP&gt;"Marginalized communities are the focus of Manuela's advocacy efforts, highlighting her commitment to social justice.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;MANUELA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Manuela is a woman of Portuguese descent who has held a seat in the National Assembly and continues to advocate for social justice and equality.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;PORTUGUESE DESCENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Portuguese descent refers to Manuela's heritage, which is significant in her political career.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social justice is a key area of Manuela's advocacy, aiming to promote equality and fair treatment for all.")</data>
      <data key="d2">cb-0061</data>
    </node>
    <node id="&quot;EQUALITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Equality is another core aspect of Manuela's advocacy, ensuring that everyone has equal opportunities.")</data>
      <data key="d2">cb-0061</data>
    </node>
