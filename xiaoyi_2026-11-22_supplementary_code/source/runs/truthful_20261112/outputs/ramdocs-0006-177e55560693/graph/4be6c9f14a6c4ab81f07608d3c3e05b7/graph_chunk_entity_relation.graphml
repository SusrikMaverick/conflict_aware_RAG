  <graph edgedefault="undirected">
    <node id="&quot;DALLAS COUNTY COURTHOUSE (IOWA)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dallas County Courthouse (Iowa) is a historic courthouse located in Adel, Iowa, United States, built in 1902 and listed on the National Register of Historic Places in 1973."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;ADEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Adel is a city in Dallas County, Iowa, United States, where the Dallas County Courthouse is located."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is a program of the United States government that lists buildings, sites, structures, objects, and districts deemed worthy of preservation."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;COUNTY COURTHOUSES IN IOWA THEMATIC RESOURCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"County Courthouses in Iowa Thematic Resource is a resource that includes the Dallas County Courthouse in Adel, Iowa, as part of a thematic collection."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;ADEL PUBLIC SQUARE HISTORIC DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Adel Public Square Historic District is a historic district that includes the Dallas County Courthouse in Adel, Iowa, as a contributing property."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;DALLAS COUNTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dallas County is a county in Iowa, United States, where the Dallas County Courthouse is located."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;RAWSON AND SON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rawson and Son is the company that built the first courthouse in Dallas County, Iowa, in 1848."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;W. T. PROUDFOOT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"W. T. Proudfoot is an architect who designed the current courthouse in Adel, Iowa, which was built in 1902."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;GEORGE BIRD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Bird is an architect who contributed to the design of the current courthouse in Adel, Iowa, which was built in 1902."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;JONES, ROWSON AND SON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jones, Rowson and Son is the contracting firm that built the third courthouse in Dallas County, Iowa, in 1850."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;JOHN OLSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Olson was the superintendent of construction for the third courthouse in Dallas County, Iowa, which was built in 1850."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;AZAY-LE-RIDEAU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Azay-Le-Rideau is a French Chateau used as inspiration for the design of the current courthouse in Adel, Iowa, which was built in 1902."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1848-1853&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This time period refers to when the first courthouse in Dallas County, Iowa, was in use."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1850&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This year marks the completion of the third courthouse in Dallas County, Iowa, and the dedication of the current courthouse."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1850-1885&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This time period refers to when the second courthouse in Dallas County, Iowa, was in use before the current courthouse was built."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1885&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This year marks the construction of the current courthouse in Dallas County, Iowa."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1900&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This year marks when the funding for the current courthouse was approved by county voters."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;1902-2009&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This time period refers to when the current courthouse in Dallas County, Iowa, was in use until it was included in the Adel Public Square Historic District."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;2009&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"This year marks when the current courthouse was included in the Adel Public Square Historic District."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;$20,000&quot;">
      <data key="d0">"CURRENCY AMOUNT"</data>
      <data key="d1">"This amount represents the cost of the third courthouse in Dallas County, Iowa, which was built in 1850."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;$85,000&quot;">
      <data key="d0">"CURRENCY AMOUNT"</data>
      <data key="d1">"This amount represents the funding approved by county voters for the current courthouse in Dallas County, Iowa, which was built in 1902."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;$109,000&quot;">
      <data key="d0">"CURRENCY AMOUNT"</data>
      <data key="d1">"This amount represents the cost of the third courthouse in Dallas County, Iowa, which was built in 1850."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;FRENCH CHATEAU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The French Chateau, specifically Azay-Le-Rideau, inspired the design of the current courthouse in Adel, Iowa."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;LOIRE RIVER VALLEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Loire River Valley, located 150 miles southwest of Paris, is the region where the French Chateau Azay-Le-Rideau is situated."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;LATE 19TH AND 20TH CENTURY REVIVALS&quot;">
      <data key="d0">"ARCHITECTURAL STYLE"</data>
      <data key="d1">"This architectural style describes the design of the current courthouse in Adel, Iowa."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;VICTORIAN ARCHITECTURE&quot;">
      <data key="d0">"ARCHITECTURAL STYLE"</data>
      <data key="d1">"This architectural style describes the design of the second courthouse in Dallas County, Iowa, which was built in 1850."</data>
      <data key="d2">ramdocs-0006-177e55560693</data>
    </node>
    <node id="&quot;40 BY 20 FEET&quot;">
      <data key="d0">"DIMENSION"</data>
