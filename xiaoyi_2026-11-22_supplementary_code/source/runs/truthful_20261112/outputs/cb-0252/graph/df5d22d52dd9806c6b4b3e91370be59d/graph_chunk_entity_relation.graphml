  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GIUSEPPE PERSIANI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Giuseppe Persiani is a talented composer from Naples, known for his lyricism, elegance, and dramatic flair, and is married to Julie Margaret-Anne Beuth."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;JULIE MARGARET-ANNE BEUTH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Julie Margaret-Anne Beuth is Giuseppe Persiani's wife, a noblewoman known for her piercing green eyes and her quick wit."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;SIGNORA ROSA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Signora Rosa is the cook at the villa, busy preparing dinner for the evening's guests."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;TUSCANY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tuscany is the setting where Giuseppe Persiani composes his music, known for its rolling hills and vineyards."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is the city where the villa is located, and the premiere of Giuseppe's latest work is celebrated."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;VILLA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The villa is a place where Giuseppe Persiani and Julie Margaret-Anne Beuth live, surrounded by vineyards and filled with music and laughter."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;MILAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milan is the city where Giuseppe Persiani works on his opera 'Ines de Castro' and meets Fanny Tacchinardi."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;FANNY TACCHINARDI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Fanny Tacchinardi is a soprano from Rome, known for her powerful, expressive voice and captivating stage presence, and is later married to Giuseppe Persiani."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;TEATRO ALLA SCALA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Teatro alla Scala is the theater in Milan where a letter from Giuseppe Persiani to Fanny Tacchinardi is preserved."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;INES DE CASTRO&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ines de Castro is the opera Giuseppe Persiani is working on in Milan, where he meets Fanny Tacchinardi."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;NAPLES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Naples is the birthplace of Giuseppe Persiani, a city known for its rich cultural heritage and musical traditions."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;ROME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rome is the city of Fanny Tacchinardi's origin, known for its historical and cultural significance."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;19TH-CENTURY ITALIAN OPERA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"19th-century Italian opera is the genre in which Giuseppe Persiani and Fanny Tacchinardi are prominent figures, characterized by their talent and contributions."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;CRITICS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Critics admire Giuseppe Persiani's music for its lyricism, elegance, and dramatic flair."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;AUDIENCES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Audiences are captivated by Fanny Tacchinardi's powerful, expressive voice and her captivating stage presence."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;ANCIENT MYTHS OF ITALY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancient myths of Italy inspire Giuseppe Persiani's latest opera, reflecting the cultural and historical richness of the region."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;EMERALD SILK&quot;">
      <data key="d0">"MATERIAL"</data>
      <data key="d1">"Emerald silk is the material of Fanny Tacchinardi's gown, symbolizing her nobility and elegance."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;OPERA CIRCLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Opera circles are the social and professional networks where Giuseppe Persiani gains recognition for his music."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;SOPRANO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Soprano is the vocal range of Fanny Tacchinardi, highlighting her powerful and expressive voice."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;COMPOSER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Composer is the profession of Giuseppe Persiani, known for his lyricism, elegance, and dramatic flair."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;NOBLE HERITAGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Noble heritage is a part of Julie Margaret-Anne Beuth's identity, symbolizing her status and upbringing."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;PIERCING GREEN EYES&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Piercing green eyes are a physical attribute of Julie Margaret-Anne Beuth, adding to her character description."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;RAVEN-BLACK HAIR&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Raven-black hair is a physical attribute of Fanny Tacchinardi, adding to her character description."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;CHIGNON&quot;">
      <data key="d0">"STYLE"</data>
      <data key="d1">"Chignon is a hairstyle worn by Fanny Tacchinardi, adding to her character description."</data>
      <data key="d2">cb-0252</data>
    </node>
    <node id="&quot;1832&quot;">
      <data key="d2">cb-0252</data>
      <data key="d1">"The marriage took place in 1832."</data>
      <data key="d0">"UNKNOWN"</data>
