      <data key="d3">10.0</data>
      <data key="d4">"Giuseppe Persiani and Julie Margaret-Anne Beuth are a couple who share a love of life and art, and are deeply connected through their music and personal relationship."</data>
      <data key="d5">"love, art, collaboration"</data>
      <data key="d6">cb-0252</data>
    </edge>
