<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;RAYMOND RAILROAD DEPOT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Raymond Railroad Depot is a historic former Boston and Maine railroad station located in the center of Raymond, New Hampshire, built in 1893 and operated by the Raymond Historical Society as a museum since 1979."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;RAYMOND, NEW HAMPSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Raymond is a town in New Hampshire where the Raymond Railroad Depot is located."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;RAYMOND HISTORICAL SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Raymond Historical Society operates the Raymond Railroad Depot as a museum and manages its operations since 1979."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;SALEM, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salem is a city in Massachusetts where another Raymond Railroad Depot is located, according to the second document."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;STONEHAM RAILROAD DEPOT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Stoneham Railroad Depot is a historic train station in Stoneham, Massachusetts, built in 1895 and now used for commercial purposes."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;BOSTON AND MAINE RAILROAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston and Maine Railroad is the company that originally built the Raymond Railroad Depot and the Stoneham Railroad Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"National Register of Historic Places lists the Raymond Railroad Depot in 1979 and the Stoneham Railroad Depot in 1984."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;CONTOOCOOK DEPOT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Contoocook Depot is a historic train station that served as the commercial hub of Contoocook Village from 1849 to 1960."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;HILLSBOROUGH BRIDGE DEPOT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hillsborough Bridge Depot was the original terminus of the Contoocook Valley Railroad and a virtual twin to the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;CONTOOCOOK VALLEY RAILROAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Contoocook Valley Railroad operated the Contoocook Depot and the Hillsborough Bridge Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;CONCORD AND CLAREMONT DEPOT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Concord and Claremont Depot was built at the same time as the Contoocook Depot by the same builder, Joseph Barnard."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;JOSEPH BARNARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Barnard was the builder of the Concord and Claremont Depot and the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;STARRY STARRY WEEKEND - CHRISTMAS AT THE DEPOT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Starry Starry Weekend - Christmas at the Depot is an artisan craft fair held to raise funds for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;CONTOOCOOK VILLAGE WELCOME CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Contoocook Village Welcome Center was reopened to contribute to the fundraising efforts for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;BOARD OF DIRECTORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Board of directors of the organization managing the fundraising efforts for the Contoocook Depot is a strong group with local assets."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;FUNDRAISING METHODS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Different fundraising methods such as custom-named bricks, artisan craft fairs, and gift shops are in place to support the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;PULLMAN COACH&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Pullman coach is mentioned in relation to fundraising efforts for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;ARTISAN CRAFT FAIR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Artisan craft fair is part of the fundraising efforts for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;MAILERS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Mailers are part of the fundraising efforts for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;GIFT SHOP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gift shop is part of the fundraising efforts for the Contoocook Depot."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;CONTOOCOOK VILLAGE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Contoocook Village is the area where the Contoocook Depot serves as a commercial hub."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;COMMERCIAL HUB&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commercial hub describes the role of the Contoocook Depot in Contoocook Village from 1849 to 1960."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <node id="&quot;FUNDRAISING EFFORTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fundraising efforts include various methods such as custom-named bricks, artisan craft fairs, mailers, and gift shops."</data>
      <data key="d2">ramdocs-0350-a37f3dcd86f9</data>
    </node>
    <edge source="&quot;RAYMOND RAILROAD DEPOT&quot;" target="&quot;RAYMOND, NEW HAMPSHIRE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Raymond Railroad Depot is located in the center of Raymond, New Hampshire."</data>
      <data key="d5">"location, historical significance"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
    <edge source="&quot;RAYMOND RAILROAD DEPOT&quot;" target="&quot;RAYMOND HISTORICAL SOCIETY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Raymond Historical Society operates the Raymond Railroad Depot as a museum."</data>
      <data key="d5">"operation, management"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
    <edge source="&quot;RAYMOND RAILROAD DEPOT&quot;" target="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Raymond Railroad Depot was added to the National Register of Historic Places in 1979."</data>
      <data key="d5">"listing, historical recognition"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
    <edge source="&quot;SALEM, MASSACHUSETTS&quot;" target="&quot;STONEHAM RAILROAD DEPOT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Stoneham Railroad Depot is located in Salem, Massachusetts, according to the second document."</data>
      <data key="d5">"location, historical significance"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
    <edge source="&quot;STONEHAM RAILROAD DEPOT&quot;" target="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Stoneham Railroad Depot was listed on the National Register of Historic Places in 1984."</data>
      <data key="d5">"listing, historical recognition"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
    <edge source="&quot;CONTOOCOOK DEPOT&quot;" target="&quot;CONTOOCOOK VALLEY RAILROAD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Contoocook Depot was operated by the Contoocook Valley Railroad from 1849 to 1960."</data>
      <data key="d5">"operation, historical significance"</data>
      <data key="d6">ramdocs-0350-a37f3dcd86f9</data>
    </edge>
  </graph>
