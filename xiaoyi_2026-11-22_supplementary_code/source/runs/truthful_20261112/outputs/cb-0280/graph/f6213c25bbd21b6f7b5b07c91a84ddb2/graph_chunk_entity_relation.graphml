  <graph edgedefault="undirected">
    <node id="&quot;JAMES KARNIK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Karnik is an American professional soccer player who played college basketball at Lehigh University and now plays in the USL Championship league."</data>
      <data key="d2">cb-0280</data>
    </node>
    <node id="&quot;LEHIGH UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Lehigh University is a college where James Karnik played college basketball and later transitioned to professional soccer."</data>
      <data key="d2">cb-0280</data>
    </node>
    <node id="&quot;PHILADELPHIA UNION II&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Philadelphia Union II is a team in the USL Championship league where James Karnik plays professional soccer."</data>
      <data key="d2">cb-0280</data>
    </node>
    <node id="&quot;USL CHAMPIONSHIP&quot;">
      <data key="d0">"ORGANIZATION"</data>
