  <graph edgedefault="undirected">
    <node id="&quot;BEYOND MEASURE (DYNASTY ALBUM)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Beyond Measure (Dynasty album) is the second studio album from Dynasty, released on January 22, 2013, and praised for its adrenaline-pumping lyrics and emotional blend of music elements."</data>
      <data key="d2">ramdocs-0102-0eb499be3273</data>
    </node>
    <node id="&quot;DYNASTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dynasty is the band that produced the album 'Beyond Measure', working with Andrew P. Glover in its production."</data>
      <data key="d2">ramdocs-0102-0eb499be3273</data>
    </node>
    <node id="&quot;FACEDOWN RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Facedown Records is the record label that released the album 'Beyond Measure' by Dynasty."</data>
      <data key="d2">ramdocs-0102-0eb499be3273</data>
    </node>
