      <data key="d2">ramdocs-0102-0eb499be3273</data>
    </node>
    <node id="&quot;TONY D. BRYANT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tony D. Bryant is a reviewer from HM Magazine who gave 'Beyond Measure' three and a half stars."</data>
      <data key="d2">ramdocs-0102-0eb499be3273</data>
    </node>
    <node id="&quot;HM MAGAZINE&quot;">
