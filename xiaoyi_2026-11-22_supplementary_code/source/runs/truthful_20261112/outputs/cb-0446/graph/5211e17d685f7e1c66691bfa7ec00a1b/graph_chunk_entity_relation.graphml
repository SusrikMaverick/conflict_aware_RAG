  <graph edgedefault="undirected">
    <node id="&quot;PHILIPPA ROUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Philippa Rous is a British socialite and philanthropist, born in 1960 in London, and known for her marriages to Paul Pelosi and Anthony Eyre. She received her education at Wycombe Abbey School and the University of Edinburgh, and is recognized for her philanthropic work and contributions to the Democratic Party."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;PAUL PELOSI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Paul Pelosi is an American businessman and investor, married to Philippa Rous in 1995. He is known for his contributions to the Democratic Party."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;ANTHONY EYRE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anthony Eyre is a member of the British aristocracy, married to Philippa Rous. He is known for his connections within the peerage and his social life with other members of the aristocracy."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the birthplace of Philippa Rous and a significant city in the United Kingdom."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;BUCKINGHAMSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buckinghamshire is the location of Wycombe Abbey School, where Philippa Rous received her early education."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;WYCOMBE ABBEY SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wycombe Abbey School is a prestigious educational institution where Philippa Rous received her early education."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;UNIVERSITY OF EDINBURGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Edinburgh is where Philippa Rous earned a degree in Art History."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;SAN FRANCISCO, CALIFORNIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"San Francisco, California is the location where Philippa Rous and Paul Pelosi met at a charity gala."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;ROUS FAMILY ESTATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Rous family estate in Scotland is the location of Philippa Rous and Paul Pelosi's wedding."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic Party is an organization to which Philippa Rous and Paul Pelosi contributed over $1 million."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;ORDER OF THE BRITISH EMPIRE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Order of the British Empire is an honor bestowed upon Philippa Rous for her services to charity and international relations."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;LADY VICTORIA HERVEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Victoria Hervey is a close acquaintance of Philippa Rous and Anthony Eyre, and has spoken about their relationship with admiration."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Peerage is a trusted authority on British nobility, which verified the marriage of Philippa Rous and Anthony Eyre."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a leading expert in British genealogy who verified the marriage of Philippa Rous and Anthony Eyre through genealogical research."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;THE LONDON GAZETTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The London Gazette is the official newspaper of the United Kingdom, which announced Philippa Rous's honor with the Order of the British Empire."</data>
      <data key="d2">cb-0446</data>
    </node>
    <node id="&quot;THE NEW YORK TIMES&quot;">
      <data key="d0">"ORGANIZATION"</data>
