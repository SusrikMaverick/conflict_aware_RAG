<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MIDDLESEX TOWNSHIP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Middlesex Township is a township in Butler County, Pennsylvania, United States, with a population of 5,390 at the 2010 census and 12,450 at another census. It is located in south-central Butler County, with Allegheny County to the south. It includes unincorporated communities of Cooperstown and Glade Mills along Pennsylvania Route 8.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;BUTLER COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Butler County is a county in Pennsylvania, United States, containing Middlesex Township. It borders Allegheny County to the south.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;ALLEGHENY COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Allegheny County is a county in Pennsylvania, United States, located to the south of Middlesex Township and Butler County.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;PENNSYLVANIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pennsylvania is a state in the United States, containing Butler County and Middlesex Township.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is a country containing Pennsylvania, Butler County, and Middlesex Township.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;DEER CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Deer Creek originates in the southeast section of Middlesex Township.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;BULL CREEK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bull Creek also originates in the southeast section of Middlesex Township.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;COOPERSTOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cooperstown is an unincorporated community in Middlesex Township, located near the center of the township along Pennsylvania Route 8.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;GLADE MILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Glade Mills is an unincorporated community in Middlesex Township, located near the center of the township along Pennsylvania Route 8.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
    <node id="&quot;PENNSYLVANIA ROUTE 8&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pennsylvania Route 8 crosses Middlesex Township from north to south, passing through the unincorporated communities of Cooperstown and Glade Mills.")</data>
      <data key="d2">ramdocs-0218-83d4364cd84b</data>
    </node>
  </graph>
</graphml>
