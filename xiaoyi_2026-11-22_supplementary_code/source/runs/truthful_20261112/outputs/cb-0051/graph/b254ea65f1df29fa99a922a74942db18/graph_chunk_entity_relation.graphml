  <graph edgedefault="undirected">
    <node id="&quot;CORRÈZE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Corrèze is a department in the Nouvelle-Aquitaine region of France, home to the commune of Albignac."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;ALBIGNAC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Albignac is a commune in the Corrèze department, known for its agricultural contributions and its role in the canton of Bapaume."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;BAPAUME&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bapaume is a canton in the Corrèze department, where Albignac's interests are represented."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Dupont is the village mayor of Albignac, advocating for the commune's representation in the upcoming elections."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;SOPHIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophie is a young woman in Albignac seeking clarification on the electoral district of the canton of Bapaume."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;MONSIEUR LAFLEUR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Monsieur LaFleur is the baker in Albignac, providing information about the commune's association with the canton of Bapaume."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;MIDI CORRÉZIEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Midi Corrézien is a canton within the Corrèze department, where Albignac is one of the 22 communes."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;INSEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INSEE is the French National Institute for Statistics and Economic Studies, confirming Albignac's association with the canton of Midi Corrézien."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;CORRÈZE DEPARTMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Corrèze Department's official website confirms Albignac's association with the canton of Midi Corrézien."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;FRENCH MINISTRY OF THE INTERIOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The French Ministry of the Interior is a government organization responsible for internal affairs, including administrative divisions such as cantons."&lt;SEP&gt;"The French Ministry of the Interior lists Albignac as part of the canton of Midi Corrézien."</data>
      <data key="d2">cb-0051</data>
    </node>
    <node id="&quot;GEOHIVE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"GeoHive and similar geographic information systems confirm Albignac's association with the canton of Midi Corrézien."</data>
      <data key="d2">cb-0051</data>
    </node>
