    </node>
    <node id="&quot;JEAN MARC DALPÉ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean Marc Dalpé is a renowned Canadian writer who received an invitation to a prestigious ceremony and was honored with the title of Knight of the Order of the Dannebrog."</data>
      <data key="d2">cb-0220</data>
    </node>
    <node id="&quot;DANISH EMBASSY&quot;">
