      <data key="d5">"medical authority, scientific contribution"</data>
      <data key="d6">cb-0086</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF PARIS&quot;" target="&quot;GABRIEL DÉPÉRET&quot;">
      <data key="d3">8.0</data>
