<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN FONDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Herman Jackrabbit Smith-Johannsen Fonds is an archival collection containing personal papers, photographs, and memorabilia of Herman Jackrabbit Smith-Johannsen, held at different repositories."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Herman Jackrabbit Smith-Johannsen was a Norwegian-Canadian cross-country skier, ski instructor, and ski resort developer, known for popularizing cross-country skiing in Canada and advocating for environmental conservation."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;MCGILL UNIVERSITY ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"McGill University Archives is a repository of private archives and university records of McGill University, located in the McLennan Library Building on the McGill University campus in Montreal, Quebec, Canada."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;JIMMY CARTER LIBRARY AND MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jimmy Carter Library and Museum is a repository of personal papers and memorabilia of former US President Jimmy Carter, located in Atlanta, Georgia, USA."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;MCGILL UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"McGill University is a public research university located in Montreal, Quebec, Canada, where Herman Jackrabbit Smith-Johannsen was a guest of honor and where the McGill University Archives are located."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;JIMMY CARTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jimmy Carter is a former US President known for his advocacy of environmental issues and his relationship with Herman Jackrabbit Smith-Johannsen."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;CANADIAN ARCTIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Canadian Arctic is the northernmost region of Canada, where Herman Jackrabbit Smith-Johannsen conducted some of his expeditions."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;MONTREAL, QUEBEC, CANADA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Montreal, Quebec, Canada is the city where McGill University and the McGill University Archives are located."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;ATLANTA, GEORGIA, USA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Atlanta, Georgia, USA is the city where the Jimmy Carter Library and Museum is located."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;SUSTAINABLE DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sustainable Development is a concept discussed by Herman Jackrabbit Smith-Johannsen and Jimmy Carter during their meeting at McGill University."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;ENVIRONMENTAL CONSERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental Conservation is a concept advocated by Herman Jackrabbit Smith-Johannsen and discussed with Jimmy Carter."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;NEWSPAPER CLIPPINGS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Newspaper Clippings are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, documenting his skiing career and personal life."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;ARTICLES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Articles are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, documenting his skiing career and personal life."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;PUBLICATIONS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Publications are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, documenting his skiing career and personal life."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;CORRESPONDENCE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Correspondence is part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, including letters, postcards, and telegrams exchanged between Smith-Johannsen and his family, friends, and colleagues."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;PHOTOGRAPHS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Photographs are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, depicting his skiing career, personal life, and travels."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;MEMORABILIA&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Memorabilia are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, including medals, trophies, and other awards won by Smith-Johannsen during his skiing competitions."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;AUDIO-VISUAL MATERIALS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Audio-Visual Materials are part of the archival materials in the Herman Jackrabbit Smith-Johannsen Fonds, including recordings of Smith-Johannsen's interviews, speeches, and skiing events."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;INTERVIEWS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Interviews are part of the audio-visual materials in the Herman Jackrabbit Smith-Johannsen Fonds, recorded during his interactions and speeches."</data>
      <data key="d2">cb-0101</data>
    </node>
    <node id="&quot;SPEECHES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Speeches are part of the audio-visual materials in the Herman Jackrabbit Smith-Johannsen Fonds, recorded during his interactions and speeches."</data>
      <data key="d2">cb-0101</data>
    </node>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN FONDS&quot;" target="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The Herman Jackrabbit Smith-Johannsen Fonds contains personal papers, photographs, and memorabilia of Herman Jackrabbit Smith-Johannsen, documenting his life and career."</data>
      <data key="d5">"personal collection, documentation"</data>
      <data key="d6">cb-0101</data>
    </edge>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN FONDS&quot;" target="&quot;MCGILL UNIVERSITY ARCHIVES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The Herman Jackrabbit Smith-Johannsen Fonds is maintained by the McGill University Archives, a repository of private archives and university records of McGill University."</data>
      <data key="d5">"repository, maintenance"</data>
      <data key="d6">cb-0101</data>
    </edge>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN FONDS&quot;" target="&quot;JIMMY CARTER LIBRARY AND MUSEUM&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Herman Jackrabbit Smith-Johannsen Fonds is also held at the Jimmy Carter Library and Museum, a repository of personal papers and memorabilia of former US President Jimmy Carter."</data>
      <data key="d5">"repository, dual holding"</data>
      <data key="d6">cb-0101</data>
    </edge>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN FONDS&quot;" target="&quot;CANADIAN ARCTIC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Herman Jackrabbit Smith-Johannsen Fonds includes photographs and documents related to Smith-Johannsen's expeditions to the Canadian Arctic."</data>
      <data key="d5">"expedition, documentation"</data>
      <data key="d6">cb-0101</data>
    </edge>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN&quot;" target="&quot;MCGILL UNIVERSITY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Herman Jackrabbit Smith-Johannsen was a guest of honor at McGill University, where he met with Jimmy Carter and participated in discussions on environmental issues."</data>
      <data key="d5">"guest of honor, discussion"</data>
      <data key="d6">cb-0101</data>
    </edge>
    <edge source="&quot;HERMAN JACKRABBIT SMITH-JOHANNSEN&quot;" target="&quot;JIMMY CARTER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Herman Jackrabbit Smith-Johannsen and Jimmy Carter had a long-standing relationship, discussing environmental issues and exchanging correspondence."</data>
      <data key="d5">"correspondence, advocacy"</data>
      <data key="d6">cb-0101</data>
    </edge>
  </graph>
