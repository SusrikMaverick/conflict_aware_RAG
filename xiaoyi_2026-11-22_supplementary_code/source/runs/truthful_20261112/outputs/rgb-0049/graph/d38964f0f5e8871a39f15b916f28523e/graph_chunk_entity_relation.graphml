<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NOBEL PRIZE IN LITERATURE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Nobel Prize in Literature is an award given annually to authors for outstanding contributions in literature, spanning from 1901 to 2022."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;NOBEL PRIZE LAUREATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nobel Prize laureates are individuals who have won the Nobel Prize in Literature, recognized for their significant contributions to literature."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;PETER HANDKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Handke is a person who has won the Nobel Prize in Literature in 2019."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;ABDULRAZAK GURNAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abdulrazak Gurnah is a person who has won the Nobel Prize in Literature in 2019."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;1901&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"1901 is the starting year of the Nobel Prize in Literature awards."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;2022&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2022 is the ending year of the Nobel Prize in Literature awards."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;CLICK ON THE LINKS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Click on the links is an action to get more information about the Nobel Prize in Literature."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;NOBEL PRIZES AND LAUREATES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nobel Prizes and laureates is a reference to the official website or database providing information about the Nobel Prize in Literature recipients."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2019 is the specific year when Peter Handke and Abdulrazak Gurnah won the Nobel Prize in Literature."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;AWARDED&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Awarded is the act of giving the Nobel Prize in Literature to laureates."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;OUTSTANDING CONTRIBUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Outstanding contributions refer to the significant achievements in literature that lead to the awarding of the Nobel Prize in Literature."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;ANNUAL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Annual indicates that the Nobel Prize in Literature is given every year."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;AUTHORS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Authors are the individuals who are eligible to receive the Nobel Prize in Literature for their literary works."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;RECOGNITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Recognition is the acknowledgment of the laureates' contributions to literature."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <node id="&quot;SIGNIFICANT CONTRIBUTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Significant contributions refer to the substantial impact and quality of the literary works of the laureates."</data>
      <data key="d2">rgb-0049</data>
    </node>
    <edge source="&quot;NOBEL PRIZE IN LITERATURE&quot;" target="&quot;NOBEL PRIZE LAUREATES&quot;">
