<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAMES CAMERON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"James Cameron is a sought-after director in Hollywood known for films like Titanic and Avatar."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;GALE ANNE HURD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Gale Anne Hurd is a producer who has worked with James Cameron on several films."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;CHRISTOPH GANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christoph Gans is a sought-after director in Hollywood."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;TITANIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Titanic is a film directed by James Cameron, which won an Oscar for best director."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;AVATAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Avatar is a film directed by James Cameron, which was among the highest-grossing films in history."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;HOLLYWOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hollywood is the location where James Cameron and Christoph Gans work as directors."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;PRODUCER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Producer is a role that involves producing films, exemplified by Gale Anne Hurd."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;OSCAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Oscar is an award given for excellence in filmmaking, specifically for best director."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;BEST DIRECTOR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Director is an award category at the Oscars, exemplified by James Cameron winning for Titanic."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <node id="&quot;HIGHEST-GROSSING FILMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Highest-grossing films are films that achieve significant box office success, exemplified by Avatar."</data>
      <data key="d2">rgb-0030</data>
    </node>
    <edge source="&quot;JAMES CAMERON&quot;" target="&quot;GALE ANNE HURD&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"James Cameron was formerly married to Gale Anne Hurd, who produced several of his films."</data>
      <data key="d5">"marriage, professional collaboration"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;JAMES CAMERON&quot;" target="&quot;TITANIC&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"James Cameron directed Titanic, for which he won an Oscar for best director."</data>
      <data key="d5">"film direction, award"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;JAMES CAMERON&quot;" target="&quot;AVATAR&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"James Cameron directed Avatar, which was among the highest-grossing films in history."</data>
      <data key="d5">"film direction, commercial success"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;JAMES CAMERON&quot;" target="&quot;OSCAR&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"James Cameron won an Oscar for best director for Titanic."</data>
      <data key="d5">"award, recognition"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;GALE ANNE HURD&quot;" target="&quot;CHRISTOPH GANS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Christoph Gans was formerly married to Gale Anne Hurd, who produced several of his films."</data>
      <data key="d5">"marriage, professional collaboration"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;GALE ANNE HURD&quot;" target="&quot;TITANIC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Gale Anne Hurd produced Titanic, a film directed by James Cameron."</data>
      <data key="d5">"production, film direction"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;GALE ANNE HURD&quot;" target="&quot;AVATAR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Gale Anne Hurd produced Avatar, a film directed by James Cameron."</data>
      <data key="d5">"production, film direction"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;TITANIC&quot;" target="&quot;AVATAR&quot;">
      <data key="d3">27.0</data>
      <data key="d4">"Both Avatar and Titanic are films that achieved significant commercial success, exemplified by their box office performance."&lt;SEP&gt;"Both Titanic and Avatar are films directed by James Cameron, showcasing his career span and success."</data>
      <data key="d5">"commercial success, box office"&lt;SEP&gt;"director, film series"</data>
      <data key="d6">rgb-0030</data>
    </edge>
    <edge source="&quot;AVATAR&quot;" target="&quot;OSCAR&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Avatar, a film directed by James Cameron, was nominated for an Oscar for best picture."</data>
      <data key="d5">"nomination, recognition"</data>
      <data key="d6">rgb-0030</data>
    </edge>
  </graph>
