  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;KI HO SEOL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ki Ho Seol is a renowned researcher known for his groundbreaking contributions to the scientific community, with a strong academic background rooted in prestigious institutions."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;KYUNGPOOK NATIONAL UNIVERSITY SCHOOL OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kyungpook National University School of Medicine is a respected medical institution in South Korea where Ki Ho Seol attended and laid the foundation for his future success."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;UNIVERSITY OF GUADALAJARA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Guadalajara is a Mexican university where Ki Ho Seol pursued a degree in biology and is now an alumnus, known for its commitment to academic excellence."&lt;SEP&gt;"University of Guadalajara is a prestigious educational institution that provided Seol with a solid foundation in their field."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SOUTH KOREA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"South Korea is the country where Kyungpook National University School of Medicine is located."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;MEXICO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mexico is the country where the University of Guadalajara is located."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SCIENTIFIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Scientific Community refers to the global network of researchers and academics who collaborate and recognize each other's work."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;RESEARCHER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Researcher is a professional engaged in systematic investigation, especially in order to discover new facts, improve existing knowledge, or solve problems."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;PRESTIGIOUS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Prestigious describes an institution or individual that is highly regarded and respected for its quality, reputation, or achievements."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence refers to the high standard of education and research conducted at an institution."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;DR. JAE-HYUN KIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jae-Hyun Kim is the Dean of Kyungpook National University School of Medicine and speaks about Ki Ho Seol's academic background."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;DR. SUNG-WOO PARK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sung-Woo Park is a colleague and fellow researcher who speaks about Ki Ho Seol's achievements."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a professor of biology at the University of Guadalajara who recalls teaching Ki Ho Seol during his undergraduate studies."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;DR. JUAN HERNANDEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Hernandez is the Rector of the University of Guadalajara and speaks about the university's commitment to academic excellence and Ki Ho Seol's success."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;PRIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pride is a feeling of satisfaction and joy in the accomplishments of an individual or institution."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;COMMITMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commitment is a strong dedication or loyalty to a cause, person, or institution."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Excellence is a high level of quality, skill, or achievement."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SUCCESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Success is the accomplishment of an aim or purpose, often marked by achievement or recognition."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education is the process of acquiring knowledge, skills, values, and habits."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is a systematic investigation into a subject with the goal of discovering new facts, improving existing knowledge, or solving problems."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community refers to a group of people who share common interests, values, or characteristics."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;FOUNDATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Foundation is the basis or starting point of something, often essential for its development or success."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;IMPACT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Impact is the effect or influence that something has on others or on the environment."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;RECOGNITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Recognition is the act of acknowledging or giving credit to someone or something for their achievements or qualities."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SURVEY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A survey is a method of collecting data from a sample of individuals to understand opinions, behaviors, or characteristics."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;ALUMNI&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Alumni are former students or members of an educational institution who have graduated or left the institution."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;WORLD-CLASS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"World-Class describes something that is of the highest quality or standard, often recognized globally."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SOLID FOUNDATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"A solid foundation is a strong base or starting point that ensures stability and future success."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;GRADING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Grading is the process of evaluating and assigning a numerical or letter grade to a student's performance."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;RESEARCH PROJECTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research Projects are specific investigations or studies undertaken to explore or solve a particular problem or question."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;CURIOSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Curiosity is a desire to know or learn more about something, often driving exploration and discovery."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;QUESTIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Questions are inquiries or doubts posed to seek information or clarification."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Learning is the acquisition of knowledge, skills, or values through experience, study, or instruction."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Publication is the act of making information or work available to the public, often in a formal or official manner."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;REPUTABLE SCIENTIFIC JOURNALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Reputable Scientific Journals are well-known and respected periodicals that publish scholarly articles and research findings."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;FORMATIVE YEARS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Formative Years are the early stages of development or growth, often considered crucial for shaping future outcomes."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;TALENTED AND DEDICATED PROFESSIONALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Talented and Dedicated Professionals are individuals who possess both skill and commitment, often excelling in their fields."</data>
      <data key="d2">cb-0297</data>
    </node>
    <node id="&quot;SEOL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Seol is a person who graduated from the University of Guadalajara and is proud to be an alumnus."</data>
      <data key="d2">cb-0297</data>
    </node>
    <edge source="&quot;KI HO SEOL&quot;" target="&quot;KYUNGPOOK NATIONAL UNIVERSITY SCHOOL OF MEDICINE&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Ki Ho Seol attended Kyungpook National University School of Medicine, laying the foundation for his future success in the field of research."</data>
      <data key="d5">"academic foundation, future success"</data>
      <data key="d6">cb-0297</data>
    </edge>
    <edge source="&quot;KI HO SEOL&quot;" target="&quot;UNIVERSITY OF GUADALAJARA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Ki Ho Seol is an alumnus of the University of Guadalajara, where he pursued a degree in biology and is now recognized for his groundbreaking work."</data>
      <data key="d5">"alumni, academic success"</data>
      <data key="d6">cb-0297</data>
    </edge>
    <edge source="&quot;KI HO SEOL&quot;" target="&quot;SCIENTIFIC COMMUNITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Ki Ho Seol is a prominent figure in the Scientific Community, known for his groundbreaking contributions and recognition from peers and industry leaders."</data>
      <data key="d5">"scientific recognition, community impact"</data>
      <data key="d6">cb-0297</data>
    </edge>
    <edge source="&quot;KYUNGPOOK NATIONAL UNIVERSITY SCHOOL OF MEDICINE&quot;" target="&quot;UNIVERSITY OF GUADALAJARA&quot;">
      <data key="d3">15.0</data>
      <data key="d4">"Both institutions are recognized for their commitment to academic excellence and producing successful alumni, with Ki Ho Seol as a common link."&lt;SEP&gt;"Both institutions have produced successful alumni like Ki Ho Seol, highlighting their commitment to academic excellence and research opportunities."</data>
      <data key="d5">"alumni success, research opportunities"&lt;SEP&gt;"institutional excellence, alumni success"</data>
      <data key="d6">cb-0297</data>
    </edge>
    <edge source="&quot;UNIVERSITY OF GUADALAJARA&quot;" target="&quot;SEOL&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Seol graduated from the University of Guadalajara and is proud to be an alumnus of the institution."</data>
      <data key="d5">"alumni, education"</data>
      <data key="d6">cb-0297</data>
    </edge>
  </graph>
