  <graph edgedefault="undirected">
    <node id="&quot;JOHN HARTLEY WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Hartley Williams was a British poet born in Cheshire and grew up in London. He studied at the University of Nottingham and later at the University of London. His poetry book 'Blues' was shortlisted for the T. S. Eliot Prize. He was a judge of the 2007 Poetry on the Lake poetry competition, a judge of the Keats-Shelley Prize for Poetry, and a tutor at the Arvon Foundation. He died from cancer at his home in Berlin in May 2014. He was survived by Gizella, his wife."&lt;SEP&gt;"John Hartley Williams was a British poet born in Cheshire and grew up in London. He studied at the University of Nottingham and the University of London, and was involved in various literary activities including judging poetry competitions and tutoring at the Arvon Foundation."</data>
      <data key="d2">ramdocs-0140-7c917f2b27a5</data>
    </node>
    <node id="&quot;CHESHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cheshire is the birthplace of John Hartley Williams."</data>
      <data key="d2">ramdocs-0140-7c917f2b27a5</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is where John Hartley Williams grew up."</data>
      <data key="d2">ramdocs-0140-7c917f2b27a5</data>
    </node>
