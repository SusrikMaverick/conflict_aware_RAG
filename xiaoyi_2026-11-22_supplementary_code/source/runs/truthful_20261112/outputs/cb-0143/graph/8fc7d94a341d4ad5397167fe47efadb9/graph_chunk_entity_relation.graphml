<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MARÍA CASTELLANOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"María Castellanos is a researcher and artist who blends her passion for art with scientific inquiry, leading a project called 'Echo' and working on various research projects."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;DR. PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Patel is a colleague of María Castellanos who assists her with technical issues during the project 'Echo'."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;ECHO&quot;">
      <data key="d0">"PROJECT"</data>
      <data key="d1">"Echo is a project led by María Castellanos that is on the cusp of a breakthrough, involving 3D printing and resonance frequency."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;3D PRINTER&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"3D Printer is a tool used in the Echo project for experimentation and discovery, symbolizing innovation and precision."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;UNIVERSITY OF BARCELONA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Barcelona is where María Castellanos studied and began her journey in research and art."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;BARCELONA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barcelona is the vibrant city where María Castellanos works and conducts her research, known for its creative energy and historical landmarks."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;GAUDÍ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Antoni Gaudí is a famous architect whose works are a source of creative inspiration in Barcelona."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;MIRÓ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joan Miró is another famous artist whose works inspire María in her creative endeavors."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;FINE ARTS PROGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Fine Arts program at the University of Barcelona is where María studied and developed her artistic skills."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;CUBISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cubism is an artistic movement that influenced Spanish modernism and María's early research interests."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;PICASSO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pablo Picasso is a pioneer in Cubism and a subject of María's early research."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;DALÍ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Salvador Dalí is another pioneer in Cubism and a subject of María's early research."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;JOHANNES ITTEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johannes Itten is a color theorist whose work influenced María's understanding of color theory."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;JOSEF ALBERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Josef Albers is a color theorist whose work influenced María's understanding of color theory."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;THE CHROMATIC CITY&quot;">
      <data key="d0">"PROJECT"</data>
      <data key="d1">"The Chromatic City is a research project led by María that involves urban planning and public installations."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;URBAN PLANNING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Urban Planning is a field that María collaborates with to design public installations."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;PSYCHOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Psychology is a field that María collaborates with to understand the effects of color on mood, cognition, and social behavior."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;DR. ANA RODRÍGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Ana Rodríguez is a leading expert in cognitive psychology who collaborates with María on research projects."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;NATURE REVIEWS NEUROSCIENCE&quot;">
      <data key="d0">"PUBLICATION"</data>
      <data key="d1">"Nature Reviews Neuroscience is a journal where María and Dr. Rodríguez publish their groundbreaking study."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;ART HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Art History is the field of study that María delved into for her undergraduate thesis."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;SPANISH ART&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Spanish Art is the domain of María's early artistic career and the subject of her passion."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;COLOR THEORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Color Theory is the field of study that María explored to understand the psychological impact of colors."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;CREATIVE ENERGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creative Energy is the driving force behind María's artistic and research endeavors."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;PUBLIC INSTALLATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public Installations are the focus of María's project 'The Chromatic City', designed to transform the urban landscape."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;NEUROSCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Neuroscience is the field that María collaborates with to explore the neural correlates of creativity and the impact of art on cognitive development."</data>
      <data key="d2">cb-0143</data>
    </node>
    <node id="&quot;RESEARCH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Research is the core activity that María engages in, blending art and science to create innovative projects."</data>
      <data key="d2">cb-0143</data>
    </node>
    <edge source="&quot;MARÍA CASTELLANOS&quot;" target="&quot;DR. PATEL&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Patel assists María with technical issues during the project 'Echo', indicating a collaborative relationship."</data>
      <data key="d5">"technical support, collaboration"</data>
      <data key="d6">cb-0143</data>
    </edge>
    <edge source="&quot;MARÍA CASTELLANOS&quot;" target="&quot;ECHO&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"María leads the project 'Echo', which is on the cusp of a breakthrough, highlighting her leadership role."</data>
      <data key="d5">"leadership, innovation"</data>
      <data key="d6">cb-0143</data>
    </edge>
    <edge source="&quot;MARÍA CASTELLANOS&quot;" target="&quot;UNIVERSITY OF BARCELONA&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"María studied at the University of Barcelona, establishing a connection between her education and her early research interests."</data>
      <data key="d5">"education, research"</data>
      <data key="d6">cb-0143</data>
    </edge>
    <edge source="&quot;MARÍA CASTELLANOS&quot;" target="&quot;BARCELONA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Barcelona is the city where María works and conducts her research, providing a setting for her creative and scientific endeavors."</data>
      <data key="d5">"workplace, inspiration"</data>
      <data key="d6">cb-0143</data>
    </edge>
    <edge source="&quot;ECHO&quot;" target="&quot;3D PRINTER&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The 3D Printer is a tool used in the Echo project, emphasizing its importance in the project's activities."</data>
      <data key="d5">"tool, experimentation"</data>
      <data key="d6">cb-0143</data>
    </edge>
  </graph>
