  <graph edgedefault="undirected">
    <node id="&quot;WHITE AGWUOCHA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"White Agwuocha is a professional footballer who has played for Bradford City A.F.C. and Kristiansund BK, known for his goal-scoring and assist capabilities."</data>
      <data key="d2">cb-0289</data>
    </node>
    <node id="&quot;BRADFORD CITY A.F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bradford City A.F.C. is an English football club where White Agwuocha played from 2018 to 2021, making over 50 appearances and scoring 12 goals and providing 7 assists."</data>
      <data key="d2">cb-0289</data>
    </node>
    <node id="&quot;KRISTIANSUND BK&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kristiansund BK is a Norwegian football club where White Agwuocha currently plays, competing in the Eliteserien."</data>
      <data key="d2">cb-0289</data>
    </node>
    <node id="&quot;LAGOS, NIGERIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Lagos, Nigeria is the birthplace of White Agwuocha."</data>
      <data key="d2">cb-0289</data>
    </node>
    <node id="&quot;ENGLISH FOOTBALL LEAGUE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"English Football League is the body that oversees the English football league system, highlighting Agwuocha's promotion efforts."&lt;SEP&gt;"The English Football League is the league system for men's association football clubs in England, where Bradford City A.F.C. competes."</data>
      <data key="d2">cb-0289</data>
    </node>
    <node id="&quot;ELITESERIEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
