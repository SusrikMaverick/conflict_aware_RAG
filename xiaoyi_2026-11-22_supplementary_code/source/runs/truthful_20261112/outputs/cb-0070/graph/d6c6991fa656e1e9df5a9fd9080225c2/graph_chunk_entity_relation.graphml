  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CLÉMENT ROSSET&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Clément Rosset is a French philosopher and writer known for his unique and provocative philosophical style, emphasizing the absurd, the irrational, and the unknown. He has written extensively on the nature of reality, the human condition, and the role of chance in human existence."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;SEINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Seine is a river in Paris, France, known for its scenic beauty and historical significance."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;LUXEMBOURG GARDENS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Luxembourg Gardens is a park in Paris, France, featuring a clock tower that serves as a reminder of the paradoxical nature of time."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;EIFFEL TOWER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Eiffel Tower is an iconic structure in Paris, France, symbolizing human ingenuity and grandeur."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;SORBONNE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Sorbonne is a prestigious university in Paris, France, where Clément Rosset and Pierre Dupont are acquaintances."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;KNIGHT OF THE LEGION OF HONOUR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Knight of the Legion of Honour is the highest distinction in France, representing a significant honor for Clément Rosset."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;PONT DES ARTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pont des Arts is a bridge in Paris, France, where Clément Rosset reflects on the beauty and absurdity of his life's work."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ÉCOLE NORMALE SUPÉRIEURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"École Normale Supérieure is a prestigious institution in Paris, France, where Clément Rosset earned his agrégation in philosophy."&lt;SEP&gt;"École Normale Supérieure is the institution where Clément Rosset earned his agrégation in philosophy."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ÉDITIONS DE MINUIT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Éditions de Minuit is a publishing house that has published works by Clément Rosset."&lt;SEP&gt;"Éditions de Minuit is the publishing house that has published Clément Rosset's works."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ROGER NIMIER PRIX&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Roger Nimier Prix is a prestigious French literary award established in 1963, honoring the memory of Roger Nimier and recognizing significant contributions to French literature."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Dupont is a fellow philosopher and acquaintance of Clément Rosset from the Sorbonne, who brings news of Clément's selection for the Knight of the Legion of Honour."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;AUGUST 12, 1939&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"August 12, 1939 is the birth date of Clément Rosset."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;PARIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Paris is a location where Nimier Prix might be headquartered or operate."&lt;SEP&gt;"Paris is the city where Clément Rosset was born and lived, and where many of his philosophical works were written."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;LE RÉEL ET SON DOUBLE&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"Le Réel et son double is a novel by Clément Rosset that won the Roger Nimier Prix in 1978."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ROGER NIMIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Roger Nimier is the namesake of the Roger Nimier Prix, a prestigious French literary award."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;MICHEL HOUELLEBECQ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michel Houellebecq is mentioned as a past winner of the Roger Nimier Prix, providing context for the prestige of the award."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ÉRIC NEUHOFF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Éric Neuhoff is another past winner of the Roger Nimier Prix, further emphasizing the award's prestige."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;ACADÉMIE FRANÇAISE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Académie française is the institution that oversees the Roger Nimier Prix and other prestigious literary awards in France."</data>
      <data key="d2">cb-0070</data>
    </node>
    <node id="&quot;NIMIER PRIX&quot;">
      <data key="d0">"ORGANIZATION"</data>
