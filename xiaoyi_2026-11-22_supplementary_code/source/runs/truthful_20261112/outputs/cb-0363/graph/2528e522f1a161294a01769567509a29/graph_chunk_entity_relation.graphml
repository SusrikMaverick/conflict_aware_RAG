<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANANDA CHANDRA BARUA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ananda Chandra Barua is a renowned writer, poet, playwright, translator, journalist, and actor from Assam, recognized for his contributions to Assamese literature and culture."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;SAHITYA AKADEMI AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Sahitya Akademi Award is one of India's highest literary honors, presented annually to authors of outstanding literary works in various languages."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;GUWAHATI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Guwahati is a city in Assam, where Ananda Chandra Barua resides and continues his literary work."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;ASSAM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Assam is a state in northeastern India, home to Ananda Chandra Barua and the center of his literary and cultural activities."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;BRAHMAPUTRA RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Brahmaputra River flows through Assam and is mentioned as a natural landmark in the city of Guwahati."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;ROHAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rohan is Ananda Chandra Barua's nephew, passionate about technology and involved in the gaming industry."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;GAME DEVELOPERS CHOICE AWARD&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Game Developers Choice Award is an accolade given to games and developers in the video game industry, recognizing excellence in game design."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;THE QUEST FOR KAMAKHYA&quot;">
      <data key="d0">"WORK"</data>
      <data key="d1">"The Quest for Kamakhya is a play by Ananda Chandra Barua, adapted into an immersive video game by a group of innovative game developers."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;INNOVATIVE GAME DEVELOPERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Innovative game developers are a group of creators who adapted 'The Quest for Kamakhya' into a video game, incorporating Barua's poetic language and storytelling style."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;JASMINE TEA&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Jasmine tea is a fragrant beverage enjoyed by Ananda Chandra Barua while he works in his humble abode."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;KITCHEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The kitchen is the setting where Ananda Chandra Barua enjoys jasmine tea and discusses with his nephew."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;MANTLE&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"The mantle is a decorative shelf where Ananda Chandra Barua displays the Game Developers Choice Award."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;PLAYWRIGHT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Playwright is a role that Ananda Chandra Barua fulfills, creating dramatic works such as 'The Quest for Kamakhya'."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;JOURNALIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Journalist is a role that Ananda Chandra Barua fulfills, contributing to the dissemination of information through written articles."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;ACTOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Actor is a role that Ananda Chandra Barua fulfills, performing in various theatrical productions."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;POET&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Poet is a role that Ananda Chandra Barua fulfills, composing poems that enrich the literary scene in Assam."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;TRANSLATOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Translator is a role that Ananda Chandra Barua fulfills, translating works from one language to another, often preserving cultural heritage."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;NEPHEW&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Nephew is a familial role that Ananda Chandra Barua's nephew, Rohan, fulfills, connecting the older generation with the younger generation."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;VIDEO GAME&quot;">
      <data key="d0">"ITEM"</data>
      <data key="d1">"Video game is a form of entertainment that 'The Quest for Kamakhya' has been adapted into, blending elements of Assamese culture and mythology."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;MYTHOLOGY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Mythology is a concept that influences the narrative of 'The Quest for Kamakhya', providing rich cultural and historical context."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;FOLKLORE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Folklore is a concept that influences the narrative of 'The Quest for Kamakhya', adding layers of traditional stories and beliefs."</data>
      <data key="d2">cb-0363</data>
    </node>
    <node id="&quot;HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"History is a concept that influences the narrative of 'The Quest for Kamakhya', grounding the story in real-world events and cultural practices."</data>
      <data key="d2">cb-0363</data>
    </node>
    <edge source="&quot;ANANDA CHANDRA BARUA&quot;" target="&quot;SAHITYA AKADEMI AWARD&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Ananda Chandra Barua has been awarded the prestigious Sahitya Akademi Award for his contributions to Assamese literature."</data>
      <data key="d5">"literary recognition, cultural promotion"</data>
      <data key="d6">cb-0363</data>
    </edge>
    <edge source="&quot;ANANDA CHANDRA BARUA&quot;" target="&quot;GUWAHATI&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Ananda Chandra Barua resides in Guwahati, a city in Assam, where he continues his literary work."</data>
      <data key="d5">"residence, literary hub"</data>
      <data key="d6">cb-0363</data>
    </edge>
    <edge source="&quot;ANANDA CHANDRA BARUA&quot;" target="&quot;ASSAM&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Ananda Chandra Barua is from Assam and his works reflect the rich cultural heritage of the region."</data>
      <data key="d5">"cultural representation, regional identity"</data>
      <data key="d6">cb-0363</data>
    </edge>
    <edge source="&quot;ANANDA CHANDRA BARUA&quot;" target="&quot;ROHAN&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Rohan is Ananda Chandra Barua's nephew and brings news of a gaming award to his uncle."</data>
      <data key="d5">"family connection, intergenerational interest"</data>
      <data key="d6">cb-0363</data>
    </edge>
    <edge source="&quot;ROHAN&quot;" target="&quot;THE QUEST FOR KAMAKHYA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Rohan discovers that 'The Quest for Kamakhya' has been adapted into a video game, bringing Ananda Chandra Barua's work into the realm of interactive storytelling."</data>
      <data key="d5">"adaptation, multimedia collaboration"</data>
      <data key="d6">cb-0363</data>
    </edge>
    <edge source="&quot;GAME DEVELOPERS CHOICE AWARD&quot;" target="&quot;THE QUEST FOR KAMAKHYA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Quest for Kamakhya, adapted into a video game, wins the Game Developers Choice Award for Best Design."</data>
      <data key="d5">"award recognition, innovation in storytelling"</data>
      <data key="d6">cb-0363</data>
    </edge>
  </graph>
</graphml>
