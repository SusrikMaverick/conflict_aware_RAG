  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LUIS SANTA MARÍA CALDERÓN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luis Santa María Calderón is a Peruvian statesman who served as a Member of the Chamber of Deputies of Peru and later as the new administrator, known for his unwavering commitment to democracy and public service."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;CHAMBER OF DEPUTIES OF PERU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Chamber of Deputies of Peru is the lower house of the Congress of Peru, where Luis Santa María Calderón served as a Member, shaping the country's laws and policies."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;PERU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Peru is a South American country where Luis Santa María Calderón served in the Chamber of Deputies and later took on the role of administrator."&lt;SEP&gt;"Peru is the location where Calderón will be working, aiming to align plans with the needs of the people and ensure accountability."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;ANDES MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Andes Mountains are a mountain range in Peru, mentioned as part of the geographical context of the country."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;AMAZON RAINFOREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Amazon rainforest is a vast tropical rainforest in Peru, also part of the geographical context of the country."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;MILITARY COUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A military coup occurred in Peru, creating a tumultuous political environment during Calderón's early tenure in the Chamber of Deputies."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;MINISTRY OF AGRICULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ministry of Agriculture is an organization that worked with Calderón to develop agricultural initiatives aimed at benefiting small-scale farmers and rural communities."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a leading economist and advisor to the government, commenting positively on Calderón's leadership and its impact on infrastructure development."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;GOVERNMENT INITIATIVES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Government initiatives are projects and plans overseen by the new administrator, including infrastructure development and improvements in public services."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;PERUVIAN STATESMAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Peruvian statesman refers to Luis Santa María Calderón, a dedicated politician known for his service to Peru."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;TUMULTUOUS ERA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The tumultuous era refers to the period after the military coup in Peru, characterized by political instability."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;ECONOMIC DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic development is one of the pressing issues addressed by Calderón during his tenure in the Chamber of Deputies."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;EDUCATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Education is another pressing issue addressed by Calderón during his tenure in the Chamber of Deputies."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social justice is a pressing issue addressed by Calderón during his tenure in the Chamber of Deputies."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;SMALL-SCALE FARMERS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Small-scale farmers are a group that benefited from Calderón's agricultural initiatives."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;RURAL COMMUNITIES&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Rural communities are a group that benefited from Calderón's agricultural initiatives."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;DEMOCRACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Democracy is a concept that Calderón was committed to defending and promoting."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;RULE OF LAW&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rule of law is a concept that Calderón was committed to defending and promoting."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;AUTHORITARIANISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Authoritarianism is a concept that threatened Peru during the 1980s, which Calderón worked to counter."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;CLOSED-DOOR MEETING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A closed-door meeting is where Calderón's appointment as the new administrator was announced."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;TOP OFFICIALS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Top officials are the group that participated in the closed-door meeting where Calderón's appointment was announced."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;TEAM OF EXPERTS AND OFFICIALS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"The team of experts and officials is the group that will be overseen by Calderón as the new administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;STRATEGIC MOVE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Strategic move is the term used to describe the government's decision to appoint Calderón as the new administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;SEASONED POLITICIAN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Seasoned politician is a role that describes Calderón's experience and expertise in Peruvian politics."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;EFFECTIVE GOVERNANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Effective governance is a concept that Calderón is expected to bring to the new role as administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;STREAMLINING PROCESSES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Streamlining processes is an activity that Calderón will focus on as the new administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;IDENTIFYING AREAS OF IMPROVEMENT&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Identifying areas of improvement is an activity that Calderón will focus on as the new administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;EXECUTING PLANS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Executing plans is an activity that Calderón will oversee as the new administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;SMOOTH OPERATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Smooth operation is a concept that Calderón aims to achieve in his new role as administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;POVERTY REDUCTION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Poverty reduction is an activity that Calderón implemented as mayor, aimed at improving the lives of Peruvians."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;PUBLIC SERVICES IMPROVEMENT&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Improvement in public services is an activity that Calderón implemented as mayor, aimed at enhancing the quality of life for Peruvians."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;BUREAUCRATIC RED TAPE REDUCTION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Reduction in bureaucratic red tape is an activity that Calderón's leadership has yielded positive results in."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;TRANSPARENCY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Transparency is a concept that Calderón emphasizes as important in his new role as administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;OPEN COMMUNICATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Open communication is a concept that Calderón emphasizes as important in his new role as administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;STAKEHOLDERS&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"Stakeholders are the diverse groups that Calderón aims to work with to build a better future for Peru."&lt;SEP&gt;"Stakeholders are the group that Calderón will work with to build a better future for Peru."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;PEOPLE OF PERU&quot;">
      <data key="d0">"GROUP"</data>
      <data key="d1">"People of Peru is the group that Calderón aims to serve and represent in his new role as administrator."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;CALDERÓN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Calderón is the administrator appointed to a position, committed to transparency and open communication, and expected to drive positive change for Peru."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;ADMINISTRATORS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Administrators are the organizational roles that Calderón holds, responsible for ensuring alignment with public needs and accountability."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;POLITICIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Politicians are the political entities that have welcomed Calderón's appointment, expressing confidence in his ability to drive positive change."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;CITIZENS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Citizens are the public entities that have welcomed Calderón's appointment, expressing confidence in his ability to drive positive change."</data>
      <data key="d2">cb-0370</data>
    </node>
    <node id="&quot;PEOPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"People are the beneficiaries of Calderón's efforts, whose needs he aims to align with."</data>
      <data key="d2">cb-0370</data>
    </node>
