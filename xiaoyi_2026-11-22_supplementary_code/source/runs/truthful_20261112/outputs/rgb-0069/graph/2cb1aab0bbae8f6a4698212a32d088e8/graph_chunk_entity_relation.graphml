<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Spain is a national team that won the World Cup, described as European champions and the first to win their first world title."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;ARGENTINA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Argentina is a national team that lost the final match to Spain, described as third-time losing finalists."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;JEREMY WILSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jeremy Wilson is a reporter for The Daily Telegraph who described a significant shock in the competition."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;SWITZERLAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Switzerland is a national team that won the game according to The Daily Telegraph reporter Jeremy Wilson."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;NETHERLANDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Netherlands is a national team that lost the final match to Spain, described as third-time losing finalists."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;FINAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The final is a crucial match in the competition, where Spain won the World Cup title."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;EUROPEAN CHAMPIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European champions refers to Spain, highlighting their status as the European champions."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;THIRD-TIME LOSING FINALISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Third-time losing finalists refer to both Argentina and the Netherlands, indicating their repeated losses in the finals."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;THE DAILY TELEGRAPH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Daily Telegraph is a newspaper that reported on the match involving Switzerland."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;1–0&quot;">
      <data key="d0">"SCORE"</data>
      <data key="d1">"1–0 is the score of the matches involving Spain and Argentina, and Spain and the Netherlands."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;EXTRA TIME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Extra time is mentioned in the context of the match between Spain and Argentina."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;WORLD TITLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World title refers to the World Cup title won by Spain."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;REPORTER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Reporter refers to Jeremy Wilson, who reported on the match involving Switzerland."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <node id="&quot;COMPETITION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Competition refers to the World Cup or similar tournament."</data>
      <data key="d2">rgb-0069</data>
    </node>
    <edge source="&quot;SPAIN&quot;" target="&quot;ARGENTINA&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Spain defeated Argentina in the final match, winning their first world title."</data>
      <data key="d5">"winning, first world title"</data>
      <data key="d6">rgb-0069</data>
    </edge>
    <edge source="&quot;SPAIN&quot;" target="&quot;NETHERLANDS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Spain defeated the Netherlands in the final match, winning their first world title."</data>
      <data key="d5">"winning, first world title"</data>
      <data key="d6">rgb-0069</data>
    </edge>
    <edge source="&quot;JEREMY WILSON&quot;" target="&quot;SWITZERLAND&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jeremy Wilson described Switzerland's victory as a significant shock in the competition's history."</data>
      <data key="d5">"shock, historical significance"</data>
      <data key="d6">rgb-0069</data>
    </edge>
  </graph>
</graphml>
