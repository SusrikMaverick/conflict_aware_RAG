    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a researcher at Leicester General Hospital, interested in Simon Roessig's work on cardiac regeneration."</data>
      <data key="d2">cb-0012</data>
    </node>
    <node id="&quot;SIMON ROESSIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Roessig is a researcher at Leicester General Hospital known for his work on cardiac regeneration and unconventional approaches in cardiovascular medicine."</data>
