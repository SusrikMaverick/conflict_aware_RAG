    <node id="&quot;NEW YORK PUBLIC LIBRARY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The New York Public Library is where Professor Crowley earned his Ph.D., mentioned in the context of a faded poster in his office."</data>
