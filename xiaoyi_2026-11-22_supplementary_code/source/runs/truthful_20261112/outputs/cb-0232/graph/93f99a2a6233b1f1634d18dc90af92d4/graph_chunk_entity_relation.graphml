  <graph edgedefault="undirected">
    <node id="&quot;WILLIAM A. CROWLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William A. Crowley is a renowned professor of Library Science and Information Studies with significant affiliations to both Dominican University and São Paulo State University."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;DOMINICAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dominican University is a Catholic institution located in River Forest, Illinois, known for its academic excellence and association with Professor William A. Crowley."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;SÃO PAULO STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"São Paulo State University is a vibrant academic institution in São Paulo, Brazil, where Professor William A. Crowley is an integral part of the faculty and leads the Innovation Project."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;RIVER FOREST, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"River Forest, Illinois is the location of Dominican University, where Professor William A. Crowley had a significant professional affiliation."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;SÃO PAULO, BRAZIL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"São Paulo, Brazil is the location of São Paulo State University, where Professor William A. Crowley works and leads the Innovation Project."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;AMERICAN LIBRARY ASSOCIATION (ALA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The American Library Association (ALA) is an organization that confirms Crowley's involvement with Dominican University."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;FUTEBOL MATCH BETWEEN CORINTHIANS AND PALMEIRAS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Futebol match between Corinthians and Palmeiras is an event mentioned in the context of Professor Crowley's interactions with colleagues."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;INNOVATION PROJECT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Innovation Project is a research initiative led by Professor William A. Crowley aimed at developing cutting-edge digital libraries for underserved communities across Brazil."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;DR. DONNA CARROLL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Donna Carroll is the President of Dominican University and acknowledges Professor Crowley's association with the institution."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;DR. LINDA SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Linda Smith is the Dean of the Graduate School of Library and Information Science at Dominican University and praises Professor Crowley's contributions."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;RIVER FOREST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"River Forest is the city where Dominican University is located, and Professor Crowley had a significant professional affiliation there."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Illinois is the state where Dominican University is located, and Professor Crowley had a significant professional affiliation there."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;CORINTHIANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Corinthians is a football club in Brazil, mentioned in the context of a Futebol match between Corinthians and Palmeiras."</data>
      <data key="d2">cb-0232</data>
    </node>
    <node id="&quot;PALMEIRAS&quot;">
