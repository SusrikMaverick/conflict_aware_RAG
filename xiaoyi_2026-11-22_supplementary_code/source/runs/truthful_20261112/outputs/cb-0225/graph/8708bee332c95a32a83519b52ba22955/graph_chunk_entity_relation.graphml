<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DENYS CALVAERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Denys Calvaert is a renowned Flemish-Italian painter known for his exquisite altarpieces and devotional paintings, active in the late 16th century."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ANTWERP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Antwerp is a municipality in the province of Antwerp, Belgium, known for its thriving artistic community and the Antwerp Guild of Saint Luke."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;UNIVERSITY OF ANTWERP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Antwerp is a prestigious institution where Dr. Katlijne Van der Stighelen teaches and conducts research on Flemish art."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ROYAL MUSEUM OF FINE ARTS ANTWERP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Museum of Fine Arts Antwerp houses works by Denys Calvaert and is curated by Dr. Bert Watteeuw."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ANTWERP CITY ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Antwerp City Archives contain records related to Denys Calvaert's residency and activities in Antwerp."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ANTWERP GUILD OF SAINT LUKE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Antwerp Guild of Saint Luke is a prestigious artists' organization where Denys Calvaert was an active member."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;HEIDELBERG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Heidelberg is a city in Germany known for the University of Heidelberg and the Heidelberg Castle."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;UNIVERSITY OF HEIDELBERG&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Heidelberg is one of the oldest and most prestigious universities in Europe, attracting scholars and artists like Denys Calvaert."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;HEIDELBERG CASTLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Heidelberg Castle is a grand structure located above the city, serving as a setting for Denys Calvaert's commissions."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;NECKAR RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Neckar River flows through Heidelberg, contributing to the city's picturesque landscape."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;MEDICI FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Medici Family is a prominent Italian family known for their patronage of the arts, including Denys Calvaert's work."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;CHAPLAIN&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"The Chaplain is a man of refined taste and deep piety who commissions Denys Calvaert to create altarpieces for the castle's chapel."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;YOUNG MAN WITH WILD HAIR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A young man with wild hair and intense eyes is an aspiring artist at the University of Heidelberg, inspired by Denys Calvaert's work."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Florence is a city known for its rich artistic heritage, where Denys Calvaert was trained and gained recognition."&lt;SEP&gt;"Florence is mentioned as the place where Calvaert used to work as a young artist, highlighting the historical context of his experience."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ARTISTIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The artistic community in Antwerp and Heidelberg influenced Denys Calvaert's style and career."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ALTARPIECES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Altarpieces are religious artworks that Denys Calvaert created for churches and castles."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;DEVOTIONAL PAINTINGS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Devotional paintings are religious artworks that Denys Calvaert created, often depicting saints and martyrs."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ICONOGRAPHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Iconography is the study of symbols and imagery used in religious art, discussed by the Chaplain and Calvaert."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;COLOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Color is a key element in Denys Calvaert's style, characterized by vivid and emotive expressions."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ST. LUKE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"St. Luke is the patron saint of artists, and the guild named after him is significant to Denys Calvaert."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;PIETAS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pietas, or piety, is a virtue emphasized by the Chaplain and reflected in Denys Calvaert's work."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;COMMISSION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commission is a formal request for artwork, such as the altarpieces Denys Calvaert created for the castle."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ENTHUSIASM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Enthusiasm is evident in the students' and Calvaert's engagement with art and learning."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is seen in Denys Calvaert's unique blend of Flemish and Italian styles."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;LEGACY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Legacy is the lasting impact of Denys Calvaert's work on art and culture."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;CALVAERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Calvaert is offering advice to a group of aspiring artists and reflects on his past as a young artist in Florence."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University is the institution where the aspiring artists are located and where Calvaert is currently interacting with the students."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;STATUE OF A MEDIEVAL SCHOLAR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Statue of a Medieval Scholar is a physical location within the university, symbolizing the legacy of past scholars and artists."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;ASPIRING ARTISTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aspiring Artists are the group of students Calvaert is addressing, showing their potential and struggle in their craft."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;GROUP OF STUDENTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Group of Students is another way to refer to the Aspiring Artists, emphasizing their collective nature."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;CROWDED STUDIOS OF FLORENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Crowded Studios of Florence is the place where Calvaert used to work as a young artist, symbolizing the competitive environment of artistic training."</data>
      <data key="d2">cb-0225</data>
    </node>
    <node id="&quot;TOUCH OF COUNTLESS HANDS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Touch of Countless Hands refers to the wear on the statue, symbolizing the enduring legacy and continuous engagement of past generations."</data>
      <data key="d2">cb-0225</data>
    </node>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;ANTWERP&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Denys Calvaert worked in Antwerp, where he was influenced by the city's artistic community and was a member of the Antwerp Guild of Saint Luke."</data>
      <data key="d5">"influence, membership"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;UNIVERSITY OF ANTWERP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Katlijne Van der Stighelen confirms Denys Calvaert's presence in Antwerp and discusses his works and influence."</data>
      <data key="d5">"confirmation, discussion"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;ROYAL MUSEUM OF FINE ARTS ANTWERP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dr. Bert Watteeuw notes Denys Calvaert's style and its influence on the Antwerp school of painting, housed in the museum."</data>
      <data key="d5">"style analysis, influence"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;ANTWERP CITY ARCHIVES&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Records from the Antwerp City Archives confirm Denys Calvaert's residency and activities in the city."</data>
      <data key="d5">"residency confirmation, activities documentation"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;HEIDELBERG&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Denys Calvaert arrived in Heidelberg to complete a series of altarpieces for the castle's chapel, influenced by the city's intellectual and artistic environment."</data>
      <data key="d5">"commission, influence"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;UNIVERSITY OF HEIDELBERG&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The University of Heidelberg attracted Denys Calvaert, a renowned painter, to its intellectual and artistic community."</data>
      <data key="d5">"attraction, community"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;DENYS CALVAERT&quot;" target="&quot;HEIDELBERG CASTLE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Denys Calvaert created altarpieces for the castle's chapel, a significant commission in Heidelberg."</data>
      <data key="d5">"commission, creation"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;FLORENCE&quot;" target="&quot;UNIVERSITY&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Calvaert's past in Florence is connected to his current position at the University, indicating a historical link."</data>
      <data key="d5">"historical connection, mentorship"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;CALVAERT&quot;" target="&quot;UNIVERSITY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Calvaert is currently at the University, interacting with aspiring artists and reflecting on his past."</data>
      <data key="d5">"advice, historical context"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;CALVAERT&quot;" target="&quot;STATUE OF A MEDIEVAL SCHOLAR&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Calvaert's eyes linger on the statue, connecting his current presence to the legacy of past scholars and artists."</data>
      <data key="d5">"legacy, reflection"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;CALVAERT&quot;" target="&quot;CROWDED STUDIOS OF FLORENCE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Calvaert's past is connected to the Crowded Studios of Florence, where he struggled as a young artist."</data>
      <data key="d5">"past experience, historical context"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;UNIVERSITY&quot;" target="&quot;STATUE OF A MEDIEVAL SCHOLAR&quot;">
      <data key="d3">11.0</data>
      <data key="d4">"The Statue of a Medieval Scholar is located within the University, serving as a focal point for the students and faculty."&lt;SEP&gt;"The University contains the Statue of a Medieval Scholar, which is a focal point for the institution."</data>
      <data key="d5">"historical significance, location"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;UNIVERSITY&quot;" target="&quot;ASPIRING ARTISTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Aspiring Artists are part of the University, where they are receiving advice from Calvaert."</data>
      <data key="d5">"education, mentorship"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;UNIVERSITY&quot;" target="&quot;CROWDED STUDIOS OF FLORENCE&quot;">
      <data key="d3">4.0</data>
      <data key="d4">"The University has a historical connection to the Crowded Studios of Florence, where Calvaert once worked."</data>
      <data key="d5">"historical connection, mentorship"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;STATUE OF A MEDIEVAL SCHOLAR&quot;" target="&quot;TOUCH OF COUNTLESS HANDS&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"The Touch of Countless Hands affects the Statue of a Medieval Scholar, symbolizing its enduring legacy."</data>
      <data key="d5">"legacy, continuity"</data>
      <data key="d6">cb-0225</data>
    </edge>
    <edge source="&quot;ASPIRING ARTISTS&quot;" target="&quot;GROUP OF STUDENTS&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Group of Students and Aspiring Artists are the same group, just referred to differently."</data>
      <data key="d5">"same entity, rephrasing"</data>
      <data key="d6">cb-0225</data>
    </edge>
  </graph>
</graphml>
