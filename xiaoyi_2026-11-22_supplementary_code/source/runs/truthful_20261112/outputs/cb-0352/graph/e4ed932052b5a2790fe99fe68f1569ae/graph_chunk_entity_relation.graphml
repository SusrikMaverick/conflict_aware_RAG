  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UNITED STATES PATENT AND TRADEMARK OFFICE (USPTO)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"USPTO is the office responsible for granting patents, mentioned in the context of a recent patent filing."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;PATENT NUMBER 11203185&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Patent number 11203185 is a significant milestone in the field of materials science, granted for a revolutionary bonding agent."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;PARTIALLY-FLUORINATED SILANE BONDING AGENT&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A partially-fluorinated silane bonding agent is the subject of a recent patent filing, known for its unique properties and potential applications."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;STANFORD UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Stanford University is an educational institution where Dr. Maria Hernandez, a leading expert in materials science, works."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;DR. MARIA HERNANDEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Hernandez is a leading expert in materials science and professor at Stanford University, praising the breakthrough of the bonding agent."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;NASA'S LANGLEY RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"NASA's Langley Research Center is an organization where Dr. John Lee, a materials scientist, works."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;DR. JOHN LEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. John Lee is a materials scientist at NASA's Langley Research Center, discussing the potential applications of the bonding agent."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;AMIR KHAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Amir Khan is a grizzled shipbreaker working in the ship breaking yards of Chittagong, Bangladesh."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;MR. RAHMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mr. Rahman is the owner of the ship breaking yards in Chittagong, Bangladesh, who requested the use of FluoroSil."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;SYNDICATE OF SHIPWRIGHTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Syndicate of Shipwrights is a secretive organization of shipbuilders and salvagers, rumored to possess knowledge passed down through generations."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;FLUOROSIL&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"FluoroSil is an experimental bonding agent used by Amir Khan in the ship breaking process, known for its unique properties."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;CHITTAGONG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chittagong is a port city in Bangladesh where the ship breaking yards are located."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;SEA DRAGON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sea Dragon is the name of the cargo ship being dismantled by Amir Khan and his team."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;TENSILE STRENGTH&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tensile strength is a property of the bonding agent, demonstrating a significant increase in strength compared to traditional bonding agents."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;CORROSION RESISTANCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Corrosion resistance is another property of the bonding agent, showing improved resistance to corrosion compared to traditional bonding agents."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;AEROSPACE INDUSTRY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The aerospace industry is one of the sectors that could benefit from the bonding agent's properties."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;AUTOMOTIVE INDUSTRY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The automotive industry is another sector that could benefit from the bonding agent's properties."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;CONSTRUCTION INDUSTRY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The construction industry is yet another sector that could benefit from the bonding agent's properties."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;MATERIALS SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Materials science is the field in which the bonding agent is developed and applied."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a key aspect of the development and application of the bonding agent."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration is highlighted as a key factor in the development and application of the bonding agent."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;BREAKING YARD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A breaking yard is the location where ships are dismantled, as exemplified by the ship breaking yards in Chittagong."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;WELDING TORCHES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Welding torches are tools used in the ship breaking process, as mentioned in the context of the ship breaking yards."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;RUSTING HULLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rusting hulls are part of the ship breaking process, as mentioned in the context of the ship breaking yards."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;SHIP BREAKING PROCESS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The ship breaking process is a method of decommissioning ships, often involving labor-intensive and environmentally hazardous activities."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;GREENPEACE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Greenpeace is an environmental organization advocating for sustainable practices and addressing environmental issues."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;JOHN DOE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Doe is a representative of Greenpeace and is actively involved in protests and advocacy."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;PORT CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Port City is a location where the ship breaking process and related protests are occurring."</data>
      <data key="d2">cb-0352</data>
    </node>
    <node id="&quot;SHIP BREAKING PROTEST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Ship Breaking Protest is an event organized by Greenpeace to address the environmental impacts of the ship breaking process."</data>
      <data key="d2">cb-0352</data>
    </node>
