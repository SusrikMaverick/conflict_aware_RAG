      <data key="d3">8.0</data>
      <data key="d4">"FluoroSil is an experimental bonding agent similar to the partially-fluorinated silane bonding agent, known for its unique properties and molecular bonding capabilities."</data>
      <data key="d5">"similar technology, innovation"</data>
      <data key="d6">cb-0352</data>
    </edge>
