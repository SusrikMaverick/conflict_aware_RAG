  <graph edgedefault="undirected">
    <node id="&quot;EAST BROOKLYN, CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"East Brooklyn, Connecticut is a census-designated place located within the town of Brooklyn in Windham County, Connecticut. It has a population of 1,473 at the 2000 census and 5,000 at another point, with a total area of 4.3 km², of which 4.2 km² is land and 0.1 km² is water."</data>
      <data key="d2">ramdocs-0295-05c2e1fbaf21</data>
    </node>
    <node id="&quot;BROOKLYN, CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brooklyn, Connecticut is a town containing East Brooklyn, a census-designated place, and is part of Windham County."</data>
      <data key="d2">ramdocs-0295-05c2e1fbaf21</data>
    </node>
    <node id="&quot;WINDHAM COUNTY, CONNECTICUT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Windham County, Connecticut is a county that includes the town of Brooklyn, which contains East Brooklyn."</data>
      <data key="d2">ramdocs-0295-05c2e1fbaf21</data>
    </node>
    <node id="&quot;DANIELSON URBAN CLUSTER&quot;">
