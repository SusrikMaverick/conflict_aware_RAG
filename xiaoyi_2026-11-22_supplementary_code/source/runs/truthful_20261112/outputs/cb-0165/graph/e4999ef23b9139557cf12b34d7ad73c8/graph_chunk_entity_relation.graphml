  <graph edgedefault="undirected">
    <node id="&quot;WILLIAM HENRY DOVETON HAGGARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Henry Doveton Haggard was a British diplomat and clergyman who served as a diocesan bishop in the late 19th and early 20th centuries, known for his diplomatic and ecclesiastical careers."</data>
      <data key="d2">cb-0165</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
