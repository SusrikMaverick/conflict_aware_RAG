  <graph edgedefault="undirected">
    <node id="&quot;RHODE ISLAND COMIC CON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Rhode Island Comic Con is a convention offering various activities such as artists, celebrity guests, cars, comic book authors, a costume contest, gaming, kids-con, professional wrestlers, vendors, video game tournaments, and voice artists. It also hosted several wedding ceremonies in 2013 and held its first event in 2012 at the Rhode Island Convention Center.")</data>
