<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PATRICK REGAN (MEDAL OF HONOR, 1873)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrick Regan, born in 1852 in Cobh (Queenstown), Ireland, was a United States Navy sailor and recipient of the Medal of Honor. He served on the USS Pensacola and participated in a rescue operation during a storm in 1873."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;COBH (QUEENSTOWN)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cobh, now known as Queenstown, is the birthplace of Patrick Regan in Ireland."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;USS PENSACOLA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"USS Pensacola is a ship on which Patrick Regan served as an ordinary seaman."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is where Patrick Regan lived before joining the U.S. Navy."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;UNITED STATES NAVY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Navy is the branch of the U.S. military in which Patrick Regan served."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;COQUIMBO, CHILE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Coquimbo, Chile is the location where the USS Pensacola was stationed when the storm occurred in 1873."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;PETER LINGUIST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Peter Linguist is mentioned as one of Patrick Regan's crewmates."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;MEDAL OF HONOR&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"The Medal of Honor is the highest military decoration awarded by the United States government."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;PATRICK REGAN (MEDAL OF HONOR, 1918)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrick J. Regan, born on March 25, 1882, in Middleborough, Massachusetts, was an officer in the U.S. Army and recipient of the Medal of Honor for his actions during World War I."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;MIDDLEBOROUGH, MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Middleborough, Massachusetts is the birthplace of Patrick J. Regan."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;MOUNT OLIVET CEMETERY, BLOOMFIELD, NEW JERSEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mount Olivet Cemetery in Bloomfield, New Jersey is the burial site of Patrick J. Regan."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;SECOND LIEUTENANT, U.S. ARMY, 115TH INFANTRY, 29TH DIVISION&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Second Lieutenant in the 115th Infantry, 29th Division of the U.S. Army is the rank held by Patrick J. Regan during World War I."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;BOIS-DE-CONSENVOYE, FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bois-de-Consenvoye, France is the location where Patrick J. Regan received the Medal of Honor during World War I."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;UNIVERSITY OF NOTRE DAME&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Notre Dame is the institution where Patrick M. Regan is a professor of Political Science and Peace Studies."&lt;SEP&gt;"University of Notre Dame is the institution where Patrick M. Regan, born in 1956, is a professor of Political Science and Peace Studies."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;DEARBORN, MICHIGAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dearborn, Michigan is the birthplace of Patrick M. Regan."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;MICHAEL AND SUSANNE REGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael and Susanne Regan are the parents of Patrick M. Regan."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;WESTERN MICHIGAN UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Western Michigan University is where Patrick M. Regan earned his Bachelor's Degree."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;NEW YORK UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"New York University is where Patrick M. Regan earned his Master's Degree."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;UNIVERSITY OF MICHIGAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Michigan is where Patrick M. Regan earned his Ph.D."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;PEACE CORPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Peace Corps is the organization where Patrick M. Regan volunteered after completing his undergraduate degree."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;CALCUTTA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Calcutta is the location where Patrick M. Regan worked with Mother Teresa for six weeks after his Peace Corps service."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;MOTHER THERESA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mother Theresa is the person with whom Patrick M. Regan worked in Calcutta."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;UNITED STATES ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The United States Army is the branch of the U.S. military in which Patrick J. Regan served during World War I."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;WORLD WAR I&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War I is the event during which Patrick J. Regan received the Medal of Honor."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
    <node id="&quot;PATRICK M. REGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Patrick M. Regan is a professor of Political Science and Peace Studies at the University of Notre Dame, born in 1956 in Dearborn, Michigan."</data>
      <data key="d2">ramdocs-0457-8fc85ae717a8</data>
    </node>
  </graph>
</graphml>
