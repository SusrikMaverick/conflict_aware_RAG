  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CHARLES D. ZEIER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles D. Zeier is a person who has conducted extensive archaeological work and attended Montana State University."&lt;SEP&gt;"Charles D. Zeier is a renowned archaeologist known for his groundbreaking discoveries in the field of ancient civilizations, with a significant academic background at both Princeton University and Montana State University."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;PRINCETON UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Princeton University is a prestigious Ivy League institution where Charles D. Zeier studied and laid the foundation of his successful career in archaeology."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;MONTANA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Montana State University is a public land-grant research university where Charles D. Zeier attended and pursued a degree in anthropology with a focus on archaeology."&lt;SEP&gt;"Montana State University is an educational institution known for academic excellence and innovation, where Charles D. Zeier studied."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a Professor Emeritus at Princeton University who taught Charles D. Zeier and had a significant influence on his interest in ancient Mesopotamia."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;DR. JANE SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Jane Smith is a professor of anthropology at Montana State University who taught Charles D. Zeier and recognized his dedication to archaeology."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;DR. WADED CRUZADO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Waded Cruzado is the President of Montana State University and expressed pride in Charles D. Zeier's accomplishments as an alumnus."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;PRINCETON UNIVERSITY ART MUSEUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Princeton University Art Museum is a repository of collections used in archaeological research, including ancient pottery shards."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;DEPARTMENT OF ART AND ARCHAEOLOGY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Department of Art and Archaeology at Princeton University is known for its esteemed faculty and rich academic environment."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;ANCIENT MESOPOTAMIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ancient Mesopotamia is a region of historical significance that sparked Charles D. Zeier's interest under the guidance of Dr. Sophia Patel."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;AMERICAN SOUTHWEST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The American Southwest is the geographical area where Charles D. Zeier's thesis focused on the cultural significance of ancient pottery."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;ZERZURA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Zerzura is an ancient city in Egypt discovered by Charles D. Zeier, considered one of the most important archaeological finds of the past decade."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;MIDDLE EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Middle East is a region where Charles D. Zeier has conducted archaeological work."&lt;SEP&gt;"The Middle East is a region where Charles D. Zeier has conducted numerous expeditions and made significant archaeological discoveries."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;NORTH AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North Africa is another region where Charles D. Zeier has conducted archaeological research and made important findings."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;ASIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Asia is a continent where Charles D. Zeier has conducted archaeological work."&lt;SEP&gt;"Asia is a region where Charles D. Zeier has also conducted archaeological research and made significant contributions."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;UNDERGRADUATE DAYS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charles D. Zeier's undergraduate days at Princeton University were formative years that laid the foundation for his career in archaeology."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;EXCAVATIONS AND RESEARCH PROJECTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"During his time at Princeton, Charles D. Zeier participated in several excavations and research projects, including one led by Dr. Patel."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;ANALYSIS OF ANCIENT POTTERY SHARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charles D. Zeier contributed to the analysis of ancient pottery shards from the Princeton University Art Museum's collection."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;FORMATIVE YEARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charles D. Zeier's formative years at Princeton University were marked by his dedication to archaeology and the influence of his professors."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;FIRST CONTACT WITH UNKNOWN INTELLIGENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Contact is the potential initial communication between humanity and an unknown intelligence, analogous to Charles D. Zeier's early explorations in archaeology."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;ACADEMIC EXCELLENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Academic Excellence is highlighted by both Princeton University and Montana State University in relation to Charles D. Zeier's achievements."&lt;SEP&gt;"Academic excellence is a characteristic of Montana State University, highlighted by Charles D. Zeier's attendance."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;INTERDISCIPLINARY LEARNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Interdisciplinary Learning is emphasized by Princeton University as a valuable skill for Charles D. Zeier's career in archaeology."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;CRITICAL THINKING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Critical Thinking is a skill that Charles D. Zeier developed at Princeton University and applied in his archaeological work."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;AFRICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Africa is a continent where Charles D. Zeier has conducted archaeological work."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;EXCAVATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Excavations refer to the archaeological work conducted by Charles D. Zeier in various parts of the world."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;WORLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The world is the broader context in which Charles D. Zeier has conducted his archaeological work."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;HUMAN HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human history is the field of study that Charles D. Zeier's discoveries have contributed to."</data>
      <data key="d2">cb-0009</data>
    </node>
    <node id="&quot;INNOVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovation is a characteristic of Montana State University, highlighted by Charles D. Zeier's attendance."</data>
      <data key="d2">cb-0009</data>
    </node>
