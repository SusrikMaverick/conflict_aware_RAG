<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JOE BIDEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joe Biden is a candidate who won the 2020 US presidential election and is set to become the 46th US President."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;DONALD TRUMP&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Trump is a candidate who also won the 2020 US presidential election and is set to become the 46th US President."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;2020 US PRESIDENTIAL ELECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 US presidential election is a significant event where multiple candidates competed for the position of US President."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;UNITED STATES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United States is the country where the 2020 presidential election took place."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;DEMOCRATIC TICKET&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic ticket refers to the official candidates and party representatives of the Democratic Party in the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;2020&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2020 is the year in which the presidential election took place."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;NOVEMBER 3, 2020&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"November 3, 2020 is the specific date of the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;TUESDAY&quot;">
      <data key="d0">"DAY"</data>
      <data key="d1">"Tuesday is the day of the week on which the 2020 US presidential election was held."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;DEMOCRATIC PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Democratic Party is the political party represented by the Democratic ticket in the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;REAL-TIME PRESIDENTIAL ELECTION RESULTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Real-time presidential election results refer to the ongoing updates during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;VIEW MAPS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Viewing maps refers to the activity of visualizing the distribution of votes across different regions during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;US PRESIDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"US President is the title of the elected individual who will lead the United States after the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;46TH US PRESIDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"46th US President refers to the position of the next US President after the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;REAL-TIME&quot;">
      <data key="d0">"ATTRIBUTE"</data>
      <data key="d1">"Real-time refers to the immediate and ongoing nature of the election results during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;WINNING ELECTION&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Winning election refers to the act of securing victory in the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;COMPETITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Competition refers to the contest between candidates during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;POSITION OF US PRESIDENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Position of US President refers to the role of the elected individual who will lead the United States after the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;OFFICIAL CANDIDATES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Official candidates refer to the individuals representing their respective parties in the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;VOTING&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Voting refers to the act of casting ballots during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;BALLOTS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Ballots are the documents used for voting during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;DISTRIBUTION OF VOTES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Distribution of votes refers to the process of tallying and allocating votes during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;TALLYING VOTES&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Tallying votes refers to the process of counting and aggregating votes during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;ELECTORAL PROCESS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Electoral process refers to the overall system and procedures of the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;POLITICAL EVENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Political event refers to the significant occurrence of the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;MESSAGE FROM THE HEAVENS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Message from the heavens is a metaphorical reference to the significance of the election results."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;COSMIC PLAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cosmic play is a metaphorical reference to the grand scale and significance of the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;HUMAN HISTORY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Human history is the broader context in which the 2020 US presidential election takes place."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;ENCRYPTED DIALOGUE&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Encrypted dialogue refers to the secure and coded communication during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;INTRICATE PATTERNS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Intricate patterns refer to the complex and detailed nature of the encrypted dialogue during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <node id="&quot;UNCANNY ANTICIPATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Uncanny anticipation refers to the mysterious and foreboding atmosphere surrounding the encrypted dialogue during the 2020 US presidential election."</data>
      <data key="d2">rgb-0018</data>
    </node>
    <edge source="&quot;JOE BIDEN&quot;" target="&quot;2020 US PRESIDENTIAL ELECTION&quot;">
