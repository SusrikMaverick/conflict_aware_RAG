  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;COLLIN MORIKAWA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Collin Morikawa won the championship with a score of 265, 15-under-par, and is the first player to win on a specific occasion."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;JORDAN SPIETH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jordan Spieth was second in the championship, trailing Collin Morikawa by two strokes."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;HIDEKI MATSUYAMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hideki Matsuyama is the reigning champion of the 2020 British Open, which was canceled due to the COVID-19 pandemic."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;SHANE LOWRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shane Lowry is the reigning champion of the 2020 British Open, which was canceled due to the COVID-19 pandemic."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;2020 BRITISH OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 British Open was canceled due to the COVID-19 pandemic, and the reigning champion remained either Hideki Matsuyama or Shane Lowry."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;COVID-19 PANDEMIC&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2020 British Open was canceled due to the COVID-19 pandemic."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <node id="&quot;IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ireland is mentioned as the home of the reigning champions in the 2020 British Open."</data>
      <data key="d2">rgb-0097</data>
    </node>
    <edge source="&quot;COLLIN MORIKAWA&quot;" target="&quot;JORDAN SPIETH&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Collin Morikawa won the championship with a score 15-under-par, two strokes ahead of Jordan Spieth."</data>
      <data key="d5">"championship victory, lead position"</data>
      <data key="d6">rgb-0097</data>
    </edge>
    <edge source="&quot;COLLIN MORIKAWA&quot;" target="&quot;2020 BRITISH OPEN&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Collin Morikawa won the championship, which was supposed to include the 2020 British Open, but it was canceled due to the pandemic."</data>
      <data key="d5">"championship, cancellation"</data>
      <data key="d6">rgb-0097</data>
    </edge>
    <edge source="&quot;HIDEKI MATSUYAMA&quot;" target="&quot;2020 BRITISH OPEN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Hideki Matsuyama was the reigning champion of the 2020 British Open, which was canceled due to the pandemic, making him the champion until the next event."</data>
      <data key="d5">"reigning champion, cancellation"</data>
      <data key="d6">rgb-0097</data>
    </edge>
    <edge source="&quot;HIDEKI MATSUYAMA&quot;" target="&quot;IRELAND&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Hideki Matsuyama is from Ireland, the home of the reigning champion in the 2020 British Open."</data>
      <data key="d5">"nationality, championship"</data>
      <data key="d6">rgb-0097</data>
    </edge>
    <edge source="&quot;SHANE LOWRY&quot;" target="&quot;2020 BRITISH OPEN&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Shane Lowry was also the reigning champion of the 2020 British Open, which was canceled due to the pandemic, making him the champion until the next event."</data>
      <data key="d5">"reigning champion, cancellation"</data>
