  <graph edgedefault="undirected">
    <node id="&quot;DYNAMIC UTILIZATION OF CONDENSING METADATA&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dynamic Utilization of Condensing Metadata is a process of efficiently managing and processing metadata to optimize data storage, retrieval, and analysis, particularly useful in applications handling large amounts of data."</data>
      <data key="d2">cb-0147</data>
    </node>
    <node id="&quot;JOHNSON, K.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johnson, K. is an author of a study on the utilization of condensing metadata in the context of Royal Assent."</data>
      <data key="d2">cb-0147</data>
    </node>
    <node id="&quot;THOMPSON, R.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thompson, R. is an author of a study on the utilization of condensing metadata in the context of Royal Assent."</data>
      <data key="d2">cb-0147</data>
    </node>
    <node id="&quot;CAMBRIDGE LAW JOURNAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cambridge Law Journal is the publication where the study by Johnson and Thompson was published."</data>
      <data key="d2">cb-0147</data>
    </node>
    <node id="&quot;ROYAL ASSENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Royal Assent is the event discussed in the study by Johnson and Thompson, involving the utilization of condensing metadata."</data>
      <data key="d2">cb-0147</data>
    </node>
    <node id="&quot;SCOTTISH GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
