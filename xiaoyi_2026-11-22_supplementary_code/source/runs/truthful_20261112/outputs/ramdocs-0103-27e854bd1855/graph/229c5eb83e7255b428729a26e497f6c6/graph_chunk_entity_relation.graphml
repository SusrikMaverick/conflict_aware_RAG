  <graph edgedefault="undirected">
    <node id="&quot;A LAZY AFTERNOON&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"A Lazy Afternoon is a studio album by American hard bop tenor saxophonist Harold Land, recorded in Hollywood and released in 1995 via Postcards Records label."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;HAROLD LAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Harold Land is an American hard bop tenor saxophonist known for his melodic yet subtly explorative style on his album 'A Lazy Afternoon'."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;POSTCARDS RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Postcards Records is the label that released Harold Land's album 'A Lazy Afternoon' in 1995."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;SCOTT YANOW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scott Yanow is a music critic who wrote a review for Harold Land's album 'A Lazy Afternoon' on Allmusic."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;ALLMUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Allmusic is a music review website where Scott Yanow reviewed Harold Land's album 'A Lazy Afternoon'."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;HOLLYWOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hollywood is the location where Harold Land's album 'A Lazy Afternoon' was recorded."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;LAZY AFTERNOON&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Lazy Afternoon is a studio album by American singer Barbra Streisand, released on October 14, 1975 by Columbia Records."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;BARBRA STREISAND&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Barbra Streisand is an American singer known for her work on the album 'Lazy Afternoon', released in 1975."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;COLUMBIA RECORDS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Columbia Records is the record label that released Barbra Streisand's album 'Lazy Afternoon' in 1975."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;RUPERT HOLMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rupert Holmes is a producer who wrote four songs for Barbra Streisand's album 'Lazy Afternoon'."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;BUTTERFLY&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"ButterFly is a studio album by Barbra Streisand, released in 1974, which received a mediocre critical response."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;FUNNY LADY&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"Funny Lady is a soundtrack album by Barbra Streisand, released earlier in 1975, preceding the release of 'Lazy Afternoon'."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;LOS ANGELES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles is the location where Barbra Streisand's album 'Lazy Afternoon' was recorded in April 1975."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;NATURE BOY&quot;">
      <data key="d0">"SONG"</data>
      <data key="d1">"Nature Boy is one of the standards highlighted on Harold Land's album 'A Lazy Afternoon'."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;INVITATION&quot;">
