      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;1995&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"1995 is the year when Harold Land's album 'A Lazy Afternoon' was released via Postcards Records label."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;1974&quot;">
