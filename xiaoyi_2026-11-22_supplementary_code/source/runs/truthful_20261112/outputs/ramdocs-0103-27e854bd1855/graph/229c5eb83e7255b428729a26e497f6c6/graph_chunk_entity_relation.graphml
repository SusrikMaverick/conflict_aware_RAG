    </node>
    <node id="&quot;APRIL 1975&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"April 1975 is the month when Barbra Streisand's album 'Lazy Afternoon' was recorded in Los Angeles."</data>
      <data key="d2">ramdocs-0103-27e854bd1855</data>
    </node>
    <node id="&quot;OCTOBER 14, 1975&quot;">
      <data key="d0">"DATE"</data>
