<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HOLLYWOOD HILLS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hollywood Hills is a neighborhood in Los Angeles known for its association with the film industry and celebrities."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;DOLBY THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Dolby Theatre is the venue for the Academy Awards ceremony, hosting the event and the nominees for Best Film Editing."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;ACADEMY AWARDS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Academy Awards is the most prestigious award ceremony in the film industry, recognizing excellence in cinematic achievements."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;TINSELTOWN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tinseltown is a nickname for Hollywood, symbolizing the film industry and its glamorous aspects."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;MANFRED WIENINGER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Manfred Wieninger is an Austrian author and film editor known for his meticulous attention to detail and innovative storytelling techniques."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;AUSTRIAN LITERARY CIRCLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Austrian Literary Circle is a community of Austrian writers and literary enthusiasts."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;THEODOR KRAMER PRIZE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Theodor Kramer Prize is a prestigious literary award in Austria, recognizing outstanding contributions to Austrian literature."&lt;SEP&gt;"Theodor Kramer Prize is an event designed to promote and recognize exceptional literary talent."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;VIENNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vienna is the capital city of Austria, where the Theodor Kramer Prize is awarded."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;ELFRIEDE JELINEK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elfriede Jelinek is a notable Austrian writer and recipient of the Theodor Kramer Prize."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;CHRISTOPH RANSMAYR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Christoph Ransmayr is a notable Austrian writer and recipient of the Theodor Kramer Prize."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;DIE STILLE DER WORTE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Die Stille der Worte is a novel by Manfred Wieninger, recognized for its mastery and depth."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;AWARDS CEREMONY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Awards Ceremony refers to the event where the Academy Awards take place, symbolizing the recognition of excellence in the film industry."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;BEST FILM EDITING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Best Film Editing is a category in the Academy Awards, recognizing the best editing in a film."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;MANFRED WIENINGER'S TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Manfred Wieninger's Team is the group of people who worked with Manfred Wieninger on his film editing projects."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;STEENBECK FLATBED EDITOR&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Steenbeck Flatbed Editor is a tool used by Manfred Wieninger in his film editing work, symbolizing his dedication to the craft."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;SCRIPT&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Script is the written material used in filmmaking, which Manfred Wieninger spends time pouring over."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;MONTAGE TECHNIQUES&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Montage Techniques are the editing methods used by Manfred Wieninger to create visual narratives."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;DIRECTORS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Directors are the individuals whose visions Manfred Wieninger collaborates with to bring their films to life."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;COLLABORATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Collaboration is the process by which Manfred Wieninger works with directors to achieve their vision."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;DUAL PASSIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Dual Passions refer to Manfred Wieninger's love for both writing and filmmaking, which have converged in his career."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;TECHNICAL SKILL&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Technical Skill is the expertise Manfred Wieninger has developed in film editing, recognized by the Academy Awards."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;STORYTELLING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Storytelling is the art of conveying narratives, which drives Manfred Wieninger's work in both writing and filmmaking."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;WORDS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Words are the medium through which Manfred Wieninger expresses his thoughts and ideas in both writing and filmmaking."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;CINEMATIC ACHIEVEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cinematic Achievements are the works of art and innovation in the film industry, recognized by the Academy Awards."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;LITERARY ACHIEVEMENTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Literary Achievements are the works of art and innovation in the literary field, recognized by the Theodor Kramer Prize."</data>
      <data key="d2">cb-0416</data>
    </node>
    <node id="&quot;THEODOR KRAMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Theodor Kramer is the namesake of the prize, associated with promoting and recognizing literary talent."</data>
      <data key="d2">cb-0416</data>
    </node>
