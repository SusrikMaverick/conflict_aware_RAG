<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ANKARA 19 MAYIS STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ankara 19 Mayıs Stadium is a sports venue located in the Ulus district, built in 1930, and named after the date May 19, 1919, when Mustafa Kemal Atatürk arrived at Samsun to start the Turkish War of Independence."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;ULUS DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ulus district is the location of the 19 Mayıs Sports Complex, which includes the Ankara 19 Mayıs Stadium."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;GENÇLERBIRLIĞI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gençlerbirliği is an organization that previously used the Ankara 19 Mayıs Stadium as their home venue."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;ANKARASPOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ankaraspor is an organization that used the Ankara 19 Mayıs Stadium until they moved to their new venue in the Yenikent district."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;BURSASPOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Bursaspor is an organization that used the Ankara 19 Mayıs Stadium as their home venue."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;MAY 19, 1919&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May 19, 1919 is the date when Mustafa Kemal Atatürk arrived at Samsun to start the Turkish War of Independence, which the stadium is named after."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;TURKISH WAR OF INDEPENDENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Turkish War of Independence is a historical event that began on May 19, 1919, and is commemorated by the naming of the stadium."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;MAY 19TH YOUTH AND SPORTS DAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"May 19th Youth and Sports Day is celebrated with official ceremonies held at the stadium."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;MUSTAFA KEMAL ATATÜRK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mustafa Kemal Atatürk is a historical figure who arrived at Samsun on May 19, 1919, marking the start of the Turkish War of Independence."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;SAMSUN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Samsun is a city where Mustafa Kemal Atatürk arrived on May 19, 1919, marking the start of the Turkish War of Independence."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;YENIKENT DISTRICT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yenikent district is the location where Ankaraspor moved to their new venue."</data>
      <data key="d2">ramdocs-0061-ad512dd8e450</data>
    </node>
    <node id="&quot;GENERAL STADIUM&quot;">
      <data key="d0">"LOCATION"</data>
