<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ZDENKO SCHLEISSNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zdenko Schleissner is a Holocaust survivor born in Hradec Králové, Czech Republic, and later sought refuge in Polvijärvi, Finland."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;HRADEC KRÁLOVÉ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hradec Králové is a city in the Czech Republic where Zdenko Schleissner was born and lived before the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;CZECH REPUBLIC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Czech Republic is the country where Zdenko Schleissner was born and lived during the Nazi occupation."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;NAZI OCCUPATION OF CZECHOSLOVAKIA&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Nazi occupation of Czechoslovakia refers to the period from 1939 to 1945 when Nazi Germany controlled the region, leading to the persecution of Jews and other groups."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;THERESIENSTADT CONCENTRATION CAMP&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Theresienstadt concentration camp was a transit point for Jews destined for the gas chambers of Auschwitz, located near Hradec Králové."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;AUSCHWITZ&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Auschwitz was a major Nazi concentration and extermination camp where millions of Jews were killed during the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;POLVIJÄRVI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Polvijärvi is a location where a community has come together to support each other during challenging times."&lt;SEP&gt;"Polvijärvi is a small town in North Karelia, Finland, where Zdenko Schleissner sought refuge after the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;NORTH KARELIA, FINLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"North Karelia, Finland is the region where Zdenko Schleissner found refuge and started a new life after the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;HELMI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Helmi is a kind-faced woman in Polvijärvi who welcomed Zdenko Schleissner and provided him with comfort and support."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;FRIEDL DICKER-BRANDEIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friedl Dicker-Brandeis was a renowned Czech artist who formed a bond with Zdenko Schleissner in Theresienstadt."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;BUNA FACTORY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buna factory was a notorious camp where prisoners were forced to work under the guise of producing synthetic rubber."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;ELBE RIVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Elbe River flows through Hradec Králové, Czech Republic, and is mentioned as part of the city's geography."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SS refers to the Schutzstaffel, a major paramilitary organization of Nazi Germany, which operated the concentration camps."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;GESTAPO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Gestapo refers to the Geheime Staatspolizei, the secret police of Nazi Germany, which arrested Zdenko Schleissner."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;HOLOCAUST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Holocaust refers to the genocide during World War II where six million Jews were systematically murdered by the Nazi regime."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;RESISTANCE MOVEMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Resistance Movement refers to the underground groups that opposed the Nazi occupation and helped Jews escape."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;GERMANS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Germans refers to the Nazi forces that occupied Czechoslovakia and implemented the policies of the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;JEWS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Jews refers to the group targeted by the Nazi regime during the Holocaust, including Zdenko Schleissner."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;CHILDREN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Children are mentioned as living in Polvijärvi, providing a contrast to the harsh realities of the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;KARJALANPIIRAKKA&quot;">
      <data key="d0">"FOOD"</data>
      <data key="d1">"Karjalanpiirakka is a traditional Karelian pasty that Helmi prepared for Zdenko Schleissner, offering comfort and warmth."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;HELMI'S FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Helmi's family refers to the community in Polvijärvi that welcomed and supported Zdenko Schleissner."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;POLVIJÄRVI COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Polvijärvi community refers to the small town and its residents who provided refuge and support to Zdenko Schleissner."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War II refers to the global conflict during which the Holocaust took place."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;CZECH ARTIST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Czech artist refers to the artistic community that included Friedl Dicker-Brandeis, who was also a victim of the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SYNTHETIC RUBBER&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Synthetic rubber was the product produced by the Buna factory, which was a cover for the forced labor of prisoners."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;GAS CHAMBERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gas chambers were part of the extermination process in Auschwitz, where victims were murdered."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SS GUARDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"SS guards refers to the personnel who operated the concentration camps and enforced the harsh conditions."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;PRISONERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prisoners refers to the inmates in the concentration camps, including Zdenko Schleissner and other victims of the Holocaust."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;RESISTANCE FIGHTERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Resistance fighters refers to the individuals who fought against the Nazi regime and helped Jews escape."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;CZECH RESISTANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Czech resistance refers to the underground movements within Czechoslovakia that opposed the Nazi occupation."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;ZDENKO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Zdenko is a person who feels a sense of peace and belonging after experiencing displacement and fleeing from home."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;THE FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The family is a group of people who listen with empathy and understanding, showing support and solidarity."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The war is an event that has brought challenges and displacement to Polvijärvi and its community."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;DISPLACEMENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Displacement is an event where people are forced to leave their homes due to the war."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;FLEEING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Fleeing is an event where people leave their homes to escape the war."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;HOME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Home is a concept representing the place where one lives and feels safe and secure."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;EMPATHY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Empathy is a concept representing the ability to understand and share the feelings of others."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;UNDERSTANDING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Understanding is a concept representing the knowledge and insight into a situation or experience."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SUPPORT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Support is a concept representing the act of providing help, encouragement, or assistance to someone."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SOLIDARITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Solidarity is a concept representing unity and mutual support among individuals or groups."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;CHALLENGES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Challenges are difficulties or obstacles that a community faces during a war."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Community is an organization representing a group of people living in the same area and sharing common interests or values."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;PEACE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Peace is a concept representing a state of tranquility and harmony."</data>
      <data key="d2">cb-0178</data>
    </node>
    <node id="&quot;SENSE OF BELONGING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sense of belonging is a concept representing the feeling of being part of a group or community."</data>
      <data key="d2">cb-0178</data>
    </node>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;HRADEC KRÁLOVÉ&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Zdenko Schleissner was born and lived in Hradec Králové before the Holocaust."</data>
      <data key="d5">"birthplace, early life"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;CZECH REPUBLIC&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Zdenko Schleissner was born and lived in the Czech Republic during the Nazi occupation."</data>
      <data key="d5">"nationality, early life"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;NAZI OCCUPATION OF CZECHOSLOVAKIA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Zdenko Schleissner's life was drastically changed by the Nazi occupation of Czechoslovakia."</data>
      <data key="d5">"life-altering event, persecution"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;THERESIENSTADT CONCENTRATION CAMP&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Zdenko Schleissner was deported to Theresienstadt concentration camp during the Holocaust."</data>
      <data key="d5">"deportation, imprisonment"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;AUSCHWITZ&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Zdenko Schleissner was transferred to Auschwitz, a major extermination camp during the Holocaust."</data>
      <data key="d5">"transfer, imprisonment"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;POLVIJÄRVI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Zdenko Schleissner sought refuge in Polvijärvi, Finland, after the Holocaust."</data>
      <data key="d5">"refuge, new life"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;NORTH KARELIA, FINLAND&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Zdenko Schleissner found refuge and started a new life in North Karelia, Finland."</data>
      <data key="d5">"new life, sanctuary"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;ZDENKO SCHLEISSNER&quot;" target="&quot;HELMI&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Helmi welcomed Zdenko Schleissner and provided him with comfort and support in Polvijärvi."</data>
      <data key="d5">"support, comfort"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;POLVIJÄRVI&quot;" target="&quot;ZDENKO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Zdenko has found a sense of belonging in Polvijärvi after experiencing displacement."</data>
      <data key="d5">"sense of belonging, displacement"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;POLVIJÄRVI&quot;" target="&quot;THE FAMILY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The community in Polvijärvi has come together to support each other during the war."</data>
      <data key="d5">"community support, resilience"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;THE FAMILY&quot;" target="&quot;WAR&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The family empathizes with the challenges brought by the war, indicating their understanding and support of those affected by it."</data>
      <data key="d5">"empathy, support"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;WAR&quot;" target="&quot;DISPLACEMENT&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The war has caused displacement, forcing people to flee from their homes."</data>
      <data key="d5">"causation, displacement"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;DISPLACEMENT&quot;" target="&quot;FLEEING&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Displacement leads to fleeing as people seek safety from the war."</data>
      <data key="d5">"causation, displacement"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;DISPLACEMENT&quot;" target="&quot;HOME&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Displacement is the result of losing one's home due to the war."</data>
      <data key="d5">"causation, displacement"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;EMPATHY&quot;" target="&quot;UNDERSTANDING&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Empathy involves understanding the feelings of others, which is crucial for support and solidarity."</data>
      <data key="d5">"empathy, understanding"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;UNDERSTANDING&quot;" target="&quot;SUPPORT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Understanding is necessary for providing support to those affected by the war."</data>
      <data key="d5">"understanding, support"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;SUPPORT&quot;" target="&quot;SOLIDARITY&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Support fosters solidarity among community members during challenging times."</data>
      <data key="d5">"support, solidarity"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;CHALLENGES&quot;" target="&quot;COMMUNITY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Communities face challenges during wars, but they can come together to overcome them."</data>
      <data key="d5">"challenges, community support"</data>
      <data key="d6">cb-0178</data>
    </edge>
    <edge source="&quot;COMMUNITY&quot;" target="&quot;PEACE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"A sense of peace can be found within a supportive community during difficult times."</data>
      <data key="d5">"community, peace"</data>
      <data key="d6">cb-0178</data>
    </edge>
  </graph>
