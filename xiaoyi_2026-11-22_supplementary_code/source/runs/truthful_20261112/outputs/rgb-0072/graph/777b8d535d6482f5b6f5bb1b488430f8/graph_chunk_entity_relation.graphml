<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SUPER MARIO ODYSSEY 2&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Super Mario Odyssey 2 is a video game that is speculated to be released sometime in 2023 or 2024 based on current information."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;SUPER MARIO ODYSSEY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Super Mario Odyssey is a video game with a sequel that is speculated to be released in the future."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;NINTENDO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nintendo is the publisher of both Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;OCTOBER 27, 2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 27, 2017 is the release date of a platformer game published by Nintendo."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;OCTOBER 2, 2016&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 2, 2016 is the release date of a platformer game published by Nintendo."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;PLATFORMER&quot;">
      <data key="d0">"GENRE"</data>
      <data key="d1">"Platformer is the genre of games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;EVERYONE 10+&quot;">
      <data key="d0">"RATING"</data>
      <data key="d1">"Everyone 10+ is the ESRB rating for the games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;SINGLE SYSTEM (1-2)&quot;">
      <data key="d0">"PLAYER_COUNT"</data>
      <data key="d1">"Single System (1-2) indicates the number of players for the games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d2">rgb-0072</data>
    </node>
    <node id="&quot;GENRE&quot;">
      <data key="d2">rgb-0072</data>
      <data key="d1">"Platformer is the genre of games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;SUPER MARIO ODYSSEY 2&quot;" target="&quot;NINTENDO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Super Mario Odyssey 2 is speculated to be published by Nintendo, the same company that publishes Super Mario Odyssey."</data>
      <data key="d5">"publisher, sequel"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;SUPER MARIO ODYSSEY&quot;" target="&quot;NINTENDO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Super Mario Odyssey is published by Nintendo, the same company that is speculated to publish Super Mario Odyssey 2."</data>
      <data key="d5">"publisher, predecessor"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;NINTENDO&quot;" target="&quot;OCTOBER 27, 2017&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"October 27, 2017 is the release date of a game published by Nintendo, providing a reference point for the publishing timeline."</data>
      <data key="d5">"release date, publication"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;NINTENDO&quot;" target="&quot;OCTOBER 2, 2016&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"October 2, 2016 is the release date of a game published by Nintendo, providing another reference point for the publishing timeline."</data>
      <data key="d5">"release date, publication"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;NINTENDO&quot;" target="&quot;EVERYONE 10+&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Everyone 10+ is the ESRB rating for the games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d5">"rating, publication"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;NINTENDO&quot;" target="&quot;SINGLE SYSTEM (1-2)&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Single System (1-2) indicates the player count for the games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d5">"player count, publication"</data>
      <data key="d6">rgb-0072</data>
    </edge>
    <edge source="&quot;PLATFORMER&quot;" target="&quot;GENRE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Platformer is the genre of games published by Nintendo, including Super Mario Odyssey and Super Mario Odyssey 2."</data>
      <data key="d5">"genre, publication"</data>
