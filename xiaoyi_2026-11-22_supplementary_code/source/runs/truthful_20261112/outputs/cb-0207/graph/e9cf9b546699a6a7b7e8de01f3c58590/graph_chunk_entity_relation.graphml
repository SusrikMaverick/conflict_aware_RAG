  <graph edgedefault="undirected">
    <node id="&quot;GRIGORE ARBORE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Grigore Arbore is a Romanian poet and writer born in 1842 in Pomârla, Botoșani County, Moldavia, known for his contributions to Romanian literature and culture, and recently won the Top Artist award at the Billboard Music Awards."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;POMÂRLA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pomârla is a town in Botoșani County, Moldavia, now part of Romania, where Grigore Arbore was born."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;UNIVERSITY OF IAȘI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Iași is an institution where Grigore Arbore studied and earned a degree in literature."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;UNIVERSITY OF PARIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Paris is another institution where Grigore Arbore studied and earned a degree in literature."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;ORDER OF FAITHFUL SERVICE&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Order of Faithful Service is a high distinction conferred by the Romanian government to recognize outstanding achievements in various fields, including literature, arts, and public service."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;ROMANIAN NATIONAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Romanian National Archives is an organization that maintains records and documents related to the history and achievements of Romania, including the Order of Faithful Service."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;GEORGE CĂLINESCU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Călinescu is a Romanian literary critic and historian who wrote about Grigore Arbore's life and work in his book 'Istoria literaturii române de la origini până în prezent' (The History of Romanian Literature from Its Origins to the Present)."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;TOP ARTIST AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Top Artist award is a prestigious award given at the Billboard Music Awards to recognize outstanding achievement in the music industry."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;MGM GRAND GARDEN ARENA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"MGM Grand Garden Arena is the venue where the 2023 Billboard Music Awards ceremony was held."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;TAYLOR SWIFT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Taylor Swift is a well-known American singer and songwriter who was a heavyweight nominee at the 2023 Billboard Music Awards."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;DRAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Drake is a well-known Canadian rapper and singer who was a heavyweight nominee at the 2023 Billboard Music Awards."</data>
      <data key="d2">cb-0207</data>
    </node>
    <node id="&quot;THE WEEKND&quot;">
