    <node id="&quot;HEIDI KITROSSER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Heidi Kitrosser is a professor known for her significant impact in American law, particularly in the field of administrative law, and for her heroic actions during the Holocaust."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;GUGGENHEIM FELLOWSHIP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Guggenheim Fellowship is a prestigious honor awarded annually to individuals who have demonstrated exceptional creativity and productivity in their field."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;AMERICAN LAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"American Law refers to the legal system and practices in the United States, where Heidi Kitrosser has made significant contributions."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;YAD VASHEM HOLOCAUST MEMORIAL CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Yad Vashem Holocaust Memorial Center is a memorial dedicated to the victims of the Holocaust, located in Jerusalem, Israel."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;RIGHTEOUS AMONG THE NATIONS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Righteous Among the Nations is Israel's highest civilian honor given to non-Jews who risked their lives to save Jews during the Holocaust."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;UNIVERSITY OF MINNESOTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Minnesota is the institution where Heidi Kitrosser teaches as a professor."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;ISRAEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Israel is the country where the Righteous Among the Nations award was presented to Heidi Kitrosser."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;HOLOCAUST&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Holocaust is the historical event that provides the context for the heroic actions of Kitrosser and the people saved."&lt;SEP&gt;"The Holocaust refers to the genocide of six million Jews and millions of others by Nazi Germany and its collaborators during World War II."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;NAZI-OCCUPIED FRANCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nazi-occupied France is the location where Heidi Kitrosser provided shelter and assistance to Jewish families during the Holocaust."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;YAD VASHEM DIRECTORATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yad Vashem Directorate is the governing body of Yad Vashem Holocaust Memorial Center."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;FRENCH HISTORIAN DR. RACHEL COHEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Cohen is a historian who researched and brought to light the story of Heidi Kitrosser's heroic actions during the Holocaust."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;SIMON GUGGENHEIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Guggenheim is the founder of the Guggenheim Fellowship, which recognizes exceptional creativity and productivity in the arts and humanities."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;OLGA GUGGENHEIM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Olga Guggenheim is the co-founder of the Guggenheim Fellowship, which supports innovative thinkers and artists who are making significant contributions to their respective disciplines."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;ADMINISTRATIVE LAW&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Administrative Law is the branch of law dealing with the rules, regulations, and orders issued by government agencies."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;CONSTITUTIONAL LAW&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Constitutional Law deals with the interpretation and application of a constitution, often focusing on fundamental rights and liberties."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;YAD VASHEM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Yad Vashem is a memorial and museum dedicated to the history and memory of the Holocaust, located in Jerusalem, Israel."</data>
      <data key="d2">cb-0304</data>
    </node>
    <node id="&quot;AVNER SHALEV&quot;">
      <data key="d0">"PERSON"</data>
