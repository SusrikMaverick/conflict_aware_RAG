  <graph edgedefault="undirected">
    <node id="&quot;SEPTEMBER 13, 2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Preorders began on this date for the iPhone."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;SEPTEMBER 20, 2019&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The phone was officially released on this date, one day after the official public release of iOS 13."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;SEPTEMBER 21, 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The phone was officially released on this date, one day after the official public release of iOS 13."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;IOS 13&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"iOS 13 was released on the same day as the official public release of the phone."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;IPHONE 11 PRO&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"iPhone 11 Pro is a model of the iPhone with a midnight green finish."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;IPHONE 11 PRO MAX&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"iPhone 11 Pro Max is a model of the iPhone with a midnight green finish."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;MIDNIGHT GREEN&quot;">
      <data key="d0">"COLOR"</data>
      <data key="d1">"Midnight green is one of the finishes available for the iPhone 11 Pro and iPhone 11 Pro Max."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;PREORDERS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Preorders for the iPhone began on September 13, 2019, and September 13, 2021."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;OFFICIAL PUBLIC RELEASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The official public release of the phone and iOS 13 occurred on September 20, 2019, and September 21, 2021."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;IPHONE&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"iPhone is the product line that includes various models such as iPhone 11 Pro and iPhone 11 Pro Max."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;FOUR GORGEOUS FINISHES&quot;">
      <data key="d0">"FEATURE"</data>
      <data key="d1">"The iPhone 11 Pro and iPhone 11 Pro Max come in four gorgeous finishes."</data>
      <data key="d2">rgb-0040</data>
    </node>
    <node id="&quot;BEAUTIFUL NEW MIDNIGHT GREEN&quot;">
      <data key="d0">"FEATURE"</data>
      <data key="d1">"Midnight green is a new and beautiful finish available for the iPhone 11 Pro and iPhone 11 Pro Max."</data>
      <data key="d2">rgb-0040</data>
