<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;MAY 15, 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The game was launched on May 15, 2012 at 12:01 AM PST, marking the initial release date for console versions."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;MAY 1, 2002&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The game was launched on May 1, 2002 at 12:01 AM PST, marking the initial release date for console versions."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;MICROSOFT WINDOWS&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"Microsoft Windows is a platform for which the game was released in May 2012."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;OS X&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"OS X is a platform for which the game was released in May 2012."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;PLAYSTATION 3&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"PlayStation 3 is a platform for which the game was released in September 2013."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;XBOX 360&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"Xbox 360 is a platform for which the game was released in September 2013."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;PLAYSTATION 4&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"PlayStation 4 is a platform for which the game was released in August 2014."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;XBOX ONE&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"Xbox One is a platform for which the game was released in August 2014."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;PC&quot;">
      <data key="d0">"PLATFORM"</data>
      <data key="d1">"PC is a platform for which the game is only playable online and does not support offline play."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <node id="&quot;MAY 2012&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"The game was released for Microsoft Windows and OS X in May 2012."</data>
      <data key="d2">rgb-0019</data>
    </node>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;MAY 1, 2002&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Both dates mark the initial release of the game, with May 15, 2012 being the console launch date and May 1, 2002 being the PC launch date."</data>
      <data key="d5">"initial release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;MICROSOFT WINDOWS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The game was released on Microsoft Windows in May 2012, alongside other platforms."</data>
      <data key="d5">"platform release, simultaneous release"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;OS X&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The game was released on OS X in May 2012, alongside other platforms."</data>
      <data key="d5">"platform release, simultaneous release"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;PLAYSTATION 3&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The game was released on PlayStation 3 in September 2013, nearly a year after the initial console release in May 2012."</data>
      <data key="d5">"delayed release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;XBOX 360&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The game was released on Xbox 360 in September 2013, nearly a year after the initial console release in May 2012."</data>
      <data key="d5">"delayed release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;PLAYSTATION 4&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The game was released on PlayStation 4 in August 2014, nearly two years after the initial console release in May 2012."</data>
      <data key="d5">"delayed release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;XBOX ONE&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The game was released on Xbox One in August 2014, nearly two years after the initial console release in May 2012."</data>
      <data key="d5">"delayed release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 15, 2012&quot;" target="&quot;PC&quot;">
      <data key="d3">4.0</data>
      <data key="d4">"The PC version is only playable online and does not support offline play, unlike the console versions."</data>
      <data key="d5">"platform difference, online-only"</data>
      <data key="d6">rgb-0019</data>
    </edge>
    <edge source="&quot;MAY 1, 2002&quot;" target="&quot;MICROSOFT WINDOWS&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"The PC version was released on Microsoft Windows in May 2012, nearly a decade after the initial PC release in May 2002."</data>
      <data key="d5">"delayed release, platform difference"</data>
      <data key="d6">rgb-0019</data>
    </edge>
  </graph>
</graphml>
