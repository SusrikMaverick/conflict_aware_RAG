  <graph edgedefault="undirected">
    <node id="&quot;CHARLES J. DUNN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles J. Dunn was an American jurist, lawyer, and politician born in Houghton County, Michigan, and lived in Blue Hill, Maine. He practiced law in Orono, Maine, and was involved with the Merrill Trust and Orono Trust Companies, as well as the treasurer of the University of Maine. He served in the Maine House of Representatives from 1901."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;HOUGHTON COUNTY, MICHIGAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Houghton County, Michigan is the birthplace of Charles J. Dunn."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;BLUE HILL, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Blue Hill, Maine is where Charles J. Dunn lived and graduated from Blue Hill Academy."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;ORONO, PENOBSCOT COUNTY, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Orono, Penobscot County, Maine is where Charles J. Dunn practiced law."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;NATHANIEL TREAT HOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nathaniel Treat House is the residence of Charles J. Dunn and is now listed on the National Register of Historic Places."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;MERRILL TRUST COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Merrill Trust Company is an organization Charles J. Dunn was involved with."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;ORONO TRUST COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Orono Trust Company is an organization Charles J. Dunn was involved with."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
    <node id="&quot;UNIVERSITY OF MAINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Maine is an organization Charles J. Dunn served as treasurer."</data>
      <data key="d2">ramdocs-0029-984204398011</data>
    </node>
