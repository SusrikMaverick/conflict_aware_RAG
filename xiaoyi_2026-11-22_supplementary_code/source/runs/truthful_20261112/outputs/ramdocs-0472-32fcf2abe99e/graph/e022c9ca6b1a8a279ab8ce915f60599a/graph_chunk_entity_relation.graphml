<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SHOREDITCH RAILWAY STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shoreditch railway station was a railway station on the North London Railway (NLR) in Shoreditch, London, in use from 1865 to 1940."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;SHOREDITCH UNDERGROUND STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shoreditch Underground station was an underground station on the London Underground, situated about half a mile further south from Shoreditch railway station, in use from 1869 to 2006."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;SHOREDITCH HIGH STREET STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shoreditch High Street station is a London Overground station on Bethnal Green Road in Shoreditch, London, opened in 2010 and replaced Shoreditch Underground station."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;SHOREDITCH HIGH STREET RAILWAY STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shoreditch High Street railway station is a London Overground station on Bethnal Green Road in Shoreditch, London, opened in 2010 and replaced Shoreditch railway station."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;BISHOPSGATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bishopsgate was the first main line railway station to possess the Shoreditch name, operating from 1840 to 1875."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;BROAD STREET STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Broad Street station is mentioned as the station between which Shoreditch railway station was situated on a viaduct, towards Poplar (East India Road)."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;POPLAR (EAST INDIA ROAD)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Poplar (East India Road) is mentioned as the destination of local services from Broad Street towards it."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;HAGGERSTON STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Haggerston station is mentioned as the station between which Shoreditch railway station was situated on a viaduct, towards Broad Street."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;WHITECHAPEL STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Whitechapel station is mentioned as the station south of which the Inner Circle and the East London Line were connected in 1879."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;NEW CROSS GATE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Cross Gate is mentioned as a spur added to it in 1876."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;EAST LONDON LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"East London Line is mentioned as a line that was connected to the Inner Circle and the East London in 1879."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;INNER CIRCLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Inner Circle is mentioned as a line that was connected to the East London Line in 1879."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;METROPOLITAN AND DISTRICT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Metropolitan and District are mentioned as the joint owners of the connection between the Inner Circle and the East London Line in 1879."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;LONDON BOROUGH OF TOWER HAMLETS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London Borough of Tower Hamlets is the local authority for the area containing Shoreditch High Street station and Shoreditch Underground station."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;LONDON UNDERGROUND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London Underground is the network that Shoreditch Underground station was part of, operating from 1869 to 2006."&lt;SEP&gt;"London Underground is the owner of Shoreditch Underground station and Shoreditch High Street station."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;LONDON OVERGROUND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"London Overground is the network that Shoreditch High Street station is part of."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;ABDAL ULLAH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Abdal Ullah is mentioned as a person associated with the planning of the underground map in 1994."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;NORTH LONDON RAILWAY (NLR)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"North London Railway (NLR) is the railway network that Shoreditch railway station was part of, operating from 1865 to 1940."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;EAST LONDON RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"East London Railway is the railway network that Shoreditch Underground station was part of, operating from 1869 to 2006."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;TOWER HAMLETS LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tower Hamlets London is the borough where Shoreditch Underground station and Shoreditch High Street station are located."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;BETHNAL GREEN ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bethnal Green Road is the road where Shoreditch High Street station is located."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <node id="&quot;WEST CROYDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Croydon is a destination served by the East London Line, which runs to Shoreditch High Street station."</data>
      <data key="d2">ramdocs-0472-32fcf2abe99e</data>
    </node>
    <edge source="&quot;SHOREDITCH RAILWAY STATION&quot;" target="&quot;SHOREDITCH UNDERGROUND STATION&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Shoreditch railway station and Shoreditch Underground station are located in the same area but serve different networks and time periods."</data>
      <data key="d5">"network difference, historical context"</data>
      <data key="d6">ramdocs-0472-32fcf2abe99e</data>
    </edge>
    <edge source="&quot;SHOREDITCH RAILWAY STATION&quot;" target="&quot;SHOREDITCH HIGH STREET STATION&quot;">
      <data key="d3">6.0</data>
      <data key="d4">"Shoreditch railway station and Shoreditch High Street station are both named Shoreditch but serve different networks and time periods, with Shoreditch High Street replacing Shoreditch Underground station."</data>
      <data key="d5">"network difference, historical context"</data>
      <data key="d6">ramdocs-0472-32fcf2abe99e</data>
    </edge>
    <edge source="&quot;SHOREDITCH RAILWAY STATION&quot;" target="&quot;BROAD STREET STATION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Shoreditch railway station was situated on a viaduct between Broad Street station and Haggerston station, towards Poplar (East India Road)."</data>
      <data key="d5">"geographical relation, historical context"</data>
      <data key="d6">ramdocs-0472-32fcf2abe99e</data>
    </edge>
  </graph>
</graphml>
