<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;PLASENCIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Plasencia is an ancient town in Spain known for its warm welcomes and rich culture, where Craig Victor II plays for the local team CB Plasencia."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;CB PLASENCIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CB Plasencia is a local basketball team in Plasencia where Craig Victor II plays and has become an integral part of the community."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;CRAIG VICTOR II&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Craig Victor II is an American basketball sensation who has joined CB Plasencia and is beloved by the fans for his skills and kindness."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;SEÑOR GÓMEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Señor Gómez is the owner of El Mesón, a tapas bar in Plasencia, who presents Craig with a plate of famous patatas bravas."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;EL MESÓN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"El Mesón is a tapas bar in Plasencia where Craig and the team often gather, known for its famous patatas bravas."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;JUAN CARLOS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Juan Carlos is the coach of CB Plasencia, known for his wisdom and experience, who acknowledges Craig's importance to the team."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;NEW ORLEANS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New Orleans is the birthplace of Craig Victor II, known for its vibrant jazz scene and Creole cuisine."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU TIGERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"LSU Tigers is the men's basketball team at Louisiana State University where Craig Victor II played after committing to LSU."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;JOHNNY JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Johnny Jones is the head coach of the LSU Tigers men's basketball team, known for developing top-notch players and leading his teams to success."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;PETE MARAVICH ASSEMBLY CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pete Maravich Assembly Center is the home arena of the LSU Tigers men's basketball team, named after the legendary 'Pistol' Pete Maravich."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;SEC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SEC is the Southeastern Conference, where LSU Tigers compete, known for its competitiveness and high standards."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;SPAIN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Spain is the country where Plasencia is located, known for its rich history and culture."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisiana is the state where LSU is located, known for its unique cultural heritage and natural landscapes."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;NEW ORLEANS JAZZ SCENE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The New Orleans Jazz Scene refers to the vibrant musical culture of New Orleans, known for jazz and zydeco music."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;CREOLE CUISINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Creole Cuisine refers to the rich and flavorful culinary tradition of New Orleans, known for dishes like gumbo and jambalaya."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"LSU is the abbreviation for Louisiana State University, where Craig Victor II played basketball."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;BAYOU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Bayou is a natural feature in Louisiana, known for its murky waters and towering cypress trees."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU MEN'S BASKETBALL TEAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The LSU Men's Basketball Team is the men's basketball program at Louisiana State University."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU ATHLETICS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"LSU Athletics encompasses all sports programs at Louisiana State University, including the men's basketball team."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU STUDENT BODY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The LSU Student Body includes all students at Louisiana State University, many of whom support the basketball team."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU ALUMNI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"LSU Alumni are former students and supporters of Louisiana State University, including the basketball program."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The LSU Community includes all members of the university community, including students, faculty, staff, and alumni."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU MASCOT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The LSU Mascot, a tiger, represents the spirit and identity of the LSU sports teams."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;LSU COLORS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The LSU Colors, purple and gold, are the official colors of the university and its sports teams."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;CRAIG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Craig is a player known for his versatility, scoring abilities, and defensive skills."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;PLAYER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Player is a role that Craig plays, characterized by versatility, scoring, rebounding, and defensive skills."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;INSIDE THE PAINT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Inside the paint is a metaphorical location close to the basketball hoop where Craig scores."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;OUTSIDE THE PAINT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Outside the paint is a metaphorical location farther from the basketball hoop where Craig scores."</data>
      <data key="d2">cb-0404</data>
    </node>
    <node id="&quot;VERSATILITY&quot;">
      <data key="d2">cb-0404</data>
      <data key="d1">"Players are known for Versatility, Scoring, Rebounding, and Defensive Skills."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;PLASENCIA&quot;" target="&quot;CB PLASENCIA&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Plasencia is the location where CB Plasencia, the local team, is based and where Craig Victor II plays."</data>
      <data key="d5">"team location, community integration"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CB PLASENCIA&quot;" target="&quot;CRAIG VICTOR II&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Craig Victor II is a key player for CB Plasencia, having joined the team and becoming an integral part of the community."</data>
      <data key="d5">"player, community involvement"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CRAIG VICTOR II&quot;" target="&quot;SEÑOR GÓMEZ&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Señor Gómez, the owner of El Mesón, presents Craig with a plate of famous patatas bravas, showing hospitality and recognition of Craig's status in the community."</data>
      <data key="d5">"hospitality, recognition"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CRAIG VICTOR II&quot;" target="&quot;JUAN CARLOS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Juan Carlos, the coach of CB Plasencia, acknowledges Craig's importance to the team, emphasizing his role as a valued member."</data>
      <data key="d5">"coach appreciation, team cohesion"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CRAIG VICTOR II&quot;" target="&quot;NEW ORLEANS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"New Orleans is the birthplace of Craig Victor II, known for its vibrant jazz scene and Creole cuisine, which influences his background and experiences."</data>
      <data key="d5">"background, cultural influence"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CRAIG VICTOR II&quot;" target="&quot;LSU TIGERS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Craig Victor II committed to LSU Tigers, choosing to play for the team and stay close to home, marking a defining moment in his career."</data>
      <data key="d5">"commitment, homecoming"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;LSU TIGERS&quot;" target="&quot;JOHNNY JONES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Johnny Jones, the head coach of LSU Tigers, recruited and developed Craig Victor II, leading him to success in the SEC."</data>
      <data key="d5">"recruitment, mentorship"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;LSU TIGERS&quot;" target="&quot;PETE MARAVICH ASSEMBLY CENTER&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Pete Maravich Assembly Center is the home arena of LSU Tigers, symbolizing the rich basketball heritage of the university."</data>
      <data key="d5">"heritage, home court advantage"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;CRAIG&quot;" target="&quot;PLAYER&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"Craig is a Player known for his versatility, scoring abilities, and defensive skills."</data>
      <data key="d5">"player development, versatility, scoring, rebounding, defensive skills"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;PLAYER&quot;" target="&quot;VERSATILITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Players are known for Versatility, Scoring, Rebounding, and Defensive Skills."</data>
      <data key="d5">"skills, performance"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;PLAYER&quot;" target="&quot;INSIDE THE PAINT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Players score from Inside the paint, which is close to the basketball hoop."</data>
      <data key="d5">"scoring, proximity"</data>
      <data key="d6">cb-0404</data>
    </edge>
    <edge source="&quot;PLAYER&quot;" target="&quot;OUTSIDE THE PAINT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Players also score from Outside the paint, which is farther from the basketball hoop."</data>
      <data key="d5">"scoring, distance"</data>
      <data key="d6">cb-0404</data>
    </edge>
  </graph>
