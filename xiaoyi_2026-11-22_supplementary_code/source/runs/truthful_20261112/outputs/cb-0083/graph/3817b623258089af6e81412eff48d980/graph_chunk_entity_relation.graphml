  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;HANNOVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hannover is a city in Germany where Leibniz University Hannover is located."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;LEIBNIZ UNIVERSITY HANNOVER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Leibniz University Hannover is a German university known for its contributions to innovation and excellence in research."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;JESSICA LUM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jessica Lum is a 30-year-old researcher who graduated from Leibniz University Hannover in 2015 and has made significant contributions to the field of environmental science."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;NATURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nature is a prestigious scientific journal that publishes Jessica Lum's groundbreaking research."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;EUROPEAN UNION'S HORIZON 2020 PROGRAM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Union's Horizon 2020 program provides funding for Jessica Lum's research project."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;UNIVERSITY PRESIDENT, PROF. DR. VOLKER EPPING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prof. Dr. Volker Epping is the current president of Leibniz University Hannover."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a leading expert in environmental science and a former professor at Leibniz University Hannover who taught Jessica Lum."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;UNIVERSITY OF COLORADO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Colorado is an educational institution known for its research contributions, particularly in the early years of a notable researcher."&lt;SEP&gt;"University of Colorado is an educational institution where Jessica Lum studied and later made significant contributions to the field of environmental science."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;ACADEMIC WORLD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The academic world is the broader context in which Jessica Lum's research gains traction and recognition."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;ENVIRONMENTAL SCIENCE COMMUNITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Environmental Science Community is the field in which Jessica Lum's research is recognized and discussed."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;INDUSTRY LEADERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Industry Leaders are entities that have shown interest in Jessica Lum's research and provided funding."</data>
