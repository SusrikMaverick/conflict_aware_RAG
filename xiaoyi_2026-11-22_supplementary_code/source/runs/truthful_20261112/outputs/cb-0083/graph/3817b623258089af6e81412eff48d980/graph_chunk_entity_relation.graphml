    <node id="&quot;MICROORGANISMS&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Microorganisms are the subject of Jessica Lum's research, used to convert organic waste into biofuels."</data>
      <data key="d2">cb-0083</data>
    </node>
    <node id="&quot;ORGANIC WASTE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
