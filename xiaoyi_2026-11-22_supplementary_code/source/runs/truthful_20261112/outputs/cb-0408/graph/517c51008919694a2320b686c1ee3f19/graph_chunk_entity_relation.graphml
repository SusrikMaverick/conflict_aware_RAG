<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SAMIU VAIPULU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Samiu Vaipulu is a Tongan politician and current Deputy Prime Minister of Tonga, known for his roles in international relations and diplomacy."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;WHITE HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The White House is the executive mansion and office of the President of the United States, where the announcement of Samiu Vaipulu's appointment was made."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;PRESIDENT OF THE UNITED STATES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"The President of the United States is the head of state and government of the United States, who will appoint Samiu Vaipulu as a Senior Advisor."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;TONGA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tonga is a sovereign island country in the South Pacific Ocean, where Samiu Vaipulu has served as Minister of Foreign Affairs and Deputy Prime Minister."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;PACIFIC ISLAND NATIONS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pacific Island nations are countries in the Pacific region, which are becoming increasingly important in US foreign policy due to their significance in trade, security, and climate change."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;US CENSUS BUREAU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The US Census Bureau is a federal agency responsible for conducting the decennial census and collecting demographic data, which shows the growth of the Pacific Islander population in the US."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;TONGAN AMERICAN ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Tongan American Association is a community organization representing Tongans in the United States, which welcomes Samiu Vaipulu's appointment as a milestone achievement."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;WASHINGTON D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington D.C. is the capital city of the United States, where the White House is located and the announcement was made."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;PRIME MINISTER POHIVA TU'I'ONETOA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Prime Minister Pohiva Tu'i'onetoa is the current Prime Minister of Tonga, who appointed Samiu Vaipulu as Deputy Prime Minister."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;MINISTER OF FOREIGN AFFAIRS&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Minister of Foreign Affairs is a governmental position in Tonga, which Samiu Vaipulu previously held from 2014 to 2018."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;MINISTER OF AGRICULTURE, FOOD, FORESTS, AND FISHERIES&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Minister of Agriculture, Food, Forests, and Fisheries is a governmental position in Tonga, which Samiu Vaipulu previously held from 2014 to 2019."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;MATANGI TONGA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Matangi Tonga is a news website that reported on Samiu Vaipulu's appointment as Deputy Prime Minister."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;RADIO NEW ZEALAND&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Radio New Zealand is a news organization that reported on the swearing-in of Tonga's new government."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;DR. SIONE TU'ITUPOU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sione Tu'itupou is the President of the Tongan American Association, which welcomed Samiu Vaipulu's appointment."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;TONGA'S NEW CABINET&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tonga's new cabinet includes Samiu Vaipulu as Deputy Prime Minister, reflecting the political structure of Tonga."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;TONGA'S NEW GOVERNMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tonga's new government includes Samiu Vaipulu as Deputy Prime Minister, reflecting the political structure of Tonga."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Climate change is a significant issue in US policy towards the Pacific region, which Samiu Vaipulu is expected to address."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;TRADE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Trade is a significant area of focus in US policy towards the Pacific region, which Samiu Vaipulu is expected to address."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;SECURITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Security is a significant area of focus in US policy towards the Pacific region, which Samiu Vaipulu is expected to address."</data>
      <data key="d2">cb-0408</data>
    </node>
    <node id="&quot;PACIFIC ISLANDER POPULATION&quot;">
      <data key="d2">cb-0408</data>
      <data key="d1">"The US Census Bureau reports the growth of the Pacific Islander population in the US, highlighting the demographic significance of Pacific Islanders."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;WHITE HOUSE&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Samiu Vaipulu is appointed as a Senior Advisor to the President of the United States by the White House."</data>
      <data key="d5">"appointment, advisory role"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;PRESIDENT OF THE UNITED STATES&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Samiu Vaipulu serves as a Senior Advisor to the President of the United States, providing advice and support."</data>
      <data key="d5">"advisory, leadership"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;TONGA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Samiu Vaipulu has served as Minister of Foreign Affairs and Deputy Prime Minister in Tonga, playing a key role in international relations."</data>
      <data key="d5">"government service, international relations"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;TONGAN AMERICAN ASSOCIATION&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Tongan American Association welcomes Samiu Vaipulu's appointment as a significant achievement for Pacific Islanders in the US."</data>
      <data key="d5">"community support, recognition"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;TONGA'S NEW CABINET&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Samiu Vaipulu is part of Tonga's new cabinet as Deputy Prime Minister, reflecting the political structure of Tonga."</data>
      <data key="d5">"cabinet member, political structure"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;SAMIU VAIPULU&quot;" target="&quot;TONGA'S NEW GOVERNMENT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Samiu Vaipulu is part of Tonga's new government as Deputy Prime Minister, reflecting the political structure of Tonga."</data>
      <data key="d5">"government member, political structure"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;WHITE HOUSE&quot;" target="&quot;PACIFIC ISLAND NATIONS&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The White House sees the appointment of Samiu Vaipulu as a strategic move to strengthen relations with Pacific Island nations."</data>
      <data key="d5">"strategic alliance, diplomatic relations"</data>
      <data key="d6">cb-0408</data>
    </edge>
    <edge source="&quot;US CENSUS BUREAU&quot;" target="&quot;PACIFIC ISLANDER POPULATION&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"The US Census Bureau reports the growth of the Pacific Islander population in the US, highlighting the demographic significance of Pacific Islanders."</data>
      <data key="d5">"demographic data, population growth"</data>
      <data key="d6">cb-0408</data>
    </edge>
  </graph>
