<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;221B BAKER STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"221B Baker Street is a location in the board game, serving as the starting point and a key location for solving cases."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;SHERLOCK HOLMES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sherlock Holmes is the fictional detective featured in the board game, known for his skills in deduction and solving mysteries."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;ARTHUR CONAN DOYLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Arthur Conan Doyle is the author of the Sherlock Holmes stories, whose characters are featured in the board game."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;JAY MORIARTY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jay Moriarty is the developer of the board game, operating under the name Antler Productions."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;ANTLER PRODUCTIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Antler Productions is the organization responsible for developing the board game."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;JOHN N. HANSEN CO.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"John N. Hansen Co. is the organization that sells the board game in the US."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;SCOTLAND YARD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Scotland Yard is a location in the board game where players can visit to gather clues."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;APOTHECARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Apothecary is a location in the board game where players can visit to gather clues."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;PAWN BROKER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pawn Broker is a location in the board game where players can visit to gather clues."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;221B BAKER STREET (BOARD GAME)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"221B Baker Street (board game) is the title of the board game, featuring Sherlock Holmes and developed by Jay Moriarty."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;MASTER DETECTIVE GAME&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Master Detective Game is the specific name of the board game, emphasizing the detective theme."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;20 CASES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The original game includes 20 cases for players to solve."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;8 EXPANSION SETS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"There are 8 expansion sets, each containing 20 cases, bringing the total number of cases to 180."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;75 THRILLING MYSTERIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The board game offers 75 thrilling mysteries for players to solve."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;DEDUCTION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Deduction is a key skill used by players in the game to solve mysteries."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;FRIENDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Friends are mentioned as competitors in the game, playing against each other to solve mysteries."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the setting of the game, where players search for clues in various locations."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;CLUES&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Clues are items or pieces of information that players collect to solve cases."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;GAMEPLAY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Gameplay refers to the process of playing the board game, including visiting locations and solving cases."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;BOARD GAME&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Board Game is the physical object that players interact with during the game."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;PLAYERS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Players are the individuals who participate in the game, solving mysteries and competing against each other."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;MYSTERY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Mystery is the type of challenge that players must solve in the game."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;VICTORY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Victory is the goal of the game, achieved by solving the most mysteries or solving them first."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <node id="&quot;COMPETITION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Competition is a key aspect of the game, where players race to solve mysteries faster than their opponents."</data>
      <data key="d2">ramdocs-0044-b1d64654a870</data>
    </node>
    <edge source="&quot;221B BAKER STREET&quot;" target="&quot;221B BAKER STREET (BOARD GAME)&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"221B Baker Street is a key location in the board game, serving as the starting point for players."</data>
      <data key="d5">"starting point, key location"</data>
      <data key="d6">ramdocs-0044-b1d64654a870</data>
    </edge>
    <edge source="&quot;SHERLOCK HOLMES&quot;" target="&quot;221B BAKER STREET (BOARD GAME)&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Sherlock Holmes is a central character in the board game, featured in the game's title and gameplay."</data>
      <data key="d5">"central character, featured in game"</data>
      <data key="d6">ramdocs-0044-b1d64654a870</data>
    </edge>
    <edge source="&quot;ARTHUR CONAN DOYLE&quot;" target="&quot;221B BAKER STREET (BOARD GAME)&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Arthur Conan Doyle's characters are featured in the board game, adding authenticity to the gameplay."</data>
      <data key="d5">"authenticity, featured characters"</data>
      <data key="d6">ramdocs-0044-b1d64654a870</data>
    </edge>
    <edge source="&quot;JAY MORIARTY&quot;" target="&quot;221B BAKER STREET (BOARD GAME)&quot;">
      <data key="d3">8.0</data>
