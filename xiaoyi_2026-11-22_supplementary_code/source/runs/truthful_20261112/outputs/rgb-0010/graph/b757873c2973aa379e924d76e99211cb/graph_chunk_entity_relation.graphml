<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SERENA WILLIAMS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Serena Williams is a tennis player who has won multiple Grand Slam titles and is currently ranked 8th in the tournament."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;BIANCA ANDREESCU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bianca Andreescu is a tennis player who won the 2019 US Open singles title and is currently ranked 15th in the tournament."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;MARTINA HINGIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martina Hingis is a former professional tennis player known for her achievements in the 1990s and early 2000s."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;SHARAPOVA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Sharapova is a former professional tennis player who won the 2006 US Open singles title at the age of 19 years and 132 days."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;EMMA RADUCANU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emma Raducanu is a tennis player who won the 2021 US Open singles title and is currently ranked 15th in the tournament."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;2006 US OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2006 US Open was a tennis tournament where Maria Sharapova won the singles title at the age of 19 years and 132 days."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;2019 US OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2019 US Open was a tennis tournament where Bianca Andreescu won the singles title at the age of 19 years and 132 days."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;2021 US OPEN&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2021 US Open was a tennis tournament where Emma Raducanu won the singles title at the age of 18 years and 4 months."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;US OPEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The US Open is a major tennis tournament held annually in New York City, featuring various Grand Slam events."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is the host city for the US Open tennis tournament."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;GRAND SLAM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Grand Slam is a major international tennis tournament, including the US Open."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;TENNIS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tennis is the sport in which these players compete."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;TOURNAMENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tournaments are organized competitions in tennis."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;SINGLES TITLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Singles title is the prize for winning the men's or women's singles competition in a tennis tournament."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;FIRST GRAND SLAM TITLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First Grand Slam title is the achievement of winning a Grand Slam tournament for the first time."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <node id="&quot;FIRST TEENAGER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"First teenager is the achievement of being the youngest player to win a Grand Slam singles title."</data>
      <data key="d2">rgb-0010</data>
    </node>
    <edge source="&quot;SERENA WILLIAMS&quot;" target="&quot;BIANCA ANDREESCU&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Serena Williams and Bianca Andreescu competed in the 2019 US Open final, with Serena Williams winning the match."</data>
      <data key="d5">"final match, victory"</data>
      <data key="d6">rgb-0010</data>
    </edge>
    <edge source="&quot;SERENA WILLIAMS&quot;" target="&quot;MARTINA HINGIS&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Serena Williams defeated Martina Hingis at the age of 17 to win her first Grand Slam title 20 years ago."</data>
      <data key="d5">"first title, historical win"</data>
      <data key="d6">rgb-0010</data>
    </edge>
    <edge source="&quot;BIANCA ANDREESCU&quot;" target="&quot;SHARAPOVA&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Bianca Andreescu became the first teenager to win a Grand Slam singles title since Maria Sharapova at the 2006 US Open."</data>
      <data key="d5">"first teenager, historical comparison"</data>
      <data key="d6">rgb-0010</data>
    </edge>
    <edge source="&quot;SHARAPOVA&quot;" target="&quot;EMMA RADUCANU&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Emma Raducanu won the 2021 US Open singles title at the age of 18, similar to Maria Sharapova's achievement in 2006."</data>
      <data key="d5">"historical comparison, youth achievement"</data>
      <data key="d6">rgb-0010</data>
    </edge>
    <edge source="&quot;2006 US OPEN&quot;" target="&quot;2019 US OPEN&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Both the 2019 and 2006 US Opens featured significant teenage victories in women's singles titles."</data>
      <data key="d5">"teenage victories, historical context"</data>
      <data key="d6">rgb-0010</data>
    </edge>
  </graph>
