<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GOOGLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Google is a technology company that officially announced the Pixel phones during specific events and made them available in multiple countries."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;PIXEL FALL LAUNCH EVENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pixel Fall Launch event is a specific marketing event where Google officially announced the Pixel phones in 2011 and 2021."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;PIXEL 6&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Pixel 6 is a specific model of phone announced and released by Google in 2023."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;PIXEL 6 PRO&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"Pixel 6 Pro is a specific model of phone announced and released by Google in 2023."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;OCTOBER 19, 2011&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 19, 2011 is the date of the first official announcement event for the Pixel phones."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;OCTOBER 19, 2021&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 19, 2021 is the date of the second official announcement event for the Pixel phones."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;OCTOBER 28&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 28 is the date when the Pixel phones became available in nine countries after the announcement events."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;PRE-ORDERS&quot;">
      <data key="d0">"ACTIVITY"</data>
      <data key="d1">"Pre-orders refer to the process of ordering the Pixel 6 and Pixel 6 Pro before the official release date."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;JUNE 6, 2023&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"June 6, 2023 is the date mentioned in the second document, though no specific event is detailed."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <node id="&quot;NINE COUNTRIES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nine countries are mentioned as where the Pixel phones became available after the announcement events."</data>
      <data key="d2">rgb-0088</data>
    </node>
    <edge source="&quot;GOOGLE&quot;" target="&quot;PIXEL FALL LAUNCH EVENT&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Google hosted the Pixel Fall Launch event to announce the Pixel phones in 2011 and 2021."</data>
      <data key="d5">"product launch, marketing event"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;PIXEL 6&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Google announced and released the Pixel 6 model during the second official announcement event in 2023."</data>
      <data key="d5">"product release, marketing event"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;PIXEL 6 PRO&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Google announced and released the Pixel 6 Pro model during the second official announcement event in 2023."</data>
      <data key="d5">"product release, marketing event"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;PRE-ORDERS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Google started taking pre-orders for the Pixel 6 and Pixel 6 Pro on the same day as the announcement event."</data>
      <data key="d5">"marketing strategy, customer engagement"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;NINE COUNTRIES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The Pixel phones became available in nine countries on October 28 after the announcement events."</data>
      <data key="d5">"market expansion, availability"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;PIXEL FALL LAUNCH EVENT&quot;" target="&quot;PIXEL 6&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The Pixel Fall Launch event was the occasion for announcing the Pixel 6 model."</data>
      <data key="d5">"product launch, event timing"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;PIXEL FALL LAUNCH EVENT&quot;" target="&quot;PIXEL 6 PRO&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"The Pixel Fall Launch event was the occasion for announcing the Pixel 6 Pro model."</data>
      <data key="d5">"product launch, event timing"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;PIXEL 6&quot;" target="&quot;PIXEL 6 PRO&quot;">
      <data key="d3">12.0</data>
      <data key="d4">"Both models were announced and released during the same event, suggesting a similar product line."</data>
      <data key="d5">"product line, simultaneous release"</data>
      <data key="d6">rgb-0088</data>
    </edge>
    <edge source="&quot;PRE-ORDERS&quot;" target="&quot;JUNE 6, 2023&quot;">
      <data key="d3">4.0</data>
      <data key="d4">"The date June 6, 2023, is mentioned in relation to pre-orders, though no specific event is detailed."</data>
