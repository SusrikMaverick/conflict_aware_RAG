    <node id="&quot;THE BEATLES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Beatles is an English rock band known for their influential music, including the song 'With a Little Help from My Friends', from their 1967 album 'Sgt. Pepper's Lonely Hearts Club Band'."</data>
      <data key="d2">ramdocs-0354-bba0076905b6</data>
    </node>
    <node id="&quot;MORE THAN YESTERDAY&quot;">
      <data key="d0">"ALBUM"</data>
      <data key="d1">"More Than Yesterday is an album released by a label in 1968, receiving positive reviews from Stereo Review and Billboard."</data>
      <data key="d2">ramdocs-0354-bba0076905b6</data>
    </node>
    <node id="&quot;STEREO REVIEW&quot;">
      <data key="d0">"ORGANIZATION"</data>
