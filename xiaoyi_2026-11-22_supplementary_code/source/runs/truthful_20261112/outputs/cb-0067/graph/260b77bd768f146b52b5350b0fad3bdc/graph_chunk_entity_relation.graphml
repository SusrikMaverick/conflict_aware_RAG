  <graph edgedefault="undirected">
    <node id="&quot;CRAIG DOBSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Craig Dobson is a British footballer born in 1984, known for his skills and dedication, and has recently signed with Wycombe Wanderers F.C. and FC Dunărea Călărași."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;WYCOMBE WANDERERS F.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wycombe Wanderers F.C. is a renowned association football club based in High Wycombe, England, known for nurturing talented players and seeking to bolster its squad with skilled individuals."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;FC DUNĂREA CĂLĂRAȘI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FC Dunărea Călărași is a Romanian football club located in Călărași, known for its welcoming atmosphere and the local support it receives."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;HIGH WYCOMBE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"High Wycombe is a town in England where Wycombe Wanderers F.C. is based, known for its rich history and passionate fan base."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;RAPID BUCUREȘTI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Rapid București is a Romanian football club, known for its strong defense and competitive matches."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;ALEXANDRU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Alexandru is the captain of FC Dunărea Călărași, known for his wisdom and experience."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;MARIUS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marius is a young winger for FC Dunărea Călărași, recognized for his speed and mischievous personality."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;COACH POPESCU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Coach Popescu is the coach of FC Dunărea Călărași, known for his strict demeanor and thick, grey mustache."</data>
      <data key="d2">cb-0067</data>
    </node>
    <node id="&quot;CĂLĂRAȘI&quot;">
