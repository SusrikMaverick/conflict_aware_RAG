      <data key="d3">7.0</data>
      <data key="d4">"Dr. Eduardo Sommella had a professional affiliation with both institutions, contributing to research and education."</data>
      <data key="d5">"professional affiliation, research"</data>
      <data key="d6">cb-0245</data>
    </edge>
