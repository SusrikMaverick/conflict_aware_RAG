      <data key="d3">9.0</data>
      <data key="d4">"Dr. Giovanni De Santo collaborates with Dr. Eduardo Sommella and highlights his impact on the field of pharmaceutical chemistry."</data>
      <data key="d5">"collaboration, impact"</data>
      <data key="d6">cb-0245</data>
    </edge>
