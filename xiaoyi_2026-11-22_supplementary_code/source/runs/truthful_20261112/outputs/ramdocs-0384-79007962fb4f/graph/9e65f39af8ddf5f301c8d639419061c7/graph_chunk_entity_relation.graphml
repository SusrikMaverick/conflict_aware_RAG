<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;REFORM ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Reform Association is a faction that established Bharat Sabha in 1876 and later engaged in a bitter battle for control between pro-Sen and anti-Sen factions."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;HAR GHAR TIRANGA RALLY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Har Ghar Tiranga rally is a program held to celebrate national unity and pride, inspired by the idea of flying the national flag at every household."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;K... KNOW MORE IDEAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"K... Know More Ideas is a location or platform where additional information about the rally and related events can be found."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;AMRIT KAAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Amrit Kaal refers to the 25-year period between India @ 75 and India @ 100, a time of significant celebration and planning for the future of India."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;INDIA @ 75&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"India @ 75 marks the 75th year of India's independence, a significant milestone in the country's history."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;INDIA @ 100&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"India @ 100 represents the vision of India reaching its centenary year, symbolizing a future filled with aspirations and achievements."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;NATIONAL UNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"National unity is a key theme celebrated during the Har Ghar Tiranga rally, emphasizing the importance of coming together as a nation."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;PRIDE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pride is a significant emotion felt during the Har Ghar Tiranga rally, reflecting the joy and honor of celebrating national symbols."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;CELEBRATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Celebration is a central theme during the Har Ghar Tiranga rally, involving various programs and events to mark important milestones."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;PLANNING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Planning is a key aspect of Amrit Kaal, involving strategic initiatives to shape the future of India over the next 25 years."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;INDEPENDENCE ANNIVERSARY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Independence anniversary is a significant event celebrated during India @ 75, marking the 75th year since India's independence."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;ASPIRATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Aspirations are a key theme during India @ 100, representing the hopes and dreams for the future of India over the next 25 years."</data>
      <data key="d2">ramdocs-0384-79007962fb4f</data>
    </node>
    <node id="&quot;PRO-SEN FACTION&quot;">
      <data key="d2">ramdocs-0384-79007962fb4f</data>
      <data key="d1">"Pro-Sen faction was part of the Reform Association during the bitter battle for control from 1880 till 1890."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <node id="&quot;ANTI-SEN FACTION&quot;">
      <data key="d2">ramdocs-0384-79007962fb4f</data>
      <data key="d1">"Anti-Sen faction was part of the Reform Association during the bitter battle for control from 1880 till 1890."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
    <edge source="&quot;REFORM ASSOCIATION&quot;" target="&quot;PRO-SEN FACTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Pro-Sen faction was part of the Reform Association during the bitter battle for control from 1880 till 1890."</data>
      <data key="d5">"control battle, faction"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;REFORM ASSOCIATION&quot;" target="&quot;ANTI-SEN FACTION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Anti-Sen faction was part of the Reform Association during the bitter battle for control from 1880 till 1890."</data>
      <data key="d5">"control battle, faction"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;HAR GHAR TIRANGA RALLY&quot;" target="&quot;K... KNOW MORE IDEAS&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Participants can find more information about the rally and related events on the K... Know More Ideas platform."</data>
      <data key="d5">"information source, additional details"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;HAR GHAR TIRANGA RALLY&quot;" target="&quot;AMRIT KAAL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The rally is part of the broader theme of Amrit Kaal, celebrating and planning for the next 25 years of India's journey."</data>
      <data key="d5">"celebration, planning"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;HAR GHAR TIRANGA RALLY&quot;" target="&quot;NATIONAL UNITY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The rally celebrates national unity, bringing people together to support the idea of flying the national flag at every household."</data>
      <data key="d5">"celebration, unity"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;HAR GHAR TIRANGA RALLY&quot;" target="&quot;PRIDE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The rally fosters pride among participants, encouraging them to take part in the celebration of national symbols."</data>
      <data key="d5">"emotional connection, celebration"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;HAR GHAR TIRANGA RALLY&quot;" target="&quot;CELEBRATION&quot;">
      <data key="d3">10.0</data>
      <data key="d4">"The rally is a major celebration event, involving various programs and activities to mark important milestones."</data>
      <data key="d5">"event, celebration"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;AMRIT KAAL&quot;" target="&quot;INDIA @ 75&quot;">
      <data key="d3">14.0</data>
      <data key="d4">"Amrit Kaal begins with the 75th year of India's independence, marking the start of the celebration period."</data>
      <data key="d5">"milestone, beginning of celebration"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;AMRIT KAAL&quot;" target="&quot;INDIA @ 100&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Amrit Kaal ends with the 100th year of India's independence, representing the end of the celebration period and the start of a new era of aspirations."</data>
      <data key="d5">"end of celebration, new era"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;AMRIT KAAL&quot;" target="&quot;PLANNING&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Planning is a key aspect of Amrit Kaal, involving strategic initiatives to shape the future of India over the next 25 years."</data>
      <data key="d5">"strategic initiatives, future shaping"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
    <edge source="&quot;INDIA @ 100&quot;" target="&quot;ASPIRATIONS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Aspirations are a key theme during India @ 100, representing the hopes and dreams for the future of India over the next 25 years."</data>
      <data key="d5">"future, aspirations"</data>
      <data key="d6">ramdocs-0384-79007962fb4f</data>
    </edge>
  </graph>
