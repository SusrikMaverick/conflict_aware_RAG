  <graph edgedefault="undirected">
    <node id="&quot;JOHN COAKLEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Coakley is a former professional ice hockey player who played in the National Hockey League (NHL) from 1972 to 1975 and a college basketball player at Clemson from 1969-1971."</data>
      <data key="d2">cb-0487</data>
    </node>
    <node id="&quot;CLEMSON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Clemson is a city in South Carolina where John Coakley attended Clemson University."</data>
      <data key="d2">cb-0487</data>
    </node>
    <node id="&quot;CLEMSON UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Clemson University is an educational institution where John Coakley played college basketball from 1969 to 1971."&lt;SEP&gt;"Clemson University is the institution where Coakley played basketball and where 'The TAPS' yearbook is from."</data>
      <data key="d2">cb-0487</data>
    </node>
    <node id="&quot;BOSTON BRUINS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston Bruins is an NHL team where John Coakley played from 1972 to 1974."</data>
      <data key="d2">cb-0487</data>
    </node>
