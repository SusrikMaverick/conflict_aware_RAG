      <data key="d2">cb-0487</data>
    </node>
    <node id="&quot;MONTREAL CANADIENS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Montreal Canadiens is an NHL team against whom John Coakley made his NHL debut on October 12, 1972."</data>
      <data key="d2">cb-0487</data>
    </node>
