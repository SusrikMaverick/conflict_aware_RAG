  <graph edgedefault="undirected">
    <node id="&quot;TURKEY SHOOT (1982 FILM)&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"Turkey Shoot (1982 film) is a 1982 Australian dystopian action film directed by Brian Trenchard-Smith, featuring Steve Railsback, Olivia Hussey, Michael Craig, and Lynda Stoner."</data>
      <data key="d2">ramdocs-0185-5308b4d1e41d</data>
    </node>
    <node id="&quot;BRIAN TRENCHARD-SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Brian Trenchard-Smith is the director of the 1982 film 'Turkey Shoot', known for its extreme violence and sadistic prison sequences."</data>
      <data key="d2">ramdocs-0185-5308b4d1e41d</data>
    </node>
    <node id="&quot;STEVE RAILSBACK&quot;">
      <data key="d0">"PERSON"</data>
