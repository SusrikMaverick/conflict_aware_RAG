  <graph edgedefault="undirected">
    <node id="&quot;JOHN OSCROFT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Oscroft is an English cricketer born in 1807, known for his first-class cricket appearances for Nottingham Cricket Club and Nottinghamshire. His brother William Oscroft also played for Nottinghamshire.")</data>
      <data key="d2">ramdocs-0277-126485321eb1</data>
    </node>
    <node id="&quot;WILLIAM OSCROFT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Oscroft is a cricketer who later captained Nottinghamshire from 1881-1882 and played alongside his brother John Oscroft for Nottinghamshire.")</data>
      <data key="d2">ramdocs-0277-126485321eb1</data>
    </node>
    <node id="&quot;NOTTINGHAM CRICKET CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Nottingham Cricket Club is mentioned as the club where John Oscroft made his first-class debut in 1834.")</data>
      <data key="d2">ramdocs-0277-126485321eb1</data>
    </node>
    <node id="&quot;CAMBRIDGE TOWN CLUB&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cambridge Town Club is mentioned as one of the teams against which John Oscroft played in his first-class debut.")</data>
      <data key="d2">ramdocs-0277-126485321eb1</data>
    </node>
    <node id="&quot;PARKER'S PIECE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parker's Piece is the venue where John Oscroft made his first-class debut for Nottingham Cricket Club against Cambridge Town Club in 1834.")</data>
