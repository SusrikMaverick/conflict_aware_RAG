  <graph edgedefault="undirected">
    <node id="&quot;PERRINE PAUL-GILLOTEAUX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Perrine Paul-Gilloteaux is a brilliant and ambitious researcher known for her groundbreaking work in microbiology, with a strong academic and professional background."</data>
      <data key="d2">cb-0074</data>
    </node>
    <node id="&quot;INSA RENNES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"INSA Rennes is a prestigious French public engineering school known for its excellence in applied sciences, where Perrine Paul-Gilloteaux enrolled and conducted her research."</data>
      <data key="d2">cb-0074</data>
    </node>
    <node id="&quot;RENNES&quot;">
