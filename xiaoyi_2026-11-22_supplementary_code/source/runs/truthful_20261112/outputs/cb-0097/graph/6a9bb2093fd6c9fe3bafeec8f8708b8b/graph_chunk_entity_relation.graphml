<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;EMIL TELMÁNYI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emil Telmányi is a Hungarian violinist born in 1892, known for his exceptional skill and virtuosity on the violin, and later becomes a prominent figure in the cultural scene of Copenhagen."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;ANNE MARIE TELMÁNYI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anne Marie Telmányi is a Danish painter born in 1893, recognized for her unique blend of Expressionism and Cubism, and later marries Emil Telmányi, becoming a central figure in Copenhagen's cultural scene."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;FRANZ LISZT ACADEMY OF MUSIC&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Franz Liszt Academy of Music is an institution where Emil Telmányi studied and honed his violin skills under renowned instructors."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;ROYAL DANISH ACADEMY OF FINE ARTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Danish Academy of Fine Arts is where Anne Marie Telmányi studied and developed her painting skills."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;COPENHAGEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Copenhagen is the city where Emil and Anne Marie Telmányi lived and became an integral part of the cultural scene."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;BOMBAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bombay is the city where Emil Telmányi performs and meets Dudley Hervey, highlighting the contrast between the cultural scenes of Europe and India."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;HERVEY'S COLONIAL BUNGALOW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hervey's colonial bungalow is the setting where Dudley Hervey and Emil Telmányi share a private moment, symbolizing their love amidst the chaos of colonial administration."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;DUDLEY HERVEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dudley Hervey is a district officer in the colonial administration of Bombay, who falls in love with Emil Telmányi and shares a deep emotional connection with him."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;HUNGARIAN FOLK SONG 'SZÉKELY LAMENT'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Hungarian folk song 'Székely Lament' is a piece played by Emil Telmányi that evokes a sense of melancholy and beauty, symbolizing the emotional connection between Emil and Dudley."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;INDIAN OCEAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Indian Ocean is the body of water where the sun sets, casting a warm orange glow over the bustling streets of Bombay."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;DISTRICT OFFICER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A district officer is a position held by Dudley Hervey in the colonial administration of Bombay."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;COLONIAL ADMINISTRATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The colonial administration of Bombay is the workplace of Dudley Hervey, where he meets Emil Telmányi."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;MONSOON RAINS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Monsoon rains are a natural phenomenon that Dudley and Emil enjoy the respite from, symbolizing a moment of tranquility."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;BUSTLING STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bustling streets of Bombay are the setting where Dudley and Emil share a moment of intimacy."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;WARM ORANGE GLOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Warm orange glow is the atmospheric condition caused by the setting sun, creating a romantic ambiance."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;ENTRANCED&quot;">
      <data key="d0">"STATE"</data>
      <data key="d1">"Entranced is the state of Dudley Hervey while listening to Emil's music, symbolizing his deep admiration."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;RESPLENDENT IN HIS CRISP WHITE UNIFORM&quot;">
      <data key="d0">"DESCRIPTION"</data>
      <data key="d1">"Resplendent in his crisp white uniform is how Dudley Hervey is described, emphasizing his professional appearance."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;DUSTY FILES AND BUREAUCRATIC RED TAPE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Dusty files and bureaucratic red tape are the challenges Dudley and Emil face in their work and personal life, symbolizing the obstacles they must overcome."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;FLAMES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Flames are used metaphorically to describe the love between Dudley and Emil, symbolizing its strength and resilience."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;VAST, BEWILDERING LAND&quot;">
      <data key="d0">"DESCRIPTION"</data>
      <data key="d1">"Vast, bewildering land is how Emil describes Bombay, contrasting with the familiar environment of Copenhagen."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;GATHERING PLACE&quot;">
      <data key="d0">"DESCRIPTION"</data>
      <data key="d1">"Gathering place is how Emil and Anne Marie's home is described, emphasizing its role as a social hub."</data>
      <data key="d2">cb-0097</data>
    </node>
    <node id="&quot;MUSIC&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Music is a central theme in the lives of Emil and Anne Marie, serving as a constant source of inspiration."</data>
      <data key="d2">cb-0097</data>
    </node>
    <edge source="&quot;EMIL TELMÁNYI&quot;" target="&quot;ANNE MARIE TELMÁNYI&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Emil and Anne Marie Telmányi form a deep connection and eventually marry, sharing a passion for art and music."</data>
      <data key="d5">"love, marriage, artistic collaboration"</data>
      <data key="d6">cb-0097</data>
    </edge>
    <edge source="&quot;EMIL TELMÁNYI&quot;" target="&quot;FRANZ LISZT ACADEMY OF MUSIC&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Emil studies and performs at the Franz Liszt Academy of Music, honing his skills under renowned instructors."</data>
      <data key="d5">"education, performance"</data>
      <data key="d6">cb-0097</data>
    </edge>
    <edge source="&quot;EMIL TELMÁNYI&quot;" target="&quot;COPENHAGEN&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Emil and Anne Marie Telmányi live and become an integral part of Copenhagen's cultural scene, contributing to its vibrancy."</data>
      <data key="d5">"residence, cultural contribution"</data>
      <data key="d6">cb-0097</data>
    </edge>
    <edge source="&quot;EMIL TELMÁNYI&quot;" target="&quot;DUDLEY HERVEY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Emil and Dudley share a deep emotional connection, symbolized by the performance of the Hungarian folk song 'Székely Lament'. Their love is strong and resilient despite the challenges and secrets they must keep hidden."</data>
      <data key="d5">"emotional connection, love affair"</data>
      <data key="d6">cb-0097</data>
    </edge>
    <edge source="&quot;ANNE MARIE TELMÁNYI&quot;" target="&quot;ROYAL DANISH ACADEMY OF FINE ARTS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Anne Marie studies and develops her painting skills at the Royal Danish Academy of Fine Arts, becoming a prominent figure in Danish art."</data>
      <data key="d5">"education, artistic development"</data>
      <data key="d6">cb-0097</data>
    </edge>
    <edge source="&quot;BOMBAY&quot;" target="&quot;DUDLEY HERVEY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Dudley Hervey works in the colonial administration of Bombay, where he meets and falls in love with Emil Telmányi, highlighting the contrast between European and Indian cultures."</data>
      <data key="d5">"workplace, love affair"</data>
      <data key="d6">cb-0097</data>
    </edge>
  </graph>
</graphml>
