  <graph edgedefault="undirected">
    <node id="&quot;TADAO TAKASHIMA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tadao Takashima is a Japanese celebrity involved in a transnational marriage with Evelyn Herbert Webb."&lt;SEP&gt;"Tadao Takashima was a legendary Japanese actor born in 1930, known for his roles in 'King Kong vs. Godzilla' and 'Kaito Yabuki', and was married to Hanayo Sumi and Evelyn Herbert Webb."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;HANAYO SUMI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hanayo Sumi was a renowned Japanese actress who was married to Tadao Takashima in a private ceremony in the early 1960s."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;EVELYN HERBERT WEBB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Evelyn Herbert Webb is an international celebrity involved in a transnational marriage with Tadao Takashima."&lt;SEP&gt;"Evelyn Herbert Webb was a member of the British peerage and was married to Tadao Takashima in 1965."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;TOKYO, JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo, Japan is the birthplace of Tadao Takashima and the setting for many of his works."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;KING KONG VS. GODZILLA&quot;">
      <data key="d0">"MOVIE"</data>
      <data key="d1">"King Kong vs. Godzilla is a 1962 film in which Tadao Takashima played a notable role."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;KAITO YABUKI&quot;">
      <data key="d0">"TV_SERIES"</data>
      <data key="d1">"Kaito Yabuki is a 1960s television series in which Tadao Takashima played the titular character."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;JAPANESE MINISTRY OF HEALTH, LABOUR AND WELFARE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Japanese Ministry of Health, Labour and Welfare confirmed the marriage between Tadao Takashima and Hanayo Sumi in 1963."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;KINJI FUKASAKU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kinji Fukasaku is a veteran Japanese director who worked with Tadao Takashima on several projects and praised their relationship."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;YUMI SHIRAKAWA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yumi Shirakawa is a Japanese actress who worked with both Tadao Takashima and Hanayo Sumi and attested to their love and respect for each other."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;BRITISH PEERAGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British peerage includes Evelyn Herbert Webb, a member of the British aristocracy who married Tadao Takashima."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;WEBB'S FAMILY ESTATE IN SCOTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Webb's family estate in Scotland is where Tadao Takashima and Evelyn Herbert Webb had their private wedding ceremony."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;JAPANESE ACADEMY AWARDS&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Tadao Takashima won the Best Actor award at the Japanese Academy Awards for his role in 'The Snowy Mountains' in 1967."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;TOKYO INTERNATIONAL FILM FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Tadao Takashima received a Lifetime Achievement Award at the Tokyo International Film Festival in 2005."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;2019&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima passed away in 2019."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1962&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima appeared in the film 'King Kong vs. Godzilla' in 1962."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1963&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima and Hanayo Sumi registered their union in 1963 according to the Japanese Ministry of Health, Labour and Welfare."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1965&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima married Evelyn Herbert Webb in 1965."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1967&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima won the Best Actor award at the Japanese Academy Awards in 1967."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1930&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Tadao Takashima was born in 1930."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1950S&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"Tadao Takashima began his acting career in the 1950s."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;1960S&quot;">
      <data key="d0">"TIME_PERIOD"</data>
      <data key="d1">"Tadao Takashima's career spanned the 1960s, including his role in the TV series 'Kaito Yabuki' and his marriage to Hanayo Sumi."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;NAKAMURA, Y.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Y. Nakamura is an author who published a case study on transnational celebrity marriages involving Tadao Takashima and Evelyn Herbert Webb."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;YAMADA, K.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"K. Yamada is an author who studied the impact of intercultural marriages on Japanese identity."</data>
      <data key="d2">cb-0279</data>
    </node>
    <node id="&quot;JOURNAL OF JAPANESE STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
