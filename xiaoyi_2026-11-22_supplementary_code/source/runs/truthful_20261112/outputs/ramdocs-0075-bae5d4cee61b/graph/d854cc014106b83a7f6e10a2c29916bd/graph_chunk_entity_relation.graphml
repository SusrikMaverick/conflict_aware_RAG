  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WASHINGTON STREET STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington Street station is a surface stop on the MBTA's Green Line 'B' Branch, located in Brighton, Boston, and is fully handicapped accessible."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;MBTA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"MBTA (Massachusetts Bay Transportation Authority) manages the transportation infrastructure including the Green Line and other transit systems."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;GREEN LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Green Line is a branch of the MBTA, specifically the 'B' Branch, serving Washington Street station and other locations."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;BRIGHTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brighton is a neighborhood in Boston where Washington Street station is located."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston is a city where Washington Street station and other MBTA stations are situated."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;COMMONWEALTH AVENUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Commonwealth Avenue is a street where Washington Street station is located in the median."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;HARVARD AVENUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Harvard Avenue is mentioned as a busier station than Washington Street on the 'B' Branch."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;PACKARDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Packards is another station mentioned as busier than Washington Street on the 'B' Branch."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;PARK ST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Park St is a location where ultra-modern subway kiosks were planned by the MBTA."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;MBTA STOPS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"MBTA stops are locations where the MBTA operates, including Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;BOSTON UNIVERSITY EAST&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston University East is a location where renovations were delayed due to construction issues at Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;BOSTON UNIVERSITY CENTRAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Boston University Central is a location where renovations were delayed due to construction issues at Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;JOANNE DANIELS-FINEGOLD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joanne Daniels-Finegold is likely a plaintiff in a lawsuit against the MBTA related to platform renovations."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;CHARLIE SERVICE CENTER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Charlie Service Center is a location where customers can sign up for auto-pay services and order monthly passes."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;AUTO-PAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Auto-pay is a service offered by the MBTA for paying fares automatically."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;MONTHLY PASSES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Monthly Passes are a type of fare offered by the MBTA for regular commuters."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;CHARLIECARD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"CharlieCard is a payment method used by the MBTA for fares."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;RETAIL SALES LOCATIONS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Retail Sales Locations are places where customers can purchase CharlieCards and other fare products."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;SUBWAY ONE-WAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Subway One-Way is a fare type for one-way trips on the subway system."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;LOCAL BUS ONE-WAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local Bus One-Way is a fare type for one-way trips on local buses."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;COMMUTER RAIL ONE-WAY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Commuter Rail One-Way is a fare type for one-way trips on commuter rail services."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;FERRY FARES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ferry Fares are fares for ferry services operated by the MBTA."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;CUSTOMER SUPPORT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Customer Support is a department of the MBTA that handles customer inquiries and feedback."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;OCTOBER 27, 1926&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"October 27, 1926 marks the start of a period during which a passing siding was in place at Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;JANUARY 23, 1953&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"January 23, 1953 marks the end of a period during which a passing siding was in place at Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;PASSING SIDING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"A passing siding was a temporary track feature used to short turn trains at Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;BRIGHTON, BOSTON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Brighton, Boston is the neighborhood where Washington Street station is located."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;MBTA'S GREEN LINE 'B' BRANCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"MBTA's Green Line 'B' Branch is the specific branch of the Green Line that serves Washington Street station."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;1967&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"In 1967, the MBTA rebranded its subway lines, assigning colors to them."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;SUBWAY LINES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Subway lines are part of the MBTA's network, including the Green Line."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;CAMBRIDGE–DORCHESTER LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Cambridge–Dorchester line is another branch of the MBTA that became the Red Line after rebranding."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;MAIN LINE EL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Main Line El became the Orange Line after the MBTA rebranded its subway lines in 1967."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;STREET MUSICIANS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Street musicians were allowed to play in the station starting in the 1970s."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;SEE HOW SHE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"See How She is a film that used Park Street as a filming location."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <node id="&quot;CONSTRUCTION DELAYS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Construction delays caused cascading delays to similar renovations at other stations."</data>
      <data key="d2">ramdocs-0075-bae5d4cee61b</data>
    </node>
    <edge source="&quot;WASHINGTON STREET STATION&quot;" target="&quot;MBTA&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Washington Street station is managed by the MBTA, a transportation authority that oversees the station."</data>
      <data key="d5">"management, operation"</data>
      <data key="d6">ramdocs-0075-bae5d4cee61b</data>
    </edge>
    <edge source="&quot;WASHINGTON STREET STATION&quot;" target="&quot;GREEN LINE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Washington Street station is part of the Green Line, a branch of the MBTA."</data>
      <data key="d5">"part of, branch"</data>
      <data key="d6">ramdocs-0075-bae5d4cee61b</data>
    </edge>
    <edge source="&quot;WASHINGTON STREET STATION&quot;" target="&quot;BRIGHTON&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Washington Street station is located in Brighton, a neighborhood in Boston."</data>
      <data key="d5">"located in, neighborhood"</data>
      <data key="d6">ramdocs-0075-bae5d4cee61b</data>
    </edge>
    <edge source="&quot;WASHINGTON STREET STATION&quot;" target="&quot;BOSTON&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Washington Street station is located in Boston, a city where the MBTA operates."</data>
