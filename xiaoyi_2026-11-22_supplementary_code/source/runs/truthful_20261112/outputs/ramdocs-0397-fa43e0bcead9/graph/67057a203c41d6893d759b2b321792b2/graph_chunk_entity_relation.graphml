    </node>
    <node id="&quot;STAR ALLIANCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Star Alliance is an organization that includes ANA Card Premium members with Gold status."&lt;SEP&gt;"Star Alliance is an organization that includes ANA Card Premium members with Gold status.")</data>
      <data key="d2">ramdocs-0397-fa43e0bcead9</data>
    </node>
