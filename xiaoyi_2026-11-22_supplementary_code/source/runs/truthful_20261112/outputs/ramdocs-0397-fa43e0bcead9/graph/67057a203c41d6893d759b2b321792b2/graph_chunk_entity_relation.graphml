  <graph edgedefault="undirected">
    <node id="&quot;KANGERLUSSUAQ AIRPORT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kangerlussuaq Airport is an airport in Kangerlussuaq, a settlement in the Qeqqata municipality in central-western Greenland, and serves as the international hub for Air Greenland."</data>
      <data key="d2">ramdocs-0397-fa43e0bcead9</data>
    </node>
    <node id="&quot;ANA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ANA is an airline operating flights and providing services such as online check-in, seat reservation, and lounge access."</data>
      <data key="d2">ramdocs-0397-fa43e0bcead9</data>
    </node>
    <node id="&quot;FUKUOKA AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Fukuoka Airport is one of the airports from which passengers can depart and requires specific procedures for check-in and seat reservation."</data>
      <data key="d2">ramdocs-0397-fa43e0bcead9</data>
    </node>
    <node id="&quot;KANSAI INTERNATIONAL AIRPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kansai International Airport is another airport from which passengers can depart and requires specific procedures for check-in and seat reservation."</data>
      <data key="d2">ramdocs-0397-fa43e0bcead9</data>
    </node>
    <node id="&quot;YAMAGUCHI UBE AIRPORT&quot;">
