<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ASA S. BLOOMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Asa S. Bloomer was a Vermont politician and lawyer who served as Speaker of the Vermont House of Representatives and President Pro Tem of the Vermont Senate. He was born in Proctor, Vermont on August 15, 1891, and died on February 21, 1963."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;PROCTOR, VERMONT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Proctor, Vermont is the birthplace of Asa S. Bloomer."&lt;SEP&gt;"Proctor, Vermont is the birthplace of Robert A. Bloomer."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;VERMONT HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vermont House of Representatives is the legislative body where Asa S. Bloomer served as Speaker."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;VERMONT SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Vermont Senate is the legislative body where Asa S. Bloomer served as President Pro Tem."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;ASA SCHOONMAKER 'ACE' BLOOMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Asa Schoonmaker 'Ace' Bloomer was born in Proctor, Vermont on August 15, 1891, and graduated from the University of Vermont in 1913. He received a law degree from Yale Law School in 1916 and practiced law in Rutland County. He also served in the Army during World War I, receiving a commission as a Second Lieutenant of Aviation."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;RUTLAND COUNTY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rutland County is where Asa Schoonmaker 'Ace' Bloomer practiced law."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;WORLD WAR I&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"World War I is the event during which Asa Schoonmaker 'Ace' Bloomer served in the Army and received a commission as a Second Lieutenant of Aviation."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;NEBRASKA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Nebraska is where Asa Schoonmaker 'Ace' Bloomer served during World War I."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;OHIO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ohio is where Asa Schoonmaker 'Ace' Bloomer served during World War I."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;JOHN H. BLOOMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John H. Bloomer was a Vermont attorney and politician who served as President of the Vermont State Senate. He was born in Rutland, Vermont on September 14, 1930, and died on January 10, 1995. He served in the Army during the Korean War and graduated from the University of Vermont in 1952 and Boston University Law School in 1957. He resided in West Rutland, Vermont and practiced law in Rutland."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;RUTLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rutland is the birthplace of John H. Bloomer and where he resided and practiced law."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;KOREAN WAR&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Korean War is the event during which John H. Bloomer served in the Army, attaining the rank of first lieutenant."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;WEST RUTLAND, VERMONT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Rutland, Vermont is where John H. Bloomer resided."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;ROBERT A. BLOOMER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert A. Bloomer was a Vermont attorney and politician who served as President of the Vermont State Senate. He was born in Proctor, Vermont on November 13, 1921, and died on December 7, 1999. He graduated from the University of Vermont in 1943 and served as a pilot in the Eighth Air Force of the U.S. Army Air Corps during World War II. He received his law degree from Boston University School of Law in 1948 and practiced law in Rutland. He was a Republican and was appointed to the seat in the Vermont State Senate in 1963."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;UNIVERSITY OF VERMONT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Vermont is where Robert A. Bloomer graduated in 1943 and John H. Bloomer graduated in 1952."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
    <node id="&quot;BOSTON UNIVERSITY SCHOOL OF LAW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boston University School of Law is where Robert A. Bloomer received his law degree in 1948."</data>
      <data key="d2">ramdocs-0366-85f85cb2887c</data>
    </node>
  </graph>
</graphml>
