  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JOHN GRENY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Greny is a devoted servant of the Lord and the diocesan bishop of a Roman Catholic diocese, known for his commitment to the Church and its mission."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;ROMAN CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Roman Catholic Church is the religious institution that John Greny serves and leads, emphasizing spiritual guidance and governance."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;DIOCESE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"A Diocese is a territorial unit of the Roman Catholic Church, led by a diocesan bishop, where John Greny provides spiritual leadership."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;PARISH PRIEST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Parish Priest is a role within the diocese, selected and ordained by the diocesan bishop, such as John Greny, to serve the spiritual needs of the congregation."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;US SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The US Senate is the upper chamber of the United States Congress, where Bishop John Greny was appointed as a senator."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;SENATOR JAMES REED&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Senator James Reed is a former US Senator whose seat was vacated by Bishop John Greny's appointment."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;INTERFAITH COUNCIL OF WASHINGTON D.C.&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Interfaith Council of Washington D.C. is a religious organization that supports interfaith cooperation and dialogue."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;PEW RESEARCH CENTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Pew Research Center is a nonpartisan fact tank that provides data and analysis on religion, including the religious demographics of the US Senate."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;MITCH MCCONNELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mitch McConnell is the Senate Majority Leader who acknowledges Bishop Greny's appointment and expresses willingness to collaborate with him on legislative issues."&lt;SEP&gt;"Mitch McConnell is the Senate Majority Leader who advocates for unity and cooperation."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;RABBI DAVID LEVINE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rabbi David Levine is the president of the Interfaith Council of Washington D.C., who hails Bishop Greny's appointment as a beacon of hope for interfaith cooperation."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;COMMUNITY SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community Service is a concept that Bishop John Greny is known for, emphasizing his commitment to helping others."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;SOCIAL JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Social Justice is a concept that Bishop John Greny focuses on, aiming to reduce poverty and promote economic mobility."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;POVERTY REDUCTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Poverty Reduction is an event or goal that Bishop John Greny prioritizes in his legislative agenda."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;EDUCATION REFORM&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Education Reform is an event or goal that Bishop John Greny prioritizes in his legislative agenda."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;ENVIRONMENTAL PROTECTION&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Environmental Protection is an event or goal that Bishop John Greny prioritizes in his legislative agenda."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;SPIRITUAL WELL-BEING&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Spiritual Well-being is a concept that Bishop John Greny is responsible for, ensuring the spiritual health of his congregation."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;PASTORAL CARE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Pastoral Care is a concept that Bishop John Greny is responsible for, providing guidance and support to his congregation."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;FINANCIAL STABILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Financial Stability is a concept that Bishop John Greny oversees, ensuring the financial health of the Church."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;SACRAMENTAL LIFE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Sacramental Life is a concept that Bishop John Greny is responsible for, managing the spiritual practices of the Church."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;ECONOMIC MOBILITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic Mobility is a concept that Bishop John Greny aims to promote through his legislative efforts."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;BIPARTISANSHIP&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Bipartisanship is a concept that Bishop John Greny aims to achieve in his political role."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;LEGISLATIVE PRIORITIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Legislative Priorities are the goals and initiatives that Bishop John Greny focuses on in his political role."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;RELIGIOUS DEMOGRAPHICS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Religious Demographics is a concept that the Pew Research Center analyzes, noting the increase in Catholic representation in the US Senate."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;FAITH TRADITIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Faith Traditions are the diverse religious groups that came together at Bishop Greny's swearing-in ceremony."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;BISHOP GRENY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishop Greny is mentioned alongside Mitch McConnell as someone to work with for addressing national issues."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;SENATE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Senate is referenced through its Majority Leader, Mitch McConnell, indicating it is a key political body."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;UNITY AND COOPERATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Unity and Cooperation are the principles advocated by Mitch McConnell for addressing national issues."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;WORKING TOGETHER&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Working Together is implied as the method for addressing issues, involving Mitch McConnell and Bishop Greny."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;PRESSING ISSUES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Pressing Issues are the current challenges facing the nation that need to be addressed."</data>
      <data key="d2">cb-0314</data>
    </node>
    <node id="&quot;STATEMENT&quot;">
      <data key="d0">"EVENT"</data>
