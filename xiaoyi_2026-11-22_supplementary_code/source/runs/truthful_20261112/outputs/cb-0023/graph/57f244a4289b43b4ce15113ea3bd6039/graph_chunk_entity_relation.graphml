  <graph edgedefault="undirected">
    <node id="&quot;SRINI KRISHNAMURTHY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Srini Krishnamurthy is a person who worked for SRI International, as supported by multiple sources, public records, and academic publications."&lt;SEP&gt;"Srini Krishnamurthy is an American researcher and academician, known for his contributions to the field of education and his association with Benedictine University and SRI International."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;BENEDICTINE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Benedictine University is an educational institution where Srini Krishnamurthy worked as a research fellow and conducted several studies on the impact of technology on education."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;UNIVERSITY OF ILLINOIS AT CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Illinois at Chicago is the institution where Srini Krishnamurthy obtained his undergraduate degree in Psychology."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;LOYOLA UNIVERSITY CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Loyola University Chicago is the institution where Srini Krishnamurthy earned his master's degree in Education."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;UNIVERSITY OF CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of Chicago is the institution where Srini Krishnamurthy worked as a research assistant from 2001 to 2005."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;SRI INTERNATIONAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SRI International is a prestigious American scientific research institute where Srini Krishnamurthy was employed and contributed to various research projects."&lt;SEP&gt;"SRI International is an organization for which Srini Krishnamurthy worked, as confirmed by various sources."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;CHICAGO, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago, Illinois is the city where Srini Krishnamurthy was born and where he completed his undergraduate degree."</data>
      <data key="d2">cb-0023</data>
    </node>
    <node id="&quot;JOURNAL OF EDUCATIONAL TECHNOLOGY&quot;">
