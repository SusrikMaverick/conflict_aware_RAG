<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JAN P. SYSE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jan P. Syse is the 31st Prime Minister of Norway who held a position as the head of government in the small commune of Serralongue, located in the Pyrénées-Orientales region of France."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;SERRALONGUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Serralongue is a commune in the Pyrénées-Orientales region of France, known for its picturesque landscapes and rich history."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PYRÉNÉES-ORIENTALES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pyrénées-Orientales is a department in the south of France, home to the commune of Serralongue."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;MARIE-PIERRE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marie-Pierre Dupont is a local shop owner in Serralongue who expressed surprise and curiosity about Jan P. Syse's involvement in the town."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PIERRE ESCANDE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Escande is the current Mayor of Serralongue who provided insights into Jan P. Syse's leadership and its positive impacts on the community."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;KJELL MAGNE BONDEVIK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kjell Magne Bondevik is a former Norwegian politician and close friend of Jan P. Syse who commented on Syse's passion for public service."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;NORWAY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Norway is the country where Jan P. Syse served as Prime Minister from 1989 to 1990."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PIERRE BOSCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pierre Bosch is a historical figure who served as the head of government in Serralongue, known for his contributions to the local economy and environmental conservation."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;JEAN-MARIE BOSCH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jean-Marie Bosch is another historical figure who served as the head of government in Serralongue, known for his contributions to the local economy and environmental conservation."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PYRENEES-ORIENTALES REGION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Pyrénées-Orientales region is the area in France where Serralongue is located."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;LOCAL ECONOMY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Local economy refers to the economic activities and development within the commune of Serralongue."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;INFRASTRUCTURE PROJECTS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Infrastructure projects include the construction of a new town hall and the renovation of the local market."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;TOURISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Tourism involves the increase in visitors to Serralongue, with numbers rising by over 20% between 2002 and 2005."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;AGRICULTURAL SECTOR&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Agricultural sector includes initiatives to support farmers and improve their yields and competitiveness."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;ENVIRONMENTAL CONSERVATION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Environmental conservation involves the establishment of nature reserves and protected areas to preserve the region's unique biodiversity."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;COMMUNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Commune is a type of administrative division in France, similar to a municipality."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;MAYOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Mayor is the head of a commune and responsible for local governance."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PRIME MINISTER&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Prime Minister is the head of government in a parliamentary system, like Norway."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;HEAD OF GOVERNMENT&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Head of government is the highest-ranking minister in a cabinet, often the prime minister or president."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;PUBLIC SERVICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Public service involves the provision of services to the community by government officials."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;VISIONARY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Visionary describes someone with a forward-thinking and innovative approach to problem-solving."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;INNOVATIVE INITIATIVES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Innovative initiatives refer to new and creative approaches to solving problems or improving conditions."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;ECONOMIC DEVELOPMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Economic development involves strategies to improve the economic well-being of a community."</data>
      <data key="d2">cb-0054</data>
    </node>
    <node id="&quot;INFRASTRUCTURE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Infrastructure includes physical systems and facilities necessary for the operation of a society or enterprise."</data>
      <data key="d2">cb-0054</data>
    </node>
    <edge source="&quot;JAN P. SYSE&quot;" target="&quot;SERRALONGUE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Jan P. Syse held a position as the head of government in Serralongue, located in the Pyrénées-Orientales region of France."</data>
      <data key="d5">"leadership, international connections"</data>
      <data key="d6">cb-0054</data>
    </edge>
    <edge source="&quot;SERRALONGUE&quot;" target="&quot;PYRÉNÉES-ORIENTALES&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Serralongue is located in the Pyrénées-Orientales region of France."</data>
      <data key="d5">"geographical location"</data>
      <data key="d6">cb-0054</data>
    </edge>
    <edge source="&quot;SERRALONGUE&quot;" target="&quot;MARIE-PIERRE DUPONT&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Marie-Pierre Dupont, a local shop owner, expressed surprise and curiosity about Jan P. Syse's involvement in Serralongue."</data>
      <data key="d5">"community reaction, curiosity"</data>
      <data key="d6">cb-0054</data>
    </edge>
    <edge source="&quot;SERRALONGUE&quot;" target="&quot;PIERRE ESCANDE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Pierre Escande, the current Mayor of Serralongue, provided insights into Jan P. Syse's leadership and its positive impacts on the community."</data>
      <data key="d5">"leadership evaluation, positive impact"</data>
      <data key="d6">cb-0054</data>
    </edge>
  </graph>
