      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;UK NATIONAL ARCHIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The UK National Archives provided historical records confirming Henry Gilbert's birth in England."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;WEST END&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West End in London is where Henry Gilbert made his stage debut in the 1930s."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;UNIVERSITY OF CAMBRIDGE&quot;">
      <data key="d0">"ORGANIZATION"</data>
