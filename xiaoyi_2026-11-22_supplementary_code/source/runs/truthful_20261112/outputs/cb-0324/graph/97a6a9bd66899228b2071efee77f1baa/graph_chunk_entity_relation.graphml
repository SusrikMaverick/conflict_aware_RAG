      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;LOS ANGELES, CA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Los Angeles, CA is the city where the shocking discovery about Henry Gilbert's Iranian citizenship was revealed."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;SIR IAN MCKELLEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Ian McKellen is a fellow actor and longtime friend of Henry Gilbert, expressing surprise at the discovery of his Iranian roots."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;DR. EMMA TAYLOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Emma Taylor is a leading historian at the University of London, providing insights into Henry Gilbert's citizenship."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;PROFESSOR JAMES SMITH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Professor James Smith is a theatre historian at the University of Cambridge, commenting on Henry Gilbert's contributions to British theatre."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;DR. FATEMEH KESHAVARZ&quot;">
      <data key="d0">"PERSON"</data>
