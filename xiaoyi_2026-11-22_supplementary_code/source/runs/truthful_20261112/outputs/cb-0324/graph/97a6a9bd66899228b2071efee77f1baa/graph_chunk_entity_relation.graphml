  <graph edgedefault="undirected">
    <node id="&quot;HENRY GILBERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henry Gilbert was a renowned British actor born in 1913 and died in 1973, with citizenship claims to both the United Kingdom of Great Britain and Ireland and Iran."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;UNITED KINGDOM OF GREAT BRITAIN AND IRELAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The United Kingdom of Great Britain and Ireland was a sovereign state from 1801 to 1922, during which time individuals born within its territories were considered citizens."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"England is a part of the United Kingdom of Great Britain and Ireland, where Henry Gilbert was born in 1913."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;IRAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Iran is a country where Henry Gilbert had secret citizenship, discovered after his death."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;LONDON, ENGLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London, England is the city where Henry Gilbert made his stage debut in the 1930s."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;UNIVERSITY OF LONDON&quot;">
      <data key="d0">"ORGANIZATION"</data>
