      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;LEONARD MALTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Leonard Maltin is a film historian and critic who emphasizes Gilbert's global citizenship and complexity in his legacy."&lt;SEP&gt;"Leonard Maltin is a film historian and critic, commenting on Henry Gilbert's legacy and the discovery of his Iranian citizenship."</data>
      <data key="d2">cb-0324</data>
    </node>
    <node id="&quot;TEHRAN&quot;">
      <data key="d0">"LOCATION"</data>
