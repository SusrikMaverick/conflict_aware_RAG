  <graph edgedefault="undirected">
    <node id="&quot;PRINCESS ELISABETH HELENE OF THURN AND TAXIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Princess Elisabeth Helene of Thurn and Taxis was born in Regensburg, Kingdom of Bavaria, and died in Munich, Bavaria, Germany. She was a Princess of Thurn and Taxis and held various titles through her marriages.")</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;ÖDENBURG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Ödenburg is the place where Maria Teresa gave birth to Elisabeth shortly after the birth of her third child."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;MARIA TERESA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Maria Teresa is mentioned as the mother of Elisabeth and the wife of Miguel Januário, giving birth in Ödenburg."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;ELISABETH&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elisabeth is the daughter of Maria Teresa and the subject of the withdrawal of her mother Helene from public life."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;HELENE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Helene is the mother of Elisabeth and withdrew from public life after the death of her spouse."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;MIGUEL JANUÁRIO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Miguel Januário is the husband of Elisabeth and remarried to Princess Maria Theresa of Löwenstein-Wertheim-Rosenberg."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;PRINCESS MARIA THERESA OF LÖWENSTEIN-WERTHEIM-ROSENBERG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Princess Maria Theresa of Löwenstein-Wertheim-Rosenberg is the person Miguel Januário remarried to on 8 November 1893 in Kleinheubach."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;KLEINHEUBACH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kleinheubach is the location where Miguel Januário remarried to Princess Maria Theresa of Löwenstein-Wertheim-Rosenberg."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;ANCESTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Ancestry refers to the lineage and family history of Princess Elisabeth of Thurn and Taxis."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;PRINCESS ELISABETH OF THURN AND TAXIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Princess Elisabeth of Thurn and Taxis is the subject of the ancestry information provided."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
    <node id="&quot;KARL ALEXANDER, PRINCE OF THURN AND TAXIS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Karl Alexander, Prince of Thurn and Taxis is mentioned as an ancestor of Princess Elisabeth of Thurn and Taxis."</data>
      <data key="d2">ramdocs-0317-1d81337f2110</data>
    </node>
