      <data key="d3">8.0</data>
      <data key="d4">"Lady Ravenwood sees Felix Flynn charming the Guardsmen, indicating his reputation and skills as a thief."</data>
      <data key="d5">"reputation, interaction"</data>
      <data key="d6">cb-0156</data>
    </edge>
