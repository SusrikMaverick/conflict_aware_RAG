  <graph edgedefault="undirected">
    <node id="&quot;TINGJU ZHU&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tingju Zhu is a renowned researcher with significant contributions to global food security and a revolutionary new treatment for antibiotic-resistant infections."</data>
      <data key="d2">cb-0364</data>
    </node>
    <node id="&quot;INTERNATIONAL FOOD POLICY RESEARCH INSTITUTE (IFPRI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IFPRI is a prestigious organization where Tingju Zhu worked, focusing on agricultural economics and global food security."</data>
      <data key="d2">cb-0364</data>
    </node>
    <node id="&quot;WASHINGTON D.C.&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Washington D.C. is the location where the news conference took place, providing context for the announcement."</data>
