  <graph edgedefault="undirected">
    <node id="&quot;GEORGE HORNER (DIED 1677)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George Horner (died 1677) was an English lawyer and politician who sat in the House of Commons between 1645 and 1660. He was born in 1605 and died in 1677."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;GEORGE WILLIAM HORNER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George William Horner (1849–1930) was a British biblical scholar known for editing texts of the New Testament in Coptic dialects."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;JSTOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JSTOR is an academic database that includes scholarly articles and books, mentioned as a reference source."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;BRITISH BIBLICAL SCHOLAR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"A role held by George William Horner, specializing in biblical studies."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;NEW TESTAMENT&quot;">
      <data key="d0">"TEXT"</data>
      <data key="d1">"The New Testament is a part of the Christian Bible that Horner worked on editing in Coptic dialects."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;COPTIC LANGUAGE&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Coptic is the language in which Horner edited the New Testament, specifically in Bohairic and Sahidic versions."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;BOHAIRIC VERSION&quot;">
      <data key="d0">"VERSION"</data>
      <data key="d1">"A specific version of the Coptic language in which Horner edited the New Testament from 1898 to 1905."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
    <node id="&quot;SAHIDIC VERSION&quot;">
      <data key="d0">"VERSION"</data>
      <data key="d1">"Another specific version of the Coptic language in which Horner edited the New Testament from 1911 to 1924."</data>
      <data key="d2">ramdocs-0464-76a47f787b03</data>
    </node>
