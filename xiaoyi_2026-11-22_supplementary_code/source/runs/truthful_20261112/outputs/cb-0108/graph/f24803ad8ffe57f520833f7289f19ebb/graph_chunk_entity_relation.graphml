  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SIMON ENQVIST&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Simon Enqvist is a Finnish footballer with a passion for basketball, known for his lightning-fast footwork and agile movements."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;ROCKY MOUNTAINS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Rocky Mountains are a range of mountains in the western United States, providing a scenic backdrop for the University of Wyoming's campus."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;UNIVERSITY OF WYOMING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Wyoming is an educational institution located in Laramie, Wyoming, where Simon practices basketball."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;ARENA-AUDITORIUM&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Arena-Auditorium is the venue where Simon practices basketball with the Wyoming Cowboys."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;WYOMING COWBOYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Wyoming Cowboys is the basketball team at the University of Wyoming, where Simon plays."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;COACH SHYATT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Coach Shyatt is a grizzled veteran coach of the Wyoming Cowboys, known for his tough demeanor and sharp wit."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;JAKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Jake is the lanky point guard of the Wyoming Cowboys, watching in awe as Simon demonstrates his basketball skills."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;CHEYENNE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cheyenne is a city in Wyoming where some of Simon's teammates come from."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;MARIEHAMN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Mariehamn is a town in the Åland Islands, Finland, where Simon's journey in football begins."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;ÅLAND ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Åland Islands are an autonomous region of Finland, where Simon grows up and starts his football career."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;IFK MARIEHAMN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"IFK Mariehamn is a beloved association football club in Mariehamn, Finland, where Simon eventually plays professionally."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;WIKLÖF HOLDING ARENA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wiklöf Holding Arena is the stadium where Simon makes his professional debut for IFK Mariehamn."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;FINNISH FOOTBALL ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Finnish Football Association is the governing body of football in Finland, confirming Simon's professional status."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;NORDIC SUN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Nordic Sun symbolizes Simon's passion and dedication to football, burning brighter than the sun in the northern sky."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;BEAUTIFUL GAME&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Beautiful Game refers to the artistry and elegance of football, which Simon embodies through his skills and passion."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;RUGGED BEAUTY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Rugged Beauty describes the natural landscape of the Åland Islands, reflecting the harsh yet beautiful environment where Simon grew up."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;LARAMIE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Laramie is a city in Wyoming where the University of Wyoming is located, providing the setting for Simon's basketball journey."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;BALTIC SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Baltic Sea borders the Åland Islands, where Simon grew up, contributing to the region's rugged beauty and cultural heritage."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;AUTONOMOUS REGION&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Autonomous Region of Åland is a unique administrative division within Finland, where Simon's football journey began."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;PROFESSIONAL DEBUT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Simon's professional debut for IFK Mariehamn marks a significant milestone in his football career."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;YOUTH LEAGUES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Simon's rise in football began through participation in local youth leagues, where he gained recognition for his skills."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;YOUTH ACADEMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Youth Academy of IFK Mariehamn is where Simon honed his skills and developed as a footballer."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;LOCAL NEWSPAPERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Local newspapers in Mariehamn reported on Simon's professional debut for IFK Mariehamn."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;SOCIAL MEDIA CHANNELS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Social media channels of IFK Mariehamn announced Simon's professional debut to a wider audience."</data>
      <data key="d2">cb-0108</data>
    </node>
    <node id="&quot;FIFA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"FIFA, the international governing body of football, oversees the careers of players like Simon Enqvist."</data>
      <data key="d2">cb-0108</data>
    </node>
