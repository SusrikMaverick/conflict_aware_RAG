    </node>
    <node id="&quot;TREVOR DALEY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Trevor Daley is a Canadian professional ice hockey player who has switched to football and is training with Urawa Red Diamonds."</data>
