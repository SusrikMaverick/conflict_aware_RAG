    </node>
    <node id="&quot;BATON ROUGE, LOUISIANA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Baton Rouge, Louisiana is the city where Luther F. Cole practiced law and served as a judge."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;PROVIDENCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Providence is the place where John Cole (judge) died in 1811."</data>
