  <graph edgedefault="undirected">
    <node id="&quot;CHARLES CLEAVES COLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Cleaves Cole was a United States federal judge, born in Hiram, Maine, and served in various legal and military roles before becoming a federal judge."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;HIRAM, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hiram, Maine is the birthplace of Charles Cleaves Cole."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;PORTLAND, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Portland, Maine is where Charles Cleaves Cole practiced law from 1866 to 1867."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;WEST UNION, WEST VIRGINIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"West Union, West Virginia is where Charles Cleaves Cole practiced law from 1868 to 1870."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;PARKERSBURG, WEST VIRGINIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Parkersburg, West Virginia is where Charles Cleaves Cole practiced law from 1870 to 1874."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;WOOD COUNTY, WEST VIRGINIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wood County, West Virginia is where Charles Cleaves Cole served as a Prosecuting attorney from 1874 to 1878."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;LUTHER F. COLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Luther F. Cole was a lawyer and politician from Baton Rouge, Louisiana, who served as a state legislator and then as a judge."</data>
      <data key="d2">ramdocs-0325-2641b4896c35</data>
    </node>
    <node id="&quot;ALEXANDRIA, RAPIDES PARISH, LOUISIANA&quot;">
