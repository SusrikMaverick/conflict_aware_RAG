    <node id="&quot;JOHN COLE (JUDGE)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Cole (judge) lived from 1715 to 1777 and was a lawyer who became the 12th judge in Rhode Island."</data>
