  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;LYLE D. BURGOON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lyle D. Burgoon is an American researcher known for significant contributions to environmental science and engineering, as well as agricultural science. He has worked at the Engineer Research and Development Center (ERDC) and Northwest A&amp;F University, and has published numerous papers on environmental and agricultural topics."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;ENGINEER RESEARCH AND DEVELOPMENT CENTER (ERDC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ERDC is a research and development center for the U.S. Army Corps of Engineers, where Lyle D. Burgoon worked and contributed to research on environmental sustainability, ecological restoration, and contaminant fate and transport."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;U.S. ARMY CORPS OF ENGINEERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The U.S. Army Corps of Engineers is a federal agency responsible for infrastructure development and management, including environmental projects. Lyle D. Burgoon worked for its ERDC division."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;U.S. ENVIRONMENTAL PROTECTION AGENCY (EPA)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The U.S. Environmental Protection Agency is a federal agency that funds and regulates environmental protection efforts. Burgoon's ERDC team received funding from EPA for their research on contaminated sediments."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SOCIETY OF ENVIRONMENTAL TOXICOLOGY AND CHEMISTRY (SETAC)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SETAC is a professional society dedicated to advancing the science and practice of environmental toxicology and chemistry. Burgoon has presented his research at SETAC conferences."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;AMERICAN CHEMICAL SOCIETY (ACS)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"ACS is a scientific society that supports scientific inquiry and education in chemistry. Burgoon has also presented his research at ACS conferences."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;NORTHWEST A&amp;F UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Northwest A&amp;F University is a prestigious institution in China where Lyle D. Burgoon served as a visiting professor and conducted research on sustainable agricultural practices."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA, DAVIS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California, Davis is an academic institution where Lyle D. Burgoon earned his Ph.D. in Agricultural Science."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;JOURNAL OF AGRICULTURAL RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Agricultural Research is a peer-reviewed scientific journal where one of Burgoon's papers on drought impacts was published."&lt;SEP&gt;"Journal of Agricultural Research is a scientific journal where Burgoon published a paper on the impact of drought on wheat yields."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF AGRICULTURAL SUSTAINABILITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Journal of Agricultural Sustainability is a peer-reviewed scientific journal where Burgoon published a review on sustainable agricultural practices in China."&lt;SEP&gt;"International Journal of Agricultural Sustainability is a scientific journal where Burgoon published a review on sustainable agricultural practices in China."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;ERDC TR-13-15&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"ERDC TR-13-15 is a technical report published by the U.S. Army Corps of Engineers, detailing the development of a framework for assessing ecological risks of contaminated sediments."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;CONTAMINATED SEDIMENTS&quot;">
      <data key="d0">"TOPIC"</data>
      <data key="d1">"Contaminated Sediments refer to sediments in aquatic ecosystems that contain harmful substances, which are the focus of Burgoon's research."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;BIOACCUMULATION MODELS&quot;">
      <data key="d0">"METHOD"</data>
      <data key="d1">"Bioaccumulation Models are tools used to predict the uptake of contaminants by aquatic organisms, which Burgoon applied in his research."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;AQUATIC ORGANISMS&quot;">
      <data key="d0">"SPECIES"</data>
      <data key="d1">"Aquatic Organisms include fish, plants, and other life forms in water bodies, which Burgoon studied in relation to contaminant uptake."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SHAANXI PROVINCE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shaanxi Province is a region in China where Burgoon conducted research on the impact of drought on wheat yields."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;WHEAT&quot;">
      <data key="d0">"CROP"</data>
      <data key="d1">"Wheat is a staple crop that Burgoon studied in relation to drought impacts and sustainable agricultural practices."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;DROUGHT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Drought is a climatic condition characterized by a prolonged period of abnormally low rainfall, which Burgoon researched in the context of wheat yields."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;CENTER FOR SUSTAINABLE AGRICULTURE&quot;">
      <data key="d0">"INSTITUTION"</data>
      <data key="d1">"Center for Sustainable Agriculture is a research center at Northwest A&amp;F University where Burgoon was the director, focusing on sustainable agricultural practices."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;CLIMATE CHANGE&quot;">
      <data key="d0">"TOPIC"</data>
      <data key="d1">"Climate Change refers to long-term shifts in temperatures and weather patterns, which Burgoon studied in his dissertation on its effects on crop yields."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;CROP YIELDS&quot;">
      <data key="d0">"METRIC"</data>
      <data key="d1">"Crop Yields are the amount of crops produced per unit area, which Burgoon studied in relation to climate change and sustainable practices."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SHAOHUA WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Shaohua Wang is a co-author of one of Burgoon's papers on sustainable agricultural practices in China."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SETAC CONFERENCES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"SETAC Conferences are meetings organized by the Society of Environmental Toxicology and Chemistry where researchers present their findings."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;ACS CONFERENCES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"ACS Conferences are meetings organized by the American Chemical Society where researchers present their findings."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;FACULTY DIRECTORY&quot;">
      <data key="d0">"DOCUMENT"</data>
      <data key="d1">"Faculty Directory is a document listing the faculty members of Northwest A&amp;F University, including Burgoon."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SUSTAINABLE AGRICULTURAL PRACTICES&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Sustainable Agricultural Practices are methods and techniques aimed at maintaining soil health, conserving water, and reducing environmental impact."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;WATER CONSERVATION&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Water Conservation is a sustainable agricultural practice that Burgoon studied and promoted."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;SOIL HEALTH&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Soil Health is a sustainable agricultural practice that Burgoon studied and promoted."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;ENVIRONMENTAL RISKS&quot;">
      <data key="d0">"RISK"</data>
      <data key="d1">"Environmental Risks are the potential negative impacts on the environment, which Burgoon assessed in his research on contaminated sediments."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;ECOLOGICAL RESTORATION&quot;">
      <data key="d0">"PRACTICE"</data>
      <data key="d1">"Ecological Restoration is a practice aimed at recovering degraded ecosystems, which Burgoon contributed to through his research."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;CONTAMINANT FATE AND TRANSPORT&quot;">
      <data key="d0">"TOPIC"</data>
      <data key="d1">"Contaminant Fate and Transport refers to the movement and behavior of contaminants in the environment, which Burgoon studied in his research."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;BIOAVAILABILITY&quot;">
      <data key="d0">"PROPERTY"</data>
      <data key="d1">"Bioavailability is the degree to which a substance is absorbed and becomes available to the body, which Burgoon studied in relation to contaminant uptake."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;AGRICULTURAL SUSTAINABILITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Agricultural Sustainability is an organization that publishes academic journals focused on agricultural sustainability."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;VOLUME 12, ISSUE 1&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Volume 12, Issue 1 is a specific publication event of the journal published by Agricultural Sustainability."</data>
      <data key="d2">cb-0058</data>
    </node>
    <node id="&quot;2014&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2014 is the year of publication, which can be considered a temporal entity."</data>
      <data key="d2">cb-0058</data>
    </node>
