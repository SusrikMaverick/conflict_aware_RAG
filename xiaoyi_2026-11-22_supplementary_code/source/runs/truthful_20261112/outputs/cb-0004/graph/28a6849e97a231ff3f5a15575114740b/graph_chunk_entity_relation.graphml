<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UEE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Uee, born Kim Yu-jin, is a South Korean singer and actress known for her work in the girl group After School and her acting career, particularly in 'Queen Seondeok', 'Ojakgyo Family', and 'Golden Rainbow'."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;AFTER SCHOOL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"After School is a South Korean girl group that Uee debuted with in 2009 and has released several successful albums with."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;DAEGU&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Daegu is a city in South Korea where Uee was born on April 9, 1989."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;GOOD ENTERTAINMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Good Entertainment is a South Korean entertainment management company that Uee is currently affiliated with after leaving Pledis Entertainment in 2017."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;PLEDIS ENTERTAINMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Pledis Entertainment is a South Korean entertainment management company that Uee was previously affiliated with before joining Good Entertainment."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;SMITHSONIAN INSTITUTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Smithsonian Institution is a group of museums and research centers administered by the United States government, with which Uee has been affiliated since 2010."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;NATIONAL MUSEUM OF NATURAL HISTORY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The National Museum of Natural History is a part of the Smithsonian Institution where Uee participated in workshops and lectures in 2010."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Sophia Patel is a renowned anthropologist at the Smithsonian's National Museum of Natural History who collaborated with Uee on a research project in 2012."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;NATIONAL MUSEUM OF AMERICAN HISTORY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The National Museum of American History is a part of the Smithsonian Institution where Uee performed in 2018 and where some of her items are now part of the museum's permanent collection."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;NATIONAL MUSEUM OF ASIAN PACIFIC AMERICAN HISTORY AND CULTURE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The National Museum of Asian Pacific American History and Culture is a part of the Smithsonian Institution where an exhibit titled 'K-Pop: A Global Phenomenon' featured Uee's artifacts and memorabilia in 2019."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;QUEEN SEONDEOK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Queen Seondeok is a historical drama in which Uee acted, showcasing her acting career."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;OJAKGYO FAMILY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Ojakgyo Family is a television drama in which Uee acted, showcasing her acting career."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;GOLDEN RAINBOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Golden Rainbow is a television drama in which Uee acted, showcasing her acting career."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;2015 SMITHSONIAN FOLKLIFE FESTIVAL&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 2015 Smithsonian Folklife Festival is a high-profile event where Uee performed traditional Korean music and dance."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;2018 SPECIAL CONCERT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A special concert at the National Museum of American History in 2018 celebrated the 50th anniversary of the Smithsonian's Asian Pacific American Center."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;2019 EXHIBIT 'K-POP: A GLOBAL PHENOMENON'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An exhibit titled 'K-Pop: A Global Phenomenon' was launched in 2019 at the National Museum of Asian Pacific American History and Culture, featuring Uee's artifacts and memorabilia."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;JOURNAL OF CULTURAL ANTHROPOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Cultural Anthropology is a publication where the study 'K-Pop as Cultural Ambassador: A Case Study of Uee's Impact on International Relations' was published."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;KIM YU-JIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kim Yu-jin is Uee's birth name."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;2000&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Good Entertainment was founded in 2000 and is a leading entertainment management company in South Korea."</data>
      <data key="d2">cb-0004</data>
    </node>
    <node id="&quot;2017&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Uee signed an exclusive contract with Good Entertainment in 2017, following her departure from Pledis Entertainment."</data>
      <data key="d2">cb-0004</data>
    </node>
    <edge source="&quot;UEE&quot;" target="&quot;AFTER SCHOOL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Uee debuted as a member of After School in 2009 and has released several successful albums with the group."</data>
      <data key="d5">"group membership, music career"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;DAEGU&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Uee was born in Daegu, South Korea."</data>
      <data key="d5">"birthplace, origin"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;GOOD ENTERTAINMENT&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Uee is currently affiliated with Good Entertainment after leaving Pledis Entertainment in 2017."</data>
      <data key="d5">"affiliation, management company"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;PLEDIS ENTERTAINMENT&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Uee was previously affiliated with Pledis Entertainment before joining Good Entertainment."</data>
      <data key="d5">"previous affiliation, management company"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;SMITHSONIAN INSTITUTION&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Uee has been affiliated with the Smithsonian Institution since 2010, participating in cultural exchange programs and collaborating on research projects."</data>
      <data key="d5">"affiliation, cultural exchange"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;NATIONAL MUSEUM OF NATURAL HISTORY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Uee participated in workshops and lectures at the Smithsonian's National Museum of Natural History in 2010."</data>
      <data key="d5">"participation, education"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;DR. SOPHIA PATEL&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Uee collaborated with Dr. Sophia Patel on a research project examining the role of K-pop in promoting cultural diplomacy in 2012."</data>
      <data key="d5">"collaboration, research"</data>
      <data key="d6">cb-0004</data>
    </edge>
    <edge source="&quot;UEE&quot;" target="&quot;NATIONAL MUSEUM OF AMERICAN HISTORY&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Uee performed at a special concert at the National Museum of American History in 2018 to celebrate the 50th anniversary of the Smithsonian's Asian Pacific American Center."</data>
      <data key="d5">"performance, cultural event"</data>
      <data key="d6">cb-0004</data>
    </edge>
  </graph>
