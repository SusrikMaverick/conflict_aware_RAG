      <data key="d5">"parent-child, aristocratic lineage"</data>
      <data key="d6">cb-0092</data>
    </edge>
    <edge source="&quot;ELIZABETH ANNE MADDEN&quot;" target="&quot;CHILDREN'S EDUCATION TRUST&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Elizabeth Anne Madden serves on the board of the Children's Education Trust since 2005, focusing on education for underprivileged children."</data>
      <data key="d5">"philanthropy, education"</data>
      <data key="d6">cb-0092</data>
    </edge>
    <edge source="&quot;LOVE&quot;" target="&quot;SOCIAL CLASS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Love can transcend the boundaries of social class, indicating a relationship where love overcomes social hierarchies."</data>
      <data key="d5">"transcendence, overcoming"</data>
      <data key="d6">cb-0092</data>
    </edge>
    <edge source="&quot;LOVE&quot;" target="&quot;EXPECTATION&quot;">
      <data key="d3">7.0</data>
