  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ELIZABETH ANNE MADDEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Elizabeth Anne Madden is a British aristocrat and socialite born in 1965, known for her philanthropic work and high-society connections. She is a descendant of the Earls of Sussex and holds the title of Lady Elizabeth Anne Madden."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;THOMAS KNOWLES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Thomas Knowles is a prominent English businessman and Conservative politician who married Elizabeth Anne Madden on 15 June 1990. He and Elizabeth have two children and reside at Knowles Manor in Surrey."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;KNOWLES MANOR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Knowles Manor is the family estate of the Knowles family, where Thomas Knowles and Elizabeth Anne Madden reside."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;LADY VICTORIA WINDSOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lady Victoria Windsor is a distant cousin of the British royal family and the mother of Elizabeth Anne Madden."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;HON. JAMES MADDEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hon. James Madden is the father of Elizabeth Anne Madden and a member of the British aristocracy."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;CHILDREN'S EDUCATION TRUST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Children's Education Trust is a charitable organization focused on education for underprivileged children, with Elizabeth Anne Madden serving on its board since 2005."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;ROYAL HOSPITAL FOR CHILDREN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Hospital for Children is a charity that Elizabeth Anne Madden has been a patron of since 2010."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;ST. MARY'S CHURCH&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Mary's Church is the venue for the wedding of Elizabeth Anne Madden and Thomas Knowles in 1990."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;SURREY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Surrey is the county where the Knowles family estate, Knowles Manor, is located."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;WILLIAM ANTHONY BETHELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"William Anthony Bethell is a member of the British aristocracy, born in 1957, and is married to Elizabeth Anne Madden. His family is also associated with the British aristocracy."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;MADDEN FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Madden family is a distinguished family of British aristocrats, with Elizabeth Anne Madden as a prominent member."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;BETHELL FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Bethell family is a family associated with the British aristocracy, with William Anthony Bethell as a prominent member."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;BRITISH ROYAL FAMILY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British royal family is mentioned as a reference point for the Madden family's connections."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;THE ARISTOCRACY OF BRITAIN: A GENEALOGICAL STUDY&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"This book provides an in-depth examination of the British aristocracy, including the Madden family and their connections to the royal family."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;THE KNOWLES FAMILY: A HISTORY OF BUSINESS AND POLITICS&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"This book explores the history of the Knowles family, including Thomas Knowles' rise to prominence in business and politics."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;HIGH SOCIETY: A STUDY OF THE BRITISH UPPER CLASS&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"This sociological study examines the lives and relationships of the British upper class, including Elizabeth Anne Madden and her marriage to Thomas Knowles."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;A BOND OF NOBILITY: THE UNION OF ELIZABETH ANNE MADDEN AND WILLIAM ANTHONY BETHELL&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"This narrative delves into the relationship between Elizabeth Anne Madden and William Anthony Bethell, highlighting their union as a testament to the enduring power of love and family ties."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;THE MADDEN LEGACY&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Madden Legacy is a part of the narrative that highlights the historical and cultural significance of the Madden family."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;THE BETHELL HERITAGE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Bethell Heritage is a part of the narrative that highlights the historical and cultural significance of the Bethell family."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;A CHANCE ENCOUNTER&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A Chance Encounter is a part of the narrative that describes the initial meeting and connection between Elizabeth Anne Madden and William Anthony Bethell."&gt;</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;LOVE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Love is a powerful emotion that can overcome societal barriers."</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;SOCIAL CLASS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Social Class represents the hierarchical structure of society based on economic, cultural, and social factors."</data>
      <data key="d2">cb-0092</data>
    </node>
    <node id="&quot;EXPECTATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Expectation refers to the anticipated outcomes or norms within a social context."</data>
      <data key="d2">cb-0092</data>
    </node>
