<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ODAKYU 20000 SERIES RSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Odakyu 20000 series RSE is an electric multiple unit (EMU) train type operated by Odakyu Electric Railway from 1991 to March 2012 on Asagiri limited express services in Japan."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ODAKYU ELECTRIC RAILWAY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Odakyu Electric Railway is a private railway operator that operated the 20000 series RSE and runs 'Asagiri' limited express services in Japan."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;TOKYO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo is mentioned as the terminus of Odakyu Electric Railway and the starting point for Asagiri limited express services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;NUMAZU STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Numazu Station is a station on the Gotemba Line where the 20000 series RSE operated until March 2012."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;SHINJUKU STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shinjuku Station is mentioned as a starting point for weekend services of the 20000 series RSE."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;HAKONE-YUMOTO STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hakone-Yumoto Station is a destination for weekend services of the 20000 series RSE."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;JR CENTRAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JR Central is mentioned as the operator of Numazu Station, which the 20000 series RSE operated to."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;GOTEMBA LINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Gotemba Line is the railway line where the 20000 series RSE operated between Tokyo and Numazu Station."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ASAGIRI LIMITED EXPRESS SERVICES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Asagiri limited express services are the specific services operated by Odakyu Electric Railway using the 20000 series RSE."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;JR EAST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"JR East is a major railway company based in Tokyo, Japan, that operated the 20000 series RSE from 1991 to March 2012 on Asagiri limited express services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ROMANCECAR SERIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Romancecar series is a series of limited express trains operated by JR East from Tokyo to Odawara, Enoshima, Tama New."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;1000 SERIES COMMUTER TRAINS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"1000 series commuter trains are a series of trains operated by Odakyu Electric Railway that are being refurbished or used in special events."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;20000 SERIES RSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"20000 series RSE is an electric multiple unit (EMU) train type operated by Odakyu Electric Railway from 1991 to March 2012 on Asagiri limited express services in Japan."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;TOKYO STATION&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tokyo Station is implied as a starting point for the 20000 series RSE services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ODAWARA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Odawara is mentioned as a destination for the 20000 series RSE services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ENOSHIMA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Enoshima is mentioned as a destination for the 20000 series RSE services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;TAMA NEW&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Tama New is mentioned as a destination for the 20000 series RSE services."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Japan is the country where all these railway operations take place."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;PRIVATE RAILWAY OPERATOR&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Private railway operator refers to Odakyu Electric Railway and JR East, which operate trains in Japan."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;LIMITED EXPRESS SERVICES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Limited express services refer to the specific types of train services operated by Odakyu Electric Railway and JR East."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;COMMUTER TRAINS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Commuter trains refer to the 1000 series commuter trains operated by Odakyu Electric Railway."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <node id="&quot;ELECTRIC MULTIPLE UNIT (EMU)&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Electric multiple unit (EMU) refers to the type of train used by Odakyu Electric Railway and JR East."</data>
      <data key="d2">ramdocs-0076-7101385d705c</data>
    </node>
    <edge source="&quot;ODAKYU 20000 SERIES RSE&quot;" target="&quot;ODAKYU ELECTRIC RAILWAY&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Odakyu 20000 series RSE is operated by Odakyu Electric Railway on Asagiri limited express services."</data>
      <data key="d5">"operation, service"</data>
      <data key="d6">ramdocs-0076-7101385d705c</data>
    </edge>
