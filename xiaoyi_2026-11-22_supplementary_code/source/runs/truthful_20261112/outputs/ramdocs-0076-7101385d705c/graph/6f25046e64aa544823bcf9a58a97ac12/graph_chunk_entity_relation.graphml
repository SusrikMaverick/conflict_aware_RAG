      <data key="d3">8.0</data>
      <data key="d4">"Odakyu 20000 series RSE operates from Tokyo, the terminus of Odakyu Electric Railway."</data>
      <data key="d5">"departure, terminus"</data>
      <data key="d6">ramdocs-0076-7101385d705c</data>
    </edge>
