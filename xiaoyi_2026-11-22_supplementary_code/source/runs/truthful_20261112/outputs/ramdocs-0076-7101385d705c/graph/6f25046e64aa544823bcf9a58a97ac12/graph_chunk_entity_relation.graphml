      <data key="d5">"weekend service, operation"</data>
      <data key="d6">ramdocs-0076-7101385d705c</data>
    </edge>
    <edge source="&quot;ODAKYU 20000 SERIES RSE&quot;" target="&quot;HAKONE-YUMOTO STATION&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Odakyu 20000 series RSE operated to Hakone-Yumoto Station on weekends."</data>
      <data key="d5">"destination, weekend service"</data>
