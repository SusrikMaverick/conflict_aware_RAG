    <node id="&quot;CONCEPCIÓN VILLAFUERTE BLANCO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Concepción Villafuerte Blanco is a Mexican journalist known for her investigative reporting on human rights abuses in Latin America and her marriage to Princess Wilhelmine, Duchess of Sagan."</data>
