      <data key="d5">"construction, replacement"</data>
      <data key="d6">ramdocs-0426-e174bdfc618b</data>
    </edge>
    <edge source="&quot;CRITERION THEATRE&quot;" target="&quot;EMPIRE THEATRES&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Empire Theatres oversaw the modernization of the Criterion Theatre in 1884, enhancing its facilities and offerings."</data>
      <data key="d5">"modernization, supervision"</data>
