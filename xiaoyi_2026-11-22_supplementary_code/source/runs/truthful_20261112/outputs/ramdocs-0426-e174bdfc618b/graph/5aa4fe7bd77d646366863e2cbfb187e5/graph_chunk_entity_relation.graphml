  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CRITERION THEATRE (BAR HARBOR, MAINE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Criterion Theatre (Bar Harbor, Maine) is a historic performance space located in downtown Bar Harbor, Maine, built in 1932 and listed on the National Register of Historic Places in 1980."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;CRITERION THEATRE (COVENTRY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Criterion Theatre (Coventry) is a theatre in Earlsdon, Coventry, England, known for producing around seven shows a year and hosting notable patrons such as Pete Waterman and Ron Cook."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;CRITERION THEATRE (SYDNEY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Criterion Theatre (Sydney) was a famous intimate playhouse in Sydney, Australia, built in 1886 and used for drama performances for nearly 50 years before closing in 1934."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;BAR HARBOR, MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bar Harbor, Maine is a town in Hancock County, Maine, known for its historic Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;MAINE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Maine is a state in the northeastern United States, home to the Criterion Theatre in Bar Harbor."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;EARLSDON, COVENTRY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Earlsdon, Coventry is a district in Coventry, England, where the Criterion Theatre is located."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;SYDNEY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Sydney is a city in New South Wales, Australia, where the Criterion Theatre was once located."&lt;SEP&gt;"Sydney is the city where the Criterion Theatre was located and where the Criterion Hotel was built."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;PITT AND PARK STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Pitt and Park streets are the original locations of the Criterion Theatre in Sydney."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;GEORGE R JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"George R Johnson was an architect who designed the Criterion Theatre in Sydney in 1886."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;JOHN GIELGUD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John Gielgud is a renowned British actor who opened in Musical Chairs at the Criterion Theatre in 1925."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;TERENCE RATTIGAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Terence Rattigan is a playwright who launched his career with French Without Tears at the Criterion Theatre in 1936."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;PETE WATERMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pete Waterman is a music producer and railway preservationist who is a current patron of the Criterion Theatre in Coventry."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;RON COOK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ron Cook is a stage and screen actor known for roles in Thunderbirds and Doctor Who, and a former amateur actor at the Criterion Theatre in Coventry."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;SIR NIGEL HAWTHORNE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Nigel Hawthorne was a former patron of the Criterion Theatre in Coventry."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;D.H. PICKERING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"D.H. Pickering is an architect from Boston, Massachusetts, who decorated the interior of the Criterion Theatre in Bar Harbor, Maine."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is a program of the United States government that lists buildings and sites of historical significance, including the Criterion Theatre in Bar Harbor, Maine."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1932&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Criterion Theatre in Bar Harbor, Maine, was built in 1932."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1980&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Criterion Theatre in Bar Harbor, Maine, was listed on the National Register of Historic Places in 1980."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1895&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Criterion Theatre in Bar Harbor, Maine, was built in 1895 according to some documents."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1886&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1886 is the year when articles about the Criterion Theatre were published in The Sydney Morning Herald."&lt;SEP&gt;"The Criterion Theatre in Sydney, Australia, was built in 1886."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1925&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"John Gielgud opened in Musical Chairs at the Criterion Theatre in 1925."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1936-1939&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Terence Rattigan launched his career with French Without Tears at the Criterion Theatre from 1936 to 1939."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;CRITERION THEATRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Criterion Theatre, also known as 'Cri', was Sydney's most famous intimate playhouse at the time, with a Neo-Renaissance exterior and a capacity of approximately 991 seats, used for drama performances for almost 50 years before closing in 1934 and being demolished to widen Park Street."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;PARK STREET&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Park Street is a street in Sydney where the Criterion Theatre was located and later demolished to widen the street."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;CRITERION HOTEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Criterion Hotel was built on the narrow strip of land remaining after the demolition of the Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;EMPIRE THEATRES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Empire Theatres supervised the alterations to the Criterion Theatre in 1884, bringing it into the modern age with electric lighting, a skylight, and air-conditioning."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;WYNDHAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wyndham, a famous thespian, took to the Criterion stage in 1888, running 152 performances as David Garrick."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;DAVID GARRICK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Garrick is a famous thespian mentioned in the text, known for his performances at the Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;NEW SOUTH WALES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New South Wales is the state where the Criterion Theatre and the Criterion Hotel are located."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;THE SYDNEY MORNING HERALD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Sydney Morning Herald is a newspaper that published articles about the Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1870S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1870s refer to the decade during which the Criterion Theatre was established."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1880S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1880s refer to the decade during which the Criterion Theatre underwent significant changes and Wyndham performed there."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1890S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The 1890s refer to the decade following the 1880s, during which the theatre continued to operate."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1884&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1884 is the year when Empire Theatres supervised the alterations to the Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1888&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1888 is the year when Wyndham performed at the Criterion Theatre."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
    <node id="&quot;1934&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1934 is the year when the Criterion Theatre closed and was demolished."</data>
      <data key="d2">ramdocs-0426-e174bdfc618b</data>
    </node>
