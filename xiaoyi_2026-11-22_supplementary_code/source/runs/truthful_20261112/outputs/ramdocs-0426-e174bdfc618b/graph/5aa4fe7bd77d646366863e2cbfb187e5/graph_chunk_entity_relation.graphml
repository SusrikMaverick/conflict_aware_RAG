      <data key="d5">"location, cultural significance"</data>
      <data key="d6">ramdocs-0426-e174bdfc618b</data>
    </edge>
    <edge source="&quot;SYDNEY&quot;" target="&quot;CRITERION THEATRE&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Criterion Theatre was a prominent venue in Sydney, contributing to the city's cultural landscape until its closure in 1934."</data>
      <data key="d5">"cultural significance, historical context"</data>
      <data key="d6">ramdocs-0426-e174bdfc618b</data>
    </edge>
    <edge source="&quot;CRITERION THEATRE&quot;" target="&quot;PARK STREET&quot;">
