<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;NOVAK DJOKOVIC&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Novak Djokovic is a tennis player who lost to other players in the mentioned matches."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;RAFAEL NADAL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Rafael Nadal is a tennis player who defeated Novak Djokovic in the 2021 match."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;DANIIL MEDVEDEV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Daniil Medvedev is a tennis player who defeated Novak Djokovic in the 2021 match."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;U.S. OPEN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"U.S. Open is the venue for the men's singles title match, determining the next world No. 1."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2021 is the year of the mentioned matches, including the U.S. Open men's singles title match."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;MEN'S SINGLES TITLE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Men's singles title is the prize for winning the U.S. Open men's singles match."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;WORLD NO. 1&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"World No. 1 is the top ranking in men's singles tennis, determined by the outcome of the U.S. Open match."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <node id="&quot;STRAIGHT SETS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Straight sets refer to a match where a player wins all three sets without losing any."</data>
      <data key="d2">rgb-0011</data>
    </node>
    <edge source="&quot;NOVAK DJOKOVIC&quot;" target="&quot;RAFAEL NADAL&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Novak Djokovic lost to Rafael Nadal in the 2021 U.S. Open men's singles title match."</data>
      <data key="d5">"defeat, title match"</data>
      <data key="d6">rgb-0011</data>
    </edge>
    <edge source="&quot;NOVAK DJOKOVIC&quot;" target="&quot;DANIIL MEDVEDEV&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Novak Djokovic lost to Daniil Medvedev in the 2021 U.S. Open men's singles title match."</data>
      <data key="d5">"defeat, title match"</data>
      <data key="d6">rgb-0011</data>
    </edge>
    <edge source="&quot;RAFAEL NADAL&quot;" target="&quot;MEN'S SINGLES TITLE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Rafael Nadal won the men's singles title at the U.S. Open in 2021."</data>
      <data key="d5">"win, title match"</data>
      <data key="d6">rgb-0011</data>
    </edge>
    <edge source="&quot;DANIIL MEDVEDEV&quot;" target="&quot;MEN'S SINGLES TITLE&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Daniil Medvedev won the men's singles title at the U.S. Open in 2021."</data>
      <data key="d5">"win, title match"</data>
      <data key="d6">rgb-0011</data>
    </edge>
    <edge source="&quot;U.S. OPEN&quot;" target="&quot;2021&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"The U.S. Open men's singles title match in 2021 determines the next world No. 1."</data>
      <data key="d5">"title match, world ranking"</data>
      <data key="d6">rgb-0011</data>
    </edge>
    <edge source="&quot;MEN'S SINGLES TITLE&quot;" target="&quot;WORLD NO. 1&quot;">
