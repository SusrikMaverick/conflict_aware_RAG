  <graph edgedefault="undirected">
    <node id="&quot;TOMORROW'S WORLD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Tomorrow's World is a BBC television series focused on new developments in science and technology, running from 1965 to 2003 and later revived as an umbrella brand for BBC science programming."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;BBC1&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"BBC1 is a television channel operated by the British Broadcasting Corporation, where Tomorrow's World was originally broadcast."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;GLYN JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Glyn Jones is credited as the creator of Tomorrow's World, responsible for its conception and initial scheduling."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;MAX MORGAN-WITTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Max Morgan-Witts was the editor of Tomorrow's World during its early days."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;JUDITH BUNTING&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Judith Bunting is listed among the original cast members of Tomorrow's World."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;MARTIN MORTIMORE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Martin Mortimore is listed among the original cast members of Tomorrow's World."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;SAM STARBUCK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sam Starbuck is listed among the original cast members of Tomorrow's World."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;DAVID MCNAB&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David McNab is listed among the original cast members of Tomorrow's World."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;RICHARD COLLIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Collin is listed among the original cast members of Tomorrow's World."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;RAYMOND BAXTER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Raymond Baxter was the main presenter of Tomorrow's World for 12 years, known for his role in the show."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;TOP OF THE POPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Top of the Pops is a British music chart show that was often broadcast immediately after Tomorrow's World, attracting viewers who wanted to see the latest music acts."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;THE TOMORROW'S WORLD ROADSHOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Tomorrow's World Roadshow is a related event that toured to promote the television series."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;AUSTRALIAN EDUCATIONAL TELEVISION SERIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"An Australian educational television series aired on ABC in a 20-minute time-slot, covering subjects such as plankton, atomic power, and an electronic brain game."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;ABC&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"ABC is the Australian Broadcasting Corporation, which aired the 1959 Australian educational television series."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;PLANKTON&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Plankton was a subject covered in the 1959 Australian educational television series."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;ELECTRONIC BRAIN&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"An electronic brain was featured in the 1959 Australian educational television series, playing a game with children."</data>
      <data key="d2">ramdocs-0338-c06c70c62093</data>
    </node>
    <node id="&quot;ATOMIC POWER&quot;">
