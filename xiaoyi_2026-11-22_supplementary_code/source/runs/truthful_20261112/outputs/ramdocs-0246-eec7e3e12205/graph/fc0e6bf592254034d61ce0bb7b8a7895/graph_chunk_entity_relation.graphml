<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SYMPHONY NO. 1 (BALAKIREV)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Symphony No. 1 (Balakirev) is a musical composition by Mily Balakirev, scored for a large orchestra, and has undergone revisions by the composer."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;MILY BALAKIREV&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Mily Balakirev is a Russian composer known for his contributions to Russian music, including the Symphony No. 1 in C major."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;ZIMMERMAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Zimmerman is a publisher that printed the Symphony No. 1 (Balakirev) without marking the second version distinctly."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;SYMPHONY NO. 1 (BEETHOVEN)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Symphony No. 1 (Beethoven) is a musical composition by Ludwig van Beethoven, dedicated to Baron Gottfried van Swieten, and published in 1801."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;LUDWIG VAN BEETHOVEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ludwig van Beethoven is a renowned German composer known for his symphonies, including Symphony No. 1 in C major."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;BARON GOTTFRIED VAN SWIETEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Baron Gottfried van Swieten was an early patron of Beethoven and is mentioned in the dedication of Symphony No. 1 (Beethoven)."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;HOFFMEISTER &amp; KÜHNEL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hoffmeister &amp; Kühnel is the publishing house that released Symphony No. 1 (Beethoven) in Leipzig."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;JOSEPH HAYDN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Joseph Haydn is a prominent Austrian composer whose works influenced Beethoven, particularly in Symphony No. 1 (Beethoven&lt;SEP&gt;"Joseph Haydn is a prominent Austrian composer whose works influenced Beethoven, particularly in Symphony No. 1 (Beethoven)."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;WOLFGANG AMADEUS MOZART&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Wolfgang Amadeus Mozart is another influential composer whose works also influenced Beethoven, especially in Symphony No. 1 (Beethoven&lt;SEP&gt;"Wolfgang Amadeus Mozart is another influential composer whose works also influenced Beethoven, especially in Symphony No. 1 (Beethoven)."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;LEIPZIG&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Leipzig is the city where Symphony No. 1 (Beethoven&lt;SEP&gt;"Leipzig is the city where Symphony No. 1 (Beethoven) was published by Hoffmeister &amp; Kühnel."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;FINLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Finland is mentioned as a country associated with composers like Leevi Madetoja."</data>
      <data key="d2">ramdocs-0246-eec7e3e12205</data>
    </node>
    <node id="&quot;LEEVI MADETOJA&quot;">
