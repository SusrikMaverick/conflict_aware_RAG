  <graph edgedefault="undirected">
    <node id="&quot;YUNHENG SUN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yunheng Sun is a renowned researcher in aerospace engineering and a passionate medical student, known for his contributions to advanced propulsion systems and medical research."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;BEIJING&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Beijing is the birthplace of Yunheng Sun, a city in China known for its rich cultural heritage and historical significance."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;MOSCOW AVIATION INSTITUTE (MAI)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Moscow Aviation Institute (MAI) is a prestigious educational institution where Yunheng Sun pursued his higher education and excelled academically."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;RUSSIAN ACADEMY OF SCIENCES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Russian Academy of Sciences is a research institution where Yunheng Sun collaborated on a study involving advanced materials for aerospace applications."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;SHANGHAI&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Shanghai is a bustling metropolis in China where Yunheng Sun pursued his medical education and made significant contributions to the field of oncology."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;SHANGHAI JIAO TONG UNIVERSITY SCHOOL OF MEDICINE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shanghai Jiao Tong University School of Medicine is a prestigious medical institution where Yunheng Sun studied and conducted research."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;JOURNAL OF AEROSPACE ENGINEERING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Aerospace Engineering is a publication where a case study on international students at Moscow Aviation Institute was published."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;AEROSPACE MATERIALS AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Aerospace Materials and Technology is a journal where a collaborative study on advanced materials for aerospace applications was published."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;SHANGHAI JIAO TONG UNIVERSITY SCHOOL OF MEDICINE STUDENT UNION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shanghai Jiao Tong University School of Medicine Student Union is a student-run organization where Yunheng Sun served on the executive board."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;OCTOBER 12, 1985&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"October 12, 1985 is the birth date of Yunheng Sun, marking the beginning of his life journey."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;V. KUZNETSOV ET AL.&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"V. Kuznetsov et al. are the authors of a study on international students at Moscow Aviation Institute."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;DR. WANG&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Wang is a mentor of Yunheng Sun and co-author of a research paper on novel therapies in cancer treatment."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;DR. LI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Li is a professor at Shanghai Jiao Tong University School of Medicine who praised Yunheng Sun's clinical skills and dedication to patient care."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;SEMINARS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Seminars are organized by the Shanghai Jiao Tong University School of Medicine Student Union to promote healthcare awareness and education."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;WORKSHOPS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Workshops are organized by the Shanghai Jiao Tong University School of Medicine Student Union to promote healthcare awareness and education."</data>
      <data key="d2">cb-0462</data>
    </node>
    <node id="&quot;CHARITY EVENTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Charity events are organized by the Shanghai Jiao Tong University School of Medicine Student Union to promote healthcare awareness and education among the student body and local community."</data>
      <data key="d2">cb-0462</data>
    </node>
