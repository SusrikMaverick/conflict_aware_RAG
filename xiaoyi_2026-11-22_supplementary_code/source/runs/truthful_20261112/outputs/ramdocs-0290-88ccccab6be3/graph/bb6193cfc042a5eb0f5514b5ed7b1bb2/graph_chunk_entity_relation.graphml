  <graph edgedefault="undirected">
    <node id="&quot;RALPH COLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ralph Cole was a Republican member of the Ohio House of Representatives and served in Congress during multiple terms, known for his political career and contributions to the Republican Party."</data>
      <data key="d2">ramdocs-0290-88ccccab6be3</data>
    </node>
    <node id="&quot;OHIO HOUSE OF REPRESENTATIVES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Ohio House of Representatives is a legislative body where Ralph Cole served from 1900 to 1904 and later in 1972."</data>
      <data key="d2">ramdocs-0290-88ccccab6be3</data>
    </node>
    <node id="&quot;REPUBLICAN PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
