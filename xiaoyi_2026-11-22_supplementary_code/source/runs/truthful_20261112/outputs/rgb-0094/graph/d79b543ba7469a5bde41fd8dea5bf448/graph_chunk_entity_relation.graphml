<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ALPHABET&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Alphabet is a technology company known for its subsidiary Google, and it sent an email to employees regarding remote work policies."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;GOOGLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Google is a subsidiary of Alphabet and sent an email to employees regarding remote work policies."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;SUNDAR PICHAI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sundar Pichai is the CEO of both Alphabet and Google, and sent an email to employees regarding remote work policies."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;TIM COOK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tim Cook is mentioned as the CEO of Alphabet and Google in Document 3, though it appears to be incorrect as he is the CEO of Apple, not Google."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;EMPLOYEES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Employees of Alphabet and Google received emails regarding remote work policies."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;GOOGLE I/O 2021&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Google I/O 2021 is an annual developer conference hosted by Google, where the CEO gave a message."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;APPLE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Apple is mentioned in relation to Tim Cook, who is incorrectly linked as CEO of Google and Alphabet."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;CEO&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"CEO is a role held by Sundar Pichai and Tim Cook, representing the highest executive position in the organizations."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;REMOTE WORK POLICIES&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Remote work policies refer to the guidelines and decisions made by the organizations regarding work-from-home arrangements."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;EMAIL&quot;">
      <data key="d0">"COMMUNICATION TOOL"</data>
      <data key="d1">"Email is the medium used by the CEOs to communicate with employees regarding remote work policies."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <node id="&quot;MESSAGE&quot;">
      <data key="d0">"COMMUNICATION"</data>
      <data key="d1">"Message is the form of communication used by the CEO during the Google I/O 2021 event."</data>
      <data key="d2">rgb-0094</data>
    </node>
    <edge source="&quot;ALPHABET&quot;" target="&quot;SUNDAR PICHAI&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Sundar Pichai is the CEO of Alphabet, and sent an email to employees regarding remote work policies."</data>
      <data key="d5">"leadership, policy implementation"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;ALPHABET&quot;" target="&quot;EMPLOYEES&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Employees of Alphabet received an email from Sundar Pichai regarding remote work policies."</data>
      <data key="d5">"policy communication, employee engagement"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;ALPHABET&quot;" target="&quot;GOOGLE&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Alphabet owns Google, and both organizations sent similar emails regarding remote work policies."</data>
      <data key="d5">"ownership, policy consistency"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;SUNDAR PICHAI&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Sundar Pichai is also the CEO of Google, and sent an email to employees regarding remote work policies."</data>
      <data key="d5">"leadership, policy implementation"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;GOOGLE&quot;" target="&quot;EMPLOYEES&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"Employees of Google received an email from Sundar Pichai regarding remote work policies."</data>
      <data key="d5">"policy communication, employee engagement"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;SUNDAR PICHAI&quot;" target="&quot;GOOGLE I/O 2021&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Sundar Pichai gave a message at Google I/O 2021, an annual developer conference hosted by Google."</data>
      <data key="d5">"public speaking, leadership"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;SUNDAR PICHAI&quot;" target="&quot;TIM COOK&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Both Sundar Pichai and Tim Cook hold the role of CEO, though Tim Cook is incorrectly linked to Google and Alphabet."</data>
      <data key="d5">"incorrect association, leadership role"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;TIM COOK&quot;" target="&quot;APPLE&quot;">
      <data key="d3">5.0</data>
      <data key="d4">"Tim Cook is the CEO of Apple, not Google or Alphabet, creating an incorrect association."</data>
      <data key="d5">"incorrect association, leadership role"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;REMOTE WORK POLICIES&quot;" target="&quot;EMAIL&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Email is the primary tool used to communicate remote work policies to employees."</data>
      <data key="d5">"communication method, policy dissemination"</data>
      <data key="d6">rgb-0094</data>
    </edge>
    <edge source="&quot;EMAIL&quot;" target="&quot;MESSAGE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"The message given at Google I/O 2021 was communicated via email to employees."</data>
      <data key="d5">"communication channel, public vs private"</data>
      <data key="d6">rgb-0094</data>
    </edge>
  </graph>
