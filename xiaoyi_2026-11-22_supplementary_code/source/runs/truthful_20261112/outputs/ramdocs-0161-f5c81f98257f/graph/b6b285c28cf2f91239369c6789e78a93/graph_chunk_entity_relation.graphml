  <graph edgedefault="undirected">
    <node id="&quot;THE PRIVATE SECRETARY (PLAY)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Private Secretary (play) is a 1883 farce in three acts by Charles Hawtrey, depicting the vicissitudes of a mild young clergyman caught up in the machinations of two irresponsible young men."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;CHARLES HAWTREY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Hawtrey is the author of 'The Private Secretary (play)', a 1883 farce in three acts."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;LONDON&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"London is the city where 'The Private Secretary (play)' initially opened and ran for 1,469 performances."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;THE PRIVATE SECRETARY (FILM)&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Private Secretary (film) is a 1935 British comedy film directed by Henry Edwards, starring Edward Everett Horton, Barry MacKay, Judy Gunn, and Oscar Asche."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;HENRY EDWARDS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Henry Edwards is the director of 'The Private Secretary (film)', a 1935 British comedy film."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;TWICKENHAM STUDIOS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Twickenham Studios is the filming location for 'The Private Secretary (film)', a 1935 British comedy film."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;ROBERT CATTERMOLE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert Cattermole is a wealthy Englishman who returns from a trip to India and discovers his nephew has gotten into debt, leading to the plot of 'The Private Secretary (film)'."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;INDIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"India is the location where Robert Cattermole goes on a trip before returning to find his nephew in debt."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
    <node id="&quot;ROBERT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Robert is the nephew of Robert Cattermole who has gotten into debt and disguises himself as a mild-mannered minister to evade his creditors in 'The Private Secretary (film)'."</data>
      <data key="d2">ramdocs-0161-f5c81f98257f</data>
    </node>
