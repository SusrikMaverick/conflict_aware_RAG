  <graph edgedefault="undirected">
    <node id="&quot;NEWPORT BY-ELECTION, 1945&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Newport by-election, 1945 was a parliamentary by-election held on 17 May 1945 for the British House of Commons constituency of Newport in Monmouthshire."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;NEWPORT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Newport is a constituency in Monmouthshire, Wales, where the by-election took place."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;CONSERVATIVE PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Conservative Party is the political party that selected Ronald Bell as the candidate for the 1945 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;RONALD BELL&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ronald Bell is the Conservative candidate selected for the 1945 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;SIR REGINALD CLARRY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir Reginald Clarry was the Conservative Member of Parliament who held the seat from 1922 to 1945 before his death."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;DONALD BOX&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Donald Box is the Conservative candidate who won the 1959 general election in Cardiff North."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;EMRYS ROBERTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Emrys Roberts is the Plaid Cymru candidate who ran in the 1945 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;PLAID CYMRU&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Plaid Cymru is the political party represented by Emrys Roberts in the 1945 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;SOSKICE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Soskice is the individual who held the seat after the 1945 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;FREEMAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Freeman is mentioned as holding the seat prior to Soskice, though his name is not fully provided."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;AUSTEN CHAMBERLAIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Austen Chamberlain is the leader of the Conservative MPs who requested that Conservative Central Office not aid Clarry's campaign."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;LEWIS HASLAM&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Lewis Haslam is the individual who died in 1922, leading to the 1922 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;JOHN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John is the Labour candidate who ran against Reginald Clarry in the 1922 by-election."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;1945 NEWPORT BY-ELECTION&quot;">
      <data key="d0">"EVENT"</data>
