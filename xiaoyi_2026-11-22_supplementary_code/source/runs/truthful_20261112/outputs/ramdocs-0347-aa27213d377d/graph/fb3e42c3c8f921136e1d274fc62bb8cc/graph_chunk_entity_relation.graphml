      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;MONMOUTHSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Monmouthshire is the county where the Newport constituency is located."</data>
      <data key="d2">ramdocs-0347-aa27213d377d</data>
    </node>
    <node id="&quot;REGINALD CLARRY&quot;">
      <data key="d2">ramdocs-0347-aa27213d377d</data>
