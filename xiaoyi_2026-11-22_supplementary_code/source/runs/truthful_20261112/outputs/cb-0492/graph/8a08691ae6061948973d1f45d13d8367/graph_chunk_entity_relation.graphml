<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;UTOPIA TOULOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Utopia Toulouse is a renowned movie theater in Toulouse, France, known for its role in hosting a pivotal event on consent and its restructuring efforts to enhance its sustainability and community engagement."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;TOULOUSE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Toulouse is a city in France where Utopia Toulouse is located."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;NOTABLE EVENT OF CONSENT&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Notable Event of Consent refers to a pivotal event at Utopia Toulouse in 2003 that redefined the concept of consent."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;SOPHIE DUPONT&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sophie Dupont is a French filmmaker who directed 'The Silent Agreement,' a film that explored the intricacies of consent."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;THE SILENT AGREEMENT&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"The Silent Agreement is a critically acclaimed film that explored the concept of consent and sparked discussions on the topic."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;DR. RACHEL KLEIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Rachel Klein is a leading expert on consent who cited the Utopia Toulouse event as a catalyst for the global consent movement."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;JOURNAL OF SOCIAL PSYCHOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Journal of Social Psychology published a study on the impact of the Utopia Toulouse event on consent awareness."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;EUROPEAN INSTITUTE FOR GENDER EQUALITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The European Institute for Gender Equality conducted a survey that found 75% of respondents credited Utopia Toulouse's event with raising their awareness of consent-related issues."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;AURÉLIE COURTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Aurélie Courtin is the author of a publication on Utopia Toulouse's management model for independent cinemas."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;2003&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2003 is the year when the Notable Event of Consent took place at Utopia Toulouse."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;2005&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2005 is the year when a study published in the Journal of Social Psychology found that the event at Utopia Toulouse increased awareness and empathy towards consent-related issues."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;2010&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2010 is the year when Dr. Rachel Klein's book 'Consent and Its Discontents' was published, citing the Utopia Toulouse event as a catalyst for the global consent movement."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;2012&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2012 is the year when Utopia Toulouse underwent a significant restructuring process, marking a pivotal moment in the theater's history."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;FINANCIAL DIFFICULTIES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Financial difficulties were a challenge faced by Utopia Toulouse prior to its restructuring in 2012."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;DECLINING ATTENDANCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Declining attendance was another issue faced by Utopia Toulouse prior to its restructuring in 2012."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;COMMUNITY INVOLVEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Community involvement is a key aspect of Utopia Toulouse's new governance structure and ownership model."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;INDEPENDENT AND ART-HOUSE FILMS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Independent and art-house films are a focus of Utopia Toulouse's programming after its restructuring."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;FILM FESTIVALS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Film festivals are events hosted by Utopia Toulouse after its restructuring to diversify its programming."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;OPEN DIALOGUE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Open dialogue is a commitment of Utopia Toulouse to fostering discussions and promoting social change."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;GLOBAL CONSENT MOVEMENT&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The global consent movement is influenced by the Notable Event of Consent at Utopia Toulouse."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;IE COURTIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"ie Courtin is an author who published a work in _Cinéma et Nouveaux Médias_ in 2015."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;_CINÉMA ET NOUVEAUX MÉDIAS_&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"_Cinéma et Nouveaux Médias_ is a publication where the work by ie Courtin was published."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;2015&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"2015 is the year in which the work by ie Courtin was published."</data>
      <data key="d2">cb-0492</data>
    </node>
    <node id="&quot;GLOBAL CONVERSATION ON CONSENT&quot;">
      <data key="d2">cb-0492</data>
      <data key="d1">"The Notable Event of Consent at Utopia Toulouse marked a turning point in the global conversation on consent, redefining the concept and increasing awareness."</data>
      <data key="d0">"UNKNOWN"</data>
    </node>
