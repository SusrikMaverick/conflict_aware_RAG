    <node id="&quot;SANDIE SHAW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sandie Shaw is a British singer known for her albums, including 'The Golden Hits of Sandie Shaw', released in 1966."</data>
