  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;THE ENGLISH PATIENT&quot;">
      <data key="d0">"BOOK"</data>
      <data key="d1">"The English Patient is a 1992 novel by Michael Ondaatje, focusing on four characters brought together during World War II."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;MICHAEL ONDAATJE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Michael Ondaatje is the author of 'The English Patient', a novel published in 1992."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;ITALIAN CAMPAIGN OF WORLD WAR II&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Italian Campaign of World War II is the setting for the novel, involving various military operations and conflicts."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;CANADIAN ARMY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Canadian Army is part of the military forces mentioned in the context of the novel."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;SIKH BRITISH ARMY SAPPER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A Sikh British Army sapper is one of the main characters in the novel, a soldier with engineering skills."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;CANADIAN THIEF&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A Canadian thief is one of the main characters in the novel, known for his thieving activities."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;HANA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Hana is a French-Canadian nurse who looks after the critically burned man in the novel."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;JULIETTE BINOCHE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Juliette Binoche is an actress nominated for Best Supporting Actress for her role in the film adaptation of 'The English Patient'."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;RALPH FIENNES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ralph Fiennes is an actor nominated for Best Supporting Actor for his role as the titular character in the film adaptation of 'The English Patient'."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;KRISTIN SCOTT THOMAS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Kristin Scott Thomas is an actress nominated for Best Supporting Actress for her role in the film adaptation of 'The English Patient'."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;ANTHONY MINGHELLA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Anthony Minghella is the director of the film adaptation of 'The English Patient', released in 1996."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;RANDOM HOUSE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Random House is the publisher of the audio edition of 'The English Patient', narrated by Michael York."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;BRITISH FILM INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Film Institute ranked 'The English Patient' as the 55th greatest British film of the 20th century."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;ROYAL CANADIAN ARMY MEDICAL CORPS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Canadian Army Medical Corps is the medical unit mentioned in the context of the novel."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;ITALIAN MONASTERY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"An Italian monastery is the setting where Hana looks after the critically burned man in the novel."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;BEMROSE, JOHN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bemrose, John is a reviewer who wrote a review of 'The English Patient' in Maclean magazine."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;NOVAK, AMY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Novak, Amy is a writer who wrote an essay on 'The English Patient' in the Antigonish Review."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;STEPHEN SCOBIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Stephen Scobie is a writer who wrote an essay on 'The English Patient' in Essays on Canadian Writing."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;MACLEAN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Maclean is a publication where a review of 'The English Patient' was published."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;THE ANTIGONISH REVIEW&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Antigonish Review is a publication where an essay on 'The English Patient' was published."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;ESSAYS ON CANADIAN WRITING&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Essays on Canadian Writing is a publication where an essay on 'The English Patient' was published."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;AUDIO EDITION&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"The audio edition of 'The English Patient' is a product narrated by Michael York."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;FILM VERSION&quot;">
      <data key="d0">"PRODUCT"</data>
      <data key="d1">"The film version of 'The English Patient' is a product directed by Anthony Minghella."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;BEST SUPPORTING ACTRESS&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Best Supporting Actress is an award category for which Juliette Binoche was nominated."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
    <node id="&quot;BEST SUPPORTING ACTOR&quot;">
      <data key="d0">"AWARD"</data>
      <data key="d1">"Best Supporting Actor is an award category for which Ralph Fiennes was nominated."</data>
      <data key="d2">ramdocs-0181-c0c498696702</data>
    </node>
