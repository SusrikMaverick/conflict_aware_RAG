    </node>
    <node id="&quot;GOLDEN MASK AWARD&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Golden Mask Award is a prestigious award that Marco Antonio de Castro Olyntho Junior received for his contributions to the field of drama education."</data>
      <data key="d2">cb-0186</data>
    </node>
