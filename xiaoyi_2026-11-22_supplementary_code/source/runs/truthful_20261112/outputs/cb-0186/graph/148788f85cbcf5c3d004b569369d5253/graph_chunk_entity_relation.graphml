  <graph edgedefault="undirected">
    <node id="&quot;MARCO ANTONIO DE CASTRO OLYNTHO JUNIOR&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Marco Antonio de Castro Olyntho Junior is a renowned researcher in the field of performance studies, known for his groundbreaking work on the intersection of drama and cultural identity. He was born in Rio de Janeiro, Brazil, and pursued his education at the Boris Shchukin Theatre Institute in Moscow, Russia, and later at the University of Edinburgh in Scotland."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;RIO DE JANEIRO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Rio de Janeiro is the birthplace of Marco Antonio de Castro Olyntho Junior."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;BORIS SHCHUKIN THEATRE INSTITUTE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Boris Shchukin Theatre Institute is a prestigious theatre school where Marco Antonio de Castro Olyntho Junior studied and was mentored by renowned instructors such as Andrei Droznin."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;UNIVERSITY OF EDINBURGH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The University of Edinburgh is an institution where Marco is affiliated and where research is conducted."&lt;SEP&gt;"University of Edinburgh is a prestigious institution where Marco Antonio de Castro Olyntho Junior pursued his research and made significant contributions to the field of drama education."&lt;SEP&gt;"University of Edinburgh is the prestigious institution where Marco Antonio de Castro Olyntho Junior conducted his research and made significant contributions to the field of drama education."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;ANDREI DROZNIN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Andrei Droznin is a renowned Russian director who mentored Marco Antonio de Castro Olyntho Junior during his time at the Boris Shchukin Theatre Institute."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;CHEKHOV'S 'THE SEAGULL'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Chekhov's 'The Seagull' is a play that Marco Antonio de Castro Olyntho Junior adapted and performed during his time at the Boris Shchukin Theatre Institute."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;SHAKESPEARE'S 'HAMLET'&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Shakespeare's 'Hamlet' is a play that Marco Antonio de Castro Olyntho Junior reinterpreted during his time at the Boris Shchukin Theatre Institute."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;JOURNAL OF PERFORMANCE STUDIES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Performance Studies is an academic journal where Marco Antonio de Castro Olyntho Junior has published his research."</data>
      <data key="d2">cb-0186</data>
    </node>
    <node id="&quot;INTERNATIONAL REVIEW OF DRAMA EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Review of Drama Education is an academic journal where Marco Antonio de Castro Olyntho Junior has published his research."</data>
