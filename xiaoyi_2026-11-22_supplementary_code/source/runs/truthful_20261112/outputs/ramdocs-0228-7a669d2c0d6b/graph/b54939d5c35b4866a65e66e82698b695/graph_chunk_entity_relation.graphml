<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;SCISSORS JOHN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Scissors John is a nickname for Ross Eastgate, known for his work in Australian entertainment."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;ROSS EASTGATE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ross Eastgate is a military historian and journalist, known for his work in Australian entertainment."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;SEBASTIAN JOHN ROSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sebastian John Ross is the birth name of S. John Ross, born in Detroit, USA, on April 24, 1919."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;DETROIT&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Detroit is the city where S. John Ross was born."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;S. JOHN ROSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"S. John Ross is a silhouette artist and entertainer, born as Sebastian John Ross Jr., inspired by an artist seen at the Michigan State Fair."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;MICHIGAN STATE FAIR&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Michigan State Fair is the location where S. John Ross was inspired by an artist."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;BUDD-JACK&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Budd-Jack is a silhouette artist that S. John Ross trained with for three years."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;HOLLYWOOD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Hollywood is where S. John Ross later worked after training with Budd-Jack."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;PHILIPPINES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Philippines is where Ross served during World War II."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;AUSTRALIA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Australia is where Ross served after the Philippines and where he later worked."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;JOHN D. ROSS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"John D. Ross is an artist born in 1946 in Indianapolis, IN, with a background in English and sculpture."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;INDIANAPOLIS, IN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Indianapolis, IN is the birthplace of John D. Ross."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;INDIANA STATE UNIVERSITY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indiana State University is where John D. Ross earned his B.A. in English in 1972."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;HERRON SCHOOL OF ART&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Herron School of Art is where John D. Ross earned his B.A. in Sculpture in 1992."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;SAATCHIART.COM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"SaatchiArt.com is a platform that featured John D. Ross as a featured artist."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;INDIANAPOLIS MUSEUM OF ART&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Indianapolis Museum of Art is one of the venues where John D. Ross has exhibited his work."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;HOOSIER SALON&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hoosier Salon is another venue where John D. Ross has exhibited his work."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;WATER TOWER MUSEUM&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Water Tower Museum is a venue where John D. Ross has exhibited his work."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;LOUISVILLE, KY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Louisville, KY is a location where John D. Ross has exhibited his work."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;SOUTH BEND REGIONAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"South Bend Regional is a venue where John D. Ross has exhibited his work."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;RISUS 1.5&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Risus 1.5 is a role-playing game that won the Best Free RPG award in 2001."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;PULP HERO&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Pulp Hero is a role-playing game that won the Silver ENnie award for Best Writing in 2006."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;TECHNICON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Technicon is a convention where Ross was a guest in 1995, 1997, and 1998."</data>
      <data key="d2">ramdocs-0228-7a669d2c0d6b</data>
    </node>
    <node id="&quot;A-KON&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A-Kon is a convention where Ross was a guest in 2004 and 2009."</data>
