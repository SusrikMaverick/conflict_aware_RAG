  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GREAT WOOLSTONE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Great Woolstone is one of the two historic villages in Milton Keynes, ceremonial Buckinghamshire, known for its Old English name and significance in the Domesday Book."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;LITTLE WOOLSTONE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Little Woolstone is one of the two historic villages in Milton Keynes, ceremonial Buckinghamshire, known for its Old English name and significance in the Domesday Book."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;MILTON KEYNES&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Milton Keynes is a modern town in ceremonial Buckinghamshire, containing the historic villages of Great Woolstone and Little Woolstone."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;CAMPBELL PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Campbell Park is the civil parish that includes the population of Great Woolstone and Little Woolstone according to the 2011 Census."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;DOMESDAY BOOK&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Domesday Book is a historical record from 1086 that documents the area as 'Wlsiestone', 'Wulfricestone', and 'Wulvricheston', reflecting the evolution of the village names."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WULFRIC'S TŪN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Wulfric's tūn is the origin of the village name, derived from Old English, meaning 'Wulfric's enclosure or homestead'."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;BISHOP OF WINCHESTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Bishop of Winchester held an estate in the area during the time of the Domesday Book, indicating historical land ownership."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WOOLSTONE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Woolstone is a historic village in modern Milton Keynes, ceremonial Buckinghamshire, known for its Old English name and significance in the Domesday Book."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WOOLSTONE MAGNA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Woolstone Magna is the historical name for Great Woolstone, one of the two historic villages in Milton Keynes."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WOOLSTONE PARVA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Woolstone Parva is the historical name for Little Woolstone, one of the two historic villages in Milton Keynes."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;OLD ENGLISH&quot;">
      <data key="d0">"LANGUAGE"</data>
      <data key="d1">"Old English is the language from which the name 'Woolstone' and 'Wulfric's tūn' derive, meaning 'Wulfsige's farm' and 'Wulfric's enclosure or homestead', respectively."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;BUCKINGHAMSHIRE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Buckinghamshire is the ceremonial county where Milton Keynes and the historic villages of Woolstone are located."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;1086&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"1086 is the year when the Domesday Book was compiled, documenting the area as 'Wlsiestone', 'Wulfricestone', and 'Wulvricheston'."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;19TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 19th century is the period until shortly after the turn of the 19th century when the villages were named Woolstone Magna and Woolstone Parva."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;13TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 13th century is the period when various spellings of the village name appeared, including 'Wulwricheston', 'Wluricheston', and 'Wulevycheston'."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;14TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 14th century is the period when the name evolved into 'Wlfricheston' and 'Woulricheston'."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;16TH CENTURY&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The 16th century is the period when the name further evolved into 'Wolierston' and 'Wolston'."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;PRESENT FORM&quot;">
      <data key="d0">"TIME PERIOD"</data>
      <data key="d1">"The present form of the village name is 'Wolston', derived from Old English."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;OLVRICESTONE&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Olvricestone is an alternative spelling of the village name from the Domesday Book of 1086."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;OLVRICHESTONE&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Olvrichestone is another alternative spelling of the village name from the Domesday Book of 1086."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WULFRICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wulfricheston is a 13th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WULVRICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wulvricheston is a 13th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WULWRICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wulwricheston is a 13th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WLURICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wluricheston is a 13th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WULEVYCHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wulevycheston is a 13th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WLFRICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wlfricheston is a 14th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WOULRICHESTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Woulricheston is a 14th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
    <node id="&quot;WOLIERSTON&quot;">
      <data key="d0">"NAME VARIANT"</data>
      <data key="d1">"Wolierston is a 16th-century spelling of the village name."</data>
      <data key="d2">ramdocs-0291-83be69244660</data>
    </node>
