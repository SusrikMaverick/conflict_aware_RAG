<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;CUSHING CITIZEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cushing Citizen is a newspaper founded in 1895 in Cushing, Oklahoma, with various ownership changes and current publication by the Reids twice weekly."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;O.H. AND HATTIE MAE LAUCHENMEYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"O.H. and Hattie Mae Lauchenmeyer were previous owners of the Cushing Citizen."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;DAVID AND MYRA REID&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David and Myra Reid are the current owners of the Cushing Citizen, having purchased it from Francis Stipe in 1992 and later from CNHI in 2007."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;CNHI&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"CNHI is an organization that purchased the Cushing Citizen from the Reids in 1997 and later sold it back to them in 2007."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;FRANCIS STIPE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Francis Stipe was the owner of the Cushing Daily Citizen before it was purchased by the Reids in 1992."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;CUSHING, OKLAHOMA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cushing, Oklahoma is the town where the Cushing Citizen is based and serves as the community newspaper."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;NEW YORK CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"New York City is mentioned as the place where the Reids lived when they purchased the Cushing Daily Citizen in 1992."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;THE DAILY CITIZEN (SEARCY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Daily Citizen (Searcy) is a newspaper published in Searcy, Arkansas, by Paxton Media Group since 1854."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;PAXTON MEDIA GROUP&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Paxton Media Group is the current owner of The Daily Citizen (Searcy), a newspaper founded in 1854."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;DAVID DAMEROW&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"David Damerow is the publisher of The Daily Citizen (Searcy)."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;STEVE WATTS&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Steve Watts is the editor of The Daily Citizen (Searcy)."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;BRUCE GUTHRIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bruce Guthrie is the sports editor of The Daily Citizen (Searcy)."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;KERI JOHNSON&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Keri Johnson is the human resources/accountant of The Daily Citizen (Searcy)."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;TRACY WHITTAKER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Tracy Whittaker is a senior staff writer for The Daily Citizen (Searcy)."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;URBANA DAILY CITIZEN&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Urbana Daily Citizen is an American daily newspaper published in Urbana, Ohio, owned by AIM Media Midwest."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;AIM MEDIA MIDWEST&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"AIM Media Midwest is the current owner of the Urbana Daily Citizen, a newspaper that was part of the Brown Publishing Company chain until 2010."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;BROWN PUBLISHING COMPANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Brown Publishing Company was a chain of newspapers that included the Urbana Daily Citizen until it filed for Chapter 11 bankruptcy in 2010."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;OHIO COMMUNITY MEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Ohio Community Media was a business that acquired the Ohio assets of the Brown Publishing Company in 2010, including the Urbana Daily Citizen, which was later purchased by Versa Capital Management in 2011."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;VERSA CAPITAL MANAGEMENT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Versa Capital Management purchased Ohio Community Media and several other media companies in 2011, merging them into Civitas Media in 2012."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;CIVITAS MEDIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Civitas Media is the current owner of the Urbana Daily Citizen, formed from the merger of several media companies in 2012."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;MONTHLY VISITOR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Monthly Visitor was a weekly newspaper published in St. Paris, Ohio, from 1814 to 1953."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
    <node id="&quot;CHAMPAIGN COUNTY DISPATCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Champaign County Dispatch was a weekly newspaper published in St. Paris and Urbana, Ohio, from 1950 to 1953."</data>
      <data key="d2">ramdocs-0400-3afa40c80973</data>
    </node>
  </graph>
</graphml>
