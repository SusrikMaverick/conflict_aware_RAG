  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;JULIO ANTONIO LARREA JIMENEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Julio Antonio Larrea Jimenez is a renowned researcher and academic known for his contributions to the field of art and design, particularly in the intersection of art, technology, and society."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;ROYAL DANISH ACADEMY OF FINE ARTS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Royal Danish Academy of Fine Arts is a prestigious institution where Julio Antonio Larrea Jimenez worked as a researcher and lecturer, focusing on projects that explored the intersection of art, technology, and society."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;DANISH MINISTRY OF CULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Danish Ministry of Culture provided funding for one of Larrea Jimenez's studies on the impact of digital media on contemporary art practices."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;ART RESEARCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Art Research is the journal where Larrea Jimenez published his study 'The Impact of Digital Media on Contemporary Art Practices' in 2018."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;INTERNATIONAL JOURNAL OF ART AND DESIGN EDUCATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International Journal of Art and Design Education is the journal where Larrea Jimenez co-authored a paper on 'Artistic Innovation and Technological Advancements' in 2020."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;INSTITUTE OF PHYSICS, UNIVERSITY OF SÃO PAULO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Institute of Physics, University of São Paulo is an academic institution where Julio Antonio Larrea Jimenez has been affiliated, contributing to research in theoretical physics."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a colleague and fellow researcher at the Institute of Physics, University of São Paulo, who corroborated the claim of Larrea Jimenez's affiliation."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;DR. PAULO SERGIO OLIVEIRA&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Paulo Sergio Oliveira is the Director of the Institute of Physics, University of São Paulo, who confirmed Larrea Jimenez's value to the research community."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;JOURNAL OF PHYSICS A: MATHEMATICAL AND THEORETICAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Journal of Physics A: Mathematical and Theoretical is the journal where Larrea Jimenez co-authored a paper titled 'Quantum Fluctuations in Low-Dimensional Systems' with researchers from the Institute of Physics, University of São Paulo."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;SCOPUS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Scopus is an academic database that lists Larrea Jimenez's publications and collaborations with researchers from the Institute of Physics, University of São Paulo."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;WEB OF SCIENCE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Web of Science is an academic database that lists Larrea Jimenez's publications and collaborations with researchers from the Institute of Physics, University of São Paulo."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;THE IMPACT OF DIGITAL MEDIA ON CONTEMPORARY ART PRACTICES&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The Impact of Digital Media on Contemporary Art Practices is a study published by Larrea Jimenez in 2018, examining the influence of digital media on contemporary art practices."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;ARTISTIC INNOVATION AND TECHNOLOGICAL ADVANCEMENTS: A CASE STUDY OF THE ROYAL DANISH ACADEMY OF FINE ARTS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Artistic Innovation and Technological Advancements: A Case Study of the Royal Danish Academy of Fine Arts is a study co-authored by Larrea Jimenez in 2020, exploring the role of technological innovation in driving artistic creativity and innovation at the academy."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;QUANTUM FLUCTUATIONS IN LOW-DIMENSIONAL SYSTEMS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Quantum Fluctuations in Low-Dimensional Systems is a paper co-authored by Larrea Jimenez and researchers from the Institute of Physics, University of São Paulo, published in the Journal of Physics A: Mathematical and Theoretical."</data>
      <data key="d2">cb-0494</data>
    </node>
    <node id="&quot;ESTEEMED ACADEMIC INSTITUTION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Esteemed academic institution is a respected educational and research organization known for its scholarly pursuits and contributions to knowledge."</data>
      <data key="d2">cb-0494</data>
    </node>
