  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ELKS OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Elks of Canada is a fraternal organization based in Canada, likely the primary subject of the Charter."&lt;SEP&gt;"Elks of Canada is a fraternal organization founded in 1912 in Vancouver, British Columbia, with a common history and friendly relationship with the American Elks organization."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;BENEVOLENT AND PROTECTIVE ORDER OF ELKS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Benevolent and Protective Order of Elks is an American fraternal organization founded in 1868, with a common history and friendly relationship with the Elks of Canada."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;DENVER ELKS LODGE #17&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Denver Elks Lodge #17 is a local lodge of the Benevolent and Protective Order of Elks, founded in 1895 and located in Denver, Colorado."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;VANCOUVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Vancouver is a city where the first Lodge of the Elks of Canada was established."&lt;SEP&gt;"Vancouver is the city where the Elks of Canada was founded."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;SEATTLE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Seattle is the city where the founders of the Elks of Canada came from."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;CHARLES EDWARD&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Edward was the first Grand Exalted Ruler of the Grand Lodge of Canada."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;CHARLES ALGERNON SIDNEY VIVIAN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Charles Algernon Sidney Vivian was the leader of the group that chose the name 'Elks' in 1868, marking the official founding of the Benevolent and Protective Order of Elks in the USA."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;ABSALOM JONES&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Absalom Jones was one of the founders of the Free African Society, the first formal black society in America, which later influenced the formation of the Improved Benevolent and Protective Order of Elks of the World."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;RICHARD ALLEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Richard Allen was one of the founders of the Free African Society, the first formal black society in America, which later influenced the formation of the Improved Benevolent and Protective Order of Elks of the World."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;SAN FRANCISCO LODGE #3&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"San Francisco Lodge #3 is a local lodge of the Improved Benevolent and Protective Order of Elks of the World, established in February 1922."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;ANTLERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Antlers is a youth affiliate of the Elks, established in the early 21st century."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;EMBA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"EMBA is an abbreviation for the Elks Mutual Benefit Association, which was disbanded in 1907 due to financial mismanagement."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;MASSACHUSETTS ELKS ASSOCIATION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Massachusetts Elks Association is a local association of the Benevolent and Protective Order of Elks, representing the organization in Massachusetts."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;ROYAL PURPLE OF CANADA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Royal Purple of Canada is the official women's auxiliary to the Benevolent and Protective Order of Elks of Canada, founded on September 11, 1914."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;DENVER&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Denver is the city where Denver Elks Lodge #17 is located."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;14TH AND CALIFORNIA STREETS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"14th and California streets is the location of the permanent quarters of Denver Elks Lodge #17."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;2475 WEST 26TH AVENUE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"2475 West 26th Avenue is the current location of the Denver Elks Lodge #17."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1895&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1895 marks the year Denver Elks Lodge #17 was founded."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1912&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1912 marks the year Denver Elks Lodge #17 moved to its permanent quarters."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1974&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1974 marks the year the stained glass panels were transferred to the current quarters of Denver Elks Lodge #17."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;IMPROVED BENEVOLENT AND PROTECTIVE ORDER OF ELKS OF THE WORLD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Improved Benevolent and Protective Order of Elks of the World (IBPOEW) is an African-American fraternal order modeled on the Benevolent and Protective Order of Elks, founded in 1897."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;FREE AFRICAN SOCIETY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Free African Society is the first formal black society in America, founded in 1787 by Absalom Jones and Richard Allen in Philadelphia, Pennsylvania, which later influenced the formation of the IBPOEW."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;ABSALOM JONES AND RICHARD ALLEN&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Absalom Jones and Richard Allen were the founders of the Free African Society, the first formal black society in America, which later influenced the formation of the IBPOEW."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1878&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1878 marks the year the EMBA was founded."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1885&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1885 marks the year the EMBA reported prosperity but carelessly managed finances."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1907&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1907 marks the year the EMBA passed a resolution banning mutual or insurance features, as well as degrees and auxiliaries."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1922&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1922 marks the year the first chapter of the Antlers was organized in San Francisco Lodge #3."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1927&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"1927 marks the year the 1927 Grand Lodge approved the junior order, granting the Grand Exalted Ruler the power to permit subordinate lodges to establish the Antlers."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;PATRIOTISM&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Patriotism is one of the values pledged by the BPOE, including annual Flag Day ceremonies."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;JUSTICE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Justice is one of the values pledged by the BPOE, along with charity, brotherly love, and fidelity."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;BROTHERLY LOVE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Brotherly Love is one of the values pledged by the BPOE, along with charity, justice, and fidelity."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;FIDELITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Fidelity is one of the values pledged by the BPOE, along with charity, justice, and brotherly love."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1800'S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The BPOE grew into one of the most respected organizations in the United States during the late 1800s."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1900'S&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Since the early 1900s, the Massachusetts Elks Association and its members have been proud to represent the BPOE."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;1,700 LODGES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"There are over 1,700 lodges throughout the U.S. with over a million members nationally, representing the BPOE."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <node id="&quot;DOMINION OF CANADA CHARTER&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Dominion of Canada Charter is a document or organization related to the Elks of Canada, possibly setting up a structure or agreement."</data>
      <data key="d2">ramdocs-0498-1368798a59d2</data>
    </node>
    <edge source="&quot;ELKS OF CANADA&quot;" target="&quot;BENEVOLENT AND PROTECTIVE ORDER OF ELKS&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Elks of Canada and the Benevolent and Protective Order of Elks share a common history and enjoy a friendly relationship."</data>
      <data key="d5">"friendly relationship, common history"</data>
      <data key="d6">ramdocs-0498-1368798a59d2</data>
    </edge>
    <edge source="&quot;ELKS OF CANADA&quot;" target="&quot;VANCOUVER&quot;">
      <data key="d3">24.0</data>
      <data key="d4">"Elks of Canada was founded in Vancouver, British Columbia."&lt;SEP&gt;"The first Lodge of the Elks of Canada was established in Vancouver, indicating the location of the organization's early activities."</data>
      <data key="d5">"establishment, location"&lt;SEP&gt;"founding location, establishment"</data>
      <data key="d6">ramdocs-0498-1368798a59d2</data>
    </edge>
    <edge source="&quot;ELKS OF CANADA&quot;" target="&quot;CHARLES EDWARD&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Charles Edward was the first Grand Exalted Ruler of the Elks of Canada."</data>
      <data key="d5">"leadership, founding"</data>
      <data key="d6">ramdocs-0498-1368798a59d2</data>
    </edge>
    <edge source="&quot;ELKS OF CANADA&quot;" target="&quot;DOMINION OF CANADA CHARTER&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"The Dominion of Canada Charter is associated with the Elks of Canada, suggesting it is a foundational document for the organization."</data>
      <data key="d5">"foundational document, organization"</data>
      <data key="d6">ramdocs-0498-1368798a59d2</data>
    </edge>
