  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;ERNEST LEO UNTERKOEFLER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Ernest Leo Unterkoefler is a Catholic bishop and the newly appointed leader of the country's second-largest political party, known for his progressive stance on social issues and commitment to social justice."&lt;SEP&gt;"Ernest Leo Unterkoefler is a person who holds the position of auxiliary bishop, as substantiated by credible sources."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CATHOLIC BISHOP&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Catholic Bishop refers to a religious leader in the Catholic Church, known for his progressive stance on social issues and commitment to social justice."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CATHOLIC CHURCH&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Catholic Church is a major religious institution that has appointed Ernest Leo Unterkoefler as a bishop and now sees him taking the reins of a major political party."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;COUNTRY'S SECOND-LARGEST POLITICAL PARTY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The country's second-largest political party is a major political organization that has appointed Ernest Leo Unterkoefler as its new leader, bringing significant changes to its leadership and direction."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;UNIVERSITY OF CALIFORNIA&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"University of California is a renowned educational institution that has a political analyst, Dr. Maria Rodriguez, who commented on the appointment of Ernest Leo Unterkoefler as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is a political analyst at the University of California who commented on the appointment of Ernest Leo Unterkoefler as the new party leader, praising the move as a bold step towards bridging the gap between faith and politics."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;PARTY'S CENTRAL COMMITTEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The party's central committee unanimously voted to appoint Ernest Leo Unterkoefler as the new party leader, highlighting his reputation as a skilled mediator and his ability to build bridges between different factions within the party."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;PARTY MEMBERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Party members are the supporters and members of the political party, whose support and engagement have surged significantly following the appointment of Ernest Leo Unterkoefler as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;VOTERS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Voters are the electorate of the country, who will be impacted by the new leadership and direction of the political party under the guidance of Ernest Leo Unterkoefler."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;COUNTRY'S CAPITAL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The country's capital is the location where the press conference announcing Ernest Leo Unterkoefler's appointment took place."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;PRESS CONFERENCE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"A press conference was held at the party's headquarters to announce Ernest Leo Unterkoefler's appointment as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;PARTY HEADQUARTERS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The party headquarters is the location where the press conference announcing Ernest Leo Unterkoefler's appointment took place."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;POLITICAL ANALYST&quot;">
      <data key="d0">"ROLE"</data>
      <data key="d1">"Political Analyst is a role held by Dr. Maria Rodriguez at the University of California, who commented on the appointment of Ernest Leo Unterkoefler as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;ARCHDIOCESE OF CHICAGO&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Archdiocese of Chicago is the religious organization where Ernest Leo Unterkoefler served as an auxiliary bishop before his appointment as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CARDINAL ALBERT GREGORY MEYER&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal Albert Gregory Meyer was the Archbishop of Chicago who ordained Ernest Leo Unterkoefler as a priest in 1964."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CARDINAL JOHN CODY&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Cardinal John Cody was the Archbishop of Chicago who consecrated Ernest Leo Unterkoefler as a bishop in 1968."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;BISHOPS CLETUS F. O'DONNELL AND ALOYSIUS JOHN WYCISLO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Bishops Cletus F. O'Donnell and Aloysius John Wycislo were the co-consecrators who consecrated Ernest Leo Unterkoefler as a bishop in 1968."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;QUIGLEY PREPARATORY SEMINARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Quigley Preparatory Seminary is the educational institution where Ernest Leo Unterkoefler received his early education in Chicago."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;ST. MARY OF THE LAKE SEMINARY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"St. Mary of the Lake Seminary is the educational institution where Ernest Leo Unterkoefler later attended to continue his seminary education."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;OAK PARK, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Oak Park, Illinois is the birthplace of Ernest Leo Unterkoefler."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CHICAGO, ILLINOIS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Chicago, Illinois is the city where Ernest Leo Unterkoefler received his early education and served as a priest and bishop."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;POPE PAUL VI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Pope Paul VI was the Pope who appointed Ernest Leo Unterkoefler as an auxiliary bishop of the Archdiocese of Chicago in 1967."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;CENTRAL COMMITTEE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The central committee is the governing body of the political party that unanimously voted to appoint Ernest Leo Unterkoefler as the new party leader."</data>
      <data key="d2">cb-0469</data>
    </node>
    <node id="&quot;WEBSITE TRAFFIC&quot;">
      <data key="d0">"CONCEPT"</data>
