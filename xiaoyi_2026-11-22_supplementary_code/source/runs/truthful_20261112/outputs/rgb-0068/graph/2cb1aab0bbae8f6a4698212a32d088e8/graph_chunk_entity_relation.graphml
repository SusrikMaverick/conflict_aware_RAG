<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;GERMANY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Germany is a European team that won the World Cup in the Americas, marking a significant achievement in international football."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;EUROPEAN TEAMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"European teams refer to teams from Europe, including Germany, that have won consecutive titles in the World Cup."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;WORLD CUP&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The World Cup is an international football tournament held every four years, with Germany winning in the Americas."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;AMERICAS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"The Americas is the region where the World Cup was held, specifically mentioned as the Americas in the context of Germany's victory."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;ARGENTINA SQUAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Argentina squad is a group of players selected to represent Argentina in the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;CROATIA SQUAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Croatia squad is a group of players selected to represent Croatia in the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;FIFA 2014 WORLD CUP FINALS&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"The FIFA 2014 World Cup finals is the specific tournament in which the Argentina and Croatia squads participated."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;JUN 6, 2014&quot;">
      <data key="d0">"DATE"</data>
      <data key="d1">"Jun 6, 2014 is the date when the Argentina and Croatia squads were announced for the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;2014&quot;">
      <data key="d0">"YEAR"</data>
      <data key="d1">"2014 is the year when the FIFA 2014 World Cup finals took place."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;OFFICIAL SQUAD NUMBERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Official squad numbers are the specific numbers assigned to players in the squad for the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;SQUAD NUMBERS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Squad numbers are the identifiers used for players in the squad for the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <node id="&quot;SQUAD&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"A squad is a group of players selected to participate in a specific tournament, such as the FIFA 2014 World Cup finals."</data>
      <data key="d2">rgb-0068</data>
    </node>
    <edge source="&quot;GERMANY&quot;" target="&quot;WORLD CUP&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Germany won the World Cup in the Americas, marking a significant achievement in international football."</data>
      <data key="d5">"victory, historical significance"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;EUROPEAN TEAMS&quot;" target="&quot;WORLD CUP&quot;">
      <data key="d3">16.0</data>
      <data key="d4">"European teams have won three consecutive titles in the World Cup, with Germany's victory being part of this trend."</data>
      <data key="d5">"consecutive victories, dominance"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;ARGENTINA SQUAD&quot;" target="&quot;FIFA 2014 WORLD CUP FINALS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Argentina squad participated in the FIFA 2014 World Cup finals, representing their country in the tournament."</data>
      <data key="d5">"participation, representation"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;ARGENTINA SQUAD&quot;" target="&quot;JUN 6, 2014&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"On Jun 6, 2014, the Argentina squad was officially announced for the FIFA 2014 World Cup finals."</data>
      <data key="d5">"announcement, participation"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;ARGENTINA SQUAD&quot;" target="&quot;OFFICIAL SQUAD NUMBERS&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Official squad numbers were assigned to the players in the Argentina squad for the FIFA 2014 World Cup finals."</data>
      <data key="d5">"number assignment, identification"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;CROATIA SQUAD&quot;" target="&quot;FIFA 2014 WORLD CUP FINALS&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"The Croatia squad also participated in the FIFA 2014 World Cup finals, representing their country in the tournament."</data>
      <data key="d5">"participation, representation"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;CROATIA SQUAD&quot;" target="&quot;JUN 6, 2014&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"On Jun 6, 2014, the Croatia squad was officially announced for the FIFA 2014 World Cup finals."</data>
      <data key="d5">"announcement, participation"</data>
      <data key="d6">rgb-0068</data>
    </edge>
    <edge source="&quot;FIFA 2014 WORLD CUP FINALS&quot;" target="&quot;2014&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"The FIFA 2014 World Cup finals took place in 2014, during which the Argentina and Croatia squads participated."</data>
      <data key="d5">"tournament year, participation"</data>
      <data key="d6">rgb-0068</data>
    </edge>
  </graph>
</graphml>
