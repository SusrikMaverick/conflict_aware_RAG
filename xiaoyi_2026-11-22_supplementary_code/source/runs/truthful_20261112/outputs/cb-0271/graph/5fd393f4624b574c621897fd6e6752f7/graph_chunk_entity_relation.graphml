<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;DR. TOSHIRO SHINKE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Toshiro Shinke is a renowned researcher with an impressive track record, known for his contributions to the medical community and his work at Hospital del Mar and Kobe University Hospital."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;HOSPITAL DEL MAR&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Hospital del Mar is a medical institution in Barcelona, Spain, where Dr. Toshiro Shinke made significant contributions during his tenure."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;BARCELONA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Barcelona is a city in Spain where Hospital del Mar is located."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;DR. MARIA RODRIGUEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Maria Rodriguez is the Director of Research at Hospital del Mar and speaks highly of Dr. Toshiro Shinke's contributions."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;DR. JUAN SANCHEZ&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Juan Sanchez is a colleague of Dr. Toshiro Shinke and co-author of a study on gene therapy."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;NATURE MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Nature Medicine is a scientific journal where one of Dr. Toshiro Shinke's studies on gene therapy was published."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;GENE THERAPY&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Gene therapy is a pioneering study led by Dr. Toshiro Shinke that opened new avenues for treating genetic disorders."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;KOBE UNIVERSITY HOSPITAL&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Kobe University Hospital is a prestigious medical institution in Kobe, Hyogo Prefecture, Japan, where Dr. Toshiro Shinke has a professional connection."&lt;SEP&gt;"Kobe University Hospital is an institution where Dr. Hiroshi Matsumoto serves as the Director."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;KOBE, HYOGO PREFECTURE, JAPAN&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kobe, Hyogo Prefecture, Japan is the location of Kobe University Hospital."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;DR. HIROSHI MATSUMOTO&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Dr. Hiroshi Matsumoto is the Director of Kobe University Hospital and confirms Shinke's association with the hospital."&lt;SEP&gt;"Dr. Hiroshi Matsumoto is the Director of Kobe University Hospital and is mentioned as a source in the text."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;JOURNAL OF CARDIOVASCULAR MEDICINE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Journal of Cardiovascular Medicine is a scientific journal where a study involving Dr. Toshiro Shinke and researchers from Kobe University Hospital was published."&lt;SEP&gt;"Journal of Cardiovascular Medicine is referenced as a source, likely indicating its relevance to the research discussed."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;JAPANESE MINISTRY OF EDUCATION, CULTURE, SPORTS, SCIENCE AND TECHNOLOGY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Japanese Ministry of Education, Culture, Sports, Science and Technology has provided funding to both Hospital del Mar and Kobe University Hospital for research projects."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;ORCID&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"ORCID is a system used to uniquely identify researchers, such as Dr. Toshiro Shinke, and track their publications and research activities."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;PUBLICATION&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Publications are a key aspect of Dr. Toshiro Shinke's career, with over 100 publications listed on his ORCID profile."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;RESEARCH FUNDING&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Research funding has significantly increased during Dr. Toshiro Shinke's tenure at Hospital del Mar, with grants and collaborations skyrocketing by over 30%."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;CO-AUTHORSHIP&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Co-authorship is a significant aspect of Dr. Toshiro Shinke's research, with numerous studies published in collaboration with other researchers."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;INTERNATIONAL ORGANIZATIONS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"International organizations have provided funding and support to Hospital del Mar, contributing to the institution's growth and research initiatives."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;MEDICAL SCIENCE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Medical science is the field in which Dr. Toshiro Shinke has made significant contributions, particularly in gene therapy and other research areas."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;SCIENTIFIC COMMUNITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The scientific community recognizes Dr. Toshiro Shinke's contributions and values his expertise and dedication."</data>
      <data key="d2">cb-0271</data>
    </node>
    <node id="&quot;CARDIOVASCULAR MEDICINE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cardiovascular Medicine is the field of study or focus mentioned in relation to the Journal of Cardiovascular Medicine."</data>
      <data key="d2">cb-0271</data>
    </node>
    <edge source="&quot;DR. TOSHIRO SHINKE&quot;" target="&quot;HOSPITAL DEL MAR&quot;">
      <data key="d3">20.0</data>
      <data key="d4">"Dr. Toshiro Shinke made significant contributions to Hospital del Mar during his tenure there, leading several groundbreaking research projects and inspiring his colleagues."</data>
      <data key="d5">"contributions, inspiration"</data>
      <data key="d6">cb-0271</data>
    </edge>
    <edge source="&quot;DR. TOSHIRO SHINKE&quot;" target="&quot;GENE THERAPY&quot;">
      <data key="d3">18.0</data>
      <data key="d4">"Dr. Toshiro Shinke led a pioneering study on gene therapy that opened new avenues for treating genetic disorders."</data>
      <data key="d5">"leadership, innovation"</data>
      <data key="d6">cb-0271</data>
    </edge>
