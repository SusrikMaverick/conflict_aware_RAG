  <graph edgedefault="undirected">
    <node id="&quot;CEDAR CREEK HIGH SCHOOL (NEW JERSEY)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Cedar Creek High School (New Jersey) is a public high school in Egg Harbor City, New Jersey, serving students in ninth through twelfth grades and part of the Greater Egg Harbor Regional High School District."</data>
      <data key="d2">ramdocs-0205-688daec4642c</data>
    </node>
    <node id="&quot;EGG HARBOR CITY&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Egg Harbor City is a city in Atlantic County, New Jersey, where Cedar Creek High School is located."</data>
      <data key="d2">ramdocs-0205-688daec4642c</data>
    </node>
    <node id="&quot;GREATER EGG HARBOR REGIONAL HIGH SCHOOL DISTRICT&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Greater Egg Harbor Regional High School District is the school district that includes Cedar Creek High School."</data>
