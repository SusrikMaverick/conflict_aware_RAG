<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d5" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d4" for="edge" attr.name="description" attr.type="string" />
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="source_id" attr.type="string" />
  <key id="d1" for="node" attr.name="description" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_type" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="&quot;WINTER ISLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winter Island is an island located in Salem, Massachusetts, and another one in Antarctica, both bounded by specific bodies of water and featuring residential areas and marine parks."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SALEM NECK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salem Neck is a part of Salem, Massachusetts, connected by a causeway to Winter Island."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;MASSACHUSETTS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Massachusetts is a state in the United States where Winter Island is located."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SMITH POOL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Smith Pool is a body of water bounding Winter Island to the northwest."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;CAT COVE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Cat Cove is a body of water bounding Winter Island to the west."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SALEM CHANNEL&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Salem Channel is a body of water bounding Winter Island to the south and east."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;JUNIPER COVE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Juniper Cove is a body of water bounding Winter Island to the north."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;WINTER ISLAND ROAD&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winter Island Road is the only road on Winter Island, located at the north end."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;PLUMMER HOME FOR BOYS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Plummer Home for Boys is now known as Plummer Youth Promise and sits on 10 acres of land on the northeastern shore of Winter Island."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;WINTER ISLAND MARINE PARK&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Winter Island Marine Park occupies the majority of Winter Island, excluding the residential area and Plummer Youth Promise."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;NATIONAL REGISTER OF HISTORIC PLACES&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The National Register of Historic Places is an organization that added Winter Island to its register in 1980."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;ANTARCTICA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Antarctica is a continent where Winter Island (Antarctica) is located, north of Skua Island in the Argentine Islands, Wilhelm Archipelago."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SKUA ISLAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Skua Island is an island in the Argentine Islands, Wilhelm Archipelago, off the west coast of Graham Land, Antarctica, near Winter Island (Antarctica)."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;ARGENTINE ISLANDS&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Argentine Islands are a group of islands in the Wilhelm Archipelago, off the west coast of Graham Land, Antarctica, including Winter Island (Antarctica)."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;WILHELM ARCHIPELAGO&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Wilhelm Archipelago is a group of islands off the west coast of Graham Land, Antarctica, including Winter Island (Antarctica) and Skua Island."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;GRAHAM LAND&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Graham Land is a region in Antarctica, where the Wilhelm Archipelago and Winter Island (Antarctica) are located."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;BRITISH GRAHAM LAND EXPEDITION (BGLE)&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The British Graham Land Expedition (BGLE) named Winter Island as the site of its winter base during 1935."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;FALKLAND ISLANDS DEPENDENCIES SURVEY&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"The Falkland Islands Dependencies Survey established a base on Winter Island in 1947, named Base F (Argentine Islands)."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SIR JAMES WORDIE&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Sir James Wordie was a member of Shackleton's Imperial Trans-Antarctic Expedition who visited Winter Island during the BGLE expedition."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;YETI&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"Yeti is a mythical creature mentioned in the context of religious needs and suffering."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;BASE F (ARGENTINE ISLANDS)&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Base F (Argentine Islands) is a base established by the Falkland Islands Dependencies Survey on Winter Island in 1947."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SHACKLETON'S IMPERIAL TRANS-ANTARCTIC EXPEDITION&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"Shackleton's Imperial Trans-Antarctic Expedition included Sir James Wordie who visited Winter Island during the BGLE expedition."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;RELIGIOUS NEED&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Religious Need refers to the need for a new artifact for religious purposes mentioned in the context of providing comfort and repayment for suffering."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;FOOD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Food is mentioned as a way to make everything better and repay suffering."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;REPARATIONS&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Reparations refer to the payment required to release someone from a punishment, mentioned in the context of an abhorrent crime."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;DEATH PENALTY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Death Penalty is a form of punishment that has been abolished, mentioned in the context of a hypothetical scenario."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;COLD&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Cold is a condition mentioned in the context of drying clothes near a warm fire."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;FIRE&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Fire is used to dry and warm clothes in the context of dealing with wet clothing."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;TRACKS&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Tracks are mentioned in the context of movement near a frozen lake."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;FROZEN LAKE&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Frozen Lake is a location near which tracks are mentioned."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;KYIV PENINSULA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Kyiv Peninsula is a projection from the western side of the Antarctic Peninsula, mentioned in the context of a group's location."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;ANTARCTIC PENINSULA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Antarctic Peninsula is a region where the Kyiv Peninsula is located, mentioned in the context of satellite imagery acquisition."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;BELLINGSHAUSEN SEA&quot;">
      <data key="d0">"LOCATION"</data>
      <data key="d1">"Bellingshausen Sea is a sea where natural color images are acquired, mentioned in the context of satellite imagery acquisition."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SATELLITE&quot;">
      <data key="d0">"TECHNOLOGY"</data>
      <data key="d1">"Satellite is used to acquire natural color images in the Bellingshausen Sea, mentioned in the context of satellite imagery acquisition."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <node id="&quot;SEA ICE&quot;">
      <data key="d0">"OBJECT"</data>
      <data key="d1">"Sea Ice is mentioned in the context of its melting and lowest extent observed since 1979."</data>
      <data key="d2">ramdocs-0163-66031241e443</data>
    </node>
    <edge source="&quot;WINTER ISLAND&quot;" target="&quot;SALEM NECK&quot;">
      <data key="d3">8.0</data>
      <data key="d4">"Winter Island is connected by a causeway to Salem Neck in Salem, Massachusetts."</data>
      <data key="d5">"connection, infrastructure"</data>
      <data key="d6">ramdocs-0163-66031241e443</data>
    </edge>
    <edge source="&quot;WINTER ISLAND&quot;" target="&quot;MASSACHUSETTS&quot;">
      <data key="d3">9.0</data>
      <data key="d4">"Winter Island is located in Massachusetts, United States."</data>
      <data key="d5">"location, jurisdiction"</data>
      <data key="d6">ramdocs-0163-66031241e443</data>
    </edge>
    <edge source="&quot;WINTER ISLAND&quot;" target="&quot;SMITH POOL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Smith Pool bounds Winter Island to the northwest."</data>
      <data key="d5">"boundary, geography"</data>
      <data key="d6">ramdocs-0163-66031241e443</data>
    </edge>
    <edge source="&quot;WINTER ISLAND&quot;" target="&quot;CAT COVE&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Cat Cove bounds Winter Island to the west."</data>
      <data key="d5">"boundary, geography"</data>
      <data key="d6">ramdocs-0163-66031241e443</data>
    </edge>
    <edge source="&quot;WINTER ISLAND&quot;" target="&quot;SALEM CHANNEL&quot;">
      <data key="d3">7.0</data>
      <data key="d4">"Salem Channel bounds Winter Island to the south and east."</data>
      <data key="d5">"boundary, geography"</data>
      <data key="d6">ramdocs-0163-66031241e443</data>
    </edge>
  </graph>
